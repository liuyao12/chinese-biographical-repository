":"c-sanguozhi-053-chengbing","raw_mention_count":1,"mention_ids":["c-sanguozhi-053-chengbing:line027:m0040"],"paragraph_ids":["c-sanguozhi-053-chengbing:line027"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-053-chengbing:line027:m0040","mention_ids":["c-sanguozhi-053-chengbing:line027:m0040"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-060-lvdai"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu060-lvdai-0","subject_person_id":"x6j_swp_8be","object_person_id":"p2p_gqb_6ar","predicate":"father","qualifiers":{"source_term":"燮子徽"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-lvdai","source_id":"s-sanguozhi-060-lvdai","paragraph_id":"c-sanguozhi-060-lvdai:line051","quote":"　　交阯太守士燮卒，權以燮子徽為安遠將軍，領九真太守，以校尉陳時代燮。岱表分海南三郡為交州，以將軍戴良為刺史，海東四郡為廣州，岱自為刺史。遣良與時南入，而徽不承命，舉兵戍海口以拒良等。岱於是上疏請討徽罪，督兵三千人晨夜浮海。或謂岱曰：\"徽藉累世之恩，為一州所附，未易輕也。\"岱曰：\"今徽雖懷逆計，未虞吾之卒至，若我潛軍輕舉，掩其無備，破之必也。稽留不速，使得生心，嬰城固守，七郡百蠻，雲合響應，雖有智者，誰能圖之?\"遂行，過合浦，與良俱進。徽聞岱至，果大震怖，不知所出，即率兄弟六人肉袒迎岱。岱皆斬送其首，徽大將甘醴，桓治等率吏民攻岱，岱奮擊大破之，進封番禺侯。於是除廣州，復為交州如故。岱既定交州，復進討九真，斬獲以萬數。又遣從事南宣國化，暨徼外扶南、林邑、堂明諸王，各遣使奉貢。權嘉其功，進拜鎮南將軍。","subject_person_mention_id":"c-sanguozhi-060-lvdai:line051:m0014","object_person_mention_id":"c-sanguozhi-060-lvdai:line051:m0006"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu060-lvdai1","person_id":"p2p_gqb_6ar","event_type":"death","source_term":"士燮卒","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-lvdai","source_id":"s-sanguozhi-060-lvdai","paragraph_id":"c-sanguozhi-060-lvdai:line051","quote":"　　交阯太守士燮卒，權以燮子徽為安遠將軍，領九真太守，以校尉陳時代燮。岱表分海南三郡為交州，以將軍戴良為刺史，海東四郡為廣州，岱自為刺史。遣良與時南入，而徽不承命，舉兵戍海口以拒良等。岱於是上疏請討徽罪，督兵三千人晨夜浮海。或謂岱曰：\"徽藉累世之恩，為一州所附，未易輕也。\"岱曰：\"今徽雖懷逆計，未虞吾之卒至，若我潛軍輕舉，掩其無備，破之必也。稽留不速，使得生心，嬰城固守，七郡百蠻，雲合響應，雖有智者，誰能圖之?\"遂行，過合浦，與良俱進。徽聞岱至，果大震怖，不知所出，即率兄弟六人肉袒迎岱。岱皆斬送其首，徽大將甘醴，桓治等率吏民攻岱，岱奮擊大破之，進封番禺侯。於是除廣州，復為交州如故。岱既定交州，復進討九真，斬獲以萬數。又遣從事南宣國化，暨徼外扶南、林邑、堂明諸王，各遣使奉貢。權嘉其功，進拜鎮南將軍。","person_mention_id":"c-sanguozhi-060-lvdai:line051:m0006"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line088:m0125","start":125,"end":127,"surface":"士燮","kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-buzhi-complete:line088","chapter_id":"c-sanguozhi-052-buzhi-complete"},{"id":"c-sanguozhi-052-buzhi-complete:line088:m0162","start":162,"end":163,"surface":"燮","kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-buzhi-complete:line088","chapter_id":"c-sanguozhi-052-buzhi-complete"},{"id":"c-sanguozhi-053-chengbing:line027:m0040","start":40,"end":42,"surface":"士燮","kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-053-chengbing:line027","chapter_id":"c-sanguoz