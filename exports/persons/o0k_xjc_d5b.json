ounger_ordinal":null}},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-huanwen","source_id":"s-jinshu-098-ws2614273","paragraph_id":"c-jinshu-098-huanwen:p008","quote":"進位太尉，固讓不拜。時殷浩至洛陽修復園陵，經涉數年，屢戰屢敗，器械都盡。溫復進督司州，因朝野之怨，乃奏廢浩，自此內外大權一歸溫矣。溫遂統步騎四萬發江陵，水軍自襄陽入均口。至南鄉，步自淅川以征關中，命梁州刺史司馬勳出子午道。別軍攻上洛，獲苻健荊州刺史郭敬，進擊青泥，破之。健又遣子生、弟雄眾數萬屯嶢柳、愁思塠以距溫，遂大戰，生親自陷陣，殺溫將應庭、劉泓，死傷千數。溫軍力戰，生眾乃散。雄又與將軍桓沖戰白鹿原，又為沖所破。雄遂馳襲司馬勳，勳退次女媧堡。溫進至霸上，健以五千人深溝自固，居人皆安堵復業，持牛酒迎溫于路者十八九，耆老感泣曰：「不圖今日復見官軍！」初，溫恃麥熟，取以為軍資。而健芟苗清野，軍糧不屬，收三千餘口而還。帝使侍中黃門勞溫於襄陽。","subject_person_mention_id":"c-jinshu-098-huanwen:p008:m0142","object_person_mention_id":"c-jinshu-098-huanwen:p008:m0135"}],"interpretation_note":"此條按本句所明言。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-008-jin098-huanwen-fangtou:354:m0006","start":6,"end":8,"surface":"苻雄","kind":"person","person_id":"o0k_xjc_d5b","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-008-jin098-huanwen-fangtou:354","chapter_id":"c-jinshu-008-jin098-huanwen-fangtou"},{"id":"c-jinshu-098-huan-guanzhong-wyd:p001:m0039","start":39,"end":40,"surface":"雄","kind":"person","person_id":"o0k_xjc_d5b","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-huan-guanzhong-wyd:p001","chapter_id":"c-jinshu-098-huan-guanzhong-wyd"},{"id":"c-jinshu-098-huanwen:p008:m0142","start":142,"end":143,"surface":"雄","kind":"person","person_id":"o0k_xjc_d5b","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-098-huanwen:p008","chapter_id":"c-jinshu-098-huanwen"},{"id":"c-jinshu-098-huanwen:p008:m0191","start":191,"end":192,"surface":"雄","kind":"person","person_id":"o0k_xjc_d5b","status":"contextual_provis