{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002370","identity_policy":"contextual_provisional","person_ids":["cbr-p002370"],"persons":[{"id":"cbr-p002370","label":"公子紲（趙世家爭立候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公子紲","mention_ids":["c-shiji-043-zhao:m054-0110"]},{"surface":"紲","mention_ids":["c-shiji-043-zhao:m054-0120"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m054-0110","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p054","quote":"公子紲"},{"mention_id":"c-shiji-043-zhao:m054-0120","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p054","quote":"紲"}]}],"mentions":[{"id":"c-shiji-043-zhao:m054-0110","start":110,"end":113,"surface":"公子紲","kind":"person","person_id":"cbr-p002370","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p054","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m054-0120","start":120,"end":121,"surface":"紲","kind":"person","person_id":"cbr-p002370","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p054","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-141","person_id":"cbr-p002370","surfaces":["公子紲","紲"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p054","quote":"十七年，成侯與魏惠王遇葛孽。十九年，與齊、宋會平陸，與燕會阿。二十年，魏獻榮椽，因以爲檀臺。二十一年，魏圍我邯鄲。二十二年，魏惠王拔我邯鄲，齊亦敗魏於桂陵。二十四年，魏歸我邯鄲，與魏盟漳水上。秦攻我藺。二十五年，成侯卒。公子紲太子肅侯爭立，紲敗亡奔韓。"}],"rationale":"限本篇明示姓名、是為與連續事件；太戊午／大戊午暫接但字形待底本核查。娃嬴／孟姚／惠后按本段明示暫接，不與先前夢辭孟姚按同名合併；王紲與較早公子紲分候選。君王職稱按各國上下文辨別，不全域匹配。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p054","text":"十七年，成侯與魏惠王遇葛孽。十九年，與齊、宋會平陸，與燕會阿。二十年，魏獻榮椽，因以爲檀臺。二十一年，魏圍我邯鄲。二十二年，魏惠王拔我邯鄲，齊亦敗魏於桂陵。二十四年，魏歸我邯鄲，與魏盟漳水上。秦攻我藺。二十五年，成侯卒。公子紲太子肅侯爭立，紲敗亡奔韓。","annotation_status":"named_mentions_first_pass","text_