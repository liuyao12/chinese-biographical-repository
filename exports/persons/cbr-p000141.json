,"start":42,"end":44,"surface":"好女","kind":"person","person_id":"cbr-p000141","status":"source_identified","paragraph_id":"c-shiji-003-yin:p029","chapter_id":"c-shiji-003-yin"},{"id":"c-shiji-003-yin:m029-0049","start":49,"end":52,"surface":"九侯女","kind":"person","person_id":"cbr-p000141","status":"source_identified","paragraph_id":"c-shiji-003-yin:p029","chapter_id":"c-shiji-003-yin"}],"relations":[{"id":"a-shiji003-036","subject_person_id":"cbr-p000141","predicate":"father","object_person_id":"cbr-p000140","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p029","quote":"九侯有好女，入之紂","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"女","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p029","text":"百姓怨望而諸侯有畔者，於是紂乃重刑辟，有炮格之法。以西伯昌、九侯、鄂侯為三公。九侯有好女，入之紂。九侯女不憙淫，紂怒，殺之，而醢九侯。鄂侯爭之彊，辨之疾，并脯鄂侯。西伯昌聞之，竊嘆。崇侯虎知之，以告紂，紂囚西伯羑里。西伯之臣閎夭之徒，求美女奇物善馬以獻紂，紂乃赦西伯。西伯出而獻洛西之地，以請除炮格之刑。紂乃許之，賜弓矢斧鉞，使得征伐，為西伯。而用費中為政。費中善諛，好利，殷人弗親。紂又用惡來。惡來善毀讒，諸侯以此益疏。","mentions":[{"id":"c-shiji-003-yin:m029-0013","start":13,"end":14,"surface":"紂","kind":"person","person_id":"cbr-p000136","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0026","start":26,"end":29,"surface":"西伯昌","kind":"person","person_id":"cbr-p000139","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0030","start":30,"end":32,"surface":"九侯","kind":"person","person_id":"cbr-p000140","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0033","start":33,"end":35,"surface":"鄂侯","kind":"person","person_id":"cbr-p000142","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0039","start":39,"end":41,"surface":"九侯","kind":"person","person_id":"cbr-p000140","status":"source_identified"},{"id":"c-shiji-003-yin:m029-0042","start":42