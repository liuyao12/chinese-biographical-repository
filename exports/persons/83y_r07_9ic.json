rce_ids":["s-songshu-076-wangxuanmo-ws-ws1997726"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-songshu-076-wangxuanmo-ws:named_attendant7-177","kind":"named_attendant","person_id":"83y_r07_9ic","source_quote":"一崐崘奴子，名白主","reading":"書中標名白主，身份以原詞存；未據白字推姓，籍貫未詳。","note":"書中標名白主，身份以原詞存；未據白字推姓，籍貫未詳。","paragraph_id":"c-songshu-076-wangxuanmo-ws:p007","start_codepoint":177,"end_codepoint":186,"human_reviewed":false,"chapter_id":"c-songshu-076-wangxuanmo-ws","source_id":"s-songshu-076-wangxuanmo-ws-ws1997726"},{"id":"c-songshu-076-wangxuanmo-ws:printed_name_variant7-183","kind":"printed_name_variant","person_id":"83y_r07_9ic","source_quote":"名白主","reading":"武英殿本卷76葉七下第四欄印「名曰主」，數位宋書、南史作「名白主」。留下所見兩種讀法。","note":"武英殿本卷76葉七下第四欄印「名曰主」，數位宋書、南史作「名白主」。留下所見兩種讀法。","paragraph_id":"c-songshu-076-wangxuanmo-ws:p007","start_codepoint":183,"end_codepoint":186,"human_reviewed":false,"witness_readings":["名曰主","名白主"],"surname":null,"chapter_id":"c-songshu-076-wangxuanmo-ws","source_id":"s-songshu-076-wangxuanmo-ws-ws1997726"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-076-wangxuanmo-ws:p007:m0184","start":184,"end":186,"surface":"白主","kind":"person","person_id":"83y_r07_9ic","status":"contextual_provisional","paragraph_id":"c-songshu-076-wangxuanmo-ws:p007","chapter_id":"c-songshu-076-wangxuanmo-ws"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-songshu-076-wangxuanmo-ws:p007:r0180","paragraph_id":"c-songshu-076-wangxuanmo-ws:p007","start":180,"end":182,"surface":"奴子","person_id":"83y_r07_9ic","referent_role":"third_person","quote":"孝武狎侮羣臣，隨其狀貌，各有比類，多鬚者謂之羊。顏師伯缺齒，號之曰齴。劉秀之儉吝，呼為老慳。黃門侍郎宗靈秀體肥，拜起不便，每至集會，多所賜與，欲其瞻謝傾踣，以為歡笑。又刻木作靈秀父光祿勳叔獻像，送其家廳事。柳元景、垣護之並北人，而玄謨獨受「老傖」之目。凡所稱謂，四方書疏亦如之。嘗為玄謨作四時詩曰：「菫荼供春膳，粟漿充夏飡。瓟醬調秋菜，白醝解冬寒。」又寵一崐崘奴子，名白主。常在左右，令以杖擊羣臣，自柳元景以下，皆罹其毒。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-songshu-076-wangxuanmo-ws","book_id":"b-songshu-076","work_id":"w-songshu","source_id":"s-songshu-076-wangxuanmo-ws-ws1997726"},{"id":"c-songshu-076-wangxuanmo-ws:p007:r0208","paragraph_id":"c-songshu-076-wangxuanmo-ws:p007","start":208,"end":209,"surface":"其","person_id":"83y_r07_9ic","referent_role":"third_person","quote":"孝武狎侮羣臣，隨其狀貌，各有比類，多鬚者謂之羊。顏師伯缺齒，號之曰齴。劉秀之儉吝，呼為老慳。黃門侍郎宗靈秀體肥，拜起不便，每至集會，多所賜與，欲其瞻謝傾踣，以為歡笑。又刻木作靈秀父光祿勳叔獻像，送其家廳事。柳元景、垣護之並北人，而玄謨獨受「老傖」之目。凡所稱謂，四方書疏亦如之。嘗為玄謨作四時詩曰：「菫荼供春膳，粟漿充夏飡。瓟醬調秋菜，白醝解冬寒。」又寵一崐崘奴子，名白主。常在左右，令以杖擊羣臣，自柳元景以下，皆罹其毒。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-songshu-076-wangxuanmo-ws","book_id":"b-songshu-076","work_id":"w-songshu","source_id":"s-songshu-076-wangxuanmo-ws-ws1997726"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-076-wangxuanmo-ws:p007","text":"孝武狎侮羣臣，隨其狀貌，各有比類，多鬚者謂之羊。顏師伯缺齒，號之曰齴。劉秀之儉吝，呼為老慳。黃門侍郎宗靈秀體肥，拜起不便，每至集會，多所賜與，欲其瞻謝傾踣，以為歡笑。又刻木作靈秀父光祿勳叔獻像，送其家廳事。柳元景、垣護之並北人，而玄謨獨受「老傖」之目。凡所稱謂，四方書疏亦如之。嘗為玄謨作四時詩曰：「菫荼供春膳，粟漿充夏飡。瓟醬調秋菜，白醝解冬寒。」又寵一崐崘奴子，名白主。常在左右，令以杖擊羣臣，自柳元景以下，皆罹其毒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":48,"last_line":48,"raw_start":4823,"raw_end":5034,"raw_character_offsets":[4823,4824,4825,4826,4827,4828,4829,4830,4831,4832,4833,4834,4835,4836,4837,4838,4839,4840,4841,4842,4843,4844,4845,4846,4847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,4858,4859,4860,4861,4862,4863,4864,4865,4866,4867,4868,4869,4870,4871,48