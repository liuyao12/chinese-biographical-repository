d":"c-shiji-107-weiqi:m012-0083","start":83,"end":86,"surface":"潁陰侯","kind":"person","person_id":"d4q_icw_co6","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p012","chapter_id":"c-shiji-107-weiqi"},{"id":"c-shiji-107-weiqi:m013-0000","start":0,"end":3,"surface":"潁陰侯","kind":"person","person_id":"d4q_icw_co6","status":"contextual_provisional","paragraph_id":"c-shiji-107-weiqi:p013","chapter_id":"c-shiji-107-weiqi"}],"relations":[],"title_holdings":[{"id":"th-shiji107-020","person_id":"d4q_icw_co6","title":"將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p012","quote":"灌將軍夫者，潁陰人也。夫父張孟，嘗為潁陰侯嬰舍人，得幸，因進之至二千石，故蒙灌氏姓為灌孟。吳楚反時，潁陰侯灌何為將軍，屬太尉，請灌孟為校尉。夫以千人與父俱。灌孟年老，潁陰侯彊請之，郁郁不得意，故戰常陷堅，遂死吳軍中。軍法，父子俱從軍，有死事，得與喪歸。灌夫不肯隨喪歸，奮曰：「願取吳王若將軍頭，以報父之仇。」於是灌夫被甲持戟，募軍中壯士所善願從者數十人。及出壁門，莫敢前。獨二人及從奴十數騎馳入吳軍，至吳將麾下，所殺傷數十人。不得前，復馳還，走入漢壁，皆亡其奴，獨與一騎歸。夫身中大創十餘，適有萬金良藥，故得無死。夫創少瘳，又復請將軍曰：「吾益知吳壁中曲折，請復往。」將軍壯義之，恐亡夫，乃言太尉，太尉乃固止之。吳已破，灌夫以此名聞天下。"}],"attestations":[{"id":"th-shiji107-020:a001","paragraph_id":"c-shiji-107-weiqi:p012","start":56,"end":58,"surface":"將軍","person_mention_id":"c-shiji-107-weiqi:m012-0050","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按明示拜、為、免、罷逐與坐法去官區分授任與終點。既任官只作來源用稱；職位轉移不另補前官終止日。數月、數歲保留相對表述，不推具體年。太仆保留數位見證字形。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji107-015","person_id":"d4q_icw_co6","surfaces":["潁陰侯灌何","潁陰侯"],"scope":"same_chapter","chapter_ids":["c-shiji-107-weiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-107-weiqi:p012","quote":"灌將軍夫者，潁陰人也。夫父張孟，嘗為潁陰侯嬰舍人，得幸，因進之至二千石，故蒙灌氏姓為灌孟。吳楚反時，潁陰侯灌何為將軍，屬太尉，請灌孟為校尉。夫以千人與父俱。灌孟年老，潁陰侯彊請之，郁郁不得意，故戰常陷堅，遂死吳軍中。軍法，父子俱從軍，有死事，得與喪歸。灌夫不肯隨喪歸，奮曰：「願取吳王若將軍頭，以報父之仇。」於是灌夫被甲持戟，募軍中壯士所善願從者數十人。及出壁門，莫敢前。獨二人及從奴十數騎馳入吳軍，至吳將麾下，所殺傷數十人。不得前，復馳還，走入漢壁，皆亡其奴，獨與一騎歸。夫身中大創十餘，適有萬金良藥，故得無死。夫創少瘳，又復請將軍曰：「吾益知吳壁中曲折，請復往。」將軍壯義之，恐亡夫，乃言太尉，太尉乃固止之。吳已破，灌夫以此名聞天下。"},{"paragraph_id":"c-shiji-107-weiqi:p013","quote":"潁陰侯言之上，上以夫為中郎將。數月，坐法去。後家居長安，長安中諸公莫弗稱之。孝景時，至代相。孝景崩，今上初即位，以為淮陽天下交，勁兵處，故徙夫為淮陽太守。建元元年，入為太仆。二年，夫與長樂衛尉竇甫飲，輕重不得，夫醉，搏甫。甫，竇太后昆弟也。上恐太后誅夫，徙為燕相。數歲，坐法去官，家居長安。"}],"rationale":"限本篇逐段介紹、事件與說話者的稱呼承接。灌仲孺是灌夫，長孺是韓安國；田蚡與子恬的武安侯按嗣爵前後分開，夫不匹配夫妻、大夫或夫人。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-107-weiqi:p012","text":"灌將軍夫者，潁陰人也。夫父張孟，嘗為潁陰侯嬰舍人，得幸，因進之至二千石，故蒙灌氏姓為灌孟。吳楚反時，潁陰侯灌何為將軍，屬太尉，請灌孟為校尉。夫以千人與父俱。灌孟年老，潁陰侯彊請之，郁郁不得意，故戰常陷堅，遂死吳軍中。軍法，父子俱從軍，有死事，得與喪歸。灌夫不肯隨喪歸，奮曰：「願取吳王若將軍頭，以報父之仇。」於是灌夫被甲持戟，募軍中壯士所善願從者數十人。及出壁門，莫敢前。獨二人及從奴十數騎馳入吳軍，至吳將麾下，所殺傷數十人。不得前，復馳還，走入漢壁，皆亡其奴，獨與一騎歸。夫身中大創十餘，適有萬金良藥，故得無死。夫創少瘳，又復請將軍曰：「吾益知吳壁中曲折，請復往。」將軍壯義之，恐亡夫，乃言太尉，太尉乃固止之。吳已破，灌夫以此名聞天下。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-107-weiqi:m012-0000","start":0,"end":4,"surface":"灌將軍夫","kind":"person","person_id":"h1w_44g_vef_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0011","start":11,"end":12,"surface":"夫","kind":"person","person_id":"h1w_44g_vef_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0013","start":13,"end":15,"surface":"張孟","kind":"person","person_id":"h1w_44g_vef","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0018","start":18,"end":22,"surface":"潁陰侯嬰","kind":"person","person_id":"tfu_611_q19","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0042","start":42,"end":44,"surface":"灌孟","kind":"person","person_id":"h1w_44g_vef","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0050","start":50,"end":55,"surface":"潁陰侯灌何","kind":"person","person_id":"d4q_icw_co6","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m012-0064","start":64,"end":66,"surface":"灌孟","kind":"perso