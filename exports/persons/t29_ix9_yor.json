ons":[{"id":"c-jinshu-043-wangrong:p010:m0256","start":256,"end":258,"surface":"葛旟","kind":"person","person_id":"t29_ix9_yor","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。","paragraph_id":"c-jinshu-043-wangrong:p010","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-059-jiong:p003:m0061","start":118,"end":120,"surface":"葛𣄣","kind":"person","person_id":"t29_ix9_yor","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p003","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-059-jiong:p011:m0121","start":242,"end":244,"surface":"葛旟","kind":"person","person_id":"t29_ix9_yor","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p011","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-059-jiong:p013:m0141","start":105,"end":107,"surface":"葛旟","kind":"person","person_id":"t29_ix9_yor","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p013","chapter_id":"c-jinshu-059-jiong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p010","text":"裴頠，戎之婿也，頠誅，戎坐免官。齊王冏起義，孫秀祿戎於城內，趙王倫子欲取戎為軍司。博士王繇曰：「濬沖譎詐多端，安肯為少年用？」乃止。惠帝反宮，以戎為尚書令。既而河間王顒遣使就說成都王穎，將誅齊王冏。檄書至，冏謂戎曰：「孫秀作逆，天子幽逼。孤糾合義兵，掃除元惡，臣子之節，信著神明。二王聽讒，造構大難，當賴忠謀，以和不協。卿其善為我籌之。」戎曰：「公首舉義眾，匡定大業，開闢以來，未始有也。然論功報嘗，不及有勞，朝野失望，人懷貳志。今二王帶甲百萬，其鋒不可當，若以王就第，不失故爵。委權崇讓，此求安之計也。」冏謀臣葛旟怒曰：「漢魏以來，王公就第，甯有得保妻子乎！議者可斬。」於是百官震悚，戎偽藥發墮廁，得不及禍。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p010:m0000","start":0,"end":2,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0003","start":3,"end":4,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0008","start":8,"end":9,"surface":"頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0011","start":11,"end":12,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0016","start":16,"end":19,"surface":"齊王冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0022","start":22,"end":24,"surface":"孫秀","kind":"person","person_id":"8x5_e5i_yle","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0025","start":25,"end":26,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0030","start":30,"end":33,"surface":"趙王倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0033","start":33,"end":34,"surface":"子","kind":"person","person_id":"43s_gru_94d","status":"contextual_provisional","resolution_note":"倫子未明是哪一子，獨立匿名來源身份。"},{"id":"c-jinshu-043-wangrong:p010:m0036","start":36,"end":37,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"八王亂時域，冏引語之孤/戎引語之公屬冏，卿是冏對戎；兩王群指顒與穎但不拆單代詞。"},{"id":"c-jinshu-043-wangrong:p010:m0043","start":43,"end":45,"surfac