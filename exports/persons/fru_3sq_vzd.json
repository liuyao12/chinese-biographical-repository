c-nanqishu-049-zhangchong:p012","chapter_id":"c-nanqishu-049-zhangchong"}],"relations":[],"title_holdings":[{"id":"th-w067-wen-46","person_id":"fru_3sq_vzd","title":"廣陵功曹","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-wenqiao","source_id":"s-jinshu-067-wenqiao","paragraph_id":"c-jinshu-067-wenqiao:line036","quote":"昔包胥楚國之微臣，重趼致誠，義感諸侯。藺相如趙邦之陪隸，恥君之辱，按劍秦庭。皇漢之季，董卓作亂，劫遷獻帝，虐害忠良，關東州郡相率同盟。廣陵功曹臧洪，郡之小吏耳，登壇喢血，涕淚橫流，慷慨之節，實厲群后。况今居台鼎，據方州，列名邦，受國恩者哉！不期而會，不謀而同，不亦宜乎！","person_mention_id":"c-jinshu-067-wenqiao:line036:m0071"}],"attestations":[{"id":"th-w043-wen-46:a","paragraph_id":"c-jinshu-067-wenqiao:line036","start":67,"end":71,"surface":"廣陵功曹","person_mention_id":"c-jinshu-067-wenqiao:line036:m0071","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-wenqiao:line036","text":"昔包胥楚國之微臣，重趼致誠，義感諸侯。藺相如趙邦之陪隸，恥君之辱，按劍秦庭。皇漢之季，董卓作亂，劫遷獻帝，虐害忠良，關東州郡相率同盟。廣陵功曹臧洪，郡之小吏耳，登壇喢血，涕淚橫流，慷慨之節，實厲群后。况今居台鼎，據方州，列名邦，受國恩者哉！不期而會，不謀而同，不亦宜乎！","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-wenqiao:line036:m0001","start":1,"end":3,"surface":"包胥","kind":"person","person_id":"0rc_0ya_wg8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line036:m0019","start":19,"end":22,"surface":"藺相如","kind":"person","person_id":"sfa_wwl_tt2","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line036:m0043","start":43,"end":45,"surf