中而亡去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m052-0000","start":0,"end":2,"surface":"懿公","kind":"person","person_id":"cbr-p001136","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0008","start":8,"end":10,"surface":"懿公","kind":"person","person_id":"cbr-p001136","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0016","start":16,"end":18,"surface":"丙戎","kind":"person","person_id":"cbr-p001142","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0032","start":32,"end":34,"surface":"丙戎","kind":"person","person_id":"cbr-p001142","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0039","start":39,"end":41,"surface":"丙戎","kind":"person","person_id":"cbr-p001142","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0043","start":43,"end":45,"surface":"庸職","kind":"person","person_id":"cbr-p001143","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0055","start":55,"end":57,"surface":"庸職","kind":"person","person_id":"cbr-p001143","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0063","start":63,"end":65,"surface":"懿公","kind":"person","person_id":"cbr-p001136","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0070","start":70,"end":72,"surface":"二人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m052-0076","start":76,"end":77,"surface":"職","kind":"person","person_id":"cbr-p001143","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0085","start":85,"end":86,"surface":"戎","kind":"person","person_id":"cbr-p001142","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m052-0094","start":94,"end":96,"surface":"二人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m052-0111","start":111,"end":113,"surface":"二人","kind":"unresolved","person_id":null,"