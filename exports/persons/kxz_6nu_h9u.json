agraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:p064:block07:m0053","start":53,"end":55,"surface":"猗頓","kind":"person","person_id":"kxz_6nu_h9u","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p064:block07","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-112-pingjin:m015-0078","start":78,"end":80,"surface":"猗頓","kind":"person","person_id":"kxz_6nu_h9u","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p015","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-129-huozhi:m010-0000","start":0,"end":2,"surface":"猗頓","kind":"person","person_id":"kxz_6nu_h9u","status":"contextual_provisional","paragraph_id":"c-shiji-129-huozhi:p010","chapter_id":"c-shiji-129-huozhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[{"id":"eq-shiji112-exemplars-yidun","person_ids":["kxz_6nu_h9u"],"canonical_person_id":"kxz_6nu_h9u","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-112-pingjin","c-shiji-006-shihuang","c-shiji-129-huozhi"],"evidence":[{"chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p015","quote":"臣聞天下之患在於土崩，不在於瓦解，古今一也。何謂土崩？秦之末世是也。陳涉無千乘之尊，尺土之地，身非王公大人名族之后，無鄉曲之譽，非有孔、墨、曾子之賢，陶朱、猗頓之富也，然起窮巷，奮棘矜，偏袒大呼而天下從風，此其故何也？由民困而主不恤，下怨而上不知（也），俗已亂而政不修，此三者陳涉之所以為資也。是之謂土崩。故曰天下之患在於土崩。何謂瓦解？吳、楚、齊、趙之兵是也。七國謀為大逆，號皆稱萬乘之君，帶甲數十萬，威足以嚴其境內，財足以勸其士民，然不能西攘尺寸之地而身為禽於中原者，此其故何也？非權輕於匹夫而兵弱於陳涉也，當是之時，先帝之德澤未衰而安土樂俗之民眾，故諸侯無境外之助。此之謂瓦解，故曰天下之患不在瓦解。由是觀之，天下誠有土崩之勢，雖布衣窮處之士或首惡而危海內，陳涉是也。況三晉之君或存乎！天下雖未有大治也，誠能無土崩之勢，雖有彊國勁兵不得旋踵而身為禽矣，吳、楚、齊、趙是也。況群臣百姓能為亂乎哉！此二體者，安危之明要也，賢主所留意而深察也。","mention_ids":["c-shiji-112-pingjin:m015-0078"],"text_layer":"received_chapter"},{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p064:block07","quote":"秦王既沒，餘威振於殊俗。陳涉，罋牖繩樞之子，甿隸之人，而遷徙之徒，才能不及中人，非有仲尼、墨翟之賢，陶朱、猗頓之富，躡足行伍之閒，而倔起什伯之中，率罷散之卒，將數百之眾，而轉攻秦。斬木為兵，揭竿為旗，天下雲集響應，贏糧而景從，山東豪俊遂并起而亡秦族矣。","mention_ids":["c-shiji-006-shihuang:p064:block07:m0053"],"text_layer":"received_chapter"},{"chapter_id":"c-shiji-129-huozhi","source_id":"s-shiji129-huozhi","paragraph_id":"c-shiji-129-huozhi:p010","quote":"猗頓用盬鹽起。而邯鄲郭縱以鐵冶成業，與王者埒富。","mention_ids":["c-shiji-129-huozhi:m010-0000"],"text_layer":"received_chapter"}],"rationale":"猗頓之富與始皇篇同一陳涉比擬、貨殖傳猗頓用盬鹽起互證；不以富商同類視為同人。 原文、引古與附詔層各存；不以引用時間當人物存世或授官時間。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-006-shihuang:p064:block07","text":"秦王既沒，餘威振於殊俗。陳涉，罋牖繩樞之子，甿隸之人，而遷徙之徒，才能不及中人，非有仲尼、墨翟之賢，陶朱、猗頓之富，躡足行伍之閒，而倔起什伯之中，率罷散之卒，將數百之眾，而轉攻秦。斬木為兵，揭竿為旗，天下雲集響應，贏糧而景從，山東豪俊遂并起而亡秦族矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p064:block07:m0000","start":0,"end":2,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0012","start":12,"end":14,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0042","start":42,"end":44,"surface":"仲尼","kind":"person","person_id":"j5s_4zz_bos","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0045","start":45,"end":47,"surface":"墨翟","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p064:block07:m0050","start":50,"end":52,"surface":"陶朱","kind":"person","person_id":"yhm_h9f_8p