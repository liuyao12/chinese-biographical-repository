ations":[{"id":"a-jin060-sunbi-father","subject_person_id":"y83_fx5_nct","object_person_id":"b9n_ldy_9p3","predicate":"father","qualifiers":{"source_term":"旂子弼"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-060","chapter_id":"c-jinshu-060-sunqi","source_id":"s-jinshu-060-sunqi-ws2413335","paragraph_id":"c-jinshu-060-sunqi:p001","quote":"孫旂，字伯旗，樂安人也。父曆，魏晉際為幽州刺史、右將軍。旂潔靜，少自修立。察孝廉，累遷黃門侍郎，出為荊州刺史，名位與二解相亞。永熙中，徵拜太子詹事，轉衛尉，坐武庫火，免官。歲餘，出為兗州刺史，遷平南將軍、假節。旂子弼及弟子髦、輔、琰四人，並有吏材，稱於當世，遂與孫秀合族。及趙王倫起事，夜從秀開神武門下觀閱器械。兄弟旬月相次為公府掾、尚書郎。弼又為中堅將軍，領尚書左丞，轉為上將軍，領射聲校尉。髦為武衛將軍，領太子詹事。琰為武威將軍，領太子左率。皆賜爵開國郡侯。推崇旂為車騎將軍、開府。初，旂以弼等受署偽朝，遣小息回責讓弼等，以過差之事，必為家禍。弼等終不從，旂制之不可，但慟哭而已。及齊王冏起義，四子皆伏誅。襄陽太守宗岱承冏檄斬旂，夷三族。","subject_person_mention_id":"c-jinshu-060-sunqi:p001:m0107","object_person_mention_id":"c-jinshu-060-sunqi:p001:m0000"}],"status":"source_attested","interpretation_note":"關係從「旂子弼及弟子髦、輔、琰」首句。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-lun:p013:m0313","surface":"孫弼","start":313,"end":315,"person_id":"y83_fx5_nct","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-lun:p013","chapter_id":"c-jinshu-059-prince-lun"},{"id":"c-jinshu-059-prince-lun:p016:m0024","surface":"孫弼","start":24,"end":26,"person_id":"y83_fx5_nct","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-lun:p016","chapter_id":"c-jinshu-059-prince-lun"},{"id":"c-jinshu-060-sunqi:p001:m0107","surface":"弼","start":107,"end":108,"person_id":"y83_fx5_nct","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-sunqi:p001","chapter_id":"c-jinshu-060-sunqi"},{"id":"c-jinshu-060-sunqi:p001:m0171","surface":"弼","start":171,"end":172,"person_id":"y83_fx5_nct","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-06