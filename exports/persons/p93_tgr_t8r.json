son_id":"p93_tgr_t8r","status":"source_attested","qualifiers":{"source_term":"父遠","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-046","chapter_id":"c-nanqishu-046-wangxiuzhi","source_id":"s-nanqishu-046-wangxiuzhi","paragraph_id":"c-nanqishu-046-wangxiuzhi:line023","quote":"秀之宗人僧祐，太尉儉從祖兄也。父遠，光祿勳。宋世爲之語曰：「王遠如屏風，屈曲從俗，能蔽風露。」而僧祐負氣不羣，儉常候之，辭不相見。世祖數閱武，僧祐獻《講武賦》，儉借觀，僧祐不與。竟陵王子良聞僧祐善彈琴，於座取琴進之，不肯從命。永明末，爲太子中舍人，在直屬疾，代人未至，僧祐委出，爲有司所奏，贖論。官至黃門郎。時衞軍掾孔逭亦抗直，著《三吳決錄》，不傳。","subject_person_mention_id":"c-nanqishu-046-wangxiuzhi:line023:m0004","object_person_mention_id":"c-nanqishu-046-wangxiuzhi:line023:m0016"}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-046-wangxiuzhi:line023:m0016","start":16,"end":17,"surface":"遠","kind":"person","person_id":"p93_tgr_t8r","status":"contextual_provisional","paragraph_id":"c-nanqishu-046-wangxiuzhi:line023","chapter_id":"c-nanqishu-046-wangxiuzhi"},{"id":"c-nanqishu-046-wangxiuzhi:line023:m0030","start":30,"end":32,"surface":"王遠","kind":"person","person_id":"p93_tgr_t8r","status":"contextual_provisional","paragraph_id":"c-nanqishu-046-wangxiuzhi:line023","chapter_id":"c-nanqishu-046-wangxiuzhi"}],"relations":[{"id":"a-nanqishu046-sengyou-father","subject_person_id":"p93_tgr_t8r_A","predicate":"father","object_person_id":"p93_tgr_t8r","status":"source_attested","qualifiers":{"source_term":"父遠","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-046","chapter_id":"c-nanqishu-046-wangxiuzhi","source_id":"s-nanqishu-046-wangxiuzhi","paragraph_id":"c-nanqishu-046-wangxiuzhi:line023","quote":"秀之宗人僧祐，太尉儉從祖兄也。父遠，光祿勳。宋世爲之語曰：「王遠如屏風，屈曲從俗，能蔽風露。」而僧祐負氣不羣，儉常候之，辭不相見。世祖數閱武，僧祐獻《講武賦》，儉借觀，僧祐不與。竟陵王子良聞僧祐善彈琴，於座取琴進之，不肯從命。永明末，爲太子中舍人，在直屬疾，代人未至，僧祐委出，爲有司所奏，贖論。官至黃門郎。時衞軍掾孔逭亦抗直，著《三吳決錄》，不傳。","subject_perso