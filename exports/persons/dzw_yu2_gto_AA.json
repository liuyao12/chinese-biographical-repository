constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-038-ziliang-guards:p004","text":"蕭赤斧，南蘭陵人，太祖從祖弟也。祖隆子，衞軍錄事參軍。父始之，冠軍中兵參軍。","mentions":[{"id":"c-nanqishu-038-ziliang-guards:p004:m0000","surface":"蕭赤斧","start":0,"end":3,"person_id":"dzw_yu2_gto_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-038-ziliang-guards:p004:m0017","surface":"隆子","start":17,"end":19,"person_id":"dzw_yu2_gto","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-038-ziliang-guards:p004:m0028","surface":"始之","start":28,"end":30,"person_id":"dzw_yu2_gto_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2273226,"source_layer":"received_biography","first_line":30,"last_line":30,"line_start":2,"line_end":40,"raw_start":1754,"raw_end":1792,"raw_character_offsets":[1754,1755,1756,1757,1758,1759,1760,1761,1762,1763,1764,1765,1766,1767,1768,1769,1770,1771,1772,1773,1774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791],"projection_sha256":"9f023153c4e8d634f8c723fe32494383aed9c5b2c6c9efacb210c2e6574dab74"},"chapter_id":"c-nanqishu-038-ziliang-guards","book_id":"b-nanqishu-038","work_id":"w-nanqishu","source_id":"s-nanqishu-038-ziliang-guards-ws2273226"},{"id":"c-nanqishu-040-ziliang:p027","text":"鑾轝亟動，天蹕屢巡，陵犯風煙，驅馳野澤。萬乘至重，一羽甚微。從甚微之懽，忽至重之誡。頃郊郛以外，科禁嚴重，匪直芻牧事罷，遂乃窀掩殆廢。且田月向登，桑時告至，士女呼嗟，易生噂議，弃民從欲，理未可安。曩時巡幸，必盡威防，領軍景先、詹事赤斧堅甲利兵，左右屯衞。今馳騖外野，交侍疏闊，晨出晚還，頓遺清道，此實愚臣最所震迫。","mentions":[{"id":"c-nanqishu-040-ziliang:p027:m0110","surface":"景先","start":110,"end":112,"person_id":"ngw_hmv_7k0_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p027:m0115","surface":"赤斧","start":115,"end":117,"person_id":"dzw_yu2_gto_AA","kind":"person","status":"