lt":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m027-0025","start":25,"end":28,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p027","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m027-0029","start":29,"end":30,"surface":"支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p027","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m027-0075","start":75,"end":78,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p027","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-087-lisi:m005-0044","start":44,"end":47,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p005","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji005-014","person_id":"1ku_2ry_mri","surfaces":["公孫支","支"],"scope":"same_chapter","chapter_ids":["c-shiji-005-qin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p027","quote":"晉旱，來請粟。丕豹說繆公勿與，因其饑而伐之。繆公問公孫支，支曰：「饑穰更事耳，不可不與。」問百里傒，傒曰：「夷吾得罪於君，其百姓何罪？」於是用百里傒、公孫支言，卒與之粟。以船漕車轉，自雍相望至絳。"}],"rationale":"依本卷同一敘事中的明示稱號、即位說明或短稱暫定；不作全庫字串匹配。穆／繆的通用關係只據此卷的繼立敘事判讀。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji087-016","person_id":"1ku_2ry_mri","surfaces":["公孫支"],"scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-087-lisi:p005","quote":"臣聞吏議逐客，竊以為過矣。昔繆公求士，西取由余於戎，東得百里奚於宛，迎蹇叔於宋，來丕豹、公孫支於晉。此五子者，不產於秦，而繆公用之，并國二十，遂霸西戎。孝公用商鞅之法，移風易俗，民以殷盛，國以富彊，百姓樂用，諸侯親服，獲楚、魏之師，舉地千里，至今治彊。惠王用張儀之計，拔三川之地，西并巴、蜀，北收上郡，南取漢中，包九夷，制鄢、郢，東據成皋之險，割膏腴之壤，遂散六國之從，使之西面事秦，功施到今。昭王得范睢，廢穰侯，逐華陽，彊公室，杜私門，蠶食諸侯，使秦成帝業。此四君者，皆以客之功。由此觀之，客何負於秦哉！向使四君卻客而不內，疏士而不用，是使國無富利之實而秦無彊大之名也。"}],"rationale":"依李斯入秦及諫逐客書局部承接暫接；辭師時秦王未定，與莊襄王卒後所說秦王分開候選，未按同稱全域合併。引古人物與黃帝傳說性分存，短稱斯限李斯敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji087-allusion-sun","person_ids":["1ku_2ry_mri"],"canonical_person_id":"1ku_2ry_mri","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p027","quote":"晉旱，來請粟。丕豹說繆公勿與，因其饑而伐之。繆公問公孫支，支曰：「饑穰更事耳，不可不與。」問百里傒，傒曰：「夷吾得罪於君，其百姓何罪？」於是用百里傒、公孫支言，卒與之粟。以船漕車轉，自雍相望至絳。","mention_ids":["c-shiji-005-qin:m027-0025","c-shiji-005-qin:m027-0029","c-shiji-005-qin:m027-0075"]},{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p005","quote":"臣聞吏議逐客，竊以為過矣。昔繆公求士，西取由余於戎，東得百里奚於宛，迎蹇叔於宋，來丕豹、公孫支於晉。此五子者，不產於秦，而繆公用之，并國二十，遂霸西戎。孝公用商鞅之法，移風易俗，民以殷盛，國以富彊，百姓樂用，諸侯親服，獲楚、魏之師，舉地千里，至今治彊。惠王用張儀之計，拔三川之地，西并巴、蜀，北收上郡，南取漢中，包九夷，制鄢、郢，東據成皋之險，割膏腴之壤，遂散六國之從，使之西面事秦，功施到今。昭王得范睢，廢穰侯，逐華陽，彊公室，杜私門，蠶食諸侯，使秦成帝業。此四君者，皆以客之功。由此觀之，客何負於秦哉！向使四君卻客而不內，疏士而不用，是使國無富利之實而秦無彊大之名也。","mention_ids":["c-shiji-087-lisi:m005-0044"]}],"rationale":"公孫支與百里傒、丕豹同為秦穆問政的人物組合，與取士五子中的同名秦臣相配；不只據姓名，不補出生地或任職始年。 各篇原文與異說分存，同書不是獨立見證；同指不確證全部事蹟、地域或紀年。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-005-qin:p027","text":"晉旱，來請粟。丕豹說繆公勿與，因其饑而伐之。繆公問公孫支，支曰：「饑穰更事耳，不可不與。」問百里傒，傒曰：「夷吾得罪於君，其百姓何罪？」於是用百里傒、公孫支言，卒與之粟。以船漕車轉，自雍相望至絳。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m027-0007","start":7,"end":9,"surface":"丕豹","kind":"person","person_id":"rlv_clg_euu_A","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0010","start":10,"end":12,"surface":"繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0022","start":22,"end":24,"surfac