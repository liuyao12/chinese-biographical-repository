n_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p027","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-043-zhao:m026-0062","start":62,"end":65,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p026","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m026-0130","start":130,"end":133,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p026","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-087-lisi:m005-0044","start":44,"end":47,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p005","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-105-bianque:m002-0094","start":94,"end":97,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p002","chapter_id":"c-shiji-105-bianque"},{"id":"c-shiji-105-bianque:m002-0163","start":163,"end":166,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional","paragraph_id":"c-shiji-105-bianque:p002","chapter_id":"c-shiji-105-bianque"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji005-014","person_id":"1ku_2ry_mri","surfaces":["公孫支","支"],"scope":"same_chapter","chapter_ids":["c-shiji-005-qin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p027","quote":"晉旱，來請粟。丕豹說繆公勿與，因其饑而伐之。繆公問公孫支，支曰：「饑穰更事耳，不可不與。」問百里傒，傒曰：「夷吾得罪於君，其百姓何罪？」於是用百里傒、公孫支言，卒與之粟。以船漕車轉，自雍相望至絳。"}],"rationale":"依本卷同一敘事中的明示稱號、即位說明或短稱暫定；不作全庫字串匹配。穆／繆的通用關係只據此卷的繼立敘事判讀。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji043-071","person_id":"1ku_2ry_mri","surfaces":["公孫支"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p026","quote":"趙簡子疾，五日不知人，大夫皆懼。醫扁鵲視之，出，董安于問。扁鵲曰：「血脈治也，而何怪！在昔秦繆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有學也。帝告我：「晉國將大亂，五世不安；其後將霸，未老而死；霸者之子且令而國男女無別。」』公孫支書而藏之，秦讖於是出矣。獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之疾與之同，不出三日疾必閒，閒必有言也。」"}],"rationale":"限本篇明示姓名、是為及連續事件判讀；夢辭人物與實際敘事分層，知伯文子未與荀櫟僅按熟知身份合併，氏族合稱保持未定。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji087-016","person_id":"1ku_2ry_mri","surfaces":["公孫支"],"scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-087-lisi:p005","quote":"臣聞吏議逐客，竊以為過矣。昔繆公求士，西取由余於戎，東得百里奚於宛，迎蹇叔於宋，來丕豹、公孫支於晉。此五子者，不產於秦，而繆公用之，并國二十，遂霸西戎。孝公用商鞅之法，移風易俗，民以殷盛，國以富彊，百姓樂用，諸侯親服，獲楚、魏之師，舉地千里，至今治彊。惠王用張儀之計，拔三川之地，西并巴、蜀，北收上郡，南取漢中，包九夷，制鄢、郢，東據成皋之險，割膏腴之壤，遂散六國之從，使之西面事秦，功施到今。昭王得范睢，廢穰侯，逐華陽，彊公室，杜私門，蠶食諸侯，使秦成帝業。此四君者，皆以客之功。由此觀之，客何負於秦哉！向使四君卻客而不內，疏士而不用，是使國無富利之實而秦無彊大之名也。"}],"rationale":"依李斯入秦及諫逐客書局部承接暫接；辭師時秦王未定，與莊襄王卒後所說秦王分開候選，未按同稱全域合併。引古人物與黃帝傳說性分存，短稱斯限李斯敘事。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji105-007","person_id":"1ku_2ry_mri","surfaces":["公孫支"],"scope":"same_chapter","chapter_ids":["c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-105-bianque:p002","quote":"當晉昭公時，諸大夫彊而公族弱，趙簡子為大夫，專國事。簡子疾，五日不知人，大夫皆懼，於是召扁鵲。扁鵲入視病，出，董安于問扁鵲，扁鵲曰：「血脈治也，而何怪！昔秦穆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有所學也。帝告我：「晉國且大亂，五世不安。其後將霸，未老而死。霸者之子且令而國男女無別。」』公孫支書而藏之，秦策於是出。夫獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之病與之同，不出三日必閒，閒必有言也。」"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；醫案引語與附載注釋分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji087-allusion-sun","person_ids":["1ku_2ry_mri"],"canonical_person_id":"1ku_2ry_mri","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-087-lisi"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p027","quote":"晉旱，來請粟。丕豹說繆公勿與，因其饑而伐之。繆公問公孫支，支曰：「饑穰更事耳，不可不與。」問百里傒，傒曰：「夷吾得罪於君，其百姓何罪？」於是用百里傒、公孫支言，卒與之粟。以船漕車轉，自雍相望至絳。","mention_ids":["c-shiji-005-qin:m027-0025","c-shiji-005-qin:m027-0029","c-shiji-005-qin:m027-0075"]},{"chapter_id":"c-shiji-087-lisi","source_id":"s-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p005","quote":"臣聞吏議逐客，竊以為過矣。昔繆公求士，西取由余於戎，東得百里奚於宛，迎蹇叔於宋，來丕豹、公孫支於晉。此五子者，不產於秦，而繆公用之，并國二十，遂霸西戎。孝公用商鞅之法，移風易俗，民以殷盛，國以富彊，百姓樂用，諸侯親服，獲楚、魏之師，舉地千里，至今治彊。惠王用張儀之計，拔三川之地，西并巴、蜀，北收上郡，南取漢中，包九夷，制鄢、郢，東據成皋之險，割膏腴之壤，遂散六國之從，使之西面事秦，功施到今。昭王得范睢，廢穰侯，逐華陽，彊公室，杜私門，蠶食諸侯，使秦成帝業。此四君者，皆以客之功。由此觀之，客何負於秦哉！向使四君卻客而不內，疏士而不用，是使國無富利之實而秦無彊大之名也。","mention_ids":["c-shiji-087-lisi:m005-0044"]}],"rationale":"公孫支與百里傒、丕豹同為秦穆問政的人物組合，與取士五子中的同名秦臣相配；不只據姓名，不補出生地或任職始年。 各篇原文與異說分存，同書不是獨立見證；同指不確證全部事蹟、地域或紀年。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji105-core-004","person_ids":["1ku_2ry_mri"],"canonical_person_id":"1ku_2ry_mri","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-043-zhao","c-shiji-105-bianque"],"status":"contextual_provisional","evidence":[{"work_id":"w-shiji","book_id":"b-shiji-005","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p027","quote":"晉旱，來請粟。丕豹說繆公勿與，因其饑而伐之。繆公問公孫支，支曰：「饑穰更事耳，不可不與。」問百里傒，傒曰：「夷吾得罪於君，其百姓何罪？」於是用百里傒、公孫支言，卒與之粟。以船漕車轉，自雍相望至絳。","mention_ids":["c-shiji-005-qin:m027-0025","c-shiji-005-qin:m027-0029","c-shiji-005-qin:m027-0075"]},{"work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p026","quote":"趙簡子疾，五日不知人，大夫皆懼。醫扁鵲視之，出，董安于問。扁鵲曰：「血脈治也，而何怪！在昔秦繆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有學也。帝告我：「晉國將大亂，五世不安；其後將霸，未老而死；霸者之子且令而國男女無別。」』公孫支書而藏之，秦讖於是出矣。獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之疾與之同，不出三日疾必閒，閒必有言也。」","mention_ids":["c-shiji-043-zhao:m026-0062","c-shiji-043-zhao:m026-0130"]},{"work_id":"w-shiji","book_id":"b-shiji-105","chapter_id":"c-shiji-105-bianque","source_id":"s-shiji-105-bianque","paragraph_id":"c-shiji-105-bianque:p002","quote":"當晉昭公時，諸大夫彊而公族弱，趙簡子為大夫，專國事。簡子疾，五日不知人，大夫皆懼，於是召扁鵲。扁鵲入視病，出，董安于問扁鵲，扁鵲曰：「血脈治也，而何怪！昔秦穆公嘗如此，七日而寤。寤之日，告公孫支與子輿曰：『我之帝所甚樂。吾所以久者，適有所學也。帝告我：「晉國且大亂，五世不安。其後將霸，未老而死。霸者之子且令而國男女無別。」』公孫支書而藏之，秦策於是出。夫獻公之亂，文公之霸，而襄公敗秦師於殽而歸縱淫，此子之所聞。今主君之病與之同，不出三日必閒，閒必有言也。」","mention_ids":["c-shiji-105-bianque:m002-0094","c-shiji-105-bianque:m002-0163"]}],"rationale":"秦穆公大夫公孫支明名；並接合同一夢言中〈趙世家〉的公孫支。 原文、夢中引語與古注分層；同一傳承不當獨立史實證成，不補生卒、夢境人物血親或診病絕對年；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-005-qin:p027","text":"晉旱，來請粟。丕豹說繆公勿與，因其饑而伐之。繆公問公孫支，支曰：「饑穰更事耳，不可不與。」問百里傒，傒曰：「夷吾得罪於君，其百姓何罪？」於是用百里傒、公孫支言，卒與之粟。以船漕車轉，自雍相望至絳。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m027-0007","start":7,"end":9,"surface":"丕豹","kind":"person","person_id":"rlv_clg_euu_A","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0010","start":10,"end":12,"surface":"繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0022","start":22,"end":24,"surface":"繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0025","start":25,"end":28,"surface":"公孫支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0029","start":29,"end":30,"surface":"支","kind":"person","person_id":"1ku_2ry_mri","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0046","start":46,"end":49,"surface":"百里傒","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0050","start":50,"end":51,"surface":"傒","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0054","start":54,"end":56,"surface":"夷吾","kind":"person","person_id":"a9v_t0d_3va","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0071","start":71,"end":74,"surface":"百里傒","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m027-0075","start":