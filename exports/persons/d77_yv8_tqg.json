":"c-sanguozhi-060-lvdai:line051","chapter_id":"c-sanguozhi-060-lvdai"},{"id":"c-sanguozhi-060-lvdai:line051:m0089","start":89,"end":90,"surface":"良","kind":"person","person_id":"d77_yv8_tqg","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-lvdai:line051","chapter_id":"c-sanguozhi-060-lvdai"},{"id":"c-sanguozhi-060-lvdai:line051:m0216","start":216,"end":217,"surface":"良","kind":"person","person_id":"d77_yv8_tqg","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-060-lvdai:line051","chapter_id":"c-sanguozhi-060-lvdai"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-060-lvdai:line051","text":"　　交阯太守士燮卒，權以燮子徽為安遠將軍，領九真太守，以校尉陳時代燮。岱表分海南三郡為交州，以將軍戴良為刺史，海東四郡為廣州，岱自為刺史。遣良與時南入，而徽不承命，舉兵戍海口以拒良等。岱於是上疏請討徽罪，督兵三千人晨夜浮海。或謂岱曰：\"徽藉累世之恩，為一州所附，未易輕也。\"岱曰：\"今徽雖懷逆計，未虞吾之卒至，若我潛軍輕舉，掩其無備，破之必也。稽留不速，使得生心，嬰城固守，七郡百蠻，雲合響應，雖有智者，誰能圖之?\"遂行，過合浦，與良俱進。徽聞岱至，果大震怖，不知所出，即率兄弟六人肉袒迎岱。岱皆斬送其首，徽大將甘醴，桓治等率吏民攻岱，岱奮擊大破之，進封番禺侯。於是除廣州，復為交州如故。岱既定交州，復進討九真，斬獲以萬數。又遣從事南宣國化，暨徼外扶南、林邑、堂明諸王，各遣使奉貢。權嘉其功，進拜鎮南將軍。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-lvdai:line051:m0006","start":6,"end":8,"surface":"士燮","kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line051:m0010","start":10,"end":11,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line051:m0012","start":12,"end":13,"surface":"燮","kind":"person","person_id":"p2p_gqb_6ar","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line051:m0014","start":14,"end":15,"surface":"徽","kind":"person","person_id":"x6j_