orial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-126-huaji:m024-0013","start":13,"end":15,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p024","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-126-huaji:m024-0108","start":108,"end":110,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p024","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-126-huaji:m024-0244","start":244,"end":246,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p024","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-126-huaji:m024-0254","start":254,"end":256,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p024","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-126-huaji:m024-0295","start":295,"end":297,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p024","chapter_id":"c-shiji-126-huaji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-126-huaji:p024","text":"至其時，西門豹往會之河上。三老、官屬、豪長者、裏父老皆會，以人民往觀之者三二千人。其巫，老女子也，已年七十。從弟子女十人所，皆衣繒單衣，立大巫后。西門豹曰：「呼河伯婦來，視其好醜。」即將女出帷中，來至前。豹視之，顧謂三老、巫祝、父老曰：「是女子不好，煩大巫嫗為入報河伯，得更求好女，后日送之。」即使吏卒共抱大巫嫗投之河中。有頃，曰：「巫嫗何久也？弟子趣之！」復以弟子一人投河中。有頃，曰：「弟子何久也？復使一人趣之！」復投一弟子河中。凡投三弟子。西門豹曰：「巫嫗弟子是女子也，不能白事，煩三老為入白之。」復投三老河中。西門豹簪筆磬折，向河立待良久。長老、吏傍觀者皆驚恐。西門豹顧曰：「巫嫗、三老不來還，柰之何？」欲復使廷掾與豪長者一人入趣之。皆叩頭，叩頭且破，額血流地，色如死灰。西門豹曰：「諾，且留待之須臾。」須臾，豹曰：「廷掾起矣。狀河伯留客之久，若皆罷去歸矣。」鄴吏民大驚恐，從是以後，不敢復言為河伯娶婦。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m024-0004","start":4,"end":7,"surface":"西門豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0013","start":13,"end":15,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0024","start":24,"end":26,"surface":"父老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m024-0041","start":41,"end":43,"surface":"其巫","kind":"person","person_id":"msq_cc5_was","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0044","start":44,"end":47,"surface":"老女子","kind":"person","person_id":"msq_cc5_was","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0055","start":55,"end":57,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m024-0069","start":69,"end":71,"surface":"大巫","kind":"person","person_id":"msq_cc5_was","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0073","start":73,"end":76,"surface":"西門豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0080","start":80,"end":83,"surface":"河伯婦","kind":"person","person_id":"u4t_jyh_ag2","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0092","start":92,"end":94,"surface":"將女","kind":"person","person_id":"u4t_jyh_ag2","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0102","start":102,"end":103,"surface":"豹","kind":"person","person_id":"nh2_z0q_c1e","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0108","start":108,"end":110,"surface":"三老","kind":"person","person_id":"ksm_7il_w8n","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m024-0114","start":114,"end":116,"surface":"父老","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m024-0119","start":119,"end":122,"surface":"是女子","kind":"