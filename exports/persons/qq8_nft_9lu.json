3,10694,10695,10696,10697,10698,10699,10700,10701,10702,10703,10704,10705,10706,10707,10708,10709,10710,10711,10712,10713,10714,10715,10716,10717,10718,10719,10720,10721,10722,10723,10724,10725,10726,10727,10728,10729,10730,10731,10732,10733,10734,10735,10736,10737,10738,10739,10740,10741,10742,10743,10744,10745,10746,10747,10748,10749,10750,10751,10752,10753,10754,10755,10756,10757,10758,10759,10760,10761,10762,10763,10764,10765,10766,10767,10768,10769,10770,10771,10772,10773,10774,10775],"projection_sha256":"89a4baa04a2168c2ae319792f8d8f64540accac2f719f9a6cbdbd3163a6773fb"},"chapter_id":"c-nanshi-022-wangzhi-digital","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangzhi-digital-ws1477957"},{"id":"c-nanshi-022-wangzhi:p001","text":"志字次道慈之弟也九嵗居所生母憂哀容毁瘠為中表所異弱冠選尚宋孝武女安固公主拜駙馬都尉褚彦囘為司徒引志為主簿謂其父僧虔曰朝廷之恩本為殊特所可光榮在屈賢子累遷宣城内史清謹有恩恵郡人張倪吴慶争田經年不決志到官父老相謂曰王府君有徳政吾鄉里乃有如此争倪慶因相擕請罪所訟地遂成閒田後為東陽太守郡獄有重囚十餘冬至日悉遣還家過節皆反唯一人失期志曰此自太守事主者勿憂眀旦果至以婦孕吏人益歎服之為吏部尚書在選以和理稱崔慧景平以例加右軍将軍封臨汝侯固讓改領右衛将軍及梁武軍至城内殺東昏百僚署名送首志歎曰冠雖弊可加足乎因取庭樹葉挼服之偽悶不署名梁武覽牋無志署心嘉之弗以讓也霸府開為驃騎大将軍長史梁臺建位散騎常侍中書令天監初為丹陽尹為政清静都下有寡婦無子姑亡舉責以斂葬既而無以還之志愍其義以俸錢償焉時年饑每旦為粥於郡門以賦百姓衆悉稱恵常懷止足謂諸子姪曰謝莊在宋孝武時位止中書令吾自視豈可過之三年為散騎常侍中書令因多謝病簡通賓客九年遷為散騎常侍金紫光禄大夫卒志善藁隷當時以為楷法齊游擊将軍徐希秀亦號能書常謂志為書聖志家居建康禁中里馬糞巷父僧䖍門風寛恕志尤惇厚所厯不以罪咎劾人門下客嘗盜脱志車幰賣之志知而不問待之如初賓客遊其門者専盖其過而稱其善兄弟子姪皆篤實謙和時人號馬糞諸王為長者普通四年志改葬武帝厚賻贈之諡曰安有五子緝休諲操素志弟揖位太中大夫揖子筠","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"first_line":469,"last_line":498,"revision_id":"3c7bdbb072bf8e1eb70d134a94570c4b8de058ea","editorial_excerpt_boundary":true},"mentions":[{"id":"c-nanshi-022-wangzhi:p001:m0000","start":0,"end":1,"surface":"志","person_id":"7r6_k52_qji_ABAAAAEBC","kind":"person","status":"contextual_provisional","interpretation_note":"完整王志附傳具名或已核跨篇身份，不以近名猜生父。"},{"id":"c-nanshi-022-wangzhi:p001:m0002","start":2,"end":4,"surface":"次道","person_id":"7r6_k52_qji_ABAAAAEBC","kind":"person","status":"contextual_provisional","interpretation_note":"完整王志附傳具名或已核跨篇身份，不以近名猜生父。"},{"id":"c-nanshi-022-wangzhi:p0