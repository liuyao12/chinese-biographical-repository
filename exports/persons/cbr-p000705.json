:723,"end":727,"surface":"西楚霸王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:p023","text":"田榮聞項羽徙齊王市膠東，而立齊將田都為齊王，乃大怒，不肯遣齊王之膠東，因以齊反，迎擊田都。田都走楚。齊王市畏項王，乃亡之膠東就國。田榮怒，追擊殺之即墨。榮因自立為齊王，而西殺擊濟北王田安，并王三齊。榮與彭越將軍印，令反梁地。陳餘陰使張同、夏說說齊王田榮曰：「項羽為天下宰，不平。今盡王故王於醜地，而王其群臣諸將善地，逐其故主趙王，乃北居代，餘以為不可。聞大王起兵，且不聽不義，願大王資餘兵，請以擊常山，以復趙王，請以國為捍蔽。」齊王許之，因遣兵之趙。陳餘悉發三縣兵，與齊并力擊常山，大破之。張耳走歸漢。陳餘迎故趙王歇於代，反之趙。趙王因立陳餘為代王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m023-0000","start":0,"end":2,"surface":"田榮","kind":"person","person_id":"cbr-p000665","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m023-0003","start":3,"end":5,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m023-0006","start":6,"end":9,"surface":"齊王市","kind":"person","person_id":"cbr-p000683","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m023-0016","start":16,"end":18,"surface":"田都","kind":"person","person_id":"cbr-p000704","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m023-0019","start":19,"end":21,"surface":"齊王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m023-0029","start":29,"end":31,"surface":"齊王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m023-0042","start":42,"end":44,"surface":"田都","kind":"person","person_id":"cbr-p000704","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m023-0045","start":45,"end":47,"surface":"田都","kind":"person","person_id":"cbr-p000704","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m023-0050","start":50,"end":53,"surface":"齊王市","kind":"person","person_id":"cbr-p000683"