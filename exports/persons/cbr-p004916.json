{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004916","identity_policy":"contextual_provisional","person_ids":["cbr-p004916"],"persons":[{"id":"cbr-p004916","label":"樓季引古（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"樓季","mention_ids":["c-shiji-087-lisi:m024-0195","c-shiji-087-lisi:m024-0217"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m024-0195","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p024","quote":"樓季"},{"mention_id":"c-shiji-087-lisi:m024-0217","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p024","quote":"樓季"}]}],"source_mention_summary":[{"source_id":"s-shiji-087-lisi","work_id":"w-shiji","book_id":"b-shiji-087","chapter_id":"c-shiji-087-lisi","mention_count":2,"mention_ids":["c-shiji-087-lisi:m024-0195","c-shiji-087-lisi:m024-0217"],"paragraph_ids":["c-shiji-087-lisi:p024"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-087-lisi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-087-lisi:m024-0195","start":195,"end":197,"surface":"樓季","kind":"person","person_id":"cbr-p004916","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p024","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m024-0217","start":217,"end":219,"surface":"樓季","kind":"person","person_id":"cbr-p004916","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p024","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-049","person_id":"cbr-p004916","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依二世用高及督責書局部承接暫接；第19段趙高之高排除高枕普通詞，第20段公子高與趙高分開；廣等只按吳廣兵承接，不標廣欲。堯禹標示傳說性，韓子商君與申韓未以模型記憶補名或全域合併；嵌套引語仍待核。","reviewer":"Codex（AI 代理）","surfaces":["樓季"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p024","quote":"故韓子曰：「慈母有敗子而嚴家無格虜」者，何也？則能罰之加焉必也。故商君之法，刑棄灰於道者。夫棄灰，薄罪也，而被刑，重罰也。彼唯明主為能深督輕罪。夫罪輕且督深，而況有重罪乎？故民不敢犯也。是故韓子曰「布帛尋常，庸人不釋，鑠金百溢，盜跖不搏」者，非庸人之心重，尋常之利深，而盜跖之欲淺也；又不以盜跖之行，為輕百鎰之重也。搏必隨手刑，則盜跖不搏百鎰；而罰不必行也，則庸人不釋尋常。是故城高五丈，而樓季不輕犯也；泰山之高百仞，而跛䍧牧其上。夫樓季也而難五丈之限，豈跛䍧也而易百仞之高哉？峭塹之勢異也。明主聖王之所以能久處尊位，長執重勢，而獨擅天下之利者，非有異道也，能獨斷而審督責，必深罰，故天下不敢犯也。今不務所以不犯，而事慈母之所以敗子也，則亦不察於聖人之論矣。夫不能行聖人之術，則舍為天下役何事哉？可不哀邪！"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p024","text":"故韓子曰：「慈母有敗子而嚴家無格虜」者，何也？則能罰之加焉必也。故商君之法，刑棄灰於道者。夫棄灰，薄罪也，而被刑，重罰也。彼唯明主為能深督輕罪。夫罪輕且督深，而況有重罪乎？故民不敢犯也。是故韓子曰「布帛尋常，庸人不釋，鑠金百溢，盜跖不搏」者，非庸人之心重，尋常之利深，而盜跖之欲淺也；又不以盜跖之行，為輕百鎰之重也。搏必隨手刑，則盜跖不搏百鎰；而罰不必行也，則庸人不釋尋常。是故城高五丈，而樓季不輕犯也；泰山之高百仞，而跛䍧牧其上。夫樓季也而難五丈之限，豈跛䍧也而易百仞之高哉？峭塹之勢異也。明主聖王之所以能久處尊位，長執重勢，而獨擅天下之利者，非有異道也，能獨斷而審督責，必深罰，故天下不敢犯也。今不務所以不犯，而事慈母之所以敗子也，則亦不察於聖人之論矣。夫不能行聖人之術，則舍為天下役何事哉？可不哀邪！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m024-0001","start":1,"end":3,"surface":"韓子","kind":"person","person_id":"cbr-p004910","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m024-0006","start":6,"end":8,"surface":"慈母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，未補特定個人或世系。"},{"id":"c-shiji-087-lisi:m024-0009","start":9,"end":11,"surface":"敗子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，未補特定個人或世系。"},{"id":"c-shiji-087-lisi:m024-0015","start":15,"end":17,"surface":"格虜","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，未補特定個人或世系。"},{"id":"c-shiji-087-lisi:m024-0033","start":33,"end":35,"surface":"商君","kind":"person","person_id":"cbr-p004914","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m024-0063","start":63,"end":65,"surface":"明主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，未補特定個人或世系。"},{"id":"c-shiji-087-lisi:m024-0095","start":95,