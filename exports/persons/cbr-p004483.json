ual_provisional"},{"id":"c-shiji-005-qin:m069-0269","start":269,"end":271,"surface":"樓緩","kind":"person","person_id":"cbr-p000506","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0320","start":320,"end":323,"surface":"楚懷王","kind":"person","person_id":"cbr-p000505","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0345","start":345,"end":347,"surface":"樓緩","kind":"person","person_id":"cbr-p000506","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0349","start":349,"end":353,"surface":"穰侯魏冉","kind":"person","person_id":"cbr-p000507","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-072-rang:p002","text":"秦武王卒，無子，立其弟為昭王。昭王母故號為羋八子，及昭王即位，羋八子號為宣太后。宣太后非武王母。武王母號曰惠文后，先武王死。宣太后二弟：其異父長弟曰穰侯，姓魏氏，名冉；同父弟曰羋戎，為華陽君。而昭王同母弟曰高陵君、涇陽君。而魏冉最賢，自惠王、武王時任職用事。武王卒，諸弟爭立，唯魏冉力為能立昭王。昭王即位，以冉為將軍，衛咸陽。誅季君之亂，而逐武王后出之魏，昭王諸兄弟不善者皆滅之，威振秦國。昭王少，宣太后自治，任魏冉為政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-072-rang:m002-0000","start":0,"end":3,"surface":"秦武王","kind":"person","person_id":"cbr-p004200","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m002-0009","start":9,"end":11,"surface":"其弟","kind":"person","person_id":"cbr-p004198","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m002-0012","start":12,"end":14,"surface":"昭王","kind":"person","person_id":"cbr-p004198","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m002-0015","start":15,"end":17,"surface":"昭王","kind":"person","person_id":"cbr-p004198","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m002-0021","start":21,"end":24,"surface":"羋八子","kind":"person","person_id":"cbr-p004199","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m002-0026","start":26,"end":28,"surface":"昭王","kind":"person","person_id":"cbr-p004198","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m002-0031","start":31,"end":34,"