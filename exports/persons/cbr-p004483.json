cbr-p004202","status":"contextual_provisional","paragraph_id":"c-shiji-072-rang:p002","chapter_id":"c-shiji-072-rang"},{"id":"c-shiji-079-fancai:m007-0003","start":3,"end":6,"surface":"華陽君","kind":"person","person_id":"cbr-p004483","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p007","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m017-0050","start":50,"end":52,"surface":"華陽","kind":"person","person_id":"cbr-p004483","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p017","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m017-0104","start":104,"end":106,"surface":"華陽","kind":"person","person_id":"cbr-p004483","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p017","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m017-0346","start":346,"end":348,"surface":"華陽","kind":"person","person_id":"cbr-p004483","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p017","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-079-fancai:m017-0513","start":513,"end":515,"surface":"華陽","kind":"person","person_id":"cbr-p004483","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p017","chapter_id":"c-shiji-079-fancai"}],"relations":[{"id":"a-shiji072-005","subject_person_id":"cbr-p004202","predicate":"brother","object_person_id":"cbr-p004199","status":"source_attested","evidence":[{"chapter_id":"c-shiji-072-rang","source_id":"s-shiji-072-rang","paragraph_id":"c-shiji-072-rang:p002","quote":"秦武王卒，無子，立其弟為昭王。昭王母故號為羋八子，及昭王即位，羋八子號為宣太后。宣太后非武王母。武王母號曰惠文后，先武王死。宣太后二弟：其異父長弟曰穰侯，姓魏氏，名冉；同父弟曰羋戎，為華陽君。而昭王同母弟曰高陵君、涇陽君。而魏冉最賢，自惠王、武王時任職用事。武王卒，諸弟爭立，唯魏冉力為能立昭王。昭王即位，以冉為將軍，衛咸陽。誅季君之亂，而逐武王后出之魏，昭王諸兄弟不善者皆滅之，威振秦國。昭王少，宣太后自治，任魏冉為政。"}],"qualifiers":{"source_term":"同父弟曰羋戎","historicity":"historical_tradition"},"interpretation_note":"依明示母與弟保存；異父長弟以宣太后為參照，同父弟亦以宣太后為參照；同母弟以昭王為參照。限定語不轉成未載父親名字或補造母系世次。原文宣太后非武王母保留作反證；兄弟不自動補父母，繼位不作父子。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji079-003","subject_person_id":"cbr-p004483","predicate":"brother","object_person_id":"cbr-p004484","status":"source_attested","evidence":[{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p007","quote":"穰侯，華陽君，昭王母宣太后之弟也；而涇陽君、高陵君皆昭王同母弟也。穰侯相，三人者更將，有封邑，以太后故，私家富重於王室。及穰侯為秦將，且欲越韓、魏而伐齊綱壽，欲以廣其陶封。范睢乃上書曰："}],"qualifiers":{"source_term":"宣太后之弟","historicity":"historical_tradition"},"interpretation_note":"只保存來源明示母、弟與同母關係，同段昭王母宣及同母弟接共同母親；不補父親。范叔父、管仲父與呂太公尊稱不當血緣。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji072-005","person_id":"cbr-p004202","title":"華陽君","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-072-rang","source_id":"s-shiji-072-rang","paragraph_id":"c-shiji-072-rang:p002","quote":"秦武王卒，無子，立其弟為昭王。昭王母故號為羋八子，及昭王即位，羋八子號為宣太后。宣太后非武王母。武王母號曰惠文后，先武王死。宣太后二弟：其異父長弟曰穰侯，姓魏氏，名冉；同父弟曰羋戎，為華陽君。而昭王同母弟曰高陵君、涇陽君。而魏冉最賢，自惠王、武王時任職用事。武王卒，諸弟爭立，唯魏冉力為能立昭王。昭王即位，以冉為將軍，衛咸陽。誅季君之亂，而逐武王后出之魏，昭王諸兄弟不善者皆滅之，威振秦國。昭王少，宣太后自治，任魏冉為政。"}],"attestations":[{"id":"th-shiji072-005:a001","paragraph_id":"c-shiji-072-rang:p002","start":92,"end":95,"surface":"華陽君","person_mention_id":"c-shiji-072-rang:m002-0092","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、授官與單純用稱分存，反覆任相各保存來源事件；未知曆日不補，時長保留原引文。免相國不自動終止穰侯爵、將軍或其他官爵，卒與收陶亦不作所有稱號共同終點。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji079-006","person_id":"cbr-p004483","title":"華陽君","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p007","quote":"穰侯，華陽君，昭王母宣太后之弟也；而涇陽君、高陵君皆昭王同母弟也。穰侯相，三人者更將，有封邑，以太后故，私家富重於王室。及穰侯為秦將，且欲越韓、魏而伐齊綱壽，欲以廣其陶封。范睢乃上書曰："}],"attestations":[{"id":"th-shiji079-006:a001","paragraph_id":"c-shiji-079-fancai:p007","start":3,"end":6,"surface":"華陽君","person_mention_id":"c-shiji-079-fancai:m007-0003","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任、實際去職及用稱分存，首次出現、降敵、出走、被誅與死亡不自動終止全部官爵；叔父仲父太公為尊稱不推血緣。擬長為應侯、稱孤與黃金印紫綬願望不當實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji072-007","person_id":"cbr-p004202","surfaces":["羋戎","華陽君"],"scope":"same_chapter","chapter_ids":["c-shiji-072-rang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-072-rang:p002","quote":"秦武王卒，無子，立其弟為昭王。昭王母故號為羋八子，及昭王即位，羋八子號為宣太后。宣太后非武王母。武王母號曰惠文后，先武王死。宣太后二弟：其異父長弟曰穰侯，姓魏氏，名冉；同父弟曰羋戎，為華陽君。而昭王同母弟曰高陵君、涇陽君。而魏冉最賢，自惠王、武王時任職用事。武王卒，諸弟爭立，唯魏冉力為能立昭王。昭王即位，以冉為將軍，衛咸陽。誅季君之亂，而逐武王后出之魏，昭王諸兄弟不善者皆滅之，威振秦國。昭王少，宣太后自治，任魏冉為政。"}],"rationale":"依前3段明示稱名與局部敘事暫接，魏冉穰侯與宣太后羋八子相配。武王后與武王分開，仇液公稱與內嵌樓緩受話的公稱分辨。異父同父同母各按相對敘事保留，不補父親名字；惠文后非宣太后，同姓族屬不全域接人物。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji079-012","person_id":"cbr-p004483","surfaces":["華陽","華陽君"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p007","quote":"穰侯，華陽君，昭王母宣太后之弟也；而涇陽君、高陵君皆昭王同母弟也。穰侯相，三人者更將，有封邑，以太后故，私家富重於王室。及穰侯為秦將，且欲越韓、魏而伐齊綱壽，欲以廣其陶封。范睢乃上書曰："},{"paragraph_id":"c-shiji-079-fancai:p017","quote":"范睢日益親，復說用數年矣，因請閒說曰：「臣居山東時，聞齊之有田文，不聞其有王也；聞秦之有太后、穰侯、華陽、高陵、涇陽，不聞其有王也。夫擅國之謂王，能利害之謂王，制殺生之威之謂王。今太后擅行不顧，穰侯出使不報，華陽、涇陽等擊斷無諱，高陵進退不請。四貴備而國不危者，未之有也。為此四貴者下，乃所謂無王也。然則權安得不傾，令安得從王出乎？臣聞善治國者，乃內固其威而外重其權。穰侯使者操王之重，決制於諸侯，剖符於天下，政適伐國，莫敢不聽。戰勝攻取則利歸於陶，國獘御於諸侯；戰敗則結怨於百姓，而禍歸於社稷。《詩》曰『木實繁者披其枝，披其枝者傷其心；大其都者危其國，尊其臣者卑其主』。崔杼、淖齒管齊，射王股，擢王筋，縣之於廟梁，宿昔而死。李兌管趙，囚主父於沙丘，百日而餓死。今臣聞秦太后、穰侯用事，高陵、華陽、涇陽佐之，卒無秦王，此亦淖齒、李兌之類也。且夫三代所以亡國者，君專授政，縱酒馳騁弋獵，不聽政事。其所授者，妒賢嫉能，御下蔽上，以成其私，不為主計，而主不覺悟，故失其國。今自有秩以上至諸大吏，下及王左右，無非相國之人者。見王獨立於朝，臣竊為王恐，萬世之後，有秦國者非王子孫也。」昭王聞之大懼，曰：「善。」於是廢太后，逐穰侯、高陵、華陽、涇陽君於關外。秦王乃拜范睢為相。收穰侯之印，使歸陶，因使縣官給車牛以徙，千乘有餘。到關，關閱其寶器，寶器珍怪多於王室。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji079-hua","person_ids":["cbr-p000497","cbr-p004202","cbr-p004483"],"canonical_person_id":"cbr-p000497","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-072-rang","c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p069","quote":"昭襄王元年，嚴君疾為相。甘茂出之魏。二年，彗星見。庶長壯與大臣、諸侯、公子為逆，皆誅，及惠文后皆不得良死。悼武王后出歸魏。三年，王冠。與楚王會黃棘，與楚上庸。四年，取蒲阪。彗星見。五年，魏王來朝應亭，復與魏蒲阪。六年，蜀侯煇反，司馬錯定蜀。庶長奐伐楚，斬首二萬。涇陽君質於齊。日食，晝晦。七年，拔新城。摢裏子卒。八年，使將軍羋戎攻楚，取新市。齊使章子，魏使公孫喜，韓使暴鳶共攻楚方城，取唐眛。趙破中山，其君亡，竟死齊。魏公子勁、韓公子長為諸侯。九年，孟嘗君薛文來相秦。奐攻楚，取八城，殺其將景快。十年，楚懷王入朝秦，秦留之。薛文以金受免。樓緩為丞相。十一年，齊、韓、魏、趙、宋、中山五國共攻秦，至鹽氏而還。秦與韓、魏河北及封陵以和。彗星見。楚懷王走之趙，趙不受，還之秦，即死，歸葬。十二年，樓緩免，穰侯魏冉為相。予楚粟五萬石。","mention_ids":["c-shiji-005-qin:m069-0160"]},{"chapter_id":"c-shiji-072-rang","source_id":"s-shiji-072-rang","paragraph_id":"c-shiji-072-rang:p002","quote":"秦武王卒，無子，立其弟為昭王。昭王母故號為羋八子，及昭王即位，羋八子號為宣太后。宣太后非武王母。武王母號曰惠文后，先武王死。宣太后二弟：其異父長弟曰穰侯，姓魏氏，名冉；同父弟曰羋戎，為華陽君。而昭王同母弟曰高陵君、涇陽君。而魏冉最賢，自惠王、武王時任職用事。武王卒，諸弟爭立，唯魏冉力為能立昭王。昭王即位，以冉為將軍，衛咸陽。誅季君之亂，而逐武王后出之魏，昭王諸兄弟不善者皆滅之，威振秦國。昭王少，宣太后自治，任魏冉為政。","mention_ids":["c-shiji-072-rang:m002-0088","c-shiji-072-rang:m002-0092"]},{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p007","quote":"穰侯，華陽君，昭王母宣太后之弟也；而涇陽君、高陵君皆昭王同母弟也。穰侯相，三人者更將，有封邑，以太后故，私家富重於王室。及穰侯為秦將，且欲越韓、魏而伐齊綱壽，欲以廣其陶封。范睢乃上書曰：","mention_ids":["c-shiji-079-fancai:m007-0003"]}],"rationale":"秦本紀將軍羋戎、穰侯傳明稱羋戎為華陽君且為宣太后同父弟，本篇華陽君同列宣太后弟，姓名爵稱橋接及親屬配置支持暫同指；本篇未見羋戎姓名不回填正文。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-005-qin:p069","text":"昭襄王元年，嚴君疾為相。甘茂出之魏。二年，彗星見。庶長壯與大臣、諸侯、公子為逆，皆誅，及惠文后皆不得良死。悼武王后出歸魏。三年，王冠。與楚王會黃棘，與楚上庸。四年，取蒲阪。彗星見。五年，魏王來朝應亭，復與魏蒲阪。六年，蜀侯煇反，司馬錯定蜀。庶長奐伐楚，斬首二萬。涇陽君質於齊。日食，晝晦。七年，拔新城。摢裏子卒。八年，使將軍羋戎攻楚，取新市。齊使章子，魏使公孫喜，韓使暴鳶共攻楚方城，取唐眛。趙破中山，其君亡，竟死齊。魏公子勁、韓公子長為諸侯。九年，孟嘗君薛文來相秦。奐攻楚，取八城，殺其將景快。十年，楚懷王入朝秦，秦留之。薛文以金受免。樓緩為丞相。十一年，齊、韓、魏、趙、宋、中山五國共攻秦，至鹽氏而還。秦與韓、魏河北及封陵以和。彗星見。楚懷王走之趙，趙不受，還之秦，即死，歸葬。十二年，樓緩免，穰侯魏冉為相。予楚粟五萬石。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m069-0000","start":0,"end":3,"surface":"昭襄王","kind":"person","person_id":"cbr-p000308","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0006","start":6,"end":9,"surface":"嚴君疾","kind":"person","person_id":"cbr-p000490","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0012","start":12,"end":14,"surface":"甘茂","kind":"person","person_id":"cbr-p000482","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0025","start":25,"end":28,"surface":"庶長壯","kind":"person","person_id":"cbr-p000491","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0044","start":44,"end":47,"surface":"惠文后","kind":"person","person_id":"cbr-p000492","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0053","start":53,"end":57,"surface":"悼武王后","kind":"person","person_id":"cbr-p000493","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0068","start":68,"end":70,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m069-0093","start":93,"end":95,"surface":"魏王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m069-0109","start":109,"end":112,"surface":"蜀侯煇","kind":"person","person_id":"cbr-p000494","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0114","start":114,"end":117,"surface":"司馬錯","kind":"person","person_id":"cbr-p000470","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0120","start":120,"end":123,"surface":"庶長奐","kind":"person","person_id":"cbr-p000495","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0131","start":131,"end":134,"surface":"涇陽君","kind":"person","