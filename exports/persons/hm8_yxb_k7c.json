licy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-054-recluses-complete:p006:m0145","start":145,"end":148,"surface":"崔思祖","kind":"person","person_id":"hm8_yxb_k7c","status":"contextual_provisional","paragraph_id":"c-nanqishu-054-recluses-complete:p006","chapter_id":"c-nanqishu-054-recluses-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-054-recluses-complete:p006","text":"　　昇明中，太祖爲太傅，教辟僧紹及顧歡、臧榮緒以旍幣之禮，徵爲記室參軍，不至。僧紹弟慶符，爲青州，僧紹乏糧食，隨慶符之鬱洲，住弇榆山，栖雲精舍，欣玩水石，竟不一入州城。建元元年冬，詔曰：「朕側席思士，載懷塵外。齊郡明僧紹標志高栖，耽情墳素，幽貞之操，宜加賁飾。」徵爲正員郎，稱疾不就。其後與崔思祖書曰：「明居士標意可重，吾前旨竟未達邪？小敘欲有講事，卿可至彼，具述吾意，令與慶符俱歸。」又曰：「不食周粟而食周薇，古猶發議。在今寧得息談邪？聊以爲笑。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":30,"last_line":30,"raw_start":1082,"raw_end":1307,"raw_character_offsets":[1082,1083,1084,1085,1086,1087,1088,1089,1090,1091,1092,1093,1094,1095,1096,1097,1098,1099,1100,1101,1102,1103,1104,1105,1106,1107,1108,1109,1110,1111,1112,1113,1114,1115,1116,1117,1118,1119,1120,1121,1122,1123,1124,1125,1126,1127,1128,1129,1130,1131,1132,1133,1134,1135,1136,1137,1138,1139,1140,1141,1142,1143,1144,1145,1146,1147,1148,1149,1150,1151,1152,1153,1154,1155,1156,1157,1158,1159,1160,1161,1162,1163,1164,1165,1166,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201,1202,1203,1204,1205,1206,1207,1208,1209,1210,1211,1212,1213,1214,1215,1216,1217,1218,1219,1220,1221,1222,1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1