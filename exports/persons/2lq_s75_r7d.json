zx_gu2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0022","start":22,"end":25,"surface":"左將軍","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0030","start":30,"end":33,"surface":"夏侯淵","kind":"person","person_id":"2lq_s75_r7d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0036","start":36,"end":38,"surface":"關羽","kind":"person","person_id":"1c2_03c_9ea","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0053","start":53,"end":55,"surface":"樊本","kind":"person","person_id":"y2s_qto_s79","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0062","start":62,"end":64,"surface":"孫規","kind":"person","person_id":"s6s_upi_dzw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0124","start":124,"end":126,"surface":"子太","kind":"person","person_id":"w6s_yzx_gu2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line071:m0159","start":159,"end":161,"surface":"子太","kind":"person","person_id":"w6s_yzx_gu2","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":71,"last_line":71,"revision_id":2387393,"raw_start":11208,"raw_end":11489,"character_positions":[11216,11217,11218,11219,11220,11221,11222,11223,11224,11225,11226,11227,11228,11229,11230,11231,11232,11233,11234,11235,11236,11237,11238,11239,11240,11241,11242,11243,11244,11245,11246,11247,11248,11249,11250,11251,11252,11253,11254,11255,11256,11257,11258,11259,11260,11261,11262,11263,11264,11265,11266,11267,11268,11269,11270,11271,11272,11273,11274,11275,11276,11277,11278,11279,11280,11281