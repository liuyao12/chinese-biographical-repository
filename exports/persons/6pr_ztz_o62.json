公犇隨。而吳兵遂入郢。子胥、伯嚭鞭平王之屍以報父讎。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m028-0003","start":3,"end":5,"surface":"吳王","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0005","start":5,"end":7,"surface":"闔廬","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0008","start":8,"end":11,"surface":"伍子胥","kind":"person","person_id":"kk7_tis_vis","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0012","start":12,"end":14,"surface":"孫武","kind":"person","person_id":"rwy_xtw_1wg","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0040","start":40,"end":42,"surface":"子常","kind":"person","person_id":"c29_dz7_9t4","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0067","start":67,"end":69,"surface":"闔廬","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0100","start":100,"end":102,"surface":"吳王","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0102","start":102,"end":104,"surface":"闔廬","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0105","start":105,"end":107,"surface":"夫槩","kind":"person","person_id":"ijk_q79_sjg","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0110","start":110,"end":112,"surface":"闔廬","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0115","start":115,"end":117,"surface":"夫槩","kind":"person","person_id":"ijk_q79_sjg","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m028-0158","start":158,"end":160,"surface":"吳王","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual