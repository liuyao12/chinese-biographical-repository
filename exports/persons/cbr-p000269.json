l"}],"mentions":[{"id":"c-shiji-004-zhou:m060-0070","start":70,"end":73,"surface":"晉定公","kind":"person","person_id":"cbr-p000269","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p060","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-005-qin:m046-0049","start":49,"end":52,"surface":"晉定公","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p046","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-031-wu:m037-0101","start":101,"end":104,"surface":"晉定公","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-031-wu:p037","chapter_id":"c-shiji-031-wu"},{"id":"c-shiji-031-wu:m037-0120","start":120,"end":123,"surface":"晉定公","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-031-wu:p037","chapter_id":"c-shiji-031-wu"},{"id":"c-shiji-031-wu:m037-0144","start":144,"end":147,"surface":"晉定公","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-031-wu:p037","chapter_id":"c-shiji-031-wu"},{"id":"c-shiji-039-jin:m128-0009","start":9,"end":12,"surface":"定公午","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p128","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m128-0014","start":14,"end":16,"surface":"定公","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p128","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m129-0040","start":40,"end":42,"surface":"定公","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p129","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m130-0004","start":4,"end":6,"surface":"定公","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p130","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m132-0005","start":5,"end":7,"surface":"定公","kind":"person","person_id":"cbr-p000269","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p132","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji031-021","person_id":"cbr-p000269","surfaces":["晉定公"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-031-wu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p060","quote":"敬王元年，晉人入敬王，子朝自立，敬王不得入，居澤。四年，晉率諸侯入敬王于周，子朝為臣，諸侯城周。十六年，子朝之徒復作亂，敬王奔于晉。十七年，晉定公遂入敬王于周。"},{"paragraph_id":"c-shiji-031-wu:p037","quote":"十四年春，吳王北會諸侯於黃池，欲霸中國以全周室。六月子，越王句踐伐吳。乙酉，越五千人與吳戰。丙戌，虜吳太子友。丁亥，入吳。吳人告敗於王夫差，夫差惡其聞也。或泄其語，吳王怒，斬七人於幕下。七月辛丑，吳王與晉定公爭長。吳王曰：「於周室我爲長。」晉定公曰：「於姬姓我爲伯。」趙鞅怒，將伐吳，乃長晉定公。吳王已盟，與晉別，欲伐宋。太宰嚭曰：「可勝而不能居也。」乃引兵歸國。國亡太子，內空，王居外久，士皆罷敝，於是乃使厚幣以與越平。"}],"rationale":"按本卷弑僚代立、伐楚入郢、吳越戰事或所引夏史的敘事語境暫定異稱；光／闔廬、伍員／子胥及子常／囊瓦有具體事件相接。前卷闔閭與本卷闔廬原字並存；來源記載不等於已校定史實。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-036","person_id":"cbr-p000269","surfaces":["定公","定公午"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p060","quote":"敬王元年，晉人入敬王，子朝自立，敬王不得入，居澤。四年，晉率諸侯入敬王于周，子朝為臣，諸侯城周。十六年，子朝之徒復作亂，敬王奔于晉。十七年，晉定公遂入敬王于周。"},{"paragraph_id":"c-shiji-039-jin:p128","quote":"十四年，頃公卒，子定公午立。定公十一年，魯陽虎奔晉，趙鞅簡子捨之。十二年，孔子相魯。"},{"paragraph_id":"c-shiji-039-jin:p129","quote":"十五年，趙鞅使邯鄲大夫午，不信，欲殺午，午與中行寅、范吉射親攻趙鞅，鞅走保晉陽。定公圍晉陽。荀櫟、韓不信、魏侈與范、中行爲仇，乃移兵伐范、中行。范、中行反，晉君撃之，敗范、中行。范、中行走朝歌，保之。韓、魏爲趙鞅謝晉君，乃赦趙鞅，復位。二十二年，晉敗范、中行氏，二子奔齊。"},{"paragraph_id":"c-shiji-039-jin:p130","quote":"三十年，定公與呉王夫差會黃池，爭長，趙鞅時從，卒長呉。"},{"paragraph_id":"c-shiji-039-jin:p132","quote":"三十七年，定公卒，子出公鑿立。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p060","text":"敬王元年，晉人入敬王，子朝自立，敬王不得入，居澤。四年，晉率諸侯入敬王于周，子朝為臣，諸侯城周。十六年，子朝之徒復作亂，敬王奔于晉。十七年，晉定公遂入敬王于周。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m060-0000","start":0,"end":2,"surface":"敬王","kind":"person","person_id":"cbr-p000268","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0008","start":8,"end":10,"surface":"敬王","kind":"person","person_id":"cbr-p000268","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0011","start":11,"end":13,"surface":"子朝","kind":"person","person_id":"cbr-p000266","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0016","start":16,"end":18,"surface":"敬王","kind":"person","person_id":"cbr-p000268","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0033","start":33,"end":35,"surface":"敬王","kind":"person","person_id":"cbr-p000268","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0038","start":38,"end":40,"surface":"子朝","kind":"person","person_id":"cbr-p000266","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0052","start":52,"end":54,"surface":"子朝","kind":"person","person_id":"cbr-p000266","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0060","start":60,"end":62,"surface":"敬王","kind":"person","person_id":"cbr-p000268","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0070","start":70,"end":73,"surface":"晉定公","kind":"person","person_id":"cbr-p000269","status":"source_identified"},{"id":"c-shiji-004-zhou:m060-0075","start":75,"end":77,"surface":"敬王","kind":"person","person_id":"cbr-p000268","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-005-qin:p046","text":"悼公二年，齊臣田乞弒其君孺子，立其兄陽生，是為悼公。六年，吳敗齊師。齊人弒悼公，立其子簡公。九年，晉定公與吳王夫差盟，爭長於黃池，卒先吳。吳彊，陵中國。十二年，齊田常弒簡公，立其弟平公，常相之。十三年，楚滅陳。秦悼公立十四年卒，子厲共公立。孔子以悼公十二年卒。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m046-0000","start":0,"end":2,"surface":"悼公","kind":"person","person_id":"cbr-p000430","status":"contextual_provisional"},{"id":"c-shiji-005-qin: