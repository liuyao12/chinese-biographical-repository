:m040-0365","start":365,"end":367,"surface":"平公","kind":"person","person_id":"cbr-p002192","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m040-0368","start":368,"end":370,"surface":"叔向","kind":"person","person_id":"cbr-p002200","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m040-0387","start":387,"end":389,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p041","text":"二十七年夏，鄭簡公朝晉。冬，畏楚靈王之彊，又朝楚，子産從。二十八年，鄭君病，使子産會諸侯，與楚靈王盟於申，誅齊慶封。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m041-0006","start":6,"end":9,"surface":"鄭簡公","kind":"person","person_id":"cbr-p002187","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0015","start":15,"end":18,"surface":"楚靈王","kind":"person","person_id":"cbr-p002201","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0025","start":25,"end":27,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0034","start":34,"end":36,"surface":"鄭君","kind":"person","person_id":"cbr-p002187","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0039","start":39,"end":41,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0046","start":46,"end":49,"surface":"楚靈王","kind":"person","person_id":"cbr-p002201","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m041-0054","start":54,"end":57,"surface":"齊慶封","kind":"person","person_id":"cbr-p002202","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p044","text":"四年，晉昭公卒，其六卿彊，公室卑。子産謂韓宣子曰：「爲政必以德，毋忘所以立。」六年，鄭火，公欲禳之。子産曰：「不如修德。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m044-0003","start":3,"end":6,"surface":"晉昭公","kind":"person","person_id":"cbr-p002204","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m044-0008","start":8,"end":11,"surface":"其六卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、述贊省稱、譬喻或未定指代保留，不補姓名或關係。"},{"id":"c-shiji-042-zheng:m044-0017","start":17,"end":19,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m044-0020","start":20,"end":23,"surface":"韓宣子","kind":"person","person_id":"cbr-p002206","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m044-0045","start":45,"end":46,"surface":"公","kind":"person","person_id":"cbr-p002203","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m044-0050","start":50,"end":52,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p049","text":"聲公五年，鄭相子産卒，鄭人皆哭泣，悲之如亡親戚。子産者，鄭成公少子也。爲人仁愛人，事君忠厚。孔子嘗過鄭，與子産如兄弟云。及聞子産死，孔子爲泣曰：「古之遺愛也！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m049-0000","start":0,"end":2,"surface":"聲公","kind":"person","person_id":"cbr-p002211","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0007","start":7,"end":9,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0024","start":24,"end":26,"surface":"子産","kind":"person","person_id":"cbr-p002190","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0028","start":28,"end":31,"surface":"鄭成公","kind":"person","person_id":"cbr-p002177","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m049-0046","start":46,"end":48,"surface":"孔子","kind":"person","person_id":"cbr-p00