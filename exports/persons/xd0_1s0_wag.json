tus":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p011","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m015-0095","start":95,"end":97,"surface":"孝景","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-109-liguang:p002","text":"及孝景初立，廣爲隴西都尉，徙爲騎郎將。呉楚軍時，廣爲驍騎都尉，從太尉亞夫擊呉楚軍，取旗，顯功名昌邑下。以梁王授廣將軍印，還，賞不行。徙爲上谷太守，匈奴日以合戰。典屬國公孫昆邪爲上泣曰：「李廣才氣，天下無雙，自負其能，數與虜敵戰，恐亡之。」於是乃徙爲上郡太守。後廣轉爲邊郡太守，徙上郡。嘗爲隴西、北地、鴈門、代郡、雲中太守，皆以力戰爲名。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m002-0001","start":1,"end":3,"surface":"孝景","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0006","start":6,"end":7,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0024","start":24,"end":25,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0034","start":34,"end":36,"surface":"亞夫","kind":"person","person_id":"tbc_xj9_4f1","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0052","start":52,"end":54,"surface":"梁王","kind":"person","person_id":"m2z_t62_97g","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0055","start":55,"end":56,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0083","start":83,"end":87,"surface":"公孫昆邪","kind":"person","person_id":"8qy_3jw_ikr","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0088","start":88,"end":89,"surface":"上","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0093","start":93,"end":95,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0130","start":130,"end":131,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"}],"chapter_id":"c-shiji-109-liguang","book_id":"b-shiji-109","work_id":"w-shiji","source_id":"s-shiji-109-liguang"},{"id":"c-shiji-109-liguang:p003","text":"匈奴大入上郡，天子使中貴人從廣勒習兵擊匈奴。中貴人將騎數十縱，見匈奴三人，與戰。三人還射，傷中貴人，殺其騎且盡。中貴人走廣。廣曰：「是必射雕者也。」廣乃遂從百騎往馳三人。三人亡馬歩行，行數十里。廣令其騎張左右翼，而廣身自射彼三人者，殺其二人，生得一人，果匈奴射雕者也。已縛之上馬，望匈奴有數千騎，見廣，以爲誘騎，皆驚，上山陳。廣之百騎皆大恐，欲馳還走。廣曰：「吾去大軍數十里，今如此以百騎走，匈奴追射我立盡。今我留，匈奴必以我爲大軍［之］誘（之），必不敢擊我。」廣令諸騎曰：「前！」前未到匈奴陳二里所，止，令曰：「皆下馬解鞍！」其騎曰：「虜多且近，即有急，柰何？」廣曰：「彼虜以我爲走，今皆解鞍以示不走，用堅其意。」於是胡騎遂不敢擊。有白馬將出護其兵，李廣上馬與十餘騎奔射殺胡白馬將，而復還至其騎中，解鞍，令士皆縱馬臥。是時會暮，胡兵終怪之，不敢擊。夜半時，胡兵亦以爲漢有伏軍於旁欲夜取之，胡皆引兵而去。平旦，李廣乃歸其大軍。大軍不知廣所之，故弗從。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m003-0007","start":7,"end":9,"surface":"天子","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m003-0010","start":10,"end":13,"surface":"中貴人","kind":"person","person_id":"f4r_7vs_l08","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m003-0014","start":14,"end":15,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m003-0022","start":22,"end":25,"surface":"中貴人","kind":"person","person_id":"f4r_7vs_l08","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m003-0034","start":34,"end":36,"surface":"三人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-109-liguang:m003-0040","start":40,"end":42,"surface":"三人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-109-liguang:m003-0046","start":46,"end":49,"surface":"中貴人","kind":"person","person_id":"f4r_7vs_l08","status":"contextual_pr