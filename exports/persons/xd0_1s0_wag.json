"c-shiji-109-liguang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-109-liguang:p002","text":"及孝景初立，廣爲隴西都尉，徙爲騎郎將。呉楚軍時，廣爲驍騎都尉，從太尉亞夫擊呉楚軍，取旗，顯功名昌邑下。以梁王授廣將軍印，還，賞不行。徙爲上谷太守，匈奴日以合戰。典屬國公孫昆邪爲上泣曰：「李廣才氣，天下無雙，自負其能，數與虜敵戰，恐亡之。」於是乃徙爲上郡太守。後廣轉爲邊郡太守，徙上郡。嘗爲隴西、北地、鴈門、代郡、雲中太守，皆以力戰爲名。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m002-0001","start":1,"end":3,"surface":"孝景","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0006","start":6,"end":7,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0024","start":24,"end":25,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0034","start":34,"end":36,"surface":"亞夫","kind":"person","person_id":"tbc_xj9_4f1","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0052","start":52,"end":54,"surface":"梁王","kind":"person","person_id":"m2z_t62_97g","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0055","start":55,"end":56,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0083","start":83,"end":87,"surface":"公孫昆邪","kind":"person","person_id":"8qy_3jw_ikr","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0088","start":88,"end":89,"surface":"上","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0093","start":93,"end":95,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m002-0130","start":130,"end":131,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"co