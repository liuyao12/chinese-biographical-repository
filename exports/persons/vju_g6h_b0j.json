":"person","person_id":"6o2_xmb_367","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m020-0103","start":103,"end":104,"surface":"王","kind":"person","person_id":"d9b_5t4_9eb_AA","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m020-0107","start":107,"end":110,"surface":"廉將軍","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m020-0119","start":119,"end":120,"surface":"臣","kind":"person","person_id":"6o2_xmb_367","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m020-0130","start":130,"end":132,"surface":"趙王","kind":"person","person_id":"d9b_5t4_9eb_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-081-lianlin","book_id":"b-shiji-081","work_id":"w-shiji","source_id":"s-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:p025","text":"趙悼襄王元年，廉頗既亡入魏，趙使李牧攻燕，拔武遂、方城。居二年，龐暖破燕軍，殺劇辛。後七年，秦破殺趙將扈輒於武遂，斬首十萬。趙乃以李牧爲大將軍，撃秦軍於宜安，大破秦軍，走秦將桓齮。封李牧爲武安君。居三年，秦攻番吾，李牧撃破秦軍，南距韓、魏。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m025-0000","start":0,"end":4,"surface":"趙悼襄王","kind":"person","person_id":"d9b_5t4_9eb_AA","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m025-0007","start":7,"end":9,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m025-0016","start":16,"end":18,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t58","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m025-0032","start":32,"end":34,"surface":"龐暖","kind":"person","person_id":"0p4_ef2_1xa","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m025-0039","start":39,"end":41,"surface":"劇辛","kind":"person","person_id":"bkf_68m_hxl","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m025-0049","start":49,"end":53,"surface":"趙將扈輒","kind":"person","person_id":"vo2_2ho_kyz","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m025-0065","sta