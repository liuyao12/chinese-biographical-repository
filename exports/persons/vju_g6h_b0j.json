,"end":19,"surface":"其母","kind":"person","person_id":"xdq_h9k_zzl","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0019","start":19,"end":20,"surface":"倡","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職稱與匿名詞保留；未名者不補熟知姓名。述贊省稱限本篇對讀，不另增加事件或闕代。"},{"id":"c-shiji-043-zhao:m121-0024","start":24,"end":27,"surface":"悼襄王","kind":"person","person_id":"q6w_qm5_w2b_A","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0028","start":28,"end":31,"surface":"悼襄王","kind":"person","person_id":"q6w_qm5_w2b_A","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0032","start":32,"end":34,"surface":"適子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職稱與匿名詞保留；未名者不補熟知姓名。述贊省稱限本篇對讀，不另增加事件或闕代。"},{"id":"c-shiji-043-zhao:m121-0034","start":34,"end":35,"surface":"嘉","kind":"person","person_id":"q6w_qm5_w2b_AB","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0037","start":37,"end":38,"surface":"遷","kind":"person","person_id":"q6w_qm5_w2b_AA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0039","start":39,"end":40,"surface":"遷","kind":"person","person_id":"q6w_qm5_w2b_AA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0052","start":52,"end":54,"surface":"李牧","kind":"person","person_id":"hph_y6n_3zb","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0056","start":56,"end":58,"surface":"郭開","kind":"person","person_id":"5x6_bvq_088","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0068","start":68,"end":69,"surface":"遷","kind":"person","person_id":"q6w_qm5_w2b_AA","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0070","start":70,"end":75,"surface":"趙之亡大夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職稱與匿名詞保留；未名者不補熟知姓名。述贊省稱限本篇對讀，不另增加事件或闕代。"},{"id":"c-shiji-043-zhao:m121-0077","start":77,"end":78,"surface":"嘉","kind":"person","person_id":"q6w_qm5_w2b_AB","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m121-0090","start":90,"end":91,"surface":"嘉","kind":"person","person_id":"q6w_qm5_w2b_AB","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-080-leyi:p018","text":"其明年，樂乘、廉頗為趙圍燕，燕重禮以和，乃解。後五歲，趙孝成王卒。襄王使樂乘代廉頗。廉頗攻樂乘，樂乘走，廉頗亡入魏。其後十六年而秦滅趙。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m018-0004","start":4,"end":6,"surface":"樂乘","kind":"person","person_id":"9t6_8nc_nuo","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0007","start":7,"end":9,"surface":"廉頗","kind":"person","person_id":"gt7_y57_atj","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0027","start":27,"end":31,"surface":"趙孝成王","kind":"person","person_id":"k2w_1d2_5u5","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0033","start":33,"end":35,"surface":"襄王","kind":"person","person_id":"vju_g6h_b0j","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0036","start":36,"end":38,"surface":"樂乘","kind":"person","person_id":"9t6_8nc_nuo","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0039","start":39,"end":41,"surface":"廉頗","kind":"person","person_id":"gt7_y57_atj","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0042","start":42,"end":44,"surface":"廉頗","kind":"person","person_id":"gt7_y57_atj","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0045","start":45,"end":47,"surface":"樂乘","kind":"person","person_id":"9t6_8nc_nuo","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0048","start":48,"end":50,"surface":"樂乘","kind":"person","person_id":"9t6_8nc_nuo","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m018-0052","start":52,"end":54,"surface":"廉頗","kind":"person","person_id":"gt7_y57_atj","status":"contextual_provisional"}],"chapter_id":"c-shiji-080-leyi","book_id":"b-shiji-080","work_id":"w-shiji","source_id":"s-shiji-080-leyi"},{"id":"c-shiji-081-lianlin:p019","text":"趙孝成王卒，子悼襄王立，使樂乘代廉頗。廉頗怒，攻樂乘，樂乘走。廉頗遂奔魏之大梁。其明年，趙乃以李牧爲將而攻燕，拔武遂、方城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m019-0000","start":0,"end":4,"surface":"趙孝成王","kind":"person","person_id":"d9b_5t4_9eb_A","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m019-0007","start":7,"end":10,"surface":"悼襄王","kind":"person","person_id":"d9b_5t4_9eb_AA","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m019-0013","start":13,"end":15,"surface":"樂乘","kind":"person","person_id":"2qv_1rq_zp0","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m019-0016","start":16,"end":18,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m019-0019","start":19,"end":21,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m019-0024","start":24,"end":26,"surface":"樂乘","kind":"person","person_id":"2qv_1rq_zp0","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m019-0027","start":27,"end":29,"surface":"樂乘","kind":"person","person_id":"2qv_1rq_zp0","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m019-0031","start":31,"end":33,"surface":"廉頗","kind":"person","person_id":"we8_3f9_z9b","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m019-0047","start":47,"end":49,"surface":"李牧","kind":"person","person_id":"qbg_2pe_t58","status":"contextual_provisional"}],"chapter_id":"c-shiji-081-lianlin","book_id":"b-shiji-081","work_id":"w-shiji","source_id":"s-shiji-081-lianlin"},{"id":"c-shiji-081-lianlin:p020","text":"廉頗居梁久之，魏不能信用。趙以數困於秦兵，趙王思復得廉頗，廉頗亦思復用於趙。趙王使使者視廉頗尚可用否。廉頗之仇郭開多與使者金，令毀之。趙使者既見廉頗，廉頗爲之一飯斗米，肉十斤，被甲上馬，以示尚可用。趙使還報王曰：「廉將軍雖老，尚善飯，然與臣坐，頃之三遺矢矣。」趙王以爲老，遂不召。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m020-00