ntion_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi052-cuiweizu-agnatic-younger","subject_person_id":"536_9u3_amc","object_person_id":"j1u_ka8_86e","predicate":"agnatic_cousin","qualifiers":{"source_term":"從弟緯","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-052","chapter_id":"c-nanqishu-052-later-literature-complete","source_id":"s-nanqishu-052-later-literature-complete-ws2371079","paragraph_id":"c-nanqishu-052-later-literature-complete:p028","quote":"　　慰祖著《海岱志》，起太公迄西晉人物，爲四十卷，半未成。臨卒，與從弟緯書云：「常欲更注遷、固二史，採史、漢所漏二百餘事，在廚簏，可檢寫之，以存大意。《海岱志》良未周悉，可寫數本，付護軍諸從事人一通，及友人任昉、徐夤、劉洋、裴揆。」又令「以棺親土，不須塼，勿設靈座」。時年三十五。","subject_person_mention_id":"c-nanqishu-052-later-literature-complete:p028:m0002","object_person_mention_id":"c-nanqishu-052-later-literature-complete:p028:m0035"}],"status":"source_attested","interpretation_note":"臨卒書予從弟。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-052-later-literature-complete:p028:m0035","start":35,"end":36,"surface":"緯","kind":"person","person_id":"j1u_ka8_86e","status":"contextual_provisional","paragraph_id":"c-nanqishu-052-later-literature-complete:p028","chapter_id":"c-nanqishu-052-later-literature-complete"}],"relations":[{"id":"a-qi052-cuiweizu-agnatic-younger","subject_person_id":"536_9u3_amc","object_person_id":"j1u_ka8_86e","predicate":"agnatic_cousin","qualifiers":{"source_term":"從弟緯","lineage":"pa