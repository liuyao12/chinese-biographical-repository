{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004262","identity_policy":"contextual_provisional","person_ids":["cbr-p004262"],"persons":[{"id":"cbr-p004262","label":"燕王喜（白起王翦列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"燕王喜","mention_ids":["c-shiji-073-baiwang:m009-0088"]},{"surface":"燕王","mention_ids":["c-shiji-073-baiwang:m010-0009"]}],"evidence":[{"mention_id":"c-shiji-073-baiwang:m009-0088","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p009","quote":"燕王喜"},{"mention_id":"c-shiji-073-baiwang:m010-0009","chapter_id":"c-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p010","quote":"燕王"}]}],"mentions":[{"id":"c-shiji-073-baiwang:m009-0088","start":88,"end":91,"surface":"燕王喜","kind":"person","person_id":"cbr-p004262","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p009","chapter_id":"c-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:m010-0009","start":9,"end":11,"surface":"燕王","kind":"person","person_id":"cbr-p004262","status":"contextual_provisional","paragraph_id":"c-shiji-073-baiwang:p010","chapter_id":"c-shiji-073-baiwang"}],"relations":[],"title_holdings":[{"id":"th-shiji073-020","person_id":"cbr-p004262","title":"燕王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-073-baiwang","source_id":"s-shiji-073-baiwang","paragraph_id":"c-shiji-073-baiwang:p009","quote":"王翦者，頻陽東鄉人也。少而好兵，事秦始皇。始皇十一年，翦將攻趙閼與，破之，拔九城，十八年，翦將攻趙。歲餘，遂拔趙，趙王降，盡定趙地為郡。明年，燕使荊軻為賊於秦，秦王使王翦攻燕。燕王喜走遼東，翦遂定燕薊而還。秦使翦子王賁擊荊，荊兵敗。還擊魏，魏王降，遂定魏地。"}],"attestations":[{"id":"th-shiji073-020:a001","paragraph_id":"c-shiji-073-baiwang:p009","start":88,"end":90,"surface":"燕王","person_mention_id":"c-shiji-073-baiwang:m009-0088","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、授爵、降等與文獻用稱分存；未知日期及終點不補造。因病辭將、拒絕代將、死亡與被虜不自動終止全部官爵；三公及秦王王為蘇代假設，未作實際授予。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji073-031","person_id":"cbr-p004262","scope":"same_chapter","chapter_ids":["c-shiji-073-baiwang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依局部敘事明示姓名、受話稱呼與回指暫接，秦昭王敘事與秦始皇敘事分段，降秦趙王與鉅鹿趙王分候選。周召引功與呂望保存引古，不補周召全名；應侯、春申君及魏公子不從記憶補名。王翦王賁王離依明示分存，孫不推出父親；將軍受話按李信與王翦對話範圍辨認。王氏蒙氏及匿名說話者未全域接個別人物。","surfaces":["燕王","燕王喜"],"evidence":[{"paragraph_id":"c-shiji-073-baiwang:p009","quote":"王翦者，頻陽東鄉人也。少而好兵，事秦始皇。始皇十一年，翦將攻趙閼與，破之，拔九城，十八年，翦將攻趙。歲餘，遂拔趙，趙王降，盡定趙地為郡。明年，燕使荊軻為賊於秦，秦王使王翦攻燕。燕王喜走遼東，翦遂定燕薊而還。秦使翦子王賁擊荊，荊兵敗。還擊魏，魏王降，遂定魏地。"},{"paragraph_id":"c-shiji-073-baiwang:p010","quote":"秦始皇既滅三晉，走燕王，而數破荊師。秦將李信者，年少壯勇，嘗以兵數千逐燕太子丹至於衍水中，卒破得丹，始皇以為賢勇。於是始皇問李信：「吾欲攻取荊，於將軍度用幾何人而足？」李信曰：「不過用二十萬人。」始皇問王翦，王翦曰：「非六十萬人不可。」始皇曰：「王將軍老矣，何怯也！李將軍果勢壯勇，其言是也。」遂使李信及蒙恬將二十萬南伐荊。王翦言不用，因謝病，歸老於頻陽。李信攻平與，蒙恬攻寢，大破荊軍。信又攻鄢郢，破之，於是引兵而西，與蒙恬會城父。荊人因隨之，三日三夜不頓舍，大破李信軍，入兩壁，殺七都尉，秦軍走。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-073-baiwang:p009","text":"王翦者，頻陽東鄉人也。少而好兵，事秦始皇。始皇十一年，翦將攻趙閼與，破之，拔九城，十八年，翦將攻趙。歲餘，遂拔趙，趙王降，盡定趙地為郡。明年，燕使荊軻為賊於秦，秦王使王翦攻燕。燕王喜走遼東，翦遂定燕薊而還。秦使翦子王賁擊荊，荊兵敗。還擊魏，魏王降，遂定魏地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m009-0000","start":0,"end":2,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0017","start":17,"end":20,"surface":"秦始皇","kind":"person","person_id":"cbr-p004259","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0021","start":21,"end":23,"surface":"始皇","kind":"person","person_id":"cbr-p004259","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0027","start":27,"end":28,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0045","start":45,"end":46,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0057","start":57,"end":59,"surface":"趙王","kind":"person","person_id":"cbr-p004260","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0073","start":73,"end":75,"surface":"荊軻","kind":"person","person_id":"cbr-p004261","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0080","start":80,"end":82,"surface":"秦王","kind":"person","person_id":"cbr-p004259","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0083","start":83,"end":85,"surface":"王翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0088","start":88,"end":91,"surface":"燕王喜","kind":"person","person_id":"cbr-p004262","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0095","start":95,"end":96,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0105","start":105,"end":106,"surface":"翦","kind":"person","person_id":"cbr-p004258","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0107","start":107,"end":109,"surface":"王賁","kind":"person","person_id":"cbr-p004263","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m009-0120","start":120,"end":122,"surface":"魏王","kind":"person","person_id":"cbr-p004264","status":"contextual_provisional"}],"chapter_id":"c-shiji-073-baiwang","book_id":"b-shiji-073","work_id":"w-shiji","source_id":"s-shiji-073-baiwang"},{"id":"c-shiji-073-baiwang:p010","text":"秦始皇既滅三晉，走燕王，而數破荊師。秦將李信者，年少壯勇，嘗以兵數千逐燕太子丹至於衍水中，卒破得丹，始皇以為賢勇。於是始皇問李信：「吾欲攻取荊，於將軍度用幾何人而足？」李信曰：「不過用二十萬人。」始皇問王翦，王翦曰：「非六十萬人不可。」始皇曰：「王將軍老矣，何怯也！李將軍果勢壯勇，其言是也。」遂使李信及蒙恬將二十萬南伐荊。王翦言不用，因謝病，歸老於頻陽。李信攻平與，蒙恬攻寢，大破荊軍。信又攻鄢郢，破之，於是引兵而西，與蒙恬會城父。荊人因隨之，三日三夜不頓舍，大破李信軍，入兩壁，殺七都尉，秦軍走。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m010-0000","start":0,"end":3,"surface