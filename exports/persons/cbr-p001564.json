isional"},{"id":"c-shiji-037-wei:m023-0193","start":193,"end":195,"surface":"懿公","kind":"person","person_id":"9w2_c77_53m_E","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m023-0201","start":201,"end":203,"surface":"成公","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m023-0206","start":206,"end":209,"surface":"穆公遫","kind":"person","person_id":"i8i_rvh_4lp_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-039-jin:p067","text":"五年春，晉文公欲伐曹，假道於衞，衞人弗許。還自河南度，侵曹，伐衞。正月，取五鹿。二月，晉侯、齊侯盟于斂盂。衞侯請盟晉，晉人不許。衞侯欲與楚，國人不欲，故出其君以説晉。衞侯居襄牛，公子買守衞。楚救衞，不卒。晉侯圍曹。三月丙午，晉師入曹，數之以其不用釐負羈言，而用美女乘軒者三百人也。令軍毋入僖負羈宗家以報德。楚圍宋，宋復告急晉。文公欲救則攻楚，爲楚嘗有德，不欲伐也；欲釋宋，宋又嘗有德於晉：患之。先軫曰：「執曹伯，分曹、衞地以與宋，楚急曹、衞，其勢宜釋宋。」於是文公從之，而楚成王乃引兵歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m067-0004","start":4,"end":7,"surface":"晉文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0043","start":43,"end":45,"surface":"晉侯","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0046","start":46,"end":48,"surface":"齊侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m067-0053","start":53,"end":55,"surface":"衞侯","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0064","start":64,"end":66,"surface":"衞侯","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0083","start":83,"end":85,"surface":"衞侯","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0089","start":89,"end":92,"surface":"公子買","kind":"person","person_id":"wny_01o_f36","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0102","start":102,"end":104,"surface":"晉侯","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0123","start":123,"end":126,"surface":"釐負羈","kind":"person","person_id":"pft_5o1_zzt","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0130","start":130,"end":138,"surface":"美女乘軒者三百人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m067-0144","start":144,"end":147,"surface":"僖負羈","kind":"person","person_id":"pft_5o1_zzt","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0163","start":163,"end":165,"surface":"文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0197","start":197,"end":199,"surface":"先軫","kind":"person","person_id":"zql_k3t_8ro","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0203","start":203,"end":205,"surface":"曹伯","kind":"person","person_id":"vs4_n7e_1qh_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m067-0230","start":230,"end":232,"surface":"文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p068","text":"楚將子玉曰：「王遇晉至厚，今知楚急曹、衞而故伐之，是輕王。」王曰：「晉侯亡在外十九年，困日久矣，果得反國，險阸盡知之，能用其民，天之所開，不可當。」子玉請曰：「非敢必有功，願以閒執讒慝之口也。」楚王怒，少與之兵。於是子玉使宛春告晉：「請復衞侯而封曹，臣亦釋宋。」咎犯曰：「子玉無禮矣，君取一，臣取二，勿許。」先軫曰：「定人之謂禮。楚一言定三國，子一言而亡之，我則毋禮。不許楚，是棄宋也。不如私許曹、衞以誘之，執宛春以怒楚，旣戰而後圖之。」晉侯乃囚宛春於衞，且私許復曹、衞。曹、衞告絶於楚。楚得臣怒，撃晉師，晉師退。軍吏曰：「爲何退？」文公曰：「昔在楚，約退三舍，可倍乎！」楚師欲去，得臣不肯。四月戊辰，宋公、齊將、秦將與晉侯次城濮。己巳，與楚兵合戰，楚兵敗，得臣收餘兵去。甲午，晉師還至衡雍，作王宮于踐土。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m068-0000","start":0,"end":4,"surface":"楚將子玉","kind":"person","person_id":"ig9_uk1_7rh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0007","start":7,"end":8,"surface":"王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0027","start":27,"end":28,"surface":"王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0030","start":30,"end":31,"surface":"王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0034","start":34,"end":36,"surface":"晉侯","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0074","start":74,"end":76,"surface":"子玉","kind":"person","person_id":"ig9_uk1_7rh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0097","start":97,"end":99,"surface":"楚王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0108","start":108,"end":110,"surface":"子玉","kind":"person","person_id":"ig9_uk1_7rh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0111","start":111,"end":113,"surface":"宛春","kind":"person","person_id":"3mo_tz2_5vi","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0119","start":119,"end":121,"surface":"衞侯","kind":"person","person_id":"i8i_rvh_4lp_A","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0131","start":131,"end":133,"surface":"咎犯","kind":"person","person_id":"xxq_5y6_8sr","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0136","start":136,"end":138,"surface":"子玉","kind":"person","person_id":"ig9_uk1_7rh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0154","start":154,"end":156,"surface":"先軫","kind":"person","person_id":"zql_k3t_8ro","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0205","start":205,"end":207,"surface":"宛春","kind":"person","person_id":"3mo_tz2_5vi","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0219","start":219,"end":221,"surface":"晉侯","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0223","start":223,"end":225,"surface":"宛春","kind":"person","person_id":"3mo_tz2_5vi","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0244","start":244,"end":247,"surface":"楚得臣","kind":"person","person_id":"ig9_uk1_7rh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0257","start":257,"end":259,"surface":"軍吏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m068-0267","start":267,"end":269,"surface":"文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0291","start":291,"end":293,"surface":"得臣","kind":"person","person_id":"ig9_uk1_7rh","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0301","start":301,"end":303,"surface":"宋公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m068-0304","start":304,"end":306,"surface":"齊將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m068-0307","start":307,"end":309,"surface":"秦將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m068-0310","start":310,"end":312,"surface":"晉侯","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m068-0329","start":329,"end":331,"surface":"得臣","kind":"person","person_id":"ig9_uk1_7rh","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p072","text":"六月，晉人復入衞侯。壬午，晉侯度河北歸國。行賞，狐偃爲首。或曰：「城濮之事，先軫之謀。」文公曰：「城濮之事，偃説我毋失信。先軫曰『軍事勝爲右』，吾用之以勝。然此一時之説，偃言萬世之功，柰何以一時之利而加萬世功乎？是以先之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"