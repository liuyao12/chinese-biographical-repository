95,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231,5232,5233,5234,5235,5236,5237,5238,5239,5240,5241,5242,5243,5244]},"chapter_id":"c-sanguozhi-060-lvdai","book_id":"b-sanguozhi-060","work_id":"w-sanguozhi","source_id":"s-sanguozhi-060-lvdai"},{"id":"c-sanguozhi-060-zhoufang:line088","text":"　　魴初建密計時，頻有郎官奉詔詰問諸事，魴乃詣部郡門下，因下發謝，故休聞之，不復疑慮。事捷軍旋，權大會諸將歡宴，酒酣。謂魴曰：“君下發載義，成孤大事，君之功名，當書之竹帛。”加裨將軍，賜爵關內侯。賊帥董嗣負阻劫鈔，豫章、臨川並受其害。吾粲、唐咨嘗以三千兵攻守，連月不能拔。魴表乞罷兵，得以便宜從事。魴遣間諜，授以方策，誘狙殺嗣。嗣弟怖懼，詣武昌降於陸遜，乞出平地，自改為善，由是數郡無復憂惕。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-zhoufang:line088:m0002","start":2,"end":3,"surface":"魴","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line088:m0020","start":20,"end":21,"surface":"魴","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line088:m0034","start":34,"end":35,"surface":"休","kind":"person","person_id":"h7n_w5t_i1c_AA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line088:m0048","start":48,"end":49,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line088:m0060","start":60,"end":61,"surface":"魴","kind":"person","person_id":"iuc_mqu_3jm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line088:m0100","start":100,"end":102,"surface":"董嗣","kind":"person","person_id":"d2f_0dk_l4m","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-zhoufang:line088:m0117","start":117,"end":119,"surface":"吾粲","kind":"person","person_id":"pax_gtm_aew","status":"contextual_provisional"