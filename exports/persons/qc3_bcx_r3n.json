,5664,5665,5666,5667,5668,5669,5670,5671,5672,5673,5674,5675,5676,5677]},"chapter_id":"c-sanguozhi-056-lvju","book_id":"b-sanguozhi-056","work_id":"w-sanguozhi","source_id":"s-sanguozhi-056-lvju"},{"id":"c-sanguozhi-060-lvdai:line053","text":"　　黃龍三年，以南土清定，召岱還屯長沙漚口。會武陵蠻夷蠢動，岱與太常潘浚共討定之。嘉禾三年，權令岱領潘璋士眾，屯陸口，後徙蒲圻。四年，廬陵賊李桓、路合、會稽東冶賊隨春、南海賊羅厲等一時並起。權復詔岱督劉纂、唐咨等分部討擊，春即時首降，岱拜春偏將軍，使領其眾，遂為列將，桓、厲等皆見斬獲，傳首詣都。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-lvdai:line053:m0014","start":14,"end":15,"surface":"岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0030","start":30,"end":31,"surface":"岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0034","start":34,"end":36,"surface":"潘浚","kind":"person","person_id":"pac_tt7_hs3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0046","start":46,"end":47,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0048","start":48,"end":49,"surface":"岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0050","start":50,"end":52,"surface":"潘璋","kind":"person","person_id":"v4f_db2_eqv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0070","start":70,"end":72,"surface":"李桓","kind":"person","person_id":"xqk_f8a_dvz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0073","start":73,"end":75,"surface":"路合","kind":"person","person_id":"cvc_zj4_1jp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-