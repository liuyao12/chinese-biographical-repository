ved_chapter","annotation_status":"in_progress","mentions":[{"id":"c-beishi-044-bei44:p001:m0000","start":0,"end":2,"surface":"崔光","kind":"person","person_id":"822_eba_7d0","identification_status":"contextual_provisional","interpretation_note":"由本段親屬語境辨識，保留原名。"},{"id":"c-beishi-044-bei44:p001:m0009","start":9,"end":11,"surface":"孝伯","kind":"person","person_id":"822_eba_7d0","identification_status":"contextual_provisional","interpretation_note":"由本段親屬語境辨識，保留原名。"},{"id":"c-beishi-044-bei44:p001:m0013","start":13,"end":15,"surface":"長仁","kind":"person","person_id":"822_eba_7d0","identification_status":"contextual_provisional","interpretation_note":"由本段親屬語境辨識，保留原名。"},{"id":"c-beishi-044-bei44:p001:m0023","start":23,"end":24,"surface":"曠","kind":"person","person_id":"su1_3c9_tqt","identification_status":"contextual_provisional","interpretation_note":"《魏書》《北史》崔光之祖，任宋樂陵太守。與晉書曹攄敘事另見的崔曠分錄。"},{"id":"c-beishi-044-bei44:p001:m0026","start":26,"end":29,"surface":"慕容德","person_id":"van_pwm_swv","kind":"person","identification_status":"contextual_provisional","interpretation_note":"據同段共拒魏軍、平三齊與父子遷代的敘事辨識。"},{"id":"c-beishi-044-bei44:p001:m0087","start":87,"end":89,"surface":"靈延","kind":"person","person_id":"ha5_uxt_6zf","identification_status":"contextual_provisional","interpretation_note":"《魏書》《北史》記崔光父、劉宋長廣太守。"},{"id":"c-beishi-044-bei44:p001:m0102","start":102,"end":105,"surface":"崔道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"《宋書》及北朝兩史所見，劉宋冀州刺史，鎮歷城。"},{"id":"c-beishi-044-bei44:p001:m0110","start":110,"end":114,"surface":"慕容白曜","person_id":"bm0_pqc_ydf","kind":"person","identification_status":"contextual_provisional","interpretation_note":"據同段共拒魏軍、平三齊與父子遷代的敘事辨識。"},{"id":"c-beishi-044-bei44:p001:m0119","start":119,"end":120,"surface":"光","person_id":"822_eba_7d0","kind":"person","identification_status":"contextual_provisional","interpretation_note":"據同段共拒魏軍、平三齊與父子遷代的敘事辨識。"}],"source_position":{"revision_id":2183262,"raw_start":177,"raw_end":323,"first_line":11,"last_line":11,"source_layer":"received_biography","raw_character_offsets":[177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322],"projection_sha256":"099e441b958a71217d87fa5b2f533e6f98414bb286835f0785bcf8557b692db5"},"chapter_id":"c-beishi-044-bei44","book_id":"b-beishi-044","work_id":"w-beishi","source_id":"s-beishi-044-bei44-ws2183262"},{"id":"c-beishi-044-cuidaogu:p004","text":"皇興初，獻文詔征南大將軍慕容白曜討道固，道固面縛請罪。白曜送赴都，詔恕其死。乃徙齊土望共道固守城者數百家于桑乾，立平齊郡于平城西北北新城，以道固為太守，賜爵臨淄子。尋徙居京城西南二百餘里舊除館之西。延興中卒，子景徽襲爵。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-beishi-044-cuidaogu:p004:m0012","start":12,"end":16,"surface":"慕容白曜","kind":"person","person_id":"bm0_pqc_ydf","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p004:m0017","start":17,"end":19,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p004:m0020","start":20,"end":22,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p004:m0027","start":27,"end":29,"surface":"白曜","kind":"person","person_id":"bm0_pqc_ydf","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p004:m0044","start":44,"end":46,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p004:m0070","start":70,"end":72,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p004:m0105","start":105,"end":107,"surface":"景徽","kind":"person","person_id":"23q_wcp_hny_B","identification_status":"contextual_provisional","interpretation_note":"兩史同述道固之子、所襲臨淄爵、平州刺史、諡定及子休纂。其與《宋書》赴安都者的同指待核。"}],"source_position":{"revision_id":2183262,"raw_start":12961,"raw_end":13071,"first_line":152,"last_line":152,"source_layer":"received_biography","raw_character_offsets":[12961,12962,12963,12964,12965,12966,12967,12968,12969,12970,12971,12972,12973,12974,12975,12976,12977,12978,12979,12980,12981,12982,12983,12984,12985,12986,12987,12988,12989,12990,12991,12992,12993,12994,12995,12996,12997,12998,12999,13000,13001,13002,13003,13004,13005,13006,13007,13008,13009,13010,13011,13012,13013,13014,13015,13016,13017,13018,13019,13020,13021,13022,13023,13024,13025,13026,13027,13028,13029,13030,13031,13032,13033,13034,13035,13036,13037,13038,13039,13040,13041,13042,13043,13044,13045,13046,13047,13048,13049,13050,13051,13052,13053,13054,13055,13056,13057,13058,13059,13060,13061,13062,13063,13064,13065,13066,13067,13068,13069,13070],"projection_sha256":"39d3cdcd836e569113350b5ea7e47c425b03c2a3a802882ec7cca1a4de5b45ba"},"chapter_id":"c-beishi-044-cuidaogu","book_id":"b-beishi-044","work_id":"w-beishi","source_id":"s-beishi-044-cuidaogu-ws2183262"},{"id":"c-weishu-weishou-024-cuidaogu:p004","text":"皇興初，顯祖詔征南大將軍慕容白曜固築長圍以守之。及白曜攻其城東郭，道固面縛請罪，表曰：「臣資生南境，限隔大化，本朝不以卑末，委授藩任。而劉氏蕭牆內侮，懼貽大戮，前遣崔啟之奉表歸誠，幸蒙陛下過垂矜納，并賜爵寵，慶佩罔極，應奔闕庭。但劉彧尋續遣使，恕臣百死。愚以世奉劉氏，深愆蒙宥，若猶違背，則是不忠於本朝，而欲求忠於大魏。雖曰希生，懼大魏之所不許。是用迷回，孤負天日，冒萬死之艱，固執拒守。僕臣白曜，振曜威靈，漸經二載，大將臨城，以今月十四日，臣東郭失守，於臣款彧之誠，庶可以彰於大魏矣。臣勢窮力屈，以十七日面縛請罪，白曜奉宣皇恩，恕臣生命。斯實陛下起臣死尸，肉臣朽骨，天地造物所不能行，而陛下育之。雖虞舜之貸有苗，姬文之宥崇壘，方之聖澤，未足以喻。既未奉朝旨，無由親馳道路，謹遣大息景徽，束骸歸闕，伏聽刑斧。」","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-weishu-weishou-024-cuidaogu:p004:m0012","start":12,"end":16,"surface":"慕容白曜","kind":"person","person_id":"bm0_pqc_ydf","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0025","start":25,"end":27,"surface":"白曜","kind":"person","person_id":"bm0_pqc_ydf","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0033","start":33,"end":35,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0082","start":82,"end":85,"surface":"崔啟之","kind":"person","person_id":"5jw_lta_ejc","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0115","start":115,"end":117,"surface":"劉彧","kind":"person","person_id":"cti_o52_4nz","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0196","start":196,"end":198,"surface":"白曜","kind":"person","person_id":"bm0_pqc_ydf","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0230","start":230,"end":231,"surface":"彧","kind":"person","person_id":"cti_o52_4nz","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0258","start":258,"end":260,"surface":"白曜","kind":"person","person_id":"bm0_pqc_ydf","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-weishu-weishou-024-cuidaogu:p004:m0300","start":300,"end"