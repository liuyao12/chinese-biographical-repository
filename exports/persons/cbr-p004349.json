frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-075-mengchang:m005-0044","start":44,"end":46,"surface":"蘇代","kind":"person","person_id":"2ih_dpv_yf7","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p005","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m005-0052","start":52,"end":53,"surface":"代","kind":"person","person_id":"2ih_dpv_yf7","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p005","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m009-0032","start":32,"end":34,"surface":"蘇代","kind":"person","person_id":"2ih_dpv_yf7","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p009","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m011-0013","start":13,"end":15,"surface":"蘇代","kind":"person","person_id":"2ih_dpv_yf7","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p011","chapter_id":"c-shiji-075-mengchang"},{"id":"c-shiji-075-mengchang:m011-0016","start":16,"end":17,"surface":"代","kind":"person","person_id":"2ih_dpv_yf7","status":"contextual_provisional","paragraph_id":"c-shiji-075-mengchang:p011","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji075-020","person_id":"2ih_dpv_yf7","scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依入秦、返齊及食客敘事明示姓名與局部回指暫接。未名夜食客、蔽光者、狗盜鷄鳴兩客、幸姬及勸說毀者各存角色，不補姓名或全域連所有客稱；木土偶保持寓言。蘇代內嵌秦昭王王稱與外層孟嘗君君稱分辨，楚王割地與楚懷王得出暫分候選，不確證異人；田甲劫王與孟嘗君反謀指控分開，不把指控當史實。","surfaces":["代","蘇代"],"evidence":[{"paragraph_id":"c-shiji-075-mengchang:p005","quote":"秦昭王聞其賢，乃先使涇陽君爲質於齊，以求見孟嘗君。孟嘗君將入秦，賓客莫欲其行，諫，不聽。蘇代謂曰：「今旦代從外來，見木禺人與土禺人相與語。木禺人曰：『天雨，子將敗矣。』土禺人曰：『我生於土，敗則歸土。今天雨，流子而行，未知所止息也。』今秦，虎狼之國也，而君欲往，如有不得還，君得無爲土禺人所笑乎？」孟嘗君乃止。"},{"paragraph_id":"c-shiji-075-mengchang:p009","quote":"孟嘗君怨秦，將以齊爲韓、魏攻楚，因與韓、魏攻秦，而借兵食於西周。蘇代爲西周謂曰：「君以齊爲韓、魏攻楚九年，取宛、葉以北以彊韓、魏，今復攻秦以益之。韓、魏南無楚憂，西無秦患，則齊危矣。韓、魏必輕齊畏秦，臣爲君危之。君不如令敝邑深合於秦，而君無攻，又無借兵食。君臨函谷而無攻，令敝邑以君之情謂秦昭王曰『薛公必不破秦以彊韓、魏。其攻秦也，欲王之令楚王割東國以與齊，而秦出楚懷王以爲和』。君令敝邑以此惠秦，秦得無破而以東國自免也，秦必欲之。楚王得出，必德齊。齊得東國益彊，而薛世世無患矣。秦不大弱，而處三晉之西，三晉必重齊。」薛公曰：「善。」因令韓、魏賀秦，使三國無攻，而不借兵食於西周矣。是時，楚懷王入秦，秦留之，故欲必出之。秦不果出楚懷王。"},{"paragraph_id":"c-shiji-075-mengchang:p011","quote":"其後，秦亡將呂禮相齊，欲困蘇代。代乃謂孟嘗君曰：「周最於齊，至厚也，而齊王逐之，而聽親弗相呂禮者，欲取秦也。齊、秦合，則親弗與呂禮重矣。有用，齊、秦必輕君。君不如急北兵，趨趙以和秦、魏，收周最以厚行，且反齊王之信，又禁天下之變。齊無秦，則天下集齊，親弗必走，則齊王孰與爲其國也！」於是孟嘗君從其計，而呂禮嫉害於孟嘗君。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p005","text":"秦昭王聞其賢，乃先使涇陽君爲質於齊，以求見孟嘗君。孟嘗君將入秦，賓客莫欲其行，諫，不聽。蘇代謂曰：「今旦代從外來，見木禺人與土禺人相與語。木禺人曰：『天雨，子將敗矣。』土禺人曰：『我生於土，敗則歸土。今天雨，流子而行，未知所止息也。』今秦，虎狼之國也，而君欲往，如有不得還，君得無爲土禺人所笑乎？」孟嘗君乃止。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m005-0000","start":0,"end":3,"surface":"秦昭王","kind":"person","person_id":"ajv_agq_es1","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m005-0010","start":10,"end":13,"surface":"涇陽君","kind":"person","person_id":"mjq_bhc_w7f","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m005-0021","start":21,"end":24,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m005-0025","start":25,"end":28,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m005-0032","start":32,"end":34,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved","note":"寓言木土偶、未名群體、族屬或未定指代，不當真人或補群體成員；二人需各按已定位客角色解讀，不將所有客稱接同一人。"},{"id":"c-shiji-075-