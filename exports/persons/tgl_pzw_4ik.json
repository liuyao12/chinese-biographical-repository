tus":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0156","start":156,"end":158,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0166","start":166,"end":167,"surface":"糾","kind":"person","person_id":"fng_mjp_tdn","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0178","start":178,"end":180,"surface":"小白","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0183","start":183,"end":185,"surface":"高傒","kind":"person","person_id":"v35_hyj_z4u","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0190","start":190,"end":192,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-032-qi:p030","text":"桓公之中鉤，詳死以誤管仲，已而載溫車中馳行，亦有高、國內應，故得先入立，發兵距魯。秋，與魯戰于乾時，魯兵敗走，齊兵掩絕魯歸道。齊遺魯書曰：「子糾兄弟，弗忍誅，請魯自殺之。召忽、管仲讎也，請得而甘心醢之。不然，將圍魯。」魯人患之，遂殺子糾于笙瀆。召忽自殺，管仲請囚。桓公之立，發兵攻魯，心欲殺管仲。鮑叔牙曰：「臣幸得從君，君竟以立。君之尊，臣無以增君。君將治齊，即高傒與叔牙足也。君且欲霸王，非管夷吾不可。夷吾所居國國重，不可失也。」於是桓公從之。乃詳為召管仲欲甘心，實欲用之。管仲知之，故請往。鮑叔牙迎受管仲，及堂阜而脫桎梏，齋祓而見桓公。桓公厚禮以為大夫，任政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m030-0000","start":0,"end":2,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0010","start":10,"end":12,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0024","start":24,"end":27,"surface":"高、國","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m030-0070","start":70,"end":72,"surface":"子糾","kind":"person","person_id":"fng_mjp_tdn","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0085","start":85,"end":87,"surface":"召忽","kind":"person","person_id":"8vp_hqi_6mq",