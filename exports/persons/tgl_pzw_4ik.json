"b-shiji-062","chapter_id":"c-shiji-062-guanyan","mention_count":1,"mention_ids":["c-shiji-062-guanyan:m002-0116"],"paragraph_ids":["c-shiji-062-guanyan:p002"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-032-qi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-032-qi:m029-0054","start":54,"end":56,"surface":"召忽","kind":"person","person_id":"8vp_hqi_6mq","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p029","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m030-0085","start":85,"end":87,"surface":"召忽","kind":"person","person_id":"8vp_hqi_6mq","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p030","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m030-0122","start":122,"end":124,"surface":"召忽","kind":"person","person_id":"8vp_hqi_6mq","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p030","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-033-lu:m040-0039","start":39,"end":41,"surface":"召忽","kind":"person","person_id":"8vp_hqi_6mq","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p040","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-062-guanyan:m002-0116","start":116,"end":118,"surface":"召忽","kind":"person","person_id":"tgl_pzw_4ik","status":"contextual_provisional","paragraph_id":"c-shiji-062-guanyan:p002","chapter_id":"c-shiji-062-guanyan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-051","person_id":"8vp_hqi_6mq","surfaces":["召忽"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。"},{"paragraph_id":"c-shiji-033-lu:p040","quote":"八年，齊公子糾來奔。九年，魯欲內子糾於齊，後桓公，桓公發兵擊魯，魯急，殺子糾。召忽死。齊告魯生致管仲。魯人施伯曰：『齊欲得管仲，非殺之也，將用之，用之則爲魯患。不如殺，以其尸與之。』莊公不聽，遂囚管仲與齊。齊人相管仲。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji062-005","person_id":"tgl_pzw_4ik","surfaces":["召忽"],"scope":"same_chapter","chapter_ids":["c-shiji-062-guanyan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-062-guanyan:p002","quote":"管仲曰：「吾始困時，嘗與鮑叔賈，分財利多自與，鮑叔不以我為貪，知我貧也。吾嘗為鮑叔謀事而更窮困，鮑叔不以我為愚，知時有利不利也。吾嘗三仕三見逐於君，鮑叔不以我為不肖，知我不遭時也。吾嘗三戰三走，鮑叔不以我怯，知我有老母也。公子糾敗，召忽死之，吾幽囚受辱，鮑叔不以我為無恥，知我不羞小節而恥功名不顯于天下也。生我者父母，知我者鮑子也。」"}],"rationale":"依明示姓名、齊公子小白立桓公、晏平仲嬰與對話說話者及御者妻敘事局部暫接；不全域按短字匹配，不把書名當人名，未名人物不補全名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji062-zhaohu","person_ids":["8vp_hqi_6mq","tgl_pzw_4ik"],"canonical_person_id":"8vp_hqi_6mq","scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-062-guanyan"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p029","quote":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。","mention_ids":["c-shiji-032-qi:m029-0054"]},{"chapter_id":"c-shiji-062-guanyan","source_id":"s-shiji-062-guanyan","paragraph_id":"c-shiji-062-guanyan:p002","quote":"管仲曰：「吾始困時，嘗與鮑叔賈，分財利多自與，鮑叔不以我為貪，知我貧也。吾嘗為鮑叔謀事而更窮困，鮑叔不以我為愚，知時有利不利也。吾嘗三仕三見逐於君，鮑叔不以我為不肖，知我不遭時也。吾嘗三戰三走，鮑叔不以我怯，知我有老母也。公子糾敗，召忽死之，吾幽囚受辱，鮑叔不以我為無恥，知我不羞小節而恥功名不顯于天下也。生我者父母，知我者鮑子也。」","mention_ids":["c-shiji-062-guanyan:m002-0116"]}],"rationale":"齊世家召忽與管仲同傅公子糾，本篇同在公子糾敗的回顧中稱召忽，敘事組合相配。 已發ID與各篇原文保留，同書各篇不當獨立見證；身份暫接不確證史實或任期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-032-qi:p029","text":"初，襄公之醉殺魯桓公，通其夫人，殺誅數不當，淫於婦人，數欺大臣，群弟恐禍及，故次弟糾奔魯。其母魯女也。管仲、召忽傅之。次弟小白奔莒，鮑叔傅之。小白母，衛女也，有寵於釐公。小白自少好善大夫高傒。及雍林人殺無知，議立君，高、國先陰召小白於莒。魯聞無知死，亦發兵送公子糾，而使管仲別將兵遮莒道，射中小白帶鉤。小白詳死，管仲使人馳報魯。魯送糾者行益遲，六日至齊，則小白已入，高傒立之，是為桓公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m029-0002","start":2,"end":4,"surface":"襄公","kind":"person","person_id":"qj2_k5a_sq4","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0007","start":7,"end":10,"surface":"魯桓公","kind":"person","person_id":"lc6_cup_v9c_AB","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0012","start":12,"end":15,"surface":"其夫人","kind":"person","person_id":"z16_hit_u7t","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0032","start":32,"end":34,"surface":"群弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代，不補未見姓名與成員；官禮等級不直接當授官。"},{"id":"c-shiji-032-qi:m029-0041","start":41,"end":42,"surface":"糾","kind":"person","person_id":"fng_mjp_tdn","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0047","start":47,"end":49,"surface":"魯女","kind":"person","person_id":"i7a_rc8_hf1","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0051","start":51,"end":53,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0054","start":54,"end":56,"surface":"召忽","kind":"person","person_id":"8vp_hqi_6mq","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0061","start":61,"end":63,"surface":"小白","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m029-0066","start":66,"end":68,"sur