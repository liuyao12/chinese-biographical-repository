,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0247","start":247,"end":250,"surface":"鮑叔牙","kind":"person","person_id":"hkc_5tg_d73","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0252","start":252,"end":254,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0267","start":267,"end":269,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m030-0270","start":270,"end":272,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-033-lu:p040","text":"八年，齊公子糾來奔。九年，魯欲內子糾於齊，後桓公，桓公發兵擊魯，魯急，殺子糾。召忽死。齊告魯生致管仲。魯人施伯曰：『齊欲得管仲，非殺之也，將用之，用之則爲魯患。不如殺，以其尸與之。』莊公不聽，遂囚管仲與齊。齊人相管仲。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m040-0003","start":3,"end":7,"surface":"齊公子糾","kind":"person","person_id":"fng_mjp_tdn","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0016","start":16,"end":18,"surface":"子糾","kind":"person","person_id":"fng_mjp_tdn","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0022","start":22,"end":24,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0025","start":25,"end":27,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0036","start":36,"end":38,"surface":"子糾","kind":"person","person_id":"fng_mjp_tdn","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0039","start":39,"end":41,"surface":"召忽","kind":"person","person_id":"8vp_hqi_6mq","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0048","start":48,"end":50,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0051","start":51,"end":53,"surface":"魯人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m040-0053","start":53,"end":55,"surface":"施伯","kind":"person","person_id":"rpb_oth_6jb","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0061","start":61,"end":63,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0091","start":91,"end":93,"surface":"莊公","kind":"person","person_id":"x50_1p7_qkk","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0098","start":98,"end":100,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m040-0103","start":103,"end":105,"surface":"齊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m040-0106","start":106,"end":108,"surface":"管仲","kind":"person","person_id":"h1v_8ap_b9y","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-062-guanyan:p002","text":"管仲曰：「吾始困時，嘗與鮑叔賈，分財利多自與，鮑叔不以我為貪，知我貧也。吾嘗為鮑叔謀事而更窮困，鮑叔不以我為愚，知時有利不利也。吾嘗三仕三見逐於君，鮑叔不以我為不肖，知我不遭時也。吾嘗三戰三走，鮑叔不以我怯，知我有老母也。公子糾敗，召忽死之，吾幽囚受辱，鮑叔不以我為無恥，知我不羞小節而恥功名不顯于天下也。生我者父母，知我者鮑子也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-062-guanyan:m002-0000","start":0,"end":2,"surface":"管仲","kind":"person","person_id":"761_6ot_9wz_A","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m002-0012","start":12,"end":14,"surface":"鮑叔","kind":"person","person_id":"ndr_tb3_504","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m002-0023","start":23,"end":25,"surface":"鮑叔","kind":"person","person_id":"ndr_tb3_504","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m