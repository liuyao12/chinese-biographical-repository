"c-chenshu-013-xunlang-rendered:p004","text":"高祖崩，宣太后與舍人蔡景歷祕不發喪，朗弟曉在都微知之，乃謀率其家兵襲臺。事覺，景歷殺曉，仍繫其兄弟。世祖即位，並釋之。因厚撫慰朗，令與侯安都等共拒王琳。琳平，遷使持節、安北將軍、散騎常侍、都督霍晉合三州諸軍事、合州刺史。天嘉六年卒，時年四十八。贈南豫州刺史，諡曰壯。子法尚嗣。","annotation_status":"in_progress","mentions":[{"id":"c-chenshu-013-xunlang-rendered:p004:m0039","kind":"person","person_id":"sko_1z7_fje_B","start":0,"end":2,"surface":"高祖","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0040","kind":"person","person_id":"64d_v5z_1lf","start":4,"end":7,"surface":"宣太后","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0041","kind":"person","person_id":"09h_mbd_vri","start":10,"end":13,"surface":"蔡景歷","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0042","kind":"person","person_id":"vh4_rsb_xo3_AA","start":18,"end":19,"surface":"朗","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0043","kind":"person","person_id":"k1s_ws8_h2d","start":20,"end":21,"surface":"曉","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0044","kind":"person","person_id":"09h_mbd_vri","start":39,"end":41,"surface":"景歷","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0045","kind":"person","person_id":"k1s_ws8_h2d","start":42,"end":43,"surface":"曉","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0046","kind":"person","person_id":"sko_1z7_fje_AA","start":50,"end":52,"surface":"世祖","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0047","kind":"person","person_id":"vh4_rsb_xo3_AA","start":63,"end":64,"surface":"朗","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0048","kind":"person","person_id":"700_wy4_ctv","start":67,"end":70,"surface":"侯安都","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p004:m0049","kind":"person","person_id":"9kl_8w5_vq8","start":73,"end":75,"surface":"王琳","status":"conte