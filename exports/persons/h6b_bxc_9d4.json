_36a_*A","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m008-0025","start":25,"end":29,"surface":"車騎將軍","kind":"person","person_id":"7dv_lqp_y4z","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m008-0046","start":46,"end":48,"surface":"陳豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m008-0050","start":50,"end":51,"surface":"敞","kind":"person","person_id":"h6b_bxc_9d4","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m008-0062","start":62,"end":64,"surface":"黥布","kind":"person","person_id":"zxd_afr_2xg","status":"contextual_provisional"}],"chapter_id":"c-shiji-098-fujin","book_id":"b-shiji-098","work_id":"w-shiji","source_id":"s-shiji-098-fujin"}],"sources":[{"chapter_id":"c-hanshu-041-fanli","work_id":"w-hanshu","book_id":"b-hanshu-041","source_id":"s-hanshu-041-fanli","source":{"title":"漢書／卷041","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/漢書/卷041","permalink":"https://zh.wikisource.org/w/index.php?title=漢書/卷041&oldid=2342290","revision_id":2342290,"accessed_on":"2026-10-15","extent":"目前錄傅寬三段、靳歙五段、周惞三段，共十一段；卷內樊、酈、滕、灌傳及贊未匯入，不代表全卷完成。","included_sections":["傅寬傳文","靳歙傳文","周惞傳文"],"text_scope":"partial_chapter","image_verified":false,"rights":"古代原文；維基文庫數位轉錄依CC BY-SA 4.0，保留貢獻者署名及固定修訂連結。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去除現代網頁小標與Wikipedia模板，保留三節十一段原字、標點與數位異文；新補觞、五石等原字不默改，異讀另記。","note":"古代篇名仍為樊酈滕灌傅靳周傳；採節內穩定段ID，日後補前文不重編既有錨點。未核書影。"},"review_status":"text_checked","edition":null,"revision_timestamp":"2023-12-14T05:51:09Z"}},{"chapter_id":"c-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","source_id":"s-shiji-008-gaozu","source":{"title":"史記／卷008","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷008","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷008&oldid=2440965","revision_id":2440965,"accessed_on":"2026-10-09","extent"