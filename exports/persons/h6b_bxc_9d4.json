"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0032","start":32,"end":34,"surface":"張春","kind":"person","person_id":"7ck_5iz_er1","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0044","start":44,"end":46,"surface":"郭蒙","kind":"person","person_id":"cfk_4it_4yn","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m074-0057","start":57,"end":59,"surface":"周勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-093-hanlu:p017","text":"十一年冬，漢兵擊斬陳豨將侯敞、王黃於曲逆下，破豨將張春於聊城，斬首萬餘。太尉勃入定太原、代地。十二月，上自擊東垣，東垣不下，卒罵上；東垣降，卒罵者斬之，不罵者黥之。更命東垣為真定。王黃、曼丘臣其麾下受購賞之，皆生得，以故陳豨軍遂敗。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m017-0009","start":9,"end":11,"surface":"陳豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0012","start":12,"end":14,"surface":"侯敞","kind":"person","person_id":"h6b_bxc_9d4","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0015","start":15,"end":17,"surface":"王黃","kind":"person","person_id":"4q3_8yy_0ys","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0023","start":23,"end":24,"surface":"豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0025","start":25,"end":27,"surface":"張春","kind":"person","person_id":"qf1_qbc_81g","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0038","start":38,"end":39,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0051","start":51,"end":52,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m017-0064","start":64,"end":65,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_p