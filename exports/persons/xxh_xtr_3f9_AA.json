,220,221,222,223,224,225,226,227,228,229,230,231,232],"revision_id":1530926},"mentions":[{"id":"c-liangshu-031-yuanjing-yuanang:p001:m0000","start":0,"end":2,"surface":"袁昂","kind":"person","person_id":"hb9_2gq_205","status":"contextual_provisional"},{"id":"c-liangshu-031-yuanjing-yuanang:p001:m0003","start":3,"end":5,"surface":"千里","kind":"person","person_id":"hb9_2gq_205","status":"contextual_provisional"},{"id":"c-liangshu-031-yuanjing-yuanang:p001:m0013","start":13,"end":14,"surface":"洵","kind":"person","person_id":"xxh_xtr_3f9_A","status":"contextual_provisional"},{"id":"c-liangshu-031-yuanjing-yuanang:p001:m0027","start":27,"end":28,"surface":"顗","kind":"person","person_id":"xxh_xtr_3f9_AA","status":"contextual_provisional"}],"chapter_id":"c-liangshu-031-yuanjing-yuanang","book_id":"b-liangshu-031","work_id":"w-liangshu","source_id":"s-liangshu-031-yuanjing-yuanang-ws1530926"},{"id":"c-nanshi-023-wangyu-jingwen:p009","text":"若乃吉凶大期，正應委之理運。遭隨參差，莫不由命也。既非聖人，不能見吉凶之先，正是依俙於理，言可行而為之耳。得吉者是其命吉，遇不吉者是其命凶。以近事論之：景和之世，晉平庶人從壽陽歸亂朝，人皆為之戰慄，而乃遇中興之運。袁顗圖避禍於襄陽，當時皆羨之，謂為陵霄駕鳳，遂與義嘉同滅。駱宰見狂主，語人言：「越王長頸鳥喙，可與共憂，不可共樂。范蠡去而全身，文種留而遇禍。今主口頸頗有越王之狀，我在尚書中久，不去必危」。遂求南江小縣。諸都令史住京師者，皆遭中興之慶，人人蒙爵級；宰逢義嘉染罪，金木纏身，性命幾絕。卿耳目所聞見，安危在運，何可豫圖邪？","mentions":[{"id":"c-nanshi-023-wangyu-jingwen:p009:m0107","surface":"袁顗","start":107,"end":109,"person_id":"xxh_xtr_3f9_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p009:m0136","surface":"駱宰","start":136,"end":138,"person_id":"216_b6d_184","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p009:m0164","surface":"范蠡","start":164,"end":166,"person_id":"yhm_h9f_8p0","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p009:m0171","surface":"文種","start":171,"end":173,"person_id":"eea_4d1_915","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官