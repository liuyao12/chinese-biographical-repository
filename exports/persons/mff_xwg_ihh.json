ress_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-050-hufan:p002","text":"藩少孤，居喪以毀稱。太守韓伯見之，謂藩叔尚書少廣曰：「卿此姪當以義烈成名。」州府辟召，不就。須二弟冠婚畢，及參郗恢征虜軍事。時殷仲堪為荊州刺史，藩外兄羅企生為仲堪參軍，藩請假還，過江陵省企生。仲堪要藩相見，接待甚厚。藩因說仲堪曰：「桓玄意趣不常，每怏怏於失職。節下崇待太過，非將來之計也。」仲堪色不悅。藩退而謂企生曰：「倒戈授人，必至之禍。若不早規去就，後悔無及。」玄自夏口襲仲堪，藩參玄後軍軍事。仲堪敗，企生果以附從及禍。藩轉參太尉、大將軍、相國軍事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":14,"last_line":14,"raw_start":244,"raw_end":561,"raw_character_offsets":[244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407,408,409,410,411,412,413,414,415,416,417,418,419,420,421,422,423,424,425,426,427,428,429,430,431,432,433,434,435,436,437,438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502],"revision_id":2371899},"mentions":[{"id":"c-songshu-050-hufan:p002:m0000","start":0,"end":1,"surface":"藩","kind":"person","person_id":"otw_1ui_wba","status":"contextual_provisional"},{"id":"c-songshu-050-hufan:p002:m0012","start":12,"end":14,"surface":"韓伯","kind":"person","person_id":"al7_2l9_13l","status":"contextual_provisional"},{"id":"c-songshu-050-hufan:p002:m0018","start":18,"end":19,"surface":"藩","kind":"person","person_id":"otw_1ui_wba","stat