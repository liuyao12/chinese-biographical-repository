vy_x7a","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-056-attendants-complete","book_id":"b-nanqishu-056","work_id":"w-nanqishu","source_id":"s-nanqishu-056-attendants-complete-ws1504717"},{"id":"c-nanqishu-056-attendants-complete:p009","text":"　　太祖廢蒼梧，明旦，呼正直舍人虞整，醉不能起，係宗歡喜奉命。太祖曰：「今天地重開，是卿盡力之日。」使寫諸處分敕令，及四方書疏。使主書十人書吏二十人配之，事皆稱旨。除羽林監，轉步兵校尉。仍除龍驤將軍，出爲海鹽令。太祖卽位，除龍驤將軍、建康令。永明元年，除寧朔將軍，令如故。尋轉右軍將軍、淮陵太守，兼中書通事舍人。母喪自解，起爲寧朔將軍，復本職。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":35,"last_line":35,"raw_start":2150,"raw_end":2329,"raw_character_offsets":[2150,2151,2152,2153,2154,2155,2156,2157,2158,2159,2160,2161,2162,2163,2164,2165,2166,2167,2168,2169,2170,2171,2172,2173,2174,2175,2176,2177,2178,2179,2180,2181,2182,2183,2184,2185,2186,2187,2188,2189,2190,2191,2192,2193,2194,2195,2196,2197,2198,2199,2200,2201,2202,2203,2204,2205,2206,2207,2208,2209,2210,2211,2212,2213,2214,2215,2216,2217,2218,2219,2220,2221,2222,2223,2224,2225,2226,2227,2228,2229,2230,2231,2232,2233,2234,2235,2236,2237,2238,2239,2240,2241,2242,2243,2244,2245,2246,2247,2248,2249,2250,2251,2252,2253,2254,2255,2256,2257,2258,2259,2260,2261,2262,2263,2264,2265,2266,2267,2268,2269,2270,2276,2277,2278,2279,2282,2283,2284,2285,2286,2287,2288,2289,2290,2291,2292,2293,2294,2295,2296,2297,2298,2299,2300,2301,2302,2303,2304,2305,2306,2307,2308,2309,2310,2311,2312,2313,2314,2315,2316,2317,2318,2319,2320,2321,2322,2323,2324,2325,2326,2327,2328],"revision_id":1504717},"mentions":[{"id":"c-nanqishu-056-attendants-complete:p009:m0002","start":2,"end":4,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-056-attendants-complete:p009:m0016","start":16,"end":18,"surface":"虞整","kind":"person","person_id":"upx_g96_gro","status":"contextual_provisional"},{"id":"c-nanqishu-056-attendants-complete:p009:m0024","start":24,"end":26,"surface":"係宗","kind":"person","person_id":"fag_9vy_x7a","status":"contextual_provisional"},{"id":"c-nanqishu-056-attendants-complete:p009:m0031","start":31,"end":33,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-056-attendants-complete:p009:m0106","start":106,"end":108,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-056-attendants-complete","book_id":"b-nanqishu-056","work_id":"w-nanqishu","source_id":"s-nanqishu-056-attendants-complete-ws1504717"},{"id":"c-nanqishu-056-attendants-complete:p010","text":"　　四年，白賊唐宇之起，宿衞兵東討，遣係宗隨軍慰勞，徧至遭賊郡縣。百姓被驅逼者，悉無所問，還復民伍。係宗還，上曰：「此段有征無戰，以時平蕩，百姓安怗，甚快也。」賜係宗錢帛。上欲脩治白下城，難於動役。係宗啓謫役東民丁隨宇之爲逆者，上從之。後車駕講武，上履行白下城，曰：「劉係宗爲國家得此一城。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":37,"last_line":37,"raw_start":2331,"raw_end":2477,"raw_character_offsets":[2331,2332,2333,2334,2335,2336,2337,2338,2339,2340,2341,2342,2343,2344,2345,2346,2347,2348,2349,2350,2351,2352,2353,2354,2355,2356,2357,2358,2359,2360,2361,2362,2363,2364,2365,2366,2367,2368,2369,2370,2371,2372,2373,2374,2375,2376,2377,2378,2379,2380,2381,2382,2383,2384,2385,2386,2387,2388,2389,2390,2391,2392,2393,2394,2395,2396,2397,2398,2399,2400,2401,2402,2403,2404,2405,2406,2407,2408,2409,2410,2411,2412,2413,2414,2415,2416,2417,2418,2419,2420,2421,2422,2423,2424,2425,2426,2427,2428,2429,2430,2431,2432,2433,2434,2435,2436,2437,2438,2439,2440,2441,2442,2443,2444,2445,2446,2447,2448,2449,2450,2451,2452,2453,2454,2455,2456,2457,2458,2459,2460,2461,2462,2463,2464,2465,2466,2467,2468,2469,2470,2471,2472,2473,2474,2475,2476],"revision_id":1504717},"mentions":[{"id":"c-nanqishu-056-attendants-complete:p010:m0007","start":7,"end":10,"surface":"唐宇之","kind":"person","person_id":"z53_7ry_s10","status":"contextual_provisional"},{"id":"c-nanqishu-056-attendants-complete:p010:m0019","start":19,"end":21,"surface":"係宗","kind":"person","person_id":"fag_9vy_x7a","status":"contextual_provisional"},{"id":"c-nanqishu-056-attendants-comp