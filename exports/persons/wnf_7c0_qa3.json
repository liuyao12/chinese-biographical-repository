wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p013","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m013-0015","start":15,"end":17,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p013","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m013-0035","start":35,"end":37,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p013","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m013-0044","start":44,"end":46,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p013","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m013-0057","start":57,"end":59,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p013","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m014-0017","start":17,"end":19,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p014","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m014-0034","start":34,"end":36,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p014","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m014-0060","start":60,"end":62,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p014","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m022-0040","start":40,"end":42,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p022","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m022-0043","start":43,"end":45,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p022","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m022-0063","start":63,"end":65,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p022","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m037-0030","start":30,"end":32,"surface":"陽虎","kind":"person","person_id":"wnf_7c0_qa3","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p037","chapter_id":"c-shiji-047-kong"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji047-031","person_id":"wnf_7c0_qa3","surfaces":["陽虎"],"scope":"same_chapter","chapter_ids":["c-shiji-047-kong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-047-kong:p003","quote":"孔子要絰，季氏饗士，孔子與往。陽虎絀曰：「季氏饗士，非敢饗子也。」孔子由是退。"},{"paragraph_id":"c-shiji-047-kong:p013","quote":"桓子嬖臣曰仲梁懷，與陽虎有隙。陽虎欲逐懷，公山不狃止之。其秋，懷益驕，陽虎執懷。桓子怒，陽虎因囚桓子，與盟而醳之。陽虎由此益輕季氏。季氏亦僭於公室，陪臣執國政，是以魯自大夫以下皆僭離於正道。故孔子不仕，退而脩詩書禮樂，弟子彌衆，至自遠方，莫不受業焉。"},{"paragraph_id":"c-shiji-047-kong:p014","quote":"定公八年，公山不狃不得意於季氏，因陽虎為亂，欲廢三桓之適，更立其庶孽陽虎素所善者，遂執季桓子。桓子詐之，得脫。定公九年，陽虎不勝，奔于齊。是時孔子年五十。"},{"paragraph_id":"c-shiji-047-kong:p022","quote":"將適陳，過匡，顏刻為僕，以其策指之曰：「昔吾入此，由彼缺也。」匡人聞之，以為魯之陽虎。陽虎嘗暴匡人，匡人於是遂止孔子。孔子狀類陽虎，拘焉五日，顏淵後，子曰：「吾以汝為死矣。」顏淵曰：「子在，回何敢死！」匡人拘孔子益急，弟子懼。孔子曰：「文王既沒，文不在茲乎？天之將喪斯文也，後死者不得與于斯文也。天之未喪斯文也，匡人其如予何！」孔子使從者為甯武子臣於衞，然後得去。"},{"paragraph_id":"c-shiji-047-kong:p037","quote":"夏，衞靈公卒，立孫輒，是為衞出公。六月，趙鞅內太子蒯聵于戚。陽虎使太子絻，八人衰絰，偽自衞迎者，哭而入，遂居焉。冬，蔡遷于州來。是歲魯哀公三年，而孔子年六十矣。齊助衞圍戚，以衞太子蒯聵在故也。"}],"rationale":"限本篇明示名、字、對話自稱、世系及附贊局部對應；世系求與冉求分開，武不接漢武帝，今皇帝與高皇帝不補姓名。子路仲由明示同指另存，冉有冉求與秦繆秦穆仍待核；附贊不當獨立作者正文或獨立見證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-047-kong:p003","text":"孔子要絰，季氏饗士，孔子與往。陽虎絀曰：「季氏饗士，非敢饗子也。」孔子由是退。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shi