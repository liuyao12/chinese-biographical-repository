tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":97,"end":99,"surface":"南郡","id":"c-liangshu-021-wangzhi-wyd:p002:m0097","person_id":"iop_ybd_afm","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作南郡。","paragraph_id":"c-liangshu-021-wangzhi-wyd:p002","chapter_id":"c-liangshu-021-wangzhi-wyd"},{"start":117,"end":119,"surface":"南郡","id":"c-liangshu-021-wangzhi:p002:m0117","person_id":"iop_ybd_afm","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作南郡。","paragraph_id":"c-liangshu-021-wangzhi:p002","chapter_id":"c-liangshu-021-wangzhi"},{"id":"c-nanqishu-043-xieyue:p005:m0012","start":12,"end":14,"surface":"鬱林","kind":"person","person_id":"iop_ybd_afm","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yulin","paragraph_id":"c-nanqishu-043-xieyue:p005","chapter_id":"c-nanqishu-043-xieyue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi043-xieyue-yulin","person_id":"iop_ybd_afm","surfaces":["鬱林"],"scope":"same_chapter","chapter_ids":["c-nanqishu-043-xieyue"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-xieyue","source_id":"s-nanqishu043-ws2400356","paragraph_id":"c-nanqishu-043-xieyue:p005","quote":"服闋，爲吏部尚書。高宗廢鬱林，領兵入殿，左右驚走報𤅢。與客圍棊，每下子，輙云「其當有意」。竟局，乃還齋卧，竟不問外事也。明帝卽位，𤅢又屬疾不視事。後上讌會，功臣上酒，尚書令王晏等興席，𤅢獨不起，曰：「陛下受命，應天從民，王晏妄叨天功以爲己力。」上大笑解之。座罷，晏呼𤅢共載還令省，欲相撫悅。又正色曰：「君巢窟在何處？」晏初得班劔，𤅢謂之曰：「身家太傅裁得六人。君亦何事一朝至此。」晏甚憚之。"}],"rationale":"固定齊004首鬱林王昭業、齊006首高宗廢鬱林之即位序，與本傳高宗廢鬱林同事件；來源王號映具體昭業，不把名字添正文。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_readings":[{"raw_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi004-fixed.wikitext","metadata_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi004-metadata.json","revision_id":1767523,"raw_sha256":"bf378be0b0e33d50202dbcca42a748f2056c3023f0afb641b4d816934e3afb44","read_segments":[{"first_line":11,"last_line":11,"raw_start":156,"raw_end":300,"raw_quote":"鬱林王昭業字元尚，文惠太子長子也。小名法身。世祖即位，封南郡王，二千戶。永明五年十一月戊子，冠於東宮崇政殿。其日小會，賜王公以下帛各有差，給昭業扶二人。七年，有司奏給班劍二十人，鼓吹一部，高選友、學。十一年，給皁輪三望車。詔高選國官。文惠太子薨，立昭業為皇太孫，居東宮。世祖崩，太孫即位。"}],"scope":"首段鬱林王名諱及即位。"},{"raw_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi006-fixed.wikitext","metadata_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi006-metadata.json","revision_id":2311630,"raw_sha256":"e7ada4fcb0bc732993f40d1e23f8250e09c37d2e3e42e6e19986d2ab0b3a2f29","read_segments":[{"first_line":11,"last_line":11,"raw_start":164,"raw_end":905,"raw_quote":"高宗明皇帝諱鸞，字景栖，始安貞王道生子也。小諱玄度。少孤，太祖撫育，恩過諸子。宋泰豫元年，為安吉令，有嚴能之名。補武陵王左常侍，不拜。元徽二年，為永世令。昇明二年，為邵陵王安南記室參軍。未拜，仍遷寧朔將軍、淮南宣城二郡太守。尋進號輔國將軍。太祖踐阼，遷侍中，封西昌侯，邑千戶。建元二年，為持節、督郢州司州之義陽諸軍事、冠軍將軍、郢州刺史，進號征虜將軍。世祖即位，轉度支尚書，領右軍將軍。永明元年，遷侍中，領驍騎將軍。王子侯舊乘纏帷車，高宗獨乘下帷，儀從如素士。公事混撓，販食人擔火誤燒牛鼻，豫章王白世祖，世祖笑焉。轉為散騎常侍、左衞將軍，清道而行，上甚悅。二年，出為征虜將軍、吳興太守。四年，遷中領軍，常侍竝如故。五年，為持節、監豫州郢州之西陽司州之汝南二郡軍事、右將軍、豫州刺史。七年，為尚書右僕射。八年，加領衞尉。十年，轉左僕射。十一年，領右衞將軍。世祖遺詔為侍中、尚書令，尋加鎮軍將軍，給班劍二十人。隆昌元年，即本號為大將軍，給鼓吹一部，親兵五百人。尋又加中書監、開府儀同三司。鬱林王廢，海陵王立，為使持節、都督揚南徐二州軍事、驃騎大將軍、錄尚書事、揚州刺史，開府如故，增班劍為三十人，封宣城郡公，二千戶。<ref>封宣城郡公二千戶　按文選三十八任昉為齊明帝讓宣城郡公第一表云「封宣城郡開國公，食邑三千戶」。</ref>鎮東府城。給兵五千人，錢二百萬，布千匹。九江作難，假黃鉞，事寧，表送之。尋加黃鉞、都督中外諸軍事、太傅，領大將軍、揚州牧，增班劍為四十人，給幢絡三望車，前後部羽葆鼓吹，劍履上殿，入朝不趨，贊拜不名，置左右長史、司馬、從事中郎、掾、屬各四人，封宣城王，邑五千戶，持節、侍中、中書監、錄尚書竝如故。未拜，太后令廢海陵王，以上入纂太祖為第三子，羣臣三請，乃受命。"}],"scope":"首完整段高宗名諱與廢鬱林、入纂太祖序。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-021-wangzhi-wyd:p002","text":"志年九歲居所生母憂哀容毀瘠為中表所異弱冠選尚宋孝武女安固公主拜駙馬都尉秘書郎累遷太尉行參軍太子舍人武陵王文學褚淵為司徒引志為主簿淵謂僧虔曰朝廷之恩本為殊特所可光榮在屈賢子累遷鎮北竟陵王功曹史安陸南郡二王友入為中書侍郎尋除宣城內史清謹有恩惠郡民張倪吳慶爭田經年不決志到官父老乃相謂曰王府君有德政吾曹鄉里乃有此爭倪慶相攜請罪所訟地遂為閑田徵拜黃門侍郎尋遷吏部侍郎出為寧朔將軍東陽太守郡獄有重囚十餘人冬至日悉遣還家過節皆返惟一人失期獄司以為言志曰此自太守事主者勿憂明旦果自詣獄辭以婦孕吏民益歎服之視事三年齊永明二年入為侍中未拜轉吏部尚書在選以和理稱崔慧景平以例加右軍將軍封臨汝侯固讓不受改領右衛將軍","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"志","id":"c-liangshu-021-wangzhi-wyd:p002:m0000","person_id":"7r6_k52_qji_ABAAAAEBC","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作志。"},{"start":14,"end":16,"surface":"中表","id":"c-liangshu-021-wangzhi-wyd:p002:u0014","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"合稱親戚，未分個人"},{"start":22,"end":25,"surface":"宋孝武","id":"c-liangshu-021-wangzhi-wyd:p002:m0022","person_id":"hx8_st4_jdd","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作孝武。"},{"start":26,"end":30,"surface":"安固公主","id":"c-liangshu-021-wangzhi-wyd:p002:m0026","person_id":"hx8_st4_jdd_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作安固公主。"},{"start":49,"end":52,"surface":"武陵王","id":"c-liangshu-021-wangzhi-wyd:p002:m0049","person_id":"i1v_ajd_qr0","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作武陵王。"},{"start":54,"end":56,"surface":"褚淵","id":"c-liangshu-021-wangzhi-wyd:p002:m0054","person_id":"jyx_72x_8t2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作褚淵。"},{"start":60,"end":61,"surface":"志","id":"c-liangshu-021-wangzhi-wyd:p002:m0060","person_id":"7r6_k52_qji_ABAAAAEBC","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作志。"},{"start":64,"end":65,"surface":"淵","id":"c-liangshu-021-wangzhi-wyd:p002:m0064","person_id":"jyx_72x_8t2","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作褚淵。"},{"start":66,"end":68,"surface":"僧虔","id":"c-liangshu-021-wangzhi-wyd:p002:m0066","person_id":"7r6_k52_qji_ABAAAAEB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名