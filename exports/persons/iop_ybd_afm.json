itorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-043-xieyue:p005:m0012","start":12,"end":14,"surface":"鬱林","kind":"person","person_id":"iop_ybd_afm","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yulin","paragraph_id":"c-nanqishu-043-xieyue:p005","chapter_id":"c-nanqishu-043-xieyue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi043-xieyue-yulin","person_id":"iop_ybd_afm","surfaces":["鬱林"],"scope":"same_chapter","chapter_ids":["c-nanqishu-043-xieyue"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-xieyue","source_id":"s-nanqishu043-ws2400356","paragraph_id":"c-nanqishu-043-xieyue:p005","quote_passage_ref":"data/corpus/nanqishu/043-xieyue.json"}],"rationale":"固定齊004首鬱林王昭業、齊006首高宗廢鬱林之即位序，與本傳高宗廢鬱林同事件；來源王號映具體昭業，不把名字添正文。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_readings":[{"raw_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi004-fixed.wikitext","metadata_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi004-metadata.json","revision_id":1767523,"raw_sha256":"bf378be0b0e33d50202dbcca42a748f2056c3023f0afb641b4d816934e3afb44","read_segments":[{"first_line":11,"last_line":11,"raw_start":156,"raw_end":300,"raw_quote":"鬱林王昭業字元尚，文惠太子長子也。小名法身。世祖即位，封南郡王，二千戶。永明五年十一月戊子，冠於東宮崇政殿。其日小會，賜王公以下帛各有差，給昭業扶二人。七年，有司奏給班劍二十人，鼓吹一部，高選友、學。十一年，給皁輪三望車。詔高選國官。文惠太子薨，立昭業為皇太孫，居東宮。世祖崩，太孫即位。"}],"scope":"首段鬱林王名諱及即位。"},{"raw_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi006-fixed.wikitext","metadata_path":"source-evidence/nanqi043-xieyue-reading/external/nanqi006-metadata.json","revision_id":2311630,"raw_sha256":"e7ada4fcb0bc732993f40d1e23f8250e09c37d2e3e42e6e19986d2ab0b3a2f29","read_segments":[{"first_line":11,"last_line":11,"raw_start":164,"raw_end":905,"raw_quote":"高宗明皇帝諱鸞，字景栖，始安貞王道生子也。小諱玄度。少孤，太祖撫育，恩過諸子。宋泰豫元年，為安吉令，有嚴能之名。補武陵王左常侍，不拜。元徽二年，為永世令。昇明二年，為邵陵王安南記室參軍。未拜，仍遷寧朔將軍、淮南宣城二郡太守。尋進號輔國將軍。太祖踐阼，遷侍中，封西昌侯，邑千戶。建元二年，為持節、督郢州司州之義陽諸軍事、冠軍將軍、郢州刺史，進號征虜將軍。世祖即位，轉度支尚書，領右軍將軍。永明元年，遷侍中，領驍騎將軍。王子侯舊乘纏帷車，高宗獨乘下帷，儀從如素士。公事混撓，販食人擔火誤燒牛鼻，豫章王白世祖，世祖笑焉。轉為散騎常侍、左衞將軍，清道而行，上甚悅。二年，出為征虜將軍、吳興太守。四年，遷中領軍，常侍竝如故。五年，為持節、監豫州郢州之西陽司州之汝南二郡軍事、右將軍、豫州刺史。七年，為尚書右僕射。八年，加領衞尉。十年，轉左僕射。十一年，領右衞將軍。世祖遺詔為侍中、尚書令，尋加鎮軍將軍，給班劍二十人。隆昌元年，即本號為大將軍，給鼓吹一部，親兵五百人。尋又加中書監、開府儀同三司。鬱林王廢，海陵王立，為使持節、都督揚南徐二州軍事、驃騎大將軍、錄尚書事、揚州刺史，開府如故，增班劍為三十人，封宣城郡公，二千戶。<ref>封宣城郡公二千戶　按文選三十八任昉為齊明帝讓宣城郡公第一表云「封宣城郡開國公，食邑三千戶」。</ref>鎮東府城。給兵五千人，錢二百萬，布千匹。九江作難，假黃鉞，事寧，表送之。尋加黃鉞、都督中外諸軍事、太傅，領大將軍、揚州牧，增班劍為四十人，給幢絡三望車，前後部羽葆鼓吹，劍履上殿，入朝不趨，贊拜不名，置左右長史、司馬、從事中郎、掾、屬各四人，封宣城王，邑五千戶，持節、侍中、中書監、錄尚書竝如故。未拜，太后令廢海陵王，以上入纂太祖為第三子，羣臣三請，乃受命。"}],"scope":"首完整段高宗名諱與廢鬱林、入纂太祖序。"}]}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-nanqishu-043-xieyue","work_id":"w-nanqishu","book_id":"b-nanqishu-043","source_id":"s-nanqishu043-ws2400356","source_ref":"corpus/nanqishu/043-xieyue.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"passage_refs":[{"chapter":"corpus/nanqishu/043-xieyue.json","id":"c-nanqishu-043-xieyue:p005"}]}
