c-jinshu-098-jin033-wangji:line047:m0078"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-070-bianhu-ws2595540","s-jinshu-098-jin033-wangji"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-070-bianhu:p010:m0072","surface":"阮孚","start":72,"end":74,"person_id":"cui_d13_g21","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-bianhu:p010","chapter_id":"c-jinshu-070-bianhu"},{"id":"c-jinshu-098-jin033-wangji:line047:m0078","start":78,"end":80,"surface":"阮孚","kind":"person","person_id":"cui_d13_g21","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line047","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w098-dun-main-9","person_id":"cui_d13_g21","title":"侍中","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line047","quote":"及帝崩，太甯元年，敦諷朝廷徵己，明帝乃手詔徵之，語在《明帝紀》。又使兼太常應詹拜授加黃龯，班劍武賁二十人，奏事不名，入朝不趨，劍覆上殿。敦移鎮姑孰，帝使侍中阮孚齎牛酒犒勞，敦稱疾不見，使主簿受詔。以王導為司徒，敦自為揚州牧。","person_mention_id":"c-jinshu-098-jin033-wangji:line047:m0078"}],"attestations":[{"id":"th-w043-dun-main-9:a","paragraph_id":"c-jinshu-098-jin033-wangji:line047","start":76,"end":78,"surface":"侍中","person_mention_id":"c-jinshu-098-jin033-wangji:line047:m0078","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-bianhu:p010","text":"壼榦實當官，以褒貶爲己任，勤於吏事，欲軌正督世，不肯苟同時好。然性不弘裕，才不副意，故爲諸名士所少，而無卓爾優譽。明帝深器之，於諸大臣而最任職。阮孚每謂之曰：「卿恒無閑泰，常如含瓦石，不亦勞乎？」壼曰：「諸君以道德恢弘，風流相尚，執鄙吝者，非壼而誰！」時貴游子弟多慕王澄、謝鯤爲達，壼厲色於朝曰：「悖禮傷教，罪莫斯甚！中朝傾覆，實由於此。」欲奏推之。王導、庾亮不從，乃止，然而聞者莫不折節。時王導以勳德輔政，成帝每幸其宅，嘗拜導婦曹氏。侍中孔坦密表不宜拜。導聞之曰：「王茂弘駑痾耳，若卞望之之巖巖，刁玄亮之察察，戴若思之峰岠，當敢爾邪！」壼廉潔儉素，居甚貧約。息當婚，詔特賜錢五十萬，固辭不受。後患面創，累乞解職。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":78,"last_line":78,"raw_start":7949,"raw_end":8295,"raw_character_offsets":[7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036,8037,8038,8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,