anguozhi-064-nieyou-complete-2-39:a","paragraph_id":"c-sanguozhi-064-nieyou-complete:p002","start":39,"end":43,"surface":"豫章太守","person_mention_id":"c-sanguozhi-064-nieyou-complete:p002:m0043","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-nieyou-complete","source_id":"s-sanguozhi-064-nieyou-complete-ws2263487","paragraph_id":"c-sanguozhi-064-nieyou-complete:p002","quote":"《吳錄》曰：友有脣吻，少為縣吏。虞翻徙交州，縣令使友送之，翻與語而奇焉，為書與豫章太守謝斐，令以為功曹。郡時見有功曹，斐見之，問曰：「縣吏聶友，可堪何職？」對曰：「此人縣間小吏耳，猶可堪曹佐。」斐曰：「論者以為宜作功曹，君其避之。」乃用為功曹。使至都，諸葛恪友之。時論謂顧子嘿、子直，其間無所复容，恪欲以友居其間，由是知名。後為將，討儋耳，還拜丹楊太守，年三十三卒。","person_mention_id":"c-sanguozhi-064-nieyou-complete:p002:m0043"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-nieyou-complete:p002","text":"《吳錄》曰：友有脣吻，少為縣吏。虞翻徙交州，縣令使友送之，翻與語而奇焉，為書與豫章太守謝斐，令以為功曹。郡時見有功曹，斐見之，問曰：「縣吏聶友，可堪何職？」對曰：「此人縣間小吏耳，猶可堪曹佐。」斐曰：「論者以為宜作功曹，君其避之。」乃用為功曹。使至都，諸葛恪友之。時論謂顧子嘿、子直，其間無所复容，恪欲以友居其間，由是知名。後為將，討儋耳，還拜丹楊太守，年三十三卒。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":62,"last_line":62,"raw_start":8411,"raw_end":8594,"raw_character_offsets":[8411,8412,8413,8414,8415,8416,8417,8418,8419,8420,8421,8422,8423,8424,8425,8426,8427,8428,8429,8430,8431,8432,8433,8434,8435,8436,8437,8438,8439,8440,8441,8442,8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453,8454,8455,8456,8457,8458,8459,8460,8461,8462,8463,8464,8465,8466,8467,8468,8469,8470,8471,8472,8473,8474,8475,8476,8477,8478,8479,8480,8481,8482,8483,8484,848