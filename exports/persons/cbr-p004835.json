":"acr_zxn_ca3","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0229","start":229,"end":233,"surface":"韓相俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0234","start":234,"end":236,"surface":"俠累","kind":"person","person_id":"9hw_mvo_jk8","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0237","start":237,"end":239,"surface":"韓君","kind":"person","person_id":"fji_le1_7p1","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0244","start":244,"end":246,"surface":"宗族","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m015-0251","start":251,"end":253,"surface":"兵衞","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m015-0282","start":282,"end":286,"surface":"車騎壯士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m015-0295","start":295,"end":297,"surface":"聶政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0321","start":321,"end":323,"surface":"國君","kind":"person","person_id":"fji_le1_7p1","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0359","start":359,"end":361,"surface":"仲子","kind":"person","person_id":"acr_zxn_ca3","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m015-0372","start":372,"end":376,"surface":"車騎人徒","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m015-0377","start":377,"end":379,"surface":"聶政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p018","text":"政姊榮聞人有刺殺韓相者，賊不得，國不知其名姓，暴其尸而縣之千金，乃於邑曰：「其是吾弟與？嗟乎，嚴仲子知吾弟！」立起，如韓，之市，而死者果政也，伏尸哭極哀，曰：「是軹深井里所謂聶政者也。」市行者諸衆人皆曰：「此人暴虐吾國相，王縣購其名姓千金，夫人不聞與？何敢來識之也？」榮應之曰：「聞之。然政所以蒙汚辱自棄於市販之閒者，爲老母幸無恙，妾未嫁也。親既以天年下世，妾已嫁夫，嚴仲子乃察舉吾弟困汚之中而交之，澤厚矣，可柰何！士固爲知己者死，今乃以妾尚在之故，重自刑以絶從，妾其柰何畏歿身之誅，終滅賢弟之名！」大驚韓市人。乃大呼天者三，卒於邑悲哀而死政之旁。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m018-0000","start":0,"end":1,"surface":"政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0002","start":2,"end":3,"surface":"榮","kind":"person","person_id":"klu_n74_itc","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0047","start":47,"end":50,"surface":"嚴仲子","kind":"person","person_id":"acr_zxn_ca3","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0068","start":68,"end":69,"surface":"政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0087","start":87,"end":89,"surface":"聶政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0093","start":93,"end":99,"surface":"市行者諸衆人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m018-0111","start":111,"end":112,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m018-0134","start":134,"end":135,"surface":"榮","kind":"person","person_id":"klu_n74_itc","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0144","start":144,"end":145,"surface":"政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0160","start":160,"end":162,"surface":"老母","kind":"person","person_id":"0e4_dav_p5t","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0183","start":183,"end":184,"surface":"，","kind":"person","person_id":"gmx_6ao_hg2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0184","start":184,"end":187,"surface":"嚴仲子","kind":"person","person_id":"acr_zxn_ca3","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m018-0252","start":252,"end":255,"surface":"韓市人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m018-0270","start":270,"end":271,"surface":"政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p019","text":"晉、楚、齊、衞聞之，皆曰：「非獨政能也，乃其姊亦烈女也。鄕使政誠知其姊無濡忍之志，不重暴骸之難，必絶險千里以列其名，姊弟倶僇於韓市者，亦未必敢以身許嚴仲子也。嚴仲子亦可謂知人能得士矣！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m019-0016","start":16,"end":17,"surface":"政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0021","start":21,"end":23,"surface":"其姊","kind":"person","person_id":"klu_n74_itc","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0030","start":30,"end":31,"surface":"政","kind":"person","person_id":"ri4_ypz_y8z","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0033","start":33,"end":35,"surface":"其姊","kind":"person","person_id":"klu_n74_itc","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0058","start":58,"end":60,"surface":"姊弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定稱呼保持未解，不補姓名。"},{"id":"c-shiji-086-cike:m019-0074","start":74,"end":77,"surface":"嚴仲子","kind":"person","person_id":"acr_zxn_ca3","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m019-0079","start":79,"end":82,"surface":"嚴仲子","kind":"person","person_id":"acr_zxn_ca3","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"}],"sources":[{"chapter_id":"c-shiji-086-cike","work_id":"w-shiji","book_id":"b-shiji-086","source_id":"s-shiji-086-cike","source":{"title":"史記／卷086","provider":"維基文庫","u