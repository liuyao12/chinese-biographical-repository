,8593,8594,8595,8596,8597,8598,8599,8600,8601,8602,8603,8604,8605,8606,8607,8608,8609,8610,8611,8612,8613,8614,8615,8616,8617,8618,8619,8620,8621,8622,8623,8624,8625,8626,8627,8628,8629,8630,8631,8632,8633,8634,8635,8636,8637,8638,8639,8640,8641,8642,8643,8644,8645,8646,8647,8648,8649,8650,8651,8652,8653,8654,8655,8656,8657,8658,8659,8660,8661,8662,8663,8664,8665,8666,8667,8668,8669,8670,8671,8672,8673,8674,8675,8676,8677,8678,8679,8680,8681,8682,8683,8684,8685,8686,8687,8688,8689,8690,8691,8692,8693,8694,8695,8696,8697,8698,8699,8700,8701,8702,8703,8704,8705,8706,8707,8708,8709,8710,8711,8712,8713,8714,8715,8716,8717,8718,8719,8720,8721,8722,8723,8724,8725,8726,8727,8728,8729,8730,8731,8732,8733,8734,8735,8736,8737,8738,8739,8740,8741,8742,8743,8744,8745,8746,8747,8748,8749,8750,8751,8752,8753,8754,8755,8756,8757,8758,8759,8760],"projection_sha256":"520f7760a1c43a5b367f1bb525ec4a132e3bd8490f9f499b276218f2b599e54c","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-024-wangmeng","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wangmeng-ws1765279"},{"id":"c-nanshi-024-wangmeng:p005","text":"猛母妻子先留建鄴，因隨後主入京，詔賜宅及什物甚厚，別賚物一千段，及遣璽書勞猛。仍討平山越，馳驛奏聞。時文帝幸河東，會猛使至，大悅。楊素賀，因曰：「昔漢武此地聞喜，用改縣名，王猛今者告捷，遠符前事。」於是又降璽書褒賞，以其長子繕爲開府儀同三司。猛尋卒于廣州，文帝聞而痛之，遣使弔祭，贈上開府儀同三司，封歸仁縣公。命其子繕襲，仍授普州刺史。仁壽元年，繕弟續表陳猛志，求葬關中，詔許之。仍贈使持節、大將軍、宋州刺史、三州諸軍事，諡曰成。","mentions":[{"id":"c-nanshi-024-wangmeng:p005:m0000","surface":"猛","start":0,"end":1,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0002","surface":"妻","start":2,"end":3,"person_id":"pnw_wov_a66","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0037","surface":"猛","start":37,"end":38,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangmeng:p005:m0058","surface":"猛","start":58,"end