c-chenshu-006-wangmeng-houzhu-context"}],"relations":[{"id":"a-nanshi024-wangmeng-shubao","subject_person_id":"icd_mkz_d9n_A","object_person_id":"icd_mkz_d9n","predicate":"father","qualifiers":{"source_term":"高宗嫡長子","nanshi024_wangmeng_reading":"shubao","lineage":"paternal","birth_order":{"parent_person_id":"icd_mkz_d9n","scope":"sons_of_parent","ordinal":1,"position":"eldest","interpretation_status":"source_attested"}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-006","source_id":"s-chenshu-006-wangmeng-houzhu-context-ws2312453","chapter_id":"c-chenshu-006-wangmeng-houzhu-context","paragraph_id":"c-chenshu-006-wangmeng-houzhu-context:p001","quote":"後主諱叔寶，字元秀，小字黃奴，高宗嫡長子也。","subject_person_mention_id":"c-chenshu-006-wangmeng-houzhu-context:p001:m0003","object_person_reference_id":"c-chenshu-006-wangmeng-houzhu-context:p001:r0015","relationship_anchor":{"paragraph_id":"c-chenshu-006-wangmeng-houzhu-context:p001","surface":"高宗嫡長子","start":15,"end":20}}],"status":"source_attested","interpretation_note":"高宗嫡長子。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-chenshu-006-wangmeng-houzhu-context:p001:r0000","surface":"後主","start":0,"end":2,"person_id":"icd_mkz_d9n_A","referent_role":"third_person","paragraph_id":"c-chenshu-006-wangmeng-houzhu-context:p001","quote":"後主諱叔寶，字元秀，小字黃奴，高宗嫡長子也。","note":"陳叔寶。","chapter_id":"c-chenshu-006-wangmeng-houzhu-context","book_id":"b-chenshu-006","work_id":"w-chenshu","source_id":"s-chenshu-006-wangmeng-houzhu-context-ws2312453"},{"id":"c-nanshi-024-wangmeng:p004:r0156","surface":"後主","start":156,"end":158,"person_id":"icd_mkz_d9n_A","referent_role":"third_person","paragraph_id":"c-nanshi-024-wangmeng:p004","quote":"禎明二年，詔授鎭南大將軍、都督二十四州諸軍事，尋命徙鎭廣州。未之鎭，而隋師濟江，猛總督所部赴援。時廣州刺史臨汝侯方慶、西衡州刺史衡陽王伯信並隸猛督府，各觀望不至。猛使高州刺史戴智烈、清遠太守曾孝遠各以輕兵就斬之而發其兵。及聞台城不守，乃舉哀素服，藉稿不食，歎曰：「申包胥獨何人哉。」因勒兵緣江拒守，以固誠節。及審後主不死，乃遣其部將辛昉馳驛赴京師歸款。隋文帝大悅，謂昉曰：「猛懷其舊主，送故情深，即是我之誠臣。保守一方，不勞兵甲，又是我之功臣。」即日拜昉開府儀同三司，仍詔猛與行軍總管韋洸便留嶺表經略。","note":"陳後主叔寶。","chapter_id":"c-nanshi-024-wangmeng","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wangmeng-ws1765279"},{"id":"c-nanshi-024-wangmeng:p004:r0190","surface":"舊主","start":190,"end":192,"person_id":"icd_mkz_d9n_A","referent_role":"third_person","paragraph_id":"c-nanshi-024-wangmeng:p004","quote":"禎明二年，詔授鎭南大將軍、都督二十四州諸軍事，尋命徙鎭廣州。未之鎭，而隋師濟江，猛總督所部赴援。時廣州刺史臨汝侯方慶、西衡州刺史衡陽王伯信並隸猛督府，各觀望不至。猛使高州刺史戴智烈、清遠太守曾孝遠各以輕兵就斬之而發其兵。及聞台城不守，乃舉哀素服，藉稿不食，歎曰：「申包胥獨何人哉。」因勒兵緣江拒守，以固誠節。及審後主不死，乃遣其部將辛昉馳驛赴京師歸款。隋文帝大悅，謂昉曰：「猛懷其舊主，送故情深，即是我之誠臣。保守一方，不勞兵甲，又是我之功臣。」即日拜昉開府儀同三司，仍詔猛與行軍總管韋洸便留嶺表經略。","note":"隋文帝稱王猛懷陳後主。","chapter_id":"c-nanshi-024-wangmeng","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wangmeng-ws1765279"},{"id":"c-nanshi-024-wangmeng:p005:r0011","surface":"後主","start":11,"end":13,"person_id":"icd_mkz_d9n_A","referent_role":"third_person","paragraph_id":"c-nanshi-024-wangmeng:p005","quote":"猛母妻子先留建鄴，因隨後主入京，詔賜宅及什物甚厚，別賚物一千段，及遣璽書勞猛。仍討平山越，馳驛奏聞。時文帝幸河東，會猛使至，大悅。楊素賀，因曰：「昔漢武此地聞喜，用改縣名，王猛今者告捷，遠符前事。」於是又降璽書褒賞，以其長子繕爲開府儀同三司。猛尋卒于廣州，文帝聞而痛之，遣使弔祭，贈上開府儀同三司，封歸仁縣公。命其子繕襲，仍授普州刺史。仁壽元年，繕弟續表陳猛志，求葬關中，詔許之。仍贈使持節、大將軍、宋州刺史、三州諸軍事，諡曰成。","note":"隨後主入京者為王猛家屬。","chapter_id":"c-nanshi-024-wangmeng","book_id":"b-nanshi-024","work_id":"w-nanshi","source_id":"s-nanshi-024-wangmeng-ws1765279"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"parent_person_id":"icd_mkz_d9n","scope":"sons_of_parent","ordinal":1,"position":"eldest","interpretation_status":"source_attested","assertion_id":"a-nanshi024-wangmeng-shubao","person_id":"icd_mkz_d9n_A","evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-006","source_id":"s-chenshu-006-wangmeng-houzhu-context-ws2312453","chapter_id":"c-chenshu-006-wangmeng-houzhu-context","paragraph_id":"c-chenshu-006-wangmeng-houzhu-context:p001","quote":"後主諱叔寶，字元秀，小字黃奴，高宗嫡長子也。","subject_person_mention_id":"c-chenshu-006-wangmeng-houzhu-context:p001:m0003","object_person_reference_id":"c-chenshu-006-wan