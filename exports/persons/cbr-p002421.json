":67,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m077-0069","start":69,"end":72,"surface":"田不禮","kind":"person","person_id":"cbr-p002427","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m077-0073","start":73,"end":74,"surface":"章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p078","text":"李兌謂肥義曰：「公子章彊壯而志驕，黨衆而欲大，殆有私乎？田不禮之爲人也，忍殺而驕。二人相得，必有謀陰賊起，一出身徼幸。夫小人有欲，輕慮淺謀，徒見其利而不顧其害，同類相推，倶入禍門。以吾觀之，必不久矣。子任重而勢大，亂之所始，禍之所集也，子必先患。仁者愛萬物而智者備禍於未形，不仁不智，何以爲國？子奚不稱疾毋出，傳政於公子成？毋爲怨府，毋爲禍梯。」肥義曰：「不可，昔者主父以王屬義也，曰：『毋變而度，毋異而慮，堅守一心，以歿而世。』義再拜受命而籍之。今畏不禮之難而忘吾籍，變孰大焉。進受嚴命，退而不全，負孰甚焉。變負之臣，不容於刑。諺曰『死者復生，生者不愧』。吾言已在前矣，吾欲全吾言，安得全吾身！且夫貞臣也難至而節見，忠臣也累至而行明。子則有賜而忠我矣，雖然，吾有語在前者也，終不敢失。」李兌曰：「諾，子勉之矣！吾見子已今年耳。」涕泣而出。李兌數見公子成，以備田不禮之事。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m078-0000","start":0,"end":2,"surface":"李兌","kind":"person","person_id":"cbr-p002428","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0003","start":3,"end":5,"surface":"肥義","kind":"person","person_id":"cbr-p002386","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0008","start":8,"end":11,"surface":"公子章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0028","start":28,"end":31,"surface":"田不禮","kind":"person","person_id":"cbr-p002427","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0041","start":41,"end":43,"surface":"二人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m078-0158","start":158,"end":161,"surface":"公子成","kind":"person","person_id":"cbr-p002404","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0173","start":173,"end":175,"surface":"肥義","kind":"person","person_id":"cbr-p002386","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0183","start":183,"end":185,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0186","start":186,"end":187,"surface":"王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0188","start":188,"end":189,"surface":"義","kind":"person","person_id":"cbr-p002386","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0215","start":215,"end":216,"surface":"義","kind":"person","person_id":"cbr-p002386","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0226","start":226,"end":228,"surface":"不禮","kind":"person","person_id":"cbr-p002427","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0344","start":344,"end":346,"surface":"李兌","kind":"person","person_id":"cbr-p002428","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0370","start":370,"end":372,"surface":"李兌","kind":"person","person_id":"cbr-p002428","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0374","start":374,"end":377,"surface":"公子成","kind":"person","person_id":"cbr-p002404","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m078-0380","start":380,"end":383,"surface":"田不禮","kind":"person","person_id":"cbr-p002427","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p080","text":"四年，朝群臣，安陽君亦來朝。主父令王聽朝，而自從旁觀窺群臣宗室之禮。見其長子章傫然也，反北面爲臣，詘於其弟，心憐之，於是乃欲分趙而王章於代，計未決而輟。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m080-0004","start":4,"end":6,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m080-0007","start":7,"end":10,"surface":"安陽君","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m080-0014","start":14,"end":16,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m080-0017","start":17,"end":18,"surface":"王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m080-0027","start":27,"end":29,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m080-0029","start":29,"end":31,"surface":"宗室","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m080-0036","start":36,"end":39,"surface":"長子章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m080-0051","start":51,"end":53,"surface":"其弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、代詞、未名君主或版本疑字保留；不把帝王泛稱、父子群體與未決分封當已確證身份或任期。"},{"id":"c-shiji-043-zhao:m080-0066","start":66,"end":67,"surface":"章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p081","text":"主父及王游沙丘，異宮，公子章卽以其徒與田不禮作亂，詐以主父令召王。肥義先入，殺之。髙信卽與王戰。公子成與李兌自國至，乃起四邑之兵入距難，殺公子章及田不禮，滅其黨賊而定王室。公子成爲相，號安平君，李兌爲司寇。公子章之敗，往走主父，主主開之，成、兌因圍主父宮。公子章死，公子成、李兌謀曰：「以章故圍主父，卽解兵，吾屬夷矣。」乃遂圍主父。令宮中人「後出者夷」，宮中人悉出。主父欲出不得，又不得食，探爵鷇而食之，三月餘而餓死沙丘宮。主父定死，乃發喪赴諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m081-0000","start":0,"end":2,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0003","start":3,"end":4,"surface":"王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m081-0011",