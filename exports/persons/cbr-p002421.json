"c-shiji-043-zhao:m082-0053","start":53,"end":54,"surface":"章","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p082","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m082-0068","start":68,"end":71,"surface":"故太子","kind":"person","person_id":"cbr-p002421","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p082","chapter_id":"c-shiji-043-zhao"}],"relations":[{"id":"a-shiji043-057","subject_person_id":"cbr-p002421","predicate":"father","object_person_id":"cbr-p002380","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p082","quote":"是時王少，成、兌專政，畏誅，故圍主父。主父初以長子章爲太子，後得吳娃，愛之，爲不出者數歳，生子何，乃廢太子章而立何爲王。吳娃死，愛弛，憐故太子，欲兩王之，猶豫未決，故亂起，以至父子倶死，爲天下笑，豈不痛乎！"}],"qualifiers":{"source_term":"主父初以長子章","historicity":"historical_tradition"},"interpretation_note":"依明示長子、子、吳娃子及其弟與聽朝敘事保存，未從繼位推親屬；章母未名不補。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji043-058","subject_person_id":"cbr-p002421","predicate":"brother","object_person_id":"cbr-p002424","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p080","quote":"四年，朝群臣，安陽君亦來朝。主父令王聽朝，而自從旁觀窺群臣宗室之禮。見其長子章傫然也，反北面爲臣，詘於其弟，心憐之，於是乃欲分趙而王章於代，計未決而輟。"}],"qualifiers":{"source_term":"反北面爲臣，詘於其弟","historicity":"historical_tradition"},"interpretation_note":"依明示長子、子、吳娃子及其弟與聽朝敘事保存，未從繼位推親屬；章母未名不補。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji043-053","person_id":"cbr-p002421","title":"中軍","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p073","quote":"二十一年，攻中山。趙袑爲右軍，許鈞爲左軍，公子章爲中軍，王并將之。牛翦將車騎，趙希并將胡、代。趙與之陘，合軍曲陽，攻取丹丘、華陽、鴟之塞。王軍取鄗、石邑、封龍、東垣。中山獻四邑和，王許之，罷兵。二十三年，攻中山。二十五年，惠后卒。使周袑胡服傅王子何。二十六年，復攻中山，攘地北至燕、代，西至雲中、九原。"}],"attestations":[{"id":"th-shiji043-053:a001","paragraph_id":"c-shiji-043-zhao:p073","start":25,"end":27,"surface":"中軍","person_mention_id":"c-shiji-043-zhao:m073-0021","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授予、自號及廢太子與敘事用稱分開；分趙而王章的未決計畫不是授予。死亡與傳國不推所有官爵終點，回敘太子不補曆日。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji043-060","person_id":"cbr-p002421","title":"代安陽君","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p077","quote":"三年，滅中山，遷其王於膚施。起靈壽，北地方從，代道大通。還歸，行賞，大赦，置酒酺五日，封長子章爲代安陽君。章素侈，心不服其弟所立。主父又使田不禮相章也。"}],"attestations":[{"id":"th-shiji043-060:a001","paragraph_id":"c-shiji-043-zhao:p077","start":48,"end":52,"surface":"代安陽君","person_mention_id":"c-shiji-043-zhao:m077-0044","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"三年","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p077","quote":"三年，滅中山，遷其王於膚施。起靈壽，北地方從，代道大通。還歸，行賞，大赦，置酒酺五日，封長子章爲代安陽君。章素侈，心不服其弟所立。主父又使田不禮相章也。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授予、自號及廢太子與敘事用稱分開；分趙而王章的未決計畫不是授予。死亡與傳國不推所有官爵終點，回敘太子不補曆日。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji043-064","person_id":"cbr-p002421","title":"太子","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p082","quote":"是時王少，成、兌專政，畏誅，故圍主父。主父初以長子章爲太子，後得吳娃，愛之，爲不出者數歳，生子何，乃廢太子章而立何爲王。吳娃死，愛弛，憐故太子，欲兩王之，猶豫未決，故亂起，以至父子倶死，爲天下笑，豈不痛乎！"}],"attestations":[{"id":"th-shiji043-064:a001","paragraph_id":"c-shiji-043-zhao:p082","start":27,"end":29,"surface":"太子","person_mention_id":"c-shiji-043-zhao:m082-0023","usage":"retrospective"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_e