","person_id":"dkn_ge4_286_AAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0104","start":104,"end":105,"surface":"澹","kind":"person","person_id":"dkn_ge4_286_AAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0110","start":110,"end":111,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0116","start":116,"end":117,"surface":"漼","kind":"person","person_id":"dkn_ge4_286_AAAAAD","status":"contextual_provisional"}],"source_position":{"first_line":28,"last_line":28,"revision_id":2444513,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-038-langye-near-family","book_id":"b-jinshu-038","work_id":"w-jinshu","source_id":"s-jinshu-038-langye-near-family"},{"id":"c-jinshu-043-leguang:line156","text":"遷吏部尚書左僕射，後東安王繇當為僕射，轉廣為右僕射，領吏部，代王戎為尚書令，始戎薦廣，而終踐其位，時人美之。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-leguang:line156:m0010","start":10,"end":14,"surface":"東安王繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-leguang:line156:m0020","start":20,"end":21,"surface":"廣","kind":"person","person_id":"591_360_8ca","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-leguang:line156:m0031","start":31,"end":33,"surface":"王戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-leguang:line156:m0039","start":39,"end":40,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-leguang:line156:m0041","start":41,"end":42,"surface":"廣","kind":"person","person_id":"591_360_8ca","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":156,"last_line":156,"raw_start":12256,"raw_end":12312,"revision_id":2618531},"chapter_id":"c-jinshu-043-leguang","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-leguang"},{"id":"c-jinshu-043-wangrong:p008","text":"楊駿執政，拜太子太傅。駿誅之後，東安公繇專斷刑賞，威震外內。戎誡繇曰：「大事之後，宜深遠之。」繇不從，果得罪。轉中書令，加光祿大夫，給恩信五十人。遷尚書左僕射，領吏部。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangrong:p008:m0000","start":0,"end":2,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0011","start":11,"end":12,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0016","start":16,"end":20,"surface":"東安公繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0030","start":30,"end":31,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0032","start":32,"end":33,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0047","start":47,"end":48,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"}],"source_position":{"first_line":78,"last_line":78,"revision_id":2618531},"chapter_id":"c-jinshu-043-wangrong","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-ws2618531-wangrong"},{"id":"c-jinshu-059-prince-ying:p006","text":"永興初，左衛將軍陳眕，殿中中郎褾苞、成輔及長沙故將上官巳等，奉大駕討穎，馳檄四方，赴者雲集。軍次安陽，眾十餘萬，鄴中震懼。穎欲走，其掾步熊有道術，曰：「勿動！南軍必敗。」穎會其眾問計，東安王繇乃曰：「天子親征，宜罷甲，縞素出迎請罪。」司馬王混、參軍崔曠勸穎距戰，穎從之，乃遣奮武將軍石超率眾五萬，次於蕩陰。眕二弟匡、規自鄴赴王師，云：「鄴中皆已離散。」由是不甚設備。超眾奄至，王師敗績，矢及乘輿，侍中嵇紹死於帝側，左右皆奔散，乃棄天子于槁中。超遂奉帝幸鄴。穎改元建武，害東安王繇，署置百官，殺生自己，立郊于鄴南。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":159,"last_line":159,"raw_start":16154,"raw_end":16412,"raw_character_offsets":[16156,16157,16158,16159,16160,16161,16162,16163,16164,16165,16166,16167,16168,16169,16170,16171,16172,16173,16174,16175,16176,16177,16178,16179,16180,16181,16182,16183,16184,16185,16186,16187,16188,16189,16190,16191,16192,16193,16194,16195,16196,16197,16198,16199,16200,16201,16202,16203,16204,16205,16206,16207,16208,16209,16210,16211,16212,16213,16214,16215,16216,16217,16218,16219,16220,16221,16222,16223,16224,16225,16226,16227,16228,16229,16230,16231,16232,16233,16234,16235,16236,16237,16238,16239,16240,16241,16242,16243,16244,16245,16246,16247,16248,16249,16250,16251,16252,16253,16254,16255,16256,16257,16258,16259,16260,16261,16262,16263,16264,16265,16266,16267,16268,16269,16270,16271,16272,16273,16274,16275,16276,16277,16278,16279,16280,16281,16282,16283,16284,16285,16286,16287,16288,16289,16290,16291,16292,16293,16294,16295,16296,16297,16298,16299,16300,16301,16302,16303,16304,16305,16306,16307,16308,16309,16310,16311,16312,16313,16314,16315,16316,16317,16318,16319,16320,16321,16322,16323,16324,16325,16326,16327,16328,16329,16330,16331,16332,16333,16334,16335,16336,16337,16338,16339,16340,16341,16342,16343,16344,16345,16346,16347,16348,16349,16350,16351,16352,16353,16354,16355,16356,16357,16358,16359,16360,16361,16362,16363,16364,16365,16366,16367,16368,16369,16370,16371,16372,16373,16374,16375,16376,16377,16378,16379,16380,16381,16382,16383,16384,16385,16386,16387,16388,16389,16390,16391,16392,16393,16394,16395,16396,16397,16398,16399,16400,16401,16402,16403,16404,16405,16406,16407,16408,16409,16410,16411],"revision_id":2650517},"mentions":[{"id":"c-jinshu-059-prince-ying:p006:m0008","surface":"陳眕","start":8,"end":10,"person_id":"p1n_kla_0x7","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-059-prince-