"id":"c-jinshu-031-jia-comparison:p004:m0137","kind":"person","person_id":"kwx_czc_d4c_A","status":"source_attested"},{"start":143,"end":144,"surface":"衍","id":"c-jinshu-031-jia-comparison:p004:m0143","kind":"person","person_id":"kwx_czc_d4c_A","status":"source_attested"}],"chapter_id":"c-jinshu-031-jia-comparison","book_id":"b-jinshu-031","work_id":"w-jinshu","source_id":"s-jinshu031-jia-ws2479706-comparison"},{"id":"c-jinshu-038-langye-near-family:line028","text":"伷既戚屬尊重，加有平吳之功，克己恭儉，無矜滿之色，僚吏盡力，百姓懷化。疾篤，賜床帳、衣服、錢帛、秔梁等物，遣侍中問焉。太康四年薨，時年五十七。臨終表求葬母太妃陵次，並乞分國封四子，帝許之。子恭王覲立。又封次子澹為武陵王，繇為東安王，漼為淮陵王。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-038-langye-near-family:line028:m0000","start":0,"end":1,"surface":"伷","kind":"person","person_id":"dkn_ge4_286_AAAAA","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0077","start":77,"end":79,"surface":"太妃","kind":"person","person_id":"q6k_jro_wvy","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0090","start":90,"end":91,"surface":"帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0097","start":97,"end":98,"surface":"覲","kind":"person","person_id":"dkn_ge4_286_AAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0104","start":104,"end":105,"surface":"澹","kind":"person","person_id":"dkn_ge4_286_AAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0110","start":110,"end":111,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0116","start":116,"end":117,"surface":"漼","kind":"person","person_id":"dkn_ge4_286_AAAAAD","status":"contextual_provisional"}],"source_position":{"first_line":28,"last_line":28,"revision_id":2444513,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-038-langye-near-family","book_id":"b-jinshu-038","work_id":"w-jinshu","source_id":"s-jinshu-038-langye-near-family"},{"id":"c-jinshu-043-wangrong:p008","text":"楊駿執政，拜太子太傅。駿誅之後，東安公繇專斷刑賞，威震外內。戎誡繇曰：「大事之後，宜深遠之。」繇不從，果得罪。轉中書令，加光祿大夫，給恩信五十人。遷尚書左僕射，領吏部。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p008:m0000","start":0,"end":2,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0011","start":11,"end":12,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0016","start":16,"end":20,"surface":"東安公繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0030","start":30,"end":31,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0032","start":32,"end":33,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wangrong:p008:m0047","start":47,"end":48,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"}],"source_position":{"first_line":78,"last_line":78,"revision_id":2618531},"chapter_id":"c-jinshu-043-wangrong","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-ws2618531-wangrong"},{"id":"c-jinshu-043-wyd1739-wangrong:p006","text":"拜太子太傅駿誅之後東安公繇專斷刑賞威振外內戎誡繇曰大事之後宜深遠之繇不從果得罪轉中書令加光祿大夫給恩信五十人遷尚書左僕射領吏部戎始為甲午制凡選舉皆先治百姓然後授用司隸傅咸奏戎曰書稱三載考績三載黜陟幽明今內外羣官居職未期而戎奏還既未定其優劣且送故迎新相望道路巧詐由生傷農害政戎不仰依堯舜典謨而驅動浮華虧敗風俗非徒無益乃有大損宜免戎官以敦風俗戎與賈郭通親竟得不坐尋轉司徒以王政將圮苟媚取容屬愍懷太子之廢竟無一言匡諫裴頠戎之婿","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0005","start":5,"end":6,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0009","start":9,"end":13,"surface":"東安公繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0021","start":21,"end":22,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0023","start":23,"end":24,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0033","start":33,"end":34,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional","resolution_note":"東安公繇為司馬繇；不是後段博士王繇。"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0063","start":63,"end":64,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"傅咸奏文引用堯舜，賈郭通親只留氏族未決；湣懷太子廢事。"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0083","start":83,"end":85,"surface":"傅咸","kind":"person","person_id":"2rh_opu_xtn","status":"contextual_provisional","resolution_note":"傅咸奏文引用堯舜，賈郭通親只留氏族未決；湣懷太子廢事。"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0086","start":86,"end":87,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"傅咸奏文引用堯舜，賈郭通親只留氏族未決；湣懷太子廢事。"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:w0088","start":88,"end":89,"surface":"書","kind":"work","person_id":null,"status":"contextual_provisional","resolution_note":"書名引用；非當時人物、非新造同名作品。","work_id":"w-shangshu-hhs064-luzhi-reference"},{"id":"c-jinshu-043-wyd1739-wangrong:p006:m0110","start":110,