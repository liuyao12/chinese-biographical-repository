rson_id":"0va_zus_2zt_AAB","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0122","start":122,"end":125,"surface":"曼成然","kind":"person","person_id":"ck7_0oc_r4j","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0126","start":126,"end":129,"surface":"初王比","kind":"person","person_id":"0va_zus_2zt_AAC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0132","start":132,"end":134,"surface":"子皙","kind":"person","person_id":"0va_zus_2zt_AAD","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0137","start":137,"end":138,"surface":"王","kind":"person","person_id":"0va_zus_2zt_AAB","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0147","start":147,"end":149,"surface":"司馬","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0175","start":175,"end":177,"surface":"初王","kind":"person","person_id":"0va_zus_2zt_AAC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0178","start":178,"end":180,"surface":"子皙","kind":"person","person_id":"0va_zus_2zt_AAD","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0187","start":187,"end":189,"surface":"棄疾","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0196","start":196,"end":198,"surface":"熊居","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0201","start":201,"end":203,"surface":"平王","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p039","text":"初，共王有寵子五人，無適立，乃望祭群神，請神決之，使主社稷，而陰與巴姬埋璧於室内，召五公子齋而入。康王跨之，靈王肘加之，子比、子皙皆遠之。平王幼，抱其上而拜，壓紐。故康王以長立，至其子失之；圍爲靈王，及身而弒；子比爲王十餘日，子皙不得立，又倶誅。四子皆絶無後。唯獨棄疾後立，爲平王，竟續楚祀，如其神符。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m039-0002