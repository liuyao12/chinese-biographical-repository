令尹，棄疾爲司馬。先除王宮，觀從從師于乾豀，令楚衆曰：「國有王矣。先歸，復爵邑田室。後者遷之。」楚衆皆潰，去靈王而歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m034-0005","start":5,"end":8,"surface":"楚靈王","kind":"person","person_id":"0va_zus_2zt_AAB","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0024","start":24,"end":26,"surface":"靈王","kind":"person","person_id":"0va_zus_2zt_AAB","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0035","start":35,"end":38,"surface":"常壽過","kind":"person","person_id":"qqe_yxh_v49","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0043","start":43,"end":45,"surface":"觀起","kind":"person","person_id":"bm8_bzq_1ee","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0046","start":46,"end":47,"surface":"起","kind":"person","person_id":"bm8_bzq_1ee","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0048","start":48,"end":49,"surface":"從","kind":"person","person_id":"bm8_bzq_1ee_A","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0055","start":55,"end":57,"surface":"呉王","kind":"unresolved","person_id":null,"status":"unresolved","note":"勸吳伐楚時的吳王未明示姓名，須另核吳篇事件，不由後文闔閭泛接。"},{"id":"c-shiji-040-chu:m034-0065","start":65,"end":68,"surface":"常壽過","kind":"person","person_id":"qqe_yxh_v49","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0078","start":78,"end":82,"surface":"公子棄疾","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0084","start":84,"end":87,"surface":"公子比","kind":"person","person_id":"0va_zus_2zt_AAC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0103","start":103,"end":106,"surface":"公子比","kind":"person","person_id":"0va_zus_2zt_AAC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0107","start":107,"end":109,"surface":"棄疾","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0118","start":118,"end":120,"surface":"靈王","kind":"person","person_id":"0va_zus_2zt_AAB","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0120","start":120,"end":123,"surface":"太子祿","kind":"person","person_id":"k4b_0jv_rwa","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0125","start":125,"end":127,"surface":"子比","kind":"person","person_id":"0va_zus_2zt_AAC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0130","start":130,"end":134,"surface":"公子子皙","kind":"person","person_id":"0va_zus_2zt_AAD","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0138","start":138,"end":140,"surface":"棄疾","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0149","start":149,"end":151,"surface":"觀從","kind":"person","person_id":"bm8_bzq_1ee_A","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m034-0158","start":158,"end":160,"surface":"楚衆","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、寓言人物或未定指代，未補未見姓名、全體成員或親屬關係。"},{"id":"c-shiji-040-chu:m034-0183","start":183,"end":185,"surface":"楚衆","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、寓言人物或未定指代，未補未見姓名、全體成員或親屬關係。"},{"id":"c-shiji-040-chu:m034-0189","start":189,"end":191,"surface":"靈王","kind":"person","person_id":"0va_zus_2zt_AAB","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p037","text":"是時楚國雖已立比爲王，畏靈王復來，又不聞靈王死，故觀從謂初王比曰：「不殺棄疾，雖得國猶受禍。」王曰：「余不忍。」從曰：「人將忍王。」王不聽，乃去。棄疾歸。國人毎夜驚，曰：「靈王入矣！」乙卯夜，棄疾使船人從江上走呼曰：「靈王至矣！」國人愈驚。又使曼成然告初王比及令尹子皙曰：「王至矣！國人將殺君，司馬將至矣！君蚤自圖，無取辱焉。衆怒如水火，不可救也。」初王及子皙遂自殺。丙辰，棄疾卽位爲王，改名熊居，是爲平王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m037-0007","start":7,"end":8,"surface":"比","kind":"person","person_id":"0va_zus_2zt_AAC","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m037-0012","start":12,"