}],"source_assertion_id":"a-shiji040-045","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"0va_zus_2zt_AA"},"id_aliases":["cbr-p001891"]}],"source_mention_summary":[{"source_id":"s-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","chapter_id":"c-shiji-040-chu","mention_count":6,"mention_ids":["c-shiji-040-chu:m029-0011","c-shiji-040-chu:m034-0130","c-shiji-040-chu:m037-0132","c-shiji-040-chu:m037-0178","c-shiji-040-chu:m039-0063","c-shiji-040-chu:m039-0113"],"paragraph_ids":["c-shiji-040-chu:p029","c-shiji-040-chu:p034","c-shiji-040-chu:p037","c-shiji-040-chu:p039"],"passage_count":4}],"most_mentioned_source_ids":["s-shiji-040-chu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji040-045","subject_person_id":"0va_zus_2zt_AAD","predicate":"father","object_person_id":"0va_zus_2zt_AA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p039","quote":"初，共王有寵子五人，無適立，乃望祭群神，請神決之，使主社稷，而陰與巴姬埋璧於室内，召五公子齋而入。康王跨之，靈王肘加之，子比、子皙皆遠之。平王幼，抱其上而拜，壓紐。故康王以長立，至其子失之；圍爲靈王，及身而弒；子比爲王十餘日，子皙不得立，又倶誅。四子皆絶無後。唯獨棄疾後立，爲平王，竟續楚祀，如其神符。"}],"qualifiers":{"source_term":"共王有寵子五人","historicity":"historical_tradition"},"interpretation_note":"依本段明示生育、兄弟、母子及苗裔敘事；祖先不作直接父親，繼位不自動推父子，不補未見母名或闕代。來源主張不等於版本與史實已覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji040-085","subject_person_id":"0va_zus_2zt_AAD","predicate":"brother","object_person_id":"0va_zus_2zt_AAA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p029","quote":"康王寵弟公子圍、子比、子皙、棄疾。郟敖三年，以其季父康王弟公子圍爲令尹，主兵事。四年，圍使鄭，道聞王疾而還。十二月己酉，圍入問王疾，絞而弒之，遂殺其子莫及平夏。使使赴於鄭。伍舉問曰：「誰爲後？」對曰：「寡大夫圍。」伍舉更曰：「共王之子圍爲長。」子比奔晉，而圍立，是爲靈王。"}],"qualifiers":{"source_term":"康王寵弟公子圍、子比、子皙、棄疾","historicity":"historical_tradition"},"interpretation_note":"本段明列康王所寵四弟，不由共同父系自動補其他兄弟或母親。 此為來源主張，身份、版本及異說尚未完成覆核。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p039","quote":"初，共王有寵子五人，無適立，乃望祭群神，請神決之，使主社稷，而陰與巴姬埋璧於室内，召五公子齋而入。康王跨之，靈王肘加之，子比、子皙皆遠之。平王幼，抱其上而拜，壓紐。故康王以長立，至其子失之；圍爲靈王，及身而弒；子比爲王十餘日，子皙不得立，又倶誅。四子皆絶無後。唯獨棄疾後立，爲平王，竟續楚祀，如其神符。","source_term":"共王有寵子五人"}],"source_assertion_id":"a-shiji040-045","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"0va_zus_2zt_AA","person_id":"0va_zus_2zt_AAD"}],"mentions":[{"id":"c-shiji-040-chu:m029-0011","start":11,"end":13,"surface":"子皙","kind":"person","person_id":"0va_zus_2zt_AAD","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p029","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m034-0130","start":130,"end":134,"surface":"公子子皙","kind":"person","person_id":"0va_zus_2zt_AAD","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p034","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m037-0132","start":132,"end":134,"surface":"子皙","kind":"person","person_id":"0va_zus_2zt_AAD","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p037","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m037-0178","start":178,"end":180,"surface":"子皙","kind":"person","person_id":"0va_zus_2zt_AAD","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p037","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m039-0063","start":63,"end":65,"surface":"子皙","kind":"person","person_id":"0