graph_id":"c-shiji-075-mengchang:p011","chapter_id":"c-shiji-075-mengchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji075-035","person_id":"fw7_8k1_43d","scope":"same_chapter","chapter_ids":["c-shiji-075-mengchang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依局部敘事姓名、書信受話及回指暫接。第11段其後齊王限接前段齊湣王，馮驩初敘與復位故事中的齊秦兩王未自動接湣襄或昭王；內嵌秦王王君與外層孟嘗君君稱分辨。馮驩馮先生馮公與局部驩相配，馮軾與代舍非其人名。親弗、周最與原字保留，魏冉書信子稱按受話限定；孟嘗諸子不補個別子嗣。","surfaces":["周最"],"evidence":[{"paragraph_id":"c-shiji-075-mengchang:p011","quote":"其後，秦亡將呂禮相齊，欲困蘇代。代乃謂孟嘗君曰：「周最於齊，至厚也，而齊王逐之，而聽親弗相呂禮者，欲取秦也。齊、秦合，則親弗與呂禮重矣。有用，齊、秦必輕君。君不如急北兵，趨趙以和秦、魏，收周最以厚行，且反齊王之信，又禁天下之變。齊無秦，則天下集齊，親弗必走，則齊王孰與爲其國也！」於是孟嘗君從其計，而呂禮嫉害於孟嘗君。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p011","text":"其後，秦亡將呂禮相齊，欲困蘇代。代乃謂孟嘗君曰：「周最於齊，至厚也，而齊王逐之，而聽親弗相呂禮者，欲取秦也。齊、秦合，則親弗與呂禮重矣。有用，齊、秦必輕君。君不如急北兵，趨趙以和秦、魏，收周最以厚行，且反齊王之信，又禁天下之變。齊無秦，則天下集齊，親弗必走，則齊王孰與爲其國也！」於是孟嘗君從其計，而呂禮嫉害於孟嘗君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m011-0006","start":6,"end":8,"surface":"呂禮","kind":"person","person_id":"q7s_ogm_yr2","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0013","start":13,"end":15,"surface":"蘇代","kind":"person","person_id":"2ih_dpv_yf7","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0016","start":16,"end":17,"surface":"代","kind":"person","person_id":"2ih_dpv_yf7","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0019","start":19,"end":22,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0025","start":25,"end":27,"surface":"周最","kind":"person","person_id":"fw7_8k1_43d","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m011-0035","start":35,"end":37,"surface":"齊王","kind":