nce_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-043-ws2618531-wangrong","s-shiji-031-wu"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangrong:p011:m0008","start":8,"end":11,"surface":"蘧伯玉","kind":"person","person_id":"nd8_vw5_w1w","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。","paragraph_id":"c-jinshu-043-wangrong:p011","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-shiji-031-wu:m012-0061","start":61,"end":63,"surface":"蘧瑗","kind":"person","person_id":"nd8_vw5_w1w","status":"contextual_provisional","paragraph_id":"c-shiji-031-wu:p012","chapter_id":"c-shiji-031-wu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p011","text":"戎以晉室方亂，慕蘧伯玉之為人，與時舒卷，無蹇諤之節。自經典選，未嘗進寒素，退虛名，但與時浮沈，戶調門選而已。尋拜司徒，雖位總鼎司，而委事僚采。間乘小馬，從便門而出遊，見者不知其三公也。故吏多至大官，道路相遇輒避之。性好興利，廣收八方園田水碓，周遍天下。積實聚錢，不知紀極，每自執牙籌，晝夜算計，恆若不足。而又儉嗇，不自奉養，天下人謂之膏肓之疾。女適裴頠，貸錢數萬，久而未還。女後歸寧，戎色不悅，女遽還直，然後乃歡。從子將婚，戎遺其一單衣，婚訖而更責取。家有好李，常出貨之，恐人得種，恆鑽其核。以此獲譏於世。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p011:m0000","start":0,"end":1,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0008","start":8,"end":11,"surface":"蘧伯玉","kind":"person","person_id":"nd8_vw5_w1w","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0088","start":88,"end":90,"surface":"三公","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"乘小馬出遊者戎。"},{"id":"c-jinshu-043-wangrong:p011:m0172","start":172,"end":173,"surface":"女","kind":"person","person_id":"cxf_421_onp","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0174","start":174,"end":176,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0187","start":187,"end":188,"surface":"女","kind":"person","person_id":"cxf_421_onp","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0192","start":192,"end":193,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0197","start":197,"end":198,"surface":"女","kind":"person","person_id":"cxf_421_onp","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0207","start":207,"end":209,"surface":"從子","kind":"person","person_id":"8ud_nma_oo4","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"},{"id":"c-jinshu-043-wangrong:p011:m0212","start":212,"end":213,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"女適裴頠與歸寧同一女；從子單衣婚事不補其父/姓名。"}],"source_position":{"first_line":84,"last_line":84,"revision_id":2618531},"chapter_id":"c-jinshu-043-wangrong","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-ws2618531-wangrong"},{"id":"c-shiji-031-wu:p012","text":"去齊，使於鄭。見子産，如舊交。謂子産曰：「鄭之執政侈，難將至矣，政必及子。子爲政，愼以禮。不然，鄭國將敗。」去鄭，適衞。説蘧瑗、史狗、史鰍、公子荊、公叔發、公子朝曰：「衞多君子，未有患也。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m012-0008","start":8,"end":10,"surface":"子産","kind":"person","person_id":"qjs_3hl_6ck_A","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m012-0016","start":16,"end":18,"surface":"子産","kind":"person","person_id":"qjs_3hl_6ck_A","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m012-0061","start":61,"end":63,"surface":"蘧瑗","kind":"person","person_id":"nd8_vw5_w1w","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m012-0064","start":64,"end":66,"surface":"史狗","kind":"person","person_id":"4rw_nce_8oq","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m012-0067","start":67,"end":69,"surface":"史鰍","kind":"person","person_id":"zwx_rs0_1lh","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m012-0070","start":70,"end":73,"surface":"公子荊","kind":"person","person_id":"rcd_or9_g0a","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m012-0074","start":74,"end":77,"surface":"公叔發","kind":"person","person_id":"yuq_yq1_oq6","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m012-0078","start":78,"end":81,"surface":"公子朝","kind":"person","person_id":"che_kst_jnn","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"}],"sources":[{"chapter_id":"c-jinshu-043-wangrong","work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-wangrong","source":{"title":"《晉書》卷四十三王戎完整本傳（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷043&oldid=2618531","permalink":"https://zh.wikisource.org/w/i