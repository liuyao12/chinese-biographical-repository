003:m0095","start":95,"end":97,"surface":"任昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional"},{"id":"c-liangshu-027-daoqia-complete:p003:m0107","start":107,"end":108,"surface":"洽","kind":"person","person_id":"4mr_j4p_k5h","status":"contextual_provisional"},{"id":"c-liangshu-027-daoqia-complete:p003:m0118","start":118,"end":120,"surface":"高祖","kind":"person","person_id":"fo7_f8v_rmf","status":"contextual_provisional"},{"id":"c-liangshu-027-daoqia-complete:p003:m0121","start":121,"end":122,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional"},{"id":"c-liangshu-027-daoqia-complete:p003:m0133","start":133,"end":134,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional"}],"chapter_id":"c-liangshu-027-daoqia-complete","book_id":"b-liangshu-027","work_id":"w-liangshu","source_id":"s-liangshu-027-daoqia-complete-ws1511478"},{"id":"c-liangshu-027-luxiang-complete:p002","text":"天監三年，都官尚書范岫表薦襄，起家擢拜著作佐郎，除永寧令。秩滿，累遷司空臨川王法曹，外兵，輕車廬陵王記室參軍。昭明太子聞襄業行，啓高祖引與游處，除太子洗馬，遷中舍人，並掌管記。出爲揚州治中，襄父終此官，固辭職，高祖不許，聽與府司馬換廨居之。昭明太子敬耆老，襄母年將八十，與蕭琛、傅昭、陸杲每月常遣存問，加賜珍羞衣服。襄母嘗卒患心痛，醫方須三升粟漿，是時冬月，日又逼暮，求索無所。忽有老人詣門貨漿，量如方劑，始欲酬直，無何失之，時以襄孝感所致也。累遷國子博士，太子家令，復掌管記，母憂去職。襄年已五十，毀頓過禮，太子憂之，日遣使誡喻。服闋，除太子中庶子，復掌管記。中大通三年，昭明太子薨，官屬罷，妃蔡氏別居金華宮，以襄爲中散大夫、領步兵校尉、金華宮家令、知金華宮事。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":63,"last_line":63,"raw_start":4302,"raw_end":4648,"raw_character_offsets":[4307,4308,4309,4310,4313,4314,4315,4316,4317,4318,4319,4320,4321,4322,4323,4324,4325,4326,4327,4328,4329,4330,4331,4332,4333,4334,4335,4336,4337,4338,4339,4340,4341,4342,4343,4344,4345,4346,4347,4348,4349,4350,4351,4352,4353,4354,4355,4356,4357,4358,4359,4360,4361,4362,4363,4364,4365,4366,4367,4368,4369,4370,4371,4372,4373,4374,4375,4376,4377,4378,4379,4380,4381,4382,4383,4384,4385,4386,4387,4388,4389,4390,4391,4392,4393,4394,4395,4396,4397,4398,4399,4400,4401,4402,4403,4404,4405,4406,4407,4408,4409,4410,4411