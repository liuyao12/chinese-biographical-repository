ginal_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-030-peiziye:p004:m0094","start":94,"end":96,"surface":"蕭琛","kind":"person","person_id":"m5h_0x9_uxb","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","paragraph_id":"c-liangshu-030-peiziye:p004","chapter_id":"c-liangshu-030-peiziye"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-xiaochen","person_id":"m5h_0x9_uxb","surfaces":["蕭琛"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p004:m0094"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p004","quote":"初，子野曾祖松之，宋元嘉中受詔續修何承天《宋史》，未及成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》旣行，子野更刪撰爲《宋略》二十卷。其敘事評論多善，約見而歎曰：「吾弗逮也。」蘭陵蕭琛、北地傅昭、汝南周捨咸稱重之。至是，吏部尚書徐勉言之於高祖，以爲著作郎，掌國史及起居注。頃之，兼中書通事舍人，尋除通直正員郎，著作、舍人如故。又敕掌中書詔誥。是時西北徼外有白題及滑國，遣使由岷山道入貢。此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔《注》云：『白題，胡名也。』又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰《方國使圖》，廣述懷來之盛，自要服至于海表，凡二十國。"}],"rationale":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-030-peiziye:p004","text":"初，子野曾祖松之，宋元嘉中受詔續修何承天《宋史》，未及成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》旣行，子野更刪撰爲《宋略》二十卷。其敘事評論多善，約見而歎曰：「吾弗逮也。」蘭陵蕭琛、北地傅昭、汝南周捨咸稱重之。至是，吏部尚書徐勉言之於高祖，以爲著作郎，掌國史及起居注。頃之，兼中書通事舍人，尋除通直正員郎，著作、舍人如故。又敕掌中書詔誥。是時西北徼外有白題及滑國，遣使由岷山道入貢。此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔《注》云：『白題，胡名也。』又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰《方國使圖》，廣述懷來之盛，自要服至于海表，凡二十國。","source_position":{"start":1016,"end":1322,"raw":"　　初，子野曾祖松之，宋元嘉中受詔續修何承天《宋史》，未及成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《[[宋書]]》旣行，子野更刪撰爲《宋略》二十卷。其敘事評論多善，約見而歎曰：「吾弗逮也。」蘭陵蕭琛、北地傅昭、汝南周捨咸稱重之。至是，吏部尚書徐勉言之於高祖，以爲著作郎，掌國史及起居注。頃之，兼中書通事舍人，尋除通直正員郎，著作、舍人如故。又敕掌中書詔誥。是時西北徼外有白題及滑國，遣使由岷山道入貢。此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔《注》云：『白題，胡名也。』又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰《方國使圖》，廣述懷來之盛，自要服至于海表，凡二十國。","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p004:m0002","start":2,"end":4,"surface":"子野","kind":"person","person_id":"hvz_7p7_g9m","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0006","start":6,"end":8,"surface":"松之","kind":"person","person_id":"301_026_427","status":"contextual_provisional","interpretation_note":"宋064原傳松之中書侍郎與注陳壽三國志、梁曾祖松之明字官爵及宋053議禮同人脈絡。"},{"id":"c-liangshu-030-peiziye:p004:m0017","start":17,"end":20,"surface":"何承天","kind":"person","person_id":"92h_l93_ixy","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0031","start":31,"end":33,"surface":"子野","kind":"person","person_id":"hvz_7p7_g9m","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0046","start":46,"end":48,"surface":"沈約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0057","start":57,"end":59,"surface":"子野","kind":"person","person_id":"hvz_7p7_g9m","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0079","start":79,"end":80,"surface":"約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p004:m0086","start":86,"end":87,"surface":"吾","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional","interpr