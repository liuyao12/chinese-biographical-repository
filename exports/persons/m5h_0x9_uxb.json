[{"id":"c-liangshu-027-daoqia-complete:p003:m0092","start":92,"end":94,"surface":"蕭琛","kind":"person","person_id":"m5h_0x9_uxb","status":"contextual_provisional","paragraph_id":"c-liangshu-027-daoqia-complete:p003","chapter_id":"c-liangshu-027-daoqia-complete"},{"id":"c-liangshu-027-luxiang-complete:p002:m0136","start":136,"end":138,"surface":"蕭琛","kind":"person","person_id":"m5h_0x9_uxb","status":"contextual_provisional","paragraph_id":"c-liangshu-027-luxiang-complete:p002","chapter_id":"c-liangshu-027-luxiang-complete"},{"id":"c-liangshu-030-peiziye:p004:m0094","start":94,"end":96,"surface":"蕭琛","kind":"person","person_id":"m5h_0x9_uxb","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","paragraph_id":"c-liangshu-030-peiziye:p004","chapter_id":"c-liangshu-030-peiziye"},{"start":140,"end":142,"surface":"蕭琛","id":"c-nanshi-022-wanggui:p002:m0140","person_id":"m5h_0x9_uxb","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作琛。","paragraph_id":"c-nanshi-022-wanggui:p002","chapter_id":"c-nanshi-022-wanggui"},{"id":"c-nanshi-033-pei-family:p018:m0133","start":133,"end":135,"surface":"蕭琛","kind":"person","person_id":"m5h_0x9_uxb","status":"contextual_provisional","interpretation_note":"蘭陵蕭琛稱子野評論與過秦王命比，梁030同地望同文評。","paragraph_id":"c-nanshi-033-pei-family:p018","chapter_id":"c-nanshi-033-pei-family"}],"relations":[],"title_holdings":[{"id":"th-nanshi022-wanggui-68-138","person_id":"m5h_0x9_uxb","title":"特進","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi022-wanggui-68-138:a","paragraph_id":"c-nanshi-022-wanggui:p002","start":138,"end":140,"surface":"特進","person_mention_id":"c-nanshi-022-wanggui:p002:m0140","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-022","chapter_id":"c-nanshi-022-wanggui","source_id":"s-nanshi-022-wanggui-ws1477957","paragraph_id":"c-nanshi-022-wanggui:p002","quote":"天監十二年，改造太極殿畢，規獻新殿賦，其辭甚工。後為晉安王綱雲麾諮議參軍，久之，為新安太守。父憂去職，服闋，襲封南昌縣侯。除中書黃門侍郎，敕與陳郡殷芸、琅邪王錫、范陽張緬同侍東宮，俱為昭明太子所禮。湘東王繹時為丹陽尹，與朝士宴集，屬規為酒令。規從容曰：「江左以來，未有茲舉。」特進蕭琛、金紫光祿大夫傅昭在坐，並謂為知言。朱異嘗因酒卿規，規責以無禮。","person_mention_id":"c-nanshi-022-wanggui:p002:m0140"}],"status":"source_attested","interpretation_note":"本句所載官名，任期無確切年月。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-xiaochen","person_id":"m5h_0x9_uxb","surfaces":["蕭琛"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p004:m0094"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p004","quote":"初，子野曾祖松之，宋元嘉中受詔續修何承天《宋史》，未及成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》旣行，子野更刪撰爲《宋略》二十卷。其敘事評論多善，約見而歎曰：「吾弗逮也。」蘭陵蕭琛、北地傅昭、汝南周捨咸稱重之。至是，吏部尚書徐勉言之於高祖，以爲著作郎，掌國史及起居注。頃之，兼中書通事舍人，尋除通直正員郎，著作、舍人如故。又敕掌中書詔誥。是時西北徼外有白題及滑國，遣使由岷山道入貢。此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔《注》云：『白題，胡名也。』又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰《方國使圖》，廣述懷來之盛，自要服至于海表，凡二十國。"}],"rationale":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null},{"id":"d-nanshi033-蕭琛","person_id":"m5h_0x9_uxb","surfaces":["蕭琛"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-033-pei-family:p018:m0133"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p018","quote":"初，子野曾祖松之，宋元嘉中受詔續修何承天宋史，未成而卒，子野常欲繼成先業。及齊永明末，沈約所撰《宋書》稱「松之已後無聞焉」。子野更撰為《宋略》二十卷，其敘事評論多善，而云：「戮淮南太守沈璞，以其不從義師故也」。約懼，徒跣謝之，請兩釋焉。歎其述作曰：「吾弗逮也。」蘭陵蕭琛言其評論可與過秦、王命分路揚鑣。於是吏部尚書徐勉言之于武帝，以為著作郎，掌修國史及起居注。頃之，兼中書通事舍人，尋除通直員外，著作、舍人如故。敕又掌中書詔誥。"}],"rationale":"蘭陵蕭琛稱子野評論與過秦王命比，梁030同地望同文評。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-027-daoqia-complete:p003","text":"天監初，沼、溉俱蒙擢用，洽尤見知賞，從弟沆亦相與齊名。高祖問待詔丘遲曰：「到洽何如沆、溉？」遲對曰：「正清過於沆，文章不減溉；加以清言，殆將難及。」卽召爲太子舍人。御華光殿，詔洽及沆、蕭琛、任昉侍讌，賦二十韻詩，以洽辭爲工，賜絹二十匹。高祖謂昉曰：「諸到可謂才子。」昉對曰：「臣常竊議，宋得其武，梁得其文。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":30,"last_line":30,"raw_start":1492,"raw_end":1646,"raw_character_offsets":[1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1577,1578,1579,1580,1581,1582,1583,1584,1585,1586,1587,1588,1589,1590,1591,1592,1593,1594,1595,1596,1597,1598,1599,1600,1601,1602,1603,1604,1605,1606,1607,1608,1609,1610,1611,1612,1613,1614,1615,1616,1617,1618,1619,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641,1642,1643,1644,1645],"revision_id":1511478},"mentions":[{"id":"c-liangshu-027-daoqia-complete:p003:m0004","start":4,"end":5,"surface":"沼","kind":"person","person_id":"6bo_qfq_pl9_ABA","status":"contextual_provisional"},{"id":"c-liangshu-027-daoqia-complete:p003:m0006","start":6,"end":7,"surface":"溉","kind":"person","person_id":"6bo_qfq_pl9_ABB","status":"contextual_provisional"},{"id":"c-liangshu-027-daoqia-complete:p003:m0012","start":12,"end":13,"surface":"洽","kind":"person","person_id":"4mr_j4p_k5h","status":"contextual_provisional"},{"i