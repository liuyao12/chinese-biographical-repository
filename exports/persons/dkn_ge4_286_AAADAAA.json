473,8474,8475,8476,8477,8478,8479,8480,8481,8482,8488,8489,8490,8491,8494,8495,8496,8497,8498,8499,8500,8501,8502,8503,8504,8505,8506,8507,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523,8524,8525,8526,8527,8528,8529,8530,8531,8532,8533,8534,8535,8536,8537,8538],"first_line":118,"last_line":118,"source_layer":"received_biography"},"chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018","book_id":"b-jinshu-037","work_id":"w-jinshu","source_id":"s-jinshu037-gaomi-nanyang-ws2630018"},{"id":"c-jinshu-037-phase5-pengcheng:line100","text":"彭城穆王權，字子輿，宣帝弟魏魯相東武城侯馗之子也。初襲封，拜冗從僕射。武帝受禪，封彭城王，邑二千九百戶。出為北中郎將、都督鄴城守諸軍事。泰始中入朝，賜袞冕之服。咸甯元年薨，子元王植立。歷位後將軍，尋拜國子祭酒、太僕卿、侍中、尚書。出為安東將軍、都督揚州諸軍事，代淮南王允鎮壽春，未發。或云植助允攻趙王倫，遂以憂薨。贈車騎將軍，增封萬五千戶。子康王釋立，官至南中郎將、持節、平南將軍，分魯國蕃、薛二縣以益其國，心二萬三千戶。薨，子雄立，坐奔蘇峻伏誅，更以釋子紘嗣。","mentions":[{"id":"c-jinshu-037-phase5-pengcheng:line100:m0000","start":0,"end":5,"surface":"彭城穆王權","kind":"person","person_id":"dkn_ge4_286_AAADA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0007","start":7,"end":9,"surface":"子輿","kind":"person","person_id":"dkn_ge4_286_AAADA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0010","start":10,"end":12,"surface":"宣帝","kind":"person","person_id":"dkn_ge4_286_AAAA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0020","start":20,"end":21,"surface":"馗","kind":"person","person_id":"dkn_ge4_286_AAAD"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0035","start":35,"end":37,"surface":"武帝","kind":"person","person_id":"dkn_ge4_286_AAAAIA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0087","start":87,"end":90,"surface":"元王植","kind":"person","person_id":"dkn_ge4_286_AAADAA"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0131","start":131,"end":135,"surface":"淮南王允","kind":"person","person_id":"dkn_ge4_286_AAAAIAD"},{"id":"c-jinshu-037-phase5-pengcheng:line100:m0142","start":142,"end":143,"surface":"或","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"未名記述者；或云為來源限定詞，不定成具名作者。"},{"id":"c-jinshu-037-phase5-pengcheng:l