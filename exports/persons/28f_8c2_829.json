,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi049-shenxizu-death","person_id":"28f_8c2_829","event_type":"death","source_term":"卒","source_anchor":{"paragraph_id":"c-nanqishu-049-zhangchong:p004","start":165,"end":166,"surface":"卒"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-049","chapter_id":"c-nanqishu-049-zhangchong","source_id":"s-nanqishu-049-zhangchong-ws2261984","paragraph_id":"c-nanqishu-049-zhangchong:p004","quote":"其年，遷廬陵王北中郎司馬、加冠軍將軍。未拜，豐城公遙昌爲豫州，上慮寇難未已，徙沖爲征虜長史、南梁郡太守。永泰元年，除江夏王前軍長史。東昏卽位，出爲建安王征虜長史、輔國將軍、江夏內史，行郢州府州事。永元元年，遷持節、督豫州軍事、豫州刺史，代裴叔業。竟不行。明年，遷督南兖兖徐青冀五州、輔國將軍、南兖州刺史，持節如故。會司州刺史申希祖卒，以沖爲督司州軍事、冠軍將軍、司州刺史。裴叔業以壽春降虜，又遷沖爲督南兖兖徐青冀五州、南兖州刺史，持節、將軍如故。竝未拜。崔慧景事平，徵建安王寶夤還都，以沖爲督郢司二州、郢州刺史，持節、將軍如故。一歲之中，頻授四州，至此受任。其冬，進征虜將軍。封定襄侯，食邑千戶。","person_mention_id":"c-nanqishu-049-zhangchong:p004:m0162"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-049-zhangchong:p004:m0162","start":162,"end":165,"surface":"申希祖","kind":"person","person_id":"28f_8c2_829","status":"contextual_provisional","paragraph_id":"c-nanqishu-049-zhangchong:p004","chapter_id":"c-nanqishu-049-zhangchong"}],"relations":[],"title_holdings":[{"id":"th-nanqishu-049-zhangchong-4-158","title":"司州刺史","kind":"office","mode":"attestation","person_id":"28f_8c2_829","attestations":[{"id":"th-nanqishu-049-zhangchong-4-158:a","paragraph_id":"c-nanqishu-049-zhangchong:p004","start":158,"end":162,"surface":"司州刺史","person_mention_id":"c-nanqishu-049-zhangchong:p004:m0162","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-049","chapter_id":"c-nanqishu-049-zhangchong","source_id":"s-nanqishu-049-zhangchong-ws2261984","parag