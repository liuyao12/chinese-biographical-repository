{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003256","canonical_person_id":"slm_sf2_yss","id_aliases":["cbr-p003256"],"identity_policy":"contextual_provisional","person_ids":["slm_sf2_yss"],"persons":[{"id":"qok_ik2_99j_A","label":"次景（齊悼惠王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"齊厲王","mention_ids":["c-shiji-052-qidaohui:m027-0000","c-shiji-052-qidaohui:m031-0000"]},{"surface":"次景","mention_ids":["c-shiji-052-qidaohui:m026-0181"]},{"surface":"厲王","mention_ids":["c-shiji-052-qidaohui:m026-0187","c-shiji-052-qidaohui:m027-0020"]}],"evidence":[{"mention_id":"c-shiji-052-qidaohui:m027-0000","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p027","quote":"齊厲王"},{"mention_id":"c-shiji-052-qidaohui:m031-0000","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p031","quote":"齊厲王"},{"mention_id":"c-shiji-052-qidaohui:m026-0181","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p026","quote":"次景"},{"mention_id":"c-shiji-052-qidaohui:m026-0187","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p026","quote":"厲王"},{"mention_id":"c-shiji-052-qidaohui:m027-0020","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p027","quote":"厲王"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p026","quote":"齊初圍急，陰與三國通謀，約未定，會聞路中大夫從漢來，喜，及其大臣乃復勸王毋下三國。居無何，漢將欒布、平陽侯等兵至齊，擊破三國兵，解齊圍。已而復聞齊初與三國有謀，將欲移兵伐齊。齊孝王懼，乃飲藥自殺。景帝聞之，以為齊首善，以迫劫有謀，非其罪也，乃立孝王太子壽為齊王，是為懿王，續齊後。而膠西、膠東、濟南、菑川王咸誅滅，地入于漢。徙濟北王王菑川。齊懿王立二十二年卒，子次景立，是為厲王。","source_term":"子次景立"}],"source_assertion_id":"a-shiji052-010","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"qok_ik2_99j"},"id_aliases