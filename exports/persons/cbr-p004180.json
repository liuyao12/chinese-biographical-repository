{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004180","canonical_person_id":"fxa_91g_1cz","id_aliases":["cbr-p004180"],"identity_policy":"contextual_provisional","person_ids":["fxa_91g_1cz"],"persons":[{"id":"fxa_91g_1cz","label":"召滑（樗里子甘茂列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"召滑","mention_ids":["c-shiji-071-chugan:m014-0198"]}],"evidence":[{"mention_id":"c-shiji-071-chugan:m014-0198","chapter_id":"c-shiji-071-chugan","paragraph_id":"c-shiji-071-chugan:p014","quote":"召滑"}],"id_aliases":["cbr-p004180"]}],"source_mention_summary":[{"source_id":"s-shiji-071-chugan","work_id":"w-shiji","book_id":"b-shiji-071","chapter_id":"c-shiji-071-chugan","mention_count":1,"mention_ids":["c-shiji-071-chugan:m014-0198"],"paragraph_ids":["c-shiji-071-chugan:p014"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-071-chugan"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-071-chugan:m014-0198","start":198,"end":200,"surface":"召滑","kind":"person","person_id":"fxa_91g_1cz","status":"contextual_provisional","paragraph_id":"c-shiji-071-chugan:p014","chapter_id":"c-shiji-071-chugan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji071-039","person_id":"fxa_91g_1cz","scope":"same_chapter","chapter_ids":["c-shiji-071-chugan"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依第13至14段明示姓名與引語分辨；貧富女是內嵌故事，甘茂妻子為群體不補個體。秦王齊王按蘇代轉述的受話範圍，楚王范蜎問答的王不接秦王；章義之難未按未核研究拆人物，鬼谷保持地名。","surfaces":["召滑"],"evidence":[{"paragraph_id":"c-shiji-071-chugan:p014","quote":"齊使甘茂於楚，楚懷王新與秦合婚而驩。而秦聞甘茂在楚，使人謂楚王曰：「願送甘茂於秦。」楚王問於范蜎曰：「寡人欲置相於秦，孰可？」對曰：「臣不足以識之。」楚王曰：「寡人欲相甘茂，可乎？」對曰：「不可。夫史舉，下蔡之監門也，大不為事君，小不為家室，以茍賤不廉聞於世，甘茂事之順焉。故惠王之明，武王之察，張儀之辯，而甘茂事之，取十官而無罪。茂誠賢者也，然不可相於秦。夫秦之有賢相，非楚國之利也。且王前嘗用召滑於越，而內行章義之難，越國亂，故楚南塞厲門而郡江東。計王之功所以能如此者，越國亂而楚治也。今王知用諸越而忘用諸秦，臣以王為鉅過矣。然則王若欲置相於秦，則莫若向壽者可。夫向壽之於秦王，親也，少與之同衣，長與之同車，以聽事。王必相向壽於秦，則楚國之利也。」於是使使請秦相向壽於秦。秦卒相向壽。而甘茂竟不得復入秦，卒於魏。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-071-chugan:p014","text":"齊使甘茂於楚，楚懷王新與秦合婚而驩。而秦聞甘茂在楚，使人謂楚王曰：「願送甘茂於秦。」楚王問於范蜎曰：「寡人欲置相於秦，孰可？」對曰：「臣不足以識之。」楚王曰：「寡人欲相甘茂，可乎？」對曰：「不可。夫史舉，下蔡之監門也，大不為事君，小不為家室，以茍賤不廉聞於世，甘茂事之順焉。故惠王之明，武王之察，張儀之辯，而甘茂事之，取十官而無罪。茂誠賢者也，然不可相於秦。夫秦之有賢相，非楚國之利也。且王前嘗用召滑於越，而內行章義之難，越國亂，故楚南塞厲門而郡江東。計王之功所以能如此者，越國亂而楚治也。今王知用諸越而忘用諸秦，臣以王為鉅過矣。然則王若欲置相於秦，則莫若向壽者可。夫向壽之於秦王，親也，少與之同衣，長與之同車，以聽事。王必相向壽於秦，則楚國之利也。」於是使使請秦相向壽於秦。秦卒相向壽。而甘茂竟不得復入秦，卒於魏。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-071-chugan:m014-0002","start":2,"end":4,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m014-0007","start":7,"end":10,"surface":"楚懷王","kind":"person","person_id":"xjk_0i9_vc2","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m014-0021","start":21,"end":23,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m014-0026","start":26,"end":28,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"家屬群體、未名使者或事件名稱，不補個體及姓名；章義未按字面認作人物。"},{"id":"c-shiji-071-chugan:m014-0029","start":29,"end":31,"surface":"楚王","kind":"person","person_id":"xjk_0i9_vc2","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m014-0036","start":36,"end":38,"surface":"甘茂","kind":"person","person_id":"xcr_p13_j7x","status":"contextual_provisional"},{"id":"c-shiji-071-chugan:m014-0042","start":42,"end":44,