{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003341","identity_policy":"contextual_provisional","person_ids":["cbr-p003341"],"persons":[{"id":"cbr-p003341","label":"田既（曹相國世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"田既","mention_ids":["c-shiji-054-cao:m005-0308"]}],"evidence":[{"mention_id":"c-shiji-054-cao:m005-0308","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"田既"}]}],"mentions":[{"id":"c-shiji-054-cao:m005-0308","start":308,"end":310,"surface":"田既","kind":"person","person_id":"cbr-p003341","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p005","chapter_id":"c-shiji-054-cao"}],"relations":[],"title_holdings":[{"id":"th-shiji054-037","person_id":"cbr-p003341","title":"膠東將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p005","quote":"高祖（三）［二］年，拜為假左丞相，入屯兵關中。月餘，魏王豹反，以假左丞相別與韓信東攻魏將軍孫遬軍東張，大破之。因攻安邑，得魏將王襄。擊魏王於曲陽，追至武垣，生得魏王豹。取平陽，得魏王母妻子，盡定魏地，凡五十二城。賜食邑平陽。因從韓信擊趙相國夏說軍於鄔東，大破之，斬夏說。韓信與故常山王張耳引兵下井陘，擊成安君，而令參還圍趙別將戚將軍於鄔城中。戚將軍出走，追斬之。乃引兵詣敖倉漢王之所。韓信已破趙，為相國，東擊齊。參以右丞相屬韓信，攻破齊歷下軍，遂取臨菑。還定濟北郡，攻著、漯陰、平原、鬲、盧。已而從韓信擊龍且軍於上假密，大破之，斬龍且，虜其將軍周蘭。定齊，凡得七十餘縣。得故齊王田廣相田光，其守相許章，及故齊膠東將軍田既。韓信為齊王，引兵詣陳，與漢王共破項羽，而參留平齊未服者。"}],"attestations":[{"id":"th-shiji054-037:a001","paragraph_id":"c-shiji-054-cao:p005","start":304,"end":308,"surface":"膠東將軍","person_mention_id":"c-shiji-054-cao:m005-0308","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授予、改官、爵秩、任事與追稱分開，原校勘字不改作定論；任期不由首見、死亡或後嗣承爵自動推端點。執帛、執珪、戚公等性質待制度與版本覆核；食邑調整不自造另一爵名。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji054-035","person_id":"cbr-p003341","surfaces":["田既"],"scope