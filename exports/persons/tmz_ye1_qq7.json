{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"tmz_ye1_qq7","canonical_person_id":"tmz_ye1_qq7","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["tmz_ye1_qq7"],"persons":[{"id":"tmz_ye1_qq7","label":"虞舜（司馬相如列傳候選）","status":"active","historicity":"legendary_tradition","aliases":[{"surface":"虞舜","mention_ids":["c-shiji-117-xiangru:m053-0009"]},{"surface":"舜","mention_ids":["c-shiji-117-xiangru:m063-0079","c-shiji-117-xiangru:m067-0057"]}],"evidence":[{"mention_id":"c-shiji-117-xiangru:m053-0009","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p053","quote":"虞舜"},{"mention_id":"c-shiji-117-xiangru:m063-0079","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p063","quote":"舜"},{"mention_id":"c-shiji-117-xiangru:m067-0057","chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p067","quote":"舜"}]}],"source_mention_summary":[{"source_id":"s-shiji117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","chapter_id":"c-shiji-117-xiangru","mention_count":3,"mention_ids":["c-shiji-117-xiangru:m053-0009","c-shiji-117-xiangru:m063-0079","c-shiji-117-xiangru:m067-0057"],"paragraph_ids":["c-shiji-117-xiangru:p053","c-shiji-117-xiangru:p063","c-shiji-117-xiangru:p067"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji117-xiangru"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-117-xiangru:m053-0009","start":9,"end":11,"surface":"虞舜","kind":"person","person_id":"tmz_ye1_qq7","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p053","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m063-0079","start":79,"end":80,"surface":"舜","kind":"person","person_id":"tmz_ye1_qq7","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p063","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m067-0057","start":57,"end":58,"surface":"舜","kind":"person","person_id":"tmz_ye1_qq7","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p067","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p053","text":"歴唐堯於崇山兮，過虞舜於九疑。紛湛湛其差錯兮，雜遝膠葛以方馳。騷擾𧘂蓯其相紛挐兮，滂濞泱軋灑以林離。鑽羅列聚叢以蘢茸兮，衍曼流爛壇以陸離。徑入靁室之砰磷鬱律兮，洞出鬼谷之崫礨嵬䃶。遍覽八紘而觀四荒兮，朅渡九江而越五河。經營炎火而浮弱水兮，杭絕浮渚而渉流沙。奄息總極氾濫水嬉兮，使靈媧鼓瑟而舞馮夷。時若薆薆將混濁兮，召屏翳誅風伯而刑雨師。西望崑崙之軋沕洸忽兮，直徑馳乎三危。排閶闔而入帝宮兮，載玉女而與之歸。舒閬風而搖集兮，亢烏騰而一止。低囘陰山翔以紆曲兮，吾乃今目睹西王母皬然白首。載勝而穴處兮，亦幸有三足烏爲之使。必長生若此而不死兮，雖濟萬世不足以喜。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m053-0001","start":1,"end":3,"surface":"唐堯","kind":"person","person_id":"92c_g3l_una","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m053-0009","start":9,"end":11,"surface":"虞舜","kind":"person","person_id":"tmz_ye1_qq7","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m053-0139","start":139,"end":141,"surface":"靈媧","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m053-0145","start":145,"end":147,"surface":"馮夷","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m053-0158","start":158,"end":160,"surface":"屏翳","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m053-0161","start":161,"end":163,"surface":"風伯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m053-0165","start":165,"end":167,"surface":"雨師","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m053-0196","start":196,"end":198,"surface":"玉女","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m053-0233","start":233,"end":236,"surface":"西王母","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p063","text":"般般之獸，樂我君囿；白質黑章，其儀可；旼旼睦睦，君子之般般之獸，樂我君囿；白質黑章，其儀可；旼旼睦睦，君子之能。蓋聞其聲，今觀其來。厥塗靡蹤，天瑞之徵。茲亦於舜，虞氏以興。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m063-0079","start":79,"end":80,"surface":"舜","kind":"person","person_id":"tmz_ye1_qq7","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"},{"id":"c-shiji-117-xiangru:p067","text":"披藝觀之，天人之際已交，上下相發允答。聖王之德，兢兢翼翼也。故曰「興必慮衰，安必思危」。是以湯武至尊嚴，不失肅祗；舜在假典，顧省厥遺：此之謂也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m067-0046","start":46,"end":47,"surface":"湯","kind":"person","person_id":"u3d_aj2_qbe","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m067-0047","start":47,"end":48,"surface":"武","kind":"person","person_id":"sxc_v8z_vpu","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m067-0057","start":57,"end":58,"surface":"舜","kind":"person","person_id":"tmz_ye1_qq7","status":"contextual_provisional"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、目錄標記及現代節標；quote模板保留全文，br轉段落；罕字模板保留第一參數字形，描述未作正文；連結保留顯示字。未核影像。 移除防轉換控制外殼，保留內字云。","note":"第58段U+E0FA私用字缺字與頌中重句原樣保存，不猜補；末段索隱述贊分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
