,"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-020","person_id":"ona_sbo_027","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["齊王"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p022","quote":"張儀至秦，詳失綏墮車，不朝三月。楚王聞之，曰：「儀以寡人絕齊未甚邪？」乃使勇士至宋，借宋之符，北罵齊王。齊王大怒，折節而下秦。秦齊之交合，張儀乃朝，謂楚使者曰：「臣有奉邑六里，願以獻大王左右。」楚使者曰：「臣受令於王，以商於之地六百里，不聞六里。」還報楚王，楚王大怒，發兵而攻秦。陳軫曰：「軫可發口言乎？攻之不如割地反以賂秦，與之并兵而攻齊，是我出地於秦，取償於齊也，王國尚可存。」楚王不聽，卒發兵而使將軍屈丐擊秦。秦齊共攻楚，斬首八萬，殺屈丐，遂取丹陽、漢中之地。楚又復益發兵而襲秦，至藍田，大戰，楚大敗，於是楚割兩城以與秦平。"}],"rationale":"按第1至23段局部明示姓名與引語判讀；魏襄王卒後哀王受話語境分開。楚懷王與秦惠王在出使鄭袖段分辨，不按最近名字或全域王字判讀。擬議秦女、美人與子母不補姓名或婚姻；未名齊王不按年代記憶定名，異稱、史實及時序仍待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p022","text":"張儀至秦，詳失綏墮車，不朝三月。楚王聞之，曰：「儀以寡人絕齊未甚邪？」乃使勇士至宋，借宋之符，北罵齊王。齊王大怒，折節而下秦。秦齊之交合，張儀乃朝，謂楚使者曰：「臣有奉邑六里，願以獻大王左右。」楚使者曰：「臣受令於王，以商於之地六百里，不聞六里。」還報楚王，楚王大怒，發兵而攻秦。陳軫曰：「軫可發口言乎？攻之不如割地反以賂秦，與之并兵而攻齊，是我出地於秦，取償於齊也，王國尚可存。」楚王不聽，卒發兵而使將軍屈丐擊秦。秦齊共攻楚，斬首八萬，殺屈丐，遂取丹陽、漢中之地。楚又復益發兵而襲秦，至藍田，大戰，楚大敗，於是楚割兩城以與秦平。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m022-0000","start":0,"end":2,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0016","start":16,"end":18,"surface":"楚王","kind":"person","person_id":"tq2_jdt_200","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0024","start":24,"end":25,"surface":"儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m022-0037","start":37,"end":39,"surface":"勇士","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、未定身分或擬議婚姻，不補姓名、實受關係或成員。"},{"id":"c-shiji-070-zhang:m022-0049","start":49,"end":51,"surface":"齊王","kind":"person","person_id":"ona_sbo_027","status":"contextual_p