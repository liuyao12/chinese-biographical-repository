-zhanger:p020","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m020-0053","start":53,"end":55,"surface":"田榮","kind":"person","person_id":"nzi_ufz_vr7","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p020","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m020-0103","start":103,"end":105,"surface":"田榮","kind":"person","person_id":"nzi_ufz_vr7","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p020","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[{"id":"th-shiji089-022","person_id":"nzi_ufz_vr7","title":"齊王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p020","quote":"張耳之國，陳餘愈益怒，曰：「張耳與餘功等也，今張耳王，餘獨侯，此項羽不平。」及齊王田榮畔楚，陳餘乃使夏説説田榮曰：「項羽爲天下宰不平，盡王諸將善地，徙故王王惡地，今趙王乃居代！願王假臣兵，請以南皮爲捍蔽。」田榮欲樹黨於趙以反楚，乃遣兵從陳餘。陳餘因悉三縣兵襲常山王張耳。張耳敗走，念諸侯無可歸者，曰：「漢王與我有舊故，而項羽又彊，立我，我欲之楚。」甘公曰：「漢王之入關，五星聚東井。東井者，秦分也。先至必霸。楚雖彊，後必屬漢。」故耳走漢。漢王亦還定三秦，方圍章邯廢丘。張耳謁漢王，漢王厚遇之。"}],"attestations":[{"id":"th-shiji089-022:a001","paragraph_id":"c-shiji-089-zhanger:p020","start":39,"end":41,"surface":"齊王","person_mention_id":"c-shiji-089-zhanger:m020-0039","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存明示授予、改封及用稱；十年追述不補起年，死亡不自動作任期終點；索隱述贊與正文分層。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-021","person_id":"nzi_ufz_vr7","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["田榮","齊王田榮"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p020","quote":"張耳之國，陳餘愈益怒，曰：「張耳與餘功等也，今張耳王，餘獨侯，此項羽