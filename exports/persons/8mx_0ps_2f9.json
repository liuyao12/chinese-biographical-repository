rpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line062","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line062:m0049","start":49,"end":50,"surface":"肅","kind":"person","person_id":"8mx_0ps_2f9","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line062","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line062:m0075","start":75,"end":76,"surface":"肅","kind":"person","person_id":"8mx_0ps_2f9","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line062","chapter_id":"c-sanguozhi-054-lvmeng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-054-lvmeng:line062","text":"　　是歲，又與周瑜、程普等西破曹公於烏林，圍曹仁於南郡。益州將襲肅舉軍來附，瑜表以肅兵益蒙，蒙盛稱肅有膽用。且慕化遠來，於義宜益不宜奪也。權善其言，還肅兵。瑜使甘寧前據夷陵，曹仁分眾圍寧，寧困急，使使請救。諸將以兵少不足分，蒙謂瑜、普曰：「留凌公績，蒙與君行，解圍釋急，勢亦不久，蒙保公績能十日守也。」又說瑜分遣三百人柴斷險道，賊走可得其馬。瑜從之。軍到夷陵，即日交戰，所殺過半。敵夜遁去，行遇柴道，騎皆捨馬步走。兵追蹙擊，獲馬三百匹，方船載還。於是將士形勢自倍，乃渡江立屯，與相攻擊，曹仁退走。遂據南郡，撫定荊州。還，拜偏將軍，領尋陽令。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-054-lvmeng:line062:m0007","start":7,"end":9,"surface":"周瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line062:m0010","start":10,"end":12,"surface":"程普","kind":"person","person_id":"p6n_a0q_flh","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line062:m0015","start":15,"end":17,"surface":"曹公","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-054-lvmeng:line062:m0022","start":22,"end":24,"surface":"曹仁","kind":"person","person_id":"8po_0xd_0vn","status":"contextua