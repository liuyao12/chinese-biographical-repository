der_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-zhouzhao-complete:line120","text":"周昭者字恭遠，與韋曜、薛瑩、華覈並述《呉書》，後爲中書郎，坐事下獄，覈表救之，孫休不聽，遂伏法云。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0000","start":0,"end":2,"surface":"周昭","kind":"person","person_id":"5sl_p6s_iab","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0004","start":4,"end":6,"surface":"恭遠","kind":"person","person_id":"5sl_p6s_iab","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0008","start":8,"end":10,"surface":"韋曜","kind":"person","person_id":"4qw_13i_jn6","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0011","start":11,"end":13,"surface":"薛瑩","kind":"person","person_id":"57a_8f8_a32","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0014","start":14,"end":16,"surface":"華覈","kind":"person","person_id":"idb_k2n_p9s","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0034","start":34,"end":35,"surface":"覈","kind":"person","person_id":"idb_k2n_p9s","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0039","start":39,"end":41,"surface":"孫休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":120,"last_line":120,"revision_id":2085149,"raw_start":14569,"raw_end":14628,"character_positions":[14571,14572,14573,14574,14575,14576,14577,14578,14579,14580,14581,14582,14583,14584,14585,14586,14587,14588,14589,14592,14593,14596,14597,14598,14599,14600,14601,14602,14603,14604,14605,14606,14607,14608,14609,14610,14611,14612,14613,14614,14615,14616,14617,14618,14619,14620,14621,14624,14627]},"chapter_id":"c-sanguozhi-052-zhouzhao-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-053-xueying:line066","text":"臣聞五帝三王皆立史官，敘錄功美，垂之無窮。漢時司馬遷、班固，咸命世大才，所撰精妙，與六經俱傳。大吳受命，建國南土。大皇帝末年，命太史令丁孚、郎中項峻始撰《吳書》。孚、峻俱非史才，其所撰作，不足紀錄。至少帝時，更差韋曜、周昭、薛瑩、梁廣及臣五人，訪求往事，所共撰立，備有本末。昭、廣先亡，曜負恩蹈罪，瑩出為將，復以過徙，其書遂委滯，迄今末撰奏。臣愚淺才劣，適可為瑩等記注而已，若使撰合，必襲孚、峻之跡，懼墜大皇帝之元功，損當世之盛美。瑩涉學既博，文章尤妙，同寮之中，瑩為冠首。今者見吏，雖多經學，記述之才，如瑩者少，是以慺慺為國惜之。實欲使卒垂成之功，編於前史之末。奏上之後，退填溝壑，無所復恨。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-xueying:line066:m0023","start":23,"end":26,"surface":"司馬遷","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xueying:line066:m0027","start":27,"end":29,"surface":"班固","kind":"person","person_id":"gxd_15x_9d0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xueying:line066:m0057","start":57,"end":60,"surface":"大皇帝","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xueying:line066:m0067","start":67,"end":69,"surface":"丁孚","kind":"person","person_id":"zb2_16q_up6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xueying:line066:m0072","start":72,"end":74,"surface":"項峻","kind":"person","person_id":"52t_0qg_ahc","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xueying:line066:m0081","start":81,"end":82,"surface":"孚","kind":"person","person_id":"zb2_16q_up6","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-xueying:line066:m0083","start":83,"end":84,"surface":"峻","kind":"person","person_id":"52t_0qg_ahc","status":"contextual_provisional","interpretation_note":"依本段姓