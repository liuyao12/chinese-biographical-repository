:"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line012:m0066","start":66,"end":67,"surface":"亮","kind":"person","person_id":"dkn_ge4_286_AAAAC","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line012:m0068","start":68,"end":69,"surface":"倫","kind":"person","person_id":"dkn_ge4_286_AAAAG","status":"contextual_provisional"}],"source_position":{"first_line":12,"last_line":12,"revision_id":2444513,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-038-langye-near-family","book_id":"b-jinshu-038","work_id":"w-jinshu","source_id":"s-jinshu-038-langye-near-family"},{"id":"c-jinshu-038-langye-near-family:line028","text":"伷既戚屬尊重，加有平吳之功，克己恭儉，無矜滿之色，僚吏盡力，百姓懷化。疾篤，賜床帳、衣服、錢帛、秔梁等物，遣侍中問焉。太康四年薨，時年五十七。臨終表求葬母太妃陵次，並乞分國封四子，帝許之。子恭王覲立。又封次子澹為武陵王，繇為東安王，漼為淮陵王。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-038-langye-near-family:line028:m0000","start":0,"end":1,"surface":"伷","kind":"person","person_id":"dkn_ge4_286_AAAAA","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0077","start":77,"end":79,"surface":"太妃","kind":"person","person_id":"q6k_jro_wvy","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0090","start":90,"end":91,"surface":"帝","kind":"person","person_id":"hgm_jvn_hle","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0097","start":97,"end":98,"surface":"覲","kind":"person","person_id":"dkn_ge4_286_AAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0104","start":104,"end":105,"surface":"澹","kind":"person","person_id":"dkn_ge4_286_AAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0110","start":110,"end":111,"surface":"繇","kind":"person","person_id":"dkn_ge4_286_AAAAAC","status":"contextual_provisional"},{"id":"c-jinshu-038-langye-near-family:line028:m0116","start":116,"end":117,"surface":"漼","kind":"person","person_id":"dkn_ge4_286_AAAAAD","status":"contextual_provisional"}],"source_position":{"first_line":28,"last_line":28,"revision_id":2444513,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-038-langye-near-family","book_id":"b-jinshu-038","work_id":"w-jinshu","source_id":"s-jinshu-038-langye-near-family"},{"id":"c-jinshu-059-liang-yang:line020","text":"咸甯初，以扶風池陽四千一百戶為太妃伏氏湯沐邑，置家令丞僕，後改食南郡枝江。太妃嘗有小疾，祓于洛水，亮兄弟三人侍從，並持節鼓吹，震耀洛濱。武帝登陵雲臺望見，曰：「伏妃可謂富貴矣。」其年進號衛將軍，加侍中。時宗室殷盛，無相統攝，乃以亮為宗師，本官如故，使訓導觀察，有不遵禮法，小者正以義方，大者隨事聞奏。","raw_quote":"　　咸甯初，以扶風池陽四千一百戶為太妃伏氏湯沐邑，置家令丞僕，後改食南郡枝江。太妃嘗有小疾，祓于洛水，亮兄弟三人侍從，並持節鼓吹，震耀洛濱。武帝登陵雲臺望見，曰：「伏妃可謂富貴矣。」其年進號衛將軍，加侍中。時宗室殷盛，無相統攝，乃以亮為宗師，本官如故，使訓導觀察，有不遵禮法，小者正以義方，大者隨事聞奏。","source_position":{"first_line":20,"last_line":20,"editorial_excerpt_boundary":true,"revision_id":2650517},"raw_quote_sha256":"cc6b5321f7a039e0f009cdaa43e7d2be080ebe65b3955b969536d057b9b97ce3","text_sha256":"23df4467d10e9408d9946baf0c1594e7088f6349bfeb8f333988a17b9a1ec39e","mentions":[{"start":15,"end":19,"surface":"太妃伏氏","kind":"person","person_id":"q6k_jro_wvy","id":"c-jinshu-059-liang-yang:line020:m0015"},{"start":37,"end":39,"surface":"太妃","kind":"person","person_id":"q6k_jro_wvy","id":"c-jinshu-059-liang-yang:line020:m0037"},{"start":49,"end":50,"surface":"亮","kind":"person","person_id":"dkn_ge4_286_AAAAC","id":"c-jinshu-059-liang-yang:line020:m0049"},{"start":50,"end":54,"surface":"兄弟三人","kind":"unresolved","person_id":null,"resolution_note":"含亮的三人集合，其餘二人未具名，不以038九男列表猜填。","status":"unresolved","id":"c-jinshu-059-liang-yang:line020:m0050"},{"start":68,"end":70,"surface":"武帝","kind":"person","person_id":"hgm_jvn_hle","id":"c-jinshu-059-liang-yang:line020:m0068"},{"start":80,"end":82,"surface":"伏妃","kind":"person","person_id":"q6k_jro_wvy","id":"c-jinshu-059-liang-yang:line020:m0080"},{"start":114,"end":115,"surface":"亮","kind":"person","person_id":"dkn_ge4_286_AAAAC","id":"c-jinshu-059-liang-yang:line020:m0114"}],"annotation_status":"named_mentions_first_pass","unit_id":"u-jinshu059-liang","text_layer":"received_chapter","chapter_id":"c-jinshu-059-liang-yang","book_id":"b-jinshu-059","work_id":"w-jinshu","source_id":"s-jinshu-059-liang-yang"}],"sources":[{"chapter_id":"c-jinshu-038-langye-near-family","work_id":"w-jinshu","book_id":"b-jinshu-038","source_id":"s-jinshu-038-langye-near-family","source":{"title":"《晉書》卷038（琅邪宗室父子選段）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2444513","permalink":"https://zh.wikisource.org/w/index.php?oldid=2444513","revision_id":2444513,"accessed_on":"2026-10-18","extent":"宣帝九男、伷篇末兩完整原段，及覲、渾父子兩處節錄；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","wikitext_sha256":"0ccab16e0c18edff6af7aa242c765c728b3f3e64ab3487a528513843281c2bb3","normalization":{"character_conversion":{},"extraction_note":"原行中明示節錄邊界；首段止於中興初之前，次段止於為東安王。僅展開維基連結、單參數年號模板。未收入的宗祀後文與數位校注不作本次正文。 新增原行12、28完整原段，移出ref校注、展開連結與年號模板、去粗體排版。","excerpts":[{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:p001","source_lines":[31,31],"raw_quote":"覲字思祖，拜冗從僕射。{{YL|太熙元年}}薨，時年三十五。子睿立，是為[[晉書/卷006#元帝|元帝]]。","raw_quote_sha256":"92b6b1a02491ca0bae5ba6efbd862434aa4a11adf451ec62b694bc2526214b9f","selected_text_sha256":"fad93529001ada968dcc9e1c0122ec579701178c22f8e836f307f4272b62a778","begin_anchor":"覲字思祖，拜冗從僕射。太","end_anchor":"十五。子睿立，是為元帝。"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:p002","source_lines":[41,41],"raw_quote":"後立琅邪王覲子長樂亭侯渾為東安王","raw_quote_sha256":"c2d57dc545484c083d35eb612cab1ce7c6c23cf288caf48916340f3df5eac989","selected_text_sha256":"c2d57dc545484c083d35eb612cab1ce7c6c23cf288caf48916340f3df5eac989","begin_anchor":"後立琅邪王覲子長樂亭侯渾","end_anchor":"王覲子長樂亭侯渾為東安王"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:line012","source_lines":[12,12],"raw_quote":"宣帝九男，[[晉書/卷031#宣穆張皇后|穆張皇后]]生[[晋书/卷002|景帝、文帝]]、平原王幹，伏夫人生汝南文成王亮、琅邪武王伷、清惠亭侯京、扶風武王駿，張夫人生梁王肜，柏夫人生趙王倫。亮及倫[[晉書/卷059#汝南文成王亮|別有傳]]<ref>亮及倫別有傳亮上原衍「汝南王亮」四字，今從吳本。</ref>。","raw_quote_sha256":"9d741ee0b3e17e6ca567108a29100f3bc8d931a5024c637e80643acda1c75d4e","selected_text_sha256":"7bb98cf560424553df55c266814dfa416afbbb2135eea9b6178cb65e3749cef9","begin_anchor":"宣帝九男，穆張皇后生景帝","end_anchor":"生趙王倫。亮及倫別有傳。"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:line028","source_lines":[28,28],"raw_quote":"伷既戚屬尊重，加有平吳之功，克己恭儉，無矜滿之色，僚吏盡力，百姓懷化。疾篤，賜床帳、衣服、錢帛、秔梁等物，遣侍中問焉。{{YL|太康四年}}薨，時年五十七。臨終表求葬母太妃陵次，並乞分國封四子，帝許之。子'''恭王覲'''立。又封次子澹為武陵王，繇為東安王，漼為淮陵王。","raw_quote_sha256":"ef2acda8c3066604221d94ec739fdff51de4c39b6a4f8c5081b690e40b4221b9","selected_text_sha256":"a385c4c93a02c7e1376b1354afeb7e1aa692098b28657e639422be5a3c9d9eb4","begin_anchor":"伷既戚屬尊重，加有平吳之","end_anchor":"繇為東安王，漼為淮陵王。"}],"removed_apparatus":[{"text_layer":"later_critical_apparatus","source_line":12,"raw_note":"亮及倫別有傳亮上原衍「汝南王亮」四字，今從吳本。","raw_note_sha256":"56487327592265c4717f825e825622e65455e9ec5597a1949119d7ec9afcae6d","collated_by_current_agent":false}]}}},{"chapter_id":"c-jinshu-059-liang-yang","work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-liang-yang","source":{"title":"《晉書》卷五十九司馬亮、司馬羕單元","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷059&oldid=2650517","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷059&oldid=2650517","revision_id":2650517,"accessed_on":"2026-10-19","extent":"汝南文成王亮完整五段及五子名單；西陽王羕完整兩段。數位章題另記，不冒作正文。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文與維基文庫數位轉錄；保留數位見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","wikitext_sha256":"a83fe708c8dffc5965863d337a19fd4e7222ae41e29aa99e1c2a11ed8030d1d3","response_sha256":"683d9b0b71eb861e426f4efd5a5ea11f69007e4bc680a3425b23704013695bde","normalization":{"character_conversion":{},"extraction_note":"只移除段首縮排；不改咸甯、羕、華暠等原字。","omitted_digital_paratext":[{"kind":"digital_section_heading","not_received_text":true,"source_lines":[27,28],"raw_quote":"\n===亮 子孫===","raw_quote_sha256":"315b8e04a385c26bb57159a974a7489643f0666ec144308991e7617bb23dcedd","source_revision":2650517},{"kind":"digital_section_heading","not_received_text":true,"source_lines":[17,17],"raw_quote":"==汝南文成王亮==","raw_quote_sha256":"a3a2677047ab8f18906315d2ca983baa5c5a38beac5209b4be157f09202535d0","source_revision":2650517}],"excerpts":[{"proposed_paragraph_id":"c-jinshu-059-liang-yang:line018","source_lines":[18,18],"raw_quote":"　　汝南文成王亮，字子翼，宣帝第四子也。少清警有才用，仕魏為散騎侍郎、萬歲亭侯，拜東中郎將，進封廣陽鄉侯。討諸葛誕于壽春，失利，免官。頃之，拜左將軍，加散騎常侍、假節，出監豫州諸軍事。五等建，改封祁陽伯，轉鎮西將軍。武帝踐阼，封扶風郡王，邑萬戶，置騎司馬，增參軍掾屬，持節、都督關中雍、涼諸軍事。會秦州刺史胡烈為羌虜所害，亮遣將軍劉旂、騎督敬琰赴救，不進，坐是貶為平西將軍。旂當斬，亮與軍司曹冏上言，節度之咎由亮而出，乞丐旂死。詔曰：「高平困急，計城中及旂足以相拔，就不能徑至，尚當深進。今奔突有投，而坐視覆敗，故加旂大戮。今若罪不在旂，當有所在。」有司又奏免亮官，削爵土。詔惟免官。頃之，拜撫軍將軍。是歲，吳將步闡來降，假亮節都督諸軍事以納之。尋加侍中之服。","raw_quote_sha256":"89427a9917a05dd3b40e84d6049c15f08bd01f9b34a4b163ead6b8d7e5e9fb3a","selected_text_sha256":"829934285020258d153bf9c633cac38c2e0e18f703e2eea68a27f7245a8070ab","begin_anchor":"汝南文成王亮，字子翼，宣帝第四子","end_anchor":"都督諸軍事以納之。尋加侍中之服。"},{"proposed_paragraph_id":"c-jinshu-059-liang-yang:line020","source_lines":[20,20],"raw_quote":"　　咸甯初，以扶風池陽四千一百戶為太妃伏氏湯沐邑，置家令丞僕，後改食南郡枝江。太妃嘗有小疾，祓于洛水，亮兄弟三人侍從，並持節鼓吹，震耀洛濱。武帝登陵雲臺望見，曰：「伏妃可謂富貴矣。」其年進號衛將軍，加侍中。時宗室殷盛，無相統攝，乃以亮為宗師，本官如故，使訓導觀察，有不遵禮法，小者正以義方，大者隨事聞奏。","raw_quote_sha256":"cc6b5321f7a039e0f009cdaa43e7d2be080ebe65b3955b969536d057b9b97ce3","selected_text_sha256":"23df4467d10e9408d9946baf0c1594e7088f6349bfeb8f333988a17b9a1ec39e","begin_anchor":"咸甯初，以扶風池陽四千一百戶為太","end_anchor":"法，小者正以義方，大者隨事聞奏。"},{"proposed_paragraph_id":"c-jinshu-059-liang-yang:line022","source_lines":[22,22],"raw_quote":"　　三年，徙封汝南，出為鎮南大將軍、都督豫州軍事，開府、假節，之國，給追鋒車、皁輪犢車，錢五十萬。頃之，征亮為侍中、撫軍大將軍，領後軍將軍，統冠軍、步兵、射聲、長水等營，給兵五百人，騎百匹。遷太尉、錄尚書事、領太子太傅，侍中如故。","raw_quote_sha256":"b3730615e5ea7096b901fffad1b770b81a6c28b0e3f4364fb7d790c628024b00","selected_text_sha256":"eb2908dcca24838380ca86cb40b62e0fe5c9a1cd0fe5f2b8b14f5d5bbf5e8232","begin_anchor":"三年，徙封汝南，出為鎮南大將軍、","end_anchor":"錄尚書事、領太子太傅，侍中如故。"},{"proposed_paragraph_id":"c-jinshu-059-liang-yang:line024","source_lines":[24,24],"raw_quote":"　　及武帝寢疾，為楊駿所排，乃以亮為侍中、大司馬、假黃鉞、大都督、督豫州諸軍事，出鎮許昌，加軒懸之樂，六佾之舞。封子羕為西陽公。未發，帝大漸，詔留亮委以後事。楊駿聞之，從中書監華暠索詔視，遂不還。帝崩，亮懼駿疑己，辭疾不入，于大司馬門外敘哀而已，表求過葬。駿欲討亮，亮知之，問計于廷尉何勖。勖曰：「今朝廷皆歸心於公，公何不討人而懼為人所討！」或說亮率所領入廢駿，亮不能用，夜馳赴許昌，故得免。及駿誅，詔曰：「大司馬、汝南王亮體道沖粹，通識政理，宣翼之績，顯於本朝，《二南》之風，流于方夏，將憑遠猷，以康王化。其以亮為太宰、錄尚書事，入朝不趨，劍履上殿，增掾屬十人，給千兵百騎，與太保衛瓘對掌朝政。」亮論賞誅楊駿之功過差，欲以苟悅眾心，由是失望。","raw_quote_sha256":"c88caf68dfdb8454a601000d2a2bc94cf30ce382defe99bb3f5258e9cc767229","selected_text_sha256":"05a6381096495db93d83674efac223a69e76aba2ccbf4fb215fb7aabea87635a","begin_anchor":"及武帝寢疾，為楊駿所排，乃以亮為","end_anchor":"功過差，欲以苟悅眾心，由是失望。"},{"proposed_paragraph_id":"c-jinshu-059-liang-yang:line026","source_lines":[26,26],"raw_quote":"　　楚王瑋有勳而好立威，亮憚之，欲奪其兵權。瑋甚憾，乃承賈后旨，誣亮與瓘有廢立之謀，矯詔遣其長史公孫宏與積弩將軍李肇夜以兵圍之。帳下督李龍白外有變，請距之，亮不聽。俄然楚兵登牆而呼，亮驚曰：「吾無二心，何至於是！若有詔書，其可見乎？」宏等不許，促兵攻之。長史劉准謂亮曰：「觀此必是奸謀，府中俊乂如林，猶可盡力距戰。」又弗聽，遂為肇所執，而歎曰：「我之忠心，可破示天下也，如何無道，枉殺不辜！」是時大熱，兵人坐亮于車下，時人憐之，為之交扇。將及日中，無敢害者。瑋出令曰：「能斬亮者，賞布千匹。」遂為亂兵所害，投於北門之壁，鬢髮耳鼻皆悉毀焉。及瑋誅，追復亮爵位，給東園溫明秘器，朝服一襲，錢三百萬，布絹三百匹，喪葬之禮如安平獻王孚故事，廟設軒懸之樂。","raw_quote_sha256":"4a2ac76aaa53398f3509fe76f90d19bb21c612c08ae182e2628311afd83d5047","selected_text_sha256":"18909238029fed83323d1871cfef330536d22aaa09c7c04380da76f49aa3aac7","begin_anchor":"楚王瑋有勳而好立威，亮憚之，欲奪","end_anchor":"如安平獻王孚故事，廟設軒懸之樂。"},{"proposed_paragraph_id":"c-jinshu-059-liang-yang:line029","source_lines":[29,29],"raw_quote":"　　有五子：粹、矩、羕、宗、熙。","raw_quote_sha256":"41197854a7ff4bd90d8343aa0495b650f76f47870d16c03219ea7fa74d5d7e9c","selected_text_sha256":"2f99a8916e29a56d9e5507f61aa835d1e5460d517458d573b9c82da168917562","begin_anchor":"有五子：粹、矩、羕、宗、熙。","end_anchor":"有五子：粹、矩、羕、宗、熙。"},{"proposed_paragraph_id":"c-jinshu-059-liang-yang:line039","source_lines":[39,39],"raw_quote":"　　羕字延年。太康末，封西陽縣公，拜散騎常侍。亮之被害也，羕時年八歲，鎮南將軍裴楷與之親姻，竊之以逃，一夜八遷，故得免。及瑋誅，進爵為王，曆步兵校尉、左軍驍騎將軍。元康初，進封郡王。永興初，拜侍中。以長沙王乂黨，廢為庶人。惠帝還洛，復羕封，為撫軍將軍，又以汝南期思、西陵益其國。永嘉初，拜鎮軍將軍，加散騎常侍，領後軍將軍，復以邾、蘄春益之，並前三萬五千戶。隨東海王越東出鄄城，遂南渡江。","raw_quote_sha256":"d8cfb40321d92e7136cac58bbdb091ed668f34bb200ae027ffbe698b86ccb15b","selected_text_sha256":"a2332c7a6af44f2260ca046947dcc14242dbda4682c20602b803767b323c7260","begin_anchor":"羕字延年。太康末，封西陽縣公，拜","end_anchor":"。隨東海王越東出鄄城，遂南渡江。"},{"proposed_paragraph_id":"c-jinshu-059-liang-yang:line041","source_lines":[41,41],"raw_quote":"　　元帝承制，更拜撫軍大將軍、開府，給千兵百騎，詔與南頓王宗統流人以實中州，江西荒梗，復還。及元帝踐阼，進位侍中、太保。以羕屬尊，元會特為設床。太興初，錄尚書事，尋領大宗師，加羽葆、斧鉞，班劍六十人，進位太宰。及王敦平，領太尉。明帝即位，以羕宗室元老，特為之拜。羕放縱兵士劫鈔，所司奏免羕官，詔不問。及帝寢疾，羕與王導同受顧命輔成帝。時帝幼沖，詔羕依安平獻王孚故事，設床帳於殿上，帝親迎拜。咸和初，坐弟南頓王宗免官，降為弋陽縣王。及蘇峻作亂，羕詣峻稱述其勳，峻大悅，矯詔復羕爵位。峻平，賜死。世子播、播弟充及息崧並伏誅，國除。咸康初，復其屬籍，以羕孫瑉為奉車都尉、奉朝請。","raw_quote_sha256":"c19c58d8d250c453cf9fe92559c39e205ec9f332003de79716fbdc462c1e8784","selected_text_sha256":"c7d1568a9e9071a6339f8a2264b294b8b65912d6e1bb4279e64cac5457b872ef","begin_anchor":"元帝承制，更拜撫軍大將軍、開府，","end_anchor":"籍，以羕孫瑉為奉車都尉、奉朝請。"}],"verified_blank_line_gaps":[{"source_lines":[19,19],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2650517},{"source_lines":[21,21],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2650517},{"source_lines":[23,23],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2650517},{"source_lines":[25,25],"raw_quote":"","raw_quote_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","revision_id":2650517}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
