s2603570-wangxizhi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-080-wangxizhi:p001:m0208","start":208,"end":210,"surface":"門生","kind":"person","person_id":"c9a_fag_m5r","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。","paragraph_id":"c-jinshu-080-wangxizhi:p001","chapter_id":"c-jinshu-080-wangxizhi"},{"id":"c-jinshu-080-wangxizhi:p001:m0226","start":226,"end":228,"surface":"門生","kind":"person","person_id":"c9a_fag_m5r","status":"contextual_provisional","resolution_note":"依完整傳/附敘之敘事、引語發受話人與逐項身份覆核；非全域同字匹配。","paragraph_id":"c-jinshu-080-wangxizhi:p001","chapter_id":"c-jinshu-080-wangxizhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi:p001","text":"王羲之，字逸少，司徒導之從子也。祖正，尚書郎。父曠，淮南太守。元帝之過江也，曠首創其議。羲之幼訥於言，人未之奇。年十三，嘗謁周顗，顗察而異之。時重牛心炙，坐客未啖，顗先割啖羲之，於是始知名。及長，辯贍，以骨鯁稱，尤善隸書，為古今之冠，論者稱其筆勢，以為飄若浮雲，矯若驚龍。深為從伯敦、導所器重。時陳留阮裕有重名，為敦主簿。敦嘗謂羲之曰：「汝是吾家佳子弟，當不減阮主簿。」裕亦目羲之與王承、王悅為王氏三少。時太尉郗鑒使門生求女婿于導，導令就東廂遍觀子弟。門生歸，謂鑒曰：「王氏諸少並佳，然聞信至，咸自矜持。惟一人在東床坦腹食，獨若不聞。」鑒曰：「正此佳婿邪！」訪之，乃羲之也，遂以女妻之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-080-wangxizhi:p001:m0000","start":0,"end":3,"surface":"王羲之","kind":"