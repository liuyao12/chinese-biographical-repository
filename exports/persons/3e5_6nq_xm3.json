nshu-059-jiong:p003:m0062"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-059-prince-jiong-ws2650517","s-jinshu-059-ws2650517-jiong"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-jiong:p003:m0062","start":125,"end":127,"surface":"路秀","kind":"person","person_id":"3e5_6nq_xm3","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。","paragraph_id":"c-jinshu-059-jiong:p003","chapter_id":"c-jinshu-059-jiong"},{"id":"c-jinshu-059-prince-jiong:p003:m0125","surface":"路秀","start":125,"end":127,"person_id":"3e5_6nq_xm3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-jiong:p003","chapter_id":"c-jinshu-059-prince-jiong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-jiong:p003","text":"冏於是輔政，居攸故宮，置掾屬四十人。大築第館，北取五穀市，南開諸署，毀壞廬舍以百數，使大匠營制，與西宮等。鑿千秋門牆以通西閣，後房施鐘懸，前庭舞八佾，沈於酒色，不入朝見。坐拜百官，符敕三臺，選舉不均，惟寵親昵。以車騎將軍何勖領中領軍。封葛𣄣為牟平公，路秀小黃公，衛毅陰平公，劉真安鄉公，韓泰封丘公，號曰「五公」，委以心膂。殿中御史桓豹奏事，不先經冏府，即考竟之。於是朝廷側目，海內失望矣。南陽處士鄭方露版極諫，主簿王豹屢有箴規，冏並不能用，遂奏豹殺之。有白頭公入大司馬府大呼，言有兵起，不出甲子旬。即收殺之。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-059-jiong:p003:m0058","start":0,"end":1,"surface":"冏","kind":"person","person_id":"ee0_b2a_68e","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0059","start":7,"end":8,"surface":"攸","kind":"person","person_id":"cac_ca2_008","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0060","start":110,"end":112,"surface":"何勖","kind":"person","person_id":"7e9_372_c4a","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0061","start":118,"end":120,"surface":"葛𣄣","kind":"person","person_id":"t29_ix9_yor","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0062","start":125,"end":127,"surface":"路秀","kind":"person","person_id":"3e5_6nq_xm3","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0063","start":131,"end":133,"surface":"衛毅","kind":"person","person_id":"aeg_ljr_nw1","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0064","start":137,"end":139,"surface":"劉真","kind":"person","person_id":"5j1_ztc_dpq","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0065","start":143,"end":145,"surface":"韓泰","kind":"person","person_id":"61s_ato_nlg","status":"contextual_provisional","resolution_note":"本完整敘事單元與本段引語之具體角色；詳隨附逐錨審閱。"},{"id":"c-jinshu-059-jiong:p003:m0066","start":152,"end":154,"surface":"五公","kind":"unresolved","person_id":null,"status":"unresolved","resolution_note":"群體／匿名／典故或指代仍待專項辨識，不補造單人。"},{"id":"c-jinshu-059-jiong:p003:m0067","s