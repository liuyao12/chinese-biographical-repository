5545,5546,5547,5548,5549,5550,5551,5552,5553],"projection_sha256":"9160fff910314d61d6675aef0bdfc5a936fe0787f2469664af1bcea8ae41685c"},"chapter_id":"c-liangshu-021-wangfen","book_id":"b-liangshu-021","work_id":"w-liangshu","source_id":"s-liangshu-021-wangfen-ws1544250"},{"id":"c-nanshi-022-wangxun:p001","text":"訓字懷範，生而紫胞，師媼云：「法當貴」。幼聰警，有識量，僧正惠超見而奇之，謂門人羅智國曰：「四郎眉目疏朗，舉動和韻，此是興門戶者。」智國以白暕，暕亦曰：「不墜基業，其在文殊。」文殊，訓小字也。年十三，暕亡，憂毀，家人莫識。十六召見文德殿，應對爽徹，上目送久之，謂朱異曰：「可謂相門有相。」初補國子生，問說師袁昂。昂曰：「久籍高名，有勞虛想，及觀容止，若披雲霧。」俄而諸袁子弟來，昂謂諸助教曰：「我兒出十數，若有一子如此，實無所恨。」射策，除秘書郎，累遷秘書丞。嘗賦詩云：「旦奭匡世功，蕭曹佐甿俗。」追祖儉之志也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"訓","id":"c-nanshi-022-wangxun:p001:m0000","person_id":"7r6_k52_qji_ABAAAAEAABC","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作訓。"},{"start":2,"end":4,"surface":"懷範","id":"c-nanshi-022-wangxun:p001:m0002","person_id":"7r6_k52_qji_ABAAAAEAABC","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作訓。"},{"start":30,"end":32,"surface":"惠超","id":"c-nanshi-022-wangxun:p001:m0030","person_id":"v5c_uia_wyg","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作惠。"},{"start":40,"end":43,"surface":"羅智國","id":"c-nanshi-022-wangxun:p001:m0040","person_id":"9kg_yt8_1pr","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作羅。"},{"start":66,"end":68,"surface":"智國","id":"c-nanshi-022-wangxun:p001:m0066","person_id":"9kg_yt8_1pr","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作羅。"},{"start":70,"end":71,"surface":"暕","id":"c-nanshi-022-wangxun:p001:m0070","person_id":"7r6_k52_qji_ABAAAAEAAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作暕。"},{"start":72,"end":73,"surface":"暕","id":"c-nanshi-022-wangxun:p001:m0072","person_id":"7r6_k52_qji_ABAAAAEAAB","kind":"person","status":"contextual_provisional","interpretation_no