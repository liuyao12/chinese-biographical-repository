,6802,6803,6804,6805,6806,6807,6808,6809,6810,6811,6812,6813,6814,6815,6816,6817,6818,6819,6820,6821,6822,6823,6824,6825,6826,6827,6828,6829,6830,6831,6832,6833,6834,6835,6836,6837,6838,6839,6840,6841,6842,6843,6844,6845,6846,6847,6848,6849,6850,6851,6852,6853,6854,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902],"projection_sha256":"cfb71972f349f2d58a7ba27d283922ee8e201a9bc06e7540959dad53b13ab30f"},"chapter_id":"c-nanshi-022-wangxun","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangxun-ws1477957"},{"id":"c-nanshi-023-wangqian-mothers:p001","text":"僉字公會，八歲丁父憂，哀毀過禮。初補國子生，祭酒袁昂稱為通理。累遷始興內史，丁所生母憂，固辭不拜。又除南康內史，在郡義興主薨，詔起復郡。","mentions":[{"id":"c-nanshi-023-wangqian-mothers:p001:m0000","surface":"僉","start":0,"end":1,"person_id":"q7m_r8k_2vn_ABAF","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqian-mothers:p001:m0002","surface":"公會","start":2,"end":4,"person_id":"q7m_r8k_2vn_ABAF","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqian-mothers:p001:m0024","surface":"袁昂","start":24,"end":26,"person_id":"hb9_2gq_205","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqian-mothers:p001:m0039","surface":"所生母","start":39,"end":42,"person_id":"4w4_f68_91v","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqian-mothers:p001:m0058","surface":"義興主","start":58,"end":61,"person_id":"qvt_eq1_lcf_AB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2478204,"source_layer":"received_biography","first_line":159,"last_line":159,"line_start":0,"line_end":68,"raw_start":12280,"raw_end":12348,"raw_character_offsets":[12280,12281,12282,12283,12284,12285,12286,12287,12288,12289,12290,12291,12292,12293,12294,12295,12296,12297,12298,12299,12300,12301,12302,12303,12304,12305,12306,12307,12308,12309,12310,12311,12312,12313,12314,12315,12316,12317,12318,12319,12320,12321,12322,12323,12324,12325,12326,12327,12328,12329,12330,12331,12332,12333,12334,12335,12336,12337,12338,12339,12340,12341,12342,12343,12344,12345,12346,12347],"projection_sha256":"859ff24a0908f633ef1c8d900743fa480f446c8f27dd7ead6c1ec329cfbd49e8"},"chapter_id":"c-nanshi-023-wangqian-mothers","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangqian-mothers-ws2478204"},{"id":"c-weishu-weishou-058-yangchun:p023","text":"未幾，屬元顥侵逼大梁，除昱征東將軍、右光祿大夫，加散騎常侍、使持節、假車騎將軍，為南道大都督，鎮滎陽。顥既擒濟陰王暉業，乘虛徑進，大兵集於城下，遣其左衞劉業、王道安等招昱，令降，昱不從，顥遂攻之。城陷，都督元恭，太守、西河王悰並踰城而走，俱被擒縶。昱與弟息五人，在門樓上，須臾顥至，執昱下城，面責昱曰：「楊昱，卿今死甘心否？卿自負我，非我負卿也。」昱答曰：「分不望生，向所以不下樓者，正慮亂兵耳。但恨八十老父，無人供養，負病黃泉，求乞小弟一命，便死不朽也。」顥乃拘之。明旦，顥將陳慶之、胡光等三百餘人伏顥帳前，請曰：「陛下渡江三千里，無遺鏃之費，昨日一朝殺傷五百餘人，求乞楊昱以快意。」顥曰：「我在江東，嘗聞梁主言，初下都日，袁昂為吳郡不降，稱其忠節。奈何殺楊昱？自此之外，任卿等所請。」於是斬昱下統帥三十七人，皆令蜀兵刳腹取心食之。顥既入洛，除昱名為民。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":8777,"raw_end":9155,"source_layer":"received_biography","raw_character_offsets":[8777,8778,8779,8780,8781,8782,8783,8784,8785,8786,8787,8788,8789,8790,8791,8792,8793,8794,8795,8796,8797,8798,8799,8800,8801,8802,8803,8804,8805,8806,8807,8808,8809,8810,8811,8812,8813,8814,8815,8816,8817,8818,8819,8820,8821,8822,8823,8824,8825,8826,8827,8828,8829,8830,8831,8832,8833,8834,8835,8836,8837,8838,8839,8840,8841,8842,8843,8844,8845,8846,8847,8848,8849,8850,8851,8852,8853,8854,8855,8856,8857,8858,8859,8860,8861,8862,8863,8864,8865,8866,8867,8868,8869,8870,8871,8872,8873,8874,8875,8876,8877,8878,8879,8880,8881,8882,8883,8884,8885,8886,8887,8888,8889,8890,8891,8892,8893,8894,8895,8896,8897,8898,8899,8900,890