086-pei02-01:m0004"}],"attestations":[{"id":"th-wu052-bz-11:a","paragraph_id":"c-sanguozhi-052-buzhi-complete:line086-pei02-01","start":12,"end":14,"surface":"尚書","person_mention_id":"c-sanguozhi-052-buzhi-complete:line086-pei02-01:m0004","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-buzhi-complete:line084","text":"歩騭字子山，臨淮淮陰人也。世亂，避難江東，單身窮困。與廣陵衞旌同年相善，俱以種瓜自給，晝勤四體，夜誦經傳。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line084:m0000","start":0,"end":2,"surface":"歩騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line084:m0003","start":3,"end":5,"surface":"子山","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line084:m0029","start":29,"end":31,"surface":"衞旌","kind":"person","person_id":"rns_m67_hfv","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":84,"last_line":84,"revision_id":2085149,"raw_start":11026,"raw_end":11170,"character_positions":[11028,11029,11030,11031,11032,11033,11034,11035,11036,11037,11038,11039,11040,11097,11098,11099,11100,11101,11102,11103,11104,11105,11106,11107,11108,11109,11110,11111,11112,11113,11114,11115,11116,11117,11118,11119,11120,11121,11122,11123,11124,11125,11126,11127,11128,11129,11130,11131,11132,11133,11134,11135,11136]},"chapter_id":"c-sanguozhi-052-buzhi-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-buzhi-complete"},{"id":"c-sanguozhi-052-buzhi-complete:line086","text":"會稽焦征羌，郡之豪族，人客放縱。騭與旌求食其地，懼爲所侵。乃共修刺奉瓜，以獻征羌。征羌方在內臥，駐之移時，旌欲委去。騭止之曰：「本所以來，畏其強也。而今捨去，欲以爲高，只結怨耳。」良久，征羌開牖見之，身隱几坐帳中，設席致地，坐騭、旌於牖外，旌愈恥之，騭辭色自若。征羌作食，身享大案，殽膳重沓，以小盤飯與騭、旌，惟菜茹而已。旌不能食，騭極飯致飽乃辭出。旌怒騭曰：「何能忍此？」騭曰：「吾等貧賤，是以主人以貧賤遇之，固其宜也，當何所恥？」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-buzhi-complete:line086:m0002","start":2,"end":5,"surface":"焦征羌","kind":"person","person_id":"iu8_yal_rpj","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line086:m0016","start":16,"end":17,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line086:m0018","start":18,"end":19,"surface":"旌","kind":"person","person_id":"rns_m67_hfv","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line086:m0038","start":38,"end":40,"surface":"征羌","kind":"person","person_id":"iu8_yal_rpj","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line086:m0041","start":41,"end":43,"surface":"征羌","kind":"person","person_id":"iu8_yal_rpj","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line086:m0053","start":53,"end":54,"surface":"旌","kind":"person","person_id":"rns_m67_hfv","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line086:m0058","start":58,"end":59,"surface":"騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-buzhi-complete:line086:m0093","start":93,"end":95,"surface":"征羌","kind":"person","person_id":"iu8_yal_rpj","st