liangshu-027-yinjun-complete:p003:m0049","paragraph_id":"c-liangshu-027-yinjun-complete:p003","chapter_id":"c-liangshu-027-yinjun-complete","quote":"鈞"},{"mention_id":"c-liangshu-027-yinjun-complete:p003:m0073","paragraph_id":"c-liangshu-027-yinjun-complete:p003","chapter_id":"c-liangshu-027-yinjun-complete","quote":"鈞"},{"mention_id":"c-liangshu-027-yinjun-complete:p003:m0192","paragraph_id":"c-liangshu-027-yinjun-complete:p003","chapter_id":"c-liangshu-027-yinjun-complete","quote":"鈞"},{"mention_id":"c-nanshi-060-yinjun-two-sons:p001:m0011","paragraph_id":"c-nanshi-060-yinjun-two-sons:p001","chapter_id":"c-nanshi-060-yinjun-two-sons","quote":"鈞"},{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-yinjun-complete","source_id":"s-liangshu-027-yinjun-complete-ws1511478","paragraph_id":"c-liangshu-027-yinjun-complete:p001","quote":"之","kind":"person_reference","mention_id":"c-liangshu-027-yinjun-complete:p001:r0134"},{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-yinjun-complete","source_id":"s-liangshu-027-yinjun-complete-ws1511478","paragraph_id":"c-liangshu-027-yinjun-complete:p003","quote":"小人","kind":"person_reference","mention_id":"c-liangshu-027-yinjun-complete:p003:r0219"},{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-yinjun-complete","source_id":"s-liangshu-027-yinjun-complete-ws1511478","paragraph_id":"c-liangshu-027-yinjun-complete:p003","quote":"臣","kind":"person_reference","mention_id":"c-liangshu-027-yinjun-complete:p003:r0303"},{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-yinjun-complete","source_id":"s-liangshu-027-yinjun-complete-ws1511478","paragraph_id":"c-liangshu-027-yinjun-complete:p003","quote":"之","kind":"person_reference","mention_id":"c-liangshu-027-yinjun-complete:p003:r0099"},{"mention_id":"c-liangshu-027-five-appraisals:p001:m0031","paragraph_id":"c-liangshu-027-five-appraisals:p001","chapter_id":"c-liangshu-027-five-appraisals","quote":"殷鈞"}],"review":"ai_provisional","identity_note":"字季和，齊人叡之子，娶梁武長女永興公主。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"ceq_pnr_q0e","source_assertion_id":"a-nanshi019-tiao-jun","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xietiao","source_id":"s-nanshi-019-xietiao-ws1531762","paragraph_id":"c-nanshi-019-xietiao:p008","quote":"朓及殷叡素與梁武以文章相得，帝以大女永興公主適叡子鈞，第二女永世公主適朓子謨。及帝爲雍州，二女並暫隨母向州。及武帝即位，二主始隨內還。武帝意薄謨，又以門單，欲更適張弘策子，弘策卒，又以與王志子諲。而謨不堪歎恨，爲書狀如詩贈主。主以呈帝，甚蒙矜歎，而婦終不得還。尋用謨爲信安縣，稍遷王府諮議。時以爲沈約早與朓善，爲制此書雲。","subject_person_mention_id":"c-nanshi-019-xietiao:p008:m0025","object_person_mention_id":"c-nanshi-019-xietiao:p008:m0023","source_term":"叡子鈞"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"本句並有兩個姓名錨點。"}},{"id":"ceq_pnr_q0e_AB","label":"殷渥（殷鈞子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"渥","mention_ids":["c-liangshu-027-yinjun-complete:p003:m0433","c-nanshi-060-yinjun-two-sons:p001:m0009"]}],"evidence":[{"mention_id":"c-liangshu-027-yinjun-complete:p003:m0433","paragraph_id":"c-liangshu-027-yinjun-complete:p003","chapter_id":"c-liangshu-027-yinjun-complete","quote":"渥"},{"mention_id":"c-nanshi-060-yinjun-two-sons:p001:m0009","paragraph_id":"c-nanshi-060-yinjun-two-sons:p001","chapter_id":"c-nanshi-060-yinjun-two-sons","quote":"渥"}],"review":"ai_provisional","identity_note":"殷渥（殷鈞子），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"ceq_pnr_q0e_A","source_assertion_id":"a-liang027-yinjun-son-渥","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-yinjun-complete","source_id":"s-liangshu-027-yinjun-complete-ws1511478","paragraph_id":"c-liangshu-027-yinjun-complete:p003","quote":"鈞體羸多疾，閉閤臥治，而百姓化其德，劫盜皆奔出境。嘗禽劫帥，不加考掠，但和言誚責。劫帥稽顙乞改過，鈞便命遣之，後遂爲善人。郡舊多山瘧，更暑必動，自鈞在任，郡境無復瘧疾。母憂去職，居喪過禮，昭明太子憂之，手書誡喻曰：「知比諸德，哀頓爲過，又所進殆無一溢，甚以酸耿。迥然一身，宗奠是寄，毀而滅性，聖教所不許。宜微自遣割，俯存禮制，穀粥果蔬，少加勉強。憂懷旣深，指故有及，並令繆道臻口具。」鈞答曰：「奉賜手令，並繆道臻宣旨，伏讀感咽，肝心塗地。小人無情，動不及禮，但稟生尫劣，假推年歲，罪戾所鐘，復加橫疾。頃者綿微，守盡晷漏，目亂玄黃，心迷哀樂，惟救危苦，未能以遠理自製。姜桂之滋，實聞前典，不避粱肉，復忝今慈，臣亦何人，降此憂愍。謹當循復聖言，思自補續，如脫申延，實由亭造。」服闋，遷五兵尚書，猶以頓瘵經時，不堪拜受，乃更授散騎常侍、領步兵校尉，侍東宮。尋改領中庶子。昭明太子薨，官屬罷，又領右遊擊，除國子祭酒，常侍如故。中大通四年，卒，時年四十九。諡曰貞子。二子：構，渥。","subject_person_mention_id":"c-liangshu-027-yinjun-complete:p003:m0433","object_person_mention_id":"c-liangshu-027-yinjun-complete:p003:m0000","source_term":"二子：構，渥"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"鈞卒諡後列二子，與南史同。"}}],"source_mention_summary":[{"source_id":"s-liangshu-027-yinjun-complete-ws1511478","work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-yinjun-complete","raw_mention_count":1,"mention_ids":["c-liangshu-027-yinjun-complete:p003:m0433"],"paragraph_ids":["c-liangshu-027-yinjun-complete:p003"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-027-yinjun-complete:p003:m0433","mention_ids":["c-liangshu-027-yinjun-complete:p003:m0433"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanshi-060-yinjun-two-sons-ws1495505","work_id":"w-nanshi","book_id":"b-nanshi-060","chapter_id":"c-nanshi-060-yinjun-two-sons","raw_mention_count":1,"mention_ids":["c-nanshi-060-yinjun-two-sons:p001:m0009"],"paragraph_ids":["c-nanshi-060-yinjun-two-sons:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-060-yinjun-two-sons:p001:m0009","mention_ids":["c-nanshi-060-yinjun-two-sons:p001:m0009"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-027-yinjun-complete-ws1511478","s-nanshi-060-yinjun-two-sons-ws1495505"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-liang027-yinjun-son-渥","subject_person_id":"ceq_pnr_q0e_AB","object_person_id":"ceq_pnr_q0e_A","predicate":"father","qualifiers":{"source_term":"二子：構，渥","lineage":"paternal"},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-027","chapter_id":"c-liangshu-027-yinjun-complete","source_id":"s-liangshu-027-yinjun-complete-ws1511478","paragraph_id":"c-liangshu-027-yinjun-complete:p003","quote":"鈞體羸多疾，閉閤臥治，而百姓化其德，劫盜皆奔出境。嘗禽劫帥，不加考掠，但和言誚責。劫帥稽顙乞改過，鈞便命遣之，後遂爲善人。郡舊多山瘧，更暑必動，自鈞在任，郡境無復瘧疾。母憂去職，居喪過禮，昭明太子憂之，手書誡喻曰：「知比諸德，哀頓爲過，又所進殆無一溢，甚以酸耿。迥然一身，宗奠是寄，毀而滅性，聖教所不許。宜微自遣割，俯存禮制，穀粥果蔬，少加勉強。憂懷旣深，指故有及，並令繆道臻口具。」鈞答曰：「奉賜手令，並繆道臻宣旨，伏讀感咽，肝心塗地。小人無情，動不及禮，但稟生尫劣，假推年歲，罪戾所鐘，復加橫疾。頃者綿微，守盡晷漏，目亂玄黃，心迷哀樂，惟救危苦，未能以遠理自製。姜桂之滋，實聞前典，不避粱肉，復忝今慈，臣亦何人，降此憂愍。謹當循復聖言，思自補續，如脫申延，實由亭造。」服闋，遷五兵尚書，猶以頓瘵經時，不堪拜受，乃更授散騎常侍、領步兵校尉，侍東宮。尋改領中庶子。昭明太子薨，官屬罷，又領右遊擊，除國子祭酒，常侍如故。中大通四年，卒，時年四十九。諡曰貞子。二子：構，渥。","subject_person_mention_id":"c-liangshu-027-yinjun-complete:p003:m0433","object_person_mention_id":"c-liangshu-027-yinjun-complete:p003:m0000"}],"status":"source_attested","interpretation_note":"鈞卒諡後列二子，與南史同。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"parent_person_id":"ceq_pnr_q0e_A","source_assertion_id":"a-