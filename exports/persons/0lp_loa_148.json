plete:line068:m0170","mention_ids":["c-sanguozhi-052-zhugejin-complete:line068:m0170"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-052-zhugejin-complete:line068:m0220","mention_ids":["c-sanguozhi-052-zhugejin-complete:line068:m0220"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-052-zhugejin-complete:line068:m0276","mention_ids":["c-sanguozhi-052-zhugejin-complete:line068:m0276"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-052-zhugejin-complete"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-052-zhugejin-complete:line068:reading-165-317","kind":"received_sentence","paragraph_id":"c-sanguozhi-052-zhugejin-complete:line068","person_id":"0lp_loa_148","related_person_ids":["lpo_z63_vzb","572_278_cba"],"start_codepoint":165,"end_codepoint":317,"source_quote":"權又怪校尉殷模，罪至不測。群下多爲之言，權怒益甚，與相反覆，推瑾默然。權曰：「子瑜何獨不言？」瑾避席曰：\"瑾與殷模等遭本州傾覆，生類殄盡。棄墳墓，攜老弱，披草萊，歸聖化，在流隸之中，蒙生成之福，不能躬相督厲。陳答萬一，至令模孤負恩惠，自陷罪戾。臣謝過不暇，誠不敢有言。\"權聞之愴然，乃曰：\"特爲君赦之。\"","reading":"瑾自責，權赦殷模。數位推瑾默然，殿本惟瑾默然。","chapter_id":"c-sanguozhi-052-zhugejin-complete","source_id":"s-sanguozhi-052-zhugejin-complete"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-052-zhugejin-complete:line068:m0170","start":170,"end":172,"surface":"殷模","kind":"person","person_id":"0lp_loa_148","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhugejin-complete:line068","chapter_id":"c-sanguozhi-052-zhugejin-complete"},{"id":"c-sanguozhi-052-zhugejin-complete:line068:m0220","start":220,"end":222,"surface":"殷模","kind":"person","person_id":"0lp_loa_148","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhugejin-complete:line068","chapter_id":"c-sanguozhi-052-zhugejin-complete"},{"id":"c-sanguozhi-052-zhugejin-complete:line068:m0276","start":276,"end":277,"surface":"模","kind":"person","person_id":"0lp_loa_148","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhugejin-complete:line068","chapter_id":"c-sanguozhi-052-zhugejin-complete"}],"relations":[],"title_holdings":[{"id":"th-wu052-zj-3","person_id":"0lp_loa_148","title":"校尉","kind":"office","mode":"attestation","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-zhugejin-complete","source_id":"s-sanguozhi-052-zhugejin-complete","paragraph_id":"c-sanguozhi-052-zhugejin-complete:line068","quote":"與權談説諫喻，未嘗切愕，微見風彩，粗陳指歸。如有未合，則捨而及他，徐復托事造端，以物類相求，於是權意往往而釋。呉郡太守朱治，權舉將也，權曾有以望之，而素加敬，難自詰讓，忿忿不解。瑾揣知其故，而不敢顯陳，乃乞以意私自問，遂於權前爲書，泛論物理，因以己心遙往忖度之。畢，以呈權，權喜，笑曰：「孤意解矣。顏氏之德，使人加親，豈謂此耶？」權又怪校尉殷模，罪至不測。群下多爲之言，權怒益甚，與相反覆，推瑾默然。權曰：「子瑜何獨不言？」瑾避席曰：\"瑾與殷模等遭本州傾覆，生類殄盡。棄墳墓，攜老弱，披草萊，歸聖化，在流隸之中，蒙生成之福，不能躬相督厲。陳答萬一，至令模孤負恩惠，自陷罪戾。臣謝過不暇，誠不敢有言。\"權聞之愴然，乃曰：\"特爲君赦之。\"","person_mention_id":"c-sanguozhi-052-zhugejin-complete:line068:m0170"}],"attestations":[{"id":"th-wu052-zj-3:a","paragraph_id":"c-sanguozhi-052-zhugejin-complete:line068","start":168,"end":170,"surface":"校尉","person_mention_id":"c-sanguozhi-052-zhugejin-complete:line068:m0170","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-sanguozhi-052-zhugejin-complete:line068:r0314","paragraph_id":"c-sanguozhi-052-zhugejin-complete:line068","start":314,"end":315,"surface":"之","person_id":"0lp_loa_148","quote":"特爲君赦之","referent_role":"third_person","note":"依此段書牘、對話或敘述所指。","chapter_id":"c-sanguozhi-052-zhugejin-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhugejin-complete"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-zhugejin-complete:line068","text":"與權談説諫喻，未嘗切愕，微見風彩，粗陳指歸。如有未合，則捨而及他，徐復托事造端，以物類相求，於是權意往往而釋。呉郡太守朱治，權舉將也，權曾有以望之，而素加敬，難自詰讓，忿忿不解。瑾揣知其故，而不敢顯陳，乃乞以意私自問，遂於權前爲書，泛論物理，因以己心遙往忖度之。畢，以呈權，權喜，笑曰：「孤意解矣。顏氏之德，使人加親，豈謂此耶？」權又怪校尉殷模，罪至不測。群下多爲之言，權怒益甚，與相反覆，推瑾默然。權曰：「子瑜何獨不言？」瑾避席曰：\"瑾與殷模等遭本州傾覆，生類殄盡。棄墳墓，攜老弱，披草萊，歸聖化，在流隸之中，蒙生成之福，不能躬相督厲。陳答萬一，至令模孤負恩惠，自陷罪戾。臣謝過不暇，誠不敢有言。\"權聞之愴然，乃曰：\"特爲君赦之。\"","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhugejin-complete:line068:m0001","start":1,"end":2,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line068:m0048","start":48,"end":49,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line068:m0059","start":59,"end":61,"surface":"朱治","kind":"person","person_id":"oix_a6t_ovk","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line068:m0062","start":62,"end":63,"surface":"權","kind":"pers