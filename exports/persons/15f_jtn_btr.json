n_id":"d2b_1d3_333","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-appraisal:p001:m0192","surface":"正叔","start":192,"end":194,"person_id":"54l_hzh_um4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-appraisal:p001:m0244","surface":"孟陽","start":244,"end":246,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-appraisal:p001:m0254","surface":"張敏","start":254,"end":256,"person_id":"z1a_96x_tl0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-appraisal:p001:m0267","surface":"傅玄","start":267,"end":269,"person_id":"15f_jtn_btr","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-055-appraisal","book_id":"b-jinshu-055","work_id":"w-jinshu","source_id":"s-jinshu-055-appraisal-ws2316433"},{"id":"c-jinshu-055-zhang-zai:p007","text":"載又為《蒙汜賦》，司隸校尉傅玄見而嗟歎，以車迎之，言談盡日，為之延譽，遂知名。起家佐著作郎，出補肥鄉令。復為著作郎，轉太子中舍人，遷樂安相、弘農太守。長沙王乂請為記室督。拜中書侍郎，復領著作。載見世方亂，無復進仕意，遂稱疾篤告歸，卒於家。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":162,"last_line":162,"raw_start":14425,"raw_end":14544,"raw_character_offsets":[14425,14426,14427,14428,14429,14430,14431,14432,14433,14434,14435,14436,14437,14438,14439,14440,14441,14442,14443,14444,14445,14446,14447,14448,14449,14450,14451,14452,14453,14454,14455,14456,14457,14458,14459,14460,14461,14462,14463,14464,14465,14466,14467,14468,14469,14470,14471,14472,14473,14474,14475,14476,14477,14478,14479,14480,14481,14482,14483,14484,14485,14486,14487,14488,14489,14490,14491,14492,14493,14494,14495,14496,14497,14498,14499,14500,14501,14502,14503,14504,14505,14506,14507,14508,14509,14510,14511,14512,14513,14514,14515,14516,14517,14518,14519,14520,14521,14522,14523,14524,14525,14526,14527,14528,14529,14530,14531,14532,14533,14534,14535,14536,14537,14538,14539,14540,14541,14542,14543],"revision_id":2316433},"mentions":[{"id":"c-jinshu-055-zhang-zai:p007:m0000","surface":"載","start":0,"end":1,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-zai:p007:m0013","surface":"傅玄","start":13,"end":15,"person_id":"15f_jtn_btr","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-zai:p007:m0075","surface":"長沙王乂","start":75,"end":79,"person_id":"4c6_984_9ed","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-zhang-zai:p007:m0096","surface":"載","start":96,"end":97,"person_id":"xyt_fs1_lsx","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-055-zhang-zai","book_id":"b-jinshu-055","work_id":"w-jinshu","source_id":"s-jinshu-055-zhang-zai-ws2316433"},{"id":"c-jinshu-060-suojing:p001","text":"索靖，字幼安，敦煌人也。累世官族，父湛，北地太守。靖少有逸群之量，與鄉人泛衷、張甝、索紾、索永俱詣太學，馳名海內，號稱「敦煌五龍」。四人並早亡，唯靖該博經史，兼通內緯。州辟別駕，郡舉賢良方正，對策高第。傅玄、張華與靖一面，皆厚與之相結。拜駙馬都尉，出為西域戊己校尉長史。太子僕同郡張勃特表，以靖才藝絕人，宜在臺閣，不宜遠出邊塞。武帝納之，擢為尚書郎。與襄陽羅尚、河南潘岳、吳郡顧榮同官，咸器服焉。靖與尚書令衛瓘俱以善草書知名，帝愛之。瓘筆勝靖，然有楷法，遠不能及靖。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":99,"last_line":99,"raw_start":8391,"raw_end":8626,"raw_character_offsets":[8393,8394,8395,8396,8397,8398,8399,8400,8401,8402,8403,8404,8405,8406,8407,8408,8409,8410,8411,8412,8413,8414,8415,8416,8417,8418,8419,8420,8421,8422,8423,8424,8425,8426,8427,8428,8429,8430,8431,8432,8433,8434,8435,8436,8437,8438,8439,8440,8441,8442,8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453,8454,8455,8456,8457,8458,8459,8460,8461,8462,8463,8464,8465,8466,8467,8468,8469,8470,8471,8472,8473,8474,8475,8476,8477,8478,8479,8480,8481,8482,8483,8484,8485,8486,8487,8488,8489,8490,8491,8492,8493,8494,8495,8496,8497,8498,8499,8500,8501,8502,8503,8504,8505,8506,8507,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523,8524,8525,8526,8527,8528,8529,8530,8531,8532,8533,8534,8535,8536,8537,8538,8539,8540,8541,8542,8543,8544,8545,8546,8547,8548,8549,8550,8551,8552,8553,8554,8555,8556,8557,8558,8559,8560,8561,8562,8563,8564,8565,8566,8567,8568,8569,8570