cy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-094-tiandan:m004-0013","start":13,"end":15,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p004","chapter_id":"c-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:m004-0039","start":39,"end":41,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p004","chapter_id":"c-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:m005-0000","start":0,"end":2,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p005","chapter_id":"c-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:m005-0013","start":13,"end":15,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p005","chapter_id":"c-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:m005-0185","start":185,"end":187,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p005","chapter_id":"c-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:m006-0111","start":111,"end":113,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional","paragraph_id":"c-shiji-094-tiandan:p006","chapter_id":"c-shiji-094-tiandan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji094-021","person_id":"8h7_82d_vjr","surfaces":["項梁"],"scope":"same_chapter","chapter_ids":["c-shiji-094-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-094-tiandan:p004","quote":"田榮之走東阿，章邯追圍之。項梁聞田榮之急，乃引兵擊破章邯軍東阿下。章邯走而西，項梁因追之。而田榮怒齊之立假，乃引兵歸，擊逐齊王假。假亡走楚。齊相角亡走趙；角弟田閒前求救趙，因留不敢歸。田榮乃立田儋子市為齊王。榮相之，田橫為將，平齊地。"},{"paragraph_id":"c-shiji-094-tiandan:p005","quote":"項梁既追章邯，章邯兵益盛，項梁使使告趙、齊，發兵共擊章邯。田榮曰：「使楚殺田假，趙殺田角、田閒，閒肯出兵。」楚懷王曰：「田假與國之王，窮而歸我，殺之不義。」趙亦不殺田角、田閒以市於齊。齊曰：「蝮螫手則斬手，螫足則斬足。何者？為害於身也。今田假、田角、田閒於楚、趙，非直手足戚也，何故不殺？且秦復得志於天下，則齮齕用事者墳墓矣。」楚、趙不聽，齊亦怒，終不肯出兵。章邯果敗殺項梁，破楚兵，楚兵東走，而章邯渡河圍趙於鉅鹿。項羽往救趙，由此怨田榮。"},{"paragraph_id":"c-shiji-094-tiandan:p006","quote":"項羽既存趙，降章邯等，西屠咸陽，滅秦而立侯王也，乃徙齊王田市更王膠東，治即墨。齊將田都從共救趙，因入關，故立都為齊王，治臨淄。故齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引兵降項羽，項羽立田安為濟北王，治博陽。田榮以負項梁不肯出兵助楚、趙攻秦，故不得王；趙將陳餘亦失職，不得王：二人俱怨項王。"}],"rationale":"明示姓名與局部敘事承接，短稱及田間田閒等異字仍待覆核，不按全域同名合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-094-tiandan:p004","text":"田榮之走東阿，章邯追圍之。項梁聞田榮之急，乃引兵擊破章邯軍東阿下。章邯走而西，項梁因追之。而田榮怒齊之立假，乃引兵歸，擊逐齊王假。假亡走楚。齊相角亡走趙；角弟田閒前求救趙，因留不敢歸。田榮乃立田儋子市為齊王。榮相之，田橫為將，平齊地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m004-0000","start":0,"end":2,"surface":"田榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0007","start":7,"end":9,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0013","start":13,"end":15,"surface":"項梁","kind":"person","person_id":"8h7_82d_vjr","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0016","start":16,"end":18,"surface":"田榮","kind":"person","person_id":"t9b_1eg_mqs","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0026","start":26,"end":28,"surface":"章邯","kind":"person","person_id":"504_piy_j5v","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0033","start":33,"end":35,"surface":"章邯","kind":