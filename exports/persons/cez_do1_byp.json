依入秦、返齊及食客敘事明示姓名與局部回指暫接。未名夜食客、蔽光者、狗盜鷄鳴兩客、幸姬及勸說毀者各存角色，不補姓名或全域連所有客稱；木土偶保持寓言。蘇代內嵌秦昭王王稱與外層孟嘗君君稱分辨，楚王割地與楚懷王得出暫分候選，不確證異人；田甲劫王與孟嘗君反謀指控分開，不把指控當史實。","surfaces":["趙平原君"],"evidence":[{"paragraph_id":"c-shiji-075-mengchang:p007","quote":"孟嘗君過趙，趙平原君客之。趙人聞孟嘗君賢，出觀之，皆笑曰：「始以薛公爲魁然也，今視之，乃眇小丈夫耳。」孟嘗君聞之，怒。客與倶者下，斫撃殺數百人，遂滅一縣以去。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-075-mengchang:p007","text":"孟嘗君過趙，趙平原君客之。趙人聞孟嘗君賢，出觀之，皆笑曰：「始以薛公爲魁然也，今視之，乃眇小丈夫耳。」孟嘗君聞之，怒。客與倶者下，斫撃殺數百人，遂滅一縣以去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-075-mengchang:m007-0000","start":0,"end":3,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m007-0006","start":6,"end":10,"surface":"趙平原君","kind":"person","person_id":"cez_do1_byp","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m007-0013","start":13,"end":15,"surface":"趙人","kind":"unresolved","person_id":null,"status":"unresolved","note":"寓言木土偶、未名群體、族屬或未定指代，不當真人或補群體成員；二人需各按已定位客角色解讀，不將所有客稱接同一人。"},{"id":"c-shiji-075-mengchang:m007-0016","start":16,"end":19,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m007-0032","start":32,"end":34,"surface":"薛公","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m007-0051","start":51,"end":54,"surface":"孟嘗君","kind":"person","person_id":"7s4_7ac_lhn_AA","status":"contextual_provisional"},{"id":"c-shiji-075-mengchang:m007-0059","start":59,"end":63,"surface":"客與倶者","kind":"unresolved","person_id":null,"status":"unresolved","note":"寓言木土偶、未名群體、族屬或未定指代，不當真人或補群體成員；二人需各按已定位客角色解讀，不將所有客稱接同一人。"},{"id":"c-shiji-075-mengchang:m007-0068","start":68,"end":71,"surface":"數百人","kind":"unresolved","person_id":null,"status":"unresolved","note":"寓言木土偶、未名群體、族屬或未定指代，不當真人或補群體成員；二人需各按已定位客角色解讀，不將所有客稱接同一人。"}],"chapter_id":"c-shiji-075-mengchang","book_id":"b-shiji-0