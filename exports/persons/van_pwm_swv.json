進昌平澗，戰不利，眾各離散，乃俱奔鮮卑慕容德。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":55,"last_line":55,"raw_start":4985,"raw_end":5223,"raw_character_offsets":[4985,4986,4987,4988,4989,4990,4991,4992,4993,4994,4995,4996,4997,4998,4999,5000,5001,5002,5003,5004,5005,5006,5007,5008,5009,5010,5011,5012,5013,5014,5015,5016,5017,5018,5019,5020,5021,5022,5023,5024,5025,5026,5027,5028,5029,5030,5031,5032,5033,5034,5035,5036,5037,5038,5039,5040,5041,5042,5043,5044,5045,5046,5047,5048,5049,5050,5051,5052,5053,5054,5055,5056,5057,5058,5059,5060,5061,5062,5063,5064,5065,5066,5067,5068,5069,5070,5071,5072,5073,5074,5075,5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222],"revision_id":2190557},"mentions":[{"id":"c-songshu-047-liujingxuan:p006:m0000","start":0,"end":1,"surface":"玄","kind":"person","person_id":"u9s_w6j_8mc_AAF","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0006","start":6,"end":8,"surface":"元顯","kind":"person","person_id":"c03_362_4d7","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0010","start":10,"end":12,"surface":"道子","kind":"person","person_id":"dkn_ge4_286_AAAAAAAFA","status":"contextual_provisional"},{"id":"c-songshu-047-liujingxuan:p006:m0014","start":14,"end":16,"surface":"牢之","kind":"person","pe