al_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-057-luji:line037:m0095","start":95,"end":97,"surface":"秦松","kind":"person","person_id":"2fy_jac_mju","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-057-luji:line037","chapter_id":"c-sanguozhi-057-luji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-057-luji:line037","text":"陸績字公紀，吳郡吳人也。父康，漢末為廬江太守。績年六歲，於九江見袁術。術出橘，績懷三枚，去，拜辭墮地，術謂曰：“陸郎作賓客而懷橘乎？”績跪答曰：\"欲歸遺母。\"術大奇之。孫策在吳，張昭、張紘、秦松為上賓，共論四海未泰，須當用武治而平之，績年少末坐，遙大聲言曰：\"昔管夷吾相齊桓公，九合諸候，一匡天下，不用兵車。孔子曰：'遠人不服，則修文德以來之。'今論者不務道德懷取之術，而惟尚武，績雖童蒙，竊所未安也。\"昭等異焉。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-057-luji:line037:m0001","start":1,"end":2,"surface":"績","kind":"person","person_id":"7ec_qvv_x1c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037:m0003","start":3,"end":5,"surface":"公紀","kind":"person","person_id":"7ec_qvv_x1c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037:m0013","start":13,"end":14,"surface":"康","kind":"person","person_id":"tfy_qzo_rqx","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037:m0023","start":23,"end":24,"surface":"績","kind":"person","person_id":"7ec_qvv_x1c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037:m0033","start":33,"end":34,"surface":"術","kind":"person","person_id":"865_b69_cb0","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-luji:line037:m0035","start":35,"end":36,"surface":"術","kind":"person","person_id":