provisional"},{"id":"c-shiji-056-chen:m008-0195","start":195,"end":198,"surface":"鍾離眛","kind":"person","person_id":"tb2_zhz_mol","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m008-0199","start":199,"end":201,"surface":"龍且","kind":"person","person_id":"sr6_5zr_1f3","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m008-0202","start":202,"end":204,"surface":"周殷","kind":"person","person_id":"hri_c2p_nht","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m008-0230","start":230,"end":232,"surface":"君臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-056-chen:m008-0238","start":238,"end":240,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m008-0266","start":266,"end":268,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m008-0281","start":281,"end":283,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"}],"chapter_id":"c-shiji-056-chen","book_id":"b-shiji-056","work_id":"w-shiji","source_id":"s-shiji-056-chen"},{"id":"c-shiji-056-chen:p009","text":"陳平既多以金縱反間於楚軍，宣言諸將鍾離眛等爲項王將，功多矣，然而終不得裂地而王，欲與漢爲一，以滅項氏而分王其地。項羽果意不信鍾離眛等。項王既疑之，使使至漢。漢王爲太牢具，舉進。見楚使，即詳驚曰：「吾以爲亞父使，乃項王使！」復持去，更以惡草具進楚使。楚使歸，具以報項王。項王果大疑亞父。亞父欲急攻下滎陽城，項王不信，不肯聽。亞父聞項王疑之，乃怒曰：「天下事大定矣，君王自爲之！願請骸骨歸！」歸未至彭城，疽發背而死。陳平乃夜出女子二千人滎陽城東門，楚因擊之，陳平乃與漢王從城西門夜出去。遂入關，收散兵復東。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m009-0000","start":0,"end":2,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0017","start":17,"end":20,"surface":"鍾離眛","kind":"person","person_id":"tb2_zhz_mol","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m009-0022","start":22,"end":24,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextua