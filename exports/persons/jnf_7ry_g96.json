on_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-045-han:m023-0026","start":26,"end":28,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p023","chapter_id":"c-shiji-045-han"},{"id":"c-shiji-045-han:m023-0096","start":96,"end":98,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p023","chapter_id":"c-shiji-045-han"},{"id":"c-shiji-045-han:m023-0396","start":396,"end":398,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p023","chapter_id":"c-shiji-045-han"},{"id":"c-shiji-045-han:m023-0401","start":401,"end":403,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p023","chapter_id":"c-shiji-045-han"},{"id":"c-shiji-045-han:m027-0023","start":23,"end":25,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p027","chapter_id":"c-shiji-045-han"},{"id":"c-shiji-045-han:m027-0071","start":71,"end":73,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p027","chapter_id":"c-shiji-045-han"},{"id":"c-shiji-045-han:m027-0275","start":275,"end":277,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p027","chapter_id":"c-shiji-045-han"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji045-069","person_id":"jnf_7ry_g96","surfaces":["公仲"],"scope":"same_chapter","chapter_ids":["c-shiji-045-han"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-045-han:p023","quote":"十六年，秦敗我修魚，虜得韓將鯁、申差於濁澤。韓氏急，公仲謂韓王曰：「與國非可恃也。今秦之欲伐楚久矣，王不如因張儀爲和於秦，賂以一名都，具甲，與之南伐楚，此以一易二之計也。」韓王曰：「善。」乃警公仲之行，將西購於秦。楚王聞之大恐，召陳軫告之。陳軫曰：「秦之欲伐楚久矣，今又得韓之名都一而具甲，秦韓并兵而伐楚，此秦所禱祀而求也。今已得之矣，楚國必伐矣。王聽臣爲之警四境之内，起師言救韓，命戰車滿道路，發信臣，多其車，重其幣，使信王之救己也。縱韓不能聽我，韓必德王也，必不爲鴈行以來，是秦韓不和也，兵雖至，楚不大病也。爲能聽我絶和於秦，秦必大怒，以厚怨韓。韓之南交楚，必輕秦；輕秦，其應秦必不敬：是因秦、韓之兵而免楚國之患也。」楚王曰：「善。」乃警四境之内，興師言救韓。命戰車滿道路，發信臣，多其車，重其幣。謂韓王曰：「不穀國雖小，已悉發之矣。願大國遂肆志於秦，不穀將以楚殉韓。」韓王聞之大説，乃止公仲之行。公仲曰：「不可。夫以實伐我者秦也，以虚名救我者楚也。王恃楚之虚名，而輕絶彊秦之敵，王必爲天下大笑。且楚韓非兄弟之國也，又非素約而謀伐秦也。已有伐形，因發兵言救韓，此必陳軫之謀也。且王已使人報於秦矣，今不行，是欺秦也。夫輕欺彊秦而信楚之謀臣，恐王必悔之。」韓王不聽，遂絶於秦。秦因大怒，益甲伐韓，大戰，楚救不至韓。十九年，大破我岸門。太子倉質於秦以和。"},{"paragraph_id":"c-shiji-045-han:p027","quote":"楚圍雍氏，韓求救於秦。秦未爲發，使公孫昧入韓。公仲曰：「子以秦爲且救韓乎？」對曰：「秦王之言曰『請道南鄭、藍田，出兵於楚以待公』，殆不合矣。」公仲曰：「子以爲果乎？」對曰：「秦王必祖張儀之故智。楚威王攻梁也，張儀謂秦王曰：『與楚攻魏，魏折而入於楚，韓固其與國也，是秦孤也。不如出兵以到之，魏楚大戰，秦取西河之外以歸。』今其狀陽言與韓，其實陰善楚。公待秦而到，必輕與楚戰。楚陰得秦之不用也，必易與公相支也。公戰而勝楚，遂與公乘楚，施三川而歸。公戰不勝楚，楚塞三川守之，公不能救也。竊爲公患之。司馬庚三反於郢，甘茂與昭魚遇於商於，其言收璽，實類有約也。」公仲恐，曰：「然則柰何？」曰：「公必先韓而後秦，先身而後張儀。公不如亟以國合於齊楚，齊楚必委國於公。公之所惡者張儀也，其實猶不無秦也。」於是楚解雍氏圍。"}],"rationale":"限本篇明示姓名、號稱、是為與連續敘事；兩位韓武子、韓趙簡子、韓魏文侯及不同時段未名楚王分開。原字及韓姬弒悼公、蟣蝨等疑點不訂正；裸王與回敘指代留待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-045-han:p023","text":"十六年，秦敗我修魚，虜得韓將鯁、申差於濁澤。韓氏急，公仲謂韓王曰：「與國非可恃也。今秦之欲伐楚久矣，王不如因張儀爲和於秦，賂以一名都，具甲，與之南伐楚，此以一易二之計也。」韓王曰：「善。」乃警公仲之行，將西購於秦。楚王聞之大恐，召陳軫告之。陳軫曰：「秦之欲伐楚久矣，今又得韓之名都一而具甲，秦韓并兵而伐楚，此秦所禱祀而求也。今已得之矣，楚國必伐矣。王聽臣爲之警四境之内，起師言救韓，命戰車滿道路，發信臣，多其車，重其幣，使信王之救己也。縱韓不能聽我，韓必德王也，必不爲鴈行以來，是秦韓不和也，兵雖至，楚不大病也。爲能聽我絶和於秦，秦必大怒，以厚怨韓。韓之南交楚，必輕秦；輕秦，其應秦必不敬：是因秦、韓之兵而免楚國之患也。」楚王曰：「善。」乃警四境之内，興師言救韓。命戰車滿道路，發信臣，多其車，重其幣。謂韓王曰：「不穀國雖小，已悉發之矣。願大國遂肆志於秦，不穀將以楚殉韓。」韓王聞之大説，乃止公仲之行。公仲曰：「不可。夫以實伐我者秦也，以虚名救我者楚也。王恃楚之虚名，而輕絶彊秦之敵，王必爲天下大笑。且楚韓非兄弟之國也，又非素約而謀伐秦也。已有伐形，因發兵言救韓，此必陳軫之謀也。且王已使人報於秦矣，今不行，是欺秦也。夫輕欺彊秦而信楚之謀臣，恐王必悔之。」韓王不聽，遂絶於秦。秦因大怒，益甲伐韓，大戰，楚救不至韓。十九年，大破我岸門。太子倉質於秦以和。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m023-0012","start":12,"end":14,"surface":"韓將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m023-0014","start":14,"end":15,"surface":"鯁","kind":"person","person_id":"631_ags_hxe","status":"contextual_provisional"},{"id":"c-shiji-045-han:m023-0016","start":16,"end":18,"surface":"申差","kind":"person","person_id":"r07_2q9_jzx","status":"contextual_provisional"},{"id":"c-shiji-045-han:m023-0026","start":26,"end":28,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional"},{"id":"c-shiji-045-han:m023-0029","start":29,"end":31,"surface":"韓王","kind":"person","person_id":"fea_it8_9n7_AAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-045-han:m023-0034","start":34,"end":36,"surface":"與國","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m023-0050","start":50,"end":51,"surface":"王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m023-0054","start":54,"end":56,"surface":"張儀","kind":"person","person_id":"zx8_mjk_l6m","status":"contextual_provisional"},{"id":"c-shiji-045-han:m023-0086","start":86,"end":88,"surface":"韓王","kind":"person","person_id":"fea_it8_9n7_AAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-045-han:m023-0096","start":96,"end":98,"surface":"公仲","kind":"person","person_id":"jnf_7ry_g96","status":"contextual_provisional"},{"id":"c-shiji-045-han:m023-0107","start":107,"end":109,"surface":"楚王","kind":"person","person_id":"6fo_fh6_ckq","status":"contextual_provisional"},{"id":"c-shiji-045-han:m023-0115","start