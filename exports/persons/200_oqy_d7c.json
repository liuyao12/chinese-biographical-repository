l"},{"id":"c-jinshu-066-taokan:p006:m0474","surface":"杜曾","start":474,"end":476,"person_id":"4vd_pg5_o8x","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p006:m0518","surface":"鄭攀","start":518,"end":520,"person_id":"200_oqy_d7c","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p006:m0529","surface":"硃伺","start":529,"end":531,"person_id":"zx9_13u_h08","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p006:m0544","surface":"張奕","start":544,"end":546,"person_id":"9u8_20z_zdq","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p006:m0601","surface":"硃伺","start":601,"end":603,"person_id":"zx9_13u_h08","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p006:m0611","surface":"張奕","start":611,"end":613,"person_id":"9u8_20z_zdq","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p006:m0623","surface":"王敦","start":623,"end":625,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-ws1527632"},{"id":"c-jinshu-066-taokan:p008","text":"韜將王貢精卒三千，出武陵江，誘五溪夷，以舟師斷官運，徑向武昌。侃使鄭攀及伏波將軍陶延夜趣巴陵，潛師掩其不備，大破之，斬千餘級，降萬餘口。貢遁還湘城。賊中離阻，杜弢遂疑張奕而殺之，眾情益懼，降者滋多。王貢復挑戰，侃遙謂之曰：「杜弢為益州吏，盜用庫錢，父死不奔喪。卿本佳人，何為隨之也？天下寧有白頭賊乎！」貢初橫腳馬上，侃言訖，貢斂容下腳，辭色甚順。侃知其可動，復令諭之，截髮為信，貢遂來降。而韜敗走。進克長沙，獲其將毛寶、高寶、梁堪而還。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":43,"last_line":43,"raw_start":5074,"raw_end":5294,"raw_character_offsets":[5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,51