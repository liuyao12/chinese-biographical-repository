171,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0176","start":176,"end":177,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0184","start":184,"end":188,"surface":"皇甫方回","kind":"person","person_id":"xe3_d7n_iej","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0203","start":203,"end":204,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0206","start":206,"end":207,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0220","start":220,"end":221,"surface":"母","kind":"person","person_id":"7ie_92j_3xk","status":"contextual_provisional"}],"source_position":{"first_line":39,"last_line":40,"revision_id":2180533,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"}],"sources":[{"chapter_id":"c-jinshu-066-taokan","work_id":"w-jinshu","book_id":"b-jinshu-066","source_id":"s-jinshu-066-taokan-ws1527632","source":{"title":"晉書卷六十六·陶侃","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1527632","url":"https://zh.wikisource.org/w/index.php?oldid=1527632","revision_id":1527632,"edition":"維基文庫固定修訂","accessed_on":"2026-11-22","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"晉書卷六十六·陶侃","text_scope":"complete_biography_unit","raw_path":"source-evidence/jin066-roll/ws1527632.wikitext","raw_file_sha256":"6cddc694d426567aad52b2183afd501d71adab778675ef7b91850801a4ced3aa","collation_witnesses":["source-evidence/jin066-roll/volume-reading.json"]}},{"chapter_id":"c-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","source":{"title":"《晉書》卷七十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王廙題自第27至43行全文，含中興賦疏與附敘子孫。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p001","source_lines":[27,28],"raw_quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","raw_quote_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","selected_text_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","begin_anchor":"王廙，字世將，丞相導從弟，而元","end_anchor":"。王敦啟為甯遠將軍、荊州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line029","source_lines":[29,29],"raw_quote":"及帝即位，廙奏《中興賦》，上疏曰：","raw_quote_sha256":"561a1b9943833462648e1a80c82c5b21545b67f168b95ab6fcd1b0b706c38cb3","begin_anchor":"及帝即位，廙奏《中興賦》，上","end_anchor":"位，廙奏《中興賦》，上疏曰："},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line031","source_lines":[31,31],"raw_quote":"{{quote|臣托備肺腑，幼蒙洪潤，愛自齠齔，至於弱冠，陛下之所撫育，恩侔于兄弟，義同于交友，思欲攀龍鱗附鳳翼者，有年矣，是以昔忝濮陽，棄官遠跡，扶持老母，攜將細弱，越長江歸陛下者，誠以道之所存，願託餘廕故也。天誘其願，遇陛下中興，當大明之盛，而守局遐外，不得奉瞻大禮，聞問之日，悲喜交集。昔司馬相如不得睹封禪之事，慷慨發憤，況臣情則骨肉，服膺聖化哉！","raw_quote_sha256":"9c582a92a469b985f92ae4aa27b0923109fe382bfd152e7e946d5908dd879e1b","begin_anchor":"臣托備肺腑，幼蒙洪潤，愛自齠","end_anchor":"，況臣情則骨肉，服膺聖化哉！"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line033","source_lines":[33,33],"raw_quote":"又臣昔嘗侍於先後，說陛下誕育之日，光明映室，白毫生於額之左，相者謂當王有四海。又臣以壬申歲見用為鄱陽內史，七月，四星聚於牽牛。又臣郡有枯樟更生。及臣後還京都，陛下見臣白兔，命臣作賦。時琅邪郡又獻甘露，陛下命臣嘗之。又驃騎將軍導向臣說晉陵有金鐸之瑞，郭璞雲必致中興。璞之爻筮，雖京房、管輅不過也。明天之歷數在陛下矣。","raw_quote_sha256":"bcbf3609e16aec908eb74b7bbfdb2b537098914823eeadaa9c2c2a2584c5535e","begin_anchor":"又臣昔嘗侍於先後，說陛下誕育","end_anchor":"不過也。明天之歷數在陛下矣。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line035","source_lines":[35,35],"raw_quote":"臣少好文學，志在史籍，而飄放遐外，嘗與桀寇為對。臣犬馬之年四十三矣，未能上報天施，而愆負屢彰。恐先朝露，填溝壑，令微情不得上達，謹竭其頑，獻《[[中興賦]]》一篇。雖未雖以宣揚盛美，亦是詩人嗟歎詠歌之義也。}}","raw_quote_sha256":"13767a378d657e26ab2c4bdf3c61b8cc9d445b23d36464fb24b1a9c385026fda","begin_anchor":"臣少好文學，志在史籍，而飄放","end_anchor":"美，亦是詩人嗟歎詠歌之義也。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:line037","source_lines":[37,37],"raw_quote":"文多不載。","raw_quote_sha256":"3cec09c8474251e248ac71bdc8dc6bf63032579c75e9016438e0480dd0821c80","begin_anchor":"文多不載。","end_anchor":"文多不載。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p002","source_lines":[39,40],"raw_quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","raw_quote_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","selected_text_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","begin_anchor":"初，王敦左遷陶侃，使廙代為荊州","end_anchor":"服闋，拜征虜將軍，進左衛將軍。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p003","source_lines":[41,42],"raw_quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","raw_quote_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","selected_text_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","begin_anchor":"及王敦構禍，帝遣廙喻敦，既不能","end_anchor":"近未易有也。坐相視盡，如何！」"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p004","source_lines":[43,44],"raw_quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","raw_quote_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","selected_text_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","begin_anchor":"子頤之嗣，仕至東海內史。頤之弟","end_anchor":"陵太守。子敬弘，義熙末為尚書。"}]},"raw_path":"source-evidence/jin079-lang-zhong-xuan-dai/external/jin076-ws2180533.wikitext","raw_file_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
