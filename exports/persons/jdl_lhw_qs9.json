s-shiji-040-chu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-040-chu:m067-0037","start":37,"end":39,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p067","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m067-0056","start":56,"end":58,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p067","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m067-0119","start":119,"end":121,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p067","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m067-0142","start":142,"end":144,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p067","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m070-0234","start":234,"end":236,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p070","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m070-0248","start":248,"end":250,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p070","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-040-chu:m071-0138","start":138,"end":140,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p071","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-065","person_id":"jdl_lhw_qs9","surfaces":["陳軫"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p067","quote":"六年，楚使柱國昭陽將兵而攻魏，破之於襄陵，得八邑。又移兵而攻齊，齊王患之。陳軫適爲秦使齊，齊王曰：「爲之柰何？」陳軫曰：「王勿憂，請令罷之。」卽往見昭陽軍中，曰：「願聞楚國之法，破軍殺將者何以貴之？」昭陽曰：「其官爲上柱國，封上爵執珪。」陳軫曰：「其有貴於此者乎？」昭陽曰：「令尹。」陳軫曰：「今君已爲令尹矣，此國冠之上。臣請得譬之。人有遺其舍人一卮酒者，舍人相謂曰：『數人飲此，不足以遍，請遂畫地爲蛇，蛇先成者獨飲之。』一人曰：『吾蛇先成。』舉酒而起，曰：『吾能爲之足。』及其爲之足，而後成人奪之酒而飲之，曰：『蛇固無足，今爲之足，是非蛇也。』今君相楚而攻魏，破軍殺將，功莫大焉，冠之上不可以加矣。今又移兵而攻齊，攻齊勝之，官爵不加於此；攻之不勝，身死爵奪，有毀於楚：此爲蛇爲足之説也。不若引兵而去以德齊，此持滿之術也。」昭陽曰：「善。」引兵而去。"},{"paragraph_id":"c-shiji-040-chu:p070","quote":"十六年，秦欲伐齊，而楚與齊從親，秦惠王患之，乃宣言張儀免相，使張儀南見楚王，謂楚王曰：「敝邑之王所甚説者無先大王，雖儀之所甚願爲門闌之廝者亦無先大王。敝邑之王所甚憎者無先齊王，雖儀之所甚憎者亦無先齊王。而大王和之，是以敝邑之王不得事王，而令儀亦不得爲門闌之廝也。王爲儀閉關而絶齊，今使使者從儀西取筆秦所分楚商於之地方六百里，如是則齊弱矣。是北弱齊，西德於秦，私商於以爲富，此一計而三利倶至也。」懷王大悅，乃置相璽於張儀，日與置酒，宣言「吾復得吾商於之地」。群臣皆賀，而陳軫獨弔。懷王曰：「何故？」陳軫對曰：「秦之所爲重王者，以王之有齊也。今地未可得而齊交先絶，是楚孤也。夫秦又何重孤國哉，必輕楚矣。且先出地而後絶齊，則秦計不爲。先絶齊而後責地，則必見欺於張儀。見欺於張儀，則王必怨之。怨之，是西起秦患，北絶齊交。西起秦患，北絶齊交，則兩國之兵必至。臣故弔。」楚王弗聽，因使一將軍西受封地。"},{"paragraph_id":"c-shiji-040-chu:p071","quote":"張儀至秦，詳醉墜車，稱病不出三月，地不可得。楚王曰：「儀以吾絶齊爲尚薄邪？」乃使勇士宋遺北辱齊王。齊王大怒，折楚符而合於秦。秦齊交合，張儀乃起朝，謂楚將軍曰：「子何不受地？從某至某，廣袤六里。」楚將軍曰：「臣之所以見命者六百里，不聞六里。」卽以歸報懷王。懷王大怒，興師將伐秦。陳軫又曰：「伐秦非計也。不如因賂之一名都，與之伐齊，是我亡於秦，取償於齊也，吾國尚可全。今王已絶於齊而責欺於秦，是吾合秦齊之交而來天下之兵也，國必大傷矣。」楚王不聽，遂絶和於秦，發兵西攻秦。秦亦發兵撃之。"}],"rationale":"本篇具名出使、合秦或說楚事件內暫接，未與他篇同名候選批量合併；短稱及未見名字仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p067","text":"六年，楚使柱國昭陽將兵而攻魏，破之於襄陵，得八邑。又移兵而攻齊，齊王患之。陳軫適爲秦使齊，齊王曰：「爲之柰何？」陳軫曰：「王勿憂，請令罷之。」卽往見昭陽軍中，曰：「願聞楚國之法，破軍殺將者何以貴之？」昭陽曰：「其官爲上柱國，封上爵執珪。」陳軫曰：「其有貴於此者乎？」昭陽曰：「令尹。」陳軫曰：「今君已爲令尹矣，此國冠之上。臣請得譬之。人有遺其舍人一卮酒者，舍人相謂曰：『數人飲此，不足以遍，請遂畫地爲蛇，蛇先成者獨飲之。』一人曰：『吾蛇先成。』舉酒而起，曰：『吾能爲之足。』及其爲之足，而後成人奪之酒而飲之，曰：『蛇固無足，今爲之足，是非蛇也。』今君相楚而攻魏，破軍殺將，功莫大焉，冠之上不可以加矣。今又移兵而攻齊，攻齊勝之，官爵不加於此；攻之不勝，身死爵奪，有毀於楚：此爲蛇爲足之説也。不若引兵而去以德齊，此持滿之術也。」昭陽曰：「善。」引兵而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m067-0007","start":7,"end":9,"surface":"昭陽","kind":"person","person_id":"69f_iaq_kzb","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0032","start":32,"end":34,"surface":"齊王","kind":"person","person_id":"uc7_nlh_gy2","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0037","start":37,"end":39,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0045","start":45,"end":47,"surface":"齊王","kind":"person","person_id":"uc7_nlh_gy2","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0056","start":56,"end":58,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0061","start":61,"end":62,"surface":"王","kind":"person","person_id":"uc7_nlh_gy2","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0074","start":74,"end":76,"surface":"昭陽","kind":"person","person_id":"69f_iaq_kzb","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0100","start":100,"end":102,"surface":"昭陽","kind":"person","person_id":"69f_iaq_kzb","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0119","start":119,"end":121,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0133","start":133,"end":135,"surface":"昭陽","kind":"person","person_id":"69f_iaq_kzb","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0142","start":142,"end":144,"surface":"陳軫","kind":"person","person_id":"jdl_lhw_qs9","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m067-0171","start":171,"end":173,"surface":"舍人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、寓言人物或未定指代，未補未見姓名、全體成員或親屬關係。"},{"id":"c-shiji-040-chu:m067-0178","start":178,"end":180,"surface":"舍人","kind":"unresolve