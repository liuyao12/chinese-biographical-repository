:[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-honggong-literal","person_id":"0r8_909_25c","surname":"弘","ming":"恭","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p012","person_mention_id":"c-jinshu-098-wangdun-comparison:p012:m0338","source_anchor":{"start":338,"end":340,"surface":"弘恭"},"quote":"劉隗前在門下，邪佞諂媚，譖毀忠良，疑惑聖聽，遂居權寵，撓亂天機，威福自由，有識杜口。大起事役，勞擾士庶，外托舉義，內自封植；奢僭過制，乃以黃散為參軍，晉魏已來，未有此比。傾盡帑藏，以自資奉；賦役不均，百姓嗟怨；免良人奴，自為惠澤。自可使其大田以充倉廩，今便割配，皆充隗軍。臣前求迎諸將妻息，聖恩聽許，而隗絕之，使三軍之士莫不怨憤。又徐州流人辛苦經載，家計始立，隗悉驅逼，以實己府。當陛下踐阼之始，投刺王官，本以非常之慶使豫蒙榮分。而更充征役，復依舊名，普取出客，從來久遠，經涉年載，或死亡滅絕，或自贖得免，或見放遣，或父兄時事身所不及，有所不得，輒罪本主，百姓哀憤，怨聲盈路。身欲北渡，以遠朝廷為名，而密知機要，潛行險慝，進人退士，高下任心，奸狡饕餮，未有隗比，雖無忌、宰嚭、弘恭、石顯未足為喻。是以遐邇憤慨，群後失望。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p012:m0338","start":338,"end":340,"surface":"弘恭","person_id":"0r8_909_25c","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p012","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p012","text":"劉隗前在門下，邪佞諂媚，譖毀忠良，疑惑聖聽，遂居權寵，撓亂天機，威福自由，有識杜口。大起事役，勞擾士庶，外托舉義，內自封植；奢僭過制，乃以黃散為參軍，晉魏已來，未有此比。傾盡帑藏，以自資奉；賦役不均，百姓嗟怨；免良人奴，自為惠澤。自可使其大田以充倉廩，今便割配，皆充隗軍。臣前求迎諸將妻息，聖恩聽許，而隗絕之，使三軍之士莫不怨憤。又徐州流人辛苦經載，家計始立，隗悉驅逼，以實己府。當陛下踐阼之始，投刺王官，本以非常之慶使豫蒙榮分。而更充征役，復依舊名，普取出客，從來久遠，經涉年載，或死亡滅絕，或自贖得免，或見放遣，或父兄時事身所不及，有所不得，輒罪本主，百姓哀憤，怨聲盈路。身欲北渡，以遠朝廷為名，而密知機要，潛行險慝，進人退士，高下任心，奸狡饕餮，未有隗比，雖無忌、宰嚭、弘恭、石顯未足為喻。是以遐邇憤慨，群後失望。","text_laye