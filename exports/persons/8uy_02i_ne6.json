textual_provisional"},{"id":"c-shiji-086-cike:m029-0404","start":404,"end":406,"surface":"太子","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0423","start":423,"end":425,"surface":"荊卿","kind":"person","person_id":"02z_7va_g33","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0433","start":433,"end":435,"surface":"太子","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m029-0450","start":450,"end":454,"surface":"車騎美女","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引古短稱或擬議結盟對象未定，保留未解，不補姓名。"},{"id":"c-shiji-086-cike:m029-0455","start":455,"end":457,"surface":"荊軻","kind":"person","person_id":"02z_7va_g33","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p030","text":"久之，荊軻未有行意。秦將王翦破趙，虜趙王，盡收入其地，進兵北略地至燕南界。太子丹恐懼，乃請荊軻曰：「秦兵旦暮渡易水，則雖欲長侍足下，豈可得哉！」荊軻曰：「微太子言，臣願謁之。今行而毋信，則秦未可親也。夫樊將軍，秦王購之金千斤，邑萬家。誠得樊將軍首與燕督亢之地圖，奉獻秦王，秦王必説見臣，臣乃得有以報。」太子曰：「樊將軍窮困來歸丹，丹不忍以己之私而傷長者之意，願足下更慮之！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m030-0003","start":3,"end":5,"surface":"荊軻","kind":"person","person_id":"02z_7va_g33","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0010","start":10,"end":14,"surface":"秦將王翦","kind":"person","person_id":"8uy_02i_ne6","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0018","start":18,"end":20,"surface":"趙王","kind":"person","person_id":"5yi_qwl_awr","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0037","start":37,"end":40,"surface":"太子丹","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0045","start":45,"end":47,"surface":"荊軻","kind":"person","person_id":"02z_7va_g33","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0072","start":72,"end":74,"surface":"荊軻","kind":"person","person_id":"02z_7va_g33","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0078","start":78,"end":80,"surface":"太子","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0101","start":101,"end":104,"surface":"樊將軍","kind":"person","person_id":"ye9_ftb_i0q","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0105","start":105,"end":107,"surface":"秦王","kind":"person","person_id":"fdc_ofl_z5f","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0119","start":119,"end":122,"surface":"樊將軍","kind":"person","person_id":"ye9_ftb_i0q","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0133","start":133,"end":135,"surface":"秦王","kind":"person","person_id":"fdc_ofl_z5f","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0136","start":136,"end":138,"surface":"秦王","kind":"person","person_id":"fdc_ofl_z5f","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0151","start":151,"end":153,"surface":"太子","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0156","start":156,"end":159,"surface":"樊將軍","kind":"person","person_id":"ye9_ftb_i0q","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0163","start":163,"end":164,"surface":"丹","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m030-0165","start":165,"end":166,"surface":"丹","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p035","text":"於是秦王大怒，益發兵詣趙，詔王翦軍以伐燕。十月而拔薊城。燕王喜、太子丹等盡率其精兵東保於遼東。秦將李信追撃燕王急，代王嘉乃遺燕王喜書曰：「秦所以尤追燕急者，以太子丹故也。今王誠殺丹獻之秦王，秦王必解，而社稷幸得血食。」其後李信追丹，丹匿衍水中，燕王乃使使斬太子丹，欲獻之秦。秦復進兵攻之。後五年，秦卒滅燕，虜燕王喜。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m035-0002","start":2,"end":4,"surface":"秦王","kind":"person","person_id":"fdc_ofl_z5f","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0014","start":14,"end":16,"surface":"王翦","kind":"person","person_id":"8uy_02i_ne6","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0028","start":28,"end":31,"surface":"燕王喜","kind":"person","person_id":"hvx_dq8_la2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0032","start":32,"end":35,"surface":"太子丹","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0039","start":39,"end":41,"surface":"精兵","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名人物或待核稱呼保留未解；未補姓名、性別或親屬名。"},{"id":"c-shiji-086-cike:m035-0047","start":47,"end":51,"surface":"秦將李信","kind":"person","person_id":"y8v_od8_wtk","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0053","start":53,"end":55,"surface":"燕王","kind":"person","person_id":"hvx_dq8_la2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0057","start":57,"end":60,"surface":"代王嘉","kind":"person","person_id":"l1x_fpj_80w","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0062","start":62,"end":65,"surface":"燕王喜","kind":"person","person_id":"hvx_dq8_la2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0079","start":79,"end":82,"surface":"太子丹","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0085","start":85,"end":87,"surface":"今王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名人物或待核稱呼保留未解；未補姓名、性別或親屬名。"},{"id":"c-shiji-086-cike:m035-0089","start":89,"end":90,"surface":"丹","kind":"person","person_id":"v89_58y_qe2","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0092","start":92,"end":94,"surface":"秦王","kind":"person","person_id":"fdc_ofl_z5f","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m035-0095","start":95,"end":9