002-0466","start":466,"end":469,"surface":"今天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0476","start":476,"end":480,"surface":"韓王孫嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m002-0484","start":484,"end":487,"surface":"李延年","kind":"person","person_id":"qhp_lk5_t1e_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-125-ningxing","book_id":"b-shiji-125","work_id":"w-shiji","source_id":"s-shiji125-ningxing"},{"id":"c-shiji-125-ningxing:p003","text":"嫣者，弓高侯孽孫也。今上為膠東王時，嫣與上學書相愛。及上為太子，愈益親嫣。嫣善騎射，善佞。上即位，欲事伐匈奴，而嫣先習胡兵，以故益尊貴，官至上大夫，賞賜擬於鄧通。時嫣常與上臥起。江都王入朝，有詔得從入獵上林中。天子車駕蹕道未行，而先使嫣乘副車，從數十百騎，騖馳視獸。江都王望見，以為天子，辟從者，伏謁道傍。嫣驅不見。既過，江都王怒，為皇太后泣曰：「請得歸國入宿衛，比韓嫣。」太后由此嗛嫣。嫣侍上，出入永巷不禁，以姦聞皇太后。皇太后怒，使使賜嫣死。上為謝，終不能得，嫣遂死。而案道侯韓說，其弟也，亦佞幸。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-125-ningxing:m003-0000","start":0,"end":1,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0003","start":3,"end":6,"surface":"弓高侯","kind":"person","person_id":"l9e_fbr_36a_*AB","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0010","start":10,"end":12,"surface":"今上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0018","start":18,"end":19,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0020","start":20,"end":21,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0027","start":27,"end":28,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0035","start":35,"end":36,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"con