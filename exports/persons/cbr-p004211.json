{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004211","identity_policy":"contextual_provisional","person_ids":["cbr-p004211"],"persons":[{"id":"cbr-p004211","label":"呂禮（穰侯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"呂禮","mention_ids":["c-shiji-072-rang:m004-0002","c-shiji-072-rang:m005-0054"]},{"surface":"禮","mention_ids":["c-shiji-072-rang:m004-0005"]}],"evidence":[{"mention_id":"c-shiji-072-rang:m004-0002","chapter_id":"c-shiji-072-rang","paragraph_id":"c-shiji-072-rang:p004","quote":"呂禮"},{"mention_id":"c-shiji-072-rang:m004-0005","chapter_id":"c-shiji-072-rang","paragraph_id":"c-shiji-072-rang:p004","quote":"禮"},{"mention_id":"c-shiji-072-rang:m005-0054","chapter_id":"c-shiji-072-rang","paragraph_id":"c-shiji-072-rang:p005","quote":"呂禮"}]}],"mentions":[{"id":"c-shiji-072-rang:m004-0002","start":2,"end":4,"surface":"呂禮","kind":"person","person_id":"cbr-p004211","status":"contextual_provisional","paragraph_id":"c-shiji-072-rang:p004","chapter_id":"c-shiji-072-rang"},{"id":"c-shiji-072-rang:m004-0005","start":5,"end":6,"surface":"禮","kind":"person","person_id":"cbr-p004211","status":"contextual_provisional","paragraph_id":"c-shiji-072-rang:p004","chapter_id":"c-shiji-072-rang"},{"id":"c-shiji-072-rang:m005-0054","start":54,"end":56,"surface":"呂禮","kind":"person","person_id":"cbr-p004211","status":"contextual_provisional","paragraph_id":"c-shiji-072-rang:p005","chapter_id":"c-shiji-072-rang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji072-016","person_id":"cbr-p004211","scope":"same_chapter","chapter_ids":["c-shiji-072-rang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依第4至5段明示姓名與局部回指，呂禮禮、壽燭燭及白起武安君暫接；壽燭原字不校改。穰侯復相、免相與封爵時長原文保留，人物同指不自動確證各任相日期，秦齊稱帝的國稱主語待另核稱號證據。","surfaces":["呂禮","禮"],"evidence":[{"paragraph_id":"c-shiji-072-rang:p004","quote":"欲誅呂禮，禮出奔齊。昭王十四年，魏冉舉白起，使代向壽將而攻韓、魏，敗之伊闕，斬首二十四萬，虜魏將公孫喜。明年，又取楚之宛、葉。魏冉謝病免相，以客卿壽燭為相。其明年，燭免，復相冉，乃封魏冉於穰，復益封陶，號曰穰侯。"},{"paragraph_id":"c-shiji-072-rang:p005","quote":"穰侯封四歲，為秦將攻魏。魏獻河東方四百里。拔魏之河內，取城大小六十餘。昭王十九年，秦稱西帝，齊稱東帝。月餘，呂禮來，而齊、秦各復歸帝為王。魏冉復相秦，六歲而免。免二歲，復相秦。四歲，而使白起拔楚之郢，秦置南郡。乃封白起為武安君。白起者，穰侯之所任舉也，相善。於是穰侯之富，富於王室。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-072-rang:p004","text":"欲誅呂禮，禮出奔齊。昭王十四年，魏冉舉白起，使代向壽將而攻韓、魏，敗之伊闕，斬首二十四萬，虜魏將公孫喜。明年，又取楚之宛、葉。魏冉謝病免相，以客卿壽燭為相。其明年，燭免，復相冉，乃封魏冉於穰，復益封陶，號曰穰侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-072-rang:m004-0002","start":2,"end":4,"surface":"呂禮","kind":"person","person_id":"cbr-p004211","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0005","start":5,"end":6,"surface":"禮","kind":"person","person_id":"cbr-p004211","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0010","start":10,"end":12,"surface":"昭王","kind":"person","person_id":"cbr-p004198","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0016","start":16,"end":18,"surface":"魏冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0019","start":19,"end":21,"surface":"白起","kind":"person","person_id":"cbr-p004212","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0024","start":24,"end":26,"surface":"向壽","kind":"person","person_id":"cbr-p004213","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0046","start":46,"end":51,"surface":"魏將公孫喜","kind":"person","person_id":"cbr-p004214","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0063","start":63,"end":65,"surface":"魏冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0071","start":71,"end":75,"surface":"客卿壽燭","kind":"person","person_id":"cbr-p004215","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0082","start":82,"end":83,"surface":"燭","kind":"person","person_id":"cbr-p004215","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0087","start":87,"end":88,"surface":"冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0091","start":91,"end":93,"surface":"魏冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0103","start":103,"end":105,"surface":"穰侯","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"}],"chapter_id":"c-shiji-072-rang","book_id":"b-shiji-072","work_id":"w-shiji","source_id":"s-shiji-072-rang"},{"id":"c-shiji-072-rang:p005","text":"穰侯封四歲，為秦將攻魏。魏獻河東方四百里。拔魏之河內，取城大小六十餘。昭王十九年，秦稱西帝，齊稱東帝。月餘，呂禮來，而齊、秦各復歸帝為王。魏冉復相秦，六歲而免。免二歲，復相秦。四歲，而使白起拔楚之郢，秦置南郡。乃封白起為武安君。白起者，穰侯之所任舉也，相善。於是穰侯之富，富於王室。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-072-rang:m005-0000","start":0,"end":2,"surface":"穰侯","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m005-0035","start":35,"end":37,"surface":"昭王","kind":"person","person_id":"cbr-p004198","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m005-0041","start":41,"end":45,"surface":"秦稱西帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"國稱主語、複數帝王或王室，未據單名自動接全部王稱；需另建立稱號與來源事件證據。"},{"id":"c-shiji-072-rang:m005-0046","start":46,"end":50,"surface":"齊稱東帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"國稱主語、複數帝王或王室，未據單名自動接全部王稱；需另建立稱號與來源事件證據。"},{"id":"c-shiji-072-rang:m005-0054","start":54,"end":56,"surface":"呂禮","kind":"person","person_id":"cbr-p004211","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m005-0059","start":59,"end":68,"surface":"齊、秦各復歸帝為王","kind":"unresolved","person_id":null,"status":"unresolved","note":"國稱主語、複數帝王或王室，未據單名自動接全部王稱；需另建立稱號與來源事件證據。"},{"id":"c-shiji-072-rang:m005-0069","start":69,"end":71,"surface":"魏冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"