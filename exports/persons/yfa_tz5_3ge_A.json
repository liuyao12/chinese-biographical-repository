廟歌辭，韶之制也。文集行於世。子曄，尚書駕部外兵郎，臨賀太守。","subject_person_mention_id":"c-songshu-060-wangshaozhi:p004:m0227","object_person_mention_id":"c-songshu-060-wangshaozhi:p004:m0000","relationship_anchor":{"paragraph_id":"c-songshu-060-wangshaozhi:p004","start":226,"end":228,"surface":"子曄"},"source_term":"子曄"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"本段列屬已具名，與同書及對讀本互核。"}}],"source_mention_summary":[{"source_id":"s-songshu-060-wangshaozhi-ws1996694","work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangshaozhi","raw_mention_count":1,"mention_ids":["c-songshu-060-wangshaozhi:p004:m0227"],"paragraph_ids":["c-songshu-060-wangshaozhi:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-songshu-060-wangshaozhi:p004:m0227","mention_ids":["c-songshu-060-wangshaozhi:p004:m0227"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-songshu-060-wangshaozhi-ws1996694"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-song060-wangshaozhi-88-227-0","subject_person_id":"yfa_tz5_3ge_A","object_person_id":"yfa_tz5_3ge","predicate":"father","status":"source_attested","qualifiers":{"source_term":"子曄","lineage":"paternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangshaozhi","source_id":"s-songshu-060-wangshaoz