weishou-058-yangbo-yangkan:p002:m0017"}],"interpretation_note":"原明母；不由外姑補王氏父母。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-weishu-weishou-058-yangbo-yangkan:p002:m0017","start":17,"end":19,"surface":"王氏","kind":"person","person_id":"r47_vug_gx5","status":"contextual_provisional","interpretation_note":"母王氏明示，文明太后之外姑原詞保留；不造王氏父名或外姑中介。","paragraph_id":"c-weishu-weishou-058-yangbo-yangkan:p002","chapter_id":"c-weishu-weishou-058-yangbo-yangkan"}],"relations":[{"id":"a-weishu058-yang-005","subject_person_id":"fum_370_iq6_AAAA","predicate":"mother","object_person_id":"r47_vug_gx5","status":"source_attested","qualifiers":{"source_term":"母王氏"},"evidence":[{"work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangbo-ws2087998","chapter_id":"c-weishu-weishou-058-yangbo-yangkan","paragraph_id":"c-weishu-weishou-058-yangbo-yangkan:p002","quote":"播本字元休，太和中，高祖賜改焉。母王氏，文明太后之外姑。播少修整，奉養盡禮。擢為中散，累遷給事，領中起部曹。以外親，優賜亟加，前後萬計。進北部給事中。詔播巡行北邊，高祖親送及戶，戒以軍略。未幾，除龍驤將軍、員外常侍，轉衞尉少卿，常侍如故。與陽平王頤等出漠北擊蠕蠕，大獲而還。高祖嘉其勳，賜奴婢十口。遷武衞將軍，復擊蠕蠕，至居然山而還。","subject_person_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p002:m0000","object_person_mention_id":"c-weishu-weishou-058-yangbo-yangkan:p002:m0017"}],"interpretation_note":"原明母；不由外姑補王氏父母。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-weishu-weishou-058-yangbo-yangkan:p002","text":"播本字元休，太和中，高祖賜改焉。母王氏，文明太后之外姑。播少修整，奉養盡禮。擢為中散，累遷給事，領中起部曹。以外親，優賜亟加，前後萬計。進北部給事中。詔播巡行北邊，高祖親送及戶，戒以軍略。未幾，除龍驤將軍、員外常侍，轉衞尉少卿，常侍如故。與陽平王頤等出漠北擊蠕蠕，大獲而還。高祖嘉其勳，賜奴婢十口。遷武衞將軍，復擊蠕蠕，至居然山而還。","text_layer":"recei