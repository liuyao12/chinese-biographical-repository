5-filial-complete:p027:m0332"],"kind":"paragraph"}],"mention_count":9,"duplicate_mention_count":0,"paragraph_occurrence_count":9,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"9處獨立位置，9個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-055-filial-complete-ws1545598"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-055-filial-complete:source_review27-0","kind":"source_review","person_id":"mab_e0c_ml2","source_quote":"　　朱謙之字處光，吳郡錢唐人也。父昭之，以學解稱於鄉里。謙之年數歲，所生母亡，昭之假葬田側，爲族人朱幼方燎火所焚。同產姉密語之，謙之雖小，便哀戚如持喪。年長不婚娶。永明中，手刃殺幼方，詣獄自繫。縣令申靈勗表上，別駕孔稚珪、兼記室劉璡、司徒左西掾張融牋與刺史豫章王曰：「禮開報仇之典，以申孝義之情；法斷相殺之條，以表權時之制。謙之揮刃斬冤，旣申私禮；繫頸就死，又明公法。今仍殺之，則成當世罪人；宥而活之，即爲盛朝孝子。殺一罪人，未足弘憲；活一孝子，實廣風德。張緒陸澄，是其鄉舊，應具來由。融等與謙之竝不相識，區區短見，深有恨然。」豫章王言之世祖，時吳郡太守王慈、太常張緒、尚書陸澄竝表論其事，世祖嘉其義，慮相復報，乃遣謙之隨曹虎西行。將發，幼方子惲於津陽門伺殺謙之，謙之之兄選之又刺殺惲，有司以聞。世祖曰：「此皆是義事，不可問。」悉赦之。吳興沈顗聞而歎曰：「弟死於孝，兄殉於義。孝友之節，萃此一門。」選之字處林，有志節，著辯相論。幼時顧歡見而異之，以女妻焉。官至江夏王參軍。","reading":"朱謙之、朱選之與朱幼方、惲有各自行為。選之尾附字、著述、婚配、官終獨立。卷四十五使者同名尚待籍貫與官次互證。","note":"朱謙之、朱選之與朱幼方、惲有各自行為。選之尾附字、著述、婚配、官終獨立。卷四十五使者同名尚待籍貫與官次互證。","paragraph_id":"c-nanqishu-055-filial-complete:p027","start_codepoint":0,"end_codepoint":436,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"},{"id":"c-nanqishu-055-filial-complete:variant_review27-399","kind":"variant_review","person_id":"mab_e0c_ml2","source_quote":"選之字處林","reading":"自字、著述、婚姻至官終的獨立生平在尾句；公案中刺惲與沈顗評語仍置兄弟共案的語境。","note":"自字、著述、婚姻至官終的獨立生平在尾句；公案中刺惲與沈顗評語仍置兄弟共案的語境。","paragraph_id":"c-nanqishu-055-filial-complete:p027","start_codepoint":399,"end_codepoint":404,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi055-zhuqianzhi-father","subject_person_id":"mab_e0c_ml2","object_person_id":"5kp_hvw_rko","predicate":"father","qualifiers":{"source_term":"父昭之"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p027","quote":"　　朱謙之字處光，吳郡錢唐人也。父昭之，以學解稱於鄉里。謙之年數歲，所生母亡，昭之假葬田側，爲族人朱幼方燎火所焚。同產姉密語之，謙之雖小，便哀戚如持喪。年長不婚娶。永明中，手刃殺幼方，詣獄自繫。縣令申靈勗表上，別駕孔稚珪、兼記室劉璡、司徒左西掾張融牋與刺史豫章王曰：「禮開報仇之典，以申孝義之情；法斷相殺之條，以表權時之制。謙之揮刃斬冤，旣申私禮；繫頸就死，又明公法。今仍殺之，則成當世罪人；宥而活之，即爲盛朝孝子。殺一罪人，未足弘憲；活一孝子，實廣風德。張緒陸澄，是其鄉舊，應具來由。融等與謙之竝不相識，區區短見，深有恨然。」豫章王言之世祖，時吳郡太守王慈、太常張緒、尚書陸澄竝表論其事，世祖嘉其義，慮相復報，乃遣謙之隨曹虎西行。將發，幼方子惲於津陽門伺殺謙之，謙之之兄選之又刺殺惲，有司以聞。世祖曰：「此皆是義事，不可問。」悉赦之。吳興沈顗聞而歎曰：「弟死於孝，兄殉於義。孝友之節，萃此一門。」選之字處林，有志節，著辯相論。幼時顧歡見而異之，以女妻焉。官至江夏王參軍。","subject_person_mention_id":"c-nanqishu-055-filial-complete:p027:m0002","object_person_mention_id":"c-nanqishu-055-filial-complete:p027:m0017"}],"status":"source_attested","interpretation_note":"昭之以學解稱。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-qi055-zhuqianzhi-xiong","subject_person_id":"mab_e0c_ml2","object_person_id":"pab_sjt_ii2","predicate":"brother","qualifiers":{"source_term":"謙之之兄選之"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p027","quote":"　　朱謙之字處光，吳郡錢唐人也。父昭之，以學解稱於鄉里。謙之年數歲，所生母亡，昭之假葬田側，爲族人朱幼方燎火所焚。同產姉密語之，謙之雖小，便哀戚如持喪。年長不婚娶。永明中，手刃殺幼方，詣獄自繫。縣令申靈勗表上，別駕孔稚珪、兼記室劉璡、司徒左西掾張融牋與刺史豫章王曰：「禮開報仇之典，以申孝義之情；法斷相殺之條，以表權時之制。謙之揮刃斬冤，旣申私禮；繫頸就死，又明公法。今仍殺之，則成當世罪人；宥而活之，即爲盛朝孝子。殺一罪人，未足弘憲；活一孝子，實廣風德。張緒陸澄，是其鄉舊，應具來由。融等與謙之竝不相識，區區短見，深有恨然。」豫章王言之世祖，時吳郡太守王慈、太常張緒、尚書陸澄竝表論其事，世祖嘉其義，慮