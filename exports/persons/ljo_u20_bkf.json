erson_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0297","start":297,"end":299,"surface":"到滿","kind":"person","person_id":"rwt_f3r_d8n","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0320","start":320,"end":323,"surface":"蜀相壯","kind":"person","person_id":"kqe_x0t_s25","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0324","start":324,"end":326,"surface":"蜀侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p069","text":"昭襄王元年，嚴君疾為相。甘茂出之魏。二年，彗星見。庶長壯與大臣、諸侯、公子為逆，皆誅，及惠文后皆不得良死。悼武王后出歸魏。三年，王冠。與楚王會黃棘，與楚上庸。四年，取蒲阪。彗星見。五年，魏王來朝應亭，復與魏蒲阪。六年，蜀侯煇反，司馬錯定蜀。庶長奐伐楚，斬首二萬。涇陽君質於齊。日食，晝晦。七年，拔新城。摢裏子卒。八年，使將軍羋戎攻楚，取新市。齊使章子，魏使公孫喜，韓使暴鳶共攻楚方城，取唐眛。趙破中山，其君亡，竟死齊。魏公子勁、韓公子長為諸侯。九年，孟嘗君薛文來相秦。奐攻楚，取八城，殺其將景快。十年，楚懷王入朝秦，秦留之。薛文以金受免。樓緩為丞相。十一年，齊、韓、魏、趙、宋、中山五國共攻秦，至鹽氏而還。秦與韓、魏河北及封陵以和。彗星見。楚懷王走之趙，趙不受，還之秦，即死，歸葬。十二年，樓緩免，穰侯魏冉為相。予楚粟五萬石。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m069-0000","start":0,"end":3,"surface":"昭襄王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0006","start":6,"end":9,"surface":"嚴君疾","kind":"person","person_id":"m6b_39t_lpp","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0012","start":12,"end":14,"surface":"甘茂","kind":"person","person_id":"8im_m5e_cpy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0025","start":25,"end":28,"surface":"庶長壯","kind":"person","person_id":"zul_9qs_fhz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0044","start":44,"end":47,"surface":"惠文后","kind":"person","person_id":"mq6_9sx_400","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0053","start":53,"end":57,"surface":"悼武王后","kind":"person","person_id":"cij_zvk_7rn","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0068","start":68,"end":70,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m069-0093","start":93,"end":95,"surface":"魏王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m069-0109","start":109,"end":112,"surface":"蜀侯煇","kind":"person","person_id":"cmh_x83_hjk","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0114","start":114,"end":117,"surface":"司馬錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0120","start":120,"end":123,"surface":"庶長奐","kind":"person","person_id":"u4n_65h_uqv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0131","start":131,"end":134,"surface":"涇陽君","kind":"person","person_id":"zdv_6wm_e1u","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0151","start":151,"end":154,"surface":"摢裏子","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0160","start":160,"end":164,"surface":"將軍羋戎","kind":"person","person_id":"4tv_nhj_oxt","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0173","start":173,"end":175,"surface":"章子","kind":"person","person_id":"e55_tuo_wbc","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0178","start":178,"end":181,"surface":"公孫喜","kind":"person","person_id":"bl6_mow_siu","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0184","start":184,"end":186,"surface":"暴鳶","kind":"person","person_id":"8u9_ugq_ise","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0201","start":201,"end":203,"surface":"其君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m069-0209","start":209,"end":213,"surface":"魏公子勁","kind":"person","person_id":"jvz_4m9_60q","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0214","start":214,"end":218,"surface":"韓公子長","kind":"person","person_id":"ei3_w5i_7ai","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0225","start":225,"end":230,"surface":"孟嘗君薛文","kind":"person","person_id":"7pl_s0g_rkh","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0234","start":234,"end":235,"surface":"奐","kind":"person","person_id":"u4n_65h_uqv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0245","start":245,"end":247,"surface":"景快","kind":"person","person_id":"4wh_yve_8ul","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0251","start":251,"end":254,"surface":"楚懷王","kind":"person","person_id":"c2w_s7g_en0","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0262","start":262,"end":264,"surface":"薛文","kind":"person","person_id":"7pl_s0g_rkh","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0269","start":269,"end":271,"surface":"樓緩","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0320","start":320,"end":323,"surface":"楚懷王","kind":"person","person_id":"c2w_s7g_en0","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0345","start":345,"end":347,"surface":"樓緩","kind":"person","person_id":"p41_n3z_dlq","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m069-0349","start":349,"end":353,"surface":"穰侯魏冉","kind":"person","person_id":"r2f_mtq_05s","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p070","text":"十三年，向壽伐韓，取武始。左更白起攻新城。五大夫禮出亡奔魏。任鄙為漢中守。十四年，左更白起攻韓、魏於伊闕，斬首二十四萬，虜公孫喜，拔五城。十五年，大良造白起攻魏，取垣，復予之。攻楚，取宛。十六年，左更錯取軹及鄧。冉免，封公子市宛，公子悝鄧，魏冉陶，為諸侯。十七年，城陽君入朝，及東周君來朝。秦以垣為蒲阪、皮氏。王之宜陽。十八年，錯攻垣、河雍，決橋取之。十九年，王為西帝，齊為東帝，皆復去之。呂禮來自歸。齊破宋，宋王在魏，死溫。任鄙卒。二十年，王之漢中，又之上郡、北河。二十一年，錯攻魏河內。魏獻安邑，秦出其人，募徙河東賜爵，赦罪人遷之。涇陽君封宛。二十二年，蒙武伐齊。河東為九縣。與楚王會宛。與趙王會中陽。二十三年，尉斯離與三晉、燕伐齊，破之濟西。王與魏王會宜陽，與韓王會新城。二十四年，與楚王會鄢，又會穰。秦取魏安城，至大梁，燕、趙救之，秦軍去。魏冉免相。二十五年，拔趙二城。與韓王會新城，與魏王會新明邑。二十六年，赦罪人遷之穰。侯冉復相。二十七年，錯攻楚。赦罪人遷之南陽。白起攻趙，取代光狼城。又使司馬錯發隴西，因蜀攻楚黔中，拔之。二十八年，大良造白起攻楚，取鄢、鄧，赦罪人遷之。二十九年，大良造白起攻楚，取郢為南郡，楚王走。周君來。王與楚王會襄陵。白起為武安君。三十年，蜀守若伐楚，取巫郡，及江南為黔中郡。三十一年，白起伐魏，取兩城。楚人反我江南。三十二年，相穰侯攻魏，至大梁，破暴鳶，斬首四萬，鳶走，魏入三縣請和。三十三年，客卿胡傷攻魏卷、蔡陽、長社，取之。擊芒卯華陽，破之，斬首十五萬。魏入南陽以和。三十四年，秦與魏、韓上庸地為一郡，南陽免臣遷居之。三十五年，佐韓、魏、楚伐燕。初置南陽郡。三十六年，客卿灶攻齊，取剛、壽，予穰侯。三十八年，中更胡傷攻趙閼與，不能取。四十年，悼太子死魏，歸葬芷陽。四十一年夏，攻魏，取邢丘、懷。四十二年，安國君為太子。十月，宣太后薨，葬芷陽酈山。九月，穰侯出之陶。四十三年，武安君白起攻韓，拔九城，斬首五萬。四十四年，攻韓南郡，取之。四十五年，五大夫賁攻韓，取十城。葉陽君悝出之國，未至而死。四十七年，秦攻韓上黨，上黨降趙，秦因攻趙，趙發兵擊秦，相距。秦使武安君白起擊，大破趙於長平，四十餘萬盡殺之。四十八年十月，韓獻垣雍。秦軍分為三軍。武安君歸。王齕將伐趙皮牢，拔之。司馬梗北定太原，盡有韓上黨。正月，兵罷，復守上黨。其十月，五大夫陵攻趙邯鄲。四十九年正月，益發卒佐陵。陵戰不善，免，王齕代將。其十月，將軍張唐攻魏，為蔡尉捐弗守，還斬之。五十年十月，武安君白起有罪，為士伍，遷陰密。張唐攻鄭，拔之。十二月，益發卒軍汾城旁。武安君白起有罪，死。齕攻邯鄲，不拔，去，還奔汾軍。二月餘攻晉軍，斬首六千，晉楚流死河二萬人。攻汾城，即從唐拔寧新中，寧新中更名安陽。初作河橋。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m070-0004","start":4,"end":6,"surface":"向壽","kind":"person","person_id":"k21_yot_5tp","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-0013","start":13,"end":17,"surface":"左更白起","kind":"person","person_id":"2bk_fz6_icl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-0021","start":21,"end":25,"surface":"五大夫禮","kind":"person","person_id":"h4c_ia5_qoe","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-0030","start":30,"end":32,"surface":"任鄙","kind":"person","person_id":"zqy_a21_8d3","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-0041","start":41,"end":45,"surface":"左更白起","kind":"person","person_id":"2bk_fz6_icl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-0061","start":61,"end":64,"surface":"公孫喜","kind":"person","person_id":"bl6_mow_siu","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-0073","start":73,"end":78,"surface":"大良造白起","kind":"person","person_id":"2bk_fz6_icl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-0100","start":100,"end":101,"surface":"錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional"},{"