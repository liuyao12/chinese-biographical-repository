d":"c-shiji-005-qin:m070-0985","start":985,"end":989,"surface":"五大夫陵","kind":"person","person_id":"ug9_gi9_fvb","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1005","start":1005,"end":1006,"surface":"陵","kind":"person","person_id":"ug9_gi9_fvb","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1007","start":1007,"end":1008,"surface":"陵","kind":"person","person_id":"ug9_gi9_fvb","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1014","start":1014,"end":1016,"surface":"王齕","kind":"person","person_id":"yms_yqu_5yi","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1023","start":1023,"end":1027,"surface":"將軍張唐","kind":"person","person_id":"qfu_p4d_ebc","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1031","start":1031,"end":1034,"surface":"蔡尉捐","kind":"person","person_id":"mw2_sla_iy2","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1047","start":1047,"end":1052,"surface":"武安君白起","kind":"person","person_id":"2bk_fz6_icl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1063","start":1063,"end":1065,"surface":"張唐","kind":"person","person_id":"qfu_p4d_ebc","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1083","start":1083,"end":1088,"surface":"武安君白起","kind":"person","person_id":"2bk_fz6_icl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1093","start":1093,"end":1094,"surface":"齕","kind":"person","person_id":"yms_yqu_5yi","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1135","start":1135,"end":1136,"surface":"唐","kind":"person","person_id":"qfu_p4d_ebc","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-070-zhang:p006","text":"苴蜀相攻擊，各來告急於秦。秦惠王欲發兵以伐蜀，以為道險狹難至，而韓又來侵秦，秦惠王欲先伐韓，後伐蜀，恐不利，欲先伐蜀，恐韓襲秦之敝。猶豫未能決。司馬錯與張儀爭論於惠王之前，司馬錯欲伐蜀，張儀曰：「不如伐韓。」王曰：「請聞其說。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m006-0013","start":13,"end":16,"surface":"秦惠王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m006-0038","start":38,"end":41,"surface":"秦惠王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m006-0072","start":72,"end":75,"surface":"司馬錯","kind":"person","person_id":"ljo_u20_bkf","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m006-0076","start":76,"end":78,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m006-0081","start":81,"end":83,"surface":"惠王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m006-0086","start":86,"end":89,"surface":"司馬錯","kind":"person","person_id":"ljo_u20_bkf","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m006-0093","start":93,"end":95,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m006-0104","start":104,"end":105,"surface":"王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"},{"id":"c-shiji-070-zhang:p008","text":"司馬錯曰：「不然。臣聞之，欲富國者務廣其地，欲彊兵者務富其民，欲王者務博其德，三資者備而王隨之矣。今王地小民貧，故臣願先從事於易。夫蜀，西僻之國也，而戎翟之長也，有桀紂之亂。以秦攻之，譬如使豺狼逐群羊。得其地足以廣國，取其財足以富民繕兵，不傷眾而彼已服焉。拔一國而天下不以為暴，利盡西海而天下不以為貪，是我一舉而名實附也，而又有禁暴止亂之名。今攻韓，劫天子，惡名也，而未必利也，又有不義之名，而攻天下所不欲，危矣。臣請謁其故：周，天下之宗室也；齊，韓之與國也。周自知失九鼎，韓自知亡三川，將二國并力合謀，以因乎齊、趙而求解乎楚、魏，以鼎與楚，以地與魏，王弗能止也。此臣之所謂危也。不如伐蜀完。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m008-0000","start":0,"end":3,"surface":"司馬錯","kind":"person","person_id":"ljo_u20_bkf","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m008-0029","start":29,"end":30,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體或未定指代，身份待覆核；使人不未經證據全接舍人。"},{"id":"c-shiji-070-zhang:m008-0050","start":50,"end":51,"surface":"王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m008-0053","start":53,"end":54,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體或未定指代，身份待覆核；使人不未經證據全接舍人。"},{"id":"c-shiji-070-zhang:m008-0082","start":82,"end":83,"surface":"桀","kind":"person","person_id":"e9o_aty_rnt","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m008-0083","start":83,"end":84,"surface":"紂","kind":"person","person_id":"i0l_qkb_6wb","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m008-0115","start":115,"end":116,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體或未定指代，身份待覆核；使人不未經證據全接舍人。"},{"id":"c-shiji-070-zhang:m008-0176","start":176,"end":178,"surface":"天子","kind":"person","person_id":"d8s_9jm_qyc","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m008-0276","start":276,"end":277,"surface":"王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"}],"chapter_id":"c-shiji-070-zhang","book_id":"b-shiji-070","work_id":"w-shiji","source_id":"s-shiji-070-zhang"}],"sources":[{"chapter_id":"c-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","source_id":"s-shiji-005-qin","source":{"title":"史記／卷005","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷005","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷005&oldid=8744286","revision_id":8744286,"accessed_on":"2026-10-09","extent":"77段數位正文；排除註釋版導覽與註號，見證行內校勘符號暫原樣保留。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铚":"銍","绖":"絰","龁":"齕"},"note":"第9段編者重複標記另存，其餘行內校勘符號仍待逐處分離；不稱已核讀底本。","editorial_readings":[{"paragraph_id":"c-shiji-005-qin:p009","witness_form":"（世父）世父","body_reading":"世父","note":"數位見證重複的括