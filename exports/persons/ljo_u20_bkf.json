pter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m070-0100","start":100,"end":101,"surface":"錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p070","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m070-0164","start":164,"end":165,"surface":"錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p070","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m070-0239","start":239,"end":240,"surface":"錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p070","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m070-0426","start":426,"end":427,"surface":"錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p070","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-005-qin:m070-0451","start":451,"end":454,"surface":"司馬錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p070","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-070-zhang:m006-0072","start":72,"end":75,"surface":"司馬錯","kind":"person","person_id":"ljo_u20_bkf","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p006","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m006-0086","start":86,"end":89,"surface":"司馬錯","kind":"person","person_id":"ljo_u20_bkf","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p006","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m008-0000","start":0,"end":3,"surface":"司馬錯","kind":"person","person_id":"ljo_u20_bkf","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p008","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-008","person_id":"ljo_u20_bkf","surfaces":["司馬錯"],"scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-070-zhang:p006","quote":"苴蜀相攻擊，各來告急於秦。秦惠王欲發兵以伐蜀，以為道險狹難至，而韓又來侵秦，秦惠王欲先伐韓，後伐蜀，恐不利，欲先伐蜀，恐韓襲秦之敝。猶豫未能決。司馬錯與張儀爭論於惠王之前，司馬錯欲伐蜀，張儀曰：「不如伐韓。」王曰：「請聞其說。」"},{"paragraph_id":"c-shiji-070-zhang:p008","quote":"司馬錯曰：「不然。臣聞之，欲富國者務廣其地，欲彊兵者務富其民，欲王者務博其德，三資者備而王隨之矣。今王地小民貧，故臣願先從事於易。夫蜀，西僻之國也，而戎翟之長也，有桀紂之亂。以秦攻之，譬如使豺狼逐群羊。得其地足以廣國，取其財足以富民繕兵，不傷眾而彼已服焉。拔一國而天下不以為暴，利盡西海而天下不以為貪，是我一舉而名實附也，而又有禁暴止亂之名。今攻韓，劫天子，惡名也，而未必利也，又有不義之名，而攻天下所不欲，危矣。臣請謁其故：周，天下之宗室也；齊，韓之與國也。周自知失九鼎，韓自知亡三川，將二國并力合謀，以因乎齊、趙而求解乎楚、魏，以鼎與楚，以地與魏，王弗能止也。此臣之所謂危也。不如伐蜀完。」"}],"rationale":"依前10段明示姓名與局部敘事暫接；張儀短名不取普通詞，楚相失璧與後文檄告暫接，未名妻與蘇秦舍人不補姓名。秦惠王王稱不取王業、欲王或王隨之。周天子、魏王與趙王不按年代記憶補名；桀紂為引古，鬼谷傳承未確證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji070-cuo","person_ids":["rec_qtq_9ve","ljo_u20_bkf"],"canonical_person_id":"rec_qtq_9ve","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-070-zhang"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p066","quote":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","mention_ids":["c-shiji-005-qin:m066-0119"]},{"chapter_id":"c-shiji-070-zhang","source_id":"s-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p006","quote":"苴蜀相攻擊，各來告急於秦。秦惠王欲發兵以伐蜀，以為道險狹難至，而韓又來侵秦，秦惠王欲先伐韓，後伐蜀，恐不利，欲先伐蜀，恐韓襲秦之敝。猶豫未能決。司馬錯與張儀爭論於惠王之前，司馬錯欲伐蜀，張儀曰：「不如伐韓。」王曰：「請聞其說。」","mention_ids":["c-shiji-070-zhang:m006-0072","c-shiji-070-zhang:m006-0086"]}],"rationale":"秦本紀載司馬錯伐蜀，本篇詳與張儀爭伐蜀伐韓，姓名、國別與伐蜀事件相配。 各篇原文與已發ID保留；同書篇章不當獨立見證。同指不確證年代、任職、人物傳說或所有敘事，版本仍待覆核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-005-qin:p066","text":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m066-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0027","start":27,"end":32,"surface":"韓、魏太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m066-0035","start":35,"end":37,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0052","start":52,"end":54,"surface":"樂池","kind":"person","person_id":"h40_rtd_6ut","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0075","start":75,"end":78,"surface":"庶長疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0086","start":86,"end":88,"surface":"申差","kind":"person","person_id":"icp_nrn_7pl","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0090","start":90,"end":94,"surface":"趙公子渴","kind":"person","person_id":"gy6_lx6_eb2","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0095","start":95,"end":99,"surface":"韓太子奐","kind":"person","person_id":"ux0_nvd_s8f","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0110","start":110,"end":112,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0119","start":119,"end":122,"surface":"司馬錯","kind":"person","person_id":"rec_qtq_9ve","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0139","start":139,"end":143,"surface":"韓