059-liang-son-zong:p001:m0002","paragraph_id":"c-jinshu-059-liang-son-zong:p001","chapter_id":"c-jinshu-059-liang-son-zong","quote":"延祚"},{"mention_id":"c-jinshu-059-liang-son-zong:p001:m0073","paragraph_id":"c-jinshu-059-liang-son-zong:p001","chapter_id":"c-jinshu-059-liang-son-zong","quote":"宗"},{"mention_id":"c-jinshu-059-liang-son-zong:p002:m0000","paragraph_id":"c-jinshu-059-liang-son-zong:p002","chapter_id":"c-jinshu-059-liang-son-zong","quote":"宗"},{"mention_id":"c-jinshu-059-liang-son-zong:p002:m0032","paragraph_id":"c-jinshu-059-liang-son-zong:p002","chapter_id":"c-jinshu-059-liang-son-zong","quote":"宗"},{"mention_id":"c-jinshu-059-liang-son-zong:p002:m0045","paragraph_id":"c-jinshu-059-liang-son-zong:p002","chapter_id":"c-jinshu-059-liang-son-zong","quote":"宗"},{"mention_id":"c-jinshu-059-liang-son-zong:p002:m0081","paragraph_id":"c-jinshu-059-liang-son-zong:p002","chapter_id":"c-jinshu-059-liang-son-zong","quote":"宗"},{"mention_id":"c-jinshu-059-liang-son-zong:p002:m0084","paragraph_id":"c-jinshu-059-liang-son-zong:p002","chapter_id":"c-jinshu-059-liang-son-zong","quote":"宗"},{"mention_id":"c-jinshu-059-liang-son-zong:p002:m0104","paragraph_id":"c-jinshu-059-liang-son-zong:p002","chapter_id":"c-jinshu-059-liang-son-zong","quote":"宗"},{"mention_id":"c-jinshu-059-liang-son-zong:p002:m0120","paragraph_id":"c-jinshu-059-liang-son-zong:p002","chapter_id":"c-jinshu-059-liang-son-zong","quote":"宗"},{"mention_id":"c-jinshu-059-prince-jiong:p017:m0060","paragraph_id":"c-jinshu-059-prince-jiong:p017","chapter_id":"c-jinshu-059-prince-jiong","quote":"南頓王宗"}],"identity_note":"卷059固定見證本地人物；未按同名跨史合併。","family_path":{"connection":"father","parent_person_id":"dkn_ge4_286_AAAAC","generation_distance":1,"source_assertion_id":"a-jinshu059-list-father-宗","status":"contextual_provisional","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line018","quote":"汝南文成王亮，字子翼，宣帝第四子也。少清警有才用，仕魏為散騎侍郎、萬歲亭侯，拜東中郎將，進封廣陽鄉侯。討諸葛誕于壽春，失利，免官。頃之，拜左將軍，加散騎常侍、假節，出監豫州諸軍事。五等建，改封祁陽伯，轉鎮西將軍。武帝踐阼，封扶風郡王，邑萬戶，置騎司馬，增參軍掾屬，持節、都督關中雍、涼諸軍事。會秦州刺史胡烈為羌虜所害，亮遣將軍劉旂、騎督敬琰赴救，不進，坐是貶為平西將軍。旂當斬，亮與軍司曹冏上言，節度之咎由亮而出，乞丐旂死。詔曰：「高平困急，計城中及旂足以相拔，就不能徑至，尚當深進。今奔突有投，而坐視覆敗，故加旂大戮。今若罪不在旂，當有所在。」有司又奏免亮官，削爵土。詔惟免官。頃之，拜撫軍將軍。是歲，吳將步闡來降，假亮節都督諸軍事以納之。尋加侍中之服。","object_person_mention_id":"c-jinshu-059-liang-yang:line018:m0000"},{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line020","quote":"咸甯初，以扶風池陽四千一百戶為太妃伏氏湯沐邑，置家令丞僕，後改食南郡枝江。太妃嘗有小疾，祓于洛水，亮兄弟三人侍從，並持節鼓吹，震耀洛濱。武帝登陵雲臺望見，曰：「伏妃可謂富貴矣。」其年進號衛將軍，加侍中。時宗室殷盛，無相統攝，乃以亮為宗師，本官如故，使訓導觀察，有不遵禮法，小者正以義方，大者隨事聞奏。"},{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line022","quote":"三年，徙封汝南，出為鎮南大將軍、都督豫州軍事，開府、假節，之國，給追鋒車、皁輪犢車，錢五十萬。頃之，征亮為侍中、撫軍大將軍，領後軍將軍，統冠軍、步兵、射聲、長水等營，給兵五百人，騎百匹。遷太尉、錄尚書事、領太子太傅，侍中如故。"},{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line024","quote":"及武帝寢疾，為楊駿所排，乃以亮為侍中、大司馬、假黃鉞、大都督、督豫州諸軍事，出鎮許昌，加軒懸之樂，六佾之舞。封子羕為西陽公。未發，帝大漸，詔留亮委以後事。楊駿聞之，從中書監華暠索詔視，遂不還。帝崩，亮懼駿疑己，辭疾不入，于大司馬門外敘哀而已，表求過葬。駿欲討亮，亮知之，問計于廷尉何勖。勖曰：「今朝廷皆歸心於公，公何不討人而懼為人所討！」或說亮率所領入廢駿，亮不能用，夜馳赴許昌，故得免。及駿誅，詔曰：「大司馬、汝南王亮體道沖粹，通識政理，宣翼之績，顯於本朝，《二南》之風，流于方夏，將憑遠猷，以康王化。其以亮為太宰、錄尚書事，入朝不趨，劍履上殿，增掾屬十人，給千兵百騎，與太保衛瓘對掌朝政。」亮論賞誅楊駿之功過差，欲以苟悅眾心，由是失望。"},{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line026","quote":"楚王瑋有勳而好立威，亮憚之，欲奪其兵權。瑋甚憾，乃承賈后旨，誣亮與瓘有廢立之謀，矯詔遣其長史公孫宏與積弩將軍李肇夜以兵圍之。帳下督李龍白外有變，請距之，亮不聽。俄然楚兵登牆而呼，亮驚曰：「吾無二心，何至於是！若有詔書，其可見乎？」宏等不許，促兵攻之。長史劉准謂亮曰：「觀此必是奸謀，府中俊乂如林，猶可盡力距戰。」又弗聽，遂為肇所執，而歎曰：「我之忠心，可破示天下也，如何無道，枉殺不辜！」是時大熱，兵人坐亮于車下，時人憐之，為之交扇。將及日中，無敢害者。瑋出令曰：「能斬亮者，賞布千匹。」遂為亂兵所害，投於北門之壁，鬢髮耳鼻皆悉毀焉。及瑋誅，追復亮爵位，給東園溫明秘器，朝服一襲，錢三百萬，布絹三百匹，喪葬之禮如安平獻王孚故事，廟設軒懸之樂。"},{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line029","quote":"有五子：粹、矩、羕、宗、熙。","subject_person_mention_id":"c-jinshu-059-liang-yang:line029:m0010"}],"interpretation_note":"完整亮單元及有五子名單先通過原生模型驗證，才配置亮支ID；名單次序未轉出生排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}}],"source_mention_summary":[{"source_id":"s-jinshu-059-liang-son-zong-ws2650517","work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-son-zong","raw_mention_count":1,"mention_ids":["c-jinshu-059-liang-son-zong:p002:m0155"],"paragraph_ids":["c-jinshu-059-liang-son-zong:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-059-liang-son-zong:p002:m0155","mention_ids":["c-jinshu-059-liang-son-zong:p002:m0155"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-059-liang-son-zong-ws2650517"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin059-volume-zong-chao-father","subject_person_id":"2t9_g8d_m3p","object_person_id":"dkn_ge4_286_AAAACD","predicate":"father","qualifiers":{"source_term":"三子：綽、超、演"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-son-zong","source_id":"s-jinshu-059-liang-son-zong-ws2650517","paragraph_id":"c-jinshu-059-liang-son-zong:p002","quote":"宗與王導、庾亮志趣不同，連結輕俠，以為腹心，導、亮並以為言。帝以宗戚屬，每容之。及帝疾篤，宗、胤密謀為亂，亮排闥入，升御床，流涕言之，帝始悟。轉為驃騎將軍。胤為大宗正。宗遂怨望形於辭色。咸和初，御史中丞鐘雅劾宗謀反，庾亮使右衛將軍趙胤收之。宗以兵距戰，為胤所殺，貶其族為馬氏，徙妻子于晉安，既而原之。三子：綽、超、演，廢為庶人。咸康中，復其屬籍。綽為奉車都尉、奉朝請。","subject_person_mention_id":"c-jinshu-059-liang-son-zong:p002:m0155","object_person_mention_id":"c-jinshu-059-liang-son-zong:p002:m0000"}],"status":"source_attested","interpretation_note":"此超為宗子。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-liang-son-zong:p002:m0155","surface":"超","start":155,"end":156,"person_id":"2t9_g8d_m3p","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-liang-son-zong:p002","chapter_id":"c-jinshu-059-liang-son-zong"}],"relations":[{"id":"a-jin059-volume-zong-chao-father","subject_person_id":"2t9_g8d_m3p","object_person_id":"dkn_ge4_286_AAAACD","predicate":"father","qualifiers":{"source_term":"三子：綽、超、演"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-son-zong","source_id":"s-jinshu-059-liang-son-zong-ws2650517","paragraph_id":"c-jinshu-059-liang-son-zong:p002","quote":"宗與王導、庾亮志趣不同，連結輕俠，以為腹心，導、亮並以為言。帝以宗戚屬，每容之。及帝疾篤，宗、胤密謀為亂，亮排闥入，升御床，流涕言之，帝始悟。轉為驃騎將軍。胤為大宗正。宗遂怨望形於辭色。咸和初，御史中丞鐘雅劾宗謀反，庾亮使右衛將軍趙胤收之。宗以兵距戰，為胤所殺，貶其族為馬氏，徙妻子于晉安，既而原之。三子：綽、超、演，廢為庶人。咸康中，復其屬籍。綽為奉車都尉、奉朝請。","subject_person_mention_id":"c-jinshu-059-liang-son-zong:p002:m0155","object_person_mention_id":"c-jinshu-059-liang-son-zong:p002:m0000"}],"status":"source_attested","interpretation_note":"此超為宗子。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"ident