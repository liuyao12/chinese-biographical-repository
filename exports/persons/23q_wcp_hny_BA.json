sages":[{"id":"c-beishi-044-cuidaogu:p005","text":"初，道固之在客邸，與薛安都、畢眾敬鄰館，時以公集相見。本既同由武達，頗結寮舊。時安都志已衰朽，於道固疏略，而眾敬每盡殷勤。道固謂劉休賓、房法壽曰：「古人云：「非我族類，其心必異」，安都視人，殊自蕭索，畢固依依也。」景徽字文睿，卒于平州刺史，諡曰定。子休纂襲爵。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-beishi-044-cuidaogu:p005:m0002","start":2,"end":4,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p005:m0010","start":10,"end":13,"surface":"薛安都","kind":"person","person_id":"u3k_51j_4ul_A","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p005:m0014","start":14,"end":17,"surface":"畢眾敬","kind":"person","person_id":"cuc_acf_nlb","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p005:m0040","start":40,"end":42,"surface":"安都","kind":"person","person_id":"u3k_51j_4ul_A","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p005:m0048","start":48,"end":50,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p005:m0054","start":54,"end":56,"surface":"眾敬","kind":"person","person_id":"cuc_acf_nlb","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p005:m0061","start":61,"end":63,"surface":"道固","kind":"person","person_id":"23q_wcp_hny","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p005:m0064","start":64,"end":67,"surface":"劉休賓","kind":"person","person_id":"hxp_qbf_0mu","identification_status":"contextual_provisional","interpretation_note":"據本段發言、親屬或任事語境辨識。"},{"id":"c-beishi-044-cuidaogu:p005:m0068","start":68,"end":71,"