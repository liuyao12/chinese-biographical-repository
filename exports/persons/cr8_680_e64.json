tness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi059-yanglingzhen-abu","subject_person_id":"3xh_uf9_fy2","object_person_id":"cr8_680_e64","predicate":"brother","qualifiers":{"source_term":"二弟婆羅、阿卜珍"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p031","quote":"四年，偽南梁州刺史楊靈珍與二弟婆羅、阿卜珍率部曲三萬餘人舉城歸附，送母及子雙健、阿皮於南鄭為質。梁州刺史陰廣宗遣中兵參軍（猷）王思考率眾救援，為虜所得，婆羅、阿卜珍戰死。靈珍攻集始於武興，殺其二弟集同、集眾。集始窮急，請降。以靈珍為持節、督隴右軍事、征虜將軍、北梁州刺史、仇池公、武都王。永元二年，復以集始為使持節、督秦雍二州軍事、輔國將軍、平羌校尉、北秦州刺史。靈珍後為虜所殺。","subject_person_mention_id":"c-nanqishu-059-western-polities-complete:p031:m0009","object_person_mention_id":"c-nanqishu-059-western-polities-complete:p031:m0018"}],"status":"source_attested","interpretation_note":"下文別有兩子。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi059-abuzhen-death","person_id":"cr8_680_e64","event_type":"death","source_term":"戰死","source_anchor":{"paragraph_id":"c-nanqishu-059-western-polities-complete:p031","start":82,"end":84,"surface":"戰死"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p031","quote":"四年，偽南梁州刺史楊靈珍與二弟婆羅、阿卜珍率部曲