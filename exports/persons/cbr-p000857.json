{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000857","identity_policy":"contextual_provisional","person_ids":["cbr-p000857"],"persons":[{"id":"cbr-p000857","label":"友所愛姬（未名）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"他姬","mention_ids":["c-shiji-009-lvhou:m011-0025"]}],"evidence":[{"mention_id":"c-shiji-009-lvhou:m011-0025","chapter_id":"c-shiji-009-lvhou","paragraph_id":"c-shiji-009-lvhou:p011","quote":"他姬"}]}],"mentions":[{"id":"c-shiji-009-lvhou:m011-0025","start":25,"end":27,"surface":"他姬","kind":"person","person_id":"cbr-p000857","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p011","chapter_id":"c-shiji-009-lvhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p011","text":"七年正月，太后召趙王友。友以諸呂女為受后，弗愛，愛他姬，諸呂女妒，怒去，讒之於太后，誣以罪過，曰：「呂氏安得王！太后百歲後，吾必擊之」。太后怒，以故召趙王。趙王至，置邸不見，令衛圍守之，弗與食。其群臣或竊饋，輒捕論之，趙王餓，乃歌曰：「諸呂用事兮劉氏危，迫脅王侯兮彊授我妃。我妃既妒兮誣我以惡，讒女亂國兮上曾不寤。我無忠臣兮何故棄國？自決中野兮蒼天舉直！于嗟不可悔兮寧蚤自財。為王而餓死兮誰者憐之！呂氏絕理兮讬天報仇。」丁丑，趙王幽死，以民禮葬之長安民冢次。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m011-0005","start":5,"end":7,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0008","start":8,"end":11,"surface":"趙王友","kind":"person","person_id":"cbr-p000808","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0012","start":12,"end":13,"surface":"友","kind":"person","person_id":"cbr-p000808","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0014","start":14,"end":17,"surface":"諸呂女","kind":"person","person_id":"cbr-p000856","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0025","start":25,"end":27,"surface":"他姬","kind":"person","person_id":"cbr-p000857","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0028","start":28,"end":31,"surface":"諸呂女","kind":"person","person_id":"cbr-p000856","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0039","start":39,"end":41,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0050","start":50,"end":52,"surface":"呂氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m011-0056","start":56,"end":58,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0068","start":68,"end":70,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0075","start":75,"end":77,"surface":"趙王","kind":"person","person_id":"cbr-p000808","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0078","start":78,"end":80,"surface":"趙王","kind":"person","person_id":"cbr-p000808","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0109","start":109,"end":111,"surface":"趙王","kind":"person","person_id":"cbr-p000808","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m011-0123","start":123,"end":125,"surface":"劉氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m011-0199","start":199,"end":201,"surface":"呂氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m011-0213","start":213,"end":215,"surface":"趙王","kind":"person","person_id":"cbr-p000808","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"}],"sources":[{"chapter_id":"c-shiji-009-lvhou","work_id":"w-shiji","book_id":"b-shiji-009","source_id":"s-shiji-009-lvhou","source":{"title":"史記／卷009","provider":"維基文庫","url":"https://zh.w