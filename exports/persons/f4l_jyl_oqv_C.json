:312,"surface":"韓千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0341","start":341,"end":343,"surface":"千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0353","start":353,"end":356,"surface":"漢使者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m009-0377","start":377,"end":379,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0382","start":382,"end":385,"surface":"韓千秋","kind":"person","person_id":"8xz_mlj_r3c","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0400","start":400,"end":402,"surface":"延年","kind":"person","person_id":"8xz_mlj_r3c_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0407","start":407,"end":409,"surface":"樛樂","kind":"person","person_id":"tz9_dhl_ifo","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0413","start":413,"end":416,"surface":"王太后","kind":"person","person_id":"3q4_zsp_jwy","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0425","start":425,"end":427,"surface":"廣德","kind":"person","person_id":"tz9_dhl_ifo_A","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0438","start":438,"end":440,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-113-nanyue:m009-0454","start":454,"end":456,"surface":"呂嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m009-0457","start":457,"end":459,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"}],"chapter_id":"c-shiji-113-nanyue","book_id":"b-shiji-113","work_id":"w-shiji","source_id":"s-shiji113-nanyue"},{"id":"c-shiji-113-nanyue:p011","text":"元鼎六年冬，樓船將軍將精卒先陷尋陜，破石門，得越船粟，因推而前，挫越鋒，以數萬人待伏波。伏波將軍將罪人，道遠，會期後，與樓船會乃有千餘人，遂俱進。樓船居前，至番禺。建德、嘉皆城守。樓船自擇便處，居東南面；伏波居西北面。會暮，樓船攻敗越人，縱火燒城。越素聞伏波名，日暮，不知其兵多少。伏波乃為營，遣使者招降者，賜印，復縱令相招。樓船力攻燒敵，反驅而入伏波營中。犁旦，城中皆降伏波。呂嘉、建德已夜與其屬數百人亡入海，以船西去。伏波又因問所得降者貴人，以知呂嘉所之，遣人追之。以其故校尉司馬蘇弘得建德，封為海常侯；越郎都稽得嘉，封為臨蔡侯。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-113-nanyue:m011-0006","start":6,"end":10,"surface":"樓船將軍","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0041","start":41,"end":43,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0044","start":44,"end":48,"surface":"伏波將軍","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0060","start":60,"end":62,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0073","start":73,"end":75,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0082","start":82,"end":84,"surface":"建德","kind":"person","person_id":"f4l_jyl_oqv_C","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0085","start":85,"end":86,"surface":"嘉","kind":"person","person_id":"jfm_184_2yb","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0090","start":90,"end":92,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0102","start":102,"end":104,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0112","start":112,"end":114,"surface":"樓船","kind":"person","person_id":"jk8_8gt_vmi","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0127","start":127,"end":129,"surface":"伏波","kind":"person","person_id":"vib_10x_51n","status":"contextual_provisional"},{"id":"c-shiji-113-nanyue:m011-0141","start":141,"end":143,"surface":"伏波","kind":"person","person_id":"vib_10x_51