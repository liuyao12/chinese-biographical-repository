ue:p006","quote":"嬰齊"},{"mention_id":"c-shiji-113-nanyue:m007-0017","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p007","quote":"嬰齊"},{"mention_id":"c-shiji-113-nanyue:m007-0034","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p007","quote":"嬰齊"},{"mention_id":"c-shiji-113-nanyue:m009-0293","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"明王"},{"mention_id":"c-shiji-113-nanyue:m013-0047","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p013","quote":"嬰齊"}]},{"id":"f4l_jyl_oqv_C","label":"建德","status":"active","historicity":"historical_tradition","aliases":[{"surface":"南越王","mention_ids":["c-shiji-110-xiongnu:m045-0074"]},{"surface":"建德","mention_ids":["c-shiji-113-nanyue:m009-0303","c-shiji-113-nanyue:m009-0457","c-shiji-113-nanyue:m011-0082","c-shiji-113-nanyue:m011-0192","c-shiji-113-nanyue:m011-0245"]}],"evidence":[{"mention_id":"c-shiji-110-xiongnu:m045-0074","chapter_id":"c-shiji-110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p045","quote":"南越王"},{"mention_id":"c-shiji-113-nanyue:m009-0303","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"建德"},{"mention_id":"c-shiji-113-nanyue:m009-0457","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"建德"},{"mention_id":"c-shiji-113-nanyue:m011-0082","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p011","quote":"建德"},{"mention_id":"c-shiji-113-nanyue:m011-0192","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p011","quote":"建德"},{"mention_id":"c-shiji-113-nanyue:m011-0245","chapter_id":"c-shiji-113-nanyue","paragraph_id":"c-shiji-113-nanyue:p011","quote":"建德"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"天子聞嘉不聽王，王、王太后弱孤不能制，使者怯無決。又以為王、王太后已附漢，獨呂嘉為亂，不足以興兵，欲使莊參以二千人往使。參曰：「以好往，數人足矣；以武往，二千人無足以為也。」辭不可，天子罷參也。郟壯士故濟北相韓千秋奮曰：「以區區之越，又有王、太后應，獨相呂嘉為害，願得勇士二百人，必斬嘉以報。」於是天子遣千秋與王太后弟樛樂將二千人往，入越境。呂嘉等乃遂反，下令國中曰：「王年少。太後，中國人也，又與使者亂，專欲內屬，盡持先王寶器入獻天子以自媚，多從人，行至長安，虜賣以為僮仆。取自脫一時之利，無顧趙氏社稷，為萬世慮計之意。」乃與其弟將卒攻殺王、太后及漢使者。遣人告蒼梧秦王及其諸郡縣，立明王長男越妻子術陽侯建德為王。而韓千秋兵入，破數小邑。其後越直開道給食，未至番禺四十里，越以兵擊千秋等，遂滅之。使人函封漢使者節置塞上，好為謾辭謝罪，發兵守要害處。於是天子曰：「韓千秋雖無成功，亦軍鋒之冠。」封其子延年為成安侯。樛樂，其姊為王太后，首願屬漢，封其子廣德為龍亢侯。乃下赦曰：「天子微，諸侯力政，譏臣不討賊。今呂嘉、建德等反，自立晏如，令罪人及江淮以南樓船十萬師往討之。」"}],"source_assertion_id":"a-shiji113-007","interpretation_note":"分支字元不表排行；只接明示父系來源，闕代不造父親。","reviewer":"Codex（AI 代理）","parent_person_id":"f4l_jyl_oqv"}}],"source_mention_summary":[{"source_id":"s-shiji113-nanyue","work_id":"w-shiji","book_id":"b-shiji-113","chapter_id":"c-shiji-113-nanyue","mention_count":5,"mention_ids":["c-shiji-113-nanyue:m009-0303","c-shiji-113-nanyue:m009-0457","c-shiji-113-nanyue:m011-0082","c-shiji-113-nanyue:m011-0192","c-shiji-113-nanyue:m011-0245"],"paragraph_ids":["c-shiji-113-nanyue:p009","c-shiji-113-nanyue:p011"],"table_cell_ids":[],"passage_count":2},{"source_id":"s-shiji110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","chapter_id":"c-shiji-110-xiongnu","mention_count":1,"mention_ids":["c-shiji-110-xiongnu:m045-0074"],"paragraph_ids":["c-shiji-110-xiongnu:p045"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji113-nanyue"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji113-007","subject_person_id":"f4l_jyl_oqv_C","predicate":"father","object_person_id":"f4l_jyl_oqv","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p009","quote":"天子聞嘉不聽王，王、王太后弱孤不能制，使者怯無決。又以為王、王太后已附漢，獨呂嘉為亂，不足