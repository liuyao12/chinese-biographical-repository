:396,"end":398,"surface":"周昌","kind":"person","person_id":"gfr_55l_72s","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p007","text":"既行久之，高祖持御史大夫印弄之，曰：「誰可以為御史大夫者？」孰視趙堯，曰：「無以易堯。」遂拜趙堯為御史大夫。堯亦前有軍功食邑，及以御史大夫從擊陳豨有功，封為江邑侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m007-0005","start":5,"end":7,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0032","start":32,"end":34,"surface":"趙堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0041","start":41,"end":42,"surface":"堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0046","start":46,"end":48,"surface":"趙堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0054","start":54,"end":55,"surface":"堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m007-0071","start":71,"end":73,"surface":"陳豨","kind":"person","person_id":"1xx_s1v_svn","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p009","text":"後五歲，高后聞御史大夫江邑侯趙堯高祖時定趙王如意之畫，乃抵堯罪，以廣阿侯任敖為御史大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m009-0004","start":4,"end":6,"surface":"高后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m009-0014","start":14,"end":16,"surface":"趙堯","kind":"person","person_id":"afb_ahe_sqp","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m009-0016","start":16,"end":18,"surface":"高祖","kind":"person","person_id