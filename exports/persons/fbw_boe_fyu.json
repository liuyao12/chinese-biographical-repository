table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-048","person_id":"fbw_boe_fyu","surfaces":["建母","母","蔡女"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p041","quote":"平王二年，使費無忌如秦爲太子建取婦。婦好，來，未至，無忌先歸，説平王曰：「秦女好，可自娶，爲太子更求。」平王聽之，卒自娶秦女，生熊珍。更爲太子娶。是時伍奢爲太子太傅，無忌爲少傅。無忌無寵於太子，常讒惡太子建。建時年十五矣，其母蔡女也，無寵於王，王稍益疎外建也。"},{"paragraph_id":"c-shiji-040-chu:p044","quote":"十年，楚太子建母在居巣，開呉。呉使公子光伐楚，遂敗陳、蔡，取太子建母而去。楚恐，城郢。初，呉之邊邑卑梁與楚邊邑鐘離小童爭桑，兩家交怒相攻，滅卑梁人。卑梁大夫怒，發邑兵攻鐘離。楚王聞之怒，發國兵滅卑梁。呉王聞之大怒，亦發兵，使公子光因建母家攻楚，遂滅鐘離、居巣。楚乃恐而城郢。"}],"rationale":"依本段具體職事、引語或親屬用稱暫接未名個人／短名，未補氏名；不同段同職名不得自動相接。 第44段太子建母的母稱接第41段建母蔡女，與秦女分開。 僅限本次列出的敘事與引語，版本及匿名指代覆核未完成。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji066-011","person_id":"fbw_boe_fyu","surfaces":["母","蔡女"],"scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-066-wu:p003","quote":"無忌既以秦女自媚於平王，因去太子而事平王。恐一旦平王卒而太子立，殺己，乃因讒太子建。建母，蔡女也，無寵於平王。平王稍益疏建，使建守城父，備邊兵。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji100-core-caimother","person_ids":["fbw_boe_fyu"],"canonical_person_id":"fbw_boe_fyu","scope":"cross_chapter","chapter_ids":["c-shiji-031-wu","c-shiji-040-chu","c-shiji-066-wu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p022","quote":"八年，吳使公子光伐楚，敗楚師，迎楚故太子建母於居巣以歸。因北伐，敗陳、蔡之師。九年，公子光伐楚，拔居巣、鍾離。初，楚邊邑卑梁氏之處女與吳邊邑之女爭桑，二女家怒相滅，兩國邊邑長聞之，怒而相攻，滅吳之邊邑。吳王怒，故遂伐楚，取兩都而去。","mention_ids":["c-shiji-031-wu:m022-0021"]},{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p041","quote":"平王二年，使費無忌如秦爲太子建取婦。婦好，來，未至，無忌先歸，説平王曰：「秦女好，可自娶，爲太子更求。」平王聽之，卒自娶秦女，生熊珍。更爲太子娶。是時伍奢爲太子太傅，無忌爲少傅。無忌無寵於太子，常讒惡太子建。建時年十五矣，其母蔡女也，無寵於王，王稍益疎外建也。","mention_ids":["c-shiji-040-chu:m041-0113"]},{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p003","quote":"無忌既以秦女自媚於平王，因去太子而事平王。恐一旦平王卒而太子立，殺己，乃因讒太子建。建母，蔡女也，無寵於平王。平王稍益疏建，使建守城父，備邊兵。","mention_ids":["c-shiji-066-wu:m003-0043","c-shiji-066-wu:m003-0045"]}],"rationale":"僅據已辨同一太子建的母子端點接合；蔡女與本卷未名母親的來源原稱分存，不補其他蔡女或秦女。 各篇原名、引文及錨點保留，同書互見不作獨立史實票數。未核書影，身份接合不核定全部親屬、官爵時段及事件紀年。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-031-wu:p022","text":"八年，吳使公子光伐楚，敗楚師，迎楚故太子建母於居巣以歸。因北伐，敗陳、蔡之師。九年，公子光伐楚，拔居巣、鍾離。初，楚邊邑卑梁氏之處女與吳邊邑之女爭桑，二女家怒相滅，兩國邊邑長聞之，怒而相攻，滅吳之邊邑。吳王怒，故遂伐楚，取兩都而去。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m022-0005","start":5,"end":8,"surface":"公子光","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m022-0018","start":18,"end":21,"surface":"太子建","kind":"person","person_id":"q8m_d0c_kq3_AEB","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m022-0021","start":21,"end":22,"surface":"母","kind":"person","person_id":"fbw_boe_fyu","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m022-0042","start":42,"end":45,"surface":"公子光","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m022-0060","start":60,"end":66,"surface":"卑梁氏之處女","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m022-0067","start":67,"end":72,"surface":"吳邊邑之女","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m022-0075","start":75,"end":77,"surface":"二女","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、族稱或未定指代；有虞等不直接補作熟知個人，仍待覆核。"},{"id":"c-shiji-031-wu:m022-0082","start":82,"end"