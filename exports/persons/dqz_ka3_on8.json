id":"c-shiji-097-luli","paragraph_id":"c-shiji-097-luli:p005","quote":"田閒"}]}],"source_mention_summary":[{"source_id":"s-shiji-097-luli","work_id":"w-shiji","book_id":"b-shiji-097","chapter_id":"c-shiji-097-luli","mention_count":1,"mention_ids":["c-shiji-097-luli:m005-0332"],"paragraph_ids":["c-shiji-097-luli:p005"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-097-luli"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"unresolved_identity_cases":[{"id":"ic-shiji097-tianxian","status":"unresolved","candidate_person_ids":["dqz_ka3_on8","27q_nw7_jv8"],"paragraph_ids":["c-shiji-097-luli:p005","c-shiji-094-tiandan:p003","c-shiji-094-tiandan:p004","c-shiji-094-tiandan:p005"],"note":"本篇田廣時田閒將兵於歷城；田儋篇較早田角之弟田閒求救趙、留趙不敢歸，田榮要求殺之。尚未讀到其歸齊承接，不因同名與齊將身分直接合併，也未證為不同人。漢書平行作田間，原字分存。林聰舜論文僅記相關背景，不代替兩處身份接合證據。","references":[{"title":"《漢書》卷043·酈食其相應段","url":"https://zh.wikisource.org/w/index.php?title=漢書/卷043&oldid=7904628","quote":"今田廣据千里之齊，田間將二十万之眾軍于歷城，諸田宗強，負海岱，阻河濟，南近楚，齊人多變詐，足下雖遣數十万師，未可以歲月破也。臣請得奉明詔說齊王使為漢而稱東籓。」","revision_id":7904628,"image_verified":false},{"title":"林聰舜〈齊國的視角──楚漢之際至漢初幾個重要階段的天下變局之詮釋〉","url":"https://thjcs.site.nthu.edu.tw/var/file/452/1452/img/2921/232567288.pdf","quote":"田閒（生卒年不詳）亡走趙","author":"林聰舜","journal":"清華學報","volume":47,"issue":3,"year":2017,"pages":"473–508","relevant_pages":"483–484","doi":"10.6503/THJCS.2017.47(3).02","scope":"modern_secondary_context","note":"僅列背景研究參考；此引句未判定本篇將軍與田角之弟同人。"}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"chapter_id":"c-shiji-097-luli","source_id":"s-shiji-097-luli"}],"reported_variants":[{"id":"rv-shiji097-tianxian","paragraph_id":"c-shiji-097-luli:p005","person_ids":["dqz_ka3_on8"],"source_term":"田閒將二十萬","received_reading":"田閒","reported_reading":"田間","commentator":"《漢書》卷043平行數位正文（不是史記底本校勘）","quote":"今田廣据千里之齊，田間將二十万之眾軍于歷城，諸田宗強，負海岱，阻河濟，南近楚，齊人多變詐，足下雖遣數十万師，未可以歲月破也。臣請得奉明詔說齊王使為漢而稱東籓。」","url":"https://zh.wikisource.org/w/index.php?title=漢書/卷043&oldid=7904628","status":"reported_not_collated","adopted":false,"revision_id":7904628,"image_verified":false}],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-097-luli:m005-0332","start":332,"end":334,"surface":"田閒","kind":"person","person_id":"dqz_ka3_on8","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p005","chapter_id":"c-shiji-097-luli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji097-010","person_id":"dqz_ka3_on8","surfaces":["田閒"],"scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-097-luli:p005","quote":"漢三年秋，項羽擊漢，拔滎陽，漢兵遁保鞏、洛。楚人聞淮陰侯破趙，彭越數反梁地，則分兵救之。淮陰方東擊齊，漢王數困滎陽、成皋，計欲捐成皋以東，屯鞏、洛以拒楚。酈生因曰：「臣聞知天之天者，王事可成；不知天之天者，王事不可成。王者以民人為天，而民人以食為天。夫敖倉，天下轉輸久矣，臣聞其下乃有藏粟甚多。楚人拔滎陽，不堅守敖倉，乃引而東，令適卒分守成皋，此乃天所以資漢也。方今楚易取而漢反卻，自奪其便，臣竊以為過矣。且兩雄不俱立，楚漢久相持不決，百姓騷動，海內搖蕩，農夫釋耒，工女下機，天下之心未有所定也。願足下急復進兵，收取滎陽，據敖倉之粟，塞成皋之險，杜大行之道，距蜚狐之口，守白馬之津，以示諸侯效實形制之勢，則天下知所歸矣。方今燕、趙已定，唯齊未下。今田廣據千里之齊，田閒將二十萬之眾，軍於歷城，諸田宗彊，負海阻河濟，南近楚，人多變詐，足下雖遣數十萬師，未可以歲月破也。臣請得奉明詔說齊王，使為漢而稱東藩。」上曰：「善。」"}],"rationale":"按酈生、陸賈與朱建分傳及敘事承接限定異稱；尉他尉佗原字分存。平原君據明示朱建另候選；朱建兩處未名子依古注另存暫定同指，淮陰侯與韓信同指另列證據。引語古王及神話人物與當事人分開。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-094-tiandan:p003","text":"秦將章邯圍魏王咎於臨濟，急。魏王請救於齊，齊王田儋將兵救魏。章邯夜銜枚擊，大破齊、魏軍，殺田儋於臨濟下。儋弟田榮收儋餘兵東走東阿。齊人聞王田儋死，乃立故齊王建之弟田假為齊王、田角為相、田間為將，以距諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m003-0002","start":2,"end":4,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0005","start":5,"end":8,"surface":"魏王咎","kind":"person","person_id":"kez_re1_kcr","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0014","start":14,"end":16,"surface":"魏王","kind":"person","person_id":"kez_re1_kcr","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0023","start":23,"end":25,"surface":"田儋","kind":"person","person_id":"u87_cc1_7vm","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0030","start":30,"end":32,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0045","start":45,"end":47,"surface":"田儋","kind":"person","person_id":"u87_cc1_7vm","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0052","start":52,"end":53,"surface":"儋","kind":"person","person_id":"u87_cc1_7vm","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0054","start":54,"end":56,"surface":"田榮","kind":"person","person_id":"0hs_fg6_1qj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0057","start":57,"end":58,"surface":"儋","kind":"person","person_id":"u87_cc1_7vm","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0069","start":69,"end":71,"surface":"田儋","kind":"person","person_id":"u87_cc1_7vm","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0076","start":76,"end":79,"surface":"齊王建","kind":"person","person_id":"vtu_yuj_kdz","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0081","start":81,"end":83,"surface":"田假","kind":"person","person_id":"hvf_el4_hqj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0087","start":87,"end":89,"surface":"田角","kind":"person","person_id":"hb5_4zq_x4c","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m003-0092","start":92,"end":94,"surface":"田間","kind":"person","person_id":"27q_nw7_jv8","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p004","text":"田榮之走東阿，章邯追圍之。項梁聞田榮之急，乃引兵擊破章邯軍東阿下。章邯走而西，項梁因追之。而田榮怒齊之立假，乃引兵歸，擊逐齊王假。假亡走楚。齊相角亡走趙；角弟田閒前求救趙，因留不敢歸。田榮乃立田儋子市為齊王。榮相之，田橫為將，平齊地。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m004-0000","start":0,"end":2,"surface":"田榮","kind":"person","person_id":"0hs_fg6_1qj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0007","start":7,"end":9,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0013","start":13,"end":15,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0016","start":16,"end":18,"surface":"田榮","kind":"person","person_id":"0hs_fg6_1qj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0026","start":26,"end":28,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0033","start":33,"end":35,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0039","start":39,"end":41,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0046","start":46,"end":48,"surface":"田榮","kind":"person","person_id":"0hs_fg6_1qj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0052","start":52,"end":53,"surface":"假","kind":"person","person_id":"hvf_el4_hqj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0061","start":61,"end":64,"surface":"齊王假","kind":"person","person_id":"hvf_el4_hqj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0065","start":65,"end":66,"surface":"假","kind":"person","person_id":"hvf_el4_hqj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0070","start":70,"end":73,"surface":"齊相角","kind":"person","person_id":"hb5_4zq_x4c","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0079","start":79,"end":81,"surface":"田閒","kind":"person","person_id":"27q_nw7_jv8","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0092","start":92,"end":94,"surface":"田榮","kind":"person","person_id":"0hs_fg6_1qj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0096-parent","start":96,"end":98,"surface":"田儋","kind":"person","person_id":"u87_cc1_7vm","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0096","start":99,"end":100,"surface":"市","kind":"person","person_id":"u87_cc1_7vm_A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0104","start":104,"end":105,"surface":"榮","kind":"person","person_id":"0hs_fg6_1qj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m004-0108","start":108,"end":110,"surface":"田橫","kind":"person","person_id":"6r7_9o6_c1i","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-094-tiandan:p005","text":"項梁既追章邯，章邯兵益盛，項梁使使告趙、齊，發兵共擊章邯。田榮曰：「使楚殺田假，趙殺田角、田閒，閒肯出兵。」楚懷王曰：「田假與國之王，窮而歸我，殺之不義。」趙亦不殺田角、田閒以市於齊。齊曰：「蝮螫手則斬手，螫足則斬足。何者？為害於身也。今田假、田角、田閒於楚、趙，非直手足戚也，何故不殺？且秦復得志於天下，則齮齕用事者墳墓矣。」楚、趙不聽，齊亦怒，終不肯出兵。章邯果敗殺項梁，破楚兵，楚兵東走，而章邯渡河圍趙於鉅鹿。項羽往救趙，由此怨田榮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-094-tiandan:m005-0000","start":0,"end":2,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0004","start":4,"end":6,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0007","start":7,"end":9,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0013","start":13,"end":15,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0026","start":26,"end":28,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0029","start":29,"end":31,"surface":"田榮","kind":"person","person_id":"0hs_fg6_1qj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0037","start":37,"end":39,"surface":"田假","kind":"person","person_id":"hvf_el4_hqj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0042","start":42,"end":44,"surface":"田角","kind":"person","person_id":"hb5_4zq_x4c","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0045","start":45,"end":47,"surface":"田閒","kind":"person","person_id":"27q_nw7_jv8","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0054","start":54,"end":57,"surface":"楚懷王","kind":"person","person_id":"c2w_s7g_en0_*A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0060","start":60,"end":62,"surface":"田假","kind":"person","person_id":"hvf_el4_hqj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0082","start":82,"end":84,"surface":"田角","kind":"person","person_id":"hb5_4zq_x4c","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0085","start":85,"end":87,"surface":"田閒","kind":"person","person_id":"27q_nw7_jv8","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0119","start":119,"end":121,"surface":"田假","kind":"person","person_id":"hvf_el4_hqj","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0122","start":122,"end":124,"surface":"田角","kind":"person","person_id":"hb5_4zq_x4c","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0125","start":125,"end":127,"surface":"田閒","kind":"person","person_id":"27q_nw7_jv8","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0180","start":180,"end":182,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0185","start":185,"end":187,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0198","start":198,"end":200,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0208","start":208,"end":210,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-094-tiandan:m005-0217","start":217,"end":219,"surface":"田榮","kind":"person","person_id":"0hs_fg6_1qj","status":"contextual_provisional"}],"chapter_id":"c-shiji-094-tiandan","book_id":"b-shiji-094","work_id":"w-shiji","source_id":"s-shiji-094-tiandan"},{"id":"c-shiji-097-luli:p005","text":"漢三年秋，項羽擊漢，拔滎陽，漢兵遁保鞏、洛。楚人聞淮陰侯破趙，彭越數反梁地，則分兵救之。淮陰方東擊齊，漢王數困滎陽、成皋，計欲捐成皋以東，屯鞏、洛以拒楚。酈生因曰：「臣聞知天之天者，王事可成；不知天之天者，王事不可成。王者以民人為天，而民人以食為天。夫敖倉，天下轉輸久矣，臣聞其下乃有藏粟甚多。楚人拔滎陽，不堅守敖倉，乃引而東，令適卒分守成皋，此乃天所以資漢也。方今楚易取而漢反卻，自奪其便，臣竊以為過矣。且兩雄不俱立，楚漢久相持不決，百姓騷動，海內搖蕩，農夫釋耒，工女下機，天下之心未有所定也。願足下急復進兵，收取滎陽，據敖倉之粟，塞成皋之險，杜大行之道，距蜚狐之口，守白馬之津，以示諸侯效實形制之勢，則天下知所歸矣。方今燕、趙已定，唯齊未下。今田廣據千里之齊，田閒將二十萬之眾，軍於歷城，諸田宗彊，負海阻河濟，南近楚，人多變詐，足下雖遣數十萬師，未可以歲月破也。臣請得奉明詔說齊王，使為漢而稱東藩。」上曰：「善。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-097-luli:m005-0005","start":5,"end":7,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0025","start":25,"end":28,"surface":"淮陰侯","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0031","start":31,"end":33,"surface":"彭越","kind":"person","person_id":"ci2_vzk_6ry","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0044","start":44,"end":46,"surface":"淮陰","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0051","start":51,"end":53,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0077","start":77,"end":79,"surface":"酈生","kind":"person","person_id":"eya_qj3_tev","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0324","start":324,"end":326,"surface":"田廣","kind":"person","person_id":"0hs_fg6_1qj_A","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0332","start":332,"end":334,"surface":"田閒","kind":"person","person_id":"dqz_ka3_on8","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0390","start":390,"end":392,"surface":"齊王","kind":"person","person_id":"0hs_fg6_1qj_A","status":"contextual_provisional"},{"id":"c-shiji-097-luli:m005-0402","start":402,"end":403,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-097-luli","book_id":"b-shiji-097","work_id":"w-shiji","source_id":"s-shiji-097-luli"}],"sources":[{"chapter_id":"c-shiji-094-tiandan","work_id":"w-shiji","book_id":"b-shiji-094","source_id":"s-shiji-094-tiandan","source":{"title":"史記／卷094","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷094","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷094&oldid=2171897","revision_id":2171897,"accessed_on":"2026-10-09","extent":"13段傳世正文含太史公論，另附1段分層索隱述贊；排除導覽與空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"龁":"齕"},"editorial_readings":[],"extraction_note":"只去外緣空白並明記龁轉齕；田間田閒、大田橫之客皆賢及博（陽）原字保留。","note":"全16個HTML區塊已讀；未核底本影像。"}}},{"chapter_id":"c-shiji-097-luli","work_id":"w-shiji","book_id":"b-shiji-097","source_id":"s-shiji-097-luli","source":{"title":"史記／卷097","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷097","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷097&oldid=1383195","rev