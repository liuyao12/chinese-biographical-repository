其眾王滇，變服，從其俗，以長之。秦時常頞略通五尺道，諸此國頗置吏焉。十餘歲，秦滅。及漢興，皆棄此國而開蜀故徼。巴蜀民或竊出商賈，取其筰馬、僰僮、髦牛，以此巴蜀殷富。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinanyi:m002-0001","start":1,"end":4,"surface":"楚威王","kind":"person","person_id":"42z_cse_1ka_A","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m002-0009","start":9,"end":11,"surface":"莊蹻","kind":"person","person_id":"b1y_l5y_xmz","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m002-0025","start":25,"end":27,"surface":"莊蹻","kind":"person","person_id":"b1y_l5y_xmz","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m002-0030","start":30,"end":33,"surface":"楚莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m002-0037","start":37,"end":38,"surface":"蹻","kind":"person","person_id":"b1y_l5y_xmz","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m002-0107","start":107,"end":109,"surface":"常頞","kind":"person","person_id":"bwt_386_283","status":"contextual_provisional"}],"chapter_id":"c-shiji-116-xinanyi","book_id":"b-shiji-116","work_id":"w-shiji","source_id":"s-shiji116-xinanyi"}],"sources":[{"chapter_id":"c-shiji-116-xinanyi","work_id":"w-shiji","book_id":"b-shiji-116","source_id":"s-shiji116-xinanyi","source":{"title":"史記／卷116","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷116","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷116&oldid=7903636","revision_id":7903636,"accessed_on":"2026-10-11","extent":"固定數位修訂全文12段，末段索隱述贊另層。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2與現代節標題；YL紀年模板保留第一參數，第二參數編輯年標不納正文。正文原字不改，未核影像。","note":"第11段太史公評語仍正文；第12段索隱述贊分層。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"da