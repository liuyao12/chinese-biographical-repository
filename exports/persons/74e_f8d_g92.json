eported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-041-helingwan-family:p004:m0028","surface":"王師壽","start":28,"end":31,"person_id":"74e_f8d_g92","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-songshu-041-helingwan-family:p004","chapter_id":"c-songshu-041-helingwan-family"}],"relations":[],"title_holdings":[{"id":"th-nanshi011-helingwan-s4-26","person_id":"74e_f8d_g92","title":"參軍","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi011-helingwan-s4-26:a","person_mention_id":"c-songshu-041-helingwan-family:p004:m0028","usage":"narrative","date_expression":null,"paragraph_id":"c-songshu-041-helingwan-family:p004","surface":"參軍","start":26,"end":28}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p004","quote":"瑀兄子亮，孝建初，為桂陽太守。丞相南郡王義宣為逆，遣參軍王師壽斷桂陽道，以防廣州刺史宗慤，亮收斬之。官至新安內史。亮弟恢，廢帝元徽初，為廣州剌史，未之鎮，坐國哀朞晦不到，免官。復起為都官尚書，未拜，卒。恢弟誕，司徒右長史。誕弟衍，最知名。性躁動。太宗初，為建安王休仁司徒從事中郎，仍除黃門郎。未拜竟，求轉司徒司馬。得司馬，復求太子右率。拜右率一二日，復求侍中。旬日之間，求進無已。不得侍中，以怨詈賜死。","person_mention_id":"c-songshu-041-helingwan-family:p004:m0028"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-041-helingwan-family:p004","text":"瑀兄子亮，孝建初，為桂陽太守。