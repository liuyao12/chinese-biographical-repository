逮若思，儒博過之。弱冠舉秀才，尋遷太子洗馬，出補西陽內史。永嘉中，元帝版行邵陵內史、丞相軍諮祭酒，出為征南軍司。于時凡百草創，學校未立，邈上疏曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":82,"last_line":82,"raw_start":6954,"raw_end":7063,"raw_character_offsets":[6956,6957,6958,6959,6960,6961,6962,6963,6964,6965,6966,6967,6973,6976,6977,6983,6986,6987,6988,6989,6990,6991,6992,6993,6994,6995,6996,6997,6998,6999,7000,7001,7002,7003,7004,7005,7006,7007,7008,7009,7010,7011,7012,7013,7014,7015,7016,7017,7018,7019,7020,7021,7022,7023,7024,7025,7026,7027,7028,7029,7030,7031,7032,7033,7034,7035,7036,7037,7038,7039,7040,7041,7042,7043,7044,7045,7046,7047,7048,7049,7050,7051,7052,7053,7054,7055,7056,7057,7058,7059,7060,7061,7062],"revision_id":2012453},"mentions":[{"id":"c-jinshu-069-daimiao:p001:m0000","surface":"邈","start":0,"end":1,"person_id":"qxw_ax7_qew","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-069-daimiao:p001:m0021","surface":"若思","start":21,"end":23,"person_id":"d9d_ab2_a72","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-069-daimiao:p001:m0053","surface":"元帝","start":53,"end":55,"person_id":"dkn_ge4_286_AAAAAAA","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-069-daimiao","book_id":"b-jinshu-069","work_id":"w-jinshu","source_id":"s-jinshu-069-daimiao-ws2012453"},{"id":"c-jinshu-069-daimiao:p007","text":"代劉隗為丹陽尹。王敦作逆，加左將軍。及敦得志，而若思遇害，邈坐免官。敦誅後，拜尚書僕射。卒官，贈衛將軍，諡曰穆。子謐嗣，歷義興太守、大司農。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":94,"last_line":94,"raw_start":7803,"raw_end":7875,"raw_character_offsets":[7805,7806,7807,7808,7809,7810,7811,7812,7813,7814,7815,7816,7817,7818,7819,7820,7821,7822,7823,7824,7825,7826,7827,7828,7829,7830,7831,7832,7833,7834,7835,7836,7837,7838,7839,7840,7841,7842,7843,7844,7845,7846,7847,7848,7849,7850,7851,7852,7853,7854,7855,7856,7857,7858,7859,7860,7861,7862,7863,7864,7865,7866,7867,7868,7869,7870,7871,7872,7873,7874],"revision_id":2012453},"mentions":[{"id":"c-jinshu-069-daimiao:p007:m0001","surface":"劉隗","start":1,"end":3,"person_id":"hnd_3at_h4i","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-069-daimiao:p007:m0008","surface":"王敦","start":8,"end":10,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-069-daimiao:p007:m0024","surface":"若思","start":24,"end":26,"person_id":"d9d_ab2_a72","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-069-daimiao:p007:m0029","surface":"邈","start":29,"end":30,"person_id":"qxw_ax7_qew","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-069-daimiao:p007:m0057","surface":"謐","start":57,"end":58,"person_id":"gzj_j1m_hy0","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-069-daimiao","book_id":"b-jinshu-069","work_id":"w-jinshu","source_id":"s-jinshu-069-daimiao-ws2012453"},{"id":"c-jinshu-069-zhouyi:p002","text":"元帝初鎮江左，請為軍諮祭酒，出為甯遠將軍、荊州刺史、領護南蠻校尉、假節。始到州，而建平流人傅密等叛迎蜀賊杜弢，顗狼狽失據。陶侃遣將吳寄以兵救之，故顗得免，因奔王敦于豫章。敦留之。軍司戴邈曰：「顗雖退敗，未有蒞眾之咎，德望素重，宜還復之。」敦不從。帝召為揚威將軍、兗州刺史。顗還建康，帝留顗不遣，復以為軍諮祭酒，尋轉右長史。中興建，補吏部尚書。頃之，以醉酒為有司所糾，白衣領職。復坐門生斫傷人，免官。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-069-zhouyi:p002:m0000","start":0,"end":2,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0045","start":45,"end":47,"surface":"傅密","kind":"person","person_id":"2ek_879_zfk","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0052","start":52,"end":54,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0055","start":55,"end":56,"surface":"顗","kind":"person","person_id":"3xx_gdy_or6_AAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0061","start":61,"end":63,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p0