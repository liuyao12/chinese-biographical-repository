an:p015:m0047","start":47,"end":48,"surface":"譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p015:m0103","start":103,"end":105,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p015:m0108","start":108,"end":109,"surface":"譚","kind":"person","person_id":"qg9_lis_fdj","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p015:m0148","start":148,"end":149,"surface":"化","kind":"person","person_id":"4fh_ev1_83y","status":"contextual_provisional"},{"id":"c-jinshu-052-hua-tan:p015:m0150","start":150,"end":151,"surface":"茂","kind":"person","person_id":"p9t_5qd_fei","status":"contextual_provisional"}],"chapter_id":"c-jinshu-052-hua-tan","book_id":"b-jinshu-052","work_id":"w-jinshu","source_id":"s-jinshu-052-hua-tan-ws2604575"},{"id":"c-jinshu-061-zhou-family:p007","text":"嵩怏怏不悅，臨發，與散騎郎張嶷在侍中戴邈坐，褒貶朝士，又詆毀邈，邈密表之。帝召嵩入，面責之曰：「卿矜豪傲慢，敢輕忽朝廷，由吾不德故耳。」嵩跪謝曰：「昔唐虞至聖，四凶在朝。陛下雖聖明禦世，亦安能無碌碌之臣乎！」帝怒，收付廷尉。廷尉華恆以嵩大不敬棄市論，嶷以扇和減罪除名。時顗方貴重，帝隱忍。久之，補廬陵太守，不之職，更拜御史中丞。","source_position":{"raw_start":1586,"raw_end":1752,"raw_text":"　　嵩怏怏不悅，臨發，與散騎郎張嶷在侍中戴邈坐，褒貶朝士，又詆毀邈，邈密表之。帝召嵩入，面責之曰：「卿矜豪傲慢，敢輕忽朝廷，由吾不德故耳。」嵩跪謝曰：「昔唐虞至聖，四凶在朝。陛下雖聖明禦世，亦安能無碌碌之臣乎！」帝怒，收付廷尉。廷尉華恆以嵩大不敬棄市論，嶷以扇和減罪除名。時顗方貴重，帝隱忍。久之，補廬陵太守，不之職，更拜御史中丞。","display_wrapper_start":0,"display_wrapper_end":0,"raw_path":"sources/jinshu/wikisource-7903772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p007:m0000","start":0,"end":1,"surface":"嵩","kind":"person","person_id":"3xx_gdy_or6_AAB","status":"contextual_provisional","interpretation_note":"069顗傳弟嵩與本061明三子相合；非賁嵩。"},{"id":"c-jinshu-061-zhou-family:p007:m0013","start":13,"end":15,"surface":"張嶷","kind":"person","person_id":"ldo_tw7_nv8","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p007:m0018","start":18,"end":20,"surface":"戴邈","kind":"person","person_id":"qxw_ax7_qew","status":"contextual_provisional","interpreta