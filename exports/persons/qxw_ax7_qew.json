黌校。","paragraph_id":"c-jinshu-069-daimiao:p002","start_codepoint":43,"end_codepoint":52,"human_reviewed":false,"chapter_id":"c-jinshu-069-daimiao","source_id":"s-jinshu-069-daimiao-ws2012453"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin052-miao-brother","subject_person_id":"qxw_ax7_qew","object_person_id":"d9d_ab2_a72","predicate":"brother","qualifiers":{"source_term":"戴若思弟邈"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-052","chapter_id":"c-jinshu-052-hua-tan","source_id":"s-jinshu-052-hua-tan-ws2604575","paragraph_id":"c-jinshu-052-hua-tan:p015","quote":"戴若思弟邈，則譚女婿也。譚平生時常抑若思而進邈，若思每銜之。殆用事，恆毀譚於帝，由是官塗不至。譚每懷觖望，嘗從容言於帝曰：「臣已老矣，將待死秘閣。汲黯之言，復存於今。」帝不懌。久之，加散騎常侍，屢以疾辭。及王敦作逆，譚疾甚，不能入省，坐免。卒於家。贈光祿大夫，金章紫綬，加散騎常侍，諡曰胡。二子：化、茂。","subject_person_mention_id":"c-jinshu-052-hua-tan:p015:m0004","object_person_mention_id":"c-jinshu-052-hua-tan:p015:m0000"}],"status":"source_attested","interpretation_note":"戴邈為若思弟。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin069-daimiao","person_id":"qxw_ax7_qew","event_type":"death","source_term":"卒官","source_anchor":{"paragraph_id":"c-jinshu-069-daimiao:p007","start":44,"end":46,"surface":"卒官"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-daimiao","source_id":"s-jinshu-069-daimiao-ws2012453","paragraph_id":"c-jinshu-069-daimiao:p007","quote":"代劉隗為丹陽尹。王敦作逆，加左將軍。及敦得志，而若思遇害，邈坐免官。敦誅後，拜尚書僕射。卒官，贈衛將軍，諡曰穆。子謐嗣，歷義興太守、大司農。","person_mention_id":"c-jinshu-069-daimiao:p007:m0029"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-052-hua-tan:p015:m0004","start":4,"end":5,"surface":"邈","kind":"person","person_id":"qxw_ax7_qew","statu