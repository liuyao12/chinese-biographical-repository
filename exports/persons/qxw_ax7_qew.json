{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"qxw_ax7_qew","canonical_person_id":"qxw_ax7_qew","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["qxw_ax7_qew"],"persons":[{"id":"qxw_ax7_qew","label":"戴邈","status":"active","historicity":"historical_tradition","aliases":[{"surface":"戴邈","mention_ids":["c-jinshu-069-zhouyi:p002:m0091"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-zhouyi","source_id":"s-jinshu-069-zhouyi","paragraph_id":"c-jinshu-069-zhouyi:p002","mention_id":"c-jinshu-069-zhouyi:p002:m0091","quote":"戴邈"}],"identity_note":"固定069正文具名／引古候選；未補未知親屬、年代或外名。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-069-zhouyi","work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-zhouyi","raw_mention_count":1,"mention_ids":["c-jinshu-069-zhouyi:p002:m0091"],"paragraph_ids":["c-jinshu-069-zhouyi:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-069-zhouyi:p002:m0091","mention_ids":["c-jinshu-069-zhouyi:p002:m0091"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-069-zhouyi"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-069-zhouyi:p002:m0091","start":91,"end":93,"surface":"戴邈","kind":"person","person_id":"qxw_ax7_qew","status":"contextual_provisional","paragraph_id":"c-jinshu-069-zhouyi:p002","chapter_id":"c-jinshu-069-zhouyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin069-zhouyi-qxw-ax7-qew","person_id":"qxw_ax7_qew","surfaces":["戴邈"],"scope":"same_chapter","chapter_ids":["c-jinshu-069-zhouyi"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-069","chapter_id":"c-jinshu-069-zhouyi","source_id":"s-jinshu-069-zhouyi","paragraph_id":"c-jinshu-069-zhouyi:p002","quote":"元帝初鎮江左，請為軍諮祭酒，出為甯遠將軍、荊州刺史、領護南蠻校尉、假節。始到州，而建平流人傅密等叛迎蜀賊杜弢，顗狼狽失據。陶侃遣將吳寄以兵救之，故顗得免，因奔王敦于豫章。敦留之。軍司戴邈曰：「顗雖退敗，未有蒞眾之咎，德望素重，宜還復之。」敦不從。帝召為揚威將軍、兗州刺史。顗還建康，帝留顗不遣，復以為軍諮祭酒，尋轉右長史。中興建，補吏部尚書。頃之，以醉酒為有司所糾，白衣領職。復坐門生斫傷人，免官。"}],"rationale":"親讀完整周顗及附閔單元，依說話受話及人物延續辨識；短字嵇阮限王導對顗引古語境，田蘇與無鹽不補未核外名。周穆及周文與既有古人同字候選分立。先帝／二宮／匿名群體保未決；親屬與為嗣提案未在此形式化。","references":[],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-069-zhouyi:p002","text":"元帝初鎮江左，請為軍諮祭酒，出為甯遠將軍、荊州刺史、領護南蠻校尉、假節。始到州，而建平流人傅密等叛迎蜀賊杜弢，顗狼狽失據。陶侃遣將吳寄以兵救之，故顗得免，因奔王敦于豫章。敦留之。軍司戴邈曰：「顗雖退敗，未有蒞眾之咎，德望素重，宜還復之。」敦不從。帝召為揚威將軍、兗州刺史。顗還建康，帝留顗不遣，復以為軍諮祭酒，尋轉右長史。中興建，補吏部尚書。頃之，以醉酒為有司所糾，白衣領職。復坐門生斫傷人，免官。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-069-zhouyi:p002:m0000","start":0,"end":2,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0045","start":45,"end":47,"surface":"傅密","kind":"person","person_id":"2ek_879_zfk","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0052","start":52,"end":54,"surface":"杜弢","kind":"person","person_id":"7dv_udy_955","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0055","start":55,"end":56,"surface":"顗","kind":"person","person_id":"xxj_ei4_g6w","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0061","start":61,"end":63,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0065","start":65,"end":67,"surface":"吳寄","kind":"person","person_id":"ns4_a8h_396","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0070","start":70,"end":71,"surface":"之","kind":"person","person_id":"xxj_ei4_g6w","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0073","start":73,"end":74,"surface":"顗","kind":"person","person_id":"xxj_ei4_g6w","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0079","start":79,"end":81,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0085","start":85,"end":86,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0087","start":87,"end":88,"surface":"之","kind":"person","person_id":"xxj_ei4_g6w","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0091","start":91,"end":93,"surface":"戴邈","kind":"person","person_id":"qxw_ax7_qew","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0096","start":96,"end":97,"surface":"顗","kind":"person","person_id":"xxj_ei4_g6w","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0116","start":116,"end":117,"surface":"之","kind":"person","person_id":"xxj_ei4_g6w","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0119","start":119,"end":120,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0123","start":123,"end":124,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0136","start":136,"end":137,"surface":"顗","kind":"person","person_id":"xxj_ei4_g6w","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0141","start":141,"end":142,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0143","start":143,"end":144,"surface":"顗","kind":"person","person_id":"xxj_ei4_g6w","status":"contextual_provisional"},{"id":"c-jinshu-069-zhouyi:p002:m0178","start":178,"end":180,"surface":"有司","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-jinshu-069-zhouyi:p002:m0190","start":190,"end":192,"surface":"門生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-jinshu-069-zhouyi:p002:m0194","start":194,"end":195,"surface":"人","kind":"unresolved","person_id":null,"status":"unresolved"}],"source_position":{"first_line":99,"last_line":99,"revision_id":2012453,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-069-zhouyi","book_id":"b-jinshu-069","work_id":"w-jinshu","source_id":"s-jinshu-069-zhouyi"}],"sources":[{"chapter_id":"c-jinshu-069-zhouyi","work_id":"w-jinshu","book_id":"b-jinshu-069","source_id":"s-jinshu-069-zhouyi","source":{"title":"《晉書》卷六十九〈周顗〉及附子閔","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7069&oldid=2012453","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7069&oldid=2012453","revision_id":2012453,"accessed_on":"2026-10-20","extent":"周顗及附子閔完整10原段，原wikitext97–115行；前標題96，後史評117。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"edition":"維基文庫數位轉錄，未親核底本影像","rights":"古代正文及維基文庫數位轉錄，保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","wikitext_sha256":"c1e20b58e336495080becb68c3823ada28de1d6cfd202a74c22e053615cc9adf","response_sha256":"6b0c6f296a175090455ff5c2340df41e5031a487c85abe2a5d196dd96ea5cc20","normalization":{"character_conversion":{},"extraction_note":"僅移除段首縮排；保存全部原字標點，未校訂武城／成武等。","excerpts":[{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p001","source_lines":[97,97],"raw_quote":"　　周顗，字伯仁，安東將軍浚之子也。少有重名，神彩秀徹，雖時輩親狎，莫能媟也。司徒掾同郡賁嵩有清操，見顗，歎曰：「汝潁固多奇士！自頃雅道陵遲，今復見周伯仁，將振起舊風，清我邦族矣。」廣陵戴若思東南之美，舉秀才，入洛，素聞顗名，往候之，終坐而出，不敢顯其才辯。顗從弟穆亦有美譽，欲陵折顗，顗陶然弗與之校，於是人士益宗附之。州郡辟命皆不就。弱冠，襲父爵武城侯，拜秘書郎，累遷尚書吏部郎。東海王越子毗為鎮軍將軍，以顗為長史。","raw_quote_sha256":"6a9cdbfd26ff481e0809c0413c436b6fc71b1630035af12a7763d3e35505c250","selected_text_sha256":"6ab9ee49d91a6fddccdb7bc72b8fa220ab90aa276fb5cc45ffb2e0d355bd95b0","begin_anchor":"周顗，字伯仁，安東將軍浚之子也。少有重名","end_anchor":"郎。東海王越子毗為鎮軍將軍，以顗為長史。"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p002","source_lines":[99,99],"raw_quote":"　　元帝初鎮江左，請為軍諮祭酒，出為甯遠將軍、荊州刺史、領護南蠻校尉、假節。始到州，而建平流人傅密等叛迎蜀賊杜弢，顗狼狽失據。陶侃遣將吳寄以兵救之，故顗得免，因奔王敦于豫章。敦留之。軍司戴邈曰：「顗雖退敗，未有蒞眾之咎，德望素重，宜還復之。」敦不從。帝召為揚威將軍、兗州刺史。顗還建康，帝留顗不遣，復以為軍諮祭酒，尋轉右長史。中興建，補吏部尚書。頃之，以醉酒為有司所糾，白衣領職。復坐門生斫傷人，免官。","raw_quote_sha256":"e6fd65049ea2e73860e2a3ca4a0a6536911c1a13ef521183a1a407fbed7c8705","selected_text_sha256":"6006ffd539ae3ae6a8bfa670e85e5992451b3735e8d3d452e09f40e89fc1ad2d","begin_anchor":"元帝初鎮江左，請為軍諮祭酒，出為甯遠將軍","end_anchor":"司所糾，白衣領職。復坐門生斫傷人，免官。"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p003","source_lines":[101,101],"raw_quote":"　　太興初，更拜太子少傅，尚書如故。顗上疏讓曰：「臣退自循省，學不通一經，智不效一官，止足良難，未能守分，遂忝顯任，名位過量。不悟天鑒忘臣頑弊，乃欲使臣內管銓衡，外忝傅訓，質輕蟬翼，事重千鈞，此之不可，不待識而明矣。若臣受負乘之責，必貽聖朝惟塵之恥，俯仰愧懼，不知所圖。」詔曰：「紹幼沖便居儲副之貴，當賴軌匠以祛蒙蔽。望之儼然，斯不言之益，何學之習邪，所謂與田蘇遊忘其鄙心者。便當副往意，不宜沖讓。」轉尚書左僕射，領吏部如故。","raw_quote_sha256":"b04bdcfbdc939a36556f998743ccef83963720166223f68c21cef3034e5faf80","selected_text_sha256":"8e90ad124f0902833b1e83e6d1d88c9d4f0c919a74b9c4a30019d52450e42bda","begin_anchor":"太興初，更拜太子少傅，尚書如故。顗上疏讓","end_anchor":"，不宜沖讓。」轉尚書左僕射，領吏部如故。"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p004","source_lines":[103,103],"raw_quote":"　　庾亮嘗謂顗曰：「諸人咸以君方樂廣。」顗曰：「何乃刻畫無鹽，唐突西施也。」帝宴群公於西堂，酒酣，從容曰：「今日名臣共集，何如堯舜時邪？」顗因醉厲聲曰：「今雖同人主，何得復比聖世！」帝大怒而起，手詔付廷尉，將加戮，累日方赦之。及出，諸公就省，顗曰：「近日之罪，固知不至於死。」尋代戴若思為護軍將軍。尚書紀瞻置酒請顗及王導等，顗荒醉失儀，復為有司所奏。詔曰：「顗參副朝右，職掌銓衡，當敬慎德音，式是百辟。屢以酒過，為有司所繩。吾亮其極歎之情，然亦是濡首之誡也。顗必能克己復禮者，今不加黜責。」","raw_quote_sha256":"3d89f33c29db6f93089b51d124c676380e0db204819e24e087b00c5851a2bff1","selected_text_sha256":"33d15a27216ade75a79efb2fc847fa0365e74d25e5310b9c64568d76ab4dc642","begin_anchor":"庾亮嘗謂顗曰：「諸人咸以君方樂廣。」顗曰","end_anchor":"之誡也。顗必能克己復禮者，今不加黜責。」"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p005","source_lines":[105,105],"raw_quote":"　　初，顗以雅望獲海內盛名，後頗以酒失。為僕射，略無醒日，時人號為「三日僕射」。庾亮曰：「周侯末年，所謂鳳德之衰也。」顗在中朝時，能飲酒一石，及過江，雖日醉，每稱無對。偶有舊對從北來，顗遇之欣然，乃出酒二石共飲，各大醉。及顗醒，使視客，已腐脅而死。","raw_quote_sha256":"64b672c275e9cb7ac2836e10c26c5a2e3e9d24e4d64061304bef9cae56e31cc6","selected_text_sha256":"8e46ccc1abe0aede9f2f33cc9d2ddc507237a8242ab6ff3a3f6899a33215faed","begin_anchor":"初，顗以雅望獲海內盛名，後頗以酒失。為僕","end_anchor":"飲，各大醉。及顗醒，使視客，已腐脅而死。"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p006","source_lines":[107,107],"raw_quote":"　　顗性寬裕而友愛過人，弟嵩嘗因酒嗔目謂顗曰：「君才不及弟，何乃橫得重名！」以所燃蠟燭投之。顗神色無忤，徐曰：「阿奴火攻，固出下策耳。」王導甚重之，嘗枕顗膝而指其腹曰：「此中何所有也？」答曰：「此中空洞無物，然足容卿輩數百人。」導亦不以為忤。又于導坐傲然嘯詠，導云：「卿欲希嵇、阮邪？」顗曰：「何敢近舍明公，遠希嵇、阮。」","raw_quote_sha256":"1517ee44aa5cb53f5729bc2713c743ddaa201b7801d4526bee9f1b09ee59f718","selected_text_sha256":"b886ee33b7850d39f23b2a5d960fb5e331b64fb79633d5e7f749999824d81eb1","begin_anchor":"顗性寬裕而友愛過人，弟嵩嘗因酒嗔目謂顗曰","end_anchor":"？」顗曰：「何敢近舍明公，遠希嵇、阮。」"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p007","source_lines":[109,109],"raw_quote":"　　及王敦構逆，溫嶠謂顗曰：「大將軍此舉似有所在，當無濫邪？」顗曰：「君少年未更事。人主自非堯舜，何能無失，人臣豈可得舉兵以協主！共相推戴，未能數年，一旦如此，豈云非亂乎！處仲剛愎強忍，狼抗無上，其意寧有限邪！」既而王師敗績，顗奉詔詣敦，敦曰：「伯仁，卿負我！」顗曰：「公戎車犯順，下官親率六軍，不能其事，使王旅奔敗，以此負公。」敦憚其辭正，不知所答。帝召顗於廣室，謂之曰：「近日大事，二宮無恙，諸人平安，大將軍故副所望邪？」顗曰：「二宮自如明詔，於臣等故未可知。」護軍長史郝嘏等勸顗避敦，顗曰：「吾備位大臣，朝廷喪敗，寧可復草間求活，外投胡越邪！」俄而與戴若思俱被收，路經太廟，顗大言曰：「天地先帝之靈；賊臣王敦傾覆社稷，枉殺忠臣，陵虐天下，神祇有靈，當速殺敦，無令縱毒，以傾王室。」語未終，收人以戟傷其口，血流至踵，顏色不變，容止自若，觀者皆為流涕。遂于石頭南門外石上害之，時年五十四。","raw_quote_sha256":"590e9977de8ad1a32cda97394637ff348e7063812bfd827a2692539f2d8f0c1e","selected_text_sha256":"d8273bcbdfaa3c8651ec3bc7abc16d0b206f8305214402db8d485fcbc91f1343","begin_anchor":"及王敦構逆，溫嶠謂顗曰：「大將軍此舉似有","end_anchor":"涕。遂于石頭南門外石上害之，時年五十四。"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p008","source_lines":[111,111],"raw_quote":"　　顗之死也，敦坐有一參軍樗蒱，馬於博頭被殺，因謂敦曰：「周家奕世令望，而位不至公，及伯仁將登而墜，有似下官此馬。」敦曰：「伯仁總角於東宮相遇，一面披襟，便許之三事，何圖不幸自貽王法。」敦素憚顗，每見顗輒面熱，雖復冬月，扇面手不得休。敦使繆坦籍顗家，收得素簏數枚，盛故絮而已，酒五甕，米數石，在位者服其清約。敦卒後，追贈左光祿大夫、儀同三司，諡曰康，祀以少牢。","raw_quote_sha256":"7d51c9bb8562293bd62fb381aac1a5eeddb0a2e8cdfe90dc4c24dc9b992e1deb","selected_text_sha256":"9d02f2ab0ecdcdc9118cce550bcfd3324a1b46ba6d14180c56055a683227fae0","begin_anchor":"顗之死也，敦坐有一參軍樗蒱，馬於博頭被殺","end_anchor":"左光祿大夫、儀同三司，諡曰康，祀以少牢。"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p009","source_lines":[113,113],"raw_quote":"　　初，敦之舉兵也，劉隗勸帝盡除諸王，司空導率群從詣闕請罪，值顗將入，導呼顗謂曰：「伯仁，以百口累卿！」顗直入不顧。既見帝，言導忠誠，申救甚至，帝納其言。顗喜飲酒，致醉而出。導猶在門，又呼顗。顗不與言，顧左右曰：「今年殺諸賊奴，取金印如斗大繫肘。」既出，又上表明導，言甚切至。導不知救己，而甚銜之。敦既得志，問導曰：「周顗、戴若思南北之望，當登三司，無所疑也。」導不答。又曰：「若不三司，便應令僕邪？」又不答。敦曰：「若不爾，正當誅爾。」導又無言。導後料檢中書故事，見顗表救己，殷勤款至。導執表流涕，悲不自勝，告其諸子曰：「吾雖不殺伯仁，伯仁由我而死。幽冥之中，負此良友！」顗三子：閔、恬、頤。","raw_quote_sha256":"77ebfb990ca0ccd38c3e15d3ae2d14ea467db2d53b5a5c239da6876db3a1fc95","selected_text_sha256":"ce29d669d7e2c34b5beeca95c3d5248c0bda25ef4534621a7bc40bd34bbdab0f","begin_anchor":"初，敦之舉兵也，劉隗勸帝盡除諸王，司空導","end_anchor":"冥之中，負此良友！」顗三子：閔、恬、頤。"},{"proposed_paragraph_id":"c-jinshu-069-zhouyi:p010","source_lines":[115,115],"raw_quote":"　　閔字子騫，方直有父風。歷衡陽、建安、臨川太守，侍中，中領軍，吏部尚書，尚書左僕射，加中軍將軍，轉護軍，領秘書監。卒，追贈金紫光祿大夫，諡曰烈。無子，以弟頤長子琳為嗣。琳仕至東陽太守。恬、頤並歷卿守。琳少子文，驃騎諮議參軍。","raw_quote_sha256":"9315c7a67c6619ce927a0652260d674293d4b17ef455c386533027de05d67cf9","selected_text_sha256":"5cf1c90928627ddbfb3216a43e577f4a026965745f4cd8523325f49b9ebbce19","begin_anchor":"閔字子騫，方直有父風。歷衡陽、建安、臨川","end_anchor":"恬、頤並歷卿守。琳少子文，驃騎諮議參軍。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
