ons":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangcheng:p005:m0330","kind":"person","start":330,"end":332,"surface":"李才","person_id":"qhk_zup_not","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。","paragraph_id":"c-jinshu-043-wangcheng:p005","chapter_id":"c-jinshu-043-wangcheng"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangcheng:p005","text":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-043-wangcheng:p005:m0000","kind":"person","start":0,"end":1,"surface":"澄","person_id":"ehx_cqg_nfx_BB","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p005:m0031","kind":"person","start":31,"end":33,"surface":"郭舒","person_id":"7mp_r23_bds","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p005:m0055","kind":"person","start":55,"end":56,"surface":"澄","person_id":"ehx_cqg_nfx_BB","status":"contextual_provisional","resolution_note":"依完整敘事角色判讀，原字保留，AI暫定。"},{"id":"c-jinshu-043-wangcheng:p005:m0074","kind":"person","start":74,"end":76,"surface":"王如","person_id":"g90_bfh_702","status":"