hangchang"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-059-zhangchang:p010:m0046","start":46,"end":49,"surface":"永昌王","kind":"person","person_id":"s6w_y37_g3w","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。","paragraph_id":"c-songshu-059-zhangchang:p010","chapter_id":"c-songshu-059-zhangchang"},{"id":"c-songshu-059-zhangchang:p010:m0219","start":219,"end":221,"surface":"永昌","kind":"person","person_id":"s6w_y37_g3w","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。","paragraph_id":"c-songshu-059-zhangchang:p010","chapter_id":"c-songshu-059-zhangchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-059-zhangchang:p010","text":"孝伯又曰長史我是中州人乆處北國自隔華風相去歩武不得致盡邉皆是北人聼我語者長史當深徳我孝伯又曰永昌王魏主從弟自復常鎮長安今領精騎八萬直造淮南壽春乆閉門自固不敢相禦向送劉康祖頭彼之所見王𤣥謨甚是所悉亦是常才耳南國何意作如此任使以致奔敗自入此境七百餘里主人竟不能一相拒逆鄒山之險君家所慿前鋒始得接手崔邪利便藏入穴我間諸将倒曳脚而出之魏主賜其生命今從在此復何以輕脫遣馬文恭至蕭縣使望風退撓邪君家民人甚相忿怨云清平之時賦我租帛至有急難不能相拯暢曰知永昌已過淮南康祖為其所破比有信使無此消息王𤣥謨南土偏将不謂為才但以人為前驅引導耳大軍未至而河冰向合𤣥謨量宜反斾未為失機但因夜回師致戎馬小亂耳我家懸瓠斗城陳憲小将魏主傾國累旬不剋胡盛之偏禆小師衆無一旅始濟融水魏國君臣奔迸僅得免脫滑臺之師無所多愧鄒山小戍雖有微險河畔之民多是新附始慕聖化姦盗未息亦使崔邪利撫之而已今沒虜手何損於國魏主自以十萬師而制一崔邪利方復足言邪聞蕭縣百姓並依山險聊遣馬文恭以十隊示之耳文恭謂前以三隊出還走後大營嵇𤣥敬以百騎至留城魏軍奔敗輕敵致此亦非所衂王境人民列居河畔二國交兵當平加撫養而魏師入境肆行殘虐事生意外由彼無道官不負民民何怨人知入境土百無相拒此自上由太尉神算次在鎮軍聖畧經國之要雖不豫聞然用兵有機間亦不容相語孝伯曰魏主當不圍此城自率衆軍直造瓜歩南事若辦彭城不待圍若不捷彭城亦非所須也我今當南飲江湖以療渇耳暢曰去留之事自適彼懐若虜馬遂得飲江便為無復天道各應反命遲復更悉暢便回還孝伯追曰長史深自愛敬相去歩武恨不執手暢因復謂曰善将愛冀蕩定有期相見無逺君若得還宋朝今為相識之始孝伯曰待此未期","mentions":[{"id":"c-songshu-059-zhangchang:p010:m0000","start":0,"end":2,"surface":"孝伯","kind":"person","person_id":"ecc_b5b_2f4","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p010:m0004","start":4,"end":6,"surface":"長史","kind":"person","person_id":"d50_8f5_wul_AAABA","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p010:m0036","start":36,"end":38,"surface":"長史","kind":"person","person_id":"d50_8f5_wul_AAABA","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p010:m0042","start":42,"end":44,"surface":"孝伯","kind":"person","person_id":"ecc_b5b_2f4","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p010:m0046","start":46,"end":49,"surface":"永昌王","kind":"person","person_id":"s6w_y37_g3w","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p010:m0049","start":49,"end":51,"surface":"魏主","kind":"person","person_id":"d10_1e6_850","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p010:m0082","start":82,"end":85,"surface":"劉康祖","kind":"person","person_id":"kd4_921_4cr","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p010:m0090","start":90,"end":93,"surface":"王𤣥謨","kind":"person","person_id":"31b_fd1_f77","status":"contextual_provisional","interpretation_note":"完整張暢本傳及對話語境判讀；同字不跨篇自動合人，未圖校。"},{"id":"c-songshu-059-zhangchang:p010:m0146","start":146,"end":149,"surface":"崔邪利","kind":"person","