nd":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0342","start":342,"end":344,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0355","start":355,"end":357,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0358","start":358,"end":360,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m011-0372","start":372,"end":374,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-048-chenshe:p006","text":"周文，陳之賢人也，嘗為項燕軍視日，事春申君，自言習兵，陳王與之將軍印，西擊秦。行收兵至關，車千乘，卒數十萬，至戲，軍焉。秦令少府章邯免酈山徒、人奴產子生，悉發以擊楚大軍，盡敗之。周文敗，走出關，止次曹陽二三月。章邯追敗之，復走次澠池十余日。章邯擊，大破之。周文自剄，軍遂不戰。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-048-chenshe:m006-0000","start":0,"end":2,"surface":"周文","kind":"person","person_id":"cbr-p002991","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m006-0011","start":11,"end":13,"surface":"項燕","kind":"person","person_id":"cbr-p002982","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m006-0018","start":18,"end":21,"surface":"春申君","kind":"person","person_id":"cbr-p002965","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m006-0027","start":27,"end":29,"surface":"陳王","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m006-0064","start":64,"end":66,"surface":"章邯","kind":"person","person_id":"cbr-p002992","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m006-0089","start":89,"end":91,"surface":"周文","kind":"person","person_id":"cbr-p002991","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m006-0105","start":105,"end":107,"surface":"章邯","kind":"person","person_id":"cbr-p002992","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m006-0120","start":120,"end":122,"surface":"章邯","kind":"person","person_id":"cbr-p002992","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m006-0128","start":128,"end":130,"surface":"周文","kind":"person","person_id":"cbr-p002991","status":"contextual_provisional"}],"chapter_id":"c-shiji-048-chenshe","book_id":"b-shiji-048","work_id":"w-shiji","source_id":"s-shiji-048-chenshe"},{"id":"c-shiji-048-chenshe:p010","text":"將軍田臧等相與謀曰：「周章軍已破矣，秦兵旦暮至，我圍滎陽城弗能下，秦軍至，必大敗。不如少遺兵，足以守熒一作「滎」陽，悉精兵迎秦軍。今假王驕，不知兵權，不可與計，非誅之，事恐敗。」因相與矯王令以誅吳叔，獻其首於陳王。陳王使使賜田臧楚令尹印，使為上將。田臧乃使諸將李歸等守滎陽城，自以精兵西迎秦軍於敖倉。與戰，田臧死，軍破。章邯進兵擊李歸等滎陽下，破之，李歸等死。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-048-chenshe:m010-0002","start":2,"end":4,"surface":"田臧","kind":"person","person_id":"cbr-p002997","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m010-0011","start":11,"end":13,"surface":"周章","kind":"person","person_id":"cbr-p002991","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m010-0097","start":97,"end":99,"surface":"吳叔","kind":"person","person_id":"cbr-p002980","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m010-0104","start":104,"end":106,"surface":"陳王","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m010-0107","start":107,"end":109,"surface":"陳王","kind":"person","person_id":"cbr-p002979","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m010-0112","start":112,"end":114,"surface":"田臧","kind":"person","person_id":"cbr-p002997","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m010-0124","start":124,"end":126,"surface":"田臧","kind":"person","person_id":"cbr-p002997","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m010-0128","start":128,"end":130,"surface":"諸將","kind":"unresolved","perso