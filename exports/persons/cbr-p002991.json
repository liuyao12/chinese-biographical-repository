vidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p006","quote":"周文，陳之賢人也，嘗為項燕軍視日，事春申君，自言習兵，陳王與之將軍印，西擊秦。行收兵至關，車千乘，卒數十萬，至戲，軍焉。秦令少府章邯免酈山徒、人奴產子生，悉發以擊楚大軍，盡敗之。周文敗，走出關，止次曹陽二三月。章邯追敗之，復走次澠池十余日。章邯擊，大破之。周文自剄，軍遂不戰。"}],"attestations":[{"id":"th-shiji048-013:a001","paragraph_id":"c-shiji-048-chenshe:p006","start":14,"end":16,"surface":"視日","person_mention_id":"c-shiji-048-chenshe:m006-0000","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、自立、既有用稱與冒稱分開；未知任期不由戰敗、被殺、歸報或首次提及推端點。詐稱與矯命不證合法或真實身份，制度種類仍待核。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji048-014","person_id":"cbr-p002991","title":"將軍","kind":"unclassified","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p006","quote":"周文，陳之賢人也，嘗為項燕軍視日，事春申君，自言習兵，陳王與之將軍印，西擊秦。行收兵至關，車千乘，卒數十萬，至戲，軍焉。秦令少府章邯免酈山徒、人奴產子生，悉發以擊楚大軍，盡敗之。周文敗，走出關，止次曹陽二三月。章邯追敗之，復走次澠池十余日。章邯擊，大破之。周文自剄，軍遂不戰。"}],"attestations":[{"id":"th-shiji048-014:a001","paragraph_id":"c-shiji-048-chenshe:p006","start":31,"end":33,"surface":"將軍","person_mention_id":"c-shiji-048-chenshe:m006-0000","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p006","quote":"周文，陳之賢人也，嘗為項燕軍視日，事春申君，自言習兵，陳王與之將軍印，西擊秦。行收兵至關，車千乘，卒數十萬，至戲，軍焉。秦令少府章邯免酈山徒、人奴產子生，悉發以擊楚大軍，盡敗之。周文敗，走出關，止次曹陽二三月。章邯追敗之，復走次澠池十余日。章邯擊，大破之。周文自剄，軍遂不戰。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、自立、既有用稱與冒稱分開；未知任期不由戰敗、被殺、歸報或首次提及推端點。詐稱與矯命不證合法或真實身份，制度種類仍待核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji006-023","person_id":"cbr-p000604","surfaces":["周章","章"],"scope":"same_chapter","chapter_ids":["c-shiji-006-shihuang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p059","quote":"二年冬，陳涉所遣周章等將西至戲，兵數十萬。二世大驚，與群臣謀曰：「柰何？」少府章邯曰：「盜已至，眾彊，今發近縣不及矣。酈山徒多，請赦之，授兵以擊之。」二世乃大赦天下，使章邯將，擊破周章軍而走，遂殺章曹陽。二世益遣長史司馬欣、董翳佐章邯擊盜，殺陳勝城父，破項梁定陶，滅魏咎臨濟。楚地盜名將已死，章邯乃北渡河，擊趙王歇等於鉅鹿。"}],"rationale":"依同一事件的即位稱號、全稱與短名暫定；欣參看前段長史司馬欣，不以章字合併周章與章邯。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji008-014","person_id":"cbr-p000604","surfaces":["周章"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p059","quote":"二年冬，陳涉所遣周章等將西至戲，兵數十萬。二世大驚，與群臣謀曰：「柰何？」少府章邯曰：「盜已至，眾彊，今發近縣不及矣。酈山徒多，請赦之，授兵以擊之。」二世乃大赦天下，使章邯將，擊破周章軍而走，遂殺章曹陽。二世益遣長史司馬欣、董翳佐章邯擊盜，殺陳勝城父，破項梁定陶，滅魏咎臨濟。楚地盜名將已死，章邯乃北渡河，擊趙王歇等於鉅鹿。"},{"paragraph_id":"c-shiji-008-gaozu:p011","quote":"秦二世二年，陳涉之將周章軍西至戲而還。燕、趙、齊、魏皆自立為王。項氏起吳。秦泗川監平將兵圍豐，二日，出與戰，破之。命雍齒守豐，引兵之薛。泗州守壯敗於薛，走至戚，沛公左司馬得泗川守壯，殺之。沛公還軍亢父，至方與，（周市來攻方與）未戰。陳王使魏人周市略地。周市使人謂雍齒曰：「豐，故梁徙也。今魏地已定者數十城。齒今下魏，魏以齒為侯守豐。不下，且屠豐。」雍齒雅不欲屬沛公，及魏招之，即反為魏守豐。沛公引兵攻豐，不能取。沛公病，還之沛。沛公怨雍齒與豐子弟叛之，聞東陽甯君、秦嘉立景駒為假王，在留，乃往從之，欲請兵以攻豐。是時秦將章邯從陳，別將司馬夷將兵北定楚地，屠相，至碭。東陽甯君、沛公引兵西，與戰蕭西，不利。還收兵聚留，引兵攻碭，三日乃取碭。因收碭兵，得五六千人。攻下邑，拔之。還軍豐。聞項梁在薛，從騎百餘往見之。項梁益沛公卒五千人，五大夫將十人。沛公還，引兵攻豐。"}],"rationale":"只在所列原句的秦末楚漢軍事／分封敘事內暫定同指；有前卷錨點時對讀相接事件，不把同名作全庫匹配規則，仍待異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji048-029","person_id":"cbr-p002991","surfaces":["周文","周章"],"scope":"same_chapter","chapter_ids":["c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-048-chenshe:p006","quote":"周文，陳之賢人也，嘗為項燕軍視日，事春申君，自言習兵，陳王與之將軍印，西擊秦。行收兵至關，車千乘，卒數十萬，至戲，軍焉。秦令少府章邯免酈山徒、人奴產子生，悉發以擊楚大軍，盡敗之。周文敗，走出關，止次曹陽二三月。章邯追敗之，復走次澠池十余日。章邯擊，大破之。周文自剄，軍遂不戰。"},{"paragraph_id":"c-shiji-048-chenshe:p010","quote":"將軍田臧等相與謀曰：「周章軍已破矣，秦兵旦暮至，我圍滎陽城弗能下，秦軍至，必大敗。不如少遺兵，足以守熒一作「滎」陽，悉精兵迎秦軍。今假王驕，不知兵權，不可與計，非誅之，事恐敗。」因相與矯王令以誅吳叔，獻其首於陳王。陳王使使賜田臧楚令尹印，使為上將。田臧乃使諸將李歸等守滎陽城，自以精兵西迎秦軍於敖倉。與戰，田臧死，軍破。章邯進兵擊李歸等滎陽下，破之，李歸等死。"}],"rationale":"限明示名、字及局部軍事角色；陳勝涉、吳廣叔、蔡賜房君與周文周章暫接，吳廣韓廣分開。引文四君短稱及比擬人物另留候選，詐稱扶蘇項燕不合陳吳，褚賈署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji048-zhou","person_ids":["cbr-p000604","cbr-p002991"],"canonical_person_id":"cbr-p000604","scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p059","quote":"二年冬，陳涉所遣周章等將西至戲，兵數十萬。二世大驚，與群臣謀曰：「柰何？」少府章邯曰：「盜已至，眾彊，今發近縣不及矣。酈山徒多，請赦之，授兵以擊之。」二世乃大赦天下，使章邯將，擊破周章軍而走，遂殺章曹陽。二世益遣長史司馬欣、董翳佐章邯擊盜，殺陳勝城父，破項梁定陶，滅魏咎臨濟。楚地盜名將已死，章邯乃北渡河，擊趙王歇等於鉅鹿。","mention_ids":["c-shiji-006-shihuang:p059:m0008","c-shiji-006-shihuang:p059:m0090","c-shiji-006-shihuang:p059:m0098"]},{"chapter_id":"c-shiji-048-chenshe","source_id":"s-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p006","quote":"周文，陳之賢人也，嘗為項燕軍視日，事春申君，自言習兵，陳王與之將軍印，西擊秦。行收兵至關，車千乘，卒數十萬，至戲，軍焉。秦令少府章邯免酈山徒、人奴產子生，悉發以擊楚大軍，盡敗之。周文敗，走出關，止次曹陽二三月。章邯追敗之，復走次澠池十余日。章邯擊，大破之。周文自剄，軍遂不戰。","mention_ids":["c-shiji-048-chenshe:m006-0000","c-shiji-048-chenshe:m006-0089","c-shiji-048-chenshe:m006-0128"]}],"rationale":"兩篇同記陳王所遣西軍至戲、被章邯所破與曹陽敗退；死亡地點與方式差異不選定，依配對人物、角色與事件暫同指。各已發ID保留，篇章不當獨立見證，不選定事實、年代或來源優先。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-006-shihuang:p059","text":"二年冬，陳涉所遣周章等將西至戲，兵數十萬。二世大驚，與群臣謀曰：「柰何？」少府章邯曰：「盜已至，眾彊，今發近縣不及矣。酈山徒多，請赦之，授兵以擊之。」二世乃大赦天下，使章邯將，擊破周章軍而走，遂殺章曹陽。二世益遣長史司馬欣、董翳佐章邯擊盜，殺陳勝城父，破項梁定陶，滅魏咎臨濟。楚地盜名將已死，章邯乃北渡河，擊趙王歇等於鉅鹿。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p059:m0004","start":4,"end":6,"surface":"陳涉","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p059:m0008","start":8,"end":10,"surface":"周章","kind":"person","person_id":"cbr-p000604","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p059:m0021","start":21,"end":23,"sur