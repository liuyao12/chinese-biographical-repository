:[9505,9506,9507,9508,9509,9510,9511,9512,9513,9514,9515,9516,9517,9518,9519,9520,9521,9522,9523,9524,9525,9526,9527,9528,9529,9530,9531,9532,9533,9534,9535,9536,9537,9538,9539,9540,9541,9542,9543,9544,9545,9546,9547,9548,9549,9550,9551,9552,9553,9554,9555,9556,9557,9558,9559,9560,9561,9562,9563,9564,9565,9566,9567,9568,9569,9570,9571,9572,9573,9574,9575,9576,9577,9578,9579,9580,9581,9582,9583,9584,9585,9586,9587,9588,9589,9590,9591,9592,9593,9594,9595,9596,9597,9598,9599,9600,9601,9602,9603,9604,9605,9606,9607,9608,9609]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"吳錄","attribution_marker":"吴录曰","reading":"裴注明列所引文獻。","quoted_work":"吳錄"},"attachment":{"received_paragraph_id":"c-sanguozhi-052-zhugejin-complete:line070","received_codepoint":249,"note_ordinal":3,"source_ordinal":1},"chapter_id":"c-sanguozhi-052-zhugejin-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhugejin-complete"},{"id":"c-sanguozhi-058-luxun:line023","text":"黃武元年，劉備率大眾來向西界，權命遜為大都督、假節，督朱然、潘璋、宋謙、韓當、徐盛、鮮于丹、孫桓等五萬人拒之。備從巫峽、建平連圍至夷陵界，立數十屯，以金錦爵賞誘動諸夷，使將軍馮習為大督，張南為前部，輔匡，趙融、廖淳、傅肜等各為別督，先遣吳班將數千人於平地立營，欲以挑戰。諸將皆欲擊之，遜曰：「此必有譎，且觀之。」備知其計不可，乃引伏兵八千，從谷中出。遜曰：「所以不聽諸君擊班者，揣之必有巧故也。」遜上疏曰：","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line023:m0006","start":6,"end":7,"surface":"備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line023:m0015","start":15,"end":16,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line023:m0017","start":17,"end":18,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line023:m0027","start":27,"end":29,"surface":"朱然","kind":"person","person_id":"tut_0t1_tb8","status":"contextual_provisional