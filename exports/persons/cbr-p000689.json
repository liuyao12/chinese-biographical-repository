{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000689","canonical_person_id":"sd6_kzw_afm","id_aliases":["cbr-p000689"],"identity_policy":"contextual_provisional","person_ids":["sd6_kzw_afm"],"persons":[{"id":"sd6_kzw_afm","label":"鯫生（沛公所引）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"鯫生","mention_ids":["c-shiji-007-xiangyu:m017-0138"]}],"evidence":[{"mention_id":"c-shiji-007-xiangyu:m017-0138","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p017","quote":"鯫生"}],"id_aliases":["cbr-p000689"]}],"source_mention_summary":[{"source_id":"s-shiji-007-xiangyu","work_id":"w-shiji","book_id":"b-shiji-007","chapter_id":"c-shiji-007-xiangyu","mention_count":1,"mention_ids":["c-shiji-007-xiangyu:m017-0138"],"paragraph_ids":["c-shiji-007-xiangyu:p017"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-007-xiangyu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-007-xiangyu:m017-0138","start":138,"end":140,"surface":"鯫生","kind":"person","person_id":"sd6_kzw_afm","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p017","chapter_id":"c-shiji-007-xiangyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p017","text":"楚左尹項伯者，項羽季父也，素善留侯張良。張良是時從沛公，項伯乃夜馳之沛公軍，私見張良，具告以事，欲呼張良與俱去。曰：「毋從俱死也。」張良曰：「臣為韓王送沛公，沛公今事有急，亡去不義，不可不語。」良乃入，具告沛公。沛公大驚，曰：「為之柰何？」張良曰：「誰為大王為此計者？」曰：「鯫生說我曰『距關，毋內諸侯，秦地可盡王也』。故聽之。」良曰：「料大王士卒足以當項王乎？」沛公默然，曰：「固不如也，且為之柰何？」張良曰：「請往謂項伯，言沛公不敢背項王也。」沛公曰：「君安與項伯有故？」張良曰：「秦時與臣游，項伯殺人，臣活之。今事有急，故幸來告良。」沛公曰「孰與君少長？」良曰：「長於臣。」沛公曰「君為我呼入，吾得兄事之。」張良出，要項伯。項伯即入見沛公。沛公奉巵酒為壽，約為婚姻，曰：「吾入關，秋豪不敢有所近，籍吏民，封府庫，而待將軍。所以遣將守關者，備他盜之出入與非常也。日夜望將軍至，豈敢反乎！願伯具言臣之不敢倍德也。」項伯許諾。謂沛公曰：「旦日不可不蚤自來謝項王。」沛公曰：「諾。」於是項伯復夜去，至軍中，具以沛公言報項王。因言曰：「沛公不先破關中，公豈敢入乎？今人有大功而擊之，不義也，不如因善遇之。」項王許諾。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m017-0003","start":3,"end":5,"surface":"項伯","kind":"person","person_id":"cyi_wjz_uxt","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0007","start":7,"end":9,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0015","start":15,"end":19,"surface":"留侯張良","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0020","start":20,"end":22,"surface":"張良","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0025","start":25,"end":27,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0028","start":28,"end":30,"surface":"項伯","kind":"person","person_id":"cyi_wjz_uxt","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0034","start":34,"end":36,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0040","start":40,"end":42,"surface":"張良","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0050","start":50,"end":52,"surface":"張良","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0066","start":66,"end":68,"surface":"張良","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m017-0