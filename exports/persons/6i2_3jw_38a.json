":"c-nanshi-011-helingwan-family:p004:r0001"},{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p004","quote":"兄","kind":"person_reference","mention_id":"c-songshu-041-helingwan-family:p004:r0001"}],"review":"ai_provisional","identity_note":"宋書稱瑀兄子亮；南史稱瑀兄子衍。所據原句未具其名。"},{"id":"6i2_3jw_38a_A","label":"何亮（何瑀兄子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"亮","mention_ids":["c-songshu-041-helingwan-family:p004:m0003","c-songshu-041-helingwan-family:p004:m0045","c-songshu-041-helingwan-family:p004:m0057"]}],"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p004","quote":"亮","mention_id":"c-songshu-041-helingwan-family:p004:m0003"},{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p004","quote":"亮","mention_id":"c-songshu-041-helingwan-family:p004:m0045"},{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p004","quote":"亮","mention_id":"c-songshu-041-helingwan-family:p004:m0057"}],"review":"ai_provisional","identity_note":"宋書明書何瑀兄子亮，與弟恢、誕、衍的長幼逐節記。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"6i2_3jw_38a","source_assertion_id":"a-nanshi011-helingwan-s-brothers-son","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p004","quote":"瑀兄子亮，孝建初，為桂陽太守。丞相南郡王義宣為逆，遣參軍王師壽斷桂陽道，以防廣州刺史宗慤，亮收斬之。官至新安內史。亮弟恢，廢帝元徽初，為廣州剌史，未之鎮，坐國哀朞晦不到，免官。復起為都官尚書，未拜，卒。恢弟誕，司徒右長史。誕弟衍，最知名。性躁動。太宗初，為建安王休仁司徒從事中郎，仍除黃門郎。未拜竟，求轉司徒司馬。得司馬，復求太子右率。拜右率一二日，復求侍中。旬日之間，求進無已。不得侍中，以怨詈賜死。","subject_person_mention_id":"c-songshu-041-helingwan-family:p004:m0003","object_person_reference_id":"c-songshu-041-helingwan-family:p004:r0001","relationship_anchor":{"paragraph_id":"c-songshu-041-helingwan-family:p004","surface":"瑀兄子亮","start":0,"end":4}}],"status":"contextual_provisional","interpretation_note":"兄字指瑀之兄，子字所繫為原文所指兄子。","human_reviewed":false}},{"id":"6i2_3jw_38a_D","label":"何衍（何瑀兄子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"衍","mention_ids":["c-nanshi-011-helingwan-family:p004:m0003","c-songshu-041-helingwan-family:p004:m0113"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-011","source_id":"s-nanshi-011-helingwan-family-ws2288359","chapter_id":"c-nanshi-011-helingwan-family","paragraph_id":"c-nanshi-011-helingwan-family:p004","quote":"衍","mention_id":"c-nanshi-011-helingwan-family:p004:m0003"},{"work_id":"w-songshu","book_id":"b-songshu-041","source_id":"s-songshu-041-helingwan-family-ws2634831","chapter_id":"c-songshu-041-helingwan-family","paragraph_id":"c-songshu-041-helingwan-family:p004","quote":"衍","mention_id":"c-songshu-041-helingwan-family:p004:m0113"}],"review":"ai_provisional","identity_note":"南史稱瑀兄子衍，宋書另說誕弟衍。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"6i2_3jw_38a","source_assertion_id":"a-nanshi011-helingwan-m-brothers-son","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-011","source_id":"s-nanshi-011-helingwan-family-ws2288359","chapter_id":"c-nanshi-011-helingwan-family","paragraph_id":"c-nanshi-011-helingwan-family:p004","quote":"瑀兄子衍性躁動，位黃門郎，拜竟，求司徒司馬；得司馬，復求太子右率；拜一二日，復求侍中。旬日之間，求進無已。不得侍中，以怨詈賜死。","subject_person_mention_id":"c-nanshi-011-helingwan-family:p004:m0003","object_person_reference_id":"c-nanshi-011-helingwan-family:p004:r0001","relationship_anchor":{"paragraph_id":"c-n