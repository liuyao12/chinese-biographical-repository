tity_decisions":[{"id":"d-shiji035-088","person_id":"tic_otw_oo2","surfaces":["孔父"],"scope":"same_chapter","chapter_ids":["c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p031","quote":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji037-046","person_id":"tic_otw_oo2","surfaces":["孔父"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-037-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p031","quote":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。"},{"paragraph_id":"c-shiji-037-wei:p012","quote":"宣公七年，魯弒其君隱公。九年，宋督弒其君殤公，及孔父。十年，晉曲沃莊伯弒其君哀侯。"}],"rationale":"宋督弒殤公、孔父的具體同一事件，與管蔡篇宋華父督弒殤公及大夫孔父相接；保留宋督的本篇字形，不按督字全域合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji038-047","person_id":"tic_otw_oo2","surfaces":["大司馬孔父","大司馬孔父嘉","孔父"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p031","quote":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。"},{"paragraph_id":"c-shiji-038-song:p029","quote":"穆公九年，病，召大司馬孔父謂曰：「先君宣公捨太子與夷而立我，我不敢忘。我死，必立與夷也。」孔父曰：「羣臣皆願立公子馮。」穆公曰：「毋立馮，吾不可以負宣公。」於是穆公使馮出居于鄭。八月庚辰，穆公卒，兄宣公子與夷立，是爲殤公。君子聞之，曰：「宋宣公可謂知人矣，立其弟以成義，然卒其子復享之。"},{"paragraph_id":"c-shiji-038-song:p031","quote":"九年，大司馬孔父嘉妻好，出，道遇太宰華督，督說，目而觀之。督利孔父妻，乃使人宣言國中曰：「殤公即位十年耳，而十一戰，民苦不堪，皆孔父爲之，我且殺孔父以寧民。」是歲，魯弒其君隱公。十年，華督攻殺孔父，取其妻。殤公怒，遂弒殤公，而迎穆公子馮於鄭而立之，是爲莊公。"}],"rationale":"宋督殺孔父並弒殤公的同一具體事件，與管蔡／衛篇宋華父督、孔父暫接；孔父嘉、大司馬及太宰華督是本篇明示用稱，未由姓補其他傳記。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-035-guancai:p031","text":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji