{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003858","identity_policy":"contextual_provisional","person_ids":["cbr-p003858"],"persons":[{"id":"cbr-p003858","label":"太史公（伍胥列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"太史公","mention_ids":["c-shiji-066-wu:m024-0000"]}],"evidence":[{"mention_id":"c-shiji-066-wu:m024-0000","chapter_id":"c-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p024","quote":"太史公"}]}],"mentions":[{"id":"c-shiji-066-wu:m024-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p003858","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p024","chapter_id":"c-shiji-066-wu"}],"relations":[],"title_holdings":[{"id":"th-shiji066-027","person_id":"cbr-p003858","title":"太史公","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p024","quote":"太史公曰：怨毒之於人甚矣哉！王者尚不能行之於臣下，況同列乎！向令伍子胥從奢俱死，何異螻蟻。棄小義，雪大恥，名垂於後世，悲夫！方子胥窘於江上，道乞食，志豈嘗須臾忘郢邪？故隱忍就功名，非烈丈夫孰能致此哉？白公如不自立為君者，其功謀亦不可勝道者哉！"}],"attestations":[{"id":"th-shiji066-027:a001","paragraph_id":"c-shiji-066-wu:p024","start":0,"end":3,"surface":"太史公","person_mention_id":"c-shiji-066-wu:m024-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官事件與文獻用稱分存。首次提及、逃亡、死亡不推定任期終點；平王、昭王、闔廬、夫差王稱隨敘事分辨。夫概自立王不作合法授爵，封堂谿未補侯爵；王子綦佯充王及石乞事成為卿的未遂條件均不當實際任職。白公的號與封邑分存，未確定爵級。來源相對年序未換算為精確紀年，版本及稱號性質仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-051","person_id":"cbr-p003858","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["太史公"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p024","quote":"太史公曰：怨毒之於人甚矣哉！王者尚不能行之於臣下，況同列乎！向令伍子胥從奢俱死，何異螻蟻。棄小義，雪大恥，名垂於後世，悲夫！方子胥窘於江上，道乞食，志豈嘗須臾忘郢邪？故隱忍就功名，非烈丈夫孰能致此哉？白公如不自立為君者，其功謀亦不可勝道者哉！"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-066-wu:p024","text":"太史公曰：怨毒之於人甚矣哉！王者尚不能行之於臣下，況同列乎！向令伍子胥從奢俱死，何異螻蟻。棄小義，雪大恥，名垂於後世，悲夫！方子胥窘於江上，道乞食，志豈嘗須臾忘郢邪？故隱忍就功名，非烈丈夫孰能致此哉？白公如不自立為君者，其功謀亦不可勝道者哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m024-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"cbr-p003858","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m024-0014","start":14,"end":16,"surface":"王者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m024-0022","start":22,"end":24,"surface":"臣下","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m024-0026","start":26,"end":28,"surface":"同列","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m024-0032","start":32,"end":35,"surface":"伍子胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m024-0036","start":36,"end":37,"surface":"奢","kind":"person","person_id":"cbr-p003809","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m024-0056","start":56,"end":58,"surface":"後世","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m024-0063","start":63,"end":65,"surface":"子胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m024-0091","start":91,"end":94,"surface":"烈丈夫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m024-0100","s