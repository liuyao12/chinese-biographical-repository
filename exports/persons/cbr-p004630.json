{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004630","identity_policy":"contextual_provisional","person_ids":["cbr-p004630"],"persons":[{"id":"cbr-p004630","label":"龐暖（廉頗藺相如列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"龐暖","mention_ids":["c-shiji-081-lianlin:m025-0032"]}],"evidence":[{"mention_id":"c-shiji-081-lianlin:m025-0032","chapter_id":"c-shiji-081-lianlin","paragraph_id":"c-shiji-081-lianlin:p025","quote":"龐暖"}]}],"mentions":[{"id":"c-shiji-081-lianlin:m025-0032","start":32,"end":34,"surface":"龐暖","kind":"person","person_id":"cbr-p004630","status":"contextual_provisional","paragraph_id":"c-shiji-081-lianlin:p025","chapter_id":"c-shiji-081-lianlin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji081-031","person_id":"cbr-p004630","scope":"same_chapter","chapter_ids":["c-shiji-081-lianlin"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["龐暖"],"evidence":[{"paragraph_id":"c-shiji-081-lianlin:p025","quote":"趙悼襄王元年，廉頗既亡入魏，趙使李牧攻燕，拔武遂、方城。居二年，龐暖破燕軍，殺劇辛。後七年，秦破殺趙將扈輒於武遂，斬首十萬。趙乃以李牧爲大將軍，撃秦軍於宜安，大破秦軍，走秦將桓齮。封李牧爲武安君。居三年，秦攻番吾，李牧撃破秦軍，南距韓、魏。"}],"rationale":"依本篇明示姓名、國別君序與代將敘事暫接；李牧牧在明示北邊主題內同指，趙王遷王稱限定末次代將。北邊早年趙王、他人及單于未名分存，不強接悼襄；太史公讓頗承接廉藺敘事，其他引語指代待逐處覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-081-lianlin:p025","text":"趙悼襄王元年，廉頗既亡入魏，趙使李牧攻燕，拔武遂、方城。居二年，龐暖破燕軍，殺劇辛。後七年，秦破殺趙將扈輒於武遂，斬首十萬。趙乃以李牧爲大將軍，撃秦軍於宜安，大破秦軍，走秦將桓齮。封李牧爲武安君。居三年，秦攻番吾，李牧撃破秦軍，南距韓、魏。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m025-0000","start":0,"end":4,"surface":"趙悼襄王","kind":"person","person_id":"cbr-p004623","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m025-0007","start":7,"end":9,"surface":"廉頗","kind":"person","person_id":"cbr-p004600","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m025-0016","start":16,"end":18,"surfa