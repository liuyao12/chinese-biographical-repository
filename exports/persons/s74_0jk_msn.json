ual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"},{"id":"c-sanguozhi-009-caozhen:p009:m0579","start":579,"end":581,"surface":"太傅","kind":"person","person_id":"dkn_ge4_286_AAAA","status":"contextual_provisional","interpretation_note":"完整曹真曹爽敘事與本段引文語境辨識；AI判讀，未圖校。"}],"annotation_status":"in_progress","text_layer":"witness_appended_pei_songzhi_note","source_position":{"raw_line_range":[360,375],"kind":"fixed_witness_contiguous_extraction","raw_projection_ref":"source-evidence/sgz009-caozhen-recovery/projection.json","unit_key":"p009","revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","source_unit_id":"sgz009-caozhen-full","biography_subject_person_id":"30k_jzz_tpd_A","annotator":"裴松之","attribution":"裴注轉引或案語，非陳壽正文；未親見所引原書。","cited_work":"魏書","projected_start":1032,"projected_end":1613,"attached_note_to_paragraph_id":"c-sanguozhi-009-caozhen:p008","reported_attributions":[{"offset":0,"literal":"魏書曰"}]},"chapter_id":"c-sanguozhi-009-caozhen","book_id":"b-sanguozhi-009","work_id":"w-sanguozhi","source_id":"s-sanguozhi-009-caozhen"},{"id":"c-shiji-004-zhou:p023","text":"成王在豐，使召公復營洛邑，如武王之意。周公復卜申視，卒營筑，居九鼎焉。曰：「此天下之中，四方入貢道里均。」作《召誥》、《洛誥》。成王既遷殷遺民，周公以王命告，作《多士》、《無佚》。召公為保，周公為師，東伐淮夷，殘奄，遷其君薄泵。成王自奄歸，在宗周，作《多方》。既絀殷命，襲淮夷，歸在豐，作《周官》。興正禮樂，度制於是改，而民和睦，頌聲興。成王既伐東夷，息慎來賀，王賜榮伯作《賄息慎之命》。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m023-0000","start":0,"end":2,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0006","start":6,"end":8,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0014","start":14,"end":16,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0019","start":19,"end":21,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0064","start":64,"end":66,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0072","start":72,"end":74,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0090","start":90,"end":92,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0095","start":95,"end":97,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0109","start":109,"end":111,"surface":"其君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m023-0114","start":114,"end":116,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0169","start":169,"end":171,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0183","start":183,"end":185,"surface":"榮伯","kind":"person","person_id":"fe0_6ra_d9a","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p034","text":"王行暴虐侈傲，國人謗王。召公諫曰：「民不堪命矣。」王怒，得衛巫，使監謗者，以告則殺之。其謗鮮矣，諸侯不朝。三十四年，王益嚴，國人莫敢言，道路以目。厲王喜，告召公曰：「吾能弭謗矣，乃不敢言。」召公曰：「是鄣之也。防民之口，甚於防水。水壅而潰，傷人必多，民亦如之。是故為水者決之使導，為民者宣之使言。故天子聽政，使公卿至於列士獻詩，瞽獻曲，史獻書，師箴，瞍賦，矇誦，百工諫，庶人傳語，近臣盡規，親戚補察，瞽史教誨，耆艾修之，而後王斟酌焉，是以事行而不悖。民之有口也，猶土之有山川也，財用於是乎出：猶其有原隰衍沃也，衣食於是乎生。口之宣言也，善敗於是乎興。行善而備敗，所以產財用衣食者也。夫民慮之於心而宣之於口，成而行之。若壅其口，其與能幾何？」王不聽。於是國莫敢出言，三年，乃相與畔，襲厲王。厲王出奔於彘。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m034-0012","start":12,"end":14,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0029","start":29,"end":31,"surface":"衛巫","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m034-0073","start":73,"end":75,"surface":"厲王","kind":"person","person_id":"jps_m3k_hu4","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0078","start":78,"end":80,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0095","start":95,"end":97,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0341","start":341,"end":343,"surface":"厲王","kind":"person","person_id":"jps_m3k_hu4","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0344","start":344,"end":346,"surface":"厲王","kind":"person","person_id":"jps_m3k_hu4","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p035","text":"厲王太子靜匿召公之家，國人聞之，乃圍之。召公曰：「昔吾驟諫王，王不從，以及此難也。今殺王太子，王其以我為讎而懟怒乎？夫事君者，險而不讎懟，怨而不怒，況事王乎！」乃以其子代王太子，太子竟得脫。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m035-0000","start":0,"end":2,"surface":"厲王","kind":"person","person_id":"jps_m3k_hu4","status":"source_identified"},{"id":"c-shiji-004-zhou:m035-0002","start":2,"end":5,"surface":"太子靜","kind":"person","person_id":"lt5_gcv_iqh","status":"source_identified"},{"id":"c-shiji-004-zhou:m035-0006","start":6,"end":8,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified"},{"id":"c-shiji-004-zhou:m035-0020","start":20,"end":22,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified"},{"id":"c-shiji-004-zhou:m035-0082","start":82,"end":84,"surface":"其子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p036","text":"召公、周公二相行政，號曰「共和」。共和十四年，厲王死于彘。太子靜長於召公家，二相乃共立之為王，是為宣王。宣王即位，二相輔之，修政，法文、武、成、康之遺風，諸侯復宗周。十二年，魯武公來朝。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-00