s_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-004-zhou:m034-0012","start":12,"end":14,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p034","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m034-0078","start":78,"end":80,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p034","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m034-0095","start":95,"end":97,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p034","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m035-0006","start":6,"end":8,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p035","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m035-0020","start":20,"end":22,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p035","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m036-0000","start":0,"end":2,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p036","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m036-0034","start":34,"end":36,"surface":"召公","kind":"person","person_id":"s74_0jk_msn","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p036","chapter_id":"c-shiji-004-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"identity_distinctions":[{"id":"d-shiji004-distinct-002","person_ids":["7m7_qvm_4oj","s74_0jk_msn"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p023","quote":"成王在豐，使召公復營洛邑，如武王之意。周公復卜申視，卒營筑，居九鼎焉。曰：「此天下之中，四方入貢道里均。」作《召誥》、《洛誥》。成王既遷殷遺民，周公以王命告，作《多士》、《無佚》。召公為保，周公為師，東伐淮夷，殘奄，遷其君薄泵。成王自奄歸，在宗周，作《多方》。既絀殷命，襲淮夷，歸在豐，作《周官》。興正禮樂，度制於是改，而民和睦，頌聲興。成王既伐東夷，息慎來賀，王賜榮伯作《賄息慎之命》。","chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou"},{"paragraph_id":"c-shiji-004-zhou:p034","quote":"王行暴虐侈傲，國人謗王。召公諫曰：「民不堪命矣。」王怒，得衛巫，使監謗者，以告則殺之。其謗鮮矣，諸侯不朝。三十四年，王益嚴，國人莫敢言，道路以目。厲王喜，告召公曰：「吾能弭謗矣，乃不敢言。」召公曰：「是鄣之也。防民之口，甚於防水。水壅而潰，傷人必多，民亦如之。是故為水者決之使導，為民者宣之使言。故天子聽政，使公卿至於列士獻詩，瞽獻曲，史獻書，師箴，瞍賦，矇誦，百工諫，庶人傳語，近臣盡規，親戚補察，瞽史教誨，耆艾修之，而後王斟酌焉，是以事行而不悖。民之有口也，猶土之有山川也，財用於是乎出：猶其有原隰衍沃也，衣食於是乎生。口之宣言也，善敗於是乎興。行善而備敗，所以產財用衣食者也。夫民慮之於心而宣之於口，成而行之。若壅其口，其與能幾何？」王不聽。於是國莫敢出言，三年，乃相與畔，襲厲王。厲王出奔於彘。","chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou"}],"rationale":"成王時與厲王時的召公按敘事時代分開；未以世襲稱呼推定為同一人。","reviewer":"Codex（AI 代理）"}],"passages":[{"id":"c-shiji-004-zhou:p023","text":"成王在豐，使召公復營洛邑，如武王之意。周公復卜申視，卒營筑，居九鼎焉。曰：「此天下之中，四方入貢道里均。」作《召誥》、《洛誥》。成王既遷殷遺民，周公以王命告，作《多士》、《無佚》。召公為保，周公為師，東伐淮夷，殘奄，遷其君薄泵。成王自奄歸，在宗周，作《多方》。既絀殷命，襲淮夷，歸在豐，作《周官》。興正禮樂，度制於是改，而民和睦，頌聲興。成王既伐東夷，息慎來賀，王賜榮伯作《賄息慎之命》。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-004-zhou:m023-0000","start":0,"end":2,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0006","start":6,"end":8,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0014","start":14,"end":16,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0019","start":19,"end":21,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0064","start":64,"end":66,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0072","start":72,"end":74,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","stat