{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005160","identity_policy":"contextual_provisional","person_ids":["cbr-p005160"],"persons":[{"id":"cbr-p005160","label":"周苛（韓信盧綰列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"周苛","mention_ids":["c-shiji-093-hanlu:m003-0120"]}],"evidence":[{"mention_id":"c-shiji-093-hanlu:m003-0120","chapter_id":"c-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p003","quote":"周苛"}]}],"mentions":[{"id":"c-shiji-093-hanlu:m003-0120","start":120,"end":122,"surface":"周苛","kind":"person","person_id":"cbr-p005160","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p003","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-010","person_id":"cbr-p005160","surfaces":["周苛"],"scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-093-hanlu:p003","quote":"項籍之封諸王皆就國，韓王成以不從無功，不遣就國，更以為列侯。及聞漢遣韓信略韓地，乃令故項籍游吳時吳令鄭昌為韓王以距漢。漢二年，韓信略定韓十餘城。漢王至河南，韓信急擊韓王昌陽城。昌降，漢王乃立韓信為韓王，常將韓兵從。三年，漢王出滎陽，韓王信、周苛等守滎陽。及楚敗滎陽，信降楚，已而得亡，復歸漢，漢復立以為韓王，竟從擊破項籍，天下定。五年春，遂與剖符為韓王，王潁川。"}],"rationale":"按韓王信開篇姓名及局部王序兵事承接；成昌與信分人，不按同名合併淮陰侯韓信。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-093-hanlu:p003","text":"項籍之封諸王皆就國，韓王成以不從無功，不遣就國，更以為列侯。及聞漢遣韓信略韓地，乃令故項籍游吳時吳令鄭昌為韓王以距漢。漢二年，韓信略定韓十餘城。漢王至河南，韓信急擊韓王昌陽城。昌降，漢王乃立韓信為韓王，常將韓兵從。三年，漢王出滎陽，韓王信、周苛等守滎陽。及楚敗滎陽，信降楚，已而得亡，復歸漢，漢復立以為韓王，竟從擊破項籍，天下定。五年春，遂與剖符為韓王，王潁川。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m003-0000","start":0,"end":2,"surface":"項籍","kind":"person","person_id":"cbr-p005159","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m003-0010","start":10,"end":13,"surface":"韓王成","kind":"person","person_id":"cbr-p005151","status":"contextual_provisional"},{"id":"c-shiji-093-h