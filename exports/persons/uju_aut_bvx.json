point":259,"end_codepoint":271,"human_reviewed":false,"chapter_id":"c-jinshu-070-zhongya","source_id":"s-jinshu-070-zhongya-ws2595540"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin070-zhongdan","person_id":"uju_aut_bvx","event_type":"death","source_term":"早卒","source_anchor":{"paragraph_id":"c-jinshu-070-zhongya:p005","start":269,"end":271,"surface":"早卒"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-zhongya","source_id":"s-jinshu-070-zhongya-ws2595540","paragraph_id":"c-jinshu-070-zhongya:p005","quote":"蘇峻之難，詔雅爲前鋒監軍、假節，領精勇千人以距峻。雅以兵少，不敢擊，退還。拜侍中。尋王師敗績，雅與劉超並侍衛天子。或謂雅曰：「見可而進，知難而退，古之道也。君性亮直，必不容於寇讎，何不隨時之宜而坐待其斃。」雅曰：「國亂不能匡，君危不能濟，各遜遁以求免，吾懼董狐執簡而至矣。」庾亮臨去，顧謂雅曰：「後事深以相委。」雅曰：「棟折榱崩，誰之責也？」亮曰：「今日之事，不容復言，卿當期剋復之效耳。」雅曰：「想足下不愧荀林父耳。」及峻逼遷車駕幸石頭，雅、超流涕步從。明年，並爲賊所害。賊平，追贈光祿勳。其後以家貧，詔賜布帛百匹。子誕，位至中軍參軍，早卒。","person_mention_id":"c-jinshu-070-zhongya:p005:m0260"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-070-zhongya:p005:m0260","surface":"誕","start":260,"end":261,"person_id":"uju_aut_bvx","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-zhongya:p005","chapter_id":"c-jinshu-070-zhongya"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-zhongya:p005","text":"蘇峻之難，詔雅爲前鋒監軍、假節，領精勇千人以距峻。雅以兵少，不敢擊，退還。拜侍中。尋王師敗績，雅與劉超並侍衛天子。或謂雅曰：「見可而進，知難而退，古之道也。君性亮直，必不容於寇讎，何不隨時之宜而坐待其斃。」雅曰：「國亂不能匡，君危不能濟，各遜遁以求免，吾懼董狐執簡而至矣。」庾亮臨去，顧謂雅曰：「後事深以相委。」雅曰：「棟折榱崩，誰之責也？」亮曰：「今日之事，不容復言，卿當期剋復之效耳。」雅曰：「想足下不愧荀林父耳。」及峻逼遷車駕幸石頭，雅、超流涕步從。明年，並爲賊所害。賊平，追贈光祿勳。其後以家貧，詔賜布帛百匹。子誕，位至中軍參軍，早卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":119,"last_line":119,"raw_start":12062,"raw_end":12341,"raw_character_offsets":[12069,12070,12071,12072,12073,12074,12075,12076,12077,12078,12079,12080,12081,12082,12083,12084,12085,12086,12087,12088,12089,12090,12091,12092,12093,12094,12095,12096,12097,12098,12099,12100,12101,12102,12103,12104,12105,12106,12107,12108,12109,12110,12111,12112,12113,12114,12115,12116,12117,12118,12119,12120,12121,12122,12123,12124,12125,12126,12127,12128,12129,12130,12131,12132,12133,12134,12135,12136,12137,12138,12139,12140,12141,12142,12143,12144,12145,12146,12147,12148,12149,12150,12151,12152,12153,12154,12155,12156,12157,12158,12159,12160,12161,12162,12163,12164,12165,12166,12167,12168,12169,12170,12171,12172,12173,12174,12175,12176,12177,12178,12179,12180,12181,12182,12183,12184,12185,12186,12187,12188,12189,12190,12191,12192,12193,12194,12195,12196,12197,12198,12199,12200,12201,12202,12203,12204,12205,12206,12207,12208,12209,12210,12211,12212,12213,12214,12215,12216,12217,12218,12219,12220,12221,12222,12223,12224,12225,12226,12227,12228,12229,12230,12231,12232,12233,12234,12235,12236,12237,12238,12239,12240,12241,12242,12243,12244,12245,12246,12247,12248,12249,12250,12251,12252,12253,12254,12255,12256,12257,12258,12259,12260,12261,12262,12263,12264,12265,12266,12267,12268,12269,12270,12271,12272,12273,12274,12275,12276,12277,12278,12279,12280,12281,12282,12283,12284,12285,12286,12287,12288,12289,12290,12291,12292,12293,12294,12295,12296,12297,12298,12299,12300,12301,12302,12303,12304,12305,12306,12307,12308,12309,12310,12311,12312,12313,12314,12315,12316,12317,12318,12319,12320,12321,12322,12323,12324,12325,12326,12327,12328,12329,12330,12331,12332,12333,12334,12335,12336,12337,12338,12339,12340],"revision_id":2595540},"mentions":[{"id":"c-jinshu-070-zhongya:p005:m0000","surface":"蘇峻","start":0,"end":2,"person_id":"lrg_