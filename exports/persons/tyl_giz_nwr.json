ed_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-056-attendants-complete:p018:m0152","start":152,"end":155,"surface":"費延宗","kind":"person","person_id":"tyl_giz_nwr","status":"contextual_provisional","paragraph_id":"c-nanqishu-056-attendants-complete:p018","chapter_id":"c-nanqishu-056-attendants-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-056-attendants-complete:p018","text":"　　呂文度，會稽人。宋世爲細作金銀庫吏，竹局匠。元徽中，爲射雉典事，隨監莫脩宗上郢。世祖鎮盆城拒沈攸之，文度仍留伏事，知軍隊雜役，以此見親。從還都，爲石頭城監，仍度東宮。世祖卽位，爲制局監，位至員外郎，帶南濮陽太守。殿內軍隊及發遣外鎮人，悉關之，甚有要勢。故世傳越州嘗缺，上覔一直事人往越州，文度啓其所知費延宗合旨，上卽以爲刺史。永明中，敕親近不得輙有申薦，人士免官，寒人鞭一百。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":56,"last_line":56,"raw_start":3581,"raw_end":3771,"raw_character_offsets":[3581,3582,3583,3584,3585,3586,3587,3588,3589,3590,3591,3592,3593,3594,3595,3596,3597,3598,3599,3600,3601,3602,3603,3604,3605,3606,3607,3608,3609,3610,3611,3612,3613,3614,3615,3616,3617,3618,3619,3620,3621,3622,3623,3624,3625,3626,3627,3628,3629,3630,3631,3632,3633,3634,3635,3636,3637,3638,3639,3640,3641,3642,3643,3644,3645,3646,3647,3648,3649,3650,3651,3652,3653,3654,3655,3656,3657,3658,3659,3660,3661,3662,3663,3664,3665,3666,3667,3668,3669,3670,3671,3672,3673,3674,3675,3676,3677,3678,3679,3680,3681,3682,3683,3684,3685,3686,3687,3688,3689,3690,3691,3692,3693,3694,3695,3696,3697,3698,3699,3700,3701,3702,3703,3704,3705,3706,3707,3708,3709,3710,3711,3712,3713,3714,3715,3716,3717,3718,3719,3720,3721,3722,3723,3724,3725,3726,3727,3728,3729,3730,3731,3732,3733,3734,3735,3736,3737,3738,3739,3740,3741,3742,3743,3744,3745,3746,3747,3748,3749,3750,3751,3752,3