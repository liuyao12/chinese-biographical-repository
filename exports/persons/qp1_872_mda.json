erson_mention_id":"c-nanqishu-059-western-polities-complete:p024:m0229"}],"status":"source_attested","interpretation_note":"封太夫人、假銀印。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p024:m0229","start":229,"end":231,"surface":"姜氏","kind":"person","person_id":"qp1_872_mda","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p024","chapter_id":"c-nanqishu-059-western-polities-complete"}],"relations":[{"id":"a-qi059-yangjishi-mother","subject_person_id":"5ss_qfy_aid","object_person_id":"qp1_872_mda","predicate":"mother","qualifiers":{"source_term":"集始母姜氏"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-059","chapter_id":"c-nanqishu-059-western-polities-complete","source_id":"s-nanqishu-059-western-polities-complete-ws1748911","paragraph_id":"c-nanqishu-059-western-polities-complete:p024","quote":"世祖即位，進後起號冠軍將軍。永明元年，以征虜將軍炅為沙州刺史、陰平王，將軍如故。二年，八座奏，後起（勒）〔勤〕彰款塞，忠著邊城。進號征虜將軍。四年，後起卒，詔曰：「後起奄至殞逝，惻愴于懷。綏禦邊服，宜詳其選。行輔國將軍、北秦州刺史、武都王楊集始，幹局沈亮，乃心忠款，必能緝境寧民、宣揚聲教。可持節、輔國將軍、北秦州刺史、平羌校尉、武都王。」後起弟後明為龍驤將軍、白水太守。集始弟集朗為寧朔將軍。五年，有司奏集始驅狐剪棘，仰化邊服。母以子貴，宜加榮寵。除集始母姜氏為太夫人，假銀印。九年，八座奏，楊炅嗣勤西牧，馳款內昭，宜增戎章，用輝遐外。進號前將軍。","subject_person_mention_id":"c-nanqishu-059-western-polities-complete:p024:m0119","object_person_mention_id":"c-nanqishu-059-western-polities-complete:p024:m0229"}],"status":"source_attested","interpretation_note":"封太夫人、假銀印。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-059-western-polities-complete:p024","text":"世祖即位，進後起號冠軍將軍。永明元年，以征虜將軍炅為沙州刺史、陰平王，將軍如故。二