contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p004:m0073","start":73,"end":74,"surface":"虞","kind":"person","person_id":"7r6_k52_qji_ABAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p004:m0075","start":75,"end":76,"surface":"柳","kind":"person","person_id":"7r6_k52_qji_ABAAAAC","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p004:m0077","start":77,"end":78,"surface":"孺","kind":"person","person_id":"7r6_k52_qji_ABAAAAD","status":"contextual_provisional"},{"id":"c-jinshu-065-wangdao-family:p004:m0079","start":79,"end":81,"surface":"曇首","kind":"person","person_id":"7r6_k52_qji_ABAAAAE","status":"contextual_provisional"}],"source_position":{"first_line":88,"last_line":89,"revision_id":1756144,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-065-wangdao-family","book_id":"b-jinshu-065","work_id":"w-jinshu","source_id":"s-jinshu-065-wangdao-family"},{"id":"c-songshu-042-wanghong:p001","text":"王弘字休元，琅邪臨沂人也。曾祖導，晉丞相。祖洽，中領軍。父珣，司徒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-042-wanghong:p001:m0000","start":0,"end":2,"surface":"王弘","kind":"person","person_id":"7r6_k52_qji_ABAAAAA","status":"contextual_provisional"},{"id":"c-songshu-042-wanghong:p001:m0003","start":3,"end":5,"surface":"休元","kind":"person","person_id":"7r6_k52_qji_ABAAAAA","status":"contextual_provisional"},{"id":"c-songshu-042-wanghong:p001:m0015","start":15,"end":16,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-songshu-042-wanghong:p001:m0022","start":22,"end":23,"surface":"洽","kind":"person","person_id":"7r6_k52_qji_ABAAA","status":"contextual_provisional"},{"id":"c-songshu-042-wanghong:p001:m0029","start":29,"end":30,"surface":"珣","kind":"person","person_id":"7r6_k52_qji_ABAAAA","status":"contextual_provisional"}],"source_position":{"first_line":45,"last_line":46,"revision_id":1478172,"editorial_excerpt_boundary":true},"chapte