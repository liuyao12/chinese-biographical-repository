jinshu-098-shenchong:line091","chapter_id":"c-jinshu-098-shenchong"},{"id":"c-jinshu-098-shenchong:line091:m0073","start":73,"end":74,"surface":"禎","kind":"person","person_id":"1s9_r97_p85","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-shenchong:line091","chapter_id":"c-jinshu-098-shenchong"},{"id":"c-jinshu-098-shenchong:line091:m0189","start":189,"end":190,"surface":"禎","kind":"person","person_id":"1s9_r97_p85","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-shenchong:line091","chapter_id":"c-jinshu-098-shenchong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-shenchong:line091","text":"明帝將伐敦，遣其鄉人沈禎諭充，許以為司空。充謂禎曰：「三司具瞻之重，豈吾所任！幣厚言甘，古人所畏。且丈夫共事，終始當同，寧可中道改易，人誰容我！」禎曰：「不然。舍忠與順，未有不亡者也。大將軍阻兵不朝，爵賞自己，五尺之童知其異志。今此之舉，將行篡弑耳，豈同於往年乎？是以疆場諸將莫不歸赴本朝，內外之士咸願致死，正以移國易主，義不北面以事之也，奈何協同逆圖，當不義之責乎！朝廷坦誠，禎所知也。賊之黨類，猶宥其罪，與之更始，況見機而作邪！」充不納。率兵臨發，謂其妻子曰：「男兒不豎豹尾，終不還也。」及敗歸吳興，亡失道，誤入其故將吳儒家。儒誘充內重壁中，因笑謂充曰：「三千戶侯也。」充曰：「封侯不足貪也。爾以大義存我，我宗族必厚報汝。若必殺我，汝族滅矣。」儒遂殺之。充子勁竟滅吳氏。勁見《忠義傳》。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-shenchong:line091:m0000","start":0,"end":2,"surface":"明帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-shenchong:line091:m0004","start":4,"end":5,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-shenchong:line091:m0010","start":10,"end":12,"surface":"沈禎","kind":"person","person_id":"1s9_r97_p85","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-shenchong:line091:m0013","start":13,"end":14,"surface":"充","kind":"person","p