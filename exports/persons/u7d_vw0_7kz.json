t_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin056-volume-sun-deng-brother","subject_person_id":"u7d_vw0_7kz","object_person_id":"22x_o5h_te6","predicate":"brother","qualifiers":{"source_term":"騰弟登"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-056","chapter_id":"c-jinshu-056-sun-tong","source_id":"s-jinshu-056-sun-tong-ws1557685","paragraph_id":"c-jinshu-056-sun-tong:p001","quote":"統字承公。幼與綽及從弟盛過江。誕任不羈，而善屬文，時人以為有楚風。征北將軍褚裒聞其名，命為參軍，辭不就，家於會稽。性好山水，乃求為鄞令，轉在吳寧。居職不留心碎務，縱意遊肆，名山勝川，靡不窮究。後為余姚令，卒。子騰嗣，以博學著稱，位至廷尉。騰弟登，少善名理，注《老子》，行於世，仕至尚書郎，早終。","subject_person_mention_id":"c-jinshu-056-sun-tong:p001:m0121","object_person_mention_id":"c-jinshu-056-sun-tong:p001:m0105"}],"status":"source_attested","interpretation_note":"同段明言騰弟登。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-056-sun-tong:p001:m0121","surface":"登","start":121,"end":122,"person_id":"u7d_vw0_7kz","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-056-sun-tong:p001","chapter_id":"c-jinshu-056-sun-tong"}],"relations":[{"id":"a-jin056-volume-sun-deng-brother","subject_person_id":"u7d_vw0_7kz","object_person_id":"22x_o5h_te6","predicate":"brother","qualifiers":{"source_term":"騰弟登"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-056","chapter_id":"c-jinshu-056-sun-tong","source_id":"s-jinshu-056-sun-tong-ws1557685","paragraph_id":"c-jinshu-056-sun-tong:p001","quote":"統字承公。幼與綽