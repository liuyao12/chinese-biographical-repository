則國彊，國彊則趙固，而君爲貴戚，豈輕於天下邪？」平原君以爲賢，言之於王。王用之治國賦，國賦大平，民富而府庫實。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-081-lianlin:m010-0000","start":0,"end":2,"surface":"趙奢","kind":"person","person_id":"6zt_fca_se8","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0015","start":15,"end":18,"surface":"平原君","kind":"person","person_id":"dur_ktk_918","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0024","start":24,"end":25,"surface":"奢","kind":"person","person_id":"6zt_fca_se8","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0031","start":31,"end":34,"surface":"平原君","kind":"person","person_id":"dur_ktk_918","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0034","start":34,"end":39,"surface":"用事者九人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m010-0040","start":40,"end":43,"surface":"平原君","kind":"person","person_id":"dur_ktk_918","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0047","start":47,"end":48,"surface":"奢","kind":"person","person_id":"6zt_fca_se8","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0049","start":49,"end":50,"surface":"奢","kind":"person","person_id":"6zt_fca_se8","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0055","start":55,"end":56,"surface":"君","kind":"person","person_id":"dur_ktk_918","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0065","start":65,"end":66,"surface":"君","kind":"person","person_id":"dur_ktk_918","status":"contextual_provisional"},{"id":"c-shiji-081-lianlin:m010-0084","start":84,"end":86,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m010-0089","start":89,"end":91,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定指代保存，不補姓名。"},{"id":"c-shiji-081-lianlin:m