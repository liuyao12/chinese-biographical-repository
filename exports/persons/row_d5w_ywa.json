e":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-044","source_id":"s-songshu-044-xiehui-digital-ws1746033","chapter_id":"c-songshu-044-xiehui-digital","paragraph_id":"c-songshu-044-xiehui-digital:p007","quote":"至江陵，深結侍中王華，冀以免禍。二女當配彭城王義康、新野侯義賓，元嘉二年，遣妻曹及長子世休送女還京邑。先是景平中，索虜為寇，覆沒河南。至是上欲誅羨之等，并討晦。聲言北伐，又言拜京陵，治裝舟艦。傅亮與晦書曰：「薄伐河朔，事猶未已，朝野之慮，憂懼者多。」又言：「朝士多諫北征，上當遣外監萬幼宗往相諮訪。」時朝廷處分異常，其謀頗泄。三年正月，晦弟黃門侍郎㬭馳使告晦，晦猶謂不然，呼諮議參軍何承天，示以亮書，曰：「計幼宗一二日必至，傅公慮我好事，故先遣此書。」承天曰：「外間所聞，咸謂西討已定，幼宗豈有上理。」晦尚謂虛妄，使承天豫立答詔啟草，言伐虜宜須明年。江夏內史程道惠得尋陽人書，言「朝廷將有大處分，其事已審」，使其輔國府中兵參軍樂冏封以示晦。晦又謂承天曰：「幼宗尚未至，若復二三日無消息，便是不復來邪？」承天答曰：「詔使本無來理，如程所說，其事已判，豈容復疑。」","person_mention_id":"c-songshu-044-xiehui-digital:p007:m0313"}],"status":"source_attested","interpretation_note":"原行列於該人名下，職稱與權限依當時敘法。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song044-wyd-role-lejiong","person_id":"row_d5w_ywa","surfaces":["樂冏"],"scope":"same_chapter","chapter_ids":["c-songshu-044-wyd1739-xiehui"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-044-wyd1739-xiehui:p004:m0019","c-songshu-044-wyd1739-xiehui:p004:m0251"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-044","source_id":"s-songshu-044-wyd1739-xiehui","chapter_id":"c-songshu-044-wyd1739-xiehui","paragraph_id":"c-songshu-044-wyd1739-xiehui:p004","quote":"廷將有大處分其事已審使其輔國府中兵參軍樂冏封以示晦晦又謂承天曰幼宗尚未至若復二三日無消息便是不復來邪承天答曰詔使本無來理如程所說其事已判豈容復疑晦欲焚南蠻兵籍率見力決戰士人多勸發兵乃立幡戒嚴謂司馬庾登之曰今當自下欲屈卿以三千人守城備禦劉粹登之曰下官親老在都又素無旅情計二三不敢受此旨晦仍問諸佐戰士三千足守城不南蠻司馬周超對曰非徒守城而已若有外寇可以立勲登之乃曰超必能辦下官請解司馬南郡以授卽於坐命超為司馬建威將軍南義陽太守轉登之為長史南郡如故太祖誅羡之等及晦子新除祕書郎世休收㬭㬭子世平兄子著作佐郎紹等樂冏又遣使告晦徐傅二公及㬭等並已誅晦先舉羡之亮哀次發子弟凶問旣而自出射堂配衣軍旅數從高祖征討備覩經略至是指揮處分莫不曲盡其宜二三日中四遠投集得精兵三萬人乃奉表曰臣階緣幸會蒙武皇帝殊常之眷外聞政事內謀帷幄經綸夷險毗贊王業預佐命之勲膺河山之賞及先帝不豫導揚末命臣與故司徒臣羡之左光祿大夫臣亮征北將軍臣道濟等並升御牀跪受遺詔載貽話言託以後事臣雖"}],"rationale":"本源明確個體已暫分登記；現有召回尚不足以接合他篇，不代表已證異人或歷史上無完整姓名。 本源確指個體採暫分登記；跨篇同指保留覆核，不斷言必為新人。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-songshu-044-wyd1739-xiehui:p004","text":"廷將有大處分其事已審使其輔國府中兵參軍樂冏封以示晦晦又謂承天曰幼宗尚未至若復二三日無消息便是不復來邪承天答曰詔使本無來理如程所說其事已判豈容復疑晦欲焚南蠻兵籍率見力決戰士人多勸發兵乃立幡戒嚴謂司馬庾登之曰今當自下欲屈卿以三千人守城備禦劉粹登之曰下官親老在都又素無旅情計二三不敢受此旨晦仍問諸佐戰士三千足守城不南蠻司馬周超對曰非徒守城而已若有外寇可以立勲登之乃曰超必能辦下官請解司馬南郡以授卽於坐命超為司馬建威將軍南義陽太守轉登之為長史南郡如故太祖誅羡之等及晦子新除祕書郎世休收㬭㬭子世平兄子著作佐郎紹等樂冏又遣使告晦徐傅二公及㬭等並已誅晦先舉羡之亮哀次發子弟凶問旣而自出射堂配衣軍旅數從高祖征討備覩經略至是指揮處分莫不曲盡其宜二三日中四遠投集得精兵三萬人乃奉表曰臣階緣幸會蒙武皇帝殊常之眷外聞政事內謀帷幄經綸夷險毗贊王業預佐命之勲膺河山之賞及先帝不豫導揚末命臣與故司徒臣羡之左光祿大夫臣亮征北將軍臣道濟等並升御牀跪受遺詔載貽話言託以後事臣雖","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-044-wyd1739-xiehui:p004:m0019","start":19,"end":21,"surface":"樂冏","status":"contextual_provisional","interpretation_note":"原文明指單一人物，已登記為可查來源暫分個體；跨篇同指仍可覆核，本號不表示已證另人。","kind":"person","person_id":"row_d5w_ywa","source_role_key":"lejiong"},{"id":"c-songshu-044-wyd1739-xiehui:p004:m0024","start":24,"end":25,"surface":"晦","status":"contextual_provisional","interpretation_note":"依本傳實指語境及已收近系/同事件角色辨識；精確種子附canonical-seeds，不據同名單獨合併。","kind":"person","person_id":"aa6_83c_juy_AAAA","source_role_key":"hui"},{"id":"c-songshu-044-wyd1739-xiehui:p004:m0025","start":25,"end":26,"surface":"晦","status":"contextual_provisional","interpretation_note":"依本傳實指語境及已收近系/同事件角色辨識；精確種子附canonical-seeds，不據同名單獨合併。","kind":"person","person_id":"aa6_83c_juy_AAAA","source_role_key":"hui"},{"id":"c-songshu-044-wyd1739-xiehui:p004:m0028","start":28,"end":30,"surface":"承天","status":"contextual_provisional","interpretation_note":"依本傳實指語境及已收近系/同事件角色辨識；精確種子附canonical-seeds，不據同名單獨合併。","kind":"person","person_id":"92h_l93_ixy","source_role_key":"chengtian"},{"id":"c-songshu-044-wyd1739-xiehui:p004:m0031","start":31,"end":33,"surface":"幼宗","sta