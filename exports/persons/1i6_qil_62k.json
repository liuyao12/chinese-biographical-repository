[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-011-helingwan-family:p002","text":"后父瑀字幼玉，晉尚書左僕射澄曾孫也。瑀尚武帝少女豫章康長公主諱次男。公主先適徐喬，美容色，聰敏有智數。文帝世，禮待特隆。瑀豪競于時，與平昌孟靈休、東海何勖等並以輿馬相尚。公主與瑀情愛隆密，何氏疏戚莫不沾被恩禮。瑀位右衛將軍，公主薨，瑀墓開，孝武追贈瑀金紫光祿大夫。","mentions":[{"id":"c-nanshi-011-helingwan-family:p002:m0002","surface":"瑀","start":2,"end":3,"person_id":"3ea_uzt_2n2_BA*A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-011-helingwan-family:p002:m0004","surface":"幼玉","start":4,"end":6,"person_id":"3ea_uzt_2n2_BA*A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-011-helingwan-family:p002:m0013","surface":"澄","start":13,"end":14,"person_id":"3ea_uzt_2n2_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-011-helingwan-family:p002:m0018","surface":"瑀","start":18,"end":19,"person_id":"3ea_uzt_2n2_BA*A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-011-helingwan-family:p002:m0031","surface":"次男","start":31,"end":33,"person_id":"3qs_nqa_ioa_AAAC","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-011-helingwan-family:p002:m0038","surface":"徐喬","start":38,"end":40,"person_id":"py9_g84_4uk","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-011-helingwan-family:p002:m0060","surface":"瑀","start":60,"end":61,"person_id":"3ea_uzt_2n2_BA*A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-011-helingwan-family:p002:m0069","surface":"孟靈休","start":69,"end":72,"person_id":"1i6_qil_62k","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-011-helingwan-family:p002:m0075","surface":"何勖",