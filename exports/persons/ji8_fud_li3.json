raph_id":"c-shiji-112-pingjin:p030","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-zhengmo:line026","text":"後以父喪去官，尋起為廷尉。是時鬲令袁毅坐交通貨賂，大興刑獄。在朝多見引逮，唯默兄弟以潔慎不染其流。遷太常。時僕射山濤欲舉一親親為博士，謂默曰：「卿似尹翁歸，令吾不敢復言。」默為人敦重，柔而能整，皆此類也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-zhengmo:line026:m0017","start":17,"end":19,"surface":"袁毅","kind":"person","person_id":"9zt_gf8_q29","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line026:m0038","start":38,"end":39,"surface":"默","kind":"person","person_id":"x18_cng_88g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line026:m0056","start":56,"end":58,"surface":"山濤","kind":"person","person_id":"96a_987_925","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line026:m0068","start":68,"end":69,"surface":"默","kind":"person","person_id":"x18_cng_88g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line026:m0074","start":74,"end":77,"surface":"尹翁歸","kind":"person","person_id":"ji8_fud_li3","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-zhengmo:line026:m0086","start":86,"end":87,"surface":"默","kind":"person","person_id":"x18_cng_88g","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":26,"last_line":26,"revision_id":1775345},"source_quote":{"witness":"j44","quote":"　　後以父喪去官，尋起為廷尉。是時鬲令袁毅坐交通貨賂，大興刑獄。在朝多見引逮，唯默兄弟以潔慎不染其流。遷太常。時僕射山濤欲舉一親親為博士，謂默曰：「卿似尹翁歸，令吾不敢復言。」默為人敦重，柔而能整，皆此類也。","raw_start":1846,"raw_end":1950,"raw_line":26},"chapter_id":"c-jinshu-044-zhengmo","book_id":"b-jinshu-044","work_id":"w-jinshu","source_id":"s-jinshu-044-zhengmo"},{"id":"c-nanqishu-047-wangrong-wyd:p002","text":"融少而神明警惠博涉有文才舉秀才晉安王南中郎板行參軍坐公事免竟陵王司徒板法曹行參軍遷太子舍人融以父官不通弱年便欲紹興家業啓世祖求自試曰臣聞春庚秋蟀集候相悲露木風榮臨年共悅夫唯動植且或有心況在生靈而能無感臣自奉望宮闕沐浴恩私拔迹庸虛參名盛列纓劍紫複趨步丹墀歲時歸來誇榮邑里然無懃而官昔賢曾議不任而祿有識必譏臣所用慷慨憤懣不遑自晏誠以深恩鮮報聖主難逢蒲柳先秋光陰不待貪及明時展悉愚効以酬陛下不世之仁若微誠獲信短才見序文武吏法唯所施用夫君道含弘臣術無隱翁歸乃居中自見克國曰莫若老臣竊景前修敢蹈輕節以冒不媒之鄙式罄奉公之誠抑又唐堯在上不參二八管夷吾恥之臣亦恥之願陛下裁覽遷祕書丞","mentions":[{"id":"c-nanqishu-047-wangrong-wyd:p002:m0000","surface":"融","start":0,"end":1,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"},{"id":"c-nanqishu-047-wangrong-wyd:p002:m0045","surface":"融","start":45,"end":46,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"},{"id":"c-nanqishu-047-wangrong-wyd:p002:m0222","surface":"翁歸","start":222,"end":224,"person_id":"ji8_fud_li3","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"},{"id":"c-nanqishu-047-wangrong-wyd:p002:m0229","surface":"克國","start":229,"end":231,"person_id":"r62_d8z_jhz","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"},{"id":"c-nanqishu-047-wangrong-wyd:p002:m0258","surface":"唐堯","start":258,"end":260,"person_id":"oho_r3f_c6y","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"},{"id":"c-nanqishu-047-wangrong-wyd:p002:m0266","surface":"管夷吾","start":266,"end":269,"person_id":"h1v_8ap_b9y","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":"cbr-ai-transcription-sha256:b3e13ccecc0f8c15729050515a6de4188790d8f8462c2804f0031b37022b7043","source_layer":"received_biography","column_projection":[{"column":"27L07","pdf_page":27,"half":"左","leaf":"一上","column_from_right":7,"start":20,"end":21,"text":"融"},{"column":"27L08","pdf_page":27,"half":"左","leaf":"一上","column_from_right":8,"start":0,"end":21,"text":"少而神明警惠博涉有文才舉秀才晉安王南中郎板"},{"column":"27L09","pdf_page":27,"half":"左","leaf":"一上","column_from_right":9,"start":0,"end":21,"text":"行參軍坐公事免竟陵王司徒板法曹行參軍遷太子"},{"column":"27L10","pdf_page":27,"half":"左","leaf":"一上","column_from_right":10,"start":0,"end":21,"text":"舍人融以父官不通弱年便欲紹興家業啓世祖求自"},{"column":"28R01","pdf_page":28,"half":"右","leaf":"一下","column_from_right":1,"start":0,"end":21,"text":"試曰臣聞春庚秋蟀集候相悲露木風榮臨年共悅夫"},{"column":"28R02","pdf_page":28,"half":"右","leaf":"一下","column_from_right":2,"start":0,"end":21,"text":"唯動植且或有心況在生靈而能無感臣自奉望宮闕"},{"column":"28R03","pdf_page":28,"half":"右","leaf":"一下","column_from_right":3,"start":0,"end":21,"text":"沐浴恩私拔迹庸虛參名盛列纓劍紫複趨步丹墀歲"},{"column":"28R04","pdf_page":28,"half":"右","leaf":"一下","column_from_right":4,"start":0,"end":21,"text":"時歸來誇榮邑里然無懃而官昔賢曾議不任而祿有"},{"column":"28R05","pdf_page":28,"half":"右","leaf":"一下","column_from_right":5,"start":0,"end":21,"text":"識必譏臣所用慷慨憤懣不遑自晏誠以深恩鮮報聖"},{"column":"28R06","pdf_page":28,"half":"右","leaf":"一下","column_from_right":6,"start":0,"end":21,"text":"主難逢蒲柳先秋光陰不待貪及明時展悉愚効以酬"},{"column":"28R07","pdf_page":28,"half":"右","leaf":"一下","column_from_right":7,"start":0,"end":21,"text":"陛下不世之仁若微誠獲信短才見序文武吏法唯所"},{"column":"28R08","pdf_page":28,"half":"右","leaf":"一下","column_from_right":8,"start":0,"end":21,"text":"施用夫君道含弘臣術無隱翁歸乃居中自見克國曰"},{"column":"28R09","pdf_page":28,"half":"右","leaf":"一下","column_from_right":9,"start":0,"end":21,"text":"莫若老臣竊景前修敢蹈輕節以冒不媒之鄙式罄奉"},{"column":"28R10","pdf_page":28,"half":"右","leaf":"一下","column_from_right":10,"start":0,"end":21,"text":"公之誠抑又唐堯在上不參二八管夷吾恥之臣亦恥"},{"column":"28L01","pdf_page":28,"half":"左","leaf":"二上","column_from_right":1,"start":0,"end":10,"text":"之願陛下裁覽遷祕書丞"}]},"chapter_id":"c-nanqishu-047-wangrong-wyd","book_id":"b-nanqishu-047","work_id":"w-nanqishu","source_id":"s-nanqishu-047-wangrong-wyd1739"},{"id":"c-nanqishu-047-wangrong:p002","text":"融少而神明警惠，博涉有文才。舉秀才。晉安王南中郎板行參軍，坐公事免。竟陵王司徒板法曹行參軍，遷太子舍人。融以父官不通，弱年便欲紹興家業，啓世祖求自試。曰：「臣聞春庚秋蟀，集候相悲，露木風榮，臨年共悅。夫唯動植，且或有心；況在生靈，而能無感。臣自奉望宮闕，沐浴恩私，拔迹庸虛，參名盛列，纓劔紫復，趨步丹墀，歲時歸來，誇榮邑里。然無懃而官，昔賢曾議；不任而祿，有識必譏。臣所用慷慨憤懣，不遑自晏。誠以深恩鮮報，聖主難逢，蒲柳先秋，光陰不待，貪及明時，展悉愚效，以酬陛下不世之仁。若微誠獲信，短才見序，文武吏法，唯所施用。夫君道含弘，臣術無隱，翁歸乃居中自是，充國曰『莫若老臣』。竊景前脩，敢蹈輕節。以冒不媒之鄙，式罄奉公之誠。抑又唐堯在上，不參二八，管夷吾恥之，臣亦恥之。願陛下裁覽。」遷祕書丞。","mentions":[{"id":"c-nanqishu-047-wangrong:p002:m0000","surface":"融","start":0,"end":1,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p002:m0052","surface":"融","start":52,"end":53,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p002:m0269","surface":"翁歸","start":269,"end":271,"person_id":"ji8_fud_li3","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p002:m0277","surface":"充國","start":277,"end":279,"person_id":"r62_d8z_jhz","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p002:m0313","surface":"唐堯","start":313,"end":315,"person_id":"oho_r3f_c6y","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p002:m0323","surface":"管夷吾","start":323,"end":326,"person_id":"h1v_8ap_b9y","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1492435,"source_layer":"received_biography","first_line":14,"last_line":14,"line_start":2,"line_end":348,"raw_start":253,"raw_end":599,"raw_character_offsets":[253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,3