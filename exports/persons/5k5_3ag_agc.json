"status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m015-0231","start":231,"end":232,"surface":"上","kind":"person","person_id":"5k5_3ag_agc","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p015","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m016-0022","start":22,"end":24,"surface":"天子","kind":"person","person_id":"5k5_3ag_agc","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p016","chapter_id":"c-shiji-109-liguang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-109-liguang:p004","text":"居久之，孝景崩，武帝立，左右以爲廣名將也，於是廣以上郡太守爲未央衞尉，而程不識亦爲長樂衞尉。程不識故與李廣俱以邊太守將軍屯。及出擊胡，而廣行無部伍行陳，就善水草屯，舍止，人人自便，不擊刀鬬以自衞，莫府省約文書籍事，然亦遠斥候，未嘗遇害。程不識正部曲行伍營陳，擊刀鬬，士吏治軍簿至明，軍不得休息，然亦未嘗遇害。不識曰：「李廣軍極簡易，然虜卒犯之，無以禁也；而其士卒亦佚樂，咸樂爲之死。我軍雖煩擾，然虜亦不得犯我。」是時漢邊郡李廣、程不識皆爲名將，然匈奴畏李廣之略，士卒亦多樂從李廣而苦程不識。程不識孝景時以數直諫爲太中大夫。爲人廉，謹於文法。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m004-0004","start":4,"end":6,"surface":"孝景","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0008","start":8,"end":10,"surface":"武帝","kind":"person","person_id":"5k5_3ag_agc","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0016","start":16,"end":17,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0023","start":23,"end":24,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0036","start":36,"end":39,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0046","start":46,"end":49,"surface":"程不識","kind"