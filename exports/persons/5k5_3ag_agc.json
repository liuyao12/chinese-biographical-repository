{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"5k5_3ag_agc","canonical_person_id":"5k5_3ag_agc","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["5k5_3ag_agc"],"persons":[{"id":"5k5_3ag_agc","label":"武帝（李將軍列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"武帝","mention_ids":["c-shiji-109-liguang:m004-0008"]},{"surface":"天子","mention_ids":["c-shiji-109-liguang:m006-0120"]}],"evidence":[{"mention_id":"c-shiji-109-liguang:m004-0008","chapter_id":"c-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p004","quote":"武帝"},{"mention_id":"c-shiji-109-liguang:m006-0120","chapter_id":"c-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p006","quote":"天子"}]}],"source_mention_summary":[{"source_id":"s-shiji-109-liguang","work_id":"w-shiji","book_id":"b-shiji-109","chapter_id":"c-shiji-109-liguang","mention_count":2,"mention_ids":["c-shiji-109-liguang:m004-0008","c-shiji-109-liguang:m006-0120"],"paragraph_ids":["c-shiji-109-liguang:p004","c-shiji-109-liguang:p006"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-109-liguang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-109-liguang:m004-0008","start":8,"end":10,"surface":"武帝","kind":"person","person_id":"5k5_3ag_agc","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p004","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m006-0120","start":120,"end":122,"surface":"天子","kind":"person","person_id":"5k5_3ag_agc","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p006","chapter_id":"c-shiji-109-liguang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-109-liguang:p004","text":"居久之，孝景崩，武帝立，左右以爲廣名將也，於是廣以上郡太守爲未央衞尉，而程不識亦爲長樂衞尉。程不識故與李廣俱以邊太守將軍屯。及出擊胡，而廣行無部伍行陳，就善水草屯，舍止，人人自便，不擊刀鬬以自衞，莫府省約文書籍事，然亦遠斥候，未嘗遇害。程不識正部曲行伍營陳，擊刀鬬，士吏治軍簿至明，軍不得休息，然亦未嘗遇害。不識曰：「李廣軍極簡易，然虜卒犯之，無以禁也；而其士卒亦佚樂，咸樂爲之死。我軍雖煩擾，然虜亦不得犯我。」是時漢邊郡李廣、程不識皆爲名將，然匈奴畏李廣之略，士卒亦多樂從李廣而苦程不識。程不識孝景時以數直諫爲太中大夫。爲人廉，謹於文法。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m004-0004","start":4,"end":6,"surface":"孝景","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0008","start":8,"end":10,"surface":"武帝","kind":"person","person_id":"5k5_3ag_agc","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0016","start":16,"end":17,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0023","start":23,"end":24,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0036","start":36,"end":39,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0046","start":46,"end":49,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0051","start":51,"end":53,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0068","start":68,"end":69,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0118","start":118,"end":121,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0154","start":154,"end":156,"surface":"不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0159","start":159,"end":161,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0211","start":211,"end":213,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0214","start":214,"end":217,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0226","start":226,"end":228,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0237","start":237,"end":239,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0241","start":241,"end":244,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0245","start":245,"end":248,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0248","start":248,"end":250,"surface":"孝景","kind":"person","person_id":"xd0_1s0_wag","status":"contextual_provisional"}],"chapter_id":"c-shiji-109-liguang","book_id":"b-shiji-109","work_id":"w-shiji","source_id":"s-shiji-109-liguang"},{"id":"c-shiji-109-liguang:p006","text":"頃之，家居數歳。廣家與故潁陰侯孫屏野居藍田南山中射獵。嘗夜從一騎出，從人田間飲。還至霸陵亭，霸陵尉醉，呵止廣。廣騎曰：「故李將軍。」尉曰：「今將軍尚不得夜行，何乃故也！」止廣宿亭下。居無何，匈奴入殺遼西太守，敗韓將軍，後韓將軍徙右北平。於是天子乃召拜廣爲右北平太守。廣即請霸陵尉與俱，至軍而斬之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m006-0008","start":8,"end":9,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m006-0012","start":12,"end":15,"surface":"潁陰侯","kind":"pers