uang","book_id":"b-shiji-109","work_id":"w-shiji","source_id":"s-shiji-109-liguang"},{"id":"c-shiji-109-liguang:p016","text":"李陵既壯，選爲建章監，監諸騎。善射，愛士卒。天子以爲李氏世將，而使將八百騎。嘗深入匈奴二千餘里，過居延視地形，無所見虜而還。拜爲騎都尉，將丹陽楚人五千人，教射酒泉、張掖以屯衞胡。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m016-0000","start":0,"end":2,"surface":"李陵","kind":"person","person_id":"wdz_85c_o7f","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m016-0022","start":22,"end":24,"surface":"天子","kind":"person","person_id":"5k5_3ag_agc","status":"contextual_provisional"}],"chapter_id":"c-shiji-109-liguang","book_id":"b-shiji-109","work_id":"w-shiji","source_id":"s-shiji-109-liguang"}],"sources":[{"chapter_id":"c-shiji-109-liguang","work_id":"w-shiji","book_id":"b-shiji-109","source_id":"s-shiji-109-liguang","source":{"title":"史記／卷109","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷109","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷109&oldid=1765440","revision_id":1765440,"accessed_on":"2026-10-11","extent":"18段正文、1段太史公論、1段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去介面模板與現代節標題；移除專名顯示模板及單字語言轉換包裹，保留模板內原字。其餘原字、標點與段落次序保留。","note":"未核底本影像。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
