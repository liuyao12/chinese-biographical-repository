c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0011","start":11,"end":13,"surface":"荀氏","kind":"person","person_id":"12b_2lg_vs3","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0020","start":20,"end":22,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0023","start":23,"end":25,"surface":"虞妃","kind":"person","person_id":"jqx_jns_jae_A","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0026","start":26,"end":27,"surface":"之","kind":"pronoun","person_id":"dkn_ge4_286_AAAAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0028","start":28,"end":29,"surface":"裒","kind":"person","person_id":"dkn_ge4_286_AAAAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0033","start":33,"end":38,"surface":"長樂亭侯渾","kind":"person","person_id":"dkn_ge4_286_AAAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0053","start":53,"end":54,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0065","start":65,"end":66,"surface":"帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0067","start":67,"end":68,"surface":"裒","kind":"person","person_id":"dkn_ge4_286_AAAAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0076","start":76,"end":78,"surface":"明帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0082","start":82,"end":84,"surface":"王導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0096","start":96,"end":97,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0100","start":100,"end":102,"surface":"世子","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0103","start":103,"end":105,"surface":"宣城","kind":"person","person_id":"dkn_ge4_286_AAAAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0128","start":128,"end":129,"surface":"裒","kind":"person","person_id":"dkn_ge4_286_AAAAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0133","start":133,"end":135,"surface":"恭王","kind":"person","person_id":"dkn_ge4_286_AAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0205","start":205,"end":207,"surface":"山氏","kind":"person","person_id":"8rj_3w5_aq0","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0212","start":212,"end":214,"surface":"穆帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0216","start":216,"end":217,"surface":"裒","kind":"person","person_id":"dkn_ge4_286_AAAAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001:m0221","start":221,"end":225,"surface":"哀王安國","kind":"person","person_id":"dkn_ge4_286_AAAAAAABA","status":"contextual_provisional"}],"source_position":{"first_line":69,"last_line":69,"revision_id":2622004,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-064-yuandi-six-sons","book_id":"b-jinshu-064","work_id":"w-jinshu","source_id":"s-jinshu-064-yuandi-six-sons"}],"sources":[{"chapter_id":"c-jinshu-038-langye-near-family","work_id":"w-jinshu","book_id":"b-jinshu-038","source_id":"s-jinshu-038-langye-near-family","source":{"title":"《晉書》卷038（琅邪宗室父子選段）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2444513","permalink":"https://zh.wikisource.org/w/index.php?oldid=2444513","revision_id":2444513,"accessed_on":"2026-10-18","extent":"宣帝九男、伷篇末兩完整原段，及覲、渾父子兩處節錄；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","wikitext_sha256":"0ccab16e0c18edff6af7aa242c765c728b3f3e64ab3487a528513843281c2bb3","normalization":{"character_conversion":{},"extraction_note":"原行中明示節錄邊界；首段止於中興初之前，次段止於為東安王。僅展開維基連結、單參數年號模板。未收入的宗祀後文與數位校注不作本次正文。 新增原行12、28完整原段，移出ref校注、展開連結與年號模板、去粗體排版。","excerpts":[{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:p001","source_lines":[31,31],"raw_quote":"覲字思祖，拜冗從僕射。{{YL|太熙元年}}薨，時年三十五。子睿立，是為[[晉書/卷006#元帝|元帝]]。","raw_quote_sha256":"92b6b1a02491ca0bae5ba6efbd862434aa4a11adf451ec62b694bc2526214b9f","selected_text_sha256":"fad93529001ada968dcc9e1c0122ec579701178c22f8e836f307f4272b62a778","begin_anchor":"覲字思祖，拜冗從僕射。太","end_anchor":"十五。子睿立，是為元帝。"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:p002","source_lines":[41,41],"raw_quote":"後立琅邪王覲子長樂亭侯渾為東安王","raw_quote_sha256":"c2d57dc545484c083d35eb612cab1ce7c6c23cf288caf48916340f3df5eac989","selected_text_sha256":"c2d57dc545484c083d35eb612cab1ce7c6c23cf288caf48916340f3df5eac989","begin_anchor":"後立琅邪王覲子長樂亭侯渾","end_anchor":"王覲子長樂亭侯渾為東安王"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:line012","source_lines":[12,12],"raw_quote":"宣帝九男，[[晉書/卷031#宣穆張皇后|穆張皇后]]生[[晋书/卷002|景帝、文帝]]、平原王幹，伏夫人生汝南文成王亮、琅邪武王伷、清惠亭侯京、扶風武王駿，張夫人生梁王肜，柏夫人生趙王倫。亮及倫[[晉書/卷059#汝南文成王亮|別有傳]]<ref>亮及倫別有傳亮上原衍「汝南王亮」四字，今從吳本。</ref>。","raw_quote_sha256":"9d741ee0b3e17e6ca567108a29100f3bc8d931a5024c637e80643acda1c75d4e","selected_text_sha256":"7bb98cf560424553df55c266814dfa416afbbb2135eea9b6178cb65e3749cef9","begin_anchor":"宣帝九男，穆張皇后生景帝","end_anchor":"生趙王倫。亮及倫別有傳。"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:line028","source_lines":[28,28],"raw_quote":"伷既戚屬尊重，加有平吳之功，克己恭儉，無矜滿之色，僚吏盡力，百姓懷化。疾篤，賜床帳、衣服、錢帛、秔梁等物，遣侍中問焉。{{YL|太康四年}}薨，時年五十七。臨終表求葬母太妃陵次，並乞分國封四子，帝許之。子'''恭王覲'''立。又封次子澹為武陵王，繇為東安王，漼為淮陵王。","raw_quote_sha256":"ef2acda8c3066604221d94ec739fdff51de4c39b6a4f8c5081b690e40b4221b9","selected_text_sha256":"a385c4c93a02c7e1376b1354afeb7e1aa692098b28657e639422be5a3c9d9eb4","begin_anchor":"伷既戚屬尊重，加有平吳之","end_anchor":"繇為東安王，漼為淮陵王。"}],"removed_apparatus":[{"text_layer":"later_critical_apparatus","source_line":12,"raw_note":"亮及倫別有傳亮上原衍「汝南王亮」四字，今從吳本。","raw_note_sha256":"56487327592265c4717f825e825622e65455e9ec5597a1949119d7ec9afcae6d","collated_by_current_agent":false}]}}},{"chapter_id":"c-jinshu-064-yuandi-six-sons","work_id":"w-jinshu","book_id":"b-jinshu-064","source_id":"s-jinshu-064-yuandi-six-sons","source":{"title":"《晉書》卷064（家世數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7064&oldid=2622004","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7064&oldid=2622004","revision_id":2622004,"accessed_on":"2026-10-18","extent":"元帝六男生母段及琅邪孝王裒本傳原段，非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"ff96db181b7f2e2c770557a8bd2ae7521766f23c38504335efe47609b7d6921c","wikitext_sha256":"b4c389968a1af2d99c2a6ad4a8afa3e6a4706f845194c0ce283f41927afae31f","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，維基連結僅取顯示原字；不換字、不補原文沒有的父母。","excerpts":[{"proposed_paragraph_id":"c-jinshu-064-yuandi-six-sons:p001","source_lines":[66,66],"raw_quote":"　　元帝六男：宮人荀氏生[[晉書/卷006#明帝|明帝]]及琅邪孝王裒。石婕妤生東海哀王沖。王才人生武陵威王晞。[[晉書/卷032#簡文宣鄭太后|鄭夫人]]生琅邪悼王煥及[[晉書/卷009#簡文帝|簡文帝]]。","raw_quote_sha256":"517729197930253705cb3af9fb71a4df248e801920447426aa8f6d07cdedbea9","selected_text_sha256":"234ff023f6e6abbb388a4df0944547ae2adb3963a861d64c0be451a38f08ab5a","begin_anchor":"元帝六男：宮人荀氏生明帝及琅邪","end_anchor":"。鄭夫人生琅邪悼王煥及簡文帝。"},{"proposed_paragraph_id":"c-jinshu-064-yuandi-six-sons:pou-care-succession:p001","source_lines":[69,69],"raw_quote":"　　琅邪孝王裒，字道成，母荀氏，以微賤入宮，元帝命虞妃養之。裒初繼叔父長樂亭侯渾，後徙封宣城郡公，拜後將軍。及帝為晉王，有司奏立太子，帝以裒有成人之量，過於明帝，從容謂王導曰：「立子以德不以年。」導曰：「世子、宣城俱有朗雋之目，固當以年。」於是太子位遂定。更封裒琅邪，嗣恭王后，改食會稽、宣城邑五萬二千戶，拜散騎常侍、使持節、都督青徐兗三州諸軍事、車騎將軍，徵還京師。{{YL|建武元年}}薨，年十八，贈車騎大將軍，加侍中。及妃山氏薨，祔葬，穆帝更贈裒太保。子哀王安國立，未逾年薨。","raw_quote_sha256":"e21fd83073bc477d04de8c327bb8e6f14ec7842677974bfd4b3d1ce458fdf0d7","selected_text_sha256":"94f5d63eb4a5f15e8ea4f0ed9db30ebced1fc05eb119f3b4fac15ce5e192f992","begin_anchor":"琅邪孝王裒，字道成，母荀氏，以","end_anchor":"太保。子哀王安國立，未逾年薨。"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"dkn_ge4_286_AAAAAAB","representative_source_person_id":"dkn_ge4_286_AAAAAAB","source_person_ids":["dkn_ge4_286_AAAAAAB"],"identity_equivalence_decision_ids":[],"parent_person_id":"dkn_ge4_286_AAAAAA","source_assertion_id":"a-jinshu038-hun-father-jin","connection":"father","assembly_id":"family-sima-jun-near-ancestry","root_person_id":"dkn_ge4_286","status":"contextual_provisional","human_reviewed":false}}
