ccurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-073-yuliang","work_id":"w-jinshu","book_id":"b-jinshu-073","chapter_id":"c-jinshu-073-yuliang","raw_mention_count":1,"mention_ids":["c-jinshu-073-yuliang:line069:m0126"],"paragraph_ids":["c-jinshu-073-yuliang:line069"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-073-yuliang:line069:m0126","mention_ids":["c-jinshu-073-yuliang:line069:m0126"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-100-phase5"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-073-yuliang:line069:m0126","start":126,"end":128,"surface":"李閎","kind":"person","person_id":"17a_fd0_7e1","status":"resolved","paragraph_id":"c-jinshu-073-yuliang:line069","chapter_id":"c-jinshu-073-yuliang"},{"id":"c-jinshu-100-phase5-sujun:line125:m0469","start":469,"end":471,"surface":"李閎","kind":"person","person_id":"17a_fd0_7e1","paragraph_id":"c-jinshu-100-phase5-sujun:line125","chapter_id":"c-jinshu-100-phase5-sujun"},{"id":"c-jinshu-100-phase5-sujun:line125:m0494","start":494,"end":496,"surface":"李閎","kind":"person","person_id":"17a_fd0_7e1","paragraph_id":"c-jinshu-100-phase5-sujun:line125","chapter_id":"c-jinshu-100-phase5-sujun"}],"relations":[],"title_holdings":[{"id":"th-yu4-069-122-17a_fd0_7e1","person_id":"17a_fd0_7e1","title":"荊州刺史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","chapter_id":"c-jinshu-073-yuliang","paragraph_id":"c-jinshu-073-yuliang:line069","quote":"時石勒新死，亮有開復中原之謀，乃解豫州授輔國將軍毛寶，使與西陽太守樊峻精兵一萬，俱戍邾城。又以陶稱為南中郎將、江夏相，率部曲五千人入沔中。亮弟翼為南蠻校尉、南郡太守，鎮江陵。以武昌太守陳囂為輔國將軍、梁州刺史，趣子午。又遣偏軍伐蜀，至江陽，執偽荊州刺史李閎、巴郡太守黃植，送於京都。亮當率大眾十萬，據石城，為諸軍聲援，乃上疏曰：「蜀胡二寇凶虐滋甚，內相誅鋤，眾叛親離。蜀甚弱而胡尚強，並佃並守，修進取之備。襄陽北接宛許，南阻漢水，其險足固，其土足食。臣宜移鎮襄陽之石城下，並遣諸軍羅布江沔。比及數年，戎士習練，乘釁齊進，以臨河洛。大勢一舉，眾知存亡，開反善之路，宥逼協之罪，因天時，順人情，誅逋逆，雪大恥，實聖朝之所先務也。願陛下許其所陳，濟其此舉。淮泗壽陽所宜進據，臣輒簡練部分。乞槐棘參議，以定經略。」帝下其議。時王導與亮意同，郗鑒議以資用未備，不可大舉。亮又上疏，便欲遷鎮。會寇陷邾城，毛寶赴水而死。亮陳謝，自貶三等，行安西將軍。有詔復位。尋拜司空，餘官如故，固讓不拜。","person_mention_id":"c-jinshu-073-yuliang:line069:m0126"}],"attestations":[{"id":"th-yu4-069-122-17a_fd0_7e1:a1","paragraph_id":"c-jinshu-073-yuliang:line069","start":122,"end":126,"surface":"荊州刺史","person_mention_id":"c-jinshu-073-yuliang:line069:m0126","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原稱、授任及用稱分錄；任命不等於已到任；缺年月、同母及生年不補，不以死亡一律截止職爵。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[{"id":"pa-yu4-69-138-17a_fd0_7e1-migration_destination","person_id":"17a_fd0_7e1","relation":"migration_destination","place":{"source_name":"京都","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"執偽荊州刺史李閎、巴郡太守黃植，送於京都","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","chapter_id":"c-jinshu-073-yuliang","paragraph_id":"c-jinshu-073-yuliang:line069","quote":"時石勒新死，亮有開復中原之謀，乃解豫州授輔國將軍毛寶，使與西陽太守樊峻精兵一萬，俱戍邾城。又以陶稱為南中郎將、江夏相，率部曲五千人入沔中。亮弟翼為南蠻校尉、南郡太守，鎮江陵。以武昌太守陳囂為輔國將軍、梁州刺史，趣子午。又遣偏軍伐蜀，至江陽，執偽荊州刺史李閎、巴郡太守黃植，送於京都。亮當率大眾十萬，據石城，為諸軍聲援，乃上疏曰：「蜀胡二寇凶虐滋甚，內相誅鋤，眾叛親離。蜀甚弱而胡尚強，並佃並守，修進取之備。襄陽北接宛許，南阻漢水，其險足固，其土足食。臣宜移鎮襄陽之石城下，並遣諸軍羅布江沔。比及數年，戎士習練，乘釁齊進，以臨河洛。大勢一舉，眾知存亡，開反善之路，宥逼協之罪，因天時，順人情，誅逋逆，雪大恥，實聖朝之所先務也。願陛下許其所陳，濟其此舉。淮泗壽陽所宜進據，臣輒簡練部分。乞槐棘參議，以定經略。」帝下其議。時王導與亮意同，郗鑒議以資用未備，不可大舉。亮又上疏，便欲遷鎮。會寇陷邾城，毛寶赴水而死。亮陳謝，自貶三等，行安西將軍。有詔復位。尋拜司空，餘官如故，固讓不拜。","person_mention_id":"c-jinshu-073-yuliang:line069:m0126"}],"interpretation_note":"按原文分地望、行止或任事轄地，不補現代行政區、座標或出生地。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"pa-yu4-69-122-17a_fd0_7e1-service_location","person_id":"17a_fd0_7e1","relation":"service_location","place":{"source_name":"荊州","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"荊州刺史","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-073","source_id":"s-jinshu-073-yuliang","chapter_id":"c-jinshu-073-yuliang","paragraph_id":"c-jinshu-073-yuliang:line069","quote":"時石勒新死，亮有開復中原之謀，乃解豫州授輔國將軍毛寶，使與西陽太守樊峻精兵一萬，俱戍邾城。又以陶稱為南中郎將、江夏相，率部曲五千人入沔中。亮弟翼為南蠻校尉、南郡太守，鎮江陵。以武昌太守陳囂為輔國將軍、梁州刺史，趣子午。又遣偏軍伐蜀，至江陽，執偽荊州刺史李閎、巴郡太守黃植，送於京都。亮當率大眾十萬，據石城，為諸軍聲援，乃上疏曰：「蜀胡二寇凶虐滋甚，內相誅鋤，眾叛親離。蜀甚弱而胡尚強，並佃並守，修進取之備。襄陽北接宛許，南阻漢水，其險足固，其土足食。臣宜移鎮襄陽之石城下，並遣諸軍羅布江沔。比及數年，戎士習練，乘釁齊進，以臨河洛。大勢一舉，眾知存亡，開反善之路，宥逼協之罪，因天時，順人情，誅逋逆，雪大恥，實聖朝之所先務也。願陛下許其所陳，濟其此舉。淮泗壽陽所宜進據，臣輒簡練部分。乞槐棘參議，以定經略。」帝下其議。時王導與亮意同，郗鑒議以資用未備，不可大舉。亮又上疏，便欲遷鎮。會寇陷邾城，毛寶赴水而死。亮陳謝，自貶三等，行安西將軍。有詔復位。尋拜司空，餘官如故，固讓不拜。","person_mention_id":"c-jinshu-073-yuliang:line069:m0126"}],"interpretation_note":"僅來源官稱所帶任事轄地；非到任、居處或籍貫，亦不據此終止其他職位。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"qualifiers":{"source_position":"荊州刺史"}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-phase5-100-李閎","person_id":"17a_fd0_7e1","surfaces":["李閎"],"scope":"same_chapter","chapter_ids":["c-jinshu-100-phase5-sujun"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-100","source_id":"s-jinshu-100-phase5","chapter_id":"c-jinshu-100-phase5-sujun","paragraph_id":"c-jinshu-100-phase5-sujun:line125","quote":"時溫嶠、陶侃已唱義于武昌，峻聞兵起，用參軍賈甯計，還據石頭，更分兵距諸義軍，所過無不殘滅。嶠等將至，峻遂遷天子于石頭，逼迫居人，盡聚之後苑，使懷德令匡術守苑城。嶠等既到，乃築壘于白石，峻率眾攻之，幾至陷沒。東西抄掠，多所擒虜，兵威日盛，戰無不克，由是義眾沮衄，人懷異計。朝士之奔義軍者，皆云：「峻狡黠有智力，其徒黨驍勇，所向無敵。惟當以天討有罪，誅滅不久；若以人事言之，未易除也。」溫嶠怒曰：「諸君怯懦，乃是譽賊。」及後累戰不捷，嶠亦深憚之。管商等進攻吳郡，焚吳縣、海監、嘉興，敗諸義軍。韓晃又攻宣城，害太守桓彝。商等又焚余杭，而大敗于武康，退還義興。嶠與趙胤率步兵萬人，從白石南上，欲以臨之。峻與匡孝將八千人逆戰，峻遣子碩與孝以數十騎先薄趙胤，敗之。峻望見胤走，曰：「孝能破賊，我更不如乎！」因舍其眾，與數騎北下突陣，不得入，將回趨白木陂，牙門彭世、李千等投之以矛，墜馬，斬首臠割之，焚其骨，三軍皆稱萬歲。峻司馬任讓等共立峻弟逸為主。求峻屍不獲，碩乃發庾亮父母墓，剖棺焚屍。逸閉城自守。韓晃聞峻死，引兵赴石頭。管商及弘徽進攻庱亭壘，督護李閎及輕車長史滕含擊破之，斬首千級。商率眾走延陵，李閎與庱亭諸軍追之，斬獲數千級。商詣庾亮降，匡術舉苑城降。韓晃與蘇逸等並力攻術，不能陷。溫嶠等選精銳將攻賊營，碩率驍勇數百渡淮而戰，於陣斬碩。晃等震懼，以其眾奔張健于曲阿，門厄不得出，更相蹈藉，死者萬數。逸為李湯所執，斬于車騎府。","person_mention_id":"c-jinshu-100-phase5-sujun:line125:m0469"},{"work_id":"w-jinshu","book_id":"b-jinshu-100","source_id":"s-jinshu-100-phase5","chapter_id":"c-jinshu-100-phase5-sujun","paragraph_id":"c-jinshu-100-phase5-sujun:line125","quote":"時溫嶠、陶侃已唱義于武昌，峻聞兵起，用參軍賈甯計，還據石頭，更分兵距諸義軍，所過無不殘滅。嶠等將至，峻遂遷天子于石頭，逼迫居人，盡聚之後苑，使懷德令匡術守苑城。嶠等既到，乃築壘于白石，峻率眾攻之，幾至陷沒。東西抄掠，多所擒虜，兵威日盛，戰無不克，由是義眾沮衄，人懷異計。朝士之奔義軍者，皆云：「峻狡黠有智力，其徒黨驍勇，所向無敵。惟當以天討有罪，誅滅不久；若以人事言之，未易除也。」溫嶠怒曰：「諸君怯懦，乃是譽賊。」及後累戰不捷，嶠亦深憚之。管商等進攻吳郡，焚吳縣、海監、嘉興，敗諸義軍。韓晃又攻宣城，害太守桓彝。商等又焚余杭，而大敗于武康，退還義興。嶠與趙胤率步兵萬人，從白石南上，欲以臨之。峻與匡孝將八千人逆戰，峻遣子碩與孝以數十騎先薄趙胤，敗之。峻望見胤走，曰：「孝能破賊，我更不如乎！」因舍其眾，與數騎北下突陣，不得入，將回趨白木陂，牙門彭世、李千等投之以矛，墜馬，斬首臠割之，焚其骨，三軍皆稱萬歲。峻司馬任讓等共立峻弟逸為主。求峻屍不獲，碩乃發庾亮父母墓，剖棺焚屍。逸閉城自守。韓晃聞峻死，引兵赴石頭。管商及弘徽進攻庱亭壘，督護李閎及輕車長史滕含擊破之，斬首千級。商率眾走延陵，李閎與庱亭諸軍追之，斬獲數千級。商詣庾亮降，匡術舉苑城降。韓晃與蘇逸等並力攻術，不能陷。溫嶠等選精銳將攻賊營，碩率驍勇數百渡淮而戰，於陣斬碩。晃等震懼，以其眾奔張健于曲阿，門厄不得出，更相蹈藉，死者萬數。逸為李湯所執，斬于車騎府。","person_mention_id":"c-jinshu-100-phase5-sujun:line125:m0494"}],"rationale":"依完整同段主語、親屬及事件辨識短稱；已有人物須同一蘇峻亂、彭城王系或相同君主脈絡，不以同名合併。馗、權、植、釋的局部父系獨立於馗接防的跨篇推論。","references":[],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-073-yuliang:line069","text":"時石勒新死，亮有開復中原之謀，乃解豫州授輔國將軍毛寶，使與西陽太守樊峻精兵一萬，俱戍邾城。又以陶稱為南中郎將、江夏相，率部曲五千人入沔中。亮弟翼為南蠻校尉、南郡太守，鎮江陵。以武昌太守陳囂為輔國將軍、梁州刺史，趣子午。又遣偏軍伐蜀，至江陽，執偽荊州刺史李閎、巴郡太守黃植，送於京都。亮當率大眾十萬，據石城，為諸軍聲援，乃上疏曰：「蜀胡二寇凶虐滋甚，內相誅鋤，眾叛親離。蜀甚弱而胡尚強，並佃並守，修進取之備。襄陽北接宛許，南阻漢水，其險足固，其土足食。臣宜移鎮襄陽之石城下，並遣諸軍羅布江沔。比及數年，戎士習練，乘釁齊進，以臨河洛。大勢一舉，眾知存亡，開反善之路，宥逼協之罪，因天時，順人情，誅逋逆，雪大恥，實聖朝之所先務也。願陛下許其所陳，濟其此舉。淮泗壽陽所宜進據，臣輒簡練部分。乞槐棘參議，以定經略。」帝下其議。時王導與亮意同，郗鑒議以資用未備，不可大舉。亮又上疏，便欲遷鎮。會寇陷邾城，毛寶赴水而死。亮陳謝，自貶三等，行安西將軍。有詔復位。尋拜司空，餘官如故，固讓不拜。","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-073-yuliang:line069:m0001","start":1,"end":3,"surface":"石勒","kind":"person","person_id":"0c9_95a_18b","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0006","start":6,"end":7,"surface":"亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0024","start":24,"end":26,"surface":"毛寶","kind":"person","person_id":"d9b_790_9f0","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0033","start":33,"end":35,"surface":"樊峻","kind":"person","person_id":"e85_94a_1fb","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0047","start":47,"end":49,"surface":"陶稱","kind":"person","person_id":"5fa_457_ec8","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0069","start":69,"end":70,"surface":"亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0071","start":71,"end":72,"surface":"翼","kind":"person","person_id":"4qr_wrk_3vd_F","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0092","start":92,"end":94,"surface":"陳囂","kind":"person","person_id":"09d_7d7_be9","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0126","start":126,"end":128,"surface":"李閎","kind":"person","person_id":"17a_fd0_7e1","status":"resolved"},{"id":"c-jinshu-073-yuliang:line069:m0133","start":133,"end":135,"surface":"黃植","kind":"person","person_id":"3