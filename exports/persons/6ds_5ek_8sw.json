諸公聞之，皆多袁盎。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m014-0005","start":5,"end":6,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0008","start":8,"end":10,"surface":"元王","kind":"person","person_id":"yqp_nlb_p1p_D","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0015","start":14,"end":15,"surface":"禮","kind":"person","person_id":"yqp_nlb_p1p_DB","status":"contextual_provisional","note":"既有錨點誤落後一為字，本輪移回原文禮；提及ID保留，正文不改，不與張恢同學劉禮合併。"},{"id":"c-shiji-101-yuanchao:m014-0019","start":19,"end":21,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0035","start":35,"end":37,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0059","start":59,"end":61,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0063","start":63,"end":65,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0066","start":66,"end":67,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0071","start":71,"end":75,"surface":"安陵富人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、學說合稱、典故或待辨匿名指代，未補成員及姓名。"},{"id":"c-shiji-101-yuanchao:m014-0077","start":77,"end":78,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0083","start":83,"end":85,"surface":"劇孟","kind":"person","person_id":"5se_9f5_u2q","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m014-0096","start":96,"end":97,"surface":"盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"