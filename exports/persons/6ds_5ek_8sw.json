"c-shiji-050-chuyuan:m011-0043","chapter_id":"c-shiji-050-chuyuan","paragraph_id":"c-shiji-050-chuyuan:p011","quote":"禮"},{"mention_id":"c-shiji-050-chuyuan:m011-0050","chapter_id":"c-shiji-050-chuyuan","paragraph_id":"c-shiji-050-chuyuan:p011","quote":"文"},{"mention_id":"c-shiji-101-yuanchao:m014-0015","chapter_id":"c-shiji-101-yuanchao","paragraph_id":"c-shiji-101-yuanchao:p014","quote":"禮"},{"mention_id":"c-shiji-106-wuwang:m019-0037","chapter_id":"c-shiji-106-wuwang","paragraph_id":"c-shiji-106-wuwang:p019","quote":"平陸侯禮"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-011-jingdi","source_id":"s-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"三年正月乙巳，赦天下。長星出西方。天火燔雒陽東宮大殿城室。吳王濞、楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠反，發兵西鄉。天子為誅晁錯，遣袁盎諭告，不止，遂西圍梁。上乃遣大將軍竇嬰、太尉周亞夫將兵誅之。六月乙亥。赦亡軍及楚元王子藝等與謀反者。封大將軍竇嬰為魏其侯。立楚元王子平陸侯禮為楚王。立皇子端為膠西王，子勝為中山王。徙濟北王志為菑川王，淮陽王餘為魯王，汝南王非為江都王。齊王將廬、燕王嘉皆薨。","source_term":"子"}],"source_assertion_id":"a-shiji011-005","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"yqp_nlb_p1p_D"}}],"source_mention_summary":[{"source_id":"s-shiji-101-yuanchao","work_id":"w-shiji","book_id":"b-shiji-101","chapter_id":"c-shiji-101-yuanchao","raw_mention_count":1,"mention_ids":["c-shiji-101-yuanchao:m016-0027"],"paragraph_ids":["c-shiji-101-yuanchao:p016"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-101-yuanchao:m016-0027","mention_ids":["c-shiji-101-yuanchao:m016-0027"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-101-yuanchao"],"mention_count_policy":{"scope":"independent_fixed_witness_o