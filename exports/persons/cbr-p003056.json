br-p003089","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p009","text":"代王立十七年，高后崩。大臣議立後，疾外家呂氏彊，皆稱薄氏仁善，故迎代王，立為孝文皇帝，而太后改號曰皇太后，弟薄昭封為軹侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m009-0000","start":0,"end":2,"surface":"代王","kind":"person","person_id":"cbr-p003055","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m009-0007","start":7,"end":9,"surface":"高后","kind":"person","person_id":"cbr-p003050","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m009-0033","start":33,"end":35,"surface":"代王","kind":"person","person_id":"cbr-p003055","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m009-0038","start":38,"end":42,"surface":"孝文皇帝","kind":"person","person_id":"cbr-p003055","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m009-0044","start":44,"end":46,"surface":"太后","kind":"person","person_id":"cbr-p003056","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m009-0050","start":50,"end":52,"surface":"太后","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m009-0054","start":54,"end":56,"surface":"薄昭","kind":"person","person_id":"cbr-p003089","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p010","text":"薄太后母亦前死，葬櫟陽北。於是乃追尊薄案為靈文侯，會稽郡置園邑三百家，長丞已下吏奉守冢，寢廟上食祠如法。而櫟陽北亦置靈文侯夫人園，如靈文侯園儀。薄太后以為母家魏王後，早失父母，其奉薄太后諸魏有力者，於是召復魏氏，［及尊］賞賜各以親疏受之。薄氏侯者凡一人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m010-0000","start":0,"end":3,"surface":"薄太后","kind":"person","person_id":"cbr-p003056","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m010-0003","start":3,"end":4,"surface":"母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m010-0018","start":18,"end":20,"surface":"薄案","kind":"person","person_id":"cbr-p003085","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m010-0072","start":72,"end":75,"surface":"薄太后","kind":"person","person_id":"cbr-p003056","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m010-0077","start":77,"end":78,"surface":"母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m010-0079","start":79,"end":82,"surface":"魏王後","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m010-0086","start":86,"end":87,"surface":"母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m010-0090","start":90,"end":93,"surface":"薄太后","kind":"person","person_id":"cbr-p003056","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p011","text":"薄太后後文帝二年，以孝景帝前二年崩，葬南陵。以呂后會葬長陵，故特自起陵，近孝文皇帝霸陵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m011-0000","start":0,"end":3,"surface":"薄太后","kind":"person","person_id":"cbr-p003056","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m011-0004","start":4,"end":6,"surface":"文帝","kind":"person","person_id":"cbr-p003055","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m011-0010","start":10,"end":13,"surface":"孝景帝","kind":"person","person_id":"cbr-p003061","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m011-0023","start":23,"end":25,"surface":"呂后","kind":"person","person_id":"cbr-p003050","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m011-0037","start":37,"end":41,"surface":"孝文皇帝","kind":"person","person_id":"cbr-p003055","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p013","text":"竇皇后親蚤卒，葬觀津。於是薄太后乃詔有司，追尊竇后父為安成侯，母曰安成夫人。令清河置園邑二百家，長丞奉守，比靈文園法。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m013-0000","start":0,"end":3,"surface":"竇皇后","kind":"person","person_id":"cbr-p003062","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m013-0013","start":13,"end":16,"surface":"薄太后","kind":"person","person_id":"cbr-p003056","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m013-0018","start":18,"end":20,"surface":"有司","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m013-0023","start":23,"end":26,"surface":"竇后父","kind":"person","person_id":"cbr-p003065","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m013-0031","start":31,"end":32,"surface":"母","kind":"person","person_id":"cbr-p003091","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p019","text":"先是臧兒又入其少女兒姁，兒姁生四男。景帝為太子時，薄太后以薄氏女為妃。及景帝立，立妃曰薄皇后。皇后毋子，毋寵。薄太后崩，廢薄皇后。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m019-0002","start":2,"end":4,"surface":"臧兒","kind":"person","person_id":"cbr-p003130","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m019-0009","start":9,"end":11,"surface":"兒姁","kind":"person","person_id":"cbr-p003135","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m019-0012","start":12,"end":14,"surface":"兒姁","kind":"person","person_id":"cbr-p003135","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m019-0018","start":18,"end":20,"surface":"景帝","kind":"person","person_id":"cbr-p003061","status":"contextual_provisional"},{"i