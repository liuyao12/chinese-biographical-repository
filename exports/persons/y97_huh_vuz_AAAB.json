erson","person_id":"3v2_uap_0g0","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m012-0038","start":38,"end":40,"surface":"武公","kind":"person","person_id":"y97_huh_vuz_AAAB","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p013","text":"武公元年，伐彭戲氏，至于華山下，居平陽封宮。三年，誅三父等而夷三族，以其殺出子也。鄭高渠瞇殺其君昭公。十年，伐邽、冀戎，初縣之。十一年，初縣杜、鄭。滅小虢。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m013-0000","start":0,"end":2,"surface":"武公","kind":"person","person_id":"y97_huh_vuz_AAAB","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m013-0026","start":26,"end":28,"surface":"三父","kind":"person","person_id":"3v2_uap_0g0","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m013-0037","start":37,"end":39,"surface":"出子","kind":"person","person_id":"y97_huh_vuz_AAAC","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m013-0041","start":41,"end":45,"surface":"鄭高渠瞇","kind":"person","person_id":"rl7_3y6_td9","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m013-0048","start":48,"end":50,"surface":"昭公","kind":"person","person_id":"j2w_ldj_v0t","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p016","text":"二十年，武公卒，葬雍平陽。初以人從死，從死者六十六人。有子一人，名曰白，白不立，封平陽。立其弟德公。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m016-0004","start":4,"end":6,"surface":"武公","kind":"person","person_id":"y97_huh_vuz_AAAB","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m016-0019","start":19,"end":22,"surface":"從死者","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、短稱或官稱指代待核；不補造姓名或自動合併。"},{"id":"c-shiji-005-qin:m016-0034","start":34,"end":35,"surface":"白","kind":"person","person_id":"y97_huh_vuz_AAABA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m016-0036","start":36,"end":37,"surface":"白","kind":"person","person_id":"y97_huh_vuz_AAABA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m016-0047","start":47,"end":49,"surface":"德公","kind":"person","person_id":"y97_huh_vuz_AAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-006-shihuang:p068","text":"憲公享國十二年，居西新邑。死，葬衙。生武公、德公、出子。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p068:m0000","start":0,"end":2,"surface":"憲公","kind":"person","person_id":"y97_huh_vuz_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p068:m0019","start":19,"end":21,"surface":"武公","kind":"person","person_id":"y97_huh_vuz_AAAB","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p068:m0022","start":22,"end":24,"surface":"德公","kind":"person","person_id":"y97_huh_vuz_AAAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p068:m0025","start":25,"end":27,"surface":"出子","kind":"person","person_id":"y97_huh_vuz_AAAC","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p069","text":"出子享國六年，居西陵。庶長弗忌、威累、參父三人，率賊賊出子鄙衍，葬衙。武公立。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p069:m0000","start":0,"end":2,"surface":"出子","kind":"person","person_id":"y97_huh_vuz_AAAC","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0011","start":11,"end":15,"surface":"庶長弗忌","kind":"person","person_id":"zkl_2cm_e8u","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0016","start":16,"end":18,"surface":"威累","kind":"person","person_id":"2ne_w1o_8cu","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0019","start":19,"end":21,"surface":"參父","kind":"person","person_id":"y9m_aj1_ara","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0021","start":21,"end":23,"surface":"三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、注記、作者標題、泛稱或未核指代；不補造姓名與世代。"},{"id":"c-shiji-006-shihuang:p069:m0025","start":25,"end":26,"surface":"賊","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、注記、作者標題、泛稱或未核指代；不補造姓名與世代。"},{"id":"c-shiji-006-shihuang:p069:m0026","start":26,"end":27,"surface":"賊","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、注記、作者標題、泛稱或未核指代；不補造姓名與世代。"},{"id":"c-shiji-006-shihuang:p069:m0027","start":27,"end":29,"surface":"出子","kind":"person","person_id":"y97_huh_vuz_AAAC","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p069:m0035","start":35,"end":37,"surface":"武公","kind":"person","person_id":"y97_huh_vuz_AAAB","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p070","text":"武公享國二十年。居平陽封宮。葬宣陽聚東南。三庶長伏其罪。德公立。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p070:m0000","start":0,"end":2,"surface":"武公","kind":"person","person_id":"y97_huh_vuz_AAAB","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p070:m0021","start":21,"end":24,"surface":"三庶長","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、注記、作者標題、泛稱或未核指代；不補造姓名與世代。"},{"id":"c-shiji-006-shihuang:p070:m0028","start":28,"end":30,"surface":"德公","kind":"person","person_id":"y97_huh_vuz_AAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"}],"sources":[{"chapter_id":"c-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","source_id":"s-shiji-005-qin","source":{"title":"史記／卷005","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷005","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷005&oldid