ention_id":"c-nanqishu-052-early-literature-complete:p014:m0101","mention_ids":["c-nanqishu-052-early-literature-complete:p014:m0101"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-early-literature-complete:p015:m0002","mention_ids":["c-nanqishu-052-early-literature-complete:p015:m0002"],"kind":"paragraph"}],"mention_count":12,"duplicate_mention_count":0,"paragraph_occurrence_count":12,"table_occurrence_count":0,"passage_count":5,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"12處獨立位置，12個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-052-early-literature-complete-ws2371079"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-052-early-literature-complete:source_review11-0","kind":"source_review","person_id":"fha_6ju_xi9","source_quote":"　　卞彬字士蔚，濟陰冤句人也。祖嗣之，中領軍。父延之，有剛氣，爲上虞令。","reading":"卞彬字士蔚，祖卞嗣之，父卞延之。","note":"卞彬字士蔚，祖卞嗣之，父卞延之。","paragraph_id":"c-nanqishu-052-early-literature-complete:p011","start_codepoint":0,"end_codepoint":36,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:source_review12-0","kind":"source_review","person_id":"fha_6ju_xi9","source_quote":"　　彬才操不羣，文多指刺。州辟西曹主簿，奉朝請，員外郎。宋元徽末，四貴輔政。彬謂太祖曰：「外閒有童謠云：『可憐可念尸著服，孝子不在日代哭，列管蹔鳴死滅族。』公頗聞不？」時王蘊居父憂，與袁粲同死，故云尸著服也。服者衣也，褚字邊衣也，孝除子，以日代者，謂褚淵也。列管，蕭也。」彬退，太祖笑曰：「彬自作此。」齊臺初建，彬又曰：「誰謂宋遠，跂予望之。」太祖聞之，不加罪也。除右軍參軍。家貧，出爲南康郡丞。","reading":"宋元徽末童謠解語依其指涉，太祖猜為卞彬自作。","note":"宋元徽末童謠解語依其指涉，太祖猜為卞彬自作。","paragraph_id":"c-nanqishu-052-early-literature-complete:p012","start_codepoint":0,"end_codepoint":198,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:source_review13-0","kind":"source_review","person_id":"fha_6ju_xi9","source_quote":"　　彬頗飲酒，擯棄形骸。作《蚤虱賦序》曰：「余居貧，布衣十年不制。一袍之縕，有生所託，資其寒暑，無與易之。爲人多病，起居甚疏，縈寢敗絮，不能自釋。兼攝性懈惰，嬾事皮膚，澡刷不謹，澣沐失時，四體，加以臭穢，故葦席蓬纓之間，蚤虱猥流。淫癢渭濩，無時恕肉，探揣擭撮，日不替手。虱有諺言，朝生暮孫。若吾之虱者，無湯沐之慮，絕相弔之憂，宴聚乎久襟爛布之裳，服無改換，搯齧不能加，脫略緩嬾，復不懃於捕討，孫孫息息，三十五歲焉。」其略言皆實錄也。","reading":"《蚤虱賦序》的十年、三十五歲均在賦語之內，無卞彬本人年齡證據。殿考證載「諺言」等字異。","note":"《蚤虱賦序》的十年、三十五歲均在賦語之內，無卞彬本人年齡證據。殿考證載「諺言」等字異。","paragraph_id":"c-nanqishu-052-early-literature-complete:p013","start_codepoint":0,"end_codepoint":216,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:source_review14-0","kind":"source_review","person_id":"fha_6ju_xi9","source_quote":"　　除南海王國郎中令，尚書比部郎，安吉令，車騎記室。彬性好飲酒，以瓠壺瓢勺杬皮爲肴，著帛冠十二年不改易，以大瓠爲火籠，什物多諸詭異。自稱「卞田居」，婦爲「傅蠶室」。或諫曰：「卿都不持操，名器何由得升？」彬曰：「擲五木子，十擲輙鞬，豈復是擲子之拙。吾好擲，政極此耳。」永元中，爲平越長史、綏建太守，卒官。","reading":"卞田居為自稱，傅蠶室為妻的稱號。永元中卒官，無確年。","note":"卞田居為自稱，傅蠶室為妻的稱號。永元中卒官，無確年。","paragraph_id":"c-nanqishu-052-early-literature-complete:p014","start_codepoint":0,"end_codepoint":151,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-complete","source_id":"s-nanqishu-052-early-literature-complete-ws2371079"},{"id":"c-nanqishu-052-early-literature-complete:source_review15-0","kind":"source_review","person_id":"fha_6ju_xi9","source_quote":"　　彬又目禽獸云：「羊性淫而狠，豬性卑而率，鵝性頑而傲，狗性險而出。」皆指斥貴勢。其蝦蟆賦云：「紆青拖紫，名爲蛤魚。」世謂比令僕也。又云：「科斗唯唯，羣浮闇水。維朝繼夕，聿役如鬼。」比令史諮事也。文章傳於閭巷。","reading":"禽獸與《蝦蟆賦》是指斥官場的文義，與兩個附傳逐字分開。","note":"禽獸與《蝦蟆賦》是指斥官場的文義，與兩個附傳逐字分開。","paragraph_id":"c-nanqishu-052-early-literature-complete:p015","start_codepoint":0,"end_codepoint":105,"human_reviewed":false,"chapter_id":"c-nanqishu-052-early-literature-comple