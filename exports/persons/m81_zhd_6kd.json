riginal_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanshi-024-wangyan:p008:m0098","surface":"鮮于文粲","start":98,"end":102,"person_id":"m81_zhd_6kd","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-024-wangyan:p008","chapter_id":"c-nanshi-024-wangyan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-024-wangyan:p008","text":"晏人望未重，又與上素疎，中興初，雖以事計委任，而內相疑阻，晏無防意。既居朝端，事多專決，內外要職，並用周旋門義，毎與上爭用人。數呼相工自視，雲當大貴。與客語，好屏人。上聞，疑晏欲反，遂有誅晏意。有鮮于文粲與晏子德元往來，密探朝旨，告晏有異志。又左右單景雋、陳世范等采巫覡言啟上，雲晏懷異圖。是時南郊應親奉，景雋等言晏因此與武帝故主帥于道中竊發。會獸犯郊壇，帝愈懼，未郊前一日，上乃停行，先報晏及徐孝嗣，孝嗣奉旨，而晏陳郊祀事大，必宜自力。景雋言益見信，元會畢，乃召晏于華林省誅之。下詔顯其罪，稱以河東王鉉識用微弱，欲令守以虛器，並令收付廷尉。","mentions":[{"id":"c-nanshi-024-wangyan:p008:m0000","surface":"晏","start":0,"end":1,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0029","surface":"晏","start":29,"end":30,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0087","surface":"晏","start":87,"end":88,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0094","surface":"晏","start":94,"end":95,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0098","surface":"鮮于文粲","start":98,"end":102,"person_id":"m81_zhd_6kd","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangyan:p008:m0103","surface":"晏","start":103,"end":104,"person_id":"i08_s4b_5bb","kin