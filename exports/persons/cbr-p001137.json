001137","label":"雍（齊桓公子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"公子雍","mention_ids":["c-shiji-032-qi:m045-0092"]},{"surface":"雍","mention_ids":["c-shiji-040-chu:m016-0297"]}],"evidence":[{"mention_id":"c-shiji-032-qi:m045-0092","chapter_id":"c-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p045","quote":"公子雍"},{"mention_id":"c-shiji-040-chu:m016-0297","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p016","quote":"雍"}]}],"source_mention_summary":[{"source_id":"s-shiji-032-qi","work_id":"w-shiji","book_id":"b-shiji-032","chapter_id":"c-shiji-032-qi","mention_count":1,"mention_ids":["c-shiji-032-qi:m045-0092"],"paragraph_ids":["c-shiji-032-qi:p045"],"passage_count":1},{"source_id":"s-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","chapter_id":"c-shiji-040-chu","mention_count":1,"mention_ids":["c-shiji-040-chu:m016-0297"],"paragraph_ids":["c-shiji-040-chu:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-032-qi","s-shiji-040-chu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-032-qi:m045-0092","start":92,"end":95,"surface":"公子雍","kind":"person","person_id":"cbr-p001137","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p045","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-040-chu:m016-0297","start":297,"end":298,"surface":"雍","kind":"person","person_id":"cbr-p001137","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p016","chapter_id":"c-shiji-040-chu"}],"relations":[{"id":"a-shiji032-035","subject_person_id":"cbr-p001137","predicate":"mother","object_person_id":"cbr-p001131","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p045","quote":"四十三年。初，齊桓公之夫人三：曰王姬、徐姬、蔡姬，皆無子。桓公好內，多內寵，如夫人者六人，長衛姬，生無詭；少衛姬，生惠公元；鄭姬，生孝公昭；葛嬴，生昭公潘；密姬，生懿公商人；宋華子，生公子雍。桓公與管仲屬孝公於宋襄公，以為太子。雍巫有寵於衛共姬，因宦者豎刀以厚獻於桓公，亦有寵，桓公許之立無詭。管仲卒，五公子皆求立。冬十月乙亥，齊桓公卒。易牙入，與豎刀因內寵殺群吏，而立公子無詭為君。太子昭奔宋。"}],"qualifiers":{"source_term":"生","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文母子、兄弟、姊妹、配偶及祖先說；祖不補代數，異母女性不合併，不以史記記載當已確證身世。蔡姬原文弗絕不推婚姻終止。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji040-082","subject_person_id":"cbr-p001137","predicate":"father","object_person_id":"cbr-p000235","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p016","quote":"成王惲元年，初卽位，布德施惠，結舊好於諸侯。使人獻天子，天子賜胙，曰：「鎭爾南方夷越之亂，無侵中國。」於是楚地千里。十六年，齊桓公以兵侵楚，至陘山。楚成王使將軍屈完以兵御之，與桓公盟。桓公數以周之賦不入王室，楚許之，乃去。十八年，成王以兵北伐許，許君肉袒謝，乃釋之。二十二年，伐黃。二十六年，滅英。三十三年，宋襄公欲爲盟會，召楚。楚王怒曰：「召我，我將好往襲辱之。」遂行，至盂，遂執辱宋公，已而歸之。三十四年，鄭文公南朝楚。楚成王北伐宋，敗之泓，射傷宋襄公，襄公遂病創死。三十五年，晉公子重耳過楚，成王以諸侯客禮饗，而厚送之於秦。三十九年，魯僖公來請兵以伐齊，楚使申侯將兵伐齊，取穀，置齊桓公子雍焉。齊桓公七子皆奔楚，楚盡以爲上大夫。滅夔，夔不祀祝融、鬻熊故也。"}],"qualifiers":{"source_term":"齊桓公子雍","historicity":"historical_tradition"},"interpretation_note":"依本段明示父子稱呼，不由封置於穀或其他繼位敘事推親屬。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-183","person_id":"cbr-p001137","surfaces":["雍"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p045","quote":"四十三年。初，齊桓公之夫人三：曰王姬、徐姬、蔡姬，皆無子。桓公好內，多內寵，如夫人者六人，長衛姬，生無詭；少衛姬，生惠公元；鄭姬，生孝公昭；葛嬴，生昭公潘；密姬，生懿公商人；宋華子，生公子雍。桓公與管仲屬孝公於宋襄公，以為太子。雍巫有寵於衛共姬，因宦者豎刀以厚獻於桓公，亦有寵，桓公許之立無詭。管仲卒，五公子皆求立。冬十月乙亥，齊桓公卒。易牙入，與豎刀因內寵殺群吏，而立公子無詭為君。太子昭奔宋。"},{"paragraph_id":"c-shiji-040-chu:p016","quote":"成王惲元年，初卽位，布德施惠，結舊好於諸侯。使人獻天子，天子賜胙，曰：「鎭爾南方夷越之亂，無侵中國。」於是楚地千里。十六年，齊桓公以兵侵楚，至陘山。楚成王使將軍屈完以兵御之，與桓公盟。桓公數以周之賦不入王室，楚許之，乃去。十八年，成王以兵北伐許，許君肉袒謝，乃釋之。二十二年，伐黃。二十六年，滅英。三十三年，宋襄公欲爲盟會，召楚。楚王怒曰：「召我，我將好往襲辱之。」遂行，至盂，遂執辱宋公，已而歸之。三十四年，鄭文公南朝楚。楚成王北伐宋，敗之泓，射傷宋襄公，襄公遂病創死。三十五年，晉公子重耳過楚，成王以諸侯客禮饗，而厚送之於秦。三十九年，魯僖公來請兵以伐齊，楚使申侯將兵伐齊，取穀，置齊桓公子雍焉。齊桓公七子皆奔楚，楚盡以爲上大夫。滅夔，夔不祀祝融、鬻熊故也。"}],"rationale":"楚篇明稱齊桓公子雍，對照齊篇桓公內寵宋華子生公子雍，按名與父子稱呼暫同指；不據楚篇補母名、封邑或事件日期。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p045","text":"四十三年。初，齊桓公之夫人三：曰王姬、徐姬、蔡姬，皆無子。桓公好內，多內寵，如夫人者六人，長衛姬，生無詭；少衛姬，生惠公元；鄭姬，生孝公昭；葛嬴，生昭公潘；密姬，生懿公商人；宋華子，生公子雍。桓公與管仲屬孝公於宋襄公，以為太子。雍巫有寵於衛共姬，因宦者豎刀以厚獻於桓公，亦有寵，桓公許之立無詭。管仲卒，五公子皆求立。冬十月乙亥，齊桓公卒。易牙入，與豎刀因內寵殺群吏，而立公子無詭為君。太子昭奔宋。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m045-0007","start":7,"end":10,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0016","start":16,"end":18,"surface":"王姬","kind":"person","person_id":"cbr-p001124","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0019","start":19,"end":21,"surface":"徐姬","kind":"person","person_id":"cbr-p001125","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0022","start":22,"end":24,"surface":"蔡姬","kind":"person","person_id":"cbr-p001116","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0029","start":29,"end":31,"surface":"桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0045","start":45,"end":48,"surface":"長衛姬","kind":"person","person_id":"cbr-p001126","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0050","start":50,"end":52,"surface":"無詭","kind":"person","person_id":"cbr-p001132","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0053","start":53,"end":56,"surface":"少衛姬","kind":"person","person_id":"cbr-p001127","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0058","start":58,"end":61,"surface":"惠公元","kind":"person","person_id":"cbr-p001133","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0062","start":62,"end":64,"surface":"鄭姬","kind":"person","person_id":"cbr-p001128","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m045-0066","start":66,"end":69,"surface":"孝公昭","kind":"person","person_id":"cbr-