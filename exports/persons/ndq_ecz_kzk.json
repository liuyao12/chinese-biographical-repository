ly_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanshi-023-wangqiu-lu:p003:m0072","surface":"劉斌","start":72,"end":74,"person_id":"ndq_ecz_kzk","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-023-wangqiu-lu:p003","chapter_id":"c-nanshi-023-wangqiu-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-023-wangqiu-lu:p003","text":"時大將軍彭城王義康專以政事為本，刀筆幹練者多被意遇。謂劉湛曰：「王敬弘、王球之屬，竟何所堪施？為自富貴，復那可解。」球兄子履深結劉湛，委誠義康與劉斌等。球每訓厲，不納。自大將軍從事中郎轉太子中庶子，流涕訴義康不願違離，故復為從事中郎。文帝甚銜之。及誅湛之夕，履徒跣告球。球命為取履，先溫酒與之，謂曰：「常日謂汝何？」履怖不得答。球徐曰：「阿父在，汝何憂。」命左右扶郎還齋，上亦以球故，履免死廢於家。","mentions":[{"id":"c-nanshi-023-wangqiu-lu:p003:m0007","surface":"義康","start":7,"end":9,"person_id":"e9f_a95_f00","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p003:m0027","surface":"劉湛","start":27,"end":29,"person_id":"h3c_ulm_pto","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p003:m0032","surface":"王敬弘","start":32,"end":35,"person_id":"7r6_k52_qji_ABDABAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p003:m0036","surface":"王球","start":36,"end":38,"person_id":"3c9_d1d_870_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p003:m0058","surface":"球","start":58,"end":59,"person_id":"3c9_d1d_870_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p003:m0061","surface":"履","start":61,"end":62,"person_id":"