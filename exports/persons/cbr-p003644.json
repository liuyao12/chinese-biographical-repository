{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003644","canonical_person_id":"mlk_3li_pp1","id_aliases":["cbr-p003644"],"identity_policy":"contextual_provisional","person_ids":["mlk_3li_pp1"],"persons":[{"id":"mlk_3li_pp1","label":"慶（三王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"慶","mention_ids":["c-shiji-060-sanwang:m006-0047","c-shiji-060-sanwang:m007-0086"]}],"evidence":[{"mention_id":"c-shiji-060-sanwang:m006-0047","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p006","quote":"慶"},{"mention_id":"c-shiji-060-sanwang:m007-0086","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p007","quote":"慶"}],"id_aliases":["cbr-p003644"]}],"source_mention_summary":[{"source_id":"s-shiji-060-sanwang","work_id":"w-shiji","book_id":"b-shiji-060","chapter_id":"c-shiji-060-sanwang","mention_count":2,"mention_ids":["c-shiji-060-sanwang:m006-0047","c-shiji-060-sanwang:m007-0086"],"paragraph_ids":["c-shiji-060-sanwang:p006","c-shiji-060-sanwang:p007"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-060-sanwang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-060-sanwang:m006-0047","start":47,"end":48,"surface":"慶","kind":"person","person_id":"mlk_3li_pp1","status":"contextual_provisional","paragraph_id":"c-shiji-060-sanwang:p006","chapter_id":"c-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:m007-0086","start":86,"end":87,"surface":"慶","kind":"person","person_id":"mlk_3li_pp1","status":"contextual_provisional","paragraph_id":"c-shiji-060-sanwang:p007","chapter_id":"c-shiji-060-sanwang"}],"relations":[],"title_holdings":[{"id":"th-shiji060-016","person_id":"mlk_3li_pp1","title":"博士","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p006","quote":"四月戊寅，奏未央宮。「丞相臣青翟、御史大夫臣湯昧死言：臣青翟等與列侯、吏二千石、諫大夫、博士臣慶等議：昧死奏請立皇子為諸侯王。制曰：『康叔親屬有十而獨尊者，褒有德也。周公祭天命郊，故魯有白牡、騂剛之牲。群公不毛，賢不肖差也。「高山仰之，景行向之」，朕甚慕焉。所以抑未成，家以列侯可。』臣青翟、臣湯、博士臣將行等伏聞康叔親屬有十，武王繼體，周公輔成王，其八人皆以祖考之尊建為大國。康叔之年幼，周公在三公之位，而伯禽據國於魯，蓋爵命之時，未至成人。康叔後捍祿父之難，伯禽殄淮夷之亂。昔五帝異制，周爵五等，春秋三等，皆因時而序尊卑。高皇帝撥亂世反諸正，昭至德，定海內，封建諸侯，爵位二等。皇子或在繦緥而立為諸侯王，奉承天子，為萬世法則，不可易。陛下躬親仁義，體行聖德，表裏文武。顯慈孝之行，廣賢能之路。內褒有德，外討彊暴。極臨北海，西（湊）［溱］月氏，匈奴、西域，舉國奉師。輿械之費，不賦於民。虛御府之藏以賞元戎，開禁倉以振貧窮，減戍卒之半。百蠻之君，靡不鄉風，承流稱意。遠方殊俗，重譯而朝，澤及方外。故珍獸至，嘉穀興，天應甚彰。今諸侯支子封至諸侯王，而家皇子為列侯，臣青翟、臣湯等竊伏孰計之，皆以為尊卑失序，使天下失望，不可。臣請立臣閎、臣旦、臣胥為諸侯王。」四月癸未，奏未央宮，留中不下。"}],"attestations":[{"id":"th-shiji060-016:a001","paragraph_id":"c-shiji-060-sanwang:p006","start":44,"end":46,"surface":"博士","person_mention_id":"c-shiji-060-sanwang:m006-0047","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依來源用稱保存，首次提及不補授職日；守、行事及兼攝不冒稱正式新授，單名及制度未定者不補姓或官制細節。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji060-012","person_id":"mlk_3li_pp1","surfaces":["慶"],"scope":"same_chapter","chapter_ids":["c-shiji-060-sanwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-060-sanwang:p006","quote":"四月戊寅，奏未央宮。「丞相臣青翟、御史大夫臣湯昧死言：臣青翟等與列侯、吏二千石、諫大夫、博士臣慶等議：昧死奏請立皇子為諸侯王。制曰：『康叔親屬有十而獨尊者，褒有德也。周公祭天命郊，故魯有白牡、騂剛之牲。群公不毛，賢不肖差也。「高山仰之，景行向之」，朕甚慕焉。所以抑未成，家以列侯可。』臣青翟、臣湯、博士臣將行等伏聞康叔親屬有十，武王繼體，周公輔成王，其八人皆以祖考之尊建為大國。康叔之年幼，周公在三公之位，而伯禽據國於魯，蓋爵命之時，未至成人。康叔後捍祿父之難，伯禽殄淮夷之亂。昔五帝異制，周爵五等，春秋三等，皆因時而序尊卑。高皇帝撥亂世反諸正，昭至德，定海內，封建諸侯，爵位