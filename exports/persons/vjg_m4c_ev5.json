er_id":"c-songshu-084-xietiao-kong"},{"id":"c-songshu-084-xietiao-kong:p002:m0035","start":35,"end":36,"surface":"覬","person_id":"vjg_m4c_ev5","kind":"person","status":"contextual_provisional","interpretation_note":"本句具名，按上下文讀作孔覬〔宋，字思遠〕。","paragraph_id":"c-songshu-084-xietiao-kong:p002","chapter_id":"c-songshu-084-xietiao-kong"},{"id":"c-songshu-084-xietiao-kong:p002:m0104","start":104,"end":105,"surface":"覬","person_id":"vjg_m4c_ev5","kind":"person","status":"contextual_provisional","interpretation_note":"本句具名，按上下文讀作孔覬〔宋，字思遠〕。","paragraph_id":"c-songshu-084-xietiao-kong:p002","chapter_id":"c-songshu-084-xietiao-kong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-047-xietiao:p005","text":"　　建武四年，出爲晉安王鎮北諮議、南東海太守，行南徐州事。啓王敬則反謀，上甚嘉賞之。遷尚書吏部郎。朓上表三讓，中書疑朓官未及讓，以問祭酒沈約。約曰：「宋元嘉中，范曅讓吏部，朱脩之讓黃門，蔡興宗讓中書，竝三表詔答，具事宛然。近世小官不讓，遂成恒俗，恐此有乖讓意。王藍田、劉安西竝貴重，初自不讓，今豈可慕此不讓邪？孫興公、孔顗竝讓記室，今豈可三署皆讓邪？謝吏部今授超階，讓別有意，豈關官之大小？撝讓之美，本出人情。若大官必讓，便與詣闕章表不異。例旣如此，謂都自非疑。」朓又啓讓，上優答不許。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-nanqishu-047-xietiao:p005:m0030","start":30,"end":33,"surface":"王敬則","person_id":"7a0_95e_c4a","kind":"person","status":"contextual_provisional","interpretation_note":"本句具名，按上下文讀作王敬則。"},{"id":"c-nanqishu-047-xietiao:p005:m0049","start":49,"end":50,"surface":"朓","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"本句具名，按上下文讀作謝朓。"},{"id":"c-nanqishu-047-xietiao:p005:m0058","start":58,"end":59,"surface":"朓","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"本句具名，按上下文讀作謝朓。"},{"id":"c-nanqishu-047-xietiao:p005:m0068","start":68,"end":70,"surface":"沈約","person_id":"p8b_7w1_y3q","kind":"person","status":"contextual_provisional","interpretation_note":"本句具