atus":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m003-0050","start":50,"end":54,"surface":"武王黥布","kind":"person","person_id":"65g_u1c_0st","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m003-0063","start":63,"end":65,"surface":"項籍","kind":"person","person_id":"3sg_fes_hit","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m003-0066","start":66,"end":68,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m003-0070","start":70,"end":72,"surface":"劉賈","kind":"person","person_id":"d85_rbs_9sv","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m003-0080","start":80,"end":82,"surface":"盧綰","kind":"person","person_id":"3m0_o0z_l0l","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m003-0085","start":85,"end":90,"surface":"臨江王共尉","kind":"person","person_id":"bwv_ob8_6xi_A","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m003-0091","start":91,"end":93,"surface":"共尉","kind":"person","person_id":"bwv_ob8_6xi_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-051-jingyan","book_id":"b-shiji-051","work_id":"w-shiji","source_id":"s-shiji-051-jingyan"},{"id":"c-shiji-093-hanlu:p009","text":"漢五年冬，以破項籍，乃使盧綰別將，與劉賈擊臨江王共尉，破之。七月還，從擊燕王臧荼，臧荼降。高祖已定天下，諸侯非劉氏而王者七人。欲王盧綰，為群臣觖望。及虜臧荼，乃下詔諸將相列侯，擇群臣有功者以為燕王。群臣知上欲王盧綰，皆言曰：「太尉長安侯盧綰常從平定天下，功最多，可王燕。」詔許之。漢五年八月，乃立虜綰為燕王。諸侯王得幸莫如燕王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m009-0007","start":7,"end":9,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0012","start":12,"end":14,"surface":"盧綰","kind":"person","person_id":"jjl_irg_zke_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0018","start":18,"end":20,"surface":"劉賈","kind":"person","person_id":"d85_rbs_9sv","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0024","start":24,"end":26,"surface":"共尉","kind":"person","person_id":"bwv_ob8_6xi_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0038","start":38,"end":40,"surface":"臧荼","kind":"person","person_id":"xaa_ewn_4ro","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0041","start":41,"end":43,"surface":"臧荼","kind":"person","person_id":"xaa_ewn_4ro","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0045","start":45,"end":47,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0065","start":65,"end":67,"surface":"盧綰","kind":"person","person_id":"jjl_irg_zke_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0076","start":76,"end":78,"surface":"臧荼","kind":"person","person_id":"xaa_ewn_4ro","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0102","start":102,"end":103,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0105","start":105,"end":107,"surface":"盧綰","kind":"person","person_id":"jjl_irg_zke_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0118","start":118,"end":120,"surface":"盧綰","kind":"person","person_id":"jjl_irg_zke_A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m009-0149","start":149,"end":150,"surface":"綰","kind":"person","person_id":"jjl_irg_zke_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-093-hanlu","book_id":"b-shiji-093","work_id":"w-shiji","source_id":"s-shiji-093-hanlu"},{"id":"c-shiji-098-fujin:p007","text":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m007-0008","start":8,"end":10,"surface":"賁郝","kind":"person","person_id":"phx_lyu_9ym","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0136","start":136,"end":138,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0157","start":157,"end":159,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0182","start":182,"end":184,"surface":"項悍","kind":"person","person_id":"xtl_sr1_di0","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0190","start":190,"end":192,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0219","start":219,"end":222,"surface":"江陵王","kind":"person","person_id":"bwv_ob8_6xi_A","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0239","start":239,"end":242,"surface":"楚王信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0259","start":259,"end":262,"surface":"信武侯","kind":"person","person_id":"7dv_lqp_y4z","status":"contextual_provisional"}],"chapter_id":"c-shiji-098-fujin","book_id":"b-shiji-098","work_id":"w-shiji","source_id":"s-shiji-098-fujin"}],"table_passages":[{"id":"shiji-016-t2-r033-c04","column":4,"rowspan":1,"colspan":1,"text":"臨江王驩。始，敖子。","source_row":34,"source_column":5,"printed_page":null,"person_mentions":[{"id":"shiji-016-t2-r033-c04-m000","start":3,"end":4,"surface":"驩","person_id":"bwv_ob8_6xi_A","status":"contextual_provisional","interpretation_note":"依臨江國列、敖子及漢虜驩的承接辨指，並與所列篇文原句對讀；不按同爵號全域接合。","identity_evidence":[{"work_id":"w-shiji","book_id":"b-shiji-008","chapter_id":"c-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p055","source_id":"s-shiji-008-gaozu","source_revision":2440965,"person_id":"bwv_ob8_6xi_A","quote":"天下大定。高祖都雒陽，諸侯皆臣屬。故臨江王驩為項羽叛漢，令盧綰、劉賈圍之，不下。數月而降，殺之雒陽。"}]},{"id":"shiji-016-t2-r033-c04-m001","start":7,"end":8,"surface":"敖","person_id":"bwv_ob8_6xi","status":"contextual_provisional","interpretation_note":"依臨江國列、敖子及漢虜驩的承接辨指，並與所列篇文原句對讀；不按同爵號全域接合。","identity_evidence":[{"work_id":"w-shiji","book_id":"b-shiji-007","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p021","source_id":"s-shiji-007-xiangyu","source_revision":5978360,"person_id":"bwv_ob8_6xi","quote":"項王使人致命懷王。懷王曰：「如約。」乃尊懷王為義帝。項王欲自王，先王諸將相。謂曰：「天下初發難時，假立諸侯後以伐秦。然身被堅執銳首事，暴露於野三年，滅秦定天下者，皆將相諸君與籍之力也。義帝雖無功，故當分其地而王之。」諸將皆曰：「善。」乃分天下，立諸將為侯王。項王、范增疑沛公之有天下，業已講解，又惡負約，恐諸侯叛之，乃陰謀曰：「巴、蜀道險，秦之遷人皆居蜀。」乃曰：「巴、蜀亦關中地也。」故立沛公為漢王，王巴、蜀、漢中，都南鄭。而三分關中，王秦降將以距塞漢王。項王乃立章邯為雍王，王咸陽以西，都廢邱。長史欣者，故為櫟陽獄掾，嘗有德於項梁；都尉董翳者，本勸章邯降楚。故立司馬欣為塞王，王咸陽以東至河，都櫟陽；立董翳為翟王，王上郡，都高奴。徙魏王豹為西魏王，王河東，都平陽。瑕丘申陽者，張耳嬖臣也，先下河南（郡），迎楚河上，故立申陽為河南王，都雒陽。韓王成因故都，都陽翟。趙將司馬卬定河內，數有功，故立卬為殷王，王河內，都朝歌。徙趙王歇為代王。趙相張耳素賢，又從入關，故立耳為常山王，王趙地，都襄國。當陽君黥布為楚將，常冠軍，故立布為九江王，都六。鄱君吳芮率百越佐諸侯，又從入關，故立芮為衡山王，都邾。義帝柱國共敖將兵擊南郡，功多，因立敖為臨江王，都江陵。徙燕王韓廣為遼東王。燕將臧荼從楚救趙，因從入關，故立荼為燕王，都薊。徙齊王田市為膠東王。齊將田都從共救趙，因從入關，故立都為齊王，都臨菑。故秦所滅齊王建孫田安，項羽方渡河救趙，田安下濟北數城，引其兵降項羽，故立安為濟北王，都博陽。田榮者，數負項梁，又不肯將兵從楚擊秦，以故不封。成安君陳餘棄將印去，不從入關，然素聞其賢，有功於趙，聞其在南皮，故因環封三縣。番君將梅鋗功多，故封十萬戶侯。項王自立為西楚霸王，王九郡，都彭城。"}]}],"table_id":"shiji-016","work_id":"w-shiji","book_id":"b-shiji-016","chapter_id":"table-chapter-shiji-016","source_id":"table-witness-shiji-016"}],"sources":[{"chapter_id":"c-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","source_id":"s-shiji-008-gaozu","source":{"title":"史記／卷008","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷008","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷008&oldid=2440965","revision_id":2440965,"accessed_on":"2026-10-09","extent":"本篇傳世正文91個p區塊，自「高祖，沛豐邑中陽里人」至太史公論贊；不含導覽標題、跨站連結及另署【索隱述贊】的後出文字。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"馕":"饢"},"editorial_readings":[],"extraction_note":"正文91段均為p；前置兩個dd為跨站導覽，不收錄。排除sup註號，保留原有行內校勘符號。","note":"第48、57段馕僅作明示簡繁轉換為饢，詞義與疑讀待核，不逕改為餉或饟。數位轉錄尚未核紙本或影像。"}}},{"cha