age_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-068-xuejian-ws2581578"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin068-xueyong-father","subject_person_id":"o7o_dqk_eal","object_person_id":"i8f_2hf_xm5","predicate":"father","qualifiers":{"source_term":"子顒，先兼卒"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-068","chapter_id":"c-jinshu-068-xuejian","source_id":"s-jinshu-068-xuejian-ws2581578","paragraph_id":"c-jinshu-068-xuejian:p002","quote":"永昌初，王敦表兼為太常。明帝即位，加散騎常侍。帝以東宮時師傅，猶宜盡敬，乃下詔曰：「朕以不德，夙遭閔凶。猥以眇身，托于王公之上。哀煢在疚，靡所諮仰，憂懷惴惴，如臨于谷。孔子有云：『故雖天子，必有尊也。』朕將祗奉先師之禮，以諮有德。太宰西陽王秩尊望重，在貴思降。丞相武昌公、司空即丘子體道高邈，勳德兼備，先帝執友，朕之師傅。太常安陽鄉侯訓保朕躬，忠肅篤誠。夫崇親尊賢，先帝所重，朕見四君及書疏儀體，一如東宮故事。」是歲，卒。詔曰：「太常、安陽鄉侯兼履德沖素，盡忠恪己。方賴德訓，弘濟政道，不幸殂殞，痛於厥心。今遣持節侍御史贈左光祿大夫、開府儀同三司。魂而有靈，嘉茲榮寵。」及葬，屬王敦作逆，朝廷多故，不得議諡，直遣使者祭乙太牢。子顒，先兼卒，無後。","subject_person_mention_id":"c-jinshu-068-xuejian:p002:m0314","object_person_mention_id":"c-jinshu-068-xuejian:p002:m0007"}],"status":"source_attested","interpretation_note":"原文記無後。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin068-xueyong","person_id":"o7o_dqk_eal","event_type":"death","source_term":"先兼卒","source_anchor":{"paragraph_id":"c-jinshu-068-xuejian:p002","start":316,"end":319,"surface":"先兼卒"},"date_expression":null,"evidence":[{"work_id":"w-