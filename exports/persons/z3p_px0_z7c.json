"kind":"person","person_id":"z3p_px0_z7c","status":"contextual_provisional","paragraph_id":"c-shiji-123-dayuan:p030","chapter_id":"c-shiji-123-dayuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p030","text":"天子已嘗使浞野侯攻樓蘭，以七百騎先至，虜其王，以定漢等言為然，而欲侯寵姬李氏，拜李廣利為貳師將軍，發屬國六千騎，及郡國惡少年數萬人，以往伐宛。期至貳師城取善馬，故號「貳師將軍」。趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。是歲太初元年也。而關東蝗大起，蜚西至敦煌。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m030-0000","start":0,"end":2,"surface":"天子","kind":"person","person_id":"mws_e02_g1o","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0005","start":5,"end":8,"surface":"浞野侯","kind":"person","person_id":"z0l_1wp_de1","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0020","start":20,"end":22,"surface":"其王","kind":"person","person_id":"lx3_ne1_5h4","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0024","start":24,"end":26,"surface":"定漢","kind":"person","person_id":"pbn_4mh_7ix","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0034","start":34,"end":38,"surface":"寵姬李氏","kind":"person","person_id":"z3p_px0_z7c","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0040","start":40,"end":43,"surface":"李廣利","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0044","start":44,"end":48,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0083","start":83,"end":87,"surface":"貳師將軍","kind":"person","person_id":"pez_8dn_r76","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m030-0089","start":89,"end":92,"surface":"趙始成","kind":"person","person_id":"zpc_ufe_fc2","status":"contextual_provisional"},{"id":