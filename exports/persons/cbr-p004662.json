83-luzou:m003-0261","start":261,"end":262,"surface":"勝","kind":"person","person_id":"cbr-p004663","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m003-0269","start":269,"end":272,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"}],"chapter_id":"c-shiji-083-luzou","book_id":"b-shiji-083","work_id":"w-shiji","source_id":"s-shiji-083-luzou"},{"id":"c-shiji-083-luzou:p004","text":"魯連見新垣衍而無言。新垣衍曰：「吾視居此圍城之中者，皆有求於平原君者也；今吾觀先生之玉貌，非有求於平原君者也，曷為久居此圍城之中而不去？」魯仲連曰：「世以鮑焦為無從頌而死者，皆非也。眾人不知，則為一身。彼秦者，棄禮義而上首功之國也，權使其士，虜使其民。彼即肆然而為帝，過而為政於天下，則連有蹈東海而死耳，吾不忍為之民也。所為見將軍者，欲以助趙也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-083-luzou:m004-0000","start":0,"end":2,"surface":"魯連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0003","start":3,"end":6,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0010","start":10,"end":13,"surface":"新垣衍","kind":"person","person_id":"cbr-p004662","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0018","start":18,"end":25,"surface":"居此圍城之中者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留，不補未見姓名。"},{"id":"c-shiji-083-luzou:m004-0030","start":30,"end":33,"surface":"平原君","kind":"person","person_id":"cbr-p004663","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0039","start":39,"end":41,"surface":"先生","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0049","start":49,"end":52,"surface":"平原君","kind":"person","person_id":"cbr-p004663","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0069","start":69,"end":72,"surface":"魯仲連","kind":"person","person_id":"cbr-p004656","status":"contextual_provisional"},{"id":"c-shiji-083-luzou:m004-0077","start":77,"end":79,"surface":"鮑焦","kind":"person","person_