ult":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-056-zhuran:line032:m0090","start":90,"end":92,"surface":"李興","kind":"person","person_id":"kve_gzb_xbr","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-056-zhuran:line032","chapter_id":"c-sanguozhi-056-zhuran"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-056-zhuran:line032","text":"　　赤烏五年，征柤中，魏將蒲忠、胡質各將數千人，忠要遮險隘。圖斷然後，質為忠繼援。時然所督兵將先四出，聞問不暇收合，便將帳下見兵八百人逆掩。忠戰不利，質等皆退。九年，復征柤中，魏將李興等聞然深入，率步騎六千斷然後道，然夜出逆之，軍以勝反。先是，歸義馬茂懷奸，覺誅，權深忿之。然臨行上疏曰：「馬茂小子，敢負恩養。臣今奉天威，事蒙克捷，欲令所獲，震耀遠近，方舟塞江，使足可觀，以解上下之忿。惟陛下識臣先言，責臣後效。」權時抑表不出。然既獻捷，群臣上賀，權乃舉酒作樂，而出然表曰：「此家前初有表，孤以為難必，今果如其言，可謂明於見事也。」遣使拜然為左大司馬、右軍師。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-056-zhuran:line032:m0013","start":13,"end":15,"surface":"蒲忠","kind":"person","person_id":"tdx_ujs_azv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuran:line032:m0016","start":16,"end":18,"surface":"胡質","kind":"person","person_id":"5d4_n4b_yty","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuran:line032:m0024","start":24,"end":25,"surface":"忠","kind":"person","person_id":"tdx_ujs_azv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuran:line032:m0032","start":32,"end":33,"surface":"然","kind":"person","person_id":"tut_0t1_tb8","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-056-zhuran:line032:m0035","start":35,"end":36,"surface":"質","kind":"person","person_id":"5d4_n4b_yty","status":"contextual_provisional","interpretation_n