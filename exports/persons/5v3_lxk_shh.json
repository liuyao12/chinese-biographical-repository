red":false},"family_paths":[],"mentions":[{"id":"c-shiji-109-liguang:m005-0139","start":139,"end":141,"surface":"胡兒","kind":"person","person_id":"5v3_lxk_shh","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p005","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m005-0150","start":150,"end":152,"surface":"胡兒","kind":"person","person_id":"5v3_lxk_shh","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p005","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m005-0157","start":157,"end":158,"surface":"兒","kind":"person","person_id":"5v3_lxk_shh","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p005","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m005-0196","start":196,"end":198,"surface":"胡兒","kind":"person","person_id":"5v3_lxk_shh","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p005","chapter_id":"c-shiji-109-liguang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-109-liguang:p005","text":"後漢以馬邑城誘單于，使大軍伏馬邑旁谷，而廣爲驍騎將軍，領屬護軍將軍。是時單于覺之，去，漢軍皆無功。其後四歳，廣以衞尉爲將軍，出鴈門擊匈奴。匈奴兵多，破敗廣軍，生得廣。單于素聞廣賢，令曰：「得李廣必生致之。」胡騎得廣，廣時傷病，置廣兩馬閒，絡而盛臥廣。行十餘里，廣佯死，睨其旁有一胡兒騎善馬，廣暫騰而上胡兒馬，因推墮兒，取其弓，鞭馬南馳數十里，復得其餘軍，因引而入塞。匈奴捕者騎數百追之，廣行取胡兒弓，射殺追騎，以故得脫。於是至漢，漢下廣吏。吏當廣所失亡多，爲虜所生得，當斬，贖爲庶人。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-109-liguang:m005-0007","start":7,"end":9,"surface":"單于","kind":"person","person_id":"qd7_pum_453","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m005-0020","start":20,"end":21,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m005-0029","start":29,"end":33,"surface":"護軍將軍","kind":"person","person_id":"6hy_i1z_hu2","status":"contextual_provis