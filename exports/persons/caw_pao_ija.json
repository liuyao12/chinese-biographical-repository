red":false},"family_paths":[],"mentions":[{"id":"c-jinshu-075-fanning:p013:m0012","surface":"張湛","start":12,"end":14,"person_id":"caw_pao_ija","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-075-fanning:p013","chapter_id":"c-jinshu-075-fanning"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-075-fanning:p013","text":"初，寧嘗患目痛就中書侍郎張湛求方，湛因嘲之曰：「古方，宋陽裏子少得其術，以授魯東門伯，魯東門伯以授左丘明，遂世也上傳。及漢杜子夏鄭康成、魏高堂隆、晉左太沖，凡此諸賢，並有目疾，得此方云：用損讀書一，減思慮二，專內視三，簡外觀四，旦晚起五，夜早眠六。凡六物熬以神火，下以氣簁，蘊於胸中七日，然後納諸方寸。修之一時，近能數其目睫，遠視尺捶之餘。長服不已，洞見牆壁之外。非但明目，乃亦延年。」既免官，家於丹陽，猶勤經學，終年不輟。年六十三，卒於家。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":200,"last_line":200,"raw_start":15754,"raw_end":15977,"raw_character_offsets":[15756,15757,15758,15759,15760,15761,15762,15763,15764,15765,15766,15767,15768,15769,15770,15771,15772,15773,15774,15775,15776,15777,15778,15779,15780,15781,15782,15783,15784,15785,15786,15787,15788,15789,15790,15791,15792,15793,15794,15795,15796,15797,15798,15799,15800,15801,15802,15803,15804,15805,15806,15807,15808,15809,15810,15811,15812,15813,15814,15815,15816,15817,15818,15819,15820,15821,15822,15823,15824,15825,15826,15827,15828,15829,15830,15831,15832,15833,15834,15835,15836,15837,15838,15839,15840,15841,15842,15843,15844,15845,15846,15847,15848,15849,15850,15851,15852,15853,15854,15855,15856,15857,15858,15859,15860,15861,15862,15863,15864,15865,15866,15867,15868,15869,15870,15871,15872,15873,15874,15875,15876,15877,15878,15879,15880,15881,15882,15883,15884,15885,15886,15887,15888,15889,15890,15891,15892,15893,15894,15895,15896,15897,15898,15899,15900,15901,15902,15903,15904,15905,15906,15907,15908,15909,15910,15911,15912,15913,15914,15915,15916,15917,15918,15919,15920,15921,15922,15923,15924,15925,15926,15927,15928,15929,15930