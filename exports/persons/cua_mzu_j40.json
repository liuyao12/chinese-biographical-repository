:290,"end":292,"person_id":"eyc_8y6_02q","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"},{"id":"c-nanqishu-047-wangrong-wyd:p015:m0294","surface":"弁","start":294,"end":295,"person_id":"sra_l7p_eeg","kind":"person","status":"contextual_provisional","interpretation_note":"對讀本傳上下文。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":"cbr-ai-transcription-sha256:b3e13ccecc0f8c15729050515a6de4188790d8f8462c2804f0031b37022b7043","source_layer":"received_biography","column_projection":[{"column":"32R06","pdf_page":32,"half":"右","leaf":"五下","column_from_right":6,"start":6,"end":21,"text":"上以融才辯十一年使兼主客接虜使"},{"column":"32R07","pdf_page":32,"half":"右","leaf":"五下","column_from_right":7,"start":0,"end":21,"text":"房景高宋弁弁見融年少問主客年幾融曰五十之年"},{"column":"32R08","pdf_page":32,"half":"右","leaf":"五下","column_from_right":8,"start":0,"end":21,"text":"久踰其半因問在朝聞主客作曲水詩序景高又云在"},{"column":"32R09","pdf_page":32,"half":"右","leaf":"五下","column_from_right":9,"start":0,"end":21,"text":"北聞主客此製勝於顏延年實願一見融乃示之後日"},{"column":"32R10","pdf_page":32,"half":"右","leaf":"五下","column_from_right":10,"start":0,"end":21,"text":"宋弁於瑤池堂謂融曰昔觀相如封禪以知漢武之德"},{"column":"32L01","pdf_page":32,"half":"左","leaf":"六上","column_from_right":1,"start":0,"end":21,"text":"今覽王生詩序用見齊王之盛融曰皇家盛明豈直比"},{"column":"32L02","pdf_page":32,"half":"左","leaf":"六上","column_from_right":2,"start":0,"end":21,"text":"蹤漢武更慙鄙製無以遠匹相如上以虜獻馬不稱使"},{"column":"32L03","pdf_page":32,"half":"左","leaf":"六上","column_from_right":3,"start":0,"end":21,"text":"融問曰秦西冀北實多駿驥而魏主所獻良馬乃駑駘"},{"column":"32L04","pdf_page":32,"half":"左","leaf":"六上","column_from_right":4,"start":0,"end":21,"text":"之不若求名檢事殊為未孚將旦旦信誓有時而爽駉"},{"column":"32L05","pdf_page":32,"half":"左","leaf":"六上","column_from_right":5,"start":0,"end":21,"text":"駉之牧不能復嗣宋弁曰不容虛僞之名當是不習土"},{"column":"32L06","pdf_page":32,"half":"左","leaf":"六上","column_from_right":6,"start":0,"end":21,"text":"地融曰周穆馬迹偏於天下若騏驥之性因地而遷則"},{"column":"32L07","pdf_page":32,"half":"左","leaf":"六上","column_from_right":7,"start":0,"end":21,"text":"造父之策有時而躓弁曰王主客何為懃懃於千里融"},{"column":"32L08","pdf_page":32,"half":"左","leaf":"六上","column_from_right":8,"start":0,"end":21,"text":"曰卿國既異其優劣聊復相訪若千里日至聖上當駕"},{"column":"32L09","pdf_page":32,"half":"左","leaf":"六上","column_from_right":9,"start":0,"end":21,"text":"鼓車弁曰向意既須必不能駕鼓車也融曰買死馬之"},{"column":"32L10","pdf_page":32,"half":"左","leaf":"六上","column_from_right":10,"start":0,"end":10,"text":"骨亦郭隗之故弁不能答"}]},"chapter_id":"c-nanqishu-047-wangrong-wyd","book_id":"b-nanqishu-047","work_id":"w-nanqishu","source_id":"s-nanqishu-047-wangrong-wyd1739"},{"id":"c-nanqishu-047-wangrong:p015","text":"上以融才辯，十一年，使兼主客，接虜使房景高、宋弁。弁見融年少，問主客年幾？融曰：「五十之年，久踰其半。」因問：「在朝聞主客作《曲水詩序》。」景高又云：「在北聞主客此制，勝於顏延年，實願一見。」融乃示之。後日，宋弁於瑤池堂謂融曰：「昔觀相如《封禪》，以知漢武之德；今覽王生《詩序》，用見齊王之盛。」融曰：「皇家盛明，豈直比蹤漢武；更慚鄙製，無以遠匹相如。」上以虜獻馬不稱，使融問曰：「秦西冀北，實多駿驥。而魏主所獻良馬，乃駑駘之不若。求名檢事，殊爲未孚。將旦旦信誓，有時而爽，駉駉之牧，不能復嗣？」宋弁曰：「不容虛偽之名，當是不習土地。」融曰：「周穆馬迹徧於天下，若騏驥之性，因地而遷，則造父之策，有時而躓。」弁曰：「王主客何爲懃懃於千里？」融曰：「卿國旣異其優劣，聊復相訪。若千里日至，聖上當駕鼓車。」弁曰：「向意旣須，必不能駕鼓車也。」融曰：「買死馬之骨，亦以郭隗之故。」弁不能答。","mentions":[{"id":"c-nanqishu-047-wangrong:p015:m0002","surface":"融","start":2,"end":3,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0018","surface":"房景高","start":18,"end":21,"person_id":"cua_mzu_j40","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0022","surface":"宋弁","start":22,"end":24,"person_id":"sra_l7p_eeg","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0025","surface":"弁","start":25,"end":26,"person_id":"sra_l7p_eeg","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0027","surface":"融","start":27,"end":28,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0037","surface":"融","start":37,"end":38,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0070","surface":"景高","start":70,"end":72,"person_id":"cua_mzu_j40","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0086","surface":"顏延年","start":86,"end":89,"person_id":"ftg_rxy_day","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0096","surface":"融","start":96,"end":97,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0104","surface":"宋弁","start":104,"end":106,"person_id":"sra_l7p_eeg","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0111","surface":"融","start":111,"end":112,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0117","surface":"相如","start":117,"end":119,"person_id":"usb_lgr_ksa","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0148","surface":"融","start":148,"end":149,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0173","surface":"相如","start":173,"end":175,"person_id":"usb_lgr_ksa","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0186","surface":"融","start":186,"end":187,"person_id":"euq_wt7_i8i","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-047-wangrong:p015:m0248","surface":"宋弁","start":248,"end":250,"person_id":"sra