rt":0,"end":2,"surface":"釐公","kind":"person","person_id":"cbr-p001114","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0003","start":3,"end":5,"surface":"莊公","kind":"person","person_id":"cbr-p001106","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0008","start":8,"end":10,"surface":"哀姜","kind":"person","person_id":"cbr-p001112","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0015","start":15,"end":17,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0022","start":22,"end":24,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0025","start":25,"end":27,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0030","start":30,"end":31,"surface":"人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m048-0032","start":32,"end":34,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0035","start":35,"end":37,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0045","start":45,"end":49,"surface":"大夫奚斯","kind":"person","person_id":"cbr-p001248","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0054","start":54,"end":56,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0057","start":57,"end":59,"surface":"奚斯","kind":"person","person_id":"cbr-p001248","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0065","start":65,"end":68,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0069","start":69,"end":71,"surface":"哀姜","kind":"person","person_id":"cbr-p001112","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0072","start":72,"end":74,"surface":"慶父","kind":"person","person_id":"cbr-p001113","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0096","start":96,"end":99,"surface":"魯釐公","kind":"person","person_id":"cbr-p001114","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-033-lu:p049","text":"季友母陳女，故亡在陳，陳故佐送季友及子申。季友之將生也，父魯桓公使人卜之，曰：『男也，其名曰「友」，閒于兩社，爲公室輔。季友亡，則魯不昌。』及生，有文在掌曰『友』，遂以名之，號爲成季。其後爲季氏，慶父後爲孟氏也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m049-0000","start":0,"end":2,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m049-0002","start":2,"end":3,"surface":"母","kind":"person","person_id":"cbr-p001249","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m049-0003","start":3,"end":5,"surface":"陳女","kind":"person","person_id":"cbr-p001249","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m049-0015","start":15,"end":17,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m049-0018","start":18,"end":20,"surface":"子申","kind":"person","person_id":"cbr-p001114","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m049-0021","start":21,"end":23,"surface":"季友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m049-0029","start":29,"end":32,"surface":"魯桓公","kind":"person","person_id":"cbr-p000229","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m049-0033","start":33,"end":36,"surface":"人卜之","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m049-0047","start":47,"end":48,"surface":"友","kind":"person","person_id":"cbr-p001244","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m04