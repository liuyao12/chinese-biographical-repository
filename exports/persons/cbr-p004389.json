"start":99,"end":101,"surface":"李同","kind":"person","person_id":"cbr-p004389","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p006","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m006-0256","start":256,"end":258,"surface":"李同","kind":"person","person_id":"cbr-p004389","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p006","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m006-0294","start":294,"end":296,"surface":"李同","kind":"person","person_id":"cbr-p004389","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p006","chapter_id":"c-shiji-076-pingyu"}],"relations":[{"id":"a-shiji076-001","subject_person_id":"cbr-p004389","predicate":"father","object_person_id":"cbr-p004390","status":"source_attested","evidence":[{"chapter_id":"c-shiji-076-pingyu","source_id":"s-shiji-076-pingyu","paragraph_id":"c-shiji-076-pingyu:p006","quote":"平原君既返趙，楚使春申君將兵赴救趙，魏信陵君亦矯奪晉鄙軍往救趙，皆未至。秦急圍邯鄲，邯鄲急，且降，平原君甚患之。邯鄲傳舍吏子李同説平原君曰：「君不憂趙亡邪？」平原君曰：「趙亡則勝爲虜，何爲不憂乎？」李同曰：「邯鄲之民，炊骨易子而食，可謂急矣，而君之後宮以百數，婢妾被綺縠，餘粱肉，而民褐衣不完，糟糠不厭。民困兵盡，或剡木爲矛矢，而君器物鐘磬自若。使秦破趙，君安得有此？使趙得全，君何患無有？今君誠能令夫人以下編於士卒之閒，分功而作，家之所有盡散以饗士，士方其危苦之時，易德耳。」於是平原君從之，得敢死之士三千人。李同遂與三千人赴秦軍，秦軍爲之卻三十里。亦會楚、魏救至，秦兵遂罷，邯鄲復存。李同戰死，封其父爲李侯。"}],"qualifiers":{"source_term":"李同戰死，封其父爲李侯","historicity":"historical_tradition"},"interpretation_note":"按明示父母保存，李同父受爵不改為李同追贈；公甫文伯母為引古敘事，母妻評論不補配偶，二自殺女子不補姓名。平原君諸公子與親戚不推出未見父親。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji076-016","person_id":"cbr-p004389","scope":"same_chapter","chapter_ids":["c-shiji-076-pingyu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依毛遂合從與邯鄲救援的姓名、稱呼及局部回指暫接，楚王留未名，湯文王保存引古。毛遂明示遂短稱與敘事遂副詞分開；相士非任相。李同父邯鄲傳舍吏及李侯按同段父稱暫接，不把父封爵改成李同追贈。第7段舉平原君之趙王未逕接惠文或孝成，親戚、子孫與食客群體未補個別世系。","surfaces":["李同"],"evidence":[{"paragraph_id":"c-shiji-076-pingyu:p006","quote":"平原君既返趙，楚使春申君將兵赴救趙，魏信陵君亦矯奪晉鄙軍往救趙，皆未至。秦急圍邯鄲，邯鄲急，且降，平原君甚患之。邯鄲傳舍吏子李同説平原君曰：「君不憂趙亡邪？」平原君曰：「趙亡則勝爲虜，何爲不憂乎？」李同曰：「邯鄲之民，炊骨易子而食，可謂急矣，而君之後宮以百數，婢妾被綺縠，餘粱肉，而民褐衣不完，糟糠不厭。民困兵盡，或剡木爲矛矢，而君器物鐘磬自若。使秦破趙，君安得有此？使趙得全，君何患無有？今君誠能令夫人以下編於士卒之閒，分功而作，家之所有盡散以饗士，士方其危苦之時，易德耳。」於是平原君從之，得敢死之士三千人。李同遂與三千人赴秦軍，秦軍爲之卻三十里。亦會楚、魏救至，秦兵遂罷，邯鄲復存。李同戰死，封其父爲李侯。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-076-pingyu:p006","text":"平原君既返趙，楚使春申君將兵赴救趙，魏信陵君亦矯奪晉鄙軍往救趙，皆未至。秦急圍邯鄲，邯鄲急，且降，平原君甚患之。邯鄲傳舍吏子李同説平原君曰：「君不憂趙亡邪？」平原君曰：「趙亡則勝爲虜，何爲不憂乎？」李同曰：「邯鄲之民，炊骨易子而食，可謂急矣，而君之後宮以百數，婢妾被綺縠，餘粱肉，而民褐衣不完，糟糠不厭。民困兵盡，或剡木爲矛矢，而君器物鐘磬自若。使秦破趙，君安得有此？使趙得全，君何患無有？今君誠能令夫人以下編於士卒之閒，分功而作，家之所有盡散以饗士，士方其危苦之時，易德耳。」於是平原君從之，得敢死之士三千人。李同遂與三千人赴秦軍，秦軍爲之卻三十里。亦會楚、魏救至，秦兵遂罷，邯鄲復存。李同戰死，封其父爲李侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-076-pingyu:m006-0000","start":0,"end":3,"surface":"平原君","kind":"person","person_id":"cbr-p004374","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m006-0009","start":9,"end":12,"surface":"春申君","kind":"person","person_id":"cbr-p004382","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m006-0018","start":18,"end":22,"surface":"魏信陵君","kind":"person","person_id":"cbr-p004381","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m006-0025","start":25,"end":27,"surface":"晉鄙","kind":"person","person_id":"cbr-p004388","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m006-0049","start":49,"end":52,"surface":"平原君","kind":"person","person_id":"cbr-p004374","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m006-0056","start":56,"end":61,"surface":"邯鄲傳舍吏","kind":"person","person_id":"cbr-p004390","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m006-0062","start":62,"end":64,"surface":"李同","kind":"person","person_id":"cbr-p004389","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m006-0065","start":65,"end":68,"surface":"平原君","kind":"person","person_id":"cbr-p004374","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m006-0071","start":71,"end":72,"surface"