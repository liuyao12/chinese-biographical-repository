{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005029","identity_policy":"contextual_provisional","person_ids":["cbr-p005029"],"persons":[{"id":"cbr-p005029","label":"廷尉未名（張耳陳餘列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"廷尉","mention_ids":["c-shiji-089-zhanger:m026-0218"]}],"evidence":[{"mention_id":"c-shiji-089-zhanger:m026-0218","chapter_id":"c-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p026","quote":"廷尉"}]}],"mentions":[{"id":"c-shiji-089-zhanger:m026-0218","start":218,"end":220,"surface":"廷尉","kind":"person","person_id":"cbr-p005029","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p026","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[{"id":"th-shiji089-031","person_id":"cbr-p005029","title":"廷尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p026","quote":"漢九年，貫髙怨家知其謀，乃上變告之。於是上皆并逮捕趙王、貫髙等。十餘人皆爭自剄，貫髙獨怒罵曰：「誰令公爲之？今王實無謀，而并捕王；公等皆死，誰白王不反者！」乃轞車膠致，與王詣長安。治張敖之罪。上乃詔趙群臣賓客有敢從王皆族。貫髙與客孟舒等十餘人，皆自髡鉗，爲王家奴，從來。貫髙至，對獄，曰：「獨吾屬爲之，王實不知。」吏治榜笞數千，刺剟，身無可撃者，終不復言。呂后數言張王以魯元公主故，不宜有此。上怒曰：「使張敖據天下，豈少而女乎！」不聽。廷尉以貫髙事辭聞，上曰：「壯士！誰知者，以私問之。」中大夫泄公曰：「臣之邑子，素知之。此固趙國立名義不侵爲然諾者也。」上使泄公持節問之箯輿前。仰視曰：「泄公邪？」泄公勞苦如生平驩，與語，問張王果有計謀不。髙曰：「人情寧不各愛其父母妻子乎？今吾三族皆以論死，豈以王易吾親哉！顧爲王實不反，獨吾等爲之。」具道本指所以爲者王不知狀。於是泄公入，具以報，上乃赦趙王。"}],"attestations":[{"id":"th-shiji089-031:a001","paragraph_id":"c-shiji-089-zhanger:p026","start":218,"end":220,"surface":"廷尉","person_mention_id":"c-shiji-089-zhanger:m026-0218","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存明示授予、改封及用稱；十年追述不補起年，死亡不自動作任期終點；索隱述贊與正文分層。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-s