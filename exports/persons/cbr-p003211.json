paragraph_id":"c-shiji-051-jingyan:p010","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:m010-0045","start":45,"end":47,"surface":"郢人","kind":"person","person_id":"cbr-p003211","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p010","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:m010-0064","start":64,"end":66,"surface":"郢人","kind":"person","person_id":"cbr-p003211","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p010","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:m010-0076","start":76,"end":78,"surface":"郢人","kind":"person","person_id":"cbr-p003211","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p010","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:m012-0083","start":83,"end":85,"surface":"郢人","kind":"person","person_id":"cbr-p003211","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p012","chapter_id":"c-shiji-051-jingyan"}],"relations":[],"title_holdings":[{"id":"th-shiji051-026","person_id":"cbr-p003211","title":"肥如令","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-051-jingyan","source_id":"s-shiji-051-jingyan","paragraph_id":"c-shiji-051-jingyan:p010","quote":"至孫定國，與父康王姬姦，生子男一人。奪弟妻為姬。與子女三人姦。定國有所欲誅殺臣肥如令郢人，郢人等告定國，定國使謁者以他法劾捕格殺郢人以滅口。至元朔元年，郢人昆弟復上書具言定國陰事，以此發覺。詔下公卿，皆議曰：「定國禽獸行，亂人倫，逆天，當誅。」上許之。定國自殺，國除為郡。"}],"attestations":[{"id":"th-shiji051-026:a001","paragraph_id":"c-shiji-051-jingyan:p010","start":39,"end":42,"surface":"肥如令","person_mention_id":"c-shiji-051-jingyan:m010-0042","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、用稱、請封與條件許諾分開；張卿萬戶侯未記實授，呂產請立與已王語不冒稱同一明示授封事件。未知任期不由卒日或首次用稱推端點。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji051-026","person_id":"cbr-p003211","surfaces":["郢人"],"scope":"same_chapter","chapter_ids":["c-shiji-051-jingyan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-051-jingyan:p010","quote":"至孫定國，與父康王姬姦，生子男一人。奪弟妻為姬。與子女三人姦。定國有所欲誅殺臣肥如令郢人，郢人等告定國，定國使謁者以他法劾捕格殺郢人以滅口。至元朔元年，郢人昆弟復上書具言定國陰事，以此發覺。詔下公卿，皆議曰：「定國禽獸行，亂人倫，逆天，當誅。」上許之。定國自殺，國除為郡。"},{"paragraph_id":"c-shiji-051-jingyan:p012","quote":"【索隱述贊】劉賈初從，首定三秦。既渡白馬，遂圍壽春。始迎黥布，絕間周殷。賞功胙士，與楚為鄰。營陵始爵，勳由擊陳。田生遊說，受賜千斤。權激諸呂，事發榮身。徙封傳嗣，亡於郢人。"}],"rationale":"明示名與局部授封、游說角色暫接；劉賈劉澤分開，諸劉疏屬不補支系，田生子不改父名，定國案保存來源敘事不冒稱獨立核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-051-jingyan:p010","text":"至孫定國，與父康王姬姦，生子男一人。奪弟妻為姬。與子女三人姦。定國有所欲誅殺臣肥如令郢人，郢人等告定國，定國使謁者以他法劾捕格殺郢人以滅口。至元朔元年，郢人昆弟復上書具言定國陰事，以此發覺。詔下公卿，皆議曰：「定國禽獸行，亂人倫，逆天，當誅。」上許之。定國自殺，國除為郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-051-jingyan:m010-0002","start":2,"end":4,"surface":"定國","kind":"person","person_id":"cbr-p003210","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m010-0007","start":7,"end":9,"surface":"康王","kind":"person","person_id":"cbr-p003209","status":"contextual_provisional"},{"id":"c-shiji-051-jingyan:m010-0009","start":9,"end":10,"surface":"姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名家屬、條件稱號或未定指代，不補成員姓名及支系。"},{"id":"c-shiji-051-jingyan:m010-0013","start":13,"end":17,"surface":"子男一人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名家屬、條件稱號或未定指代，不補成員姓名及支系。"},{"id":"c-shiji-051-jingyan:m010-0019","start":19,"end":21,"surface":"弟妻","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名家屬、條件稱號或未定指代，不補成員姓名及支系。"},{"id":"c-shiji-051-jingyan:m010-0022","start":22,"end":23,"surface":"姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名家屬、條件稱號或未定指代，不補成員姓名及支系。"},{"id":"c-shiji-051-jingyan:m010-0025","start":25,"end":29,"surface":"子女三人","kind":"unresolved","person_id":null,"status"