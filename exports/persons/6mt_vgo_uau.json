r_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m045-0162","start":162,"end":164,"surface":"郭吉","kind":"person","person_id":"6mt_vgo_uau","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p045","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji110-002","person_id":"6mt_vgo_uau","surfaces":["郭吉","吉","吾"],"scope":"same_chapter","chapter_ids":["c-shiji-110-xiongnu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-110-xiongnu:p045","quote":"是時天子巡邊，至朔方，勒兵十八萬騎以見武節，而使郭吉風告單于。郭吉既至匈奴，匈奴主客問所使，郭吉禮卑言好，曰：「吾見單于而口言。」單于見吉，吉曰：「南越王頭已懸於漢北闕。今單于（能）即［能］前與漢戰，天子自將兵待邊；單于即不能，即南面而臣於漢。何徒遠走，亡匿於幕北寒苦無水草之地，毋爲也。」語卒而單于大怒，立斬主客見者，而留郭吉不歸，遷之北海上。而單于終不肯爲寇於漢邊，休養息士馬，習射獵，數使使於漢，好辭甘言求請和親。"}],"rationale":"郭吉入見後單于見吉、吉曰承同一使者；吾只限郭吉發言中的自稱，不合併任何他篇同名或代詞。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-110-xiongnu:p045","text":"是時天子巡邊，至朔方，勒兵十八萬騎以見武節，而使郭吉風告單于。郭吉既至匈奴，匈奴主客問所使，郭吉禮卑言好，曰：「吾見單于而口言。」單于見吉，吉曰：「南越王頭已懸於漢北闕。今單于（能）即［能］前與漢戰，天子自將兵待邊；單于即不能，即南面而臣於漢。何徒遠走，亡匿於幕北寒苦無水草之地，毋爲也。」語卒而單于大怒，立斬主客見者，而留郭吉不歸，遷之北海上。而單于終不肯爲寇於漢邊，休養息士馬，習射獵，數使使於漢，好辭甘言求請和親。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m045-0002","start":2,"end":4,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m045-0024","start":24,"end":26,"surface":"郭吉","kind":"person","person_id":"6mt_vgo_uau","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m045-0028","start":28,"end":30,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m045-0031","start":31,"end":33,"surface":"郭吉","kind":"person","person_id":"6mt_vgo_uau","status":"contextual_provisiona