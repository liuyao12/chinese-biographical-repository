:231,"end":233,"surface":"后稷","kind":"person","person_id":"ys8_rdi_f0i","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p006","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m016-0001","start":1,"end":2,"surface":"棄","kind":"person","person_id":"ys8_rdi_f0i","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p016","chapter_id":"c-shiji-130-taishigong"},{"id":"c-shiji-130-taishigong:m016-0003","start":3,"end":4,"surface":"稷","kind":"person","person_id":"ys8_rdi_f0i","status":"contextual_provisional","paragraph_id":"c-shiji-130-taishigong:p016","chapter_id":"c-shiji-130-taishigong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-130-taishigong:p006","text":"是歲天子始建漢家之封，而太史公留滯周南，不得與從事，故發憤且卒。而子遷適使反，見父於河洛之閒。太史公執遷手而泣曰：「余先周室之太史也。自上世嘗顯功名於虞夏，典天官事。後世中衰，絕於予乎？汝復為太史，則續吾祖矣。今天子接千歲之統，封泰山，而余不得從行，是命也夫，命也夫！余死，汝必為太史；為太史，無忘吾所欲論著矣。且夫孝始於事親，中於事君，終於立身。揚名於後世，以顯父母，此孝之大者。夫天下稱誦周公，言其能論歌文武之德，宣周邵之風，達太王王季之思慮，爰及公劉，以尊后稷也。幽厲之後，王道缺，禮樂衰，孔子修舊起廢，論詩書，作春秋，則學者至今則之。自獲麟以來四百有餘歲，而諸侯相兼，史記放絕。今漢興，海內一統，明主賢君忠臣死義之士，余為太史而弗論載，廢天下之史文，余甚懼焉，汝其念哉！」遷俯首流涕曰：「小子不敏，請悉論先人所次舊聞，弗敢闕。」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m006-0002","start":2,"end":4,"surface":"天子","kind":"person","person_id":"xqy_bvp_g1a","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0012","start":12,"end":15,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0034","start":34,"end":35,"surface":"遷","kind":"person","person_id":"pme_eis_xqi_*A*AAAAA","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m006-0047","start":47,"end":50,"surface":"太史公","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"co