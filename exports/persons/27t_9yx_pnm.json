,"surface":"遠","start":17,"end":18,"person_id":"27t_9yx_pnm","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-071-xiongyuan","book_id":"b-jinshu-071","work_id":"w-jinshu","source_id":"s-jinshu-071-xiongyuan-ws2595541"},{"id":"c-jinshu-071-xiongyuan:p013","text":"累遷侍中，出補會稽內史。時王敦作逆，沈充舉兵應之，加遠將軍，距而不受，不輸軍資於充，保境安眾為務。敦至石頭，諷朝廷征遠，乃拜太常卿，加散騎常侍。敦深憚其正而有謀，引為長史。數月病卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":4087,"raw_end":4178,"raw_character_offsets":[4087,4088,4089,4090,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4124,4125,4126,4127,4128,4129,4130,4131,4132,4133,4134,4135,4136,4137,4138,4139,4140,4141,4142,4143,4144,4145,4146,4147,4148,4149,4150,4151,4152,4153,4154,4155,4156,4157,4158,4159,4160,4161,4162,4163,4164,4165,4166,4167,4168,4169,4170,4171,4172,4173,4174,4175,4176,4177],"revision_id":2595541},"mentions":[{"id":"c-jinshu-071-xiongyuan:p013:m0013","surface":"王敦","start":13,"end":15,"person_id":"39o_b6y_n74","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-071-xiongyuan:p013:m0018","surface":"沈充","start":18,"end":20,"person_id":"4c2_19b_bf4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-071-xiongyuan:p013:m0026","surface":"遠","start":26,"end":27,"person_id":"27t_9yx_pnm","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-071-xiongyuan","book_id":"b-jinshu-071","work_id":"w-jinshu","source_id":"s-jinshu-071-xiongyuan-ws2595541"}],"sources":[{"chapter_id":"c-jinshu-071-xiongjin","work_id":"w-jinshu","book_id":"b-jinshu-071","source_id":"s-jinshu-071-xiongjin-ws2595541","source":{"title":"晉書卷七十一·熊縉、熊鳴鵠","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2595541","url":"https://zh.wikisource.org/w/index.php?oldid=2595541","revision_id":2595541,"edition":"維基文庫