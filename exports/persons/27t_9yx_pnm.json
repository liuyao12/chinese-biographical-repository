jinshu-071","chapter_id":"c-jinshu-071-xiongyuan","source_id":"s-jinshu-071-xiongyuan-ws2595541","paragraph_id":"c-jinshu-071-xiongyuan:p001","quote":"熊遠，字孝文，豫章南昌人也。祖翹，嘗為石崇蒼頭，而性廉直，有士風。黃門郎潘嶽見而稱異，勸崇免之，乃還鄉里。遠有志尚，縣召為功曹，不起，強與衣幘，扶之使謁。十餘日薦於郡，由是辟為文學掾。遠曰：「辭大不辭小也。」固請留縣。太守察遠孝廉。屬太守討氐羌，遠遂不行，送至隴右而還。後太守會稽夏靜辟為功曹。及靜去職，遠送至會稽以歸。州辟主簿、別駕，舉秀才，除監軍華軼司馬、領武昌太守、甯遠護軍。","subject_person_mention_id":"c-jinshu-071-xiongyuan:p001:m0000","object_person_mention_id":"c-jinshu-071-xiongyuan:p001:m0015"}],"status":"source_attested","interpretation_note":"祖翹與熊遠分敘。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin071-xiongyuan","person_id":"27t_9yx_pnm","event_type":"death","source_term":"數月病卒","source_anchor":{"paragraph_id":"c-jinshu-071-xiongyuan:p013","start":86,"end":90,"surface":"數月病卒"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-071","chapter_id":"c-jinshu-071-xiongyuan","source_id":"s-jinshu-071-xiongyuan-ws2595541","paragraph_id":"c-jinshu-071-xiongyuan:p013","quote":"累遷侍中，出補會稽內史。時王敦作逆，沈充舉兵應之，加遠將軍，距而不受，不輸軍資於充，保境安眾為務。敦至石頭，諷朝廷征遠，乃拜太常卿，加散騎常侍。敦深憚其正而有謀，引為長史。數月病卒。","person_mention_id":"c-jinshu-071-xiongyuan:p013:m0026"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-jinshu-071-xiongjin:p001:m0000","surface":"遠","start":0,"end":1,"person_id":"27t_9yx_pnm","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-071-xiongjin:p001","chapter_id":"c-jinshu-071-xiongjin"},{"id":"c-jinshu-071-xiongyuan:p001:m0000","surface":"熊遠","start":0,"end":2,"person_id":"27t_9yx_pnm","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-071-xiongyuan:p001","chapter_id":"c-jinshu-071-xiongyuan"},{"id":"c-jinshu-071-xiongyuan:p002:m0