n_id":"fp6_ia6_7yw","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p061","text":"孔子以爲能通孝道，故授之業。作孝經。死於魯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m061-0000","start":0,"end":2,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-112-pingjin:p015","text":"臣聞天下之患在於土崩，不在於瓦解，古今一也。何謂土崩？秦之末世是也。陳涉無千乘之尊，尺土之地，身非王公大人名族之后，無鄉曲之譽，非有孔、墨、曾子之賢，陶朱、猗頓之富也，然起窮巷，奮棘矜，偏袒大呼而天下從風，此其故何也？由民困而主不恤，下怨而上不知（也），俗已亂而政不修，此三者陳涉之所以為資也。是之謂土崩。故曰天下之患在於土崩。何謂瓦解？吳、楚、齊、趙之兵是也。七國謀為大逆，號皆稱萬乘之君，帶甲數十萬，威足以嚴其境內，財足以勸其士民，然不能西攘尺寸之地而身為禽於中原者，此其故何也？非權輕於匹夫而兵弱於陳涉也，當是之時，先帝之德澤未衰而安土樂俗之民眾，故諸侯無境外之助。此之謂瓦解，故曰天下之患不在瓦解。由是觀之，天下誠有土崩之勢，雖布衣窮處之士或首惡而危海內，陳涉是也。況三晉之君或存乎！天下雖未有大治也，誠能無土崩之勢，雖有彊國勁兵不得旋踵而身為禽矣，吳、楚、齊、趙是也。況群臣百姓能為亂乎哉！此二體者，安危之明要也，賢主所留意而深察也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m015-0034","start":34,"end":36,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0066","start":66,"end":67,"surface":"孔","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0068","start":68,"end":69,"surface":"墨","kind":"person","person_id":"tjx_q6x_kc7","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0070","start":70,"end":72,"surface":"曾子","kind":"person","person_id":"c7w_nyj_95u","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0075","start":75,"end":77,"surface":"陶朱","kind":"person","person_id":"yhm_h9f_8p0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m015-0078","start":78,"end":80,"surface":"猗頓","kind":"person","person_id":"kxz_6