endi:m002-0474","start":474,"end":476,"surface":"代王","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0481","start":481,"end":483,"surface":"薄昭","kind":"person","person_id":"0l7_ynh_g9v","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0485","start":485,"end":487,"surface":"絳侯","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0488","start":488,"end":490,"surface":"絳侯","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0493","start":493,"end":494,"surface":"昭","kind":"person","person_id":"0l7_ynh_g9v","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0502","start":502,"end":504,"surface":"薄昭","kind":"person","person_id":"0l7_ynh_g9v","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0518","start":518,"end":520,"surface":"代王","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0523","start":523,"end":525,"surface":"宋昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0536","start":536,"end":538,"surface":"宋昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0541","start":541,"end":543,"surface":"張武","kind":"person","person_id":"3sp_xmg_o87","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0560","start":560,"end":562,"surface":"宋昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional"}],"chapter_id":"c-shiji-010-wendi","book_id":"b-shiji-010","work_id":"w-shiji","source_id":"s-shiji-010-wendi"},{"id":"c-shiji-010-wendi:p003","text":"昌至渭橋，丞相以下皆迎。宋昌還報。代王馳至渭橋，群臣拜謁稱臣。代王下車拜。太尉勃進曰：「願請閒言。」宋昌曰：「所言公，公言之。所言私，王者不受私。」太尉乃跪上天子璽符。代王謝曰：「至代邸而議之。」遂馳入代邸。群臣從至。丞相陳平、太尉周勃、大將軍陳武、御史大夫張蒼、宗正劉郢、朱虛侯劉章、東牟侯劉興居、典客劉揭皆再拜言曰：「子弘等皆非孝惠帝子，不當奉宗廟。臣謹請（與）陰安侯列侯頃王后與瑯邪王、宗室、大臣、列侯、吏二千石議曰：『大王高帝長子，宜為高帝嗣。』願大王即天子位。」代王曰：「奉高帝宗廟，重事也。寡人不佞，不足以稱宗廟。願請楚王計宜者，寡人不敢當。」群臣皆伏固請。代王西鄉讓者三，南鄉讓者再。丞相平等皆曰：「臣伏計之，大王奉高帝宗廟最宜稱，雖天下諸侯萬民以為宜。臣等為宗廟社稷計，不敢忽。願大王幸聽臣等。臣謹奉天子璽符再拜上。」代王曰：「宗室將相王列侯以為莫宜寡人，寡人不敢辭。」遂即天子位。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m003-0012","start":12,"end":14,"surface":"宋昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0017","start":17,"end":19,"surface":"代王","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0031","start":31,"end":33,"surface":"代王","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0037","start":37,"end":40,"surface":"太尉勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0050","start":50,"end":52,"surface":"宋昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0074","start":74,"end":76,"surface":"太尉","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0084","start":84,"end":86,"surface":"代王","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0111","start":111,"end":113,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0114","start":114,"end":116,"surface":"太尉","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0116","start":116,"end":118,"surface":"周勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0122","start":122,"end":124,"surface":"陳武","kind":"person","person_id":"9lk_49t_e6e","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m003-0129","start":129,"end":131,"surface":"張蒼","kind":"person","