h_id":"c-shiji-010-wendi:p004","chapter_id":"c-shiji-010-wendi"},{"id":"c-shiji-010-wendi:m010-0130","start":130,"end":132,"surface":"宋昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p010","chapter_id":"c-shiji-010-wendi"},{"id":"c-shiji-010-wendi:m010-0145","start":145,"end":146,"surface":"昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p010","chapter_id":"c-shiji-010-wendi"},{"id":"c-shiji-010-wendi:m010-0153","start":153,"end":154,"surface":"昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional","paragraph_id":"c-shiji-010-wendi:p010","chapter_id":"c-shiji-010-wendi"},{"id":"c-songshu-063-wanghua-tanshou:line033:m0276","start":276,"end":278,"surface":"宋昌","kind":"person","person_id":"al3_w9j_0ng","status":"contextual_provisional","paragraph_id":"c-songshu-063-wanghua-tanshou:line033","chapter_id":"c-songshu-063-wanghua-tanshou"}],"relations":[],"title_holdings":[{"id":"th-shiji010-005","person_id":"al3_w9j_0ng","title":"中尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p002","quote":"丞相陳平、太尉周勃等使人迎代王。代王問左右郎中令張武等。張武等議曰：「漢大臣皆故高帝時大將，習兵，多謀詐，此其屬意非止此也，特畏高帝、呂太后威耳。今已誅諸呂，新啑血京師，此以迎大王為名，實不可信。願大王稱疾毋往，以觀其變。」中尉宋昌進曰：「群臣之議皆非也。夫秦失其政，諸侯豪桀并起，人人自以為得之者以萬數，然卒踐天子之位者，劉氏也，天下絕望，一矣。高帝封王子弟，地犬牙相制，此所謂盤石之宗也，天下服其彊，二矣。漢興，除秦苛政，約法令，施德惠，人人自安，難動搖，三矣。夫以呂太后之嚴，立諸呂為三王，擅權專制，然而太尉以一節入北軍，一呼士皆左袒，為劉氏，叛諸呂，卒以滅之。此乃天授，非人力也。今大臣雖欲為變，百姓弗為使，其黨寧能專一邪？方今內有朱虛、東牟之親，外畏吳、楚、淮南、瑯邪、齊、代之彊。方今高帝子獨淮南王與大王，大王又長，賢聖仁孝，聞於天下，故大臣因天下之心而欲迎立大王，大王勿疑也。」代王報太后計之，猶與未定。卜之龜，卦兆得大橫。占曰：「大橫庚庚，余為天王，夏啟以光。」代王曰：「寡人固已為王矣，又何王？」卜人曰：「所謂天王者乃天子。」於是代王乃遣太后弟薄昭往見絳侯，絳侯等具為昭言所以迎立王意。薄昭還報曰：「信矣，毋可疑者。」代王乃笑謂宋昌曰：「果如公言。」乃命宋昌參乘，張武等六人乘傳詣長安。至高陵休止，而使宋昌先馳之長安觀變。"}],"attestations":[{"id":"th-shiji010-005:a001","paragraph_id":"c-shiji-010-wendi:p002","start":112,"end":114,"surface":"中尉","person_mention_id":"c-shiji-010-wendi:m002-0114","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文明示官爵用稱；起點未知，死亡不自動當官爵終點。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"th-shiji010-011","person_id":"al3_w9j_0ng","title":"衛將軍","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p004","quote":"群臣以禮次侍。乃使太仆嬰與東牟侯興居清宮，奉天子法駕，迎于代邸。皇帝即日夕入未央宮。乃夜拜宋昌為衛將軍，鎮撫南北軍。以張武為郎中令，行殿中。還坐前殿。於是夜下詔書曰：「閒者諸呂用事擅權，謀為大逆，欲以危劉氏宗廟，賴將相列侯宗室大臣誅之，皆伏其辜。朕初即位，其赦天下，賜民爵一級，女子百戶牛酒，酺五日。」"}],"attestations":[{"id":"th-shiji010-011:a001","paragraph_id":"c-shiji-010-wendi:p004","start":48,"end":51,"surface":"衛將軍","person_mention_id":"c-shiji-010-wendi:m004-0045","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p004","quote":"群臣以禮次侍。乃使太仆嬰與東牟侯興居清宮，奉天子法駕，迎于代邸。皇帝即日夕入未央宮。乃夜拜宋昌為衛將軍，鎮撫南北軍。以張武為郎中令，行殿中。還坐前殿。於是夜下詔書曰：「閒者諸呂用事擅權，謀為大逆，欲以危劉氏宗廟，賴將相列侯宗室大臣誅之，皆伏其辜。朕初即位，其赦天下，賜民爵一級，女子百戶牛酒，酺五日。」"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"乃夜拜宋昌為衛將軍，保存任命時序；未補干支日。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"th-shiji010-021","person_id":"al3_w9j_0ng","title":"壯武侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p010","quote":"三月，有司請立皇后。薄太后曰：「諸侯皆同姓，立太子母為皇后。」皇后姓竇氏。上為立后故，賜天下鰥寡孤獨窮困及年八十已上孤兒九歲已下布帛米肉各有數。上從代來，初即位，施德惠天下，填撫諸侯四夷皆洽驩，乃循從代來功臣。上曰：「方大臣之誅諸呂迎朕，朕狐疑，皆止朕，唯中尉宋昌勸朕，朕以得保奉宗廟。已尊昌為衛將軍，其封昌為壯武侯。諸從朕六人，官皆至九卿。」"}],"attestations":[{"id":"th-shiji010-021:a001","paragraph_id":"c-shiji-010-wendi:p010","start":155,"end":158,"surface":"壯武侯","person_mention_id":"c-shiji-010-wendi:m010-0130","usage":"narrative","date_expression":"三月"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"三月","evidence":[{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p010","quote":"三月，有司請立皇后。薄太后曰：「諸侯皆同姓，立太子母為皇后。」皇后姓竇氏。上為立后故，賜天下鰥寡孤獨窮困及年八十已上孤兒九歲已下布帛米肉各有數。上從代來，初即位，施德惠天下，填撫諸侯四夷皆洽驩，乃循從代來功臣。上曰：「方大臣之誅諸呂迎朕，朕狐疑，皆止朕，唯中尉宋昌勸朕，朕以得保奉宗廟。已尊昌為衛將軍，其封昌為壯武侯。諸從朕六人，官皆至九卿。」"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文明示官爵用稱；起點未知，死亡不自動當官爵終點。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"address_assertions":[{"id":"pa-shiji010-003","person_id":"al3_w9j_0ng","relation":"migration_destination","place":{"source_name":"長安","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p002","quote":"丞相陳平、太尉周勃等使人迎代王。代王問左右郎中令張武等。張武等議曰：「漢大臣皆故高帝時大將，習兵，多謀詐，此其屬意非止此也，特畏高帝、呂太后威耳。今已誅諸呂，新啑血京師，此以迎大王為名，實不可信。願大王稱疾毋往，以觀其變。」中尉宋昌進曰：「群臣之議皆非也。夫秦失其政，諸侯豪桀并起，人人自以為得之者以萬數，然卒踐天子之位者，劉氏也，天下絕望，一矣。高帝封王子弟，地犬牙相制，此所謂盤石之宗也，天下服其彊，二矣。漢興，除秦苛政，約法令，施德惠，人人自安，難動搖，三矣。夫以呂太后之嚴，立諸呂為三王，擅權專制，然而太尉以一節入北軍，一呼士皆左袒，為劉氏，叛諸呂，卒以滅之。此乃天授，非人力也。今大臣雖欲為變，百姓弗為使，其黨寧能專一邪？方今內有朱虛、東牟之親，外畏吳、楚、淮南、瑯邪、齊、代之彊。方今高帝子獨淮南王與大王，大王又長，賢聖仁孝，聞於天下，故大臣因天下之心而欲迎立大王，大王勿疑也。」代王報太后計之，猶與未定。卜之龜，卦兆得大橫。占曰：「大橫庚庚，余為天王，夏啟以光。」代王曰：「寡人固已為王矣，又何王？」卜人曰：「所謂天王者乃天子。」於是代王乃遣太后弟薄昭往見絳侯，絳侯等具為昭言所以迎立王意。薄昭還報曰：「信矣，毋可疑者。」代王乃笑謂宋昌曰：「果如公言。」乃命宋昌參乘，張武等六人乘傳詣長安。至高陵休止，而使宋昌先馳之長安觀變。","person_mention_id":"c-shiji-010-wendi:m002-0114"}],"source_term":"先馳之長安觀變","interpretation_note":"宋昌先行馳之長安，續段渭橋活動另存；不補入宮。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji010-004","person_id":"al3_w9j_0ng","relation":"residence","place":{"source_name":"渭橋","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-010-wendi","source_id":"s-shiji-010-wendi","paragraph_id":"c-shiji-010-wendi:p003","quote":"昌至渭橋，丞相以下皆迎。宋昌還報。代王馳至渭橋，群臣拜謁稱臣。代王下車拜。太尉勃進曰：「願請閒言。」宋昌曰：「所言公，公言之。所言私，王者不受私。」太尉乃跪上天子璽符。代王謝曰：「至代邸而議之。」遂馳入代邸。群臣從至。丞相陳平、太尉周勃、大將軍陳武、御史大夫張蒼、宗正劉郢、朱虛侯劉章、東牟侯劉興居、典客劉揭皆再拜言曰：「子弘等皆非孝惠帝子，不當奉宗廟。臣謹請（與）陰安侯列侯頃王后與瑯邪王、宗室、大臣、列侯、吏二千石議曰：『大王高帝長子，宜為高帝嗣。』願大王即天子位。」代王曰：「奉高帝宗廟，重事也。寡人不佞，不足以稱宗廟。願請楚王計宜者，寡人不敢當。」群臣皆伏固請。代王西鄉讓者三，南鄉讓者再。丞相平等皆曰：「臣伏計之，大王奉高帝宗廟最宜稱，雖天下諸侯萬民以為宜。臣等為宗廟社稷計，不敢忽。願大王幸聽臣等。臣謹奉天子璽符再拜上。」代王曰：「宗室將相王列侯以為莫宜寡人，寡人不敢辭。」遂即天子位。","person_mention_id":"c-shiji-010-wendi:m003-0012"}],"source_term":"代王馳至渭橋","interpretation_note":"同段迎接與獻璽活動地；不是籍貫。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[{"id":"shiji-019-t3-r003-c02-m000","start":12,"end":14,"surface":"宋昌","person_id":"al3_w9j_0ng","status":"contextual_provisional","interpretation_note":"依本格國別、事件與本篇時間範圍核讀的完整名字暫定同指；非全域字串配對，省稱與世襲稱號另行核讀。","table_id":"shiji-019","table_fragment_id":"shiji-019-digital-table-3","table_row_id":"shiji-019-t3-r003","table_cell_id":"shiji-019-t3-r003-c02","work_id":"w-shiji","book_id":"b-shiji-019","chapter_id":"table-chapter-shiji-019","source_id":"table-witness-shiji-019","source_revision":"6359260","kind":"table_person_mention","quote":"二十三。元年亖月辛亥，侯宋昌元年。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji010-030","person_id":"al3_w9j_0ng","surfaces":["宋昌","昌"],"scope":"same_chapter","chapter_ids":["c-shiji-010-wendi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-010-wendi:p010","quote":"三月，有司請立皇后。薄太后曰：「諸侯皆同姓，立太子母為皇后。」皇后姓竇氏。上為立后故，賜天下鰥寡孤獨窮困及年八十已上孤兒九歲已下布帛米肉各有數。上從代來，初即位，施德惠天下，填撫諸侯四夷皆洽驩，乃循從代來功臣。上曰：「方大臣之誅諸呂迎朕，朕狐疑，皆止朕，唯中尉宋昌勸朕，朕以得保奉宗廟。已尊昌為衛將軍，其封昌為壯武侯。諸從朕六人，官皆至九卿。」"}],"rationale":"所列文帝朝分封、任官、軍事與接任敘事中暫定同指；跨卷依相接事件，短名不作全庫替換，同名候選及未名者仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-010-wendi:p002","text":"丞相陳平、太尉周勃等使人迎代王。代王問左右郎中令張武等。張武等議曰：「漢大臣皆故高帝時大將，習兵，多謀詐，此其屬意非止此也，特畏高帝、呂太后威耳。今已誅諸呂，新啑血京師，此以迎大王為名，實不可信。願大王稱疾毋往，以觀其變。」中尉宋昌進曰：「群臣之議皆非也。夫秦失其政，諸侯豪桀并起，人人自以為得之者以萬數，然卒踐天子之位者，劉氏也，天下絕望，一矣。高帝封王子弟，地犬牙相制，此所謂盤石之宗也，天下服其彊，二矣。漢興，除秦苛政，約法令，施德惠，人人自安，難動搖，三矣。夫以呂太后之嚴，立諸呂為三王，擅權專制，然而太尉以一節入北軍，一呼士皆左袒，為劉氏，叛諸呂，卒以滅之。此乃天授，非人力也。今大臣雖欲為變，百姓弗為使，其黨寧能專一邪？方今內有朱虛、東牟之親，外畏吳、楚、淮南、瑯邪、齊、代之彊。方今高帝子獨淮南王與大王，大王又長，賢聖仁孝，聞於天下，故大臣因天下之心而欲迎立大王，大王勿疑也。」代王報太后計之，猶與未定。卜之龜，卦兆得大橫。占曰：「大橫庚庚，余為天王，夏啟以光。」代王曰：「寡人固已為王矣，又何王？」卜人曰：「所謂天王者乃天子。」於是代王乃遣太后弟薄昭往見絳侯，絳侯等具為昭言所以迎立王意。薄昭還報曰：「信矣，毋可疑者。」代王乃笑謂宋昌曰：「果如公言。」乃命宋昌參乘，張武等六人乘傳詣長安。至高陵休止，而使宋昌先馳之長安觀變。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m002-0002","start":2,"end":4,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0005","start":5,"end":7,"surface":"太尉","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0007","start":7,"end":9,"surface":"周勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0013","start":13,"end":15,"surface":"代王","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0016","start":16,"end":18,"surface":"代王","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0024","start":24,"end":26,"surface":"張武","kind":"person","person_id":"3sp_xmg_o87","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0028","start":28,"end":30,"surface":"張武","kind":"person","person_id":"3sp_xmg_o87","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0040","start":40,"end":42,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0064","start":64,"end":66,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m002-0067","star