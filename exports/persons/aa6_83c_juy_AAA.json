],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu079-cross-002","person_id":"aa6_83c_juy_AAA","surfaces":["重","景重","卿","汝父"],"scope":"cross_chapter","chapter_ids":["c-jinshu-079-xielang-family","c-songshu-044-xiehui"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-079-xielang-family:p004:m0001","c-jinshu-079-xielang-family:p004:m0004","c-jinshu-079-xielang-family:p004:m0043","c-jinshu-079-xielang-family:p004:m0064","c-jinshu-079-xielang-family:p004:m0068","c-jinshu-079-xielang-family:p005:m0032","c-jinshu-079-xielang-family:p005:m0058","c-songshu-044-xiehui:p001:m0022"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-079","chapter_id":"c-jinshu-079-xielang-family","source_id":"s-jinshu-079-xielang-family","paragraph_id":"c-jinshu-079-xielang-family:p004","quote":"子重，字景重，明秀有才名，為會稽王道子驃騎長史。嘗因侍坐，于時月夜明淨，道子歎以為佳。重率爾曰：「意謂乃不如微雲點綴。」道子因戲重曰：「卿居心不淨，乃復強欲滓穢太清邪！」"},{"work_id":"w-jinshu","book_id":"b-jinshu-079","chapter_id":"c-jinshu-079-xielang-family","source_id":"s-jinshu-079-xielang-family","paragraph_id":"c-jinshu-079-xielang-family:p005","quote":"子絢，字宣映，曾於公坐戲調，無禮于其舅袁湛。湛甚不堪之，謂曰：「汝父昔已輕舅，汝今復來加我，可謂世無渭陽情也。」絢父重，即王胡之外孫，與舅亦有不協之論，湛故有此及雲。"},{"work_id":"w-songshu","book_id":"b-songshu-044","chapter_id":"c-songshu-044-xiehui","source_id":"s-songshu-044-xiehui","paragraph_id":"c-songshu-044-xiehui:p001","quote":"謝晦字宣明，陳郡陽夏人也。祖朗，東陽太守。父重，會稽王道子驃騎長史。兄絢，高祖鎮軍長史，蚤卒。"}],"rationale":"晉書子重字景重，會稽王道子驃騎長史，後段又明記絢父重；與宋書謝晦父重同一職官及家世相合。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-079-xielang-family:p003","text":"朗字長度。父據，早卒。朗善言玄理，文義豔發，名亞于玄。總角時，病新起，體甚贏，未堪勞，于叔父安前與沙門支遁朗論，遂至相苦。其母王氏再遣信令還，安欲留，使竟論，王氏因出云：「新婦少遭艱難，一生所寄惟在此兒。」遂流涕攜朗去。安謂坐客曰：「家嫂辭情慷慨，恨不使朝士見之。」朗終於東陽太守。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-079-xielan