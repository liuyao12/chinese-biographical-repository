4-yan:m002-0090","start":90,"end":92,"surface":"臣扈","kind":"person","person_id":"fqj_az4_0ep","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m002-0095","start":95,"end":97,"surface":"上帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m002-0098","start":98,"end":100,"surface":"巫咸","kind":"person","person_id":"1s9_u8o_ryn","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m002-0105","start":105,"end":107,"surface":"祖乙","kind":"person","person_id":"k2v_rm5_7gw","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m002-0112","start":112,"end":114,"surface":"巫賢","kind":"person","person_id":"1p0_3w7_7vc","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m002-0116","start":116,"end":118,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m002-0123","start":123,"end":125,"surface":"甘般","kind":"person","person_id":"egz_t7c_4jf","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m002-0140","start":140,"end":142,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-038-song:p059","text":"太史公曰：孔子稱「微子去之，箕子爲之奴，比干諫而死，殷有三仁焉」。春秋譏宋之亂自宣公廢太子而立弟，國以不寧者十世。襄公之時，修行仁義，欲爲盟主。其大夫正考父美之，故追道契、湯、髙宗，殷所以興，作商頌。襄公既敗於泓，而君子或以爲多，傷中國闕禮義，褒之也，宋襄之有禮讓也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m059-0000","start":0,"end":3,"surface":"太史公","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m059-0005","start":5,"end":7,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-038-song:m059-0009","start":9,"end":11,"surface":"微子","kind":"person","person_id":"buv_igi_gpn_A","stat