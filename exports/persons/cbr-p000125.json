ather","object_person_id":"cld_aan_e20","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p023","quote":"帝武丁崩，子帝祖庚立","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji033-006","person_id":"cld_aan_e20","title":"髙宗","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-033-lu","source_id":"s-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p009","quote":"其在髙宗，久勞于外"}],"attestations":[{"id":"th-shiji033-006:a001","paragraph_id":"c-shiji-033-lu:p009","start":99,"end":101,"surface":"髙宗","person_mention_id":"c-shiji-033-lu:m009-0099","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"封授與用稱分開；伯禽歬受封不推卒後新授，太保派遣時用稱不當任職起點，未知曆日與終點不按卒日補造。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji003-017","person_id":"cld_aan_e20","surfaces":["武丁","高宗"],"scope":"same_chapter","chapter_ids":["c-shiji-003-yin"],"status":"source_explicit","evidence":[{"paragraph_id":"c-shiji-003-yin:p023","quote":"祖己嘉武丁之以祥雉為德，立其廟為高宗"}],"rationale":"廟號與本人分層保存；本文人物用稱指武丁。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji033-003","person_id":"cld_aan_e20","surfaces":["髙宗"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p021","quote":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。"},{"paragraph_id":"c-shiji-033-lu:p009","quote":"周公歸，恐成王壯，治有所淫佚，乃作多士，作毋逸。毋逸稱：『爲人父母，爲業至長久，子孫驕奢忘之，以亡其家，爲人子可不慎乎！筆昔在殷王中宗，嚴恭敬畏天命，自度治民，震懼不敢荒寧，故中宗饗國七十五年。其在髙宗，久勞于外，爲與小人，作其即位，乃有亮闇，三年不言，言乃讙，不敢荒寧，密靖殷國，至于小大無怨，故髙宗饗國五十五年。其在祖甲，不義惟王，久爲小人于外，知小人之依，能保施小民，不侮寡，故祖甲饗國三十三年。』多士稱曰：『自湯至于帝乙，無不率祀明德，帝無不配天者。在今後嗣王紂，誕淫厥佚，不顧天及民之從也。其民皆可誅。』『文王日中昃不暇食，饗國五十年。』作此以誡成王。"}],"rationale":"按周初封建、武庚管蔡之亂、殷王廟號與魯君世系的具體語境暫定異稱。周公魯公與伯禽魯公依段落角色分開，王發不把普通動詞發當人名，世系與祈禱敘事仍待版本覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji034-013","person_id":"cld_aan_e20","surfaces":["武丁"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p021","quote":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。"},{"paragraph_id":"c-shiji-034-yan:p002","quote":"其在成王時，召王爲三公：自陜以西，召公主之；自陜以東，周公主之。成王旣幼，周公攝政，當國踐祚，召公疑之，作君奭。君奭不説周公。周公乃稱「湯時有伊尹，假于皇天；在太戊時，則有若伊陟、臣扈，假于上帝，巫咸治王家；在祖乙時，則有若巫賢；在武丁時，則有若甘般：率維茲有陳，保乂有殷」。於是召公乃説。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji038-006","person_id":"cld_aan_e20","surfaces":["髙宗"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p021","quote":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。"},{"paragraph_id":"c-shiji-038-song:p059","quote":"太史公曰：孔子稱「微子去之，箕子爲之奴，比干諫而死，殷有三仁焉」。春秋譏宋之亂自宣公廢太子而立弟，國以不寧者十世。襄公之時，修行仁義，欲爲盟主。其大夫正考父美之，故追道契、湯、髙宗，殷所以興，作商頌。襄公既敗於泓，而君子或以爲多，傷中國闕禮義，褒之也，宋襄之有禮讓也。"}],"rationale":"殷篇武丁廟為高宗的明示諡廟記載，與本篇論贊追道契湯髙宗的殷祖先語境暫接，保留髙字，不將其他朝代高宗匹配。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p021","text":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。","mentions":[{"id":"c-shiji-003-yin:m021-0000","start":0,"end":3,"surface":"帝小乙","kind":"person","person_id":"blo_hqh_iqg","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0006","start":6,"end":9,"surface":"帝武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0011","start":11,"end":14,"surface":"帝武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0038","start":38,"end":40,"surface":"冢宰","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m021-0046","start":46,"end":48,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0056","start":56,"end":57,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0084","start":84,"end":85,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0092","start":92,"end":93,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0104","start":104,"end":106,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0107","start":107,"end":109,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0143","start":143,"end":145,"surface":"傅說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p022","text":"帝武丁祭成湯，明日，有飛雉登鼎耳而呴，武丁懼。祖己曰：「王勿憂，先修政事。」祖己乃訓王曰：「唯天監下典厥義，降年有永有不永，非天夭民，中絕其命。民有不若德，不聽罪，天既附命正厥德，乃曰其柰何。鳴呼！王嗣敬民，罔非天繼，常祀毋禮于棄道。」武丁修政行德，天下咸驩，殷道復興。","mentions":[{"id":"c-shiji-003-yin:m022-0000","start":0,"end":3,"surface":"帝武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m022-0004","start":4,"end":6,"surface":"成湯","kind":"person","person_id":"tpz_x3m_e0h","status":"source_identified"},{"id":"c-shiji-003-yin:m022-0019","start":19,"end":21,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m022-0023","start":23,"end":25,"surface":"祖己","kind":"person","person_id":"80h_7uw_251","status":"source_identified"},{"id":"c-shiji-003-yin:m022-0028","start":28,"end":29,"surface":"王","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional","interpretation_note":"只依本段對話的君主與事件暫定，不作全篇通用的帝／王匹配。"},{"id":"c-shiji-003-yin:m022-0038","start":38,"end":40,"surface":"祖己","kind":"person","person_id":"80h_7uw_251","status":"source_identified"},{"id":"c-shiji-003-yin:m022-0042","start":42,"end":43,"surface":"王","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional","interpretation_note":"只依本段對話的君主與事件暫定，不作全篇通用的帝／王匹配。"},{"id":"c-shiji-003-yin:m022-0099","start":99,"end":100,"surface":"王","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional","interpretation_note":"只依本段對話的君主與事件暫定，不作全篇通用的帝／王匹配。"},{"id":"c-shiji-003-yin:m022-0118","start":118,"end":120,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p023","text":"帝武丁崩，子帝祖庚立。祖己嘉武丁之以祥雉為德，立其廟為高宗，遂作高宗肜日及訓。","mentions":[{"id":"c-shiji-003-yin:m023-0000","start":0,"end":3,"surface":"帝武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m023-0006","start":6,"end":9,"surface":"帝祖庚","kind":"person","person_id":"f41_iwq_mkl","status":"source_identified"},{"id":"c-shiji-003-yin:m023-0011","start":11,"end":13,"surface":"祖己","kind":"person","person_id":"80h_7uw_251","status":"source_identified"},{"id":"c-shiji-003-yin:m023-0014","start":14,"end":16,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m023-0027","start":27,"end":29,"surface":"高宗","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional","interpretation_note":"依祖己為武丁立廟的敘事暫定此稱指武丁；書篇名稱高宗肜日另不作人物。"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-033-lu:p009","text":"周公歸，恐成王壯，治有所淫佚，乃作多士，作毋逸。毋逸稱：『爲人父母，爲業至長久，子孫驕奢忘之，以亡其家，爲人子可不慎乎！筆昔在殷王中宗，嚴恭敬畏天命，自度治民，震懼不敢荒寧，故中宗饗國七十五年。其在髙宗，久勞于外，爲與小人，作其即位，乃有亮闇，三年不言，言乃讙，不敢荒寧，密靖殷國，至于小大無怨，故髙宗饗國五十五年。其在祖甲，不義惟王，久爲小人于外，知小人之依，能保施小民，不侮寡，故祖甲饗國三十三年。』多士稱曰：『自湯至于帝乙，無不率祀明德，帝無不配天者。在今後嗣王紂，誕淫厥佚，不顧天及民之從也。其民皆可誅。』『文王日中昃不暇食，饗國五十年。』作此以誡成王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m009-0000","start":0,"end":2,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0005","start":5,"end":7,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0031","start":31,"end":33,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未定稱謂，少昊傳說稱呼未另核；不補姓名與成員。"},{"id":"c-shiji-033-lu:m009-0040","start":40,"end":42,"surface":"子孫","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未定稱謂，少昊傳說稱呼未另核；不補姓名與成員。"},{"id":"c-shiji-033-lu:m009-0063","start":63,"end":67,"surface":"殷王中宗","kind":"person","person_id":"ta6_n0m_glj","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0088","start":88,"end":90,"surface":"中宗","kind":"person","person_id":"ta6_n0m_glj","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0099","start":99,"end":101,"surface":"髙宗","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0149","start":149,"end":151,"surface":"髙宗","kind":"person","person_id":"cld_aan_e20","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0160","start":160,"end":162,"surface":"祖甲","kind":"person","person_id":"kfj_bhr_cdz","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0192","start":192,"end":194,"surface":"祖甲","kind":"person","person_id":"kfj_bhr_cdz","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0209","start":209,"end":210,"surface":"湯","kind":"person","person_id":"tpz_x3m_e0h","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0212","start":212,"end":214,"surface":"帝乙","kind":"person","person_id":"buv_igi_gpn","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0222","start":222,"end":223,"surface":"帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未定稱謂，少昊傳說稱呼未另核；不補姓名與成員。"},{"id":"c-shiji-033-lu:m009-0234","start":234,"end":235,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0258","start":258,"end":260,"surface":"文王","kind":"person","person_id":"y4i_pjk_4gn_A","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m009-0278","start":278,"end":280,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-034-yan:p002","text":"其在成王時，召王爲三公：自陜以西，召公主之；自陜以東，周公主之。成王旣幼，周公攝政，當國踐祚，召公疑之，作君奭。君奭不説周公。周公乃稱「湯時有伊尹，假于皇天；在太戊時，則有若伊陟、臣扈，假于上帝，巫咸治王家；在祖乙時，則有若巫賢；在武丁時，則有若甘般：率維茲有陳，保乂有殷」。於是召公乃説。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m002-0002","start":2,"end":4,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m002-0006","start":6,"end":8,"surface":"召王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m002-0017","start":17,"end":19,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"