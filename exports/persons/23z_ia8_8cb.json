],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu054-lvmeng4","person_id":"23z_ia8_8cb","event_type":"death","source_term":"三將死","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-054","chapter_id":"c-sanguozhi-054-lvmeng","source_id":"s-sanguozhi-054-lvmeng","paragraph_id":"c-sanguozhi-054-lvmeng:line064","quote":"　　魯肅代周瑜，當之陸口，過蒙屯下。肅意尚輕蒙，或說肅曰：「呂將軍功名日顯，不可以故意待也，君宜顧之。」遂往詣蒙。酒酣，蒙問肅曰：「君受重任，與關羽為鄰，將何計畧以備不虞？」肅造次應曰：「臨時施宜。」蒙曰：「今東西雖為一家，而關羽實熊虎也，計安可不豫定？」因為肅畫五策。肅於是越席就之，拊其背曰：「呂子明，吾不知卿才畧所及乃至於此也。」遂拜蒙母，結友而別。時蒙與成當、宋定、徐顧屯次比近，三將死，子弟幼弱，權悉以兵並蒙。蒙固辭，陳啟顧等皆勤勞國事，子弟雖小，不可廢也。書三上，權乃聽。蒙於是又為擇師，使輔導之，其操心率如此。","person_mention_id":"c-sanguozhi-054-lvmeng:line064:m0187"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-054-lvmeng:line064:m0187","start":187,"end":189,"surface":"徐顧","kind":"person","person_id":"23z_ia8_8cb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line064","chapter_id":"c-sanguozhi-054-lvmeng"},{"id":"c-sanguozhi-054-lvmeng:line064:m0216","surface":"顧","start":216,"end":217,"kind":"person","person_id":"23z_ia8_8cb","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。","paragraph_id":"c-sanguozhi-054-lvmeng:line064","chapter_id":"c-sanguozhi-054-lvmeng"}],"relations":[],"t