[{"id":"c-shiji-112-pingjin:m030-0237","start":237,"end":239,"surface":"嚴助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p030","chapter_id":"c-shiji-112-pingjin"},{"id":"c-shiji-113-nanyue:m005-0003","start":3,"end":5,"surface":"莊助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p005","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m005-0046","start":46,"end":47,"surface":"助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p005","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-113-nanyue:m005-0071","start":71,"end":72,"surface":"助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p005","chapter_id":"c-shiji-113-nanyue"},{"id":"c-shiji-122-kuli:m017-0356","start":356,"end":358,"surface":"嚴助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p017","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m017-0380","start":380,"end":381,"surface":"助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p017","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m023-0016","start":16,"end":18,"surface":"莊助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m023-0030","start":30,"end":31,"surface":"助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m023-0075","start":75,"end":77,"surface":"莊助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[{"id":"eq-shiji112-panegyric-yanzhu","person_ids":["71j_ydc_ly7"],"canonical_person_id":"71j_ydc_ly7","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-112-pingjin","c-shiji-122-kuli"],"evidence":[{"chapter_id":"c-shiji-112-pingjin","source_id":"s-shiji112-pingjin","paragraph_id":"c-shiji-112-pingjin:p030","quote":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","mention_ids":["c-shiji-112-pingjin:m030-0237"],"text_layer":"witness_appended_bangu_note"},{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p017","quote":"是時上方鄕文學，湯決大獄，欲傅古義，乃請博士弟子治尚書、春秋補廷尉史，亭疑法。奏讞疑事，必豫先爲上分別其原，上所是，受而著讞決法廷尉絜令，揚主之明。奏事卽譴，湯應謝，鄕上意所便，必引正、監、掾史賢者，曰：「固爲臣議，如上責臣，臣弗用，愚抵於此。」罪常釋。（聞）［閒］卽奏事，上善之，曰：「臣非知爲此奏，乃正、監、掾史某爲之。」其欲薦吏，揚人之善蔽人之過如此。所治卽上意所欲罪，予監史深禍者；卽上意所欲釋，與監史輕平者。所治卽豪，必舞文巧詆；卽下戸羸弱，時口言，雖文致法，上財察。於是往往釋湯所言。湯至於大吏，内行修也。通賓客飲食。於故人子弟爲吏及貧昆弟，調護之尤厚。其造請諸公，不避寒暑。是以湯雖文深意忌不專平，然得此聲譽。而刻深吏多爲爪牙用者，依於文學之士。丞相弘數稱其美。及治淮南、衡山、江都反獄，皆窮根本。嚴助及伍被，上欲釋之。湯爭曰：「伍被本畫反謀，而助親幸出入禁闥爪牙臣，乃交私諸侯如此，弗誅，後不可治。」於是上可論之。其治獄所排大臣自爲功，多此類。於是湯益尊任，遷爲御史大夫。","mention_ids":["c-shiji-122-kuli:m017-0356","c-shiji-122-kuli:m017-0380"],"text_layer":"received_chapter"}],"rationale":"應對嚴助與武帝時親幸出入禁闥、淮南交私案嚴助同一廷臣；不混嚴安或嚴彭祖。 正文、附錄及附贊的來源層各存，不把引用時間當人物存世、生卒或授官時間。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji113-core-zhuangzhu","person_ids":["71j_ydc_ly7"],"canonical_person_id":"71j_ydc_ly7","scope":"cross_chapter","chapter_ids":["c-shiji-113-nanyue","c-shiji-122-kuli"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p005","quote":"天子使莊助往諭意南越王，胡頓首曰：「天子乃為臣興兵討閩越，死無以報德！」遣太子嬰齊入宿衛。謂助曰：「國新被寇，使者行矣。胡方日夜裝入見天子。」助去後，其大臣諫胡曰：「漢興兵誅郢，亦行以驚動南越。且先王昔言，事天子期無失禮，要之不可以說好語入見。入見則不得復歸，亡國之勢也。」於是胡稱病，竟不入見。後十餘歲，胡實病甚，太子嬰齊請歸。胡薨，謚為文王。","mention_ids":["c-shiji-113-nanyue:m005-0003","c-shiji-113-nanyue:m005-0046","c-shiji-113-nanyue:m005-0071"],"text_layer":"received_chapter"},{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p017","quote":"是時上方鄕文學，湯決大獄，欲傅古義，乃請博士弟子治尚書、春秋補廷尉史，亭疑法。奏讞疑事，必豫先爲上分別其原，上所是，受而著讞決法廷尉絜令，揚主之明。奏事卽譴，湯應謝，鄕上意所便，必引正、監、掾史賢者，曰：「固爲臣議，如上責臣，臣弗用，愚抵於此。」罪常釋。（聞）［閒］卽奏事，上善之，曰：「臣非知爲此奏，乃正、監、掾史某爲之。」其欲薦吏，揚人之善蔽人之過如此。所治卽上意所欲罪，予監史深禍者；卽上意所欲釋，與監史輕平者。所治卽豪，必舞文巧詆；卽下戸羸弱，時口言，雖文致法，上財察。於是往往釋湯所言。湯至於大吏，内行修也。通賓客飲食。於故人子弟爲吏及貧昆弟，調護之尤厚。其造請諸公，不避寒暑。是以湯雖文深意忌不專平，然得此聲譽。而刻深吏多爲爪牙用者，依於文學之士。丞相弘數稱其美。及治淮南、衡山、江都反獄，皆窮根本。嚴助及伍被，上欲釋之。湯爭曰：「伍被本畫反謀，而助親幸出入禁闥爪牙臣，乃交私諸侯如此，弗誅，後不可治。」於是上可論之。其治獄所排大臣自爲功，多此類。於是湯益尊任，遷爲御史大夫。","mention_ids":["c-shiji-122-kuli:m017-0356","c-shiji-122-kuli:m017-0380"],"text_layer":"received_chapter"}],"rationale":"莊助使南越王胡，漢書95同一諭意事件明作嚴助，據此接既有嚴助；莊嚴分源記，不說成生前改名，不混莊參或莊蹻。 依具體時序、角色或事件暫定同指；不據此補生卒、任期、父子或改寫原字。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"references":[{"title":"《前漢書》卷95嚴助使南粤（文淵閣數位轉錄）","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_095.txt#L266-L267","quote":"天子使嚴助徃諭意南粤王胡頓首曰天子廼興兵誅閩粤死亡以報德遣太子嬰齊入宿衞謂","raw_quote":"降於是罷兵天子使嚴助徃諭意南粤王胡頓首曰天¶\n子廼興兵誅閩粤死亡以報德遣太子嬰齊入宿衞謂¶","scope":"received_same_mission_name_variant","image_verified":false,"source_blob_sha":"b41576d7d677e481940c3a7f222a09837c85e8f7","response_sha256":"ae85076fbcb902242dad85fc3d8b11751e408d228b939c73e8f4c3ee4a879793","response_extent":{"first_line":151,"last_line":300,"partial_file":true}}],"identity_materialized":true}],"passages":[{"id":"c-shiji-112-pingjin:p030","text":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","annotation_status":"in_progress","text_layer":"witness_appended_bangu_note","mentions":[{"id":"c-shiji-112-pingjin:m030-0000","start":0,"end":2,"surface":"班固","kind":"person","person_id":"gxd_15x_9d0","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0005","start":5,"end":8,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0009","start":9,"end":11,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0012","start":12,"end":14,"surface":"兒寬","kind":"person","person_id":"x8r_9sk_d7a","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0074","start":74,"end":75,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0092","start":92,"end":94,"surface":"枚生","kind":"person","person_id":"e1m_xt0_8w7","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0096","start":96,"end":98,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0112","start":112,"end":114,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0119","start":119,"end":121,"surface":"弘羊","kind":"person","person_id":"fi2_2cl_w22","status":"contextual_provisional"},