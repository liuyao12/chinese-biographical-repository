d_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m017-0356","start":356,"end":358,"surface":"嚴助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p017","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m017-0380","start":380,"end":381,"surface":"助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p017","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m023-0016","start":16,"end":18,"surface":"莊助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m023-0030","start":30,"end":31,"surface":"助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m023-0075","start":75,"end":77,"surface":"莊助","kind":"person","person_id":"71j_ydc_ly7","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p023","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p017","text":"是時上方鄕文學，湯決大獄，欲傅古義，乃請博士弟子治尚書、春秋補廷尉史，亭疑法。奏讞疑事，必豫先爲上分別其原，上所是，受而著讞決法廷尉絜令，揚主之明。奏事卽譴，湯應謝，鄕上意所便，必引正、監、掾史賢者，曰：「固爲臣議，如上責臣，臣弗用，愚抵於此。」罪常釋。（聞）［閒］卽奏事，上善之，曰：「臣非知爲此奏，乃正、監、掾史某爲之。」其欲薦吏，揚人之善蔽人之過如此。所治卽上意所欲罪，予監史深禍者；卽上意所欲釋，與監史輕平者。所治卽豪，必舞文巧詆；卽下戸羸弱，時口言，雖文致法，上財察。於是往往釋湯所言。湯至於大吏，内行修也。通賓客飲食。於故人子弟爲吏及貧昆弟，調護之尤厚。其造請諸公，不避寒暑。是以湯雖文深意忌不專平，然得此聲譽。而刻深吏多爲爪牙用者，依於文學之士。丞相弘數稱其美。及治淮南、衡山、江都反獄，皆窮根本。嚴助及伍被，上欲釋之。湯爭曰：「伍被本畫反謀，而助親幸出入禁闥爪牙臣，乃交私諸侯如此，弗誅，後不可治。」於是上可論之。其治獄所排大臣自爲功，多此類。於是湯益尊任，遷爲御史大夫。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m017-0002","start":2,"end":3,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0008","start":8,"end":9,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0020","start":20,"end":24,"surface":"博士弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m017-0048","start":48,"end":49,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0054","start":54,"end":55,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0079","start":79,"end":80,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0084","start":84,"end":85,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0109","start":109,"end":110,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0137","start":137,"end":138,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0152","start":152,"end":159,"surface":"正、監、掾史某","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m017-0182","start":182,"end":183,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0196","start":196,"end":197,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m017-0235","start":235,"end":236,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-ku