52","surface":"籥","start":152,"end":153,"person_id":"0ap_x9j_vf8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simaxia:p001:m0154","surface":"銓","start":154,"end":155,"person_id":"e9x_60x_9m9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simaxia:p001:m0156","surface":"端","start":156,"end":157,"person_id":"7xu_sss_agn","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-064-simaxia","book_id":"b-jinshu-064","work_id":"w-jinshu","source_id":"s-jinshu-064-simaxia-ws2622004"},{"id":"c-jinshu-064-simazhi:p001","text":"東海沖王祗，字敬度，泰始九年五月受封。殤王薨，復以祗繼兆，其年薨，時年三歲。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":25,"last_line":25,"raw_start":1138,"raw_end":1191,"raw_character_offsets":[1143,1144,1145,1146,1147,1151,1152,1153,1154,1155,1161,1162,1163,1164,1167,1168,1169,1170,1171,1172,1173,1174,1175,1176,1177,1178,1179,1180,1181,1182,1183,1184,1185,1186,1187,1188,1189,1190],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-simazhi:p001:m0000","surface":"東海沖王祗","start":0,"end":5,"person_id":"xvn_8o9_kzw","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simazhi:p001:m0019","surface":"殤王","start":19,"end":21,"person_id":"b8p_82e_1d1","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simazhi:p001:m0027","surface":"兆","start":27,"end":28,"person_id":"12z_a2y_dwt","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-064-simazhi","book_id":"b-jinshu-064","work_id":"w-jinshu","source_id":"s-jinshu-064-simazhi-ws2622004"}],"sources":[{"chapter_id":"c-jinshu-064-simajing","work_id":"w-jinshu","book_id":"b-jinshu-064","source_id":"s-jinshu-064-simajing-ws2622004","source":{"title":"晉書卷六十四·司馬景","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2622004","url":"https://zh.wikisource.org/w/index.php?oldid=2622004","revision_id":2622004,"edition":"維基文庫固定修訂","accessed_on":"2026