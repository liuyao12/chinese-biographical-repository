aragraph_id":"c-jinshu-064-simajing:p001","chapter_id":"c-jinshu-064-simajing"},{"id":"c-jinshu-064-simaxia:p001:m0031","surface":"城陽哀王兆","start":31,"end":36,"person_id":"12z_a2y_dwt","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simaxia:p001","chapter_id":"c-jinshu-064-simaxia"},{"id":"c-jinshu-064-simazhi:p001:m0027","surface":"兆","start":27,"end":28,"person_id":"12z_a2y_dwt","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-064-simazhi:p001","chapter_id":"c-jinshu-064-simazhi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-064-simajing:p001","text":"城陽懷王景，字景度，出繼叔父城陽哀王兆後。泰始五年受封，六年薨。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":23,"last_line":23,"raw_start":1071,"raw_end":1136,"raw_character_offsets":[1076,1077,1078,1079,1080,1084,1085,1086,1087,1088,1089,1090,1091,1092,1109,1110,1111,1112,1113,1116,1117,1123,1124,1125,1126,1129,1130,1131,1132,1133,1134,1135],"revision_id":2622004},"mentions":[{"id":"c-jinshu-064-simajing:p001:m0000","surface":"城陽懷王景","start":0,"end":5,"person_id":"1ik_vcj_7h6","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-064-simajing:p001:m0014","surface":"城陽哀王兆","start":14,"end":19,"person_id":"12z_a2y_dwt","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-064-simajing","book_id":"b-jinshu-064","work_id":"w-jinshu","source_id":"s-jinshu-064-simajing-ws2622004"},{"id":"c-jinshu-064-simaxia:p001","text":"清河康王遐，字深度，美容儀，有精彩，武帝愛之。既受封，出繼叔父城陽哀王兆。太康十年，封渤海郡，曆右將軍、散騎常侍、前將軍。元康初，進撫軍將軍，加侍中，遐長而懦弱，無所是非。性好內，不能接士大夫。及楚王瑋之舉兵也，使遐收衛瓘，而瓘故吏榮晦遂盡殺瓘子孫，遐不能禁，為世所尤。永康元年薨，時年二十八。四子：覃、籥、銓、端。覃嗣立。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":23