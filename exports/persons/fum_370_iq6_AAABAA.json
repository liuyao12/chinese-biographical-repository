chun:p025:m0001"}],"source_assertion_id":"a-ws058-chun-xiaoyong-father-yu","interpretation_note":"按本源明文或完整相鄰子附敘配局部父子；不把兄弟都補父、不接未名世代。","reviewer":"Codex（AI代理）"}}],"source_mention_summary":[{"source_id":"s-weishu-weishou-058-yangchun-ws2087998","work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","chapter_id":"c-weishu-weishou-058-yangchun","raw_mention_count":1,"mention_ids":["c-weishu-weishou-058-yangchun:p025:m0001"],"paragraph_ids":["c-weishu-weishou-058-yangchun:p025"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-weishu-weishou-058-yangchun:p025:m0001","mention_ids":["c-weishu-weishou-058-yangchun:p025:m0001"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-weishu-weishou-058-yangchun-ws2087998"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-ws058-chun-xiaoyong-father-yu","subject_person_id":"fum_370_iq6_AAABAA","predicate":"father","object_person_id":"fum_370_iq6_AAABA","status":"source_attested","qualifiers":{"source_term":"子孝邕"},"evidence":[{"work_id":"w-weishu-weishou","book_id":"b-weishu-weishou-058","source_id":"s-weishu-weishou-058-yangchun-ws2087998","chapter_id":"c-weishu-weishou-058-yangchun","paragraph_id":"c-weishu-weishou-058-yangchun:p024","quote":"孝莊還宮，還復前官。及父椿辭老，請解官從養，詔不許。尒朱榮之死也，昱為東道行臺，率眾拒尒朱仲遠。會尒朱兆入洛，昱還京師。後歸鄉里，亦為天光所害。太昌初，贈都督瀛定二州諸軍事、驃騎大將軍、司空公、定州刺史。","o