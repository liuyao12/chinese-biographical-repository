eived_chapter","mentions":[{"id":"c-shiji-109-liguang:m004-0004","start":4,"end":6,"surface":"孝景","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0008","start":8,"end":10,"surface":"武帝","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0016","start":16,"end":17,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0023","start":23,"end":24,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0036","start":36,"end":39,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0046","start":46,"end":49,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0051","start":51,"end":53,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0068","start":68,"end":69,"surface":"廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0118","start":118,"end":121,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0154","start":154,"end":156,"surface":"不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0159","start":159,"end":161,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0211","start":211,"end":213,"surface":"李廣","kind":"person","person_id":"27j_f4p_jwp","status":"contextual_provisional"},{"id":"c-shiji-109-liguang:m004-0214","start":214,"end":217,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional"},{"id":