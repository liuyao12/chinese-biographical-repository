-shiji-109-liguang:p004","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m004-0214","start":214,"end":217,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p004","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m004-0241","start":241,"end":244,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p004","chapter_id":"c-shiji-109-liguang"},{"id":"c-shiji-109-liguang:m004-0245","start":245,"end":248,"surface":"程不識","kind":"person","person_id":"y6f_9v5_dqg","status":"contextual_provisional","paragraph_id":"c-shiji-109-liguang:p004","chapter_id":"c-shiji-109-liguang"}],"relations":[],"title_holdings":[{"id":"th-shiji107-027","person_id":"y6f_9v5_dqg","title":"衛尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p020","quote_passage_ref":"data/corpus/shiji/107.json"}],"attestations":[{"id":"th-shiji107-027:a001","paragraph_id":"c-shiji-107-weiqi:p020","start":243,"end":245,"surface":"衛尉","person_mention_id":"c-shiji-107-weiqi:m020-0176","usage":"narrative","date_expression":"夏","normalized_date":{"era":"BCE","era_year":131,"year":-130,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"夏，丞相取燕王女為夫人，有太后詔，召列侯宗室皆往賀。魏其侯過灌夫，欲與俱。夫謝曰：「夫數以酒失得過丞相，丞相今者又與夫有郤。」魏其曰：「事已解。」彊與俱。飲酒酣，武安起為壽，坐皆避席伏。已魏其侯為壽，獨故人避席耳，餘半膝席。灌夫不悅。起行酒，至武安，武安膝席曰：「不能滿觴。」夫怒，因嘻笑曰：「將軍貴人也，屬之！」時武安不肯。行酒次至臨汝侯，臨汝侯方與程不識耳語，又不避席。夫無所發怒，乃罵臨汝侯曰：「生平毀程不識不直一錢，今日長者為壽，乃效女兒呫囁耳語！」武安謂灌夫曰：「程李俱東西宮衛尉，今眾辱程將軍，仲孺獨不為李將軍地乎？」灌夫曰：「今日斬頭陷匈，何知程李乎！」坐乃起更衣，稍稍去。魏其侯去，麾灌夫出。武安遂怒曰：「此吾驕灌夫罪。」乃令騎留灌夫。灌夫欲出不得。籍福起為謝，案灌夫項令謝。夫愈怒，不肯謝。武安乃麾騎縛夫置傳舍，召長史曰：「今日召宗室，有詔。」劾灌夫罵坐不敬，系居室。遂按其前事，遣吏分曹逐捕諸灌氏支屬，皆得棄市罪。魏其侯大媿，為資使賓客請，莫能解。武安吏皆為耳目，諸灌氏皆亡匿，夫系，遂不得告言武安陰事。","evidence":[{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p019","quote_passage_ref":"data/corpus/shiji/107.json"},{"chapter_id":"c-shiji-107-weiqi","source_id":"s-shiji-107-weiqi","paragraph_id":"c-shiji-107-weiqi:p020","quote_passage_ref":"data/corpus/shiji/107.json"}],"references":[{"title":"漢初月朔考索──以出土簡牘為線索","author":"許名瑲","publication":"北市大語文學報","issue":12,"published_on":"2014-12","url":"https://literacy.utaipei.edu.tw/var/file/65/1065/img/1007/256705145.pdf","page":"122","scope":"regnal_year_equivalence_only","image_verified":false}],"rationale":"第122頁元光元年前134年，元光四年暫換前131年。本段承第19段元光四年春的事件敘述，僅暫記用稱年，不推授任日或公曆月日。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"只記本段用稱，不推授任起訖。程、李俱為衛尉，正文不足以分配各自東宮或西宮。廷辯年份承前文敘事，保留暫定性。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji109-025","person_id":"y6f_9v5_dqg","title":"長樂衞尉","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-109-liguang","source_id":"s-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p004","quote_passage_ref":"data/corpus/shiji/109.json"}],"attestations":[{"id":"th-shiji109-025:a001","paragraph_id":"c-shiji-109-liguang:p004","start":41,"end":45,"surface":"長樂衞尉","person_mention_id":"c-shiji-109-liguang:m004-0036","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-109-liguang","source_id":"s-shiji-109-liguang","paragraph_id":"c-shiji-109-liguang:p004","quote_passage_ref":"data/corpus/shiji/109.json"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本段明示任官或用稱；名將為敘事稱，邊太守將軍與皆為名將的共享字各記二人，不推精確官階或連續任期。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji109-027","person_id":"y6f_9v5_dqg","title":"邊太守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shi