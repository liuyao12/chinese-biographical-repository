distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-guyong-complete","source_id":"s-sanguozhi-052-guyong-complete","paragraph_id":"c-sanguozhi-052-guyong-complete:line044","quote":"雍爲相十九年，年七十六，赤烏六年卒。初疾微時，權令醫趙泉視之。拜其少子濟爲騎都尉。雍聞，悲曰：「泉善別生死，吾必不起，故上欲及吾目見濟拜也。」權素服臨吊，謚曰肅侯。長子邵早卒，次子裕有篤疾，少子濟嗣，無後，絶。永安元年，詔曰：「故丞相雍，至德忠賢，輔國以禮，而侯統廢絶。朕甚愍之。其以雍次子裕襲爵爲醴陵候，以明著舊勳。」","source_term":"長子邵"}],"source_assertion_id":"a-wu052-gu-shao","interpretation_note":"本來源明記世代。後綴只供識別。","reviewer":"Codex（AI 代理）","parent_person_id":"syc_ik6_bq5_**A"}}],"source_mention_summary":[{"source_id":"s-sanguozhi-052-gushao-complete","work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","raw_mention_count":1,"mention_ids":["c-sanguozhi-052-gushao-complete:line048:m0079"],"paragraph_ids":["c-sanguozhi-052-gushao-complete:line048"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-052-gushao-complete:line048:m0079","mention_ids":["c-sanguozhi-052-gushao-complete:line048:m0079"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-052-gushao-complete"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu052-gs-cedaughter","subject_person_id":"e9c_070_567_A","object_person_id":"e