,"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin034-jiangyi-ancient-literal","person_id":"jco_uwm_8n3","surname":"江","ming":"乙","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-034-yanghu-comparison","paragraph_id":"c-jinshu-034-yanghu-comparison:p041","person_mention_id":"c-jinshu-034-yanghu-comparison:p041:m0164","source_anchor":{"start":164,"end":166,"surface":"江乙"},"quote":"發長子倫，高陽相。倫弟暨，陽平太守。暨弟伊，初為車騎賈充掾，後曆平南將軍、都督江北諸軍事，鎮宛，為張昌所殺，追贈鎮南將軍。祜伯父秘，官至京兆太守。子祉，魏郡太守。秘孫亮，字長玄，有才能，多計數。與之交者，必偽盡款誠，人皆謂得其心，而殊非其實也。初為太傅楊駿參軍，時京兆多盜竊。駿欲更重其法，盜百錢加大辟，請官屬會議，亮曰：「昔楚江乙母失布，以為盜由令尹。公若無欲，盜宜自止，何重法為？」駿慚而止。累轉大鴻臚。時惠帝在長安，亮與關東連謀，內不自安，奔於并州，為劉元海所害。亮弟陶，為徐州刺史。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-yanghu-ws2567662-rendered-comparison"}],"mentions":[{"id":"c-jinshu-034-yanghu-comparison:p041:m0164","start":164,"end":166,"surface":"江乙","kind":"person","person_id":"jco_uwm_8n3","status":"contextual_provisional","paragraph_id":"c-jinshu-034-yanghu-comparison:p041","chapter_id":"c-jinshu-034-yanghu-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin034-jiangyi-ancient","person_id":"jco_uwm_8n3","surfaces":["江乙"],"scope":"same_chapter","chapter_ids":["c-jinshu-034-yanghu-comparison"],"status":"contextual_provisional","confidence_level":"medium","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-yanghu-ws2567662-rendered-comparison","chapter_id":"c-jinshu-034-yanghu-comparison","paragraph_id":"c-jinshu-034-yanghu-compariso