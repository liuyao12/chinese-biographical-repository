xima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-059-prince-yue:source_relationship11-38","kind":"source_relationship","person_id":"f9x_h7n_0pq","source_quote":"成帝以少子奕繼之","reading":"奕為成帝子，出繼沖。","note":"奕為成帝子，出繼沖。","paragraph_id":"c-jinshu-059-prince-yue:p011","start_codepoint":38,"end_codepoint":46,"human_reviewed":false,"related_person_id":"dkn_ge4_286_AAAAAAAC","chapter_id":"c-jinshu-059-prince-yue","source_id":"s-jinshu-059-prince-yue-ws2650517"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin059-volume-yi-later-father","subject_person_id":"f9x_h7n_0pq","object_person_id":"dkn_ge4_286_AAAAAAAAA","predicate":"father","qualifiers":{"source_term":"成帝以少子奕"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-prince-yue","source_id":"s-jinshu-059-prince-yue-ws2650517","paragraph_id":"c-jinshu-059-prince-yue:p011","quote":"初，元帝鎮建鄴，裴妃之意也，帝深德之，數幸其第，以第三子沖奉越後。薨，無子，成帝以少子奕繼之。哀帝徙奕為琅邪王，而東海無嗣。隆安初，安帝更以會稽忠王次子彥璋為東海王，繼沖為曾孫。為桓玄所害，國除。","subject_person_mention_id":"c-jinshu-059-prince-yue:p011:m0043","object_person_mention_id":"c-jinshu-059-prince-yue:p011:m0038"}],"status":"source_attested","interpretation_note":"奕為成帝少子，承嗣另記。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin064-yi-emperor-father","subject_person_id":"f9x_h7n_0pq","object_person_id":"dkn_ge4_286_AAAAAAAAA","predicate":"father","qualifiers":{"source_term":"朕所哀怛。其以小晚生奕"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-064","chapter_id":"c-jinshu-064-simachong","source_id":"s-jinshu-064-simachong-ws2622004","paragraph_id":"c-jinshu-064-simachong:p002","quote":"成帝臨崩，詔曰：「哀王無嗣，國統將絕，朕所哀怛。其以小晚生奕繼哀王為東海王。」以道遠，罷滎陽，更以臨川郡益東海。及哀帝以琅邪王即尊位，徙奕為琅邪王，東海國闕，無嗣。奕後入纂大業，桓溫廢之，復為東海王，既而貶為海西公，東海國又闕嗣。隆安三年，安帝詔以會稽忠王次子彥璋為東海王，繼哀王為曾孫，改食吳興郡。為桓玄所害，國除。","subject_person_mention_id":"c-jinshu-064-simachong:p002:m0029","object_person_mention_id":"c-jinshu-064-simachong:p002:m0000"}],"status"