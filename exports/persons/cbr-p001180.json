"c-shiji-033-lu:m079-0104","start":104,"end":106,"surface":"陽虎","kind":"person","person_id":"hqs_i1n_n5h","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p079","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m079-0107","start":107,"end":109,"surface":"陽虎","kind":"person","person_id":"hqs_i1n_n5h","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p079","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-037-wei:m031-0015","start":15,"end":17,"surface":"陽虎","kind":"person","person_id":"hqs_i1n_n5h","status":"contextual_provisional","paragraph_id":"c-shiji-037-wei:p031","chapter_id":"c-shiji-037-wei"},{"id":"c-shiji-038-song:m053-0006","start":6,"end":9,"surface":"魯陽虎","kind":"person","person_id":"hqs_i1n_n5h","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p053","chapter_id":"c-shiji-038-song"},{"id":"c-shiji-039-jin:m128-0020","start":20,"end":23,"surface":"魯陽虎","kind":"person","person_id":"hqs_i1n_n5h","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p128","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-101","person_id":"hqs_i1n_n5h","surfaces":["陽虎","魯陽虎"],"scope":"same_chapter","chapter_ids":["c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p070","quote":"四十七年，魯陽虎攻其君，不勝，奔齊，請齊伐魯。鮑子諫景公，乃囚陽虎。陽虎得亡，奔晉。"}],"rationale":"按齊君繼位、家族明示與田氏政變的具體敘事暫定異稱。晉／魯昭公、齊／吳公子光分開，鮑子、鮑牧及監止、子我暫不合併，所錄或曰及疑讀仍待版本覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji033-130","person_id":"hqs_i1n_n5h","surfaces":["陽虎","魯陽虎"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p070","quote":"四十七年，魯陽虎攻其君，不勝，奔齊，請齊伐魯。鮑子諫景公，乃囚陽虎。陽虎得亡，奔晉。"},{"paragraph_id":"c-shiji-033-lu:p079","quote":"定公五年，季平子卒。陽虎私怒，囚季桓子，與盟，乃捨之。七年，齊伐我，取鄆，以爲魯陽虎邑以從政。八年，陽虎欲盡殺三桓適，而更立其所善庶子以代之；載季桓子將殺之，桓子詐而得脫。三桓共攻陽虎，陽虎居陽關。九年，魯伐陽虎，陽虎奔齊，已而奔晉趙氏。"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji037-039","person_id":"hqs_i1n_n5h","surfaces":["陽虎"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-037-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p070","quote":"四十七年，魯陽虎攻其君，不勝，奔齊，請齊伐魯。鮑子諫景公，乃囚陽虎。陽虎得亡，奔晉。"},{"paragraph_id":"c-shiji-037-wei:p031","quote":"六月乙酉，趙簡子欲入蒯聵，乃令陽虎詐命衞十餘人衰絰歸，簡子送蒯聵。衞人聞之，發兵撃蒯聵。蒯聵不得入，入宿而保，衞人亦罷兵。"}],"rationale":"按本篇明示名與追稱、衛世系及具體事件暫定所列提及同指；每段原文附存，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji038-041","person_id":"hqs_i1n_n5h","surfaces":["魯陽虎"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p070","quote":"四十七年，魯陽虎攻其君，不勝，奔齊，請齊伐魯。鮑子諫景公，乃囚陽虎。陽虎得亡，奔晉。"},{"paragraph_id":"c-shiji-038-song:p053","quote":"景公十六年，魯陽虎來奔，已復去。二十五年，孔子過宋，宋司馬桓魋惡之，欲殺孔子，孔子微服去。三十年，曹倍宋，又倍晉，宋伐曹，晉不救，遂滅曹有之。三十六年，齊田常弒簡公。"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-104","person_id":"hqs_i1n_n5h","surfaces":["魯陽虎"],"scope":"cross_chapter","chapter_ids":["c-shiji-032-qi","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-032-qi:p070","quote":"四十七年，魯陽虎攻其君，不勝，奔齊，請齊伐魯。鮑子諫景公，乃囚陽虎。陽虎得亡，奔晉。"},{"paragraph_id":"c-shiji-039-jin:p128","quote":"十四年，頃公卒，子定公午立。定公十一年，魯陽虎奔晉，趙鞅簡子捨之。十二年，孔子相魯。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-032-qi:p070","text":"四十七年，魯陽虎攻其君，不勝，奔齊，請齊伐魯。鮑子諫景公，乃囚陽虎。陽虎得亡，奔晉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m070-0005","start":5,"end":8,"surface":"魯陽虎","kind":"person","person_id":"hqs_i1n_n5h","status":"contextual_provisional"}