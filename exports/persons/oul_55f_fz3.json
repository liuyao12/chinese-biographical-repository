{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"oul_55f_fz3","canonical_person_id":"oul_55f_fz3","id_aliases":["cbr-p004910"],"identity_policy":"contextual_provisional","person_ids":["oul_55f_fz3"],"persons":[{"id":"oul_55f_fz3","label":"韓子引古未定（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韓子","mention_ids":["c-shiji-087-lisi:m021-0117","c-shiji-087-lisi:m024-0001","c-shiji-087-lisi:m024-0095"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m021-0117","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p021","quote":"韓子"},{"mention_id":"c-shiji-087-lisi:m024-0001","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p024","quote":"韓子"},{"mention_id":"c-shiji-087-lisi:m024-0095","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p024","quote":"韓子"}],"id_aliases":["cbr-p004910"]}],"source_mention_summary":[{"source_id":"s-shiji-087-lisi","work_id":"w-shiji","book_id":"b-shiji-087","chapter_id":"c-shiji-087-lisi","mention_count":3,"mention_ids":["c-shiji-087-lisi:m021-0117","c-shiji-087-lisi:m024-0001","c-shiji-087-lisi:m024-0095"],"paragraph_ids":["c-shiji-087-lisi:p021","c-shiji-087-lisi:p024"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-087-lisi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-087-lisi:m021-0117","start":117,"end":119,"surface":"韓子","kind":"person","person_id":"oul_55f_fz3","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p021","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m024-0001","start":1,"end":3,"surface":"韓子","kind":"person","person_id":"oul_55f_fz3","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p024","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m024-0095","start":95,"end":97,"surface":"韓子","kind":"person","person_id":"oul_55f_fz3","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p024","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-043","person_id":"oul_55f_fz3","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依二世用高及督責書局部承接暫接；第19段趙高之高排除高枕普通詞，第20段公子高與趙高分開；廣等只按吳廣兵承接，不標廣欲。堯禹標示傳說性，韓子商君與申韓未以模型記憶補名或全域合併；嵌套引語仍待核。","reviewer":"Codex（AI 代理）","surfaces":["韓子"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p021","quote":"法令誅罰日益刻深，羣臣人人自危，欲畔者眾。又作阿房之宮，治直、馳道，賦斂愈重，戍徭無已。於是楚戍卒陳勝、吳廣等乃作亂，起於山東，傑俊相立，自置為侯王，叛秦，兵至鴻門而卻。李斯數欲請間諫，二世不許。而二世責問李斯曰：「吾有私議而有所聞於韓子也，曰『堯之有天下也，堂高三尺，采椽不斲，茅茨不翦，雖逆旅之宿不勤於此矣。冬日鹿裘，夏日葛衣，粢糲之食，藜藿之羹，飯土匭，啜土鉶，雖監門之養不觳於此矣。禹鑿龍門，通大夏，疏九河，曲九防，決渟水致之海，而股無胈，脛無毛，手足胼胝，面目黎黑，遂以死于外，葬於會稽，臣虜之勞不烈於此矣』。然則夫所貴於有天下者，豈欲苦形勞神，身處逆旅之宿，口食監門之養，手持臣虜之作哉？此不肖人之所勉也，非賢者之所務也。彼賢人之有天下也，專用天下適己而已矣，此所貴於有天下也。夫所謂賢人者，必能安天下而治萬民，今身且不能利，將惡能治天下哉！故吾願賜志廣欲，長享天下而無害，為之奈何？」李斯子由為三川守，群盜吳廣等西略地，過去弗能禁。章邯以破逐廣等兵，使者覆案三川相屬，誚讓斯居三公位，如何令盜如此。李斯恐懼，重爵祿，不知所出，乃阿二世意，欲求容，以書對曰："},{"paragraph_id":"c-shiji-087-lisi:p024","quote":"故韓子曰：「慈母有敗子而嚴家無格虜」者，何也？則能罰之加焉必也。故商君之法，刑棄灰於道者。夫棄灰，薄罪也，而被刑，重罰也。彼唯明主為能深督輕罪。夫罪輕且督深，而況有重罪乎？故民不敢犯也。是故韓子曰「布帛尋常，庸人不釋，鑠金百溢，盜跖不搏」者，非庸人之心重，尋常之利深，而盜跖之欲淺也；又不以盜跖之行，為輕百鎰之重也。搏必隨手刑，則盜跖不搏百鎰；而罰不必行也，則庸人不釋尋常。是故城高五丈，而樓季不輕犯也；泰山之高百仞，而跛䍧牧其上。夫樓季也而難五丈之限，豈跛䍧也而易百仞之高哉？峭塹之勢異也。明主聖王之所以能久處尊位，長執重勢，而獨擅天下之利者，非有異道也，能獨斷而審督責，必深罰，故天下不敢犯也。今不務所以不犯，而事慈母之所以敗子也，則亦不察於聖人之論矣。夫不能行聖人之術，則舍為天下役何事哉？可不哀邪！"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p021","text":"法令誅罰日益刻深，羣臣人人自危，欲畔者眾。又作阿房之宮，治直、馳道，賦斂愈重，戍徭無已。於是楚戍卒陳勝、吳廣等乃作亂，起於山東，傑俊相立，自置為侯王，叛秦，兵至鴻門而卻。李斯數欲請間諫，二世不許。而二世責問李斯曰：「吾有私議而有所聞於韓子也，曰『堯之有天下也，堂高三尺，采椽不斲，茅茨不翦，雖逆旅之宿不勤於此矣。冬日鹿裘，夏日葛衣，粢糲之食，藜藿之羹，飯土匭，啜土鉶，雖監門之養不觳於此矣。禹鑿龍門，通大夏，疏九河，曲九防，決渟水致之海，而股無胈，脛無毛，手足胼胝，面目黎黑，遂以死于外，葬於會稽，臣虜之勞不烈於此矣』。然則夫所貴於有天下者，豈欲苦形勞神，身處逆旅之宿，口食監門之養，手持臣虜之作哉？此不肖人之所勉也，非賢者之所務也。彼賢人之有天下也，專用天下適己而已矣，此所貴於有天下也。夫所謂賢人者，必能安天下而治萬民，今身且不能利，將惡能治天下哉！故吾願賜志廣欲，長享天下而無害，為之奈何？」李斯子由為三川守，群盜吳廣等西略地，過去弗能禁。章邯以破逐廣等兵，使者覆案三川相屬，誚讓斯居三公位，如何令盜如此。李斯恐懼，重爵祿，不知所出，乃阿二世意，欲求容，以書對曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m021-0009","start":9,"end":11,"surface":"羣臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，未補特定個人或世系。"},{"id":"c-shiji-087-lisi:m021-0046","start":46,"end":51,"surface":"楚戍卒陳勝","kind":"person","person_id":"seb_lin_831","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0052","start":52,"end":54,"surface":"吳廣","kind":"person","person_id":"axt_oe2_4fw","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0064","start":64,"end":66,"surface":"傑俊","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或引古未定短稱保留未解，未補特定個人或世系。"},{"id":"c-shiji-087-lisi:m021-0085","start":85,"end":87,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0093","start":93,"end":95,"surface":"二世","kind":"person","person_id":"z0a_bdl_gn5_B","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0099","start":99,"end":101,"surface":"二世","kind":"person","person_id":"z0a_bdl_gn5_B","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0103","start":103,"end":105,"surface":"李斯","kind":"person","person_id":"5ok_joj_etv","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0117","start":117,"end":119,"surface":"韓子","kind":"person","person_id":"oul_55f_fz3","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m021-0123","start":123,"end":124,"surface":"堯","kind":"person","person_id":"0yh_g69_8b8","status":"contextual