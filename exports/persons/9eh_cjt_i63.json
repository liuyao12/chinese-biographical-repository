,6253,6254,6255,6256,6257,6258,6259,6260,6261,6262,6263,6264,6265,6266,6267,6268,6269,6270,6271,6272,6273,6274,6275,6276,6277,6278,6279,6280,6281,6282,6283,6284,6285,6286,6287,6288,6289,6290,6291,6292,6293,6294,6295,6296,6297,6298,6299],"revision_id":2638629},"mentions":[{"id":"c-nanqishu-058-southern-and-eastern-complete:p029:m0005","start":5,"end":9,"surface":"闍耶跋摩","kind":"person","person_id":"xfy_0t0_umc","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p029:m0015","start":15,"end":18,"surface":"那伽仙","kind":"person","person_id":"9eh_cjt_i63","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p029:m0029","start":29,"end":33,"surface":"闍耶跋摩","kind":"person","person_id":"xfy_0t0_umc","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p029:m0180","start":180,"end":183,"surface":"那伽仙","kind":"person","person_id":"9eh_cjt_i63","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p029:m0211","start":211,"end":214,"surface":"那伽仙","kind":"person","person_id":"9eh_cjt_i63","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p029:m0349","start":349,"end":352,"surface":"那伽仙","kind":"person","person_id":"9eh_cjt_i63","status":"contextual_provisional"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p029:m0709","start":709,"end":712,"surface":"那伽仙","kind":"person","person_id":"9eh_cjt_i63","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-058-southern-and-eastern-complete","book_id":"b-nanqishu-058","work_id":"w-nanqishu","source_id":"s-nanqishu-058-southern-and-eastern-complete-ws2638629"},{"id":"c-nanqishu-058-southern-and-eastern-complete:p030","text":"那伽仙詣京師，言其國俗事摩䤈首羅天神，神常降於摩躭山。土氣恒暖，草木不落。其上書曰：「吉祥利世閒，感攝於羣生。所以其然者，天感化緣明。仙山名摩躭，吉樹敷嘉榮。摩䤈首羅天，依此降尊靈。國土悉蒙祐，人民皆安寧。由斯恩被故，是以臣歸情。菩薩行忍慈，本迹起凡基。一發菩提心，二乘非所期。歷生積功業，六度行大悲。勇猛超劫數，財命捨無遺。生死不為猒，六道化有緣。具脩於十地，遺果度人天。功業既已定，行滿登正覺。萬善智圓備，惠日照塵俗。眾生感緣應，隨機授法藥。佛化遍十方，無不蒙濟擢。皇帝聖弘道，興隆於三寶。垂心覽萬機，威恩振八表。國土及城邑，仁風化清皎。亦如釋提洹，眾天中最超。陛下臨萬民，四海共歸心，聖慈流無疆，被臣小國深。」詔報曰：「具摩䤈降靈，流施彼土，雖殊俗異化，遙深欣讚。知鳩酬羅於彼背叛，竊據林邑，聚兇肆掠，殊宜剪討。彼雖介遐（休）〔陬〕，舊脩蕃貢，自宋季多難，海譯致壅，皇化惟新，習迷未革。朕方以文德來遠人，未欲便興干戈。王既欵列忠到，遠請軍威，今詔交部隨宜應接。伐叛柔服，寔惟國典，勉立殊效，以副所期。那伽仙屢銜邊譯，頗悉中土闊狹，令其具宣。」上報以絳紫地黃碧綠紋綾各五匹。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":78,"last_line":78,"raw_start":6302,"raw_end":6827,"raw_character_offsets":[6302,6303,6304,6305,6306,6307,6308,6309,6310,6311,6312,6313,6314,6315,6316,6317,6318,6319,6320,6321,6322,6323,6324,6325,6326,6327,6328,6329,6330,6331,6332,6333,6334,6335,6336,6337,6338,6339,6340,6341,6342,6343,6344,6345,6346,6347,6348,6349,6350,6351,6352,6353,6354,6355,6356,6357,6358,6359,6360,6361,6362,6363,6364,6365,6366,6367,6368,6369,6370,6371,6372,6373,6374,6375,6376,6377,6378,6379,6380,6381,6382,6383,6384,6385,6386,6387,6388,6389,6390,6391,6392,6393,6394,6395,6396,6397,6398,6399,6400,6401,6402,6403,6404,6405,6406,6407,6408,6409,6410,6411,6412,6413,6414,6415,6416,6417,6418,6419,6420,6421,6422,6423,6424,6425,6426,6427,6428,6429,6430,6431,6432,6433,6434,6435,6436,6437,6438,6439,6440,6441,6442,6443,6444,6445,6446,6447,6448,6449,6450,6451,6452,6453,6454,6455,6456,6457,6458,6459,6460,6461,6462,6463,6464,6465,6466,6467,6468,6469,6470,6471,6472,6473,6474,6475,6476,6477,6478,6479,6480,6481,6482,6483,6484,6485,6486,6487,6488,6489,6490,6491,6492,6493,6494,6495,6496,6497,6498,6499,6500,6501,6502,6503,6504,6505,6506,6507,6508,6509,6510,6511,6512,6513,6514,6515,6516,6517,6518,6519,6520,6521,6522,6523,6524,6525,6526,6527,6528,6529,6530,6531,6532,6533,6534,6535,6536,6537,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,661