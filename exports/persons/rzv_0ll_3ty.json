fancai:m013-0770","start":770,"end":772,"surface":"先生","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0786","start":786,"end":788,"surface":"太后","kind":"person","person_id":"pvp_ebv_zcb","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0792","start":792,"end":793,"surface":"臣","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0795","start":795,"end":797,"surface":"先生","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0810","start":810,"end":812,"surface":"范睢","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0814","start":814,"end":816,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"}],"chapter_id":"c-shiji-079-fancai","book_id":"b-shiji-079","work_id":"w-shiji","source_id":"s-shiji-079-fancai"},{"id":"c-shiji-117-xiangru:p045","text":"相如口吃而善著書。常有消渴疾。與卓氏婚，饒於財。其進仕宦，未嘗肯與公卿國家之事，稱病間居，不慕官爵。常從上至長楊獵，是時天子方好自擊熊彘，馳逐野獸，相如上疏諫之。其辭曰：\n臣聞物有同類而殊能者，故力稱烏獲，捷言慶忌，勇期賁、育。臣之愚，竊以為人誠有之，獸亦宜然。今陛下好陵阻險，射猛獸，卒然遇軼材之獸，駭不存之地，犯屬車之清塵，輿不及還轅，人不暇施巧，雖有烏獲、逢蒙之伎，力不得用，枯木朽株盡為害矣。是胡越起於轂下，而羌夷接軫也，豈不殆哉！雖萬全無患，然本非天子之所宜近也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m045-0000","start":0,"end":2,"surface":"相如","kind":"person","person_id":"usb_lgr_ksa","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0016","start":16,"end":18,"surface":"卓氏","kind":"person","person_id":"2ph_uqm_vm3","status":"contextual_provisional","interpretation_note":"依開篇文君婚姻與卓王孫女尚長卿的連續敘事暫接；不把所有卓氏都當文君，篇末未名妻另留候選。"},{"id":"c-shiji-117-xiangru:m045-0052","start":52,"end":53,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-117-xiangru:m045-0060","start":60,"end":62,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","