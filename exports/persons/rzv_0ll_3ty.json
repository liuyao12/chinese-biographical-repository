"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji117-xiangru"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-016-duji-dushu:unit029:m0717","start":717,"end":719,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional","interpretation_note":"烏獲舉千鈞是力士典故，與已有烏獲古代力士身份相合，不取張儀篇同人候選另造。","paragraph_id":"c-sanguozhi-016-duji-dushu:unit029","chapter_id":"c-sanguozhi-016-duji-dushu"},{"id":"c-shiji-005-qin:m068-0164","start":164,"end":166,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p068","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-079-fancai:m013-0353","start":353,"end":355,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p013","chapter_id":"c-shiji-079-fancai"},{"id":"c-shiji-117-xiangru:m045-0100","start":100,"end":102,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p045","chapter_id":"c-shiji-117-xiangru"},{"id":"c-shiji-117-xiangru:m045-0178","start":178,"end":180,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional","paragraph_id":"c-shiji-117-xiangru:p045","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-022","person_id":"rzv_0ll_3ty","surfaces":["烏獲"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p013","quote":"秦王屏左右，宮中虛無人。秦王跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」有閒，秦王復跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」若是者三。秦王跽曰：「先生卒不幸教寡人邪？」范睢曰：「非敢然也。臣聞昔者呂尚之遇文王也，身為漁父而釣於渭濱耳。若是者，交疏也。已說而立為太師，載與俱歸者，其言深也。故文王遂收功於呂尚而卒王天下。鄉使文王疏呂尚而不與深言，是周無天子之德，而文武無與成其王業也。今臣羈旅之臣也，交疏於王，而所願陳者皆匡君之事，處人骨肉之閒，願效愚忠而未知王之心也。此所以王三問而不敢對者也。臣非有畏而不敢言也。臣知今日言之於前而明日伏誅於後，然臣不敢避也。大王信行臣之言，死不足以為臣患，亡不足以為臣憂，漆身為厲被髪為狂不足以為臣恥。且以五帝之聖焉而死，三王之仁焉而死，五伯之賢焉而死，烏獲、任鄙之力焉而死，成荊、孟賁、王慶忌、夏育之勇焉而死。死者，人之所必不免也。處必然之勢，可以少有補於秦，此臣之所大願也，臣又何患哉！伍子胥橐載而出昭關，夜行晝伏，至於陵水，無以糊其口，厀行蒲伏，稽首肉袒，鼓腹吹篪，乞食於吳市，卒興吳國，闔閭為伯。使臣得盡謀如伍子胥，加之以幽囚，終身不復見，是臣之說行也，臣又何憂？箕子、接輿漆身為厲，被髪為狂，無益於主。假使臣得同行於箕子，可以有補於所賢之主，是臣之大榮也，臣有何恥？臣之所恐者，獨恐臣死之後，天下見臣之盡忠而身死，因以是杜口裹足，莫肯鄉秦耳。足下上畏太后之嚴，下惑於姦臣之態，居深宮之中，不離阿保之手，終身迷惑，無與昭姦。大者宗廟滅覆，小者身以孤危，此臣之所恐耳。若夫窮辱之事，死亡之患，臣不敢畏也。臣死而秦治，是臣死賢於生。」秦王跽曰：「先生是何言也！夫秦國辟遠，寡人愚不肖，先生乃幸辱至於此，是天以寡人慁先生而存先王之宗廟也。寡人得受命於先生，是天所以幸先王，而不棄其孤也。先生柰何而言若是！事無小大，上及太后，下至大臣，願先生悉以教寡人，無疑寡人也。」范睢拜，秦王亦拜。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，第32段白公已按四子敘事及集解釋名暫接白起，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji079-wuhuo","person_ids":["rzv_0ll_3ty"],"canonical_person_id":"rzv_0ll_3ty","scope":"cross_chapter","chapter_ids":["c-shiji-079-fancai","c-shiji-005-qin"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-079-fancai","source_id":"s-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p013","quote":"秦王屏左右，宮中虛無人。秦王跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」有閒，秦王復跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」若是者三。秦王跽曰：「先生卒不幸教寡人邪？」范睢曰：「非敢然也。臣聞昔者呂尚之遇文王也，身為漁父而釣於渭濱耳。若是者，交疏也。已說而立為太師，載與俱歸者，其言深也。故文王遂收功於呂尚而卒王天下。鄉使文王疏呂尚而不與深言，是周無天子之德，而文武無與成其王業也。今臣羈旅之臣也，交疏於王，而所願陳者皆匡君之事，處人骨肉之閒，願效愚忠而未知王之心也。此所以王三問而不敢對者也。臣非有畏而不敢言也。臣知今日言之於前而明日伏誅於後，然臣不敢避也。大王信行臣之言，死不足以為臣患，亡不足以為臣憂，漆身為厲被髪為狂不足以為臣恥。且以五帝之聖焉而死，三王之仁焉而死，五伯之賢焉而死，烏獲、任鄙之力焉而死，成荊、孟賁、王慶忌、夏育之勇焉而死。死者，人之所必不免也。處必然之勢，可以少有補於秦，此臣之所大願也，臣又何患哉！伍子胥橐載而出昭關，夜行晝伏，至於陵水，無以糊其口，厀行蒲伏，稽首肉袒，鼓腹吹篪，乞食於吳市，卒興吳國，闔閭為伯。使臣得盡謀如伍子胥，加之以幽囚，終身不復見，是臣之說行也，臣又何憂？箕子、接輿漆身為厲，被髪為狂，無益於主。假使臣得同行於箕子，可以有補於所賢之主，是臣之大榮也，臣有何恥？臣之所恐者，獨恐臣死之後，天下見臣之盡忠而身死，因以是杜口裹足，莫肯鄉秦耳。足下上畏太后之嚴，下惑於姦臣之態，居深宮之中，不離阿保之手，終身迷惑，無與昭姦。大者宗廟滅覆，小者身以孤危，此臣之所恐耳。若夫窮辱之事，死亡之患，臣不敢畏也。臣死而秦治，是臣死賢於生。」秦王跽曰：「先生是何言也！夫秦國辟遠，寡人愚不肖，先生乃幸辱至於此，是天以寡人慁先生而存先王之宗廟也。寡人得受命於先生，是天所以幸先王，而不棄其孤也。先生柰何而言若是！事無小大，上及太后，下至大臣，願先生悉以教寡人，無疑寡人也。」范睢拜，秦王亦拜。","mention_ids":["c-shiji-079-fancai:m013-0353"]},{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p068","quote":"武王元年，與魏惠王會臨晉。誅蜀相壯。張儀、魏章皆東出之魏。伐義渠、丹、犁。二年，初置丞相，摢裏疾、甘茂為左右丞相。張儀死於魏。三年，與韓襄王會臨晉外。南公揭卒，摢裏疾相韓。武王謂甘茂曰：「寡人欲容車通三川，窺周室，死不恨矣。」其秋，使甘茂、庶長封伐宜陽。四年，拔宜陽，斬首六萬。涉河，城武遂。魏太子來朝。武王有力好戲，力士任鄙、烏獲、孟說皆至大官。王與孟說舉鼎，絕臏。八月，武王死。族孟說。武王取魏女為后，無子。立異母弟，是為昭襄王。昭襄母楚人，姓羋氏，號宣太后。武王死時，昭襄王為質於燕，燕人送歸，得立。","mention_ids":["c-shiji-005-qin:m068-0164"]}],"rationale":"本篇以烏獲、任鄙並列力量典型；秦本紀在武王力士條中同列任鄙、烏獲，暫接該傳世人物。不從修辭補死亡日期。 原文與錨點保留，未核底本影像。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji117-allusion-wuhuo","person_ids":["rzv_0ll_3ty"],"canonical_person_id":"rzv_0ll_3ty","scope":"cross_chapter","chapter_ids":["c-shiji-117-xiangru","c-shiji-005-qin"],"status":"contextual_provisional","confidence_level":"high","evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p045","quote":"相如口吃而善著書。常有消渴疾。與卓氏婚，饒於財。其進仕宦，未嘗肯與公卿國家之事，稱病間居，不慕官爵。常從上至長楊獵，是時天子方好自擊熊彘，馳逐野獸，相如上疏諫之。其辭曰：\n臣聞物有同類而殊能者，故力稱烏獲，捷言慶忌，勇期賁、育。臣之愚，竊以為人誠有之，獸亦宜然。今陛下好陵阻險，射猛獸，卒然遇軼材之獸，駭不存之地，犯屬車之清塵，輿不及還轅，人不暇施巧，雖有烏獲、逢蒙之伎，力不得用，枯木朽株盡為害矣。是胡越起於轂下，而羌夷接軫也，豈不殆哉！雖萬全無患，然本非天子之所宜近也。","mention_ids":["c-shiji-117-xiangru:m045-0100","c-shiji-117-xiangru:m045-0178"]},{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p068","quote":"武王元年，與魏惠王會臨晉。誅蜀相壯。張儀、魏章皆東出之魏。伐義渠、丹、犁。二年，初置丞相，摢裏疾、甘茂為左右丞相。張儀死於魏。三年，與韓襄王會臨晉外。南公揭卒，摢裏疾相韓。武王謂甘茂曰：「寡人欲容車通三川，窺周室，死不恨矣。」其秋，使甘茂、庶長封伐宜陽。四年，拔宜陽，斬首六萬。涉河，城武遂。魏太子來朝。武王有力好戲，力士任鄙、烏獲、孟說皆至大官。王與孟說舉鼎，絕臏。八月，武王死。族孟說。武王取魏女為后，無子。立異母弟，是為昭襄王。昭襄母楚人，姓羋氏，號宣太后。武王死時，昭襄王為質於燕，燕人送歸，得立。","mention_ids":["c-shiji-005-qin:m068-0164"]}],"rationale":"以力稱烏獲，顏師古明釋秦武王力士，與秦本紀武王時力士烏獲相合。古注與正文分存，不把比喻當共同出獵事件，不補任官、生卒或世系。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true,"references":[{"title":"《漢書》卷57下·顏師古釋烏獲、慶忌、賁育","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_057.txt#L848","quote":"其辭曰臣聞物有同類而殊能者故力稱烏獲㨗言慶¶\n忌(師古曰烏獲秦武王力士也慶/忌吳王僚子也射能㨗矢也)勇期賁育(師古曰孟/賁古之勇)¶\n(士也水行不避蛟龍陸行不避豺狼/發怒吐氣聲響動天夏育亦猛士也)臣之愚竊以為人¶","scope":"ancient_commentary_identification","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"44cd0a168123204ab8369c8382018dbaaa846a86","response_sha256":"cd7ede101cb8268da5b471d2632d512a1255f22e90b850c326162b8ed516c8ee","verified_extent":{"start_line":721,"end_line":850},"image_verified":false}]}],"passages":[{"id":"c-sanguozhi-016-duji-dushu:unit029","text_layer":"received_chapter","text":"乃上疏曰帝王之道莫尚乎安民安民之術在於豐財豐財者務本而節用也方今二賊未滅戎車亟駕此自熊虎之士展力之秋也然縉紳之儒橫加榮慕搤腕抗論以孫呉為首州郡牧守咸共忽恤民之術脩將率之事農桑之民競干戈之業不可謂務本帑藏嵗虚而制度嵗廣民力嵗衰而賦役嵗興不可謂節用今大魏奄有十州之地而承喪亂之弊計其户口不如往昔一州之民然而二方僭逆北虜未賓三邊遘難繞天略帀所以統一州之民經營九州之地其為艱難譬䇿羸馬以取道里豈可不加意愛惜其力哉以武皇帝之節儉府藏充實猶不能十州擁兵郡且二十也今荆揚青徐幽并雍涼緣邊諸州皆有兵矣其所恃内充府庫外制四夷者惟兖豫司冀而已臣前以州郡典兵則專心軍功不勤民事宜别置將守以盡治理之務而陛下復以冀州寵秩吕昭冀州户口最多田多墾闢又有桑棗之饒國家徵求之府誠不當復任以兵事也若以北方當須鎭守自可專置大將以鎭安之計所置吏士之費與兼官無覺然昭於人才尚復易中朝茍乏人兼才者勢不獨多以此推之知國家以人擇官不為官擇人也官得其人則政平訟理政平故民富實訟理故囹圄虚空陛下踐祚天下斷獄百數十人嵗嵗增多至五百餘人矣民不益多法不益峻以此推之非政敎陵遲牧守不稱之明效歟往年牛死通率天下十能損二麥不半收秋種未下若二賊游魂於疆場飛芻輓粟千里不及究此之術豈在彊兵乎武士勁卒愈多愈多愈病耳夫天下猶人之體腹心充實四支雖病終無大患今兖豫司冀亦天下之腹心也是以愚臣慺慺實願四州之牧守獨脩務本之業以堪四支之重然孤論難持犯欲難成衆怨難積疑似難分故累載不為明主所察凡言此者類皆疏賤疏賤之言實未易聽若使善䇿必出於親貴固不犯四難以求忠愛此古今之所常患也時又大議考課之制以考内外衆官恕以為用不盡其人雖才且無益所存非所務所務非世要上疏曰書稱明試以功三考黜陟誠帝王之盛制使有能者當其官有功者受其禄譬猶烏獲之舉千鈞良樂之選驥足也雖歴六代而考績之法不著閲七聖而課試之文不垂臣誠以為其法可粗依其詳難備舉故也語曰世有亂人而無亂法若使法可專任則唐虞可不須稷契之佐殷周無貴伊吕之輔矣今奏考功者陳周漢之法為綴京房之本㫖可謂明考課之要矣於以崇揖讓之風興濟濟之治臣以為未盡善也其欲使州郡考士必由四科皆有事效然後察舉試辟公府為親民長吏轉以功次補郡守者或就增秩賜爵此最考課之急務也臣以為便當顯其身用其言使其為課州郡之法法具施行立必信之賞施必行之罰至於公卿及内職大臣亦當俱以其職考課之也古之三公坐而論道内職大臣納言補闕無善不紀無過不舉且天下至大萬幾至衆誠非一明所能徧照故君為元首臣為股肱明其一體相須而成也是以古人稱廊廟之材非一木之枝帝王之業非一士之略由是言之焉有大臣守職辨課可以致雍熙者哉且布衣之交猶有務信誓而蹈水火感知已而披肝膽狥聲名而立節義者况於束帶立朝致位卿相所務者非特匹夫之信所感者非徒知已之惠所狥者豈聲名而已乎諸䝉寵禄受重任者不徒欲舉明主於唐虞之上而已身亦欲厠稷契之列是以古人不患於念治之心不盡患於自任之意不足此誠人主使之然也唐虞之君委任稷契䕫龍而責成功及其罪也殛鯀而放四凶今大臣親奉明詔給事目下其有夙夜在公恪勤特立當官不撓貴勢執平不阿所私危言危行以處朝廷者自明主所察也若尸禄以為髙拱嘿以為智當官茍在於免負立朝不忘於容身潔行遜言以處朝廷者亦明主所察也誠使容身保位無放退之辜而盡節在公抱見疑之勢公義不脩而私議成俗雖仲尼為謀猶不能盡一才又况於世俗之人乎今之學者師商韓而上法術競以儒家為迂闊不周世用此最風俗之流弊創業者之所致愼也後考課竟不行","source_position":{"source_layer":"received_body","first_line":190,"last_line":263,"raw_projection_ref":"source-evidence/sgz016-duji-dushu/fixed-complete-unit.json"},"mentions":[{"id":"c-sanguozhi-016-duji-dushu:unit029:m0032","start":32,"end":34,"surface":"二賊","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"魏之兩敵國/軍政勢力，未明單一君主，不造兩個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0065","start":65,"end":66,"surface":"孫","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional","interpretation_note":"疏以孫吳為兵學先導，孫首選孫武、吳吳起的兵家併稱；保孫臏可能與學派化用資格，不宣稱本句載全名。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0066","start":66,"end":67,"surface":"呉","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional","interpretation_note":"孫吳與軍事/將率之事併說，吳起為兵學代表的上下文首選，與孫吳列傳本傳人合；不作魏朝受職。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0203","start":203,"end":206,"surface":"武皇帝","kind":"person","person_id":"dad_b77_b38","status":"contextual_provisional","interpretation_note":"太祖河北平高幹、韓遂馬超之叛、魏國建與漢中征伐為曹操；與黃初文帝/太和明帝及司馬宣文王分開。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0261","start":261,"end":262,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0289","start":289,"end":291,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0297","start":297,"end":299,"surface":"吕昭","kind":"person","person_id":"o2j_4j9_rda","status":"contextual_provisional","interpretation_note":"本章字子展/東平、鎮北將軍領冀州；009桓範段明鎮北吕昭及吕子展，是精確職/字共同橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0361","start":361,"end":362,"surface":"昭","kind":"person","person_id":"o2j_4j9_rda","status":"contextual_provisional","interpretation_note":"本章字子展/東平、鎮北將軍領冀州；009桓範段明鎮北吕昭及吕子展，是精確職/字共同橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0419","start":419,"end":421,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0487","start":487,"end":489,"surface":"二賊","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"魏之兩敵國/軍政勢力，未明單一君主，不造兩個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0556","start":556,"end":557,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0660","start":660,"end":661,"surface":"恕","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:w0686","start":686,"end":687,"surface":"書","kind":"work","person_id":null,"work_id":"w-shu-sgz022-reference","status":"contextual_provisional","interpretation_note":"書稱明試以功為尚書經文引稱，書字是書名簡稱非動詞。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0717","start":717,"end":719,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional","interpretation_note":"烏獲舉千鈞是力士典故，與已有烏獲古代力士身份相合，不取張儀篇同人候選另造。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0723","start":723,"end":724,"surface":"良","kind":"person","person_id":"4dv_h7n_m6i","status":"contextual_provisional","interpretation_note":"與樂併稱選驥足，為良/樂兩位識馬者，王良是編輯首選非明載全名；不補姓氏構件，後續可核經注。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0724","start":724,"end":725,"surface":"樂","kind":"person","person_id":"3go_52y_0mp","status":"contextual_provisional","interpretation_note":"良樂之選驥足的樂首選伯樂，與已存相馬伯樂典故同指；不把樂字映到樂詳。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0751","start":751,"end":752,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0784","start":784,"end":786,"surface":"唐虞","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"唐虞為古代聖王/王朝連稱，不能把雙人群體標成一個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0789","start":789,"end":790,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional","interpretation_note":"詔稷勤百穀、注明周棄，疏稷契相輔同古人后稷；不讀作任職官稱或杜氏人物。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0790","start":790,"end":791,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional","interpretation_note":"冥為契六世孫及疏稷契佐唐虞，為商先祖契；不按契約普通詞標。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0797","start":797,"end":798,"surface":"伊","kind":"person","person_id":"itn_zi2_il4","status":"contextual_provisional","interpretation_note":"僅疏中殷周無貴伊呂之輔的伊指商湯輔臣伊尹；後迎客之制兩伊尹另未決，不全局通配。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0798","start":798,"end":799,"surface":"吕","kind":"person","person_id":"1g3_02y_oor","status":"contextual_provisional","interpretation_note":"殷周伊呂之輔的呂是周輔臣呂尚，與齊太公望身份同指；不指本章吕昭或軍將。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0814","start":814,"end":816,"surface":"京房","kind":"person","person_id":"pwh_0lj_8em","status":"contextual_provisional","interpretation_note":"考課綴京房本旨與034杜預考課議京房遺意是精確制度引古橋，不增本源官爵。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0839","start":839,"end":840,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m0896","start":896,"end":897,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1130","start":1130,"end":1132,"surface":"唐虞","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"唐虞為古代聖王/王朝連稱，不能把雙人群體標成一個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1140","start":1140,"end":1141,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional","interpretation_note":"詔稷勤百穀、注明周棄，疏稷契相輔同古人后稷；不讀作任職官稱或杜氏人物。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1141","start":1141,"end":1142,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional","interpretation_note":"冥為契六世孫及疏稷契佐唐虞，為商先祖契；不按契約普通詞標。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1173","start":1173,"end":1175,"surface":"唐虞","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"唐虞為古代聖王/王朝連稱，不能把雙人群體標成一個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1179","start":1179,"end":1180,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional","interpretation_note":"詔稷勤百穀、注明周棄，疏稷契相輔同古人后稷；不讀作任職官稱或杜氏人物。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1180","start":1180,"end":1181,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional","interpretation_note":"冥為契六世孫及疏稷契佐唐虞，為商先祖契；不按契約普通詞標。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1181","start":1181,"end":1182,"surface":"䕫","kind":"person","person_id":"wfn_d71_zaw","status":"contextual_provisional","interpretation_note":"稷契夔龍為唐虞賢臣連稱，五帝本紀夔掌樂傳統人物，排唐陳氏夔同名字。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1182","start":1182,"end":1183,"surface":"龍","kind":"person","person_id":"rjb_0hy_dsi","status":"contextual_provisional","interpretation_note":"與稷契夔並唐虞受任，是五帝本紀納言龍而非甘龍/公孫龍。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1192","start":1192,"end":1193,"surface":"鯀","kind":"person","person_id":"y3u_g30_6et","status":"contextual_provisional","interpretation_note":"唐虞委任/殛鯀放四凶為上古治水鯀典故，源傳說層不當當時事件。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1195","start":1195,"end":1197,"surface":"四凶","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"傳統四凶群體，未在此逐名，非單人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1316","start":1316,"end":1318,"surface":"仲尼","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","interpretation_note":"孔子所謂禹吾無間然、仲尼對顏子及疏中雖仲尼為謀均引同一先秦儒者；不用名或字另造人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1339","start":1339,"end":1340,"surface":"商","kind":"person","person_id":"2wp_usr_ncd","status":"contextual_provisional","interpretation_note":"師商韓而上法術，商是法家商鞅的上下文首選，與秦變法公孫鞅身份同指；不把商朝國號泛標人。"},{"id":"c-sanguozhi-016-duji-dushu:unit029:m1340","start":1340,"end":1341,"surface":"韓","kind":"person","person_id":"n2o_l90_fnm","status":"contextual_provisional","interpretation_note":"法術商韓併稱之韓首選韓非，主本傳法家著述身份；不與韓遂或漢代韓氏牽合。"}],"chapter_id":"c-sanguozhi-016-duji-dushu","book_id":"b-sanguozhi-016","work_id":"w-sanguozhi","source_id":"s-sanguozhi-016-duji-dushu-kr214fcafa"},{"id":"c-shiji-005-qin:p068","text":"武王元年，與魏惠王會臨晉。誅蜀相壯。張儀、魏章皆東出之魏。伐義渠、丹、犁。二年，初置丞相，摢裏疾、甘茂為左右丞相。張儀死於魏。三年，與韓襄王會臨晉外。南公揭卒，摢裏疾相韓。武王謂甘茂曰：「寡人欲容車通三川，窺周室，死不恨矣。」其秋，使甘茂、庶長封伐宜陽。四年，拔宜陽，斬首六萬。涉河，城武遂。魏太子來朝。武王有力好戲，力士任鄙、烏獲、孟說皆至大官。王與孟說舉鼎，絕臏。八月，武王死。族孟說。武王取魏女為后，無子。立異母弟，是為昭襄王。昭襄母楚人，姓羋氏，號宣太后。武王死時，昭襄王為質於燕，燕人送歸，得立。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m068-0000","start":0,"end":2,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0006","start":6,"end":9,"surface":"魏惠王","kind":"person","person_id":"bhp_5xd_88r","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0014","start":14,"end":17,"surface":"蜀相壯","kind":"person","person_id":"kqe_x0t_s25","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0018","start":18,"end":20,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0021","start":21,"end":23,"surface":"魏章","kind":"person","person_id":"2pv_dtb_lrw","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0045","start":45,"end":48,"surface":"摢裏疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0049","start":49,"end":51,"surface":"甘茂","kind":"person","person_id":"8im_m5e_cpy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0057","start":57,"end":59,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0067","start":67,"end":70,"surface":"韓襄王","kind":"person","person_id":"a0a_4q4_biw","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0075","start":75,"end":78,"surface":"南公揭","kind":"person","person_id":"iln_cic_3d5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0080","start":80,"end":83,"surface":"摢裏疾","kind":"person","person_id":"r9n_0vc_ywa","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0086","start":86,"end":88,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0089","start":89,"end":91,"surface":"甘茂","kind":"person","person_id":"8im_m5e_cpy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0117","start":117,"end":119,"surface":"甘茂","kind":"person","person_id":"8im_m5e_cpy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0120","start":120,"end":123,"surface":"庶長封","kind":"person","person_id":"amq_yua_viu","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0146","start":146,"end":149,"surface":"魏太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m068-0152","start":152,"end":154,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0161","start":161,"end":163,"surface":"任鄙","kind":"person","person_id":"zqy_a21_8d3","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0164","start":164,"end":166,"surface":"烏獲","kind":"person","person_id":"rzv_0ll_3ty","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0167","start":167,"end":169,"surface":"孟說","kind":"person","person_id":"uy0_hf3_44x","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0176","start":176,"end":178,"surface":"孟說","kind":"person","person_id":"uy0_hf3_44x","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0187","start":187,"end":189,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0192","start":192,"end":194,"surface":"孟說","kind":"person","person_id":"uy0_hf3_44x","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0195","start":195,"end":197,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0198","start":198,"end":200,"surface":"魏女","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m068-0207","start":207,"end":210,"surface":"異母弟","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional","note":"立異母弟，是為昭襄王直接同指；異母關係仍保留原句。"},{"id":"c-shiji-005-qin:m068-0213","start":213,"end":216,"surface":"昭襄王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0217","start":217,"end":219,"surface":"昭襄","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0224","start":224,"end":226,"surface":"羋氏","kind":"person","person_id":"pvp_ebv_zcb","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0228","start":228,"end":231,"surface":"宣太后","kind":"person","person_id":"pvp_ebv_zcb","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0232","start":232,"end":234,"surface":"武王","kind":"person","person_id":"y97_huh_vuz_AAAAAAAAAAAAABAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m068-0237","start":237,"end":240,"surface":"昭襄王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-079-fancai:p013","text":"秦王屏左右，宮中虛無人。秦王跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」有閒，秦王復跽而請曰：「先生何以幸教寡人？」范睢曰：「唯唯。」若是者三。秦王跽曰：「先生卒不幸教寡人邪？」范睢曰：「非敢然也。臣聞昔者呂尚之遇文王也，身為漁父而釣於渭濱耳。若是者，交疏也。已說而立為太師，載與俱歸者，其言深也。故文王遂收功於呂尚而卒王天下。鄉使文王疏呂尚而不與深言，是周無天子之德，而文武無與成其王業也。今臣羈旅之臣也，交疏於王，而所願陳者皆匡君之事，處人骨肉之閒，願效愚忠而未知王之心也。此所以王三問而不敢對者也。臣非有畏而不敢言也。臣知今日言之於前而明日伏誅於後，然臣不敢避也。大王信行臣之言，死不足以為臣患，亡不足以為臣憂，漆身為厲被髪為狂不足以為臣恥。且以五帝之聖焉而死，三王之仁焉而死，五伯之賢焉而死，烏獲、任鄙之力焉而死，成荊、孟賁、王慶忌、夏育之勇焉而死。死者，人之所必不免也。處必然之勢，可以少有補於秦，此臣之所大願也，臣又何患哉！伍子胥橐載而出昭關，夜行晝伏，至於陵水，無以糊其口，厀行蒲伏，稽首肉袒，鼓腹吹篪，乞食於吳市，卒興吳國，闔閭為伯。使臣得盡謀如伍子胥，加之以幽囚，終身不復見，是臣之說行也，臣又何憂？箕子、接輿漆身為厲，被髪為狂，無益於主。假使臣得同行於箕子，可以有補於所賢之主，是臣之大榮也，臣有何恥？臣之所恐者，獨恐臣死之後，天下見臣之盡忠而身死，因以是杜口裹足，莫肯鄉秦耳。足下上畏太后之嚴，下惑於姦臣之態，居深宮之中，不離阿保之手，終身迷惑，無與昭姦。大者宗廟滅覆，小者身以孤危，此臣之所恐耳。若夫窮辱之事，死亡之患，臣不敢畏也。臣死而秦治，是臣死賢於生。」秦王跽曰：「先生是何言也！夫秦國辟遠，寡人愚不肖，先生乃幸辱至於此，是天以寡人慁先生而存先王之宗廟也。寡人得受命於先生，是天所以幸先王，而不棄其孤也。先生柰何而言若是！事無小大，上及太后，下至大臣，願先生悉以教寡人，無疑寡人也。」范睢拜，秦王亦拜。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-079-fancai:m013-0000","start":0,"end":2,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0012","start":12,"end":14,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0020","start":20,"end":22,"surface":"先生","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0030","start":30,"end":32,"surface":"范睢","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0042","start":42,"end":44,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0051","start":51,"end":53,"surface":"先生","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0061","start":61,"end":63,"surface":"范睢","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0075","start":75,"end":77,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0081","start":81,"end":83,"surface":"先生","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0092","start":92,"end":94,"surface":"范睢","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0102","start":102,"end":103,"surface":"臣","kind":"person","person_id":"zus_do8_z1q","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0106","start":106,"end":108,"surface":"呂尚","kind":"person","person_id":"1g3_02y_oor","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0110","start":110,"end":112,"surface":"文王","kind":"person","person_id":"y4i_pjk_4gn_A","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0153","start":153,"end":155,"surface":"文王","kind":"person","person_id":"y4i_pjk_4gn_A","status":"contextual_provisional"},{"id":"c-shiji-079-fancai:m013-0159",