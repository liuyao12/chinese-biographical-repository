tart":2,"end":4,"surface":"子玉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1956641,"first_line":322,"last_line":322,"line_start":0,"line_end":4,"raw_start":11269,"raw_end":11273,"raw_character_offsets":[11269,11270,11271,11272],"projection_sha256":"cbb878437998c4a4318d30a322965b22d9f338579bb23d5e9f575fe0a50f55f0","source_layer":"received_biography"},"chapter_id":"c-houhanshu-052-cuiyuan-wangjian","book_id":"b-houhanshu-052","work_id":"w-houhanshu","source_id":"s-houhanshu-052-cuiyuan-wangjian-ws1956641"},{"id":"c-nanshi-022-wangjian:p001","text":"儉字仲寶，生而僧綽遇害，為叔父僧虔所養。數歲，襲爵豫甯縣侯。拜受茅土，流涕嗚咽。幼篤學，手不釋卷。賓客或相稱美，僧虔曰：「我不患此兒無名，政恐名太盛耳。」乃手書崔子玉座右銘以貽之。丹陽尹袁粲聞其名，及見之曰：「宰相之門也。栝柏豫章雖小，已有棟樑氣矣，終當任人家國事。」言之宋明帝，選尚陽羨公主，拜駙馬都尉。帝以儉嫡母武康公主同太初巫蠱事，不可以為婦姑，欲開塚離葬。儉因人自陳，密以死請，故事不行。","mentions":[{"id":"c-nanshi-022-wangjian:p001:m0000","person_id":"7r6_k52_qji_ABAAAAEAA","start":0,"end":1,"surface":"儉","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p001:m0002","person_id":"7r6_k52_qji_ABAAAAEAA","start":2,"end":4,"surface":"仲寶","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p001:m0007","person_id":"7r6_k52_qji_ABAAAAEA","start":7,"end":9,"surface":"僧綽","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p001:m0015","person_id":"7r6_k52_qji_ABAAAAEB","start":15,"end":17,"surface":"僧虔","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p001:m0056","person_id":"7r6_k52_qji_ABAAAAEB","start":56,"end":58,"surface":"僧虔","kind":"person","status":"contextual_provisional","interpretation_note":"依該段姓名及上下文。"},{"id":"c-nanshi-022-wangjian:p001:m0080","person_id":"yfm_7fm_2ei_AAAAA","start":80,"end":83,"surface":"崔子玉","kind":