:"contextual_provisional"},{"id":"c-shiji-121-rulin:m009-0036","start":36,"end":38,"surface":"魯賜","kind":"person","person_id":"6dc_9fa_jc0","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m009-0046","start":46,"end":48,"surface":"繆生","kind":"person","person_id":"1sf_7eh_sup","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m009-0054","start":54,"end":56,"surface":"徐偃","kind":"person","person_id":"cu1_f6r_hy2","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m009-0064","start":64,"end":68,"surface":"闕門慶忌","kind":"person","person_id":"yep_hlx_57i","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m009-0088","start":88,"end":92,"surface":"學官弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m009-0120","start":120,"end":122,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p015","text":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m015-0000","start":0,"end":2,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0005","start":5,"end":7,"surface":"張生","kind":"person","person_id":"aqd_hcr_hzk","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0008","start":8,"end":11,"surface":"歐陽生","kind":"person","person_id":"47o_xhl_8u1","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m015-0012","start":12,"end":15,"surface":"歐陽生","kind":"person","person_id":"47o_xhl_8u1","status":"contextual_provisional"},{"i