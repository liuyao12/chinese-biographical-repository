{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002405","identity_policy":"contextual_provisional","person_ids":["cbr-p002405"],"persons":[{"id":"cbr-p002405","label":"王紲（趙世家使者候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王紲","mention_ids":["c-shiji-043-zhao:m069-0001"]},{"surface":"紲","mention_ids":["c-shiji-043-zhao:m069-0205"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m069-0001","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p069","quote":"王紲"},{"mention_id":"c-shiji-043-zhao:m069-0205","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p069","quote":"紲"}]}],"source_mention_summary":[{"source_id":"s-shiji-043-zhao","work_id":"w-shiji","book_id":"b-shiji-043","chapter_id":"c-shiji-043-zhao","mention_count":2,"mention_ids":["c-shiji-043-zhao:m069-0001","c-shiji-043-zhao:m069-0205"],"paragraph_ids":["c-shiji-043-zhao:p069"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-043-zhao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-043-zhao:m069-0001","start":1,"end":3,"surface":"王紲","kind":"person","person_id":"cbr-p002405","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p069","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m069-0205","start":205,"end":206,"surface":"紲","kind":"person","person_id":"cbr-p002405","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p069","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-176","person_id":"cbr-p002405","surfaces":["王紲","紲"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p069","quote":"使王紲公子成曰：「寡人胡服，將以朝也，亦欲叔服之。家聽於親而國聽於君，古今之公行也。子不反親，臣不逆君，兄弟之通義也。今寡人作教易服而叔不服，吾恐天下議之也。制國有常，利民爲本；從政有經，令行爲上。明德先論於賤，而行政先信於貴。今胡服之意，非以養欲而樂志也；事有所止而功有所出，事成功立，然後善也。今寡人恐叔之逆從政之經，以輔叔之議。且寡人聞之，事利國者行無邪，因貴戚者名不累，故願慕公叔之義，以成胡服之功。使紲謁之叔，請服焉。」公子成再拜稽首曰：「臣固聞王之胡服也。臣不佞，寢疾，未能趨走以滋進也。王命之，臣敢對，因竭其愚忠。曰：臣聞中國者，蓋聰明徇智之所居也，萬物財用之所聚也，賢聖之所教也，仁義之所施也，詩書禮樂之所用也，異敏技能之所試也，遠方之所觀赴也，蠻夷之所義行也。今王捨此而襲遠方之服，變古之教，易古人道，逆人之心，而怫學者，離中國，故臣願王圖之也。」使者以報。王曰：「吾固聞叔之疾也，我將自往請之。」"}],"rationale":"限本篇明示姓名、是為與連續事件；太戊午／大戊午暫接但字形待底本核查。娃嬴／孟姚／惠后按本段明示暫接，不與先前夢辭孟姚按同名合併；王紲與較早公子紲分候選。君王職稱按各國上下文辨別，不全域匹配。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-043-zhao:p069","text":"使王紲公子成曰：「寡人胡服，將以朝也，亦欲叔服之。家聽於親而國聽於君，古今之公行也。子不反親，臣不逆君，兄弟之通義也。今寡人作教易服而叔不服，吾恐天下議之也。制國有常，利民爲本；從政有經，令行爲上。明德先論於賤，而行政先信於貴。今胡服之意，非以養欲而樂志也；事有所止而功有所出，事成功立，然後善也。今寡人恐叔之逆從政之經，以輔叔之議。且寡人聞之，事利國者行無邪，因貴戚者名不累，故願慕公叔之義，以成胡服之功。使紲謁之叔，請服焉。」公子成再拜稽首曰：「臣固聞王之胡服也。臣不佞，寢疾，未能趨走以滋進也。王命之，臣敢對，因竭其愚忠。曰：臣聞中國者，蓋聰明徇智之所居也，萬物財用之所聚也，賢聖之所教也，仁義之所施也，詩書禮樂之所用也，異敏技能之所試也，遠方之所觀赴也，蠻夷之所義行也。今王捨此而襲遠方之服，變古之教，易古人道，逆人之心，而怫學者，離中國，故臣願王圖之也。」使者以報。王曰：「吾固聞叔之疾也，我將自往請之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m069-0001","start":1,"end":3,"surface":"王紲","kind":"person","person_id":"cbr-p002405","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m069-0003","start":3,"end":6,"surface":"公子成","kind":"person","person_id":"cbr-p002404","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m069-0021","start":21,"end":22,"surface":"叔","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、夢中女子或待核官稱／親稱保留；不從同名、國號與未名先王補個人。"},{"id":"c-shiji-043-zhao:m069-0067","start":67,"end":68,"surface":"叔","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、夢中女子或待核官稱／親稱保留；不從同名、國號與未名先王補個人。"},{"id":"c-shiji-043-zhao:m069-0153","start":153,"end":154,"surface":"叔","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、夢中女子或待核官稱／親稱保留；不從同名、國號與未名先王補個人。"},{"id":"c-shiji-043-zhao:m069-0163","start":163,"end":1