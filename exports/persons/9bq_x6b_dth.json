"person_id":"9bq_x6b_dth","source_quote":"　　又諸暨東洿里屠氏女，父失明，母痼疾，親戚相弃，鄉里不容。女移父母遠住苧羅，晝樵采，夜紡績，以供養。父母俱卒，親營殯葬，負土成墳。忽聞空中有聲云：「汝至性可重，山神欲相驅使。汝可爲人治病，必得大富。」女謂是𩲓魅，弗敢從，遂得病。積時，隣舍人有中溪蜮毒者，女試治之，自覺病便差，遂以巫道爲人治疾，無不愈。家產日益，鄉里多欲娶之，以無兄弟，誓守墳墓不肯嫁，爲山賊劫殺。縣令于琳之具言郡，太守王敬則不以聞。","reading":"屠氏女奉親、營葬、治疾及被劫殺的敘次連貫。縣令報郡，太守未上聞。","note":"屠氏女奉親、營葬、治疾及被劫殺的敘次連貫。縣令報郡，太守未上聞。","paragraph_id":"c-nanqishu-055-filial-complete:p018","start_codepoint":0,"end_codepoint":201,"human_reviewed":false,"chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi055-tushi-death","person_id":"9bq_x6b_dth","event_type":"death","source_term":"劫殺","source_anchor":{"paragraph_id":"c-nanqishu-055-filial-complete:p018","start":180,"end":182,"surface":"劫殺"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-055","chapter_id":"c-nanqishu-055-filial-complete","source_id":"s-nanqishu-055-filial-complete-ws1545598","paragraph_id":"c-nanqishu-055-filial-complete:p018","quote":"　　又諸暨東洿里屠氏女，父失明，母痼疾，親戚相弃，鄉里不容。女移父母遠住苧羅，晝樵采，夜紡績，以供養。父母俱卒，親營殯葬，負土成墳。忽聞空中有聲云：「汝至性可重，山神欲相驅使。汝可爲人治病，必得大富。」女謂是𩲓魅，弗敢從，遂得病。積時，隣舍人有中溪蜮毒者，女試治之，自覺病便差，遂以巫道爲人治疾，無不愈。家產日益，鄉里多欲娶之，以無兄弟，誓守墳墓不肯嫁，爲山賊劫殺。縣令于琳之具言郡，太守王敬則不以聞。","person_mention_id":"c-nanqishu-055-filial-complete:p018:m0008"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-055-filial-complete:p018:m0008","start":8,"end":11,"surface":"屠氏女","kind":"person","person_id":"9bq_x6b_dth","status":"contextual_provisional","paragraph_id":"c-nanqishu-055-filial-complete:p018","chapter_id":"c-nanqishu-055-filial-complete"}],"relations":[],"title_holdings":[],"address_assertions":[]