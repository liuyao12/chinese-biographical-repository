ian-ws2478204","chapter_id":"c-nanshi-023-wangxi-qian","paragraph_id":"c-nanshi-023-wangxi-qian:p001","quote":"銓弟錫字公嘏，幼而警悟，與兄弟受業，至應休散，輒獨留不起，精力不倦，致損右目。十二為國子生，十四舉清茂，除秘書郎，再遷太子洗馬。時昭明太子尚幼，武帝敕錫與秘書郎張纘使入宮，不限日數。與太子游狎，情兼師友。又敕陸倕、張率、謝舉、王規、王筠、劉孝綽、到洽、張緬為學士，十人盡一時之選。錫以戚屬，封永安侯。","person_mention_id":"c-nanshi-023-wangxi-qian:p001:m0126"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangxi-qian-ws2478204","chapter_id":"c-nanshi-023-wangxi-qian","paragraph_id":"c-nanshi-023-wangxi-qian:p001","quote":"銓弟錫字公嘏，幼而警悟，與兄弟受業，至應休散，輒獨留不起，精力不倦，致損右目。十二為國子生，十四舉清茂，除秘書郎，再遷太子洗馬。時昭明太子尚幼，武帝敕錫與秘書郎張纘使入宮，不限日數。與太子游狎，情兼師友。又敕陸倕、張率、謝舉、王規、王筠、劉孝綽、到洽、張緬為學士，十人盡一時之選。錫以戚屬，封永安侯。","person_mention_id":"c-nanshi-023-wangxi-qian:p001:m0126"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-034-wanggui-zhangmian:p001","text":"張緬字元長，車騎將軍弘策子也。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":11,"last_line":11,"raw_start":177,"raw_end":192,"raw_character_offsets":[177,178,179,180,181,182,183,184,185,186,187,188,189,190,191],"revision_id":1511900,"source_layer":"received_biography","editorial_excerpt_boundary":true,"projection_sha256":"66f49f702574ca06aee818e351eca6865c9074479b501f8bba004dcb82abc886"},"mentions":[{"id":"c-liangshu-034-wanggui-zhangmian:p001:m0000","start":0,"end":2,"surface":"張緬","person_id":"0lf_ggf_5xo_A","kind":"person","status":"contextual_provisional","interpretation_note":"本段有明名或字。"},{"id":"c-liangshu-034-wanggui-zhangmian:p001:m0003","start":3,"end":5,"surface":"元長","person_id":"0lf_ggf_5xo_A","kind":"person","status":"contextual_provisional","interpretation_note":"本段有明名或字。"},{"id":"c-liangshu-034-wanggui-zhangmian:p001:m0010","start":10,"end":12,"surface":"弘策","person_id":"0lf_ggf_5xo","kind":"person","status":"contextual_provisional","interpretation_note":"本段有明名或字。"}],"chapter_id":"c-liangshu-034-wanggui-zhangmian","book_id":"b-liangshu-034","work_id":"w-liangshu","source_id":"s-liangshu-034-wanggui-zhangmian-ws1511900"},{"id":"c-nanshi-022-wanggui:p002","text":"天監十二年，改造太極殿畢，規獻新殿賦，其辭甚工。後為晉安王綱雲麾諮議參軍，久之，為新安太守。父憂去職，服闋，襲封南昌縣侯。除中書黃門侍郎，敕與陳郡殷芸、琅邪王錫、范陽張緬同侍東宮，俱為昭明太子所禮。湘東王繹時為丹陽尹，與朝士宴集，屬規為酒令。規從容曰：「江左以來，未有茲舉。」特進蕭琛、金紫光祿大夫傅昭在坐，並謂為知言。朱異嘗因酒卿規，規責以無禮。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":13,"end":14,"surface":"規","id":"c-nanshi-022-wanggui:p002:m0013","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作規。"},{"start":29,"end":30,"surface":"綱","id":"c-nanshi-022-wanggui:p002:m0029","person_id":"rtd_v0b_nyn","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作綱。"},{"start":73,"end":75,"surface":"殷芸","id":"c-nanshi-022-wanggui:p002:m0073","person_id":"8d4_fth_d4l","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作芸。"},{"start":78,"end":80,"surface":"王錫","id":"c-nanshi-022-wanggui:p002:m0078","person_id":"q7m_r8k_2vn_ABAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作錫。"},{"start":83,"end":85,"surface":"張緬","id":"c-nanshi-022-wanggui:p002:m0083","person_id":"0lf_ggf_5xo_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作緬。"},{"start":102,"end":103,"surface":"繹","id":"c-nanshi-022-wanggui:p002:m0102","person_id":"rvc_bqx_v5w","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作繹。"},{"start":110,"end":112,"surface":"朝士","id":"c-nanshi-022-wanggui:p002:u0110","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"宴集群體未具名