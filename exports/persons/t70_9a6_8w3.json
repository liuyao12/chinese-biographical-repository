ince-yue:p002:m0118","paragraph_id":"c-jinshu-059-prince-yue:p002","chapter_id":"c-jinshu-059-prince-yue","quote":"成都王穎"},{"mention_id":"c-jinshu-059-prince-yue:p002:m0177","paragraph_id":"c-jinshu-059-prince-yue:p002","chapter_id":"c-jinshu-059-prince-yue","quote":"穎"}],"review":"ai_provisional","identity_note":"司馬穎〔成都王〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-059-prince-ying-ws2650517","work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-prince-ying","raw_mention_count":2,"mention_ids":["c-jinshu-059-prince-ying:p008:m0152","c-jinshu-059-prince-ying:p008:m0185"],"paragraph_ids":["c-jinshu-059-prince-ying:p008"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-059-prince-ying:p008:m0152","mention_ids":["c-jinshu-059-prince-ying:p008:m0152"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-059-prince-ying:p008:m0185","mention_ids":["c-jinshu-059-prince-ying:p008:m0185"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-059-prince-ying-ws2650517"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin059-volume-kuo-father","subject_person_id":"t70_9a6_8w3","object_person_id":"x4m_ygm_1d3","predicate":"father","qualifiers":{"source_term":"二子廬江王普、中都王廓"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-prince-ying","source_id":"s-jinshu-059-prince-ying-ws2650517","paragraph_id":"c-jinshu-059-prince-ying:p008","quote":"穎既廢，河北思之。鄴中故將公師籓、汲桑等起兵以迎穎，眾情翕然。顒復拜穎鎮軍大將軍、都督河北諸軍事，給兵千人，鎮鄴。穎至洛，而東海王越率眾迎大駕，所在鋒起。穎以北方盛強，懼不可進，自洛陽奔關中。值大駕還洛，穎自華陰趨武關，出新野。帝詔鎮南將軍劉弘、南中郎將劉陶收捕穎，於是棄母妻，單車與二子廬江王普、中都王廓渡河赴朝歌，收合故將士數百人，欲就公師籓。頓丘太守馮嵩執穎及普、廓送鄴，范陽王虓幽之，而無他意。屬虓暴薨，虓長史劉輿見穎為鄴都所服，慮為後患，秘不發喪，偽令人為臺使，稱詔夜賜穎死。穎謂守者田徽曰：「范陽王亡乎？」徽曰：「不知。」穎曰：「卿年幾？」徽曰：「五十。」穎曰：「知天命不？」徽曰：「不知。」穎曰：「我死之後，天下安乎不安乎？我自放逐，於今三年，身體手足不見洗沐，取數斗湯來！」其二子號泣，穎敕人將去。乃散發東首臥，命徽縊之，時年二十八。二子亦死。鄴中哀之。","subject_person_mention_id":"c-jinshu-059-prince-ying:p008:m0152","object_person_mention_id":"c-jinshu-059-prince-ying:p008:m0000"}],"status":"source_attested","interpretation_note":"隨父渡河，父死後二子亦死。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-ying:p008:m0152","surface":"廓","start":152,"end":153,"person_id":"t70_9a6_8w3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-ying:p008","chapter_id":"c-jinshu-059-prince-ying"},{"id":"c-jinshu-059-prince-ying:p008:m0185","surface":"廓","start":185,"end":186,"person_id":"t70_9a6_8w3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-ying:p008","chapter_id":"c-jinshu-059-prince-ying"}],"relations":[{"id":"a-jin059-volume-kuo-father","subject_person_id":"t70_9a6_8w3","object_person_id":"x4m_ygm_1d3","predicate":"father","qualifiers":{"source_term":"二子廬江王普、中都王廓"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-prince-ying","source_id":"s-jinshu-059-prince-ying-ws2650517","paragraph_id":"c-jinshu-059-prince-ying:p008","quote":"穎既廢，河北思之。鄴中故將公師籓、汲桑等起兵以迎穎，眾情翕然。顒復拜穎鎮軍大將軍、都督河北諸軍事，給兵千人，鎮鄴。穎至洛，而東海王越率眾迎大駕，所在鋒起。穎以北方盛強，懼不可進，自洛陽奔關中。值大駕還洛，穎自華陰趨武關，出新野。帝詔鎮南將軍劉弘、南中郎將劉陶收捕穎，於是棄母妻，單車與二子廬江王普、中都王廓渡河赴朝歌，收合故將士數