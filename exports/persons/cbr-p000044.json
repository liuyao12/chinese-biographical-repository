0,"surface":"舜","kind":"person","person_id":"cbr-p000030","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0652","start":652,"end":654,"surface":"三苗","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"}],"chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-001-wudi:p025","text":"此二十二人咸成厥功：皋陶爲大理，平，民各伏得其實；伯夷主禮，上下咸讓；垂主工師，百工致功；益主虞，山澤辟；棄主稷，百穀時茂；契主司徒，百姓親和；龍主賓客，遠人至；十二牧行而九州莫敢辟違；唯禹之功爲大，披九山，通九澤，決九河，定九州，各以其職來貢，不失厥宜。方五千里，至于荒服。南撫交阯、北發，西戎、析枝、渠廋、氐、羌，北山戎、發、息慎，東長、鳥夷，四海之內咸戴帝舜之功。於是禹乃興九招之樂，致異物，鳳皇來翔。天下明德皆自虞帝始。","mentions":[{"id":"c-shiji-001-wudi:m025-0010","start":10,"end":12,"surface":"皋陶","kind":"person","person_id":"cbr-p000044","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0025","start":25,"end":27,"surface":"伯夷","kind":"person","person_id":"cbr-p000047","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0035","start":35,"end":36,"surface":"垂","kind":"person","person_id":"cbr-p000050","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0045","start":45,"end":46,"surface":"益","kind":"person","person_id":"cbr-p000051","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0053","start":53,"end":54,"surface":"棄","kind":"person","person_id":"cbr-p000046","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0055","start":55,"end":56,"surface":"稷","kind":"person","person_id":"cbr-p000046","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0062","start":62,"end":63,"surface":"契","kind":"person","person_id":"cbr-p000045","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0072","start":72,"end":73,"surface":"龍","kind":"person","person_id":"cbr-p000049","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0081","start":81,"end":84,"surface":"十二牧","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m025-0094","start":94,"end":95,"surface":"禹","kind":"person","person_id":"cbr-p000043","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0180","start":180,"end":182,"surface":"帝舜","kind":"person","person_id":"cbr-p000030","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0187","start":187,"end":188,"surface":"禹","kind":"person","person_id":"cbr-p000043","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0210","start":210,"end":212,"surface":"虞帝","kind":"person","person_id":"cbr-p000030","status":"source_identified"}],"chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-002-xia:p003","text":"堯崩，帝舜問四嶽曰：「有能成美堯之事者使居官？」皆曰：「伯禹爲司空，可成美堯之功。」舜曰：「嗟，然！」命禹：「女平水土，維是勉之。」禹拜稽首，讓於契、后稷、皋陶。舜曰：「女其往視爾事矣。」","mentions":[{"id":"c-shiji-002-xia:m003-0000","start":0,"end":1,"surface":"堯","kind":"person","person_id":"cbr-p000020","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0003","start":3,"end":5,"surface":"帝舜","kind":"person","person_id":"cbr-p000030","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0006","start":6,"end":8,"surface":"四嶽","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、官職或未定指代；不推造個別姓名。"},{"id":"c-shiji-002-xia:m003-0015","start":15,"end":16,"surface":"堯","kind":"person","person_id":"cbr-p000020","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0028","start":28,"end":30,"surface":"伯禹","kind":"person","person_id":"cbr-p000043","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0037","start":37,"end":38,"surface":"堯","kind":"person","person_id":"cbr-p000020","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0042","start":42,"end":43,"surface":"舜","kind":"person","person_id":"cbr-p000030","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0052","start":52,"end":53,"surface":"禹","kind":"person","person_id":"cbr-p000043","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0066","start":66,"end":67,"surface":"禹","kind":"person","person_id":"cbr-p000043","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0073","start":73,"end":74,"surface":"契","kind":"person","person_id":"cbr-p000045","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0075","start":75,"end":77,"surface":"后稷","kind":"person","person_id":"cbr-p000046","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0078","start":78,"end":80,"surface":"皋陶","kind":"person","person_id":"cbr-p000044","status":"source_identified"},{"id":"c-shiji-002-xia:m003-0081","start":81,"end":82,"surface":"舜","kind":"person","person_id":"cbr-p000030","status":"source_identified"}],"chapter_id":"c-shiji-002-xia","book_id":"b-shiji-002","work_id":"w-shiji","source_id":"s-shiji-002-xia"},{"id":"c-shiji-002-xia:p020","text":"皋陶作士以理民。帝舜朝，禹、伯夷、皋陶相與語帝前。皋陶述其謀曰：「信其道德，謀明輔和。」禹曰：「然，如何？」皋陶曰：「於！慎其身脩，思長，敦序九族，衆明高翼，近可遠在已。」禹拜美言，曰：「然。」皋陶曰：「於！在知人，在安民。」禹曰：「吁！皆若是，惟帝其難之。知人則智，能官人；能安民則惠，黎民懷之。能知能惠，何憂乎驩兜，何遷乎有苗，何畏乎巧言善色佞人？」皋陶曰：「然，於！亦行有九德，亦言其有德。」乃言曰：「始事事，寬而栗，柔而立，愿而共，治而敬，擾而毅，直而溫，簡而廉，剛而實，彊而義，章其有常，吉哉。日宣三德，蚤夜翊明有家。日嚴振敬六德，亮采有國。翕受普施，九德咸事，俊乂在官，百吏肅謹。毋教邪淫奇謀。非其人居其官，是謂亂天事。天討有辠，五刑五用哉。吾言厎可行乎？」禹曰：「女言致可績行。」皋陶曰：「余未有知，思贊道哉。」","mentions":[{"id":"c-shiji-002-xia:m020-0000","start":0,"end":2,"surface":"皋陶","kind":"person","person_id":"cbr-p000044","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0008","start":8,"end":10,"surface":"帝舜","kind":"person","person_id":"cbr-p000030","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0012","start":12,"end":13,"surface":"禹","kind":"person","person_id":"cbr-p000043","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0014","start":14,"end":16,"surface":"伯夷","kind":"person","person_id":"cbr-p000047","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0017","start":17,"end":19,"surface":"皋陶","kind":"person","person_id":"cbr-p000044","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0022","start":22,"end":23,"surface":"帝","kind":"person","person_id":"cbr-p000030","status":"contextual_provisional","interpretation_note":"