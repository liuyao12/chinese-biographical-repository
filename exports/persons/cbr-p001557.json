0027","start":27,"end":30,"surface":"太子伋","kind":"person","person_id":"cbr-p001553","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m014-0039","start":39,"end":41,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m014-0043","start":43,"end":46,"surface":"太子伋","kind":"person","person_id":"cbr-p001553","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m014-0048","start":48,"end":50,"surface":"黔牟","kind":"person","person_id":"cbr-p001559","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m014-0053","start":53,"end":55,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p015","text":"衞君黔牟立八年，齊襄公率諸侯奉王命共伐衞，納衞惠公，誅左右公子。衞君黔牟奔于周，惠公復立。惠公立三年出亡，亡八年復入，與前通年凡十三年矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m015-0000","start":0,"end":4,"surface":"衞君黔牟","kind":"person","person_id":"cbr-p001559","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m015-0008","start":8,"end":11,"surface":"齊襄公","kind":"person","person_id":"cbr-p000363","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m015-0012","start":12,"end":14,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m015-0015","start":15,"end":17,"surface":"王命","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m015-0022","start":22,"end":25,"surface":"衞惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m015-0027","start":27,"end":31,"surface":"左右公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m015-0032","start":32,"end":36,"surface":"衞君黔牟","kind":"person","person_id":"cbr-p001559","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m015-0040","start":40,"end":42,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m015-0045","start":45,"end":47,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p016","text":"二十五年，惠公怨周之容舍黔牟，與燕伐周。周惠王奔温，衞、燕立惠王弟穨爲王。二十九年，鄭復納惠王。三十一年，惠公卒，子懿公赤立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m016-0005","start":5,"end":7,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m016-0012","start":12,"end":14,"surface":"黔牟","kind":"person","person_id":"cbr-p001559","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m016-0020","start":20,"end":23,"surface":"周惠王","kind":"person","person_id":"cbr-p000236","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m016-0030","start":30,"end":32,"surface":"惠王","kind":"person","person_id":"cbr-p000236","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m016-0033","start":33,"end":34,"surface":"穨","kind":"person","person_id":"cbr-p000238","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m016-0045","start":45,"end":47,"surface":"惠王","kind":"person","person_id":"cbr-p000236","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m016-0053","start":53,"end":55,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m016-0058","start":58,"end":61,"surface":"懿公赤","kind":"person","person_id":"cbr-p001560","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p018","text":"懿公之立也，百姓大臣皆不服。自懿公父惠公朔之讒殺太子伋代立至於懿公，常欲敗之，卒滅惠公之後而更立黔牟之弟昭伯頑之子申爲君，是爲戴公。戴公申元年卒。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m018-0000","start":0,"end":2,"surface":"懿公","kind":"person","person_id":"cbr-p001560","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0015","start":15,"end":17,"surface":"懿公","kind":"person","person_id":"cbr-p001560","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0018","start":18,"end":21,"surface":"惠公朔","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0024","start":24,"end":27,"surface":"太子伋","kind":"person","person_id":"cbr-p001553","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0031","start":31,"end":33,"surface":"懿公","kind":"person","person_id":"cbr-p001560","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0041","start":41,"end":43,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0048","start":48,"end":50,"surface":"黔牟","kind":"person","person_id":"cbr-p001559","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0052","start":52,"end":55,"surface":"昭伯頑","kind":"person","person_id":"cbr-p001561","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0057","start":57,"end":58,"surface":"申","kind":"person","person_id":"cbr-p001562","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0063","start":63,"end":65,"surface":"戴公","kind":"person","person_id":"cbr-p001562","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m018-0066","start":66,"end":69,"surface":"戴公申","kind":"person","person_id":"cbr-p001562","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p020","text":"初，翟殺懿公也，衞人憐之，思復立宣公前死太子伋之後，伋子又死，而代伋死者子壽又無子。太子伋同母弟二人：其一曰黔牟，黔牟嘗代惠公爲君，八年復去；其二曰昭伯。昭伯、黔牟皆已前死，故立昭伯子申爲戴公。戴公卒，復立其弟燬爲文公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-037-wei:m020-0004","start":4,"end":6,"surface":"懿公","kind":"person","person_id":"cbr-p001560","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0016","start":16,"end":18,"surface":"宣公","kind":"person","person_id":"cbr-p001549","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0020","start":20,"end":23,"surface":"太子伋","kind":"person","person_id":"cbr-p001553","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0026","start":26,"end":27,"surface":"伋","kind":"person","person_id":"cbr-p001553","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0033","start":33,"end":34,"surface":"伋","kind":"person","person_id":"cbr-p001553","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0036","start":36,"end":38,"surface":"子壽","kind":"person","person_id":"cbr-p001556","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0042","start":42,"end":45,"surface":"太子伋","kind":"person","person_id":"cbr-p001553","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0054","start":54,"end":56,"surface":"黔牟","kind":"person","person_id":"cbr-p001559","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0057","start":57,"end":59,"surface":"黔牟","kind":"person","person_id":"cbr-p001559","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0061","start":61,"end":63,"surface":"惠公","kind":"person","person_id":"cbr-p001557","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0074","start":74,"end":76,"surface":"昭伯","kind":"person","person_id":"cbr-p001561","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0077","start":77,"end":79,"surface":"昭伯","kind":"person","person_id":"cbr-p001561","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0080","start":80,"end":82,"surface":"黔牟","kind":"person","person_id":"cbr-p001559","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0089","start":89,"end":91,"surface":"昭伯","kind":"person","person_id":"cbr-p001561","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0092","start":92,"end":93,"surface":"申","kind":"person","person_id":"cbr-p001562","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0094","start":94,"end":96,"surface":"戴公","kind":"person","person_id":"cbr-p001562","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0097","start":97,"end":99,"surface":"戴公","kind":"person","person_id":"cbr-p001562","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0105","start":105,"end":106,"surface":"燬","kind":"person","person_id":"cbr-p001563","status":"contextual_provisional"},{"id":"c-shiji-037-wei:m020-0107","start":107,"end":109,"surface":"文公","kind":"person","person_id":"cbr-p001563","status":"contextual_provisional"}],"chapter_id":"c-shiji-037-wei","book_id":"b-shiji-037","work_id":"w-shiji","source_id":"s-shiji-037-wei"},{"id":"c-shiji-037-wei:p054","text":"司寇受封，梓材有作。成錫厥器，夷加其爵。暨武能脩，從文始約。詩美歸燕，傳矜石碏。皮冠射鴻，乘軒使穀。宣縱淫嬖，釁生伋、朔。蒯聵得罪，出公行惡。衞祚日衰，失於君角。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-037-wei:m054-0010","start":10,"end":12,"surface":"成錫","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m054-0015","start":15,"end":17,"surface":"夷加","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m054-0020","start":20,"end":22,"surface":"暨武","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m054-0025","start":25,"end":27,"surface":"從文","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、並稱、匿名者、校勘或尚未定指代；不補姓名、親屬、闕代或成員。"},{"id":"c-shiji-037-wei:m054-0037","start":37,"end":39,"surface":"石