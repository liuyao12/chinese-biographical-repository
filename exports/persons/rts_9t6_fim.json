ank","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-079","chapter_id":"c-jinshu-079-xielang-family","source_id":"s-jinshu-079-xielang-family","paragraph_id":"c-jinshu-079-xielang-family:p004","quote":"子重，字景重，明秀有才名，為會稽王道子驃騎長史。嘗因侍坐，于時月夜明淨，道子歎以為佳。重率爾曰：「意謂乃不如微雲點綴。」道子因戲重曰：「卿居心不淨，乃復強欲滓穢太清邪！」","person_mention_id":"c-jinshu-079-xielang-family:p004:m0014"}],"attestations":[{"id":"th-jinshu079-xie-004:a001","paragraph_id":"c-jinshu-079-xielang-family:p004","start":14,"end":17,"surface":"會稽王","person_mention_id":"c-jinshu-079-xielang-family:p004:m0014","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本傳用稱，授任與起訖年份未知。朗終於東陽太守作終官，不據此補卒日、死地或所有官職的終年；驃騎長史屬謝重，會稽王屬道子。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu079-cross-005","person_id":"rts_9t6_fim","surfaces":["會稽王道子","道子"],"scope":"cross_chapter","chapter_ids":["c-jinshu-079-xielang-family","c-songshu-044-xiehui"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-079-xielang-family:p004:m0014","c-jinshu-079-xielang-family:p004:m0036","c-jinshu-079-xielang-family:p004:m0060","c-songshu-044-xiehui:p001:m0024"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-079","chapter_id":"c-jinshu-079-xielang-family","source_id":"s-jinshu-079-xielang-family","paragraph_id":"c-jinshu-079-xielang-family:p004","quote":"子重，字景重，明秀有才名，為會稽王道子驃騎長史。嘗因侍坐，于時月夜明淨，道子歎以為佳。重率爾曰：「意謂乃不如微雲點綴。」道子因戲重曰：「卿居心不淨，乃復強欲滓穢太清邪！」"},{"work_id":"w-songshu","book_id":"b-songshu-044","chapter_id":"c-songshu-044-xiehui","source_id":"s-songshu-044-xiehui","paragraph_id":"c-songshu-044-xiehui:p001","quote":"謝晦字宣明，陳郡陽夏人也。祖朗，東陽太守。父重，會稽王道子驃騎長史。兄絢，高祖鎮軍長史，蚤卒。"}],"rationale":"晉書謝重在會稽王道子府任驃騎長史，宋書謝晦父重所任同府同職，接已有具名王號人物，不新造司馬道子重複身份。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-079-xielang-family:p004","text":"子重，字景重，明秀有才名，為會稽王道子驃騎長史。嘗因侍坐，于時月夜明淨，道子歎以為佳。重率爾曰：「意謂乃不如微雲點綴。」道子因戲重曰：「卿居心不淨，乃復強欲滓穢太清邪！」","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-079-xielang-family:p004:m0001","start":1,"end":2,"surface":"重","kind":"person","person_id":"aa6_83c_juy_AAA","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p004:m0004","start":4,"end":6,"surface":"景重","kind":"person","person_id":"aa6_83c_juy_AAA","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p004:m0014","start":14,"end":19,"surface":"會稽王道子","kind":"person","person_id":"rts_9t6_fim","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p004:m0036","start":36,"end":38,"surface":"道子","kind":"person","person_id":"rts_9t6_fim","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p004:m0043","start":43,"end":44,"surface":"重","kind":"person","person_id":"aa6_83c_juy_AAA","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p004:m0060","start":60,"end":62,"surface":"道子","kind":"person","person_id":"rts_9t6_fim","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p004:m0064","start":64,"end":65,"surface":"重","kind":"person","person_id":"aa6_83c_juy_AAA","status":"contextual_provisional"},{"id":"c-jinshu-079-xielang-family:p004:m0068","start":68,"end":69,"surface":"卿","kind":"person","person_id":"aa6_83c_juy_AAA","status":"contextual_provisional"}],"source_position":{"first_line":129,"last_line":130,"revision_id":2645985,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-079-xielang-family","book_id":"b-jinshu-079","work_id":"w-jinshu","source_id":"s-jinshu-079-xielang-family"},{"id":"c-songshu-044-xiehui:p001","text":"謝晦字宣明，陳郡陽夏人也。祖朗，東陽太守。父重，會稽王道子驃騎長史。兄絢，高祖鎮軍長史，蚤卒。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-044-xiehui:p001:m0000","start":0,"end":2,"surface":"謝晦","kind":"person","person_id":"aa6_83c_juy_AAAA","status":"contextual_provisional"},{"id":"c-songshu-044-xiehui:p001:m0003","start":3,"end":5,"surface":"宣明","kind":"person","person_id":"aa6_83c_juy_AAAA","status":"contextual_provisional"},{"id":"c-songshu-044-xiehui:p001:m0014","start":14,"end":15,"surface":"朗","kind":"person","person_id":"aa6_83c_juy_AA","status":"contextual_provisional"},{"id":"c-songshu-044-xiehui:p001:m0022","start":22,"end":23,"surface":"重","kind":"person","person_id":"aa6_83c_juy_AAA","status":"contextual_provisional"},{"id":"c-songshu-044-xiehui:p001:m0024","start":24,"end":29,"surface":"會稽王道子","kind":"person","person_id":"rts_9t6_fim","status":"contextual_provisional"},{"id":"c-songshu-044-xiehui:p001:m0035","start":35,"end":36,"surface":"絢","kind":"person","person_id":"aa6_83c_juy_AAAB","status":"contextual_provisional"},{"id":"c-songshu-044-xiehui:p001:m0037","start":37,"end":39,"surface":"高祖","kind":"person","person_id":"3dv_ken_w58","status":"contextual_provisional"}],"source_position":{"first_line":9,"last_line":10,"revision_id":1746033,"editorial_excerpt_boundary":true},"chapter_id":"c-songshu-044-xiehui","book_id":"b-songshu-044","work_id":"w-songshu","source_id":"s-songshu-044-xiehui"}],"sources":[{"chapter_id":"c-jinshu-079-xielang-family","work_id":"w-jinshu","book_id":"b-jinshu-079","source_id":"s-jinshu-079-xielang-family","source":{"title":"《晉書》卷七十九（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7079&oldid=2645985","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7079&oldid=2645985","revision_id":2645985,"accessed_on":"2026-10-18","extent":"謝安傳首、謝玄開篇、謝朗完整附傳及謝重、謝絢附傳；其餘傳文未錄。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"d163328c2cd16ad7f6eb3d805fb7f9dbd03f98297a3bfd1d9c51897d21fe1333","wikitext_sha256":"5fa1f639fa36f784fc45cc19fc9b185fa59a64dab7b01f9390d09942c4f071ca","normalization":{"character_conversion":{},"extraction_note":"移除首部排版空白；數位節題另存，不納入傳世正文或據以補家世。","excerpts":[{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p001","source_lines":[27,28],"raw_quote":"謝安，字安石，尚從弟也。父裒，太常卿。安年四歲時，譙郡桓彝見而歎曰：「此兒風神秀徹，後當不減王東海。」及總角，神識沈敏，風宇條暢，善行書。弱冠，詣王蒙，清言良久，既去，蒙子修曰：「向客何如大人？」蒙曰：「此客亹亹，為來逼人。」王導亦深器之。由是少有重名。","raw_quote_sha256":"812019dedb73fc9d58a79c6eb6ae3a327f7cc8005412a41c9c76b1e3a5fa0562","selected_text_sha256":"812019dedb73fc9d58a79c6eb6ae3a327f7cc8005412a41c9c76b1e3a5fa0562","begin_anchor":"謝安，字安石，尚從弟也。父裒，","end_anchor":"」王導亦深器之。由是少有重名。"},{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p002","source_lines":[81,82],"raw_quote":"玄字幼度。少穎悟，與從兄朗俱為叔父安所器重。安嘗戒約子侄，因曰：「子弟亦何豫人事，而正欲使其佳？」諸人莫有言者。玄答曰：「譬如芝蘭玉樹，欲使其生於庭階耳。」安悅。玄少好佩紫羅香囊，安患之，而不欲傷其意，因戲賭取，即焚之，於此遂止。","raw_quote_sha256":"e8ed9f3f2d8d374b9f5514a2eaafcd74cac15564c9b2143837d26b35d35954b0","selected_text_sha256":"e8ed9f3f2d8d374b9f5514a2eaafcd74cac15564c9b2143837d26b35d35954b0","begin_anchor":"玄字幼度。少穎悟，與從兄朗俱為","end_anchor":"，因戲賭取，即焚之，於此遂止。"},{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p003","source_lines":[125,126],"raw_quote":"朗字長度。父據，早卒。朗善言玄理，文義豔發，名亞于玄。總角時，病新起，體甚贏，未堪勞，于叔父安前與沙門支遁朗論，遂至相苦。其母王氏再遣信令還，安欲留，使竟論，王氏因出云：「新婦少遭艱難，一生所寄惟在此兒。」遂流涕攜朗去。安謂坐客曰：「家嫂辭情慷慨，恨不使朝士見之。」朗終於東陽太守。","raw_quote_sha256":"c6b9baa11b6aa7d347dd0f18ba5e39ec7c59e4cc4c6d7f732f6a049144032f9e","selected_text_sha256":"c6b9baa11b6aa7d347dd0f18ba5e39ec7c59e4cc4c6d7f732f6a049144032f9e","begin_anchor":"朗字長度。父據，早卒。朗善言玄","end_anchor":"使朝士見之。」朗終於東陽太守。"},{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p004","source_lines":[129,130],"raw_quote":"子重，字景重，明秀有才名，為會稽王道子驃騎長史。嘗因侍坐，于時月夜明淨，道子歎以為佳。重率爾曰：「意謂乃不如微雲點綴。」道子因戲重曰：「卿居心不淨，乃復強欲滓穢太清邪！」","raw_quote_sha256":"51e7b9110edf612a3aeacd5f41ebb3d95de1847dfb7334acbdcee865b0744406","selected_text_sha256":"51e7b9110edf612a3aeacd5f41ebb3d95de1847dfb7334acbdcee865b0744406","begin_anchor":"子重，字景重，明秀有才名，為會","end_anchor":"心不淨，乃復強欲滓穢太清邪！」"},{"proposed_paragraph_id":"c-jinshu-079-xielang-family:p005","source_lines":[133,134],"raw_quote":"子絢，字宣映，曾於公坐戲調，無禮于其舅袁湛。湛甚不堪之，謂曰：「汝父昔已輕舅，汝今復來加我，可謂世無渭陽情也。」絢父重，即王胡之外孫，與舅亦有不協之論，湛故有此及雲。","raw_quote_sha256":"d45e4517b24e439d2e68a343133a89bbf3ddfb7a57e7ad92250b2ab04b4581b6","selected_text_sha256":"d45e4517b24e439d2e68a343133a89bbf3ddfb7a57e7ad92250b2ab04b4581b6","begin_anchor":"子絢，字宣映，曾於公坐戲調，無","end_anchor":"舅亦有不協之論，湛故有此及雲。"}],"omitted_digital_paratext":[{"kind":"digital_section_heading","not_received_text":true,"source_lines":[123,124],"source_revision":2645985,"raw_quote":"===安兄據子 朗===\n","raw_quote_sha256":"173d13e0baa1a6ea4a5c8786bc194e60f4acdc8b8f5cbcdc2f61c7cdfe10a365"},{"kind":"digital_section_heading","not_received_text":true,"source_lines":[127,128],"source_revision":2645985,"raw_quote":"====朗子 重====\n","raw_quote_sha256":"ee915800694a2c33b402f31d3761d57831fdcb6b30af334944603793104e42a1"},{"kind":"digital_section_heading","not_received_text":true,"source_lines":[131,132],"source_revision":2645985,"raw_quote":"=====重子 絢=====\n","raw_quote_sha256":"73f651f287b39557bd2d0a55b48923a36f8dfbc5603ee880f2a3828e4b0f30b8"}]}}},{"chapter_id":"c-songshu-044-xiehui","work_id":"w-songshu","book_id":"b-songshu-044","source_id":"s-songshu-044-xiehui","source":{"title":"《宋書》卷44（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8/%E5%8D%B744&oldid=1746033","permalink":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8/%E5%8D%B744&oldid=1746033","revision_id":1746033,"accessed_on":"2026-10-18","extent":"傳首家世一段；不是全傳或全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https