{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ab8_vww_6b9","canonical_person_id":"ab8_vww_6b9","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ab8_vww_6b9"],"persons":[{"id":"ab8_vww_6b9","label":"臧均（臨淮人，上表請葬諸葛恪）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"臧均","mention_ids":["c-sanguozhi-064-zhugeke-complete:p032:m0023"]}],"evidence":[{"mention_id":"c-sanguozhi-064-zhugeke-complete:p032:m0023","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p032","chapter_id":"c-sanguozhi-064-zhugeke-complete","quote":"臧均"}],"review":"ai_provisional","identity_note":"臧均（臨淮人，上表請葬諸葛恪），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-sanguozhi-064-zhugeke-complete-ws2263487","work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-zhugeke-complete","raw_mention_count":1,"mention_ids":["c-sanguozhi-064-zhugeke-complete:p032:m0023"],"paragraph_ids":["c-sanguozhi-064-zhugeke-complete:p032"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-064-zhugeke-complete:p032:m0023","mention_ids":["c-sanguozhi-064-zhugeke-complete:p032:m0023"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-064-zhugeke-complete-ws2263487"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-064-zhugeke-complete:quoted_letter33-0","kind":"quoted_letter","person_id":"ab8_vww_6b9","source_quote":"　　臣聞震雷電激，不崇一朝，大風沖發，殺有極日。然猶繼以雲雨，因以潤物，是則天地之威，不可經日浹辰，帝王之怒，不宜訖情盡意，臣以狂愚，不知忌諱，敢冒破滅之罪，以邀風雨之會。伏念故太傅諸葛恪得承祖考風流之烈，伯叔諸父遭漢祚盡，九州鼎立，分托三方，並履忠勤，熙隆世業。爰及於恪，生長王國，陶育聖化，致名英偉，服事累紀，禍心未萌，先帝委以伊、週之任，屬以萬機之事。恪索性剛履，矜己陵人，不能敬守神器，穆靜幫內，興功暴師，未期三出，虛耗士民，空竭府藏，專擅國憲，廢易由意，假刑劫眾，大小屏息。侍中武衛將軍都鄉候俱受先帝囑寄之詔，見其奸虐，日月滋甚，將恐蕩搖宇宙，傾危社稷，奮其威怒，精貫昊天，計慮先於神明，智勇百於荊、聶，躬持白刃，梟恪殿堂，勳超朱，功越東牟。國之元害，一朝大除，馳首徇示，六軍喜踴，日月增光，風塵不動，斯實宗廟之神靈，天人之同驗也。今恪父子三首，懸市積日，觀者數萬，詈聲成風。國之大刑，無所不震，長老孩幼，無不畢見。人情之於品物，樂極則哀生，見恪貴盛，世莫與貳，身處台輔，中間歷年，今之誅夷，無異禽獸，觀訖情反，能不憯然！且已死之人，與土壤同域，鑿掘斫刺，無所復加。願聖朝稽則乾坤，怒不極旬，使其鄉邑若故吏民收以士伍之服，惠以三寸之棺。昔項籍受殯葬之施，韓信獲收斂之恩，斯則漢高發神明之譽也。惟陛下敦三皇之仁，垂哀矜之心，使國澤加於辜戮之骸，復受不已之恩，於以揚聲遐方，沮勸天下，豈不弘哉！昔欒布矯命彭越，臣竊恨之，不先請主上，而專名以肆情，其得不誅，實為幸耳。今臣不敢章宣愚情以露天恩，謹伏手書，冒昧陳聞，乞聖朝哀察。","reading":"原傳領語及下段按前後文繫於臧均致亮。","note":"原傳領語及下段按前後文繫於臧均致亮。","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p033","start_codepoint":0,"end_codepoint":665,"human_reviewed":false,"speaker_person_id":"ab8_vww_6b9","recipient_person_id":"hqp_o1w_ihy","chapter_id":"c-sanguozhi-064-zhugeke-complete","source_id":"s-sanguozhi-064-zhugeke-complete-ws2263487"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-zhugeke-complete:p032:m0023","surface":"臧均","start":23,"end":25,"kind":"person","person_id":"ab8_vww_6b9","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p032","chapter_id":"c-sanguozhi-064-zhugeke-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-zhugeke-complete:p032","text":"　　初，竦數諫恪，恪不從，常憂懼禍。及亡，臨淮臧均表乞收葬恪曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":55,"last_line":55,"raw_start":7492,"raw_end":7524,"raw_character_offsets":[7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523],"revision_id":2263487},"mentions":[{"id":"c-sanguozhi-064-zhugeke-complete:p032:m0004","surface":"竦","start":4,"end":5,"kind":"person","person_id":"512_1cd_a4b_B","status":"contextual_provisional"},{"id":"c-sanguozhi-064-zhugeke-complete:p032:m0007","surface":"恪","start":7,"end":8,"kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional"},{"id":"c-sanguozhi-064-zhugeke-complete:p032:m0009","surface":"恪","start":9,"end":10,"kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional"},{"id":"c-sanguozhi-064-zhugeke-complete:p032:m0023","surface":"臧均","start":23,"end":25,"kind":"person","person_id":"ab8_vww_6b9","status":"contextual_provisional"},{"id":"c-sanguozhi-064-zhugeke-complete:p032:m0029","surface":"恪","start":29,"end":30,"kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-064-zhugeke-complete","book_id":"b-sanguozhi-064","work_id":"w-sanguozhi","source_id":"s-sanguozhi-064-zhugeke-complete-ws2263487"}],"sources":[{"chapter_id":"c-sanguozhi-064-zhugeke-complete","work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","source_id":"s-sanguozhi-064-zhugeke-complete-ws2263487","source":{"title":"三國志卷六十四·諸葛恪及綽、竦、建","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=2263487","url":"https://zh.wikisource.org/w/index.php?oldid=2263487","revision_id":2263487,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"三國志卷六十四·諸葛恪及綽、竦、建","text_scope":"complete_biography_unit","raw_path":"source-evidence/sanguozhi064-roll/ws2263487.wikitext","raw_f