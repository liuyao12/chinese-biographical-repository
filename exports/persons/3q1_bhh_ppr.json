rtions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-082","person_id":"3q1_bhh_ppr","surfaces":["大夫奚斯","奚斯"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p048","quote":"釐公亦莊公少子。哀姜恐，奔邾。季友以賂如莒求慶父，慶父歸，使人殺慶父，慶父請奔，弗聽，乃使大夫奚斯行哭而往。慶父聞奚斯音，乃自殺。齊桓公聞哀姜與慶父亂以危魯，及召之邾而殺之，以其尸歸，戮之魯。魯釐公請而葬之。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"},{"id":"d-song051-yiqing-yq_allusion_6","person_id":"3q1_bhh_ppr","surfaces":["奚斯"],"scope":"cross_chapter","chapter_ids":["c-songshu-051-wyd1739-zongshi","c-shiji-033-lu"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-051-wyd1739-zongshi:p038:m0182"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-051","source_id":"s-songshu-051-wyd1739-zongshi","chapter_id":"c-songshu-051-wyd1739-zongshi","paragraph_id":"c-songshu-051-wyd1739-zongshi:p038","quote":"傷不可見也然則古人所不見者今獨見之矣孟軻曰千載一聖是旦暮也豈不大哉夫四皇六帝樹聲長世大寶也澤浸羣生國富刑清鴻德也制禮裁樂惇風遷俗文教也殊華潤藉束頮絳闕武功也鳴鳥躍魚滌穢河渠至祥也大寶鴻德文教武功其崇如此幽明協贊民祗與能厥應如彼唯天為大堯實則之皇哉唐哉疇與為讓抑文聞之勢之所覃者淺則美之所傳者近道之所感者深則慶之所流者遠是以豐功豔命潤色勝策盛德形容藻被歌頌察之上代則奚斯吉甫之徒鳴玉鸞於前視之中古則相如王褒之屬施金羈於後絕"},{"work_id":"w-shiji","book_id":"b-shiji-033","source_id":"s-shiji-033-lu","chapter_id":"c-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p048","quote":"釐公亦莊公少子。哀姜恐，奔邾。季友以賂如莒求慶父，慶父歸，使人殺慶父，慶父請奔，弗聽，乃使大夫奚斯行哭而往。慶父聞奚斯音，乃自殺。齊桓公聞哀姜與慶父亂以危魯，及召之邾而殺之，以其尸歸，戮之魯。魯釐公請而葬之。"}],"rationale":"頌文作者群中的魯奚斯；需補作者傳統來源，同名單獨不足。 本處為頌文／文學引古，不生在場、家族、任期或年代斷言。","reference_role":"historical_allusion","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p048","text":"釐公亦莊公少子。哀姜恐，奔邾。季友以賂如莒求慶父，慶父歸，使人殺慶父，慶父請奔，弗聽，乃使大夫奚斯行哭而往。慶父聞奚斯音，乃自殺。齊桓公聞哀姜與慶父亂以危魯，及召之邾而殺之，以其尸歸，戮之魯。魯釐公請而葬之。","annotation_stat