ngs":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-082","person_id":"3q1_bhh_ppr","surfaces":["大夫奚斯","奚斯"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p048","quote":"釐公亦莊公少子。哀姜恐，奔邾。季友以賂如莒求慶父，慶父歸，使人殺慶父，慶父請奔，弗聽，乃使大夫奚斯行哭而往。慶父聞奚斯音，乃自殺。齊桓公聞哀姜與慶父亂以危魯，及召之邾而殺之，以其尸歸，戮之魯。魯釐公請而葬之。"}],"rationale":"按懿公被弒至魯文公的敘事角色、同段明示子／弟與柯盟、齊襄公殺魯桓公、晉立惠公等具體事件暫定異稱；同字爵稱依國別分開。公子揮不與前篇公子翚、晉襄父不與晉襄公、宣伯不與叔孫宣伯自動合併。數位疑讀與親屬異說仍待核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p048","text":"釐公亦莊公少子。哀姜恐，奔邾。季友以賂如莒求慶父，慶父歸，使人殺慶父，慶父請奔，弗聽，乃使大夫奚斯行哭而往。慶父聞奚斯音，乃自殺。齊桓公聞哀姜與慶父亂以危魯，及召之邾而殺之，以其尸歸，戮之魯。魯釐公請而葬之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m048-0000","start":0,"end":2,"surface":"釐公","kind":"person","person_id":"x50_1p7_qkk_B","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0003","start":3,"end":5,"surface":"莊公","kind":"person","person_id":"x50_1p7_qkk","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0008","start":8,"end":10,"surface":"哀姜","kind":"person","person_id":"tke_fad_hlp","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0015","start":15,"end":17,"surface":"季友","kind":"person","person_id":"lc6_cup_v9c_ABA","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0022","start":22,"end":24,"surface":"慶父","kind":"person","person_id":"k6c_jbs_1gw","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0025","start":25,"end":27,"surface":"慶父","kind":"person","person_id":"k6c_jbs_1gw","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m048-0030","start":30,"end":31,"surface":"人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、地點氏稱、未定官稱或未解指代；不補姓名、成員與父系。"},{"id":"c-shiji-033-lu:m048-0032","start":32,"end":34,"surfa