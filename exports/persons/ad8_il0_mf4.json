2:m0120","start":120,"end":124,"surface":"陽平王頤","kind":"person","person_id":"jh7_tw6_n9k","status":"contextual_provisional","interpretation_note":"與播出漠北蠕蠕、太和高祖上下文；不與冀州刺史頤或其他頤因單名相合。"},{"id":"c-weishu-weishou-058-yangbo-yangkan:p002:m0137","start":137,"end":139,"surface":"高祖","kind":"person","person_id":"8dc_745_f37","status":"contextual_provisional","interpretation_note":"完整本源上下文與已錄同朝／同事來源核對之首選；逐人理由見identity-review。"}],"chapter_id":"c-weishu-weishou-058-yangbo-yangkan","book_id":"b-weishu-weishou-058","work_id":"w-weishu-weishou","source_id":"s-weishu-weishou-058-yangbo-ws2087998"},{"id":"c-weishu-weishou-058-yangchun:p001","text":"播弟椿，字延壽，本字仲考，太和中與播俱蒙高祖賜改。性寬謹，初拜中散，典御廐曹，以端慎小心，專司醫藥，遷內給事，與兄播並侍禁闈。又領蘭臺行職，改授中部曹，析訟公正，高祖嘉之。及文明太后崩，高祖五日不食。椿進諫曰：「陛下至性，孝過有虞，居哀五朝，水漿不御，羣下惶灼，莫知所言。陛下荷祖宗之業，臨萬國之重，豈可同匹夫之節，以取僵仆。且聖人之禮，毀不滅性，縱陛下欲自賢於萬代，其若宗廟何！」高祖感其言，乃一進粥。轉授宮輿曹少卿，加給事中。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"revision_id":2087998,"raw_start":3435,"raw_end":3840,"source_layer":"received_biography","raw_character_offsets":[3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3701,3702,3703,3704,3705,3706,3707,3708,3709,3710,3711,3712,3713,3714,3715,3716,3717,3718,3719,3720,3721,3722,3723,3724,3725,3726,3727,3728,3729,3730,3731,3732,3733,3734,3735,3736,3737,3738,3739,3740,3741,3742,3743,3744,3745,3746,3747,3748,3749,3750,3751,3752,3753,3754,3755,3756,3757,3758,3759,3760,3761,3762,3763,3764,3765,3766,3767,3768,3769,3770,3771,3772,3773,3774,3775,3776,3777,3778,3779,3780,3781,3782,3783,3784,3785,3786,3787,3788,3789,3790,3791,3792,3793,3794,3795,3796,3797,3798,3799,3800,3801,3802,3803,3804,3805,3806,3807,3808,3809,3810,3811,3812,3813