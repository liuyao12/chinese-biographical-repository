id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m012-0090","start":90,"end":93,"surface":"齊懿仲","kind":"person","person_id":"cbr-p001482","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m012-0095","start":95,"end":98,"surface":"陳敬仲","kind":"person","person_id":"cbr-p001109","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m012-0108","start":108,"end":110,"surface":"鳳皇","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m012-0135","start":135,"end":137,"surface":"正卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"}],"chapter_id":"c-shiji-036-chenqi","book_id":"b-shiji-036","work_id":"w-shiji","source_id":"s-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:p014","text":"四十五年，宣公卒，子款立，是為穆公。穆公五年，齊桓公卒。十六年，晉文公敗楚師于城濮。是歲，穆公卒，子共公朔立。共公六年，楚太子商臣弒其父成王代立，是為穆王。十一年，秦穆公卒。十八年，共公卒，子靈公平國立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m014-0005","start":5,"end":7,"surface":"宣公","kind":"person","person_id":"cbr-p001476","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m014-0010","start":10,"end":11,"surface":"款","kind":"person","person_id":"cbr-p001480","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m014-0015","start":15,"end":17,"surface":"穆公","kind":"person","person_id":"cbr-p001480","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m014-0018","start":18,"end":20,"surface":"穆公","kind":"person","person_id":"cbr-p001480","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m014-0023","start":23,"end":26,"surface":"齊桓公","kind":"person","person_id":"cbr-p000235","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m014-0032","start":32,"end":35,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m014-0045","start":45,"end"