le_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-045-wyd1739-liucui:p005","text":"郎王弘車騎從事中郎江夏王義恭撫軍司馬河東太守仍遷振武將軍益州刺史長史費謙別駕張熙參軍楊德年等並聚斂與利而道濟委任之傷政害民民皆怨毒太祖聞之與道濟詔戒之曰聞卿在任未盡清省又頗為殖貨若萬有一此必宜改之比傳人情不政〓諸當以法御下深思自警以副本望道濟雖奉此旨政化如初有司馬飛龍者自稱晉之宗室晉末走仇池元嘉九年間道濟綏撫失和遂自仇池入緜竹煽動羣小得千餘人破巴興縣殺令王貞之進攻陰平陰平太守沈法興焚城遁走道濟遣軍擊飛龍斬之初道濟以五","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-songshu-045-wyd1739-liucui:p005:m0001","start":1,"end":3,"surface":"王弘","kind":"person","person_id":"7r6_k52_qji_ABAAAAA"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0012","start":12,"end":14,"surface":"義恭","kind":"person","person_id":"2n6_7xk_5ov"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0034","start":34,"end":36,"surface":"費謙","kind":"person","person_id":"jm0_moa_yl8"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0038","start":38,"end":40,"surface":"張熙","kind":"person","person_id":"zu1_9sp_u1i"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0042","start":42,"end":45,"surface":"楊德年","kind":"person","person_id":"wba_vuw_f1p"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0052","start":52,"end":54,"surface":"道濟","kind":"person","person_id":"8lh_jgi_l6a_*B"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0065","start":65,"end":67,"surface":"太祖","kind":"person","person_id":"3qs_nqa_ioa_AAAA"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0070","start":70,"end":72,"surface":"道濟","kind":"person","person_id":"8lh_jgi_l6a_*B"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0077","start":77,"end":78,"surface":"卿","kind":"person","person_id":"8lh_jgi_l6a_*B"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0119","start":119,"end":121,"surface":"道濟","kind":"person","person_id":"8lh_jgi_l6a_*B"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0130","start":130,"end":134,"surface":"司馬飛龍","kind":"person","person_id":"jil_4eu_ese"},{"id":"c-songshu-045-wyd1739-liucui:p005:m0151","start":