tity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"src-shiji119-xunli-jiafu-role-ambiguity","person_id":"v9v_sk2_lbn","kind":"referent_role_ambiguity","paragraph_id":"c-shiji-119-xunli:p009","person_mention_id":"c-shiji-119-xunli:m009-0024","source_term":"家婦","source_quote":"見其家織布好，而疾出其家婦，燔其機，云：「欲令農士工女安所讎其貨乎」？","recap_paragraph_id":"c-shiji-119-xunli:p012","recap_mention_id":"c-shiji-119-xunli:m012-0033","recap_quote":"公儀子見好布而家婦逐。","status":"unresolved","possible_roles":["wife","handmaid_or_servant","other_household_woman"],"study_references":[{"title":"《史記・循吏列傳》析疑","authors":["閻鴻中"],"journal":"臺大歷史學報","year":2016,"volume":57,"pages":"1–46","specific_pages":"12，註29","doi":"10.6253/ntuhistory.2016.57.01","url":"https://doi.org/10.6253/ntuhistory.2016.57.01","summary":"作者指出本篇「家婦」與《漢書》相關敘述的「出妻」用語不同，並提示家婦亦可能指婢使；本文僅存此考證為參考，不採定婚姻身分。","scope":"modern_reference_not_received_text","image_verified":false}],"rationale":"篇中逐人及論贊回顧足以暫連兩次家婦為同一匿名人物；「家婦」詞義及相關敘事仍不足以裁定配偶或家內從役身份。故撤回原有公儀休—家婦配偶斷言，不在 preferred_relations 建立婚配；本案僅保留來源提及與角色未決判讀。","human_reviewed":false,"chapter_id":"c-shiji-119-xunli","source_id":"s-shiji119-xunli"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-119-xunli:m009-0024","start":24,"end":26,"surface":"家婦","kind":"person","person_id":"v9v_sk2_lbn","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p009","chapter_id":"c-shiji-119-xunli"},{"id":"c-shiji-119-xunli:m012-0033","start":33,"end":35,"surface":"家婦","kind":"person","person_id":"v9v_sk2_lbn","status":"contextual_provisional","paragraph_id":"c-shiji-119-xunli:p012","chapter_id":"c-shiji-119-xunli"}],"relations":[],"title_holdings":[],"address_assertions":[],