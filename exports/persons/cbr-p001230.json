p_v9c_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-038-song:p027","text":"三十四年，戴公卒，子武公司空立。武公生女爲魯惠公夫人，生魯桓公。十八年，武公卒，子宣公力立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m027-0005","start":5,"end":7,"surface":"戴公","kind":"person","person_id":"2v6_0g1_ve2_AAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m027-0010","start":10,"end":14,"surface":"武公司空","kind":"person","person_id":"2v6_0g1_ve2_AAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m027-0016","start":16,"end":18,"surface":"武公","kind":"person","person_id":"2v6_0g1_ve2_AAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m027-0021","start":21,"end":24,"surface":"魯惠公","kind":"person","person_id":"lc6_cup_v9c_A","status":"contextual_provisional"},{"id":"c-shiji-038-song:m027-0024","start":24,"end":26,"surface":"夫人","kind":"person","person_id":"2v6_0g1_ve2_AAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m027-0028","start":28,"end":31,"surface":"魯桓公","kind":"person","person_id":"lc6_cup_v9c_AB","status":"contextual_provisional"},{"id":"c-shiji-038-song:m027-0036","start":36,"end":38,"surface":"武公","kind":"person","person_id":"2v6_0g1_ve2_AAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-038-song:m027-0041","start":41,"end":44,"surface":"宣公力","kind":"person","person_id":"2v6_0g1_ve2_AAAAAAAAAB","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"}],"sources":[{"chapter_id":"c-shiji-033-lu","work_id":"w-shiji","book_id":"b-shiji-033","source_id":"s-shiji-033-lu","source":{"title":"史記／魯周公世家","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/魯周公世家","permalink":"https://zh.wikisource.org/w/index.php?title=史記/魯周公世家&oldid=7909289","revision_id":7909289,"acc