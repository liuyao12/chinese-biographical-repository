癘，歸國。立二十三年卒，謚夷侯。子襄代侯。襄尚衛長公主，生子宗。立十六年卒，謚為共侯。子宗代侯。征和二年中，宗坐太子死，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-054-cao:m017-0003","start":3,"end":4,"surface":"窋","kind":"person","person_id":"37j_16p_7n8_A","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0005","start":5,"end":7,"surface":"高后","kind":"person","person_id":"5ii_dzh_6bo","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0014","start":14,"end":17,"surface":"孝文帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0036","start":36,"end":37,"surface":"奇","kind":"person","person_id":"37j_16p_7n8_AA","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0051","start":51,"end":52,"surface":"時","kind":"person","person_id":"37j_16p_7n8_AAA","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0055","start":55,"end":56,"surface":"時","kind":"person","person_id":"37j_16p_7n8_AAA","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0057","start":57,"end":61,"surface":"平陽公主","kind":"person","person_id":"1aa_yn3_kv1","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0064","start":64,"end":65,"surface":"襄","kind":"person","person_id":"37j_16p_7n8_AAAA","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0066","start":66,"end":67,"surface":"時","kind":"person","person_id":"37j_16p_7n8_AAA","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0085","start":85,"end":86,"surface":"襄","kind":"person","person_id":"37j_16p_7n8_AAAA","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0089","start":89,"end":90,"surface":"襄","kind":"person","person_id":"37j_16p_7n8_AAAA","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0091","start":91,"end":95,"surface":"衛長公主","kind":"person","person_id":"nda_3wa_ktc","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m017-0098","start":98,"end":99,"surface"