lt":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangrong:p007:m0026","start":26,"end":27,"surface":"母","kind":"person","person_id":"s6r_kug_pk7","status":"contextual_provisional","resolution_note":"孝喪插敘武帝問劉毅，不與劉裕時護軍劉毅同人；母稱不升生母。","paragraph_id":"c-jinshu-043-wangrong:p007","chapter_id":"c-jinshu-043-wangrong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p007","text":"戎在職雖無殊能，而庶績修理。後遷光祿勳、吏部尚書，以母憂去職。性至孝，不拘禮制，飲酒食肉，或觀弈棋，而容貌毀悴，杖然後起。裴頠往吊之，謂人曰：「若使一慟能傷人，濬沖不免滅性之譏也。」時和嶠亦居父喪，以禮法自持，量米而食，哀毀不逾於戎。帝謂劉毅曰：「和嶠毀頓過禮，使人憂之。」毅曰：「嶠雖寢苫食粥，乃生孝耳。至於王戎，所謂死孝，陛下當先憂之。」戎先有吐疾，居喪增甚。帝遣醫療之，並賜藥物，又斷賓客。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p007:m0000","start":0,"end":1,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"孝喪插敘武帝問劉毅，不與劉裕時護軍劉毅同人；母稱不升生母。"},{"id":"c-jinshu-043-wangrong:p007:m0026","start":26,"end":27,"surface":"母","kind":"person","person_id":"s6r_kug_pk7","status":"contextual_provisional","resolution_note":"孝喪插敘武帝問劉毅，不與劉裕時護軍劉毅同人；母稱不升生母。"},{"id":"c-jinshu-043-wangrong:p007:m0061","start":61,"end":63,"surface":"裴頠","kind":"person","person_id":"svm_6fh_34r","status":"contextual_provisional","resolution_note":"孝喪插敘武帝問劉毅，不與劉裕時護軍劉毅同人；母稱不升生母。"},{"id":"c-jinshu-043-wangrong:p007:m0080","start":80,"end":82,"surface":"濬沖","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"孝喪插敘武帝問劉毅，不與劉裕時護軍劉毅同人；母稱不升生母。"},{"id":"c-jinshu-043-wangrong:p007:m0092","start":92,"end":94,"surface":"和嶠","kind":"person","person_id":"3fc_362_06e","status":"contextual_provisional","resolution_note":"孝喪插