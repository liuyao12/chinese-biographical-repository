{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004906","canonical_person_id":"y2h_l5o_9qj","id_aliases":["cbr-p004906"],"identity_policy":"contextual_provisional","person_ids":["y2h_l5o_9qj"],"persons":[{"id":"y2h_l5o_9qj","label":"蒙毅（李斯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"蒙毅","mention_ids":["c-shiji-087-lisi:m019-0185"]},{"surface":"大臣蒙毅","mention_ids":["c-shiji-087-lisi:m019-0365"]}],"evidence":[{"mention_id":"c-shiji-087-lisi:m019-0185","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p019","quote":"蒙毅"},{"mention_id":"c-shiji-087-lisi:m019-0365","chapter_id":"c-shiji-087-lisi","paragraph_id":"c-shiji-087-lisi:p019","quote":"大臣蒙毅"}],"id_aliases":["cbr-p004906"]}],"source_mention_summary":[{"source_id":"s-shiji-087-lisi","work_id":"w-shiji","book_id":"b-shiji-087","chapter_id":"c-shiji-087-lisi","mention_count":2,"mention_ids":["c-shiji-087-lisi:m019-0185","c-shiji-087-lisi:m019-0365"],"paragraph_ids":["c-shiji-087-lisi:p019"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-087-lisi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-087-lisi:m019-0185","start":185,"end":187,"surface":"蒙毅","kind":"person","person_id":"y2h_l5o_9qj","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p019","chapter_id":"c-shiji-087-lisi"},{"id":"c-shiji-087-lisi:m019-0365","start":365,"end":369,"surface":"大臣蒙毅","kind":"person","person_id":"y2h_l5o_9qj","status":"contextual_provisional","paragraph_id":"c-shiji-087-lisi:p019","chapter_id":"c-shiji-087-lisi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji087-039","person_id":"y2h_l5o_9qj","scope":"same_chapter","chapter_ids":["c-shiji-087-lisi"],"status":"contextual_provisional","rationale":"依二世用高及督責書局部承接暫接；第19段趙高之高排除高枕普通詞，第20段公子高與趙高分開；廣等只按吳廣兵承接，不標廣欲。堯禹標示傳說性，韓子商君與申韓未以模型記憶補名或全域合併；嵌套引語仍待核。","reviewer":"Codex（AI 代理）","surfaces":["大臣蒙毅","蒙毅"],"evidence":[{"paragraph_id":"c-shiji-087-lisi:p019","quote":"二世燕居，乃召高與謀事，謂曰：「夫人生居世間也，譬猶騁六驥過決隙也。吾既已臨天下矣，欲悉耳目之所好，窮心志之所樂，以安宗廟而樂萬姓，長有天下，終吾年壽，其道可乎？」高曰：「此賢主之所能行也，而昏亂主之所禁也。臣請言之，不敢避斧鉞之誅，願陛下少留意焉。夫沙丘之謀，諸公子及大臣皆疑焉，而諸公子盡帝兄，大臣又先帝之所置也。今陛下初立，此其屬意怏怏皆不服，恐為變。且蒙恬已死，蒙毅將兵居外，臣戰戰栗栗，唯恐不終。且陛下安得為此樂乎？」二世曰：「為之奈何？」趙高曰：「嚴法而刻刑，令有罪者相坐誅，至收族，滅大臣而遠骨肉；貧者富之，賤者貴之。盡除去先帝之故臣，更置陛下之所親信者近之。此則陰德歸陛下，害除而姦謀塞，羣臣莫不被潤澤，蒙厚德，陛下則高枕肆志寵樂矣。計莫出於此。」二世然高之言，乃更為法律。於是群臣諸公子有罪，輒下高，令鞠治之。殺大臣蒙毅等，公子十二人僇死咸陽市，十公主矺死於杜，財物入於縣官，相連坐者不可勝數。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-087-lisi:p019","text":"二世燕居，乃召高與謀事，謂曰：「夫人生居世間也，譬猶騁六驥過決隙也。吾既已臨天下矣，欲悉耳目之所好，窮心志之所樂，以安宗廟而樂萬姓，長有天下，終吾年壽，其道可乎？」高曰：「此賢主之所能行也，而昏亂主之所禁也。臣請言之，不敢避斧鉞之誅，願陛下少留意焉。夫沙丘之謀，諸公子及大臣皆疑焉，而諸公子盡帝兄，大臣又先帝之所置也。今陛下初立，此其屬意怏怏皆不服，恐為變。且蒙恬已死，蒙毅將兵居外，臣戰戰栗栗，唯恐不終。且陛下安得為此樂乎？」二世曰：「為之奈何？」趙高曰：「嚴法而刻刑，令有罪者相坐誅，至收族，滅大臣而遠骨肉；貧者富之，賤者貴之。盡除去先帝之故臣，更置陛下之所親信者近之。此則陰德歸陛下，害除而姦謀塞，羣臣莫不被潤澤，蒙厚德，陛下則高枕肆志寵樂矣。計莫出於此。」二世然高之言，乃更為法律。於是群臣諸公子有罪，輒下高，令鞠治之。殺大臣蒙毅等，公子十二人僇死咸陽市，十公主矺死於杜，財物入於縣官，相連坐者不可勝數。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-087-lisi:m019-0000","start":0,"end":2,"surface":"二世","kind":"person","person_id":"z0a_bdl_gn5_B","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m019-0007","start":7,"end":8,"surface":"高","kind":"person","person_id":"4ai_d4s_gde","status":"contextual_provisional"},{"id":"c-shiji-087-lisi:m019-0082","start":82,"end":83,"surface":"高","kind":"person","person_id":"4ai_d4s_gde","status":"contextual_provisional"},{"id":"c-shiji-