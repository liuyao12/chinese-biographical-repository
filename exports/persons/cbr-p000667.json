{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000667","identity_policy":"contextual_provisional","person_ids":["cbr-p000667"],"persons":[{"id":"cbr-p000667","label":"田假","status":"active","historicity":"historical_tradition","aliases":[{"surface":"田假","mention_ids":["c-shiji-007-xiangyu:m007-0115","c-shiji-007-xiangyu:m007-0136"]},{"surface":"假","mention_ids":["c-shiji-007-xiangyu:m007-0042","c-shiji-007-xiangyu:m007-0044","c-shiji-007-xiangyu:m007-0049"]}],"evidence":[{"mention_id":"c-shiji-007-xiangyu:m007-0115","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p007","quote":"田假"},{"mention_id":"c-shiji-007-xiangyu:m007-0136","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p007","quote":"田假"},{"mention_id":"c-shiji-007-xiangyu:m007-0042","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p007","quote":"假"},{"mention_id":"c-shiji-007-xiangyu:m007-0044","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p007","quote":"假"},{"mention_id":"c-shiji-007-xiangyu:m007-0049","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p007","quote":"假"}]}],"mentions":[{"id":"c-shiji-007-xiangyu:m007-0042","start":42,"end":43,"surface":"假","kind":"person","person_id":"cbr-p000667","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p007","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m007-0044","start":44,"end":45,"surface":"假","kind":"person","person_id":"cbr-p000667","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p007","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m007-0049","start":49,"end":50,"surface":"假","kind":"person","person_id":"cbr-p000667","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p007","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m007-0115","start":115,"end":117,"surface":"田假","kind":"person","person_id":"cbr-p000667","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p007","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m007-0136","start":136,"end":138,"surface":"田假","kind":"person","person_id":"cbr-p000667","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p007","chapter_id":"c-shiji-007-xiangyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji007-015","person_id":"cbr-p000667","surfaces":["假","田假"],"scope":"same_chapter","chapter_ids":["c-shiji-007-xiangyu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p007","quote":"居數月，引兵攻亢父，與齊田榮、司馬龍且軍救東阿，大破秦軍於東阿。田榮即引兵歸，逐其王假。假亡走楚。假相田角亡走趙。角弟田閒故齊將，居趙不敢歸。田榮立田儋子市為齊王。項梁已破東阿下軍，遂追秦軍。數使使趣齊兵，欲與俱西。田榮曰：「楚殺田假，趙殺田角、田閒，乃發兵。」項梁曰：「田假為與國之王，窮來從我，不忍殺之。」趙亦不殺田角、田閒以市於齊。齊遂不肯發兵助楚。項梁使沛公及項羽別攻城陽，屠之。西破秦軍濮陽東，秦兵收入濮陽。沛公、項羽乃攻定陶。定陶未下，去，西略地至雝丘，大破秦軍，斬李由。還攻外黃，外黃未下。"}],"rationale":"其王假、假相田角與下文田假在同一田榮驅逐敘事中暫定同指。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p007","text":"居數月，引兵攻亢父，與齊田榮、司馬龍且軍救東阿，大破秦軍於東阿。田榮即引兵歸，逐其王假。假亡走楚。假相田角亡走趙。角弟田閒故齊將，居趙不敢歸。田榮立田儋子市為齊王。項梁已破東阿下軍，遂追秦軍。數使使趣齊兵，欲與俱西。田榮曰：「楚殺田假，趙殺田角、田閒，乃發兵。」項梁曰：「田假為與國之王，窮來從我，不忍殺之。」趙亦不殺田角、田閒以市於齊。齊遂不肯發兵助楚。項梁使沛公及項羽別攻城陽，屠之。西破秦軍濮陽東，秦兵收入濮陽。沛公、項羽乃攻定陶。定陶未下，去，西略地至雝丘，大破秦軍，斬李由。還攻外黃，外黃未下。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m007-0012","start":12,"end":14,"surface":"田榮","kind":"person","person_id":"cbr-p000665","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0017","start":17,"end":19,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0032","start":32,"end":34,"surface":"田榮","kind":"person","person_id":"cbr-p000665","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0042","start":42,"end":43,"surface":"假","kind":"person","person_id":"cbr-p