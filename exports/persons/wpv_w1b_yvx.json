ons":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-035-peikai-family:p005:m0006","start":6,"end":7,"surface":"女","kind":"person","person_id":"wpv_w1b_yvx","status":"contextual_provisional","paragraph_id":"c-jinshu-035-peikai-family:p005","chapter_id":"c-jinshu-035-peikai-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-035-peikai-family:p005","text":"楷子瓚娶楊駿女，然楷素輕駿，與之不平。駿既執政，乃轉為衛尉，遷太子少師，優遊無事，默如也。及駿誅，楷以婚親收付廷尉，將加法。是日事倉卒，誅戮縱橫，眾人為之震恐。楷容色不變，舉動自若，索紙筆與親故書。賴侍中傅祗救護得免，猶坐去官。太保衛瓘、太宰亮稱楷貞正不阿附，宜蒙爵土，乃封臨海侯，食邑二千戶。代楚王瑋為北軍中候，加散騎常侍。瑋怨瓘、亮斥己任楷，楷聞之，不敢拜，轉為尚書。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-035-peikai-family:p005:m0000","start":0,"end":1,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0002","start":2,"end":3,"surface":"瓚","kind":"person","person_id":"99p_632_txb","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0004","start":4,"end":6,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0006","start":6,"end":7,"surface":"女","kind":"person","person_id":"wpv_w1b_yvx","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0009","start":9,"end":10,"surface":"楷","kind":"person","person_id":"530_f9d_4bd","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0012","start":12,"end":13,"surface":"駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-035-peikai-family:p005:m0019","start":19,"end":20,"sur