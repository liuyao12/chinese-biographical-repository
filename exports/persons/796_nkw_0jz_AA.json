r_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p015","quote":"蒼"},{"mention_id":"c-shiji-096-zhang:m015-0081","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p015","quote":"蒼"},{"mention_id":"c-shiji-096-zhang:m016-0089","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p016","quote":"張蒼"},{"mention_id":"c-shiji-096-zhang:m016-0104","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p016","quote":"張蒼"},{"mention_id":"c-shiji-096-zhang:m020-0005","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p020","quote":"張蒼"},{"mention_id":"c-shiji-096-zhang:m030-0000","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p030","quote":"張蒼"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p015","quote":"初，張蒼父長不滿五尺，及生蒼，蒼長八尺餘，為侯、丞相。蒼子復長。及孫類，長六尺餘，坐法失侯。蒼之免相後，老，口中無齒，食乳，女子為乳母。妻妾以百數，嘗孕者不復幸。蒼年百有餘歲而卒。","source_term":"張蒼父長不滿五尺"}],"source_assertion_id":"a-shiji096-006","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"796_nkw_0jz"},"id_aliases":["cbr-p005362"]},{"id":"796_nkw_0jz_AA","label":"張蒼子未名（康侯）（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"康侯","mention_ids":["c-shiji-096-zhang:m014-0139"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m014-0139","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p014","quote":"康侯"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p014","quote":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相由此自絀，謝病稱老。蒼任人為中候，大為姦利，上以讓蒼，蒼遂病免。蒼為丞相十五歲而免。孝景前五年，蒼卒，謚為文侯。子康侯代，八年卒。子類代為侯，八年，坐臨諸侯喪後就位不敬，國除。","source_term":"蒼卒，謚為文侯。子康侯代"}],"source_assertion_id":"a-shiji096-004","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"796_nkw_0jz_A"},"id_aliases":["cbr-p005400"]},{"id":"796_nkw_0jz_AAA","label":"張類（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"類","mention_ids":["c-shiji-096-zhang:m014-0148","c-shiji-096-zhang:m015-0034"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m014-0148","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p014","quote":"類"},{"mention_id":"c-shiji-096-zhang:m015-0034","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p015","quote":"類"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p014","quote":"蒼為丞相十餘年，魯人公孫臣上書言漢土德時，其符有黃龍當見。詔下其議張蒼，張蒼以為非是，罷之。其後黃龍見成紀，於是文帝召公孫臣以為博士，草土德之歷制度，更元年。張丞相由此自絀，謝病稱老。蒼任人為中候，大為姦利，上以讓蒼，蒼遂病免。蒼為丞相十五歲而免。孝景前五年，蒼卒，謚為文侯。子康侯代，八年卒。子類代為侯，八年，坐臨諸侯喪後就位不敬，國除。","source_term":"子康侯代，八年卒。子類代為侯"}],"source_assertion_id":"a-shiji096-005","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"796_nkw_0jz_AA"},"id_aliases":["cbr-p005414"]}],"source_mention_summary":[{"source_id":"s-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","chapter_id":"c-shiji-096-zhang","mention_count":1,"mention_ids":["c-shiji-096-zhang:m014-0139"],"paragraph_ids":["c-shiji-096-zhang:p014"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":