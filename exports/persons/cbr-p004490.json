{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004490","identity_policy":"contextual_provisional","person_ids":["cbr-p004490"],"persons":[{"id":"cbr-p004490","label":"禹引古（范睢蔡澤列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"禹","mention_ids":["c-shiji-079-fancai:m010-0081"]}],"evidence":[{"mention_id":"c-shiji-079-fancai:m010-0081","chapter_id":"c-shiji-079-fancai","paragraph_id":"c-shiji-079-fancai:p010","quote":"禹"}]}],"source_mention_summary":[{"source_id":"s-shiji-079-fancai","work_id":"w-shiji","book_id":"b-shiji-079","chapter_id":"c-shiji-079-fancai","mention_count":1,"mention_ids":["c-shiji-079-fancai:m010-0081"],"paragraph_ids":["c-shiji-079-fancai:p010"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-079-fancai"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-079-fancai:m010-0081","start":81,"end":82,"surface":"禹","kind":"person","person_id":"cbr-p004490","status":"contextual_provisional","paragraph_id":"c-shiji-079-fancai:p010","chapter_id":"c-shiji-079-fancai"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji079-019","person_id":"cbr-p004490","surfaces":["禹"],"scope":"same_chapter","chapter_ids":["c-shiji-079-fancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-079-fancai:p010","quote":"臣聞善厚家者取之於國，善厚國者取之於諸侯。天下有明主則諸侯不得擅厚者，何也？為其割榮也。良醫知病人之死生，而聖主明於成敗之事，利則行之，害則捨之，疑則少嘗之，雖舜禹復生，弗能改已。語之至者，臣不敢載之於書，其淺者又不足聽也。意者臣愚而不概於王心邪？亡其言臣者賤而不可用乎？自非然者，臣願得少賜游觀之閒，望見顏色。一語無效，請伏斧質。"}],"rationale":"按全35段明示姓名與局部引語暫接，范睢張祿范叔范君應侯分說話範圍；蔡澤先生綱成君依具體敘事。越王事大夫種與句踐敘事相配，更新候選標籤保留ID。馬服／馬服子依同段長平角色暫接未補姓名，白公仍未定，韓子未強接韓非，喬松不補神仙，范中行族稱不接范睢。王之弟、改讀前止足及引古異說各留，預言與擬議方案不當史實核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"