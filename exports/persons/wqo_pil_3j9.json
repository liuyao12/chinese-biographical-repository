ia-comparison:p006:m0272","kind":"person","person_id":"q1l_utb_rfn_**AA","status":"source_attested"},{"start":277,"end":280,"surface":"楚王瑋","id":"c-jinshu-031-jia-comparison:p006:m0277","kind":"person","person_id":"20b_1c2_a06","status":"source_attested"},{"start":290,"end":292,"surface":"董猛","id":"c-jinshu-031-jia-comparison:p006:m0290","kind":"person","person_id":"mqz_jmx_qlo","status":"source_attested"},{"start":297,"end":298,"surface":"猛","id":"c-jinshu-031-jia-comparison:p006:m0297","kind":"person","person_id":"mqz_jmx_qlo","status":"source_attested"},{"start":299,"end":301,"surface":"武帝","id":"c-jinshu-031-jia-comparison:p006:m0299","kind":"person","person_id":"hgm_jvn_hle","status":"source_attested"},{"start":315,"end":316,"surface":"后","id":"c-jinshu-031-jia-comparison:p006:m0315","kind":"person","person_id":"jmv_vc4_gep_*AAA","status":"source_attested"},{"start":319,"end":321,"surface":"楊駿","id":"c-jinshu-031-jia-comparison:p006:m0319","kind":"person","person_id":"603_131_11e","status":"source_attested"},{"start":327,"end":328,"surface":"猛","id":"c-jinshu-031-jia-comparison:p006:m0327","kind":"person","person_id":"mqz_jmx_qlo","status":"source_attested"},{"id":"c-jinshu-031-jia-comparison:p006:m0328","start":328,"end":330,"surface":"三兄","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-jinshu-031-jia-comparison","book_id":"b-jinshu-031","work_id":"w-jinshu","source_id":"s-jinshu031-jia-ws2479706-comparison"},{"id":"c-jinshu-031-jia-comparison:p007","text":"及太子廢黜，趙王倫、孫秀等因眾怨謀欲廢后。后數遣宮婢微服於人間視聽，其謀頗泄。后甚懼，遂害太子，以絕眾望。趙王倫乃率兵入宮，使翊軍校尉齊王冏入殿廢后。后與冏母有隙，故倫使之。后驚曰：「卿何為來！」冏曰：「有詔收后。」后曰：「詔當從我出，何詔也？」后至上閤，遙呼帝曰：「陛下有婦，使人廢之，亦行自廢。」又問冏曰：「起事者誰？」冏曰：「梁、趙。」后曰：「繫狗當繫頸，今反繫其尾，何得不然！」至宮西，見謐尸，再舉聲而哭遽止。倫乃矯詔遣尚書劉弘等持節齎金屑酒賜后死。后在位十一年。趙粲、賈午、韓壽、董猛等皆伏誅。","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"first_line":139,"last_line":139,"raw_start":10156,"raw_end":10455,"raw_character_offsets":[10158,10159,10160,10161,10162,10163,10164,10165,1016