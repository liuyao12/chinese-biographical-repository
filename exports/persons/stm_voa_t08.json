1","person_id":"stm_voa_t08","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-051-jingyan","source_id":"s-shiji-051-jingyan","paragraph_id":"c-shiji-051-jingyan:p003","quote":"漢五年，漢王追項籍至固陵，使劉賈南渡淮圍壽春。還至，使人閒招楚大司馬周殷。周殷反楚，佐劉賈舉九江，迎武王黥布兵，皆會垓下，共擊項籍。漢王因使劉賈將九江兵，與太尉盧綰西南擊臨江王共尉。共尉已死，以臨江為南郡。","person_mention_id":"c-shiji-051-jingyan:m003-0091"}],"source_term":"共尉已死","interpretation_note":"本篇明示死亡；欲誅、議當誅及擊破不直接推死亡。回述或相對年數不借別人紀年，來源指控不冒稱獨立核定。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-051-jingyan:m003-0085","start":85,"end":90,"surface":"臨江王共尉","kind":"person","person_id":"stm_voa_t08","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p003","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-051-jingyan:m003-0091","start":91,"end":93,"surface":"共尉","kind":"person","person_id":"stm_voa_t08","status":"contextual_provisional","paragraph_id":"c-shiji-051-jingyan:p003","chapter_id":"c-shiji-051-jingyan"},{"id":"c-shiji-093-hanlu:m009-0024","start":24,"end":26,"surface":"共尉","kind":"person","person_id":"stm_voa_t08","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p009","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[{"id":"th-shiji051-006","person_id":"stm_voa_t08","title":"臨江王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-051-jingyan","source_id":"s-shiji-051-jingyan","paragraph_id":"c-shiji-051-jingyan:p003","quote":"漢五年，漢王追項籍至固陵，使劉賈南渡淮圍壽春。還至，使人閒招楚大司馬周殷。周殷反楚，佐劉賈舉九江，迎武王黥布兵，皆會垓下，共擊項籍。漢王因使劉賈將九江兵，與太尉盧綰西南擊臨江王共尉。共尉已死，以臨江為南郡。"}],"attestations":[{"id":"th-shiji051-006:a001","paragraph_id":"c-shiji-051-jingyan:p003","start":85,"end":88,"surface":"臨江王","person_mention_id":"c-shiji-051-jingyan:m003-0085","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、用稱、請封與條件許諾分開；張卿萬戶侯未記實授，呂產請立與已王語不冒稱同一明示授封事件。未知任期不由卒日或首次用稱推端點。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji093-022","person_id":"stm_voa_t08","title":"臨江王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p009","quote":"漢五年冬，以破項籍，乃使盧綰別將，與劉賈擊臨江王共尉，破之。七月還，從擊燕王臧荼，臧荼降。高祖已定天下，諸侯非劉氏而王者七人。欲王盧綰，為群臣觖望。及虜臧荼，乃下詔諸將相列侯，擇群臣有功者以為燕王。群臣知上欲王盧綰，皆言曰：「太尉長安侯盧綰常從平定天下，功最多，可王燕。」詔許之。漢五年八月，乃立虜綰為燕王。諸侯王得幸莫如燕王。"}],"attestations":[{"id":"th-shiji093-022:a001","paragraph_id":"c-shiji-093-hanlu:p009","start":21,"end":24,"surface":"臨江王","person_mention_id":"c-shiji-093-hanlu:m009-0024","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按實授、自立與用稱保存；許韓王在先不作已授。明示相對年月保持原文，死亡、降漢、失侯之後裔敘事不替本人任期補終點。虜綰原字保留，以本段盧綰主語承接授爵，未核底本影像。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji051-002","person_id":"stm_voa_t08","surfaces":["共尉","臨江王共尉"],"scope":"same_chapter","chapter_ids":["c-shiji-051-jingyan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-051-jingyan:p003","quote":"漢五年，漢王追項籍至固陵，使劉賈南渡淮圍壽春。還至，使人閒招楚大司馬周殷。周殷反楚，佐劉賈舉九江，迎武王黥布兵，皆會垓下，共擊項籍。漢王因使劉賈將九江兵，與太尉盧綰西南擊臨江王共尉。共尉已死，以臨江為南郡。"}],"rationale":"明示名與局部授封、游說角色暫接；劉賈劉澤分開，諸劉疏屬不補支系，田生子不改父名，定國案保存來源敘事不冒稱獨立核定。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji093-034","person_id":"stm_voa_t08","scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","rationale":"明示姓名及局部敘事承接；引古、未名者及短稱另存候選。臧茶與臧荼、高后與呂后待跨稱判讀，不因近形或熟知姓名自動合併。","reviewer":"Codex（AI 代理）","surfaces":["共尉"],"evidence":[{"paragraph_id":"c-shiji-093-hanlu:p009","quote":"漢五年冬，以破項籍，乃使盧綰別將，與劉賈擊臨江王共尉，破之。七月還，從擊燕王臧荼，臧荼降。高祖已定天下，諸侯非劉氏而王者七人。欲王盧綰，為群臣觖望。及虜臧荼，乃下詔諸將相列侯，擇群臣有功者以為燕王