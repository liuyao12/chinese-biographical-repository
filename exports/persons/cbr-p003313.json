{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003313","canonical_person_id":"xwz_db0_zgf","id_aliases":["cbr-p003313"],"identity_policy":"contextual_provisional","person_ids":["xwz_db0_zgf"],"persons":[{"id":"xwz_db0_zgf","label":"李由（曹相國世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"李由","mention_ids":["c-shiji-054-cao:m002-0171","c-shiji-054-cao:m002-0179"]}],"evidence":[{"mention_id":"c-shiji-054-cao:m002-0171","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p002","quote":"李由"},{"mention_id":"c-shiji-054-cao:m002-0179","chapter_id":"c-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p002","quote":"李由"}],"id_aliases":["cbr-p003313"]}],"source_mention_summary":[{"source_id":"s-shiji-054-cao","work_id":"w-shiji","book_id":"b-shiji-054","chapter_id":"c-shiji-054-cao","mention_count":2,"mention_ids":["c-shiji-054-cao:m002-0171","c-shiji-054-cao:m002-0179"],"paragraph_ids":["c-shiji-054-cao:p002"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-054-cao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-054-cao:m002-0171","start":171,"end":173,"surface":"李由","kind":"person","person_id":"xwz_db0_zgf","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p002","chapter_id":"c-shiji-054-cao"},{"id":"c-shiji-054-cao:m002-0179","start":179,"end":181,"surface":"李由","kind":"person","person_id":"xwz_db0_zgf","status":"contextual_provisional","paragraph_id":"c-shiji-054-cao:p002","chapter_id":"c-shiji-054-cao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji054-007","person_id":"xwz_db0_zgf","surfaces":["李由"],"scope":"same_chapter","chapter_ids":["c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-054-cao:p002","quote":"高祖為沛公而初起也，參以中涓從。將擊胡陵、方與，攻秦監公軍，大破之。東下薛，擊泗水守軍薛郭西。復攻胡陵，取之。徙守方與。方與反為魏，擊之。豐反為魏，攻之。賜爵七大夫。擊秦司馬夷[1]軍碭東，破之，取碭、狐父、祁善置。又攻下邑以西，至虞，擊章邯車騎。攻爰戚及亢父，先登。遷為五大夫。北救阿，擊章邯軍，陷陳，追至濮陽。攻定陶，取臨濟。南救雍丘。擊李由軍，破之，殺李由，虜秦候一人。秦將章邯破殺項梁也，沛公與項羽引而東。楚懷王以沛公為碭郡長，將碭郡兵。於是乃封參為執帛，號曰建成君。遷為戚公，屬碭郡。"}],"rationale":"依本篇明示姓名與局部軍事、任官及子嗣敘事暫接；曹氏時、襄不按單字全域配對。未名者不補姓名，秦司馬夷字待底本核定，田既與田溉不擅同指。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-054-cao:p002","text":"高祖為沛公而初起也，參以中涓從。將擊胡陵、方與，攻秦監公軍，大破之。東下薛，擊泗水守軍薛郭西。復攻胡陵，取之。徙守方與。方與反為魏，擊之。豐反為魏，攻之。賜爵七大夫。擊秦司馬夷[1]軍碭東，破之，取碭、狐父、祁善置。又攻下邑以西，至虞，擊章邯車騎。攻爰戚及亢父，先登。遷為五大夫。北救阿，擊章邯軍，陷陳，追至濮陽。攻定陶，取臨濟。南救雍丘。擊李由軍，破之，殺李由，虜秦候一人。秦將章邯破殺項梁也，沛公與項羽引而東。楚懷王以沛公為碭郡長，將碭郡兵。於是乃封參為執帛，號曰建成君。遷為戚公，屬碭郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-054-cao:m002-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"1ch_lpz_g4b","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m002-0003","start":3,"end":5,"surface":"沛公","kind":"person","person_id":"1ch_lpz_g4b","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m002-0010","start":10,"end":11,"surface":"參","kind":"person","person_id":"913_1wz_ofu","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m002-0025","start":25,"end":28,"surface":"秦監公","kind":"person","person_id":"97z_1s7_oq1","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m002-0039","start":39,"end":42,"surface":"泗水守","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名署稱、群體、學說合稱或代詞待核，不補姓名、親屬成員或全域帝號。"},{"id":"c-shiji-054-cao:m002-0084","start":84,"end":88,"surface":"秦司馬夷","kind":"person","person_id":"4gs_evl_a1u","st