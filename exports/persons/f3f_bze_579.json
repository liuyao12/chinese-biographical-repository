ised_by","qualifiers":{"source_term":"為祖母殷氏所養","care_basis":"biography_head_birth_mother_dies_grandmother_care","legal_adoption_status":"not_stated","source_clause_binding":{"kind":"biography_head_birth_mother_dies_grandmother_care","mother_person_mention_id":"c-nanshi-033-pei-family:p014:m0009","clause_anchor":{"paragraph_id":"c-nanshi-033-pei-family:p014","start":0,"end":21,"surface":"子野字幾原，生而母魏氏亡，為祖母殷氏所養。"}}},"interpretation_note":"祖母撫養，與生母魏氏及繼母曹氏分存；養不等於法律收養，不作生母。"}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-grandma","person_id":"f3f_bze_579","surfaces":["祖母"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p002:m0008","c-liangshu-030-peiziye:p002:m0017"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p002","quote":"子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。"}],"rationale":"梁明祖母養且年九祖母亡；南史同事件明殷氏。保祖母／哺養，不在本包推她與祖駰婚姻或生父母。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null},{"id":"d-nanshi033-殷氏","person_id":"f3f_bze_579","surfaces":["殷氏","殷"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-033-pei-family:p014:m0016","c-nanshi-033-pei-family:p014:m0021","c-nanshi-033-pei-family:p014:m0038"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p014","quote":"子野字幾原，生而母魏氏亡，為祖母殷氏所養。殷柔明有文義，以章句授之。年九歲，殷氏亡，泣血哀慟，家人異之。少好學，善屬文，仕齊為江夏王行參軍。遭父憂去職。初，父寢疾彌年，子野禱請備至，涕泗沾濡。父夜夢見其容，旦召視如夢，俄而疾間，以為至孝所感。命著孝感傳，固辭乃止。及居喪，每之墓所，草為之枯。有白兔白鳩馴擾其側。"}],"rationale":"子野生失母由祖母殷氏養，九歲祖母亡；梁030同傳主、同幼年失母祖母教養喪事，補氏稱而不推父系法律關係。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-030-peiziye:p002","text":"子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。","source_position":{"start":275,"end":535,"raw":"　　子野生而偏孤，爲祖母所養，年九歲，祖母亡，泣血哀慟，家人異之。少好學，善屬文。起家齊武陵王國左常侍，右軍江夏王參軍，遭父憂去職。居喪盡禮，每之墓所，哭泣處草爲之枯，有白兔馴擾其側。天監初，尚書僕射范雲嘉其行，將表奏之，會雲卒，不果。樂安任昉有盛名，爲後進所慕，遊其門者，昉必相薦達。子野於昉爲從中表，獨不至，昉亦恨焉。久之，除右軍安成王參軍，俄遷兼廷尉正。時三官通署獄牒，子野嘗不在，同僚輒署其名，奏有不允，子野從坐免職。或勸言諸有司，可得無咎。子野笑而答曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p002:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"4ni_4t1_4o9_BB*AAAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0008","start":8,"end":10,"surface":"祖母","kind":"person","person_id":"f3f_bze_579","status":"contextual_provisional","interpretation_note":"梁明祖母養且年九祖母亡；南史同事件明殷氏。保祖母／哺養，不在本包推她與祖駰婚姻或生父母。"},{"id":"c-liangshu-030-peiziye:p002:m0017","start":17,"end":19,"surface":"祖母","kind":"person","person_id":"f3f_bze_579","status":"contextual_provisional","interpretation_note":"梁明祖母養且年九祖母亡；南史同事件明殷氏。保祖母／哺養，不在本包推她與祖駰婚姻或生父母。"},{"id":"c-liangshu-030-peiziye:p002:m0041","start":41,"end":45,"surface":"齊武陵王","kind":"person","person_id":"i1v_ajd_qr0","status":"contextual_provisional","interpretation_note":"齊武陵王爵號與南齊035武陵昭王曄完整傳及時代相符，暫定同人，非晉武陵王晞；尚未以直接府屬名單交核。"},{"id":"c-liangshu-030-peiziye:p002:m0052","start":52,"end":55,"surface":"江夏王","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"齊世江夏有南齊035鋒、050寶玄兩王完整傳，所讀均未明本句右軍府與子野，不任選；排除宋義恭，保兩正史候選、不創第三人。","candidate_person_ids":[]},{"id":"c-liangshu-030-peiziye:p002:m0059","start":59,"end":60,"surface":"父","kind":"person","person_id":"4ni_4t1_4o9_BB*AAAAA","status":"contextual_provisional","interpretation_note":"梁父昭明，南史駰子昭明／昭明子子野。不得套史記殷祖昭明。"},{"id":"c-liangshu-030-peiziye:p002:m0098","start":98,"end":100,"surface":"范雲","kind":"person","person_id":"nln_ldz_i3j","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0110","start":110,"end":111,"surface":"雲","kind":"person","person_id":"nln_ldz_i3j","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0118","start":118,"end":120,"surface":"任昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0135","start":135,"end":136,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0141","start":141,"end":143,"surface":"子野","kind":"person","person_id":"4ni_4t1_4o9_BB*AAAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0144","start":144,"end":145,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0154","start":154,"end":155,"surface":"昉","kind":"person","person_id":"tvc_q3c_t7w","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0165","start":165,"end":168,"surface":"安成王","kind":"person","person_id":"z8c_kq5_fri","status":"contextual_provisional","interpretation_note":"梁022安成康王秀明天監元封安成、三年右將軍，且傳末明裴子野為王門撰文；與梁030右軍安成王脈絡相符。右軍/右將軍字面差與年份不矯原字，不據此授子野實任年。"},{"id":"c-liangshu-030-peiziye:p002:m0186","start":186,"end":188,"surface":"子野","kind":"person","person_id":"4ni_4t1_4o9_BB*AAAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0196","start":196,"end":197,"surface":"其","kind":"person","person_id":"4ni_4t1_4o9_BB*AAAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0204","start":204,"end":206,"surface":"子野","kind":"person","person_id":"4ni_4t1_4o9_BB*AAAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0223","start":223,"end":225,"surface":"子野","kind":"person","person_id":"4ni_4t1_4o9_BB*AAAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p002:m0233","start":233,"end":235,"surface":"柳季","kind":"person","person_id":"myy_zdg_6b6","status":"contextual_provisional","interpretation_note":"固定《論語註疏》卷15孔注明柳下惠展禽，疏並及柳下季；卷18士師三黜直道不枉之章對上子野兼廷尉正受代署牽連而免職、拒向有司申訟且終無恨意之完整語境。判同柳季，保原稱；不是依同名或單一候選自動配人。古注二十字五十字不作年齡資料。"}],"chapter_id":"c-liangshu-030-peiziye","book_id":"b-liangshu-030","work_id":"w-liangshu","source_id":"s-liang030-ws1508510"},{"text":"子野字幾原，生而母魏氏亡，為祖母殷氏所養。殷柔明有文義，以章句授之。年九歲，殷氏亡，泣血哀慟，家人異之。少好學，善屬文，仕齊為江夏王行參軍。遭父憂去職。初，父寢疾彌年，子野禱請備至，涕泗沾濡。父夜夢見其容，旦召視如夢，俄而疾間，以為至孝所感。命著孝感傳，固辭乃止。及居喪，每之墓所，草為之枯。有白兔白鳩馴擾其側。","source_position":{"start":10144,"end":10300,"raw":"子野字幾原，生而母魏氏亡，為祖母殷氏所養。殷柔明有文義，以章句授之。年九歲，殷氏亡，泣血哀慟，家人異之。少好學，善屬文，仕齊為江夏王行參軍。遭父憂去職。初，父寢疾彌年，子野禱請備至，涕泗沾濡。父夜夢見其容，旦召視如夢，俄而疾間，以為至孝所感。命著孝感傳，固辭乃止。及居喪，每之墓所，草為之枯。有白兔白鳩馴擾其側。","raw_path":"sources/nanshi/wikisource-1554233-raw.w