{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"5p9_b8m_8bf","canonical_person_id":"5p9_b8m_8bf","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["5p9_b8m_8bf"],"persons":[{"id":"5p9_b8m_8bf","label":"馮當（酷吏列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"馮當","mention_ids":["c-shiji-122-kuli:m043-0186"]}],"evidence":[{"mention_id":"c-shiji-122-kuli:m043-0186","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p043","quote":"馮當"}]}],"source_mention_summary":[{"source_id":"s-shiji122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","chapter_id":"c-shiji-122-kuli","mention_count":1,"mention_ids":["c-shiji-122-kuli:m043-0186"],"paragraph_ids":["c-shiji-122-kuli:p043"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji122-kuli"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m043-0186","start":186,"end":188,"surface":"馮當","kind":"person","person_id":"5p9_b8m_8bf","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p043","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p043","text":"太史公曰：自郅都、杜周十人者，此皆以酷烈爲聲。然郅都伉直，引是非，爭天下大體。張湯以知陰陽，人主與倶上下，時數辯當否，國家賴其便。趙禹時據法守正。杜周從諛，以少言爲重。自張湯死後，網密，多詆嚴，官事寖以秏廢。九卿碌碌┐其官，救過不贍，何暇論繩墨之外乎！然此十人中，其廉者足以爲儀表，其汚者足以爲戒，方略教導，禁姦止邪，一切亦皆彬彬質有其文武焉。雖慘酷，斯稱其位矣。至若蜀守馮當暴挫，廣漢李貞擅磔人，東郡彌仆鋸項，天水駱璧推咸，河東褚廣妄殺，京兆無忌、馮翊殷周蝮鷙，水衡閻奉樸撃賣請，何足數哉！何足數哉！","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m043-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"42d_lp1_gxc","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0006","start":6,"end":8,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0009","start":9,"end":11,"surface":"杜周","kind":"person","person_id":"dxx_6m8_7o6","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0011","start":11,"end":13,"surface":"十人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m043-0024","start":24,"end":26,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0039","start":39,"end":41,"surface":"張湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0065","start":65,"end":67,"surface":"趙禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0073","start":73,"end":75,"surface":"杜周","kind":"person","person_id":"dxx_6m8_7o6","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0085","start":85,"end":87,"surface":"張湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0104","start":104,"end":106,"surface":"九卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m043-0128","start":128,"end":130,"surface":"十人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m043-0186","start":186,"end":188,"surface":"馮當","kind":"person","person_id":"5p9_b8m_8bf","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m043-0193","start":193,"end":195,"surface":"李貞","kind":"person","person_id":"3yu_1d6_ex4","status":"contextual_provisional"},{"id":"c-shiji-12