伏法。机兄弟既江南之秀，亦著名诸夏，并以无罪夷灭，天下痛惜之。机文章为世所重，云所著亦传於世。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0020","start":20,"end":22,"surface":"张华","kind":"person","person_id":"1dq_vh2_eru","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0023","start":23,"end":24,"surface":"华","kind":"person","person_id":"1dq_vh2_eru","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0058","start":58,"end":60,"surface":"杨骏","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0061","start":61,"end":62,"surface":"机","kind":"person","person_id":"69h_uhy_hta","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0078","start":78,"end":79,"surface":"云","kind":"person","person_id":"40p_eb9_ggr_D","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0080","surface":"吴王","start":80,"end":82,"kind":"person","person_id":"k08_xhu_k3k","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0112","start":112,"end":113,"surface":"机","kind":"person","person_id":"69h_uhy_hta","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0128","start":128,"end":129,"surface":"云","kind":"person","person_id":"40p_eb9_ggr_D","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0138","start":138,"end":139,"surface":"机","kind":"person","person_id":"69h_uhy_hta","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-lukang:line087-pei02-02:m0155","