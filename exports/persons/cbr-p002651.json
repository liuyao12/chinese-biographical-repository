erson","person_id":"l9e_fbr_36a","status":"contextual_provisional"},{"id":"c-shiji-045-han:m029-0037","start":37,"end":40,"surface":"太子咎","kind":"person","person_id":"c0i_eah_y59","status":"contextual_provisional"},{"id":"c-shiji-045-han:m029-0044","start":44,"end":46,"surface":"釐王","kind":"person","person_id":"c0i_eah_y59","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-045-han:p030","text":"釐王三年，使公孫喜率周、魏攻秦。秦敗我二十四萬，虜喜伊闕。五年，秦拔我宛。六年，與秦武遂地二百里。十年，秦敗我師于夏山。十二年，與秦昭王會西周而佐秦攻齊。齊敗，湣王出亡。十四年，與秦會兩周閒。二十一年，使暴捐救魏，爲秦所敗，捐走開封。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m030-0000","start":0,"end":2,"surface":"釐王","kind":"person","person_id":"c0i_eah_y59","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0006","start":6,"end":9,"surface":"公孫喜","kind":"person","person_id":"nzo_n0u_8s5","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0025","start":25,"end":26,"surface":"喜","kind":"person","person_id":"nzo_n0u_8s5","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0065","start":65,"end":68,"surface":"秦昭王","kind":"person","person_id":"7r3_beh_4ty","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0080","start":80,"end":82,"surface":"湣王","kind":"person","person_id":"q4s_qe2_uq2","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0102","start":102,"end":104,"surface":"暴捐","kind":"person","person_id":"kr3_soq_kkq","status":"contextual_provisional"},{"id":"c-shiji-045-han:m030-0112","start":112,"end":113,"surface":"捐","kind":"person","person_id":"kr3_soq_kkq","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"},{"id":"c-shiji-045-han:p031","text":"二十三年，趙、魏攻我華陽。韓告急於秦，秦不救。韓相國謂陳筮曰：「事急，願公雖病，爲一宿之行。」陳筮見穰侯。穰侯曰：「事急乎？故使公來。」陳筮曰：「未急也。」穰侯怒曰：「是可以爲公之主使乎？夫冠蓋相望，告敝邑甚急，公來言未急，何也？」陳筮曰：「彼韓急則將變而佗從，以未急，故復來耳。」穰侯曰：「公無見王，請今發兵救韓。」八日而至，敗趙、魏於華陽之下。是歳，釐王卒，子桓惠王立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m031-0023","start":23,"end":26,"surface":"韓相國","kind":"person","person_id":"c3r_z15_12i","status":"contextual_provisional"},{"id":"c-shiji-045-han:m031-0027","start":27,"end":29,"surface":"陳筮","kind":"person","person_id":"jmm_0ez_y53","status":"contextual_provisional"},{"id":"c-shiji-045-han:m031-0036","start":36,"end":37,"surface":"公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m031-0047","start":47,"end":49,"surface":"陳筮","kind":"person","person_id":"jmm_0ez_y53","status":"contextual_provisional"},{"id":"c-shiji-045-han:m031-0050","start":50,"end":52,"surface":"穰侯","kind":"person","person_id":"a72_80l_b8r","status":"contextual_provisional"},{"id":"c-shiji-045-han:m031-0053","start":53,"end":55,"surface":"穰侯","kind":"person","person_id":"a72_80l_b8r","status":"contextual_provisional"},{"id":"c-shiji-045-han:m031-0064","start":64,"end":65,"surface":"公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m031-0068","start":68,"end":70,"surface":"陳筮","kind":"person","person_id":"jmm_0ez_y53","status":"contextual_provisional"},{"id":"c-shiji-045-han:m031-0078","start":78,"end":80,"surface":"穰侯","kind":"person","person_id":"a72_80l_b8r","status":"contextual_provisional"},{"id":"c-shiji-045-han:m031-0088","start":88,"end":89,"surface":"公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m031-0090","start":90,"end":91,"surface":"主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話指代或未名者保留；當前與引語回敘秦王不預接，爭太子不作已授太子，大業不先定祖名。"},{"id":"c-shiji-045-han:m031-0106","start":106,"end":107,"surface":"公",