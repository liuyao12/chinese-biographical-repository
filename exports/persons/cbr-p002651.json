:m033-0005"]}],"evidence":[{"mention_id":"c-shiji-045-han:m031-0182","chapter_id":"c-shiji-045-han","paragraph_id":"c-shiji-045-han:p031","quote":"桓惠王"},{"mention_id":"c-shiji-045-han:m032-0000","chapter_id":"c-shiji-045-han","paragraph_id":"c-shiji-045-han:p032","quote":"桓惠王"},{"mention_id":"c-shiji-045-han:m033-0005","chapter_id":"c-shiji-045-han","paragraph_id":"c-shiji-045-han:p033","quote":"桓惠王"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-045-han","source_id":"s-shiji-045-han","paragraph_id":"c-shiji-045-han:p031","quote":"二十三年，趙、魏攻我華陽。韓告急於秦，秦不救。韓相國謂陳筮曰：「事急，願公雖病，爲一宿之行。」陳筮見穰侯。穰侯曰：「事急乎？故使公來。」陳筮曰：「未急也。」穰侯怒曰：「是可以爲公之主使乎？夫冠蓋相望，告敝邑甚急，公來言未急，何也？」陳筮曰：「彼韓急則將變而佗從，以未急，故復來耳。」穰侯曰：「公無見王，請今發兵救韓。」八日而至，敗趙、魏於華陽之下。是歳，釐王卒，子桓惠王立。","source_term":"釐王卒，子桓惠王立"}],"source_assertion_id":"a-shiji045-017","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"c0i_eah_y59"},"id_aliases":["cbr-p002661"]}],"source_mention_summary":[{"source_id":"s-shiji-045-han","work_id":"w-shiji","book_id":"b-shiji-045","chapter_id":"c-shiji-045-han","mention_count":8,"mention_ids":["c-shiji-045-han:m026-0009","c-shiji-045-han:m026-0032","c-shiji-045-han:m026-0120","c-shiji-045-han:m028-0158","c-shiji-045-han:m029-0037","c-shiji-045-han:m029-0044","c-shiji-045-han:m030-0000","c-shiji-045-han:m031-0177"],"paragraph_ids":["c-shiji-045-han:p026","c-shiji-045-han:p028","c-shiji-045-han:p029","c-shiji-045-han:p030","c-shiji-045-han:p031"],"passage_count":5}],"most_mentioned_source_ids":["s-shiji-045-han"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji045-017","subject_person_id":"c0i_eah_y59_A","predi