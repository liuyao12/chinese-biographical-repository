ce_ids":["s-nanqishu-047-current-rendered-xietiao","s-zizhitongjian-142-ws2316525-current-rendered-xietiao"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-nanqi047-zuoxingsheng","person_id":"kdm_jny_xgb","surname":"左","ming":"興盛","additional_names":[],"chapter_id":"c-nanqishu-047-xietiao-rendered","paragraph_id":"c-nanqishu-047-xietiao-rendered:p007","person_mention_id":"c-nanqishu-047-xietiao-rendered:p007:m0018","source_anchor":{"chapter_id":"c-nanqishu-047-xietiao-rendered","paragraph_id":"c-nanqishu-047-xietiao-rendered:p007","mention_id":"c-nanqishu-047-xietiao-rendered:p007:m0018","start":138,"end":141,"surface":"左興盛","person_id":"kdm_jny_xgb"},"quote":"東昏失德，江祐欲立夏王寶玄，末更回惑，與弟祀密謂朓曰：「江夏年少輕脫，不堪負荷神器，不可復行廢立。始安年長入纂，不乖物望。非以此要富貴，政是求安國家耳。」遙光又遣親人劉渢密致意於朓，欲以爲肺腑。朓自以受恩高宗，非渢所言，不肯答。少日，遙光以朓兼知衞尉事，朓懼見引，卽以祏等謀告左興盛，興盛不敢發言。祏聞，以告遙光，遙光大怒，乃稱敕召朓，仍回車付廷尉，與徐孝嗣、祏、暄等連名啓誅朓曰：「謝朓資性險薄，大彰遠近。王敬則往構凶逆，微有誠效，自爾昇擢，超越倫伍。而谿壑無厭，著於觸事。比遂扇動內外，處處姦說，妄貶乘輿，竊論宮禁，閒謗親賢，輕議朝宰，醜言異計，非可具聞。無君之心旣著，共棄之誅宜及。臣等參議，宜下北里，肅正刑書。」詔：「公等啓事如此，朓資性輕險，久彰物議。直以彫蟲薄伎，見齒衣冠。昔在渚宮，構扇蕃邸，日夜縱諛，仰窺俯畫。及還京師，飜自宣露，江、漢無波，以爲己功。素論於茲而盡，縉紳所以側目。去夏之事，頗有微誠，賞擢曲加，踰邁倫序，感悅未聞，陵競彌著。遂復矯構風塵，妄惑朱紫，詆貶朝政，疑閒親賢。巧言利口，見醜前志，涓流纖孽，作戒遠圖。宜有少正之刑，以申去害之義。便可收付廷尉，肅明國典。」又使御史中丞范岫奏收朓，下獄死。時年三十六。","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"此段完整原姓名供構件，非由職稱或ID拆姓。","work_id":"w-nanqishu","book_id":"b-nanqishu-047","source_id":"s-nanqishu-047-current-rendered-xietiao"}],"mentions":[{"id":"c-nanqishu-047-xietiao-rendered:p007:m0018","start":138,"end":141,"surface":"左興盛","kind":"person","person_id":"kdm_jny_xgb","status":"contextual_provisional","paragraph_id":"c-nanqishu-047-xietiao-rendered:p007","chapter_id":"c-nanqishu-047-xietiao-rendered"},{"id":"c-nanqishu-047-xietiao-rendered:p007:m0019","start":142,"end":144,"surface":"興盛","kind":"person","person_id":"kdm_jny_xgb","status":"contextual_provisional","paragraph_id":"c-nanqishu-047-xietiao-rendered:p007","chapter_id":"c-nanqishu-047-xietiao-rendered"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0014","kind":"person","start":114,"end":117,"surface":"左興盛","status":"contextual_provisional","source_role":"zuoxingsheng","person_id":"kdm_jny_xgb","paragraph_id":"c-zizhitongjian-142-xietiao-death-rendered:p001","chapter_id":"c-zizhitongjian-142-xietiao-death-rendered"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0015","kind":"person","start":118,"end":120,"surface":"興盛","status":"contextual_provisional","source_role":"zuoxingsheng","person_id":"kdm_jny_xgb","paragraph_id":"c-zizhitongjian-142-xietiao-death-rendered:p001","chapter_id":"c-zizhitongjian-142-xietiao-death-rendered"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi047-xietiao-zuoxingsheng","person_id":"kdm_jny_xgb","surfaces":["左興盛","興盛"],"scope":"same_chapter","chapter_ids":["c-nanqishu-047-xietiao-rendered"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-047","source_id":"s-nanqishu-047-current-rendered-xietiao","chapter_id":"c-nanqishu-047-xietiao-rendered","paragraph_id":"c-nanqishu-047-xietiao-rendered:p007","quote":"東昏失德，江祐欲立夏王寶玄，末更回惑，與弟祀密謂朓曰：「江夏年少輕脫，不堪負荷神器，不可復行廢立。始安年長入纂，不乖物望。非以此要富貴，政是求安國家耳。」遙光又遣親人劉渢密致意於朓，欲以爲肺腑。朓自以受恩高宗，非渢所言，不肯答。少日，遙光以朓兼知衞尉事，朓懼見引，卽以祏等謀告左興盛，興盛不敢發言。祏聞，以告遙光，遙光大怒，乃稱敕召朓，仍回車付廷尉，與徐孝嗣、祏、暄等連名啓誅朓曰：「謝朓資性險薄，大彰遠近。王敬則往構凶逆，微有誠效，自爾昇擢，超越倫伍。而谿壑無厭，著於觸事。比遂扇動內外，處處姦說，妄貶乘輿，竊論宮禁，閒謗親賢，輕議朝宰，醜言異計，非可具聞。無君之心旣著，共棄之誅宜及。臣等參議，宜下北里，肅正刑書。」詔：「公等啓事如此，朓資性輕險，久彰物議。直以彫蟲薄伎，見齒衣冠。昔在渚宮，構扇蕃邸，日夜縱諛，仰窺俯畫。及還京師，飜自宣露，江、漢無波，以爲己功。素論於茲而盡，縉紳所以側目。去夏之事，頗有微誠，賞擢曲加，踰邁倫序，感悅未聞，陵競彌著。遂復矯構風塵，妄惑朱紫，詆貶朝政，疑閒親賢。巧言利口，見醜前志，涓流纖孽，作戒遠圖。宜有少正之刑，以申去害之義。便可收付廷尉，肅明國典。」又使御史中丞范岫奏收朓，下獄死。時年三十六。","mention_ids":["c-nanqishu-047-xietiao-rendered:p007:m0018"]},{"work_id":"w-nanqishu","book_id":"b-nanqishu-047","source_id":"s-nanqishu-047-current-rendered-xietiao","chapter_id":"c-nanqishu-047-xietiao-rendered","paragraph_id":"c-nanqishu-047-xietiao-rendered:p007","quote":"東昏失德，江祐欲立夏王寶玄，末更回惑，與弟祀密謂朓曰：「江夏年少輕脫，不堪負荷神器，不可復行廢立。始安年長入纂，不乖物望。非以此要富貴，政是求安國家耳。」遙光又遣親人劉渢密致意於朓，欲以爲肺腑。朓自以受恩高宗，非渢所言，不肯答。少日，遙光以朓兼知衞尉事，朓懼見引，卽以祏等謀告左興盛，興盛不敢發言。祏聞，以告遙光，遙光大怒，乃稱敕召朓，仍回車付廷尉，與徐孝嗣、祏、暄等連名啓誅朓曰：「謝朓資性險薄，大彰遠近。王敬則往構凶逆，微有誠效，自爾昇擢，超越倫伍。而谿壑無厭，著於觸事。比遂扇動內外，處處姦說，妄貶乘輿，竊論宮禁，閒謗親賢，輕議朝宰，醜言異計，非可具聞。無君之心旣著，共棄之誅宜及。臣等參議，宜下北里，肅正刑書。」詔：「公等啓事如此，朓資性輕險，久彰物議。直以彫蟲薄伎，見齒衣冠。昔在渚宮，構扇蕃邸，日夜縱諛，仰窺俯畫。及還京師，飜自宣露，江、漢無波，以爲己功。素論於茲而盡，縉紳所以側目。去夏之事，頗有微誠，賞擢曲加，踰邁倫序，感悅未聞，陵競彌著。遂復矯構風塵，妄惑朱紫，詆貶朝政，疑閒親賢。巧言利口，見醜前志，涓流纖孽，作戒遠圖。宜有少正之刑，以申去害之義。便可收付廷尉，肅明國典。」又使御史中丞范岫奏收朓，下獄死。時年三十六。","mention_ids":["c-nanqishu-047-xietiao-rendered:p007:m0019"]}],"rationale":"依此完整傳文的明名、時序及語境稱謂辨識；原詞不改，未移轉引古人物的當代事件。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-047-xietiao-rendered:p007","text":"東昏失德，江祐欲立夏王寶玄，末更回惑，與弟祀密謂朓曰：「江夏年少輕脫，不堪負荷神器，不可復行廢立。始安年長入纂，不乖物望。非以此要富貴，政是求安國家耳。」遙光又遣親人劉渢密致意於朓，欲以爲肺腑。朓自以受恩高宗，非渢所言，不肯答。少日，遙光以朓兼知衞尉事，朓懼見引，卽以祏等謀告左興盛，興盛不敢發言。祏聞，以告遙光，遙光大怒，乃稱敕召朓，仍回車付廷尉，與徐孝嗣、祏、暄等連名啓誅朓曰：「謝朓資性險薄，大彰遠近。王敬則往構凶逆，微有誠效，自爾昇擢，超越倫伍。而谿壑無厭，著於觸事。比遂扇動內外，處處姦說，妄貶乘輿，竊論宮禁，閒謗親賢，輕議朝宰，醜言異計，非可具聞。無君之心旣著，共棄之誅宜及。臣等參議，宜下北里，肅正刑書。」詔：「公等啓事如此，朓資性輕險，久彰物議。直以彫蟲薄伎，見齒衣冠。昔在渚宮，構扇蕃邸，日夜縱諛，仰窺俯畫。及還京師，飜自宣露，江、漢無波，以爲己功。素論於茲而盡，縉紳所以側目。去夏之事，頗有微誠，賞擢曲加，踰邁倫序，感悅未聞，陵競彌著。遂復矯構風塵，妄惑朱紫，詆貶朝政，疑閒親賢。巧言利口，見醜前志，涓流纖孽，作戒遠圖。宜有少正之刑，以申去害之義。便可收付廷尉，肅明國典。」又使御史中丞范岫奏收朓，下獄死。時年三十六。","text_layer":"received_chapter","mentions":[{"id":"c-nanqishu-047-xietiao-rendered: