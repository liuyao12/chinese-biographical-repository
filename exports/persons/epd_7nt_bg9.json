"work_id":"w-shiji","source_id":"s-shiji-053-xiao"},{"id":"c-shiji-053-xiao:p017","text":"太史公曰：蕭相國何於秦時為刀筆吏，錄錄未有奇節。及漢興，依日月之末光，何謹守管籥，因民之疾法，順流與之更始。淮陰、黥布等皆以誅滅，而何之勳爛焉。位冠群臣，聲施後世，與閎夭、散宜生等爭烈矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-053-xiao:m017-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"j31_jbm_64m","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m017-0005","start":5,"end":9,"surface":"蕭相國何","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m017-0035","start":35,"end":36,"surface":"何","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m017-0054","start":54,"end":56,"surface":"淮陰","kind":"person","person_id":"ddb_bi5_eco","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m017-0057","start":57,"end":59,"surface":"黥布","kind":"person","person_id":"epd_7nt_bg9","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m017-0066","start":66,"end":67,"surface":"何","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m017-0074","start":74,"end":76,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m017-0083","start":83,"end":85,"surface":"閎夭","kind":"person","person_id":"yuo_kpg_rhg","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m017-0086","start":86,"end":89,"surface":"散宜生","kind":"person","person_id":"syq_5uv_2me","status":"contextual_provisional"}],"chapter_id":"c-shiji-053-xiao","book_id":"b-shiji-053","work_id":"w-shiji","source_id":"s-shiji-053-xiao"}],"sources":[{"chapter_id":"c-shiji-053-xiao","work_id":"w-shiji","book_id":"b-shiji-053","source_id":"s-shiji-053-xiao","source":{"title":"史記／卷053","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷053","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷