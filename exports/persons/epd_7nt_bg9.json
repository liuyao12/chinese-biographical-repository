{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"epd_7nt_bg9","canonical_person_id":"epd_7nt_bg9","id_aliases":["cbr-p003297"],"identity_policy":"contextual_provisional","person_ids":["epd_7nt_bg9"],"persons":[{"id":"epd_7nt_bg9","label":"黥布（蕭相國世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"黥布","mention_ids":["c-shiji-053-xiao:m011-0006","c-shiji-053-xiao:m012-0262","c-shiji-053-xiao:m017-0057"]},{"surface":"布","mention_ids":["c-shiji-053-xiao:m012-0002"]}],"evidence":[{"mention_id":"c-shiji-053-xiao:m011-0006","chapter_id":"c-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p011","quote":"黥布"},{"mention_id":"c-shiji-053-xiao:m012-0262","chapter_id":"c-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p012","quote":"黥布"},{"mention_id":"c-shiji-053-xiao:m017-0057","chapter_id":"c-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p017","quote":"黥布"},{"mention_id":"c-shiji-053-xiao:m012-0002","chapter_id":"c-shiji-053-xiao","paragraph_id":"c-shiji-053-xiao:p012","quote":"布"}],"id_aliases":["cbr-p003297"]}],"source_mention_summary":[{"source_id":"s-shiji-053-xiao","work_id":"w-shiji","book_id":"b-shiji-053","chapter_id":"c-shiji-053-xiao","mention_count":4,"mention_ids":["c-shiji-053-xiao:m011-0006","c-shiji-053-xiao:m012-0002","c-shiji-053-xiao:m012-0262","c-shiji-053-xiao:m017-0057"],"paragraph_ids":["c-shiji-053-xiao:p011","c-shiji-053-xiao:p012","c-shiji-053-xiao:p017"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-053-xiao"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-053-xiao:m011-0006","start":6,"end":8,"surface":"黥布","kind":"person","person_id":"epd_7nt_bg9","status":"contextual_provisional","paragraph_id":"c-shiji-053-xiao:p011","chapter_id":"c-shiji-053-xiao"},{"id":"c-shiji-053-xiao:m012-0002","start":2,"end":3,"surface":"布","kind":"person","person_id":"epd_7nt_bg9","status":"contextual_provisional","paragraph_id":"c-shiji-053-xiao:p012","chapter_id":"c-shiji-053-xiao"},{"id":"c-shiji-053-xiao:m012-0262","start":262,"end":264,"surface":"黥布","kind":"person","person_id":"epd_7nt_bg9","status":"contextual_provisional","paragraph_id":"c-shiji-053-xiao:p012","chapter_id":"c-shiji-053-xiao"},{"id":"c-shiji-053-xiao:m017-0057","start":57,"end":59,"surface":"黥布","kind":"person","person_id":"epd_7nt_bg9","status":"contextual_provisional","paragraph_id":"c-shiji-053-xiao:p017","chapter_id":"c-shiji-053-xiao"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji053-012","person_id":"epd_7nt_bg9","surfaces":["布","黥布"],"scope":"same_chapter","chapter_ids":["c-shiji-053-xiao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-053-xiao:p011","quote":"漢十二年秋，黥布反，上自將擊之，數使使問相國何為。相國為上在軍，乃拊循勉力百姓，悉以所有佐軍，如陳豨時。客有說相國曰：「君滅族不久矣。夫君位為相國，功第一，可複加哉？然君初入關中，得百姓心，十餘年矣，皆附君，常複孳孳得民和。上所為數問君者，畏君傾動關中。今君胡不多買田地，賤貰貸以自汙？上心乃安。」於是相國從其計，上乃大說。"},{"paragraph_id":"c-shiji-053-xiao:p012","quote":"上罷布軍歸，民道遮行上書，言相國賤彊買民田宅數千萬。上至，相國謁。上笑曰：「夫相國乃利民！」民所上書皆以與相國，曰：「君自謝民。」相國因為民請曰：「長安地狹，上林中多空地，棄，原令民得入田，毋收槁為禽獸食。」上大怒曰：「相國多受賈人財物，乃為請吾苑！」乃下相國廷尉，械繫之。數日，王衛尉侍，前問曰：「相國何大罪，陛下系之暴也？」上曰：「吾聞李斯相秦皇帝，有善歸主，有惡自與。今相國多受賈豎金而為民請吾苑，以自媚於民，故系治之。」王衛尉曰：「夫職事苟有便於民而請之，真宰相事，陛下奈何乃疑相國受賈人錢乎！且陛下距楚數歲，陳豨、黥布反，陛下自將而往，當是時，相國守關中，搖足則關以西非陛下有也。相國不以此時為利，今乃利賈人之金乎？且秦以不聞其過亡天下，李斯之分過，又何足法哉。陛下何疑宰相之淺也。」高帝不懌。是日，使使持節赦出相國。相國年老，素恭謹，入，徒跣謝。高帝曰：「相國休矣！相國為民請苑，吾不許，我不過為桀紂主，而相國為賢相。吾故系相國，欲令百姓聞吾過也。」"},{"paragraph_id":"c-shiji-053-xiao:p017","quote":"太史公曰：蕭相國何於秦時為刀筆吏，錄錄未有奇節。及漢興，依日月之末光，何謹守管籥，因民之疾法，順流與之更始。淮陰、黥布等皆以誅滅，而何之勳爛焉。位冠群臣，聲施後世，與閎夭、散宜生等爭烈矣。"}],"rationale":"依明示名與局部丞相、相國及軍事敘事暫接，何字先排疑問詞；秦東陵侯召平不接齊相，未名署稱不補姓名，桀紂為比擬人物不冒稱當時在場。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-053-xiao:p011","text":"漢十二年秋，黥布反，上自將擊之，數使使問相國何為。相國為上在軍，乃拊循勉力百姓，悉以所有佐軍，如陳豨時。客有說相國曰：「君滅族不久矣。夫君位為相國，功第一，可複加哉？然君初入關中，得百姓心，十餘年矣，皆附君，常複孳孳得民和。上所為數問君者，畏君傾動關中。今君胡不多買田地，賤貰貸以自汙？上心乃安。」於是相國從其計，上乃大說。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-053-xiao:m011-0006","start":6,"end":8,"surface":"黥布","kind":"person","person_id":"epd_7nt_bg9","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m011-0010","start":10,"end":11,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m011-0020","start":20,"end":22,"surface":"相國","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m011-0025","start":25,"end":27,"surface":"相國","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m011-0028","start":28,"end":29,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m011-0048","start":48,"end":50,"surface":"陳豨","kind":"person","person_id":"llz_pjb_0um","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m011-0052","start":52,"end":53,"surface":"客","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、官署或未定回指；不補姓名或後嗣成員。"},{"id":"c-shiji-053-xiao:m011-0055","start":55,"end":57,"surface":"相國","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m011-0071","start":71,"end":73,"surface":"相國","kind":"person","person_id":"ic8_7be_6x3","status":"contextual_provisional"},{"id":"c-shiji-053-xiao:m011-0112","start":112,"end":113,"surface":"上","kind":"unresolved","person_id":null,"status":"unresolved","not