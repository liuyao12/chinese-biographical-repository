contextual_provisional"},{"id":"c-nanqishu-044-shenwenji-complete:p007:m0691","start":691,"end":693,"surface":"宇之","kind":"person","person_id":"z53_7ry_s10","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-044-shenwenji-complete","book_id":"b-nanqishu-044","work_id":"w-nanqishu","source_id":"s-nanqishu-044-shenwenji-complete-ws1507959"},{"id":"c-nanshi-022-wangsengqian:p011","text":"僧虔頗解星文，夜坐見豫章分野當有事故，時僧虔子慈為豫章內史，慮有公事；少時而僧虔薨，棄郡奔赴。時有前將軍陳天福，坐討唐宇之于錢唐掠奪百姓財物棄市。先是天福將行，令家人豫作壽塚，未至東，又信催速就。塚成而得罪，因以葬焉。又宋世光祿大夫劉鎮之年三十許，病篤，已辦凶具；既而疾愈，因畜棺以為壽，九十餘乃亡，此器方用。因此而言，天道未易知也。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":2,"surface":"僧虔","id":"c-nanshi-022-wangsengqian:p011:m0000","person_id":"7r6_k52_qji_ABAAAAEB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作sq。"},{"start":20,"end":22,"surface":"僧虔","id":"c-nanshi-022-wangsengqian:p011:m0020","person_id":"7r6_k52_qji_ABAAAAEB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作sq。"},{"start":23,"end":24,"surface":"慈","id":"c-nanshi-022-wangsengqian:p011:m0023","person_id":"7r6_k52_qji_ABAAAAEBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作ci。"},{"start":38,"end":40,"surface":"僧虔","id":"c-nanshi-022-wangsengqian:p011:m0038","person_id":"7r6_k52_qji_ABAAAAEB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作sq。"},{"start":52,"end":55,"surface":"陳天福","id":"c-nanshi-022-wangsengqian:p011:m0052","person_id":"1vs_gdp_2dy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作chen。"},{"start":58,"end":61,"surface":"唐宇之","id":"c-nanshi-022-wangsengqian:p011:m0058","person_id":"z53_7ry_s10","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作tang。"},{"start":66,"end":68,"surface":"百姓","id":"c-nanshi-022-wangsengqian:p011:u0066","kind":"unresolved","person_id":null,"status":"unresolve