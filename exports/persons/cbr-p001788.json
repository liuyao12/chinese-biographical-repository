s":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-226","person_id":"ztm_pmc_2w7","surfaces":["蕭桐姪子"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p101","quote":"十一年春，齊伐魯，取隆。魯告急衞，衞與魯皆因郤克告急於晉。晉乃使郤克、欒書、韓厥以兵車八百乘與魯、衞共伐齊。夏，與頃公戰於砹傷困頃公。頃公乃與其右易位，下取飲，以得脱去。齊師敗走，晉追北至齊。頃公獻寶器以求平，不聽。郤克曰：「必得蕭桐姪子爲質。」齊使曰：「蕭桐姪子，頃公母；頃公母猶晉君母，柰何必得之？不義，請復戰。」晉乃許與平而去。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p101","text":"十一年春，齊伐魯，取隆。魯告急衞，衞與魯皆因郤克告急於晉。晉乃使郤克、欒書、韓厥以兵車八百乘與魯、衞共伐齊。夏，與頃公戰於砹傷困頃公。頃公乃與其右易位，下取飲，以得脱去。齊師敗走，晉追北至齊。頃公獻寶器以求平，不聽。郤克曰：「必得蕭桐姪子爲質。」齊使曰：「蕭桐姪子，頃公母；頃公母猶晉君母，柰何必得之？不義，請復戰。」晉乃許與平而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m101-0022","start":22,"end":24,"surface":"郤克","kind":"person","person_id":"xx7_loh_2ge","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0032","start":32,"end":34,"surface":"郤克","kind":"person","person_id":"xx7_loh_2ge","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0038","start":38,"end":40,"surface":"韓厥","kind":"person","person_id":"y3i_rsz_brn","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0057","start":57,"end":59,"surface":"頃公","kind":"person","person_id":"9w2_c77_53m_AA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0064","start":64,"end":66,"surface":"頃公","kind":"person","person_id":"9w2_c77_53m_AA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0067","start":67,"end":69,"surface":"頃公","kind":"person","person_id":"9w2_c77_53m_AA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m101-0071","start":71,"end":73,"surface":"其右","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校