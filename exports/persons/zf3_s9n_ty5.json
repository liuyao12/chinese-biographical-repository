contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji032-044","subject_person_id":"zf3_s9n_ty5","predicate":"mother","object_person_id":"m0l_71n_b8f","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p061","quote":"二十八年，初，靈公取魯女，生子光，以為太子。仲姬，戎姬。戎姬嬖，仲姬生子牙，屬之戎姬。戎姬請以為太子，公許之。仲姬曰：「不可。光之立，列於諸侯矣，今無故廢之，君必悔之。」公曰：「在我耳。」遂東太子光，使高厚傅牙為太子。靈公疾，崔杼迎故太子光而立之，是為莊公。莊公殺戎姬。五月壬辰，靈公卒，莊公即位，執太子牙於句竇之丘，殺之。八月，崔杼殺高厚。晉聞齊亂，伐齊，至高唐。"}],"qualifiers":{"source_term":"生子牙","historicity":"historical_tradition"},"interpretation_note":"逐項保存本文父母、異母兄弟、婚姻及曾祖關係；無咎父未名，偃之其弟指代未定，不由熟知世系補名或闕代。來源記載不當已確證身世。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-032-qi:m061-0035","start":35,"end":37,"surface":"子牙","kind":"person","person_id":"zf3_s9n_ty5","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p061","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m061-0104","start":104,"end":105,"surface":"牙","kind":"person","person_id":"zf3_s9n_ty5","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p061","chapter_id":"c-shiji-032-qi"},{"id":"c-shiji-032-qi:m061-0150","start":150,"end":153,"surface":"太子牙","kind":"person","person_id":"zf3_s9n_ty5","status":"contextual_provisional","paragraph_id":"c-shiji-032-qi:p061","chapter_id":"c-shiji-032-qi"}],"relations":[{"id":"a-shiji032-044","subject_person_id":"zf3_s9n_ty5","predicate":"mother","object_person_id":"m0l_71n_b8f","status":"source_attested","evidence":[{"chapter_id":"c-shiji-032-qi","source_id":"s-shiji-032-qi","paragraph_id":"c-shiji-032-qi:p061","quote":"二十八年，初，靈公取魯女，生子光，以為太子。仲姬，戎姬。戎姬嬖，仲姬生子牙，屬之戎姬。戎姬請以為太子，公許之。仲姬曰：「不可。光之立，列於諸侯矣，今無故廢之，君必悔之。」公