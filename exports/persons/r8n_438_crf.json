{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"r8n_438_crf","canonical_person_id":"r8n_438_crf","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["r8n_438_crf"],"persons":[{"id":"r8n_438_crf","label":"司馬無忌","status":"active","historicity":"historical_tradition","aliases":[{"surface":"無忌","mention_ids":["c-jinshu-073-yuyi:p011:m0097"]}],"evidence":[{"mention_id":"c-jinshu-073-yuyi:p011:m0097","paragraph_id":"c-jinshu-073-yuyi:p011","chapter_id":"c-jinshu-073-yuyi","quote":"無忌"}],"review":"ai_provisional","identity_note":"司馬無忌，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-073-yuyi-ws2296501","work_id":"w-jinshu","book_id":"b-jinshu-073","chapter_id":"c-jinshu-073-yuyi","raw_mention_count":1,"mention_ids":["c-jinshu-073-yuyi:p011:m0097"],"paragraph_ids":["c-jinshu-073-yuyi:p011"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-073-yuyi:p011:m0097","mention_ids":["c-jinshu-073-yuyi:p011:m0097"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-073-yuyi-ws2296501"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-073-yuyi:p011:m0097","surface":"無忌","start":97,"end":99,"person_id":"r8n_438_crf","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-073-yuyi:p011","chapter_id":"c-jinshu-073-yuyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-073-yuyi:p011","text":"翼時有眾四萬，詔加都督征討軍事。師次襄陽，大會僚佐，陳旌甲，親授弧矢，曰：「我之行也，若此射矣。」遂三起三疊，徒眾屬目，其氣十倍。初，翼遷襄陽，舉朝謂之不可，議者或謂避衰，唯兄冰意同，桓溫及譙王無忌贊成其計。至是，冰求鎮武昌，為翼繼援。朝議謂冰不宜出，冰乃止。又進翼征西將軍，領南蠻校尉。胡賊五六百騎出樊城，翼遣冠軍將軍曹據追擊於撓溝北，破之，死者近半，獲馬百匹。翼綏來荒遠，務盡招納之宜，立客館，置典賓參軍。桓宣卒，翼以長子方之為義成太守，代領宣眾，司馬應誕為龍驤將軍、襄陽太守，參軍司勳為建威將軍、梁州刺史，戍西城。康帝崩，兄冰卒，以家國情事，留方之戍襄陽，還鎮夏口，悉取冰所領兵自配，以兄子統為尋陽太守。詔使翼還督江州，又領豫州刺史，辭豫州。復欲移鎮樂鄉，詔不許。繕修軍器，大佃積穀，欲圖後舉。遣益州刺史周撫、西陽太守曹據伐蜀，破蜀將李桓于江陽。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":140,"last_line":140,"raw_start":11155,"raw_end":11649,"raw_character_offsets":[11157,11158,11159,11160,11161,11162,11163,11164,11165,11166,11167,11168,11169,11170,11171,11221,11222,11223,11224,11225,11226,11227,11228,11229,11230,11231,11232,11233,11234,11235,11236,11237,11238,11239,11240,11241,11242,11243,11244,11245,11246,11247,11248,11249,11250,11251,11252,11253,11254,11255,11256,11257,11258,11259,11260,11261,11262,11263,11264,11265,11266,11267,11268,11269,11270,11271,11272,11273,11274,11275,11276,11277,11278,11279,11280,11281,11282,11283,11284,11285,11286,11287,11288,11289,11290,11291,11292,11293,11294,11295,11296,11297,11298,11299,11300,11301,11302,11303,11304,11305,11306,11307,11308,11309,11310,11311,11312,11313,11314,11315,11316,11317,11318,11319,11320,11321,11322,11323,11324,11325,11326,11327,11328,11329,11330,11331,11332,11333,11334,11335,11336,11337,11338,11339,11340,11341,11342,11343,11344,11345,11346,11347,11348,11349,11350,11351,11352,11353,11354,11355,11356,11357,11358,11359,11360,11361,11362,11363,11364,113