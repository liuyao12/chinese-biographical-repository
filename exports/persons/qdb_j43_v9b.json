，后視上良久，乃引被覆面。崩于顯陽殿，時年三十六。上甚相悼痛，詔前永嘉太守顏延之為哀策，文甚麗。其辭曰：","mentions":[{"id":"c-songshu-041-yuanqigui:p001:m0006","start":6,"end":8,"surface":"齊媯","person_id":"3tt_4ey_uti_A","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為袁齊媯。"},{"id":"c-songshu-041-yuanqigui:p001:m0022","start":22,"end":23,"surface":"湛","person_id":"3tt_4ey_uti","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為袁湛。"},{"id":"c-songshu-041-yuanqigui:p001:m0057","start":57,"end":58,"surface":"劭","person_id":"fof_k8v_7md","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為宋元凶劭。"},{"id":"c-songshu-041-yuanqigui:p001:m0064","start":64,"end":66,"surface":"英娥","person_id":"3bh_k4m_fg4_A","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為東陽獻公主。"},{"id":"c-songshu-041-yuanqigui:p001:u0075","start":75,"end":77,"surface":"袁氏","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"皇后本家共稱。"},{"id":"c-songshu-041-yuanqigui:p001:m0111","start":111,"end":112,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"姓潘，以淑妃稱此人。"},{"id":"c-songshu-041-yuanqigui:p001:m0141","start":141,"end":142,"surface":"潘","person_id":"8ge_4zd_66p","kind":"person","status":"contextual_provisional","interpretation_note":"承前潘淑妃，姓氏省稱。"},{"id":"c-songshu-041-yuanqigui:p001:m0197","start":197,"end":198,"surface":"濬","person_id":"3b1_39e_aa6","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為始興王濬。"},{"id":"c-songshu-041-yuanqigui:p001:u0198","start":198,"end":201,"surface":"諸庶子","person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"文帝後宮所生諸子合稱。"},{"id":"c-songshu-041-yuanqigui:p001:m0272","start":272,"end":275,"surface":"顏延之","person_id":"ftg_rxy_day","kind":"person","status":"contextual_provisional","interpretation_note":"本段具名或具姓人物為顏延之。"}],"text_layer":"received_chapter",