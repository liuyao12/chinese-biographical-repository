:"k8g_exm_am9","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p011:m0011","surface":"琨","start":11,"end":12,"person_id":"b21_e55_8bd","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-062-liukun","book_id":"b-jinshu-062","work_id":"w-jinshu","source_id":"s-jinshu-062-liukun-ws2629226"},{"id":"c-jinshu-062-liukun:p012","text":"逆胡劉聰，敢率犬羊，馮陵輦轂，人神發憤，遐邇奮怒。伏省詔書，相國、南陽王保，太尉、涼州刺史軌，糾合二州，同恤王室，冠軍將軍允、護軍將軍綝，總齊六軍，戮力國難，王旅大捷，俘馘千計，旌旗首于晉路，金鼓振于河曲，崤函無虔劉之警，汧隴有安業之慶，斯誠宗廟社稷陛下神武之所致。含氣之類，莫不引領，況臣之心，能無踴躍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":34,"last_line":34,"raw_start":2677,"raw_end":2842,"raw_character_offsets":[2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791,2792,2793,2794,2795,2796,2797,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839],"revision_id":2629226},"mentions":[{"id":"c-jinshu-062-liukun:p012:m0002","surface":"劉聰","start":2,"end":4,"person_id":"d96_1fa_e9a","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p012:m0033","surface":"南陽王保","start":33,"end":37,"person_id":"d5b_990_e57","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p012:m0045","surface":"軌","start":45,"end":46,"person_id":"ras_ine_sf4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-062-liukun:p012:m0061"