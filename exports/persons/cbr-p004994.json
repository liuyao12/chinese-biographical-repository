:[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-089-zhanger:m008-0012","start":12,"end":14,"surface":"蒯通","kind":"person","person_id":"i3c_26z_spn","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p008","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m008-0037","start":37,"end":38,"surface":"通","kind":"person","person_id":"i3c_26z_spn","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p008","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m009-0005","start":5,"end":7,"surface":"蒯通","kind":"person","person_id":"i3c_26z_spn","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p009","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m009-0080","start":80,"end":82,"surface":"蒯通","kind":"person","person_id":"i3c_26z_spn","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p009","chapter_id":"c-shiji-089-zhanger"},{"id":"c-shiji-089-zhanger:m009-0261","start":261,"end":263,"surface":"蒯通","kind":"person","person_id":"i3c_26z_spn","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p009","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-017","person_id":"i3c_26z_spn","surfaces":["蒯通","通"],"scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-089-zhanger:p008","quote":"乃引兵東北撃范陽。范陽人蒯通説范陽令曰：「竊聞公之將死，故弔。雖然，賀公得通而生。」范陽令曰：「何以弔之？」對曰：「秦法重，足下爲范陽令十年矣，殺人之父，孤人之子，斷人之足，黥人之首，不可勝數。然而慈父孝子莫敢倳刃公之腹中者，畏秦法耳。今天下大亂，秦法不施，然則慈父孝子且倳刃公之腹中以成其名，此臣之所以弔公也。今諸侯畔秦矣，武信君兵且至，而君堅守范陽，少年皆爭殺君，下武信君。君急遣臣見武信君，可轉禍爲福，在今矣。」"},{"paragraph_id":"c-shiji-089-zhanger:p009","quote":"范陽令乃使蒯通見武信君曰：「足下必將戰勝然後略地，攻得然後下城，臣竊以爲過矣。誠聽臣之計，可不攻而降城，不戰而略地，傳檄而千里定，可乎？」武信君曰：「何謂也？」蒯通曰：「今范陽令宜整頓其士卒以守戰者也，怯而畏死，貪而重富貴，故欲先天下降，畏君以爲秦所置吏，誅殺如前十城也。然今范陽少年亦方殺其令，自以城距君。君何不齎臣侯印，拜范陽令，范陽令則以城下君，少年亦不敢殺其令。令范陽令乘朱輪華轂，使驅馳燕、趙郊。燕、趙郊見之，皆曰此范陽令，先下者也，即喜矣，燕、趙城可毋戰而降也。此臣之所謂傳檄而千里定者也。」武信君從其計，因使蒯通賜范陽令侯印。趙地聞之，不戰以城下者三十餘城。"}],"rationale":"按同段姓名及明示局部承接；未名人物獨立保留，父事不作父系。周文與周章先分候選，待跨段事件證據再接。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-089-zhanger:p008","text":"乃引兵東北撃范陽。范陽人蒯通説范陽令曰：「竊聞公之將死，故弔。雖然，賀公得通而生。」范陽令曰：「何以弔之？」對曰：「秦法重，足下爲范陽令十年矣，殺人之父，孤人之子，斷人之足，黥人之首，不可勝數。然而慈父孝子莫敢倳刃公之腹中者，畏秦法耳。今天下大亂，秦法不施，然則慈父孝子且倳刃公之腹中以成其名，此臣之所以弔公也。今諸侯畔秦矣，武信君兵且至，而君堅守范陽，少年皆爭殺君，下武信君。君急遣臣見武信君，可轉禍爲福，在今矣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-089-zhanger:m008-0012","start":12,"end":14,"surface":"蒯通","kind":"person","person_id":"i3c_26z_spn","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m008-0015","start":15,"end":18,"surface":"范陽令","kind":"person","person_id":"4z2_eut_yeu","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m008-0037","start":37,"end":38,"surface":"通","kind":"person","person_id":"i3c_26z_spn","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m008-0042","start":42,"end":45,"surface":"范陽令","kind":"person","person_id":"4z2_eut_yeu","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m008-0065","start":65,"end":68,"surface":"范陽令","kind":"person","person_id":"4z2_eut_yeu","status":"contextual_provisional"},{"id":"c-shiji-089-zhanger:m008-0099","start":99,"end":103,"surface":"慈父孝子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、後裔或未定指代保留原文，不補成員姓名。"},{"id":"c-shiji-089-zhanger:m008-0131","start":131,"end":135,"surface":"慈父孝子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、後裔或未定指代保留原文，不補成員姓名。"},{"id":"c-shiji-089-zhanger:m008-0163","start":163,"end":166,"surface":"武信君","kind":"person","perso