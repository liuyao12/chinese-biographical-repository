evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p046","quote":"王烏，北地人"}],"source_term":"北地人","interpretation_note":"保存傳記明示地方籍屬，不推精確出生地、現代行政區或所在城邑。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-110-xiongnu:p046","text":"漢使王烏等窺匈奴。匈奴法，漢使非去節而以墨黥其面者不得入穹廬。王烏，北地人，習胡俗，去其節，黥面，得入穹廬。單于愛之，詳許甘言，爲遣其太子入漢爲質，以求和親。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m046-0002","start":2,"end":4,"surface":"王烏","kind":"person","person_id":"h4f_jdj_gwf","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m046-0013","start":13,"end":15,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m046-0031","start":31,"end":33,"surface":"王烏","kind":"person","person_id":"h4f_jdj_gwf","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m046-0054","start":54,"end":56,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AABA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m046-0067","start":67,"end":69,"surface":"太子","kind":"person","person_id":"l05_5gh_nen","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p048","text":"楊信既歸，漢使王烏，而單于復肴甘言，欲多得漢財物，紿謂王烏曰：「吾欲入漢見天子，面相約爲兄弟。」王烏歸報漢，漢爲單于築邸于長安。匈奴曰：「非得漢貴人使，吾不與誠語。」匈奴使其貴人至漢，病，漢予藥，欲愈之，不幸而死。而漢使路充國佩二千石印綬往使，因送其喪，厚葬直數千金，曰「此漢貴人也」。單于以爲漢殺吾貴使者，乃留路充國不歸。諸所言者，單于特空紿王烏，殊無意入漢及遣太子來質。於是匈奴數使奇兵侵犯邊。漢乃拜郭昌爲拔胡將軍，及浞野侯屯朔方以東，備胡。路充國留匈奴三歳，單于死。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m048-0000","start":0,"end":2,"surface":"楊信","kind":"person","person_id":"rk6_uic_hnm","status":"contextual_provisional"},{"id":"c-shiji-110-xio