xtual_provisional"},{"id":"c-shiji-088-mengtian:m002-0007","start":7,"end":9,"surface":"蒙恬","kind":"person","person_id":"cbr-p004937","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m002-0037","start":37,"end":39,"surface":"蒙恬","kind":"person","person_id":"cbr-p004937","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m002-0040","start":40,"end":44,"surface":"三十萬眾","kind":"unresolved","person_id":null,"status":"unresolved","note":"先人、族稱或群體保留未解，不補直接父系或個人姓名。"},{"id":"c-shiji-088-mengtian:m002-0108","start":108,"end":110,"surface":"蒙恬","kind":"person","person_id":"cbr-p004937","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m002-0115","start":115,"end":117,"surface":"始皇","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m002-0120","start":120,"end":122,"surface":"蒙氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"先人、族稱或群體保留未解，不補直接父系或個人姓名。"},{"id":"c-shiji-088-mengtian:m002-0131","start":131,"end":133,"surface":"蒙毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m002-0149","start":149,"end":150,"surface":"恬","kind":"person","person_id":"cbr-p004937","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m002-0154","start":154,"end":155,"surface":"毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m002-0167","start":167,"end":170,"surface":"諸將相","kind":"unresolved","person_id":null,"status":"unresolved","note":"先人、族稱或群體保留未解，不補直接父系或個人姓名。"}],"chapter_id":"c-shiji-088-mengtian","book_id":"b-shiji-088","work_id":"w-shiji","source_id":"s-shiji-088-mengtian"},{"id":"c-shiji-088-mengtian:p003","text":"趙高者，諸趙疏遠屬也。趙高昆弟數人，皆生隱宮，其母被刑僇，世世卑賤。秦王聞高彊力，通於獄法，舉以為中車府令。高既私事公子胡亥，喻之決獄。高有大罪，秦王令蒙毅法治之。毅不敢阿法，當高罪死，除其宦籍。帝以高之敦於事也，赦之，復其官爵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-088-mengtian:m003-0000","start":0,"end":2,"surface":"趙高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0004","start":4,"end":9,"surface":"諸趙疏遠屬","kind":"unresolved","person_id":null,"status":"unresolved","note":"先人、族稱或群體保留未解，不補直接父系或個人姓名。"},{"id":"c-shiji-088-mengtian:m003-0011","start":11,"end":13,"surface":"趙高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0013","start":13,"end":17,"surface":"昆弟數人","kind":"unresolved","person_id":null,"status":"unresolved","note":"先人、族稱或群體保留未解，不補直接父系或個人姓名。"},{"id":"c-shiji-088-mengtian:m003-0023","start":23,"end":25,"surface":"其母","kind":"person","person_id":"cbr-p004949","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0034","start":34,"end":36,"surface":"秦王","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0037","start":37,"end":38,"surface":"高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0054","start":54,"end":55,"surface":"高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0058","start":58,"end":62,"surface":"公子胡亥","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0068","start":68,"end":69,"surface":"高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0073","start":73,"end":75,"surface":"秦王","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0076","start":76,"end":78,"surface":"蒙毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0082","start":82,"end":83,"surface":"毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0089","start":89,"end":90,"surface":"高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0098","start":98,"end":99,"surface":"帝","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m003-0100","start":100,"end":101,"surface":"高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"}],"chapter_id":"c-shiji-088-mengtian","book_id":"b-shiji-088","work_id":"w-shiji","source_id":"s-shiji-088-mengtian"},{"id":"c-shiji-088-mengtian:p005","text":"始皇三十七年冬，行出游會稽，并海上，北走瑯邪。道病，使蒙毅還禱山川，未反。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-088-mengtian:m005-0000","start":0,"end":2,"surface":"始皇","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m005-0027","start":27,"end":29,"surface":"蒙毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"}],"chapter_id":"c-shiji-088-mengtian","book_id":"b-shiji-088","work_id":"w-shiji","source_id":"s-shiji-088-mengtian"},{"id":"c-shiji-088-mengtian:p006","text":"始皇至沙丘崩，祕之，群臣莫知。是時丞相李斯、公子胡亥、中車府令趙高常從。高雅得幸於胡亥，欲立之，又怨蒙毅法治之而不為己也。因有賊心，乃與丞相李斯、公子胡亥陰謀，立胡亥為太子。太子已立，遣使者以罪賜公子扶蘇、蒙恬死。扶蘇已死，蒙恬疑而復請之。使者以蒙恬屬吏，更置。胡亥以李斯舍人為護軍。使者還報，胡亥已聞扶蘇死，即欲釋蒙恬。趙高恐蒙氏復貴而用事，怨之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-088-mengtian:m006-0000","start":0,"end":2,"surface":"始皇","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0010","start":10,"end":12,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文；不補姓名或成員。"},{"id":"c-shiji-088-mengtian:m006-0019","start":19,"end":21,"surface":"李斯","kind":"person","person_id":"cbr-p004951","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0022","start":22,"end":26,"surface":"公子胡亥","kind":"person","person