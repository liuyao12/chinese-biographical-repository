contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0112","start":112,"end":114,"surface":"蒙恬","kind":"person","person_id":"cbr-p004937","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0120","start":120,"end":122,"surface":"使者","kind":"person","person_id":"cbr-p004977","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0123","start":123,"end":125,"surface":"蒙恬","kind":"person","person_id":"cbr-p004937","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0131","start":131,"end":133,"surface":"胡亥","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0134","start":134,"end":138,"surface":"李斯舍人","kind":"person","person_id":"cbr-p004950","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0142","start":142,"end":144,"surface":"使者","kind":"person","person_id":"cbr-p004977","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0147","start":147,"end":149,"surface":"胡亥","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0151","start":151,"end":153,"surface":"扶蘇","kind":"person","person_id":"cbr-p004952","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0158","start":158,"end":160,"surface":"蒙恬","kind":"person","person_id":"cbr-p004937","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0161","start":161,"end":163,"surface":"趙高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m006-0164","start":164,"end":166,"surface":"蒙氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文；不補姓名或成員。"}],"chapter_id":"c-shiji-088-mengtian","book_id":"b-shiji-088","work_id":"w-shiji","source_id":"s-shiji-088-mengtian"},{"id":"c-shiji-088-mengtian:p007","text":"毅還至，趙高因為胡亥忠計，欲以滅蒙氏，乃言曰：「臣聞先帝欲舉賢立太子久矣，而毅諫曰『不可』。若知賢而俞弗立，則是不忠而惑主也。以臣愚意，不若誅之。」胡亥聽而系蒙毅於代。前已囚蒙恬於陽周。喪至咸陽，已葬，太子立為二世皇帝，而趙高親近，日夜毀惡蒙氏，求其罪過，舉劾之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-088-mengtian:m007-0000","start":0,"end":1,"surface":"毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0004","start":4,"end":6,"surface":"趙高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0008","start":8,"end":10,"surface":"胡亥","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0016","start":16,"end":18,"surface":"蒙氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文；不補姓名或成員。"},{"id":"c-shiji-088-mengtian:m007-0026","start":26,"end":28,"surface":"先帝","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0032","start":32,"end":34,"surface":"太子","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0038","start":38,"end":39,"surface":"毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0074","start":74,"end":76,"surface":"胡亥","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0079","start":79,"end":81,"surface":"蒙毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0087","start":87,"end":89,"surface":"蒙恬","kind":"person","person_id":"cbr-p004937","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0101","start":101,"end":103,"surface":"太子","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0105","start":105,"end":109,"surface":"二世皇帝","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0111","start":111,"end":113,"surface":"趙高","kind":"person","person_id":"cbr-p004947","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m007-0120","start":120,"end":122,"surface":"蒙氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定指代保留原文；不補姓名或成員。"}],"chapter_id":"c-shiji-088-mengtian","book_id":"b-shiji-088","work_id":"w-shiji","source_id":"s-shiji-088-mengtian"},{"id":"c-shiji-088-mengtian:p009","text":"胡亥不聽。而遣御史曲宮乘傳之代，令蒙毅曰：「先主欲立太子而卿難之。今丞相以卿為不忠，罪及其宗。朕不忍，乃賜卿死，亦甚幸矣。卿其圖之！」毅對曰：「以臣不能得先主之意，則臣少宦，順幸沒世。可謂知意矣。以臣不知太子之能，則太子獨從，周旋天下，去諸公子絕遠，臣無所疑矣。夫先主之舉用太子，數年之積也，臣乃何言之敢諫，何慮之敢謀！非敢飾辭以避死也，為羞累先主之名，願大夫為慮焉，使臣得死情實。且夫順成全者，道之所貴也；刑殺者，道之所卒也。昔者秦穆公殺三良而死，罪百里奚而非其罪也，故立號曰『繆』。昭襄王殺武安君白起。楚平王殺伍奢。吳王夫差殺伍子胥。此四君者，皆為大失，而天下非之，以其君為不明，以是籍於諸侯。故曰『用道治者不殺無罪，而罰不加於無辜』。唯大夫留心！」使者知胡亥之意，不聽蒙毅之言，遂殺之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-088-mengtian:m009-0000","start":0,"end":2,"surface":"胡亥","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m009-0009","start":9,"end":11,"surface":"曲宮","kind":"person","person_id":"cbr-p004961","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m009-0017","start":17,"end":19,"surface":"蒙毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m009-0022","start":22,"end":24,"surface":"先主","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m009-0026","start":26,"end":28,"surface":"太子","kind":"person","person_id":"cbr-p004948","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m009-0067","start":67,"end":68,"surface":"毅","kind":"person","person_id":"cbr-p004946","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m009-0077","start":77,"end":79,"surface":"先主","kind":"person","person_id":"cbr-p004941","status":"contextual_provisional"},{"id":"c-shiji-088-mengtian:m009-0102","start":102,"end":104,"surface":"太子","kind":"p