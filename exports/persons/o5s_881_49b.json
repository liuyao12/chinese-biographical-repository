[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-048-kongzhigui-complete:p004:m0162","start":162,"end":164,"surface":"宋躬","kind":"person","person_id":"o5s_881_49b","status":"contextual_provisional","paragraph_id":"c-nanqishu-048-kongzhigui-complete:p004","chapter_id":"c-nanqishu-048-kongzhigui-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-048-kongzhigui-complete:p004","text":"　　臣聞匠萬物者以繩墨爲正，馭大國者以法理爲本。是以古之聖王，臨朝思理，遠防邪萌，深杜姦漸，莫不資法理以成化，明刑賞以樹功者也。伏惟陛下躡曆登皇，乘圖踐帝，天地更築，日月再張，五禮裂而復縫，六樂穨而爰緝。乃發德音，下明詔，降恤刑之文，申慎罰之典，敕臣與公卿八座共刪注律。謹奉聖旨，諮審司徒臣子良，稟受成規，創立條緒。使兼監臣宋躬、兼平臣王植等抄撰同異，定其去取。詳議八座，裁正大司馬臣嶷。其中洪疑大議，衆論相背者，聖照玄覽，斷自天筆。始就成立《律文》二十卷，《錄敘》一卷，凡二十一卷。今以奏聞，請付外施用，宣下四海。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":34,"last_line":34,"raw_start":1772,"raw_end":2031,"raw_character_offsets":[1773,1774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805,1806,1807,1808,1809,1810,1811,1812,1813,1814,1815,1816,1817,1818,1819,1820,1821,1822,1823,1824,1825,1826,1827,1828,1829,1830,1831,1832,1833,1834,1835,1836,1837,1838,1839,1840,1841,1842,1843,1844,1845,1846,1847,1848,1849,1850,1851,1852,1853,1854,1855,1856,1857,1858,1859,1860,1861,1862,1863,1864,1865,1866,1867,1868,1869,1870,1871,1872,1873,1874,1875,1876,1877,1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888,1889,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931,1932,1933,193