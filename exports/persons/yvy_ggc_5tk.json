而止，讀書不輟。叔父璠之與顏延之友善，還祛蒙山立精舍講授，伯珍往從學，積十年，究尋經史，遊學者多依之。太守琅邪王曇生、吳郡張淹竝加禮辟，伯珍應召便退，如此者凡十二焉。徵士沈儼造膝談論，申以素交。吳郡顧歡擿出《尚書》滯義，伯珍訓答甚有條理，儒者宗之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":198,"last_line":198,"raw_start":10131,"raw_end":10291,"raw_character_offsets":[10131,10132,10133,10134,10135,10136,10137,10138,10139,10140,10141,10142,10143,10144,10145,10146,10147,10148,10149,10150,10151,10152,10153,10154,10155,10156,10157,10158,10159,10160,10161,10162,10163,10164,10165,10166,10167,10168,10169,10170,10171,10172,10173,10174,10175,10176,10177,10178,10179,10180,10181,10182,10183,10184,10185,10186,10187,10188,10189,10190,10191,10192,10193,10194,10195,10196,10197,10198,10199,10200,10201,10202,10203,10204,10205,10206,10207,10208,10209,10210,10211,10212,10213,10214,10215,10216,10217,10218,10219,10220,10221,10222,10223,10224,10225,10226,10227,10228,10229,10230,10231,10232,10233,10234,10235,10236,10237,10238,10239,10240,10241,10242,10243,10244,10245,10246,10247,10248,10249,10250,10251,10252,10253,10254,10255,10256,10257,10258,10259,10260,10261,10262,10263,10264,10265,10266,10267,10268,10269,10270,10271,10272,10273,10274,10275,10276,10277,10278,10279,10280,10281,10282,10283,10284,10285,10286,10287,10288,10289,10290],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p078:m0002","start":2,"end":4,"surface":"伯珍","kind":"person","person_id":"djb_c7k_seu","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p078:m0032","start":32,"end":34,"surface":"伯珍","kind":"person","person_id":"djb_c7k_seu","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p078:m0046","start":46,"end":48,"surface":"璠之","kind":"person","person_id":"xjm_wq6_dr2","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p078:m0049","start":49,"end":52,"surface":"顏延之","kind":"person","person_id":"ftg_rxy_day","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p078:m006