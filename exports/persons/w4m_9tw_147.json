。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":61,"last_line":61,"revision_id":2400356,"editorial_excerpt_boundary":true},"mentions":[{"id":"c-nanqishu-043-xieyue:p005:m0009","start":9,"end":11,"surface":"高宗","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-mingdi"},{"id":"c-nanqishu-043-xieyue:p005:m0012","start":12,"end":14,"surface":"鬱林","kind":"person","person_id":"iop_ybd_afm","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yulin"},{"id":"c-nanqishu-043-xieyue:p005:m0020","start":20,"end":22,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名角色/群體，未找到足夠證據唯一定位；不造名字或合併匿名人。"},{"id":"c-nanqishu-043-xieyue:p005:m0025","start":25,"end":26,"surface":"𤅢","kind":"person","person_id":"aa6_83c_juy_DBABAC","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yue"},{"id":"c-nanqishu-043-xieyue:p005:m0028","start":28,"end":29,"surface":"客","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名角色/群體，未找到足夠證據唯一定位；不造名字或合併匿名人。"},{"id":"c-nanqishu-043-xieyue:p005:m0060","start":60,"end":62,"surface":"明帝","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-mingdi"},{"id":"c-nanqishu-043-xieyue:p005:m0065","start":65,"end":66,"surface":"𤅢","kind":"person","person_id":"aa6_83c_juy_DBABAC","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yue"},{"id":"c-nanqishu-043-xieyue:p005:m0074","start":74,"end":75,"surface":"上","kind":"person","person_id":"w4