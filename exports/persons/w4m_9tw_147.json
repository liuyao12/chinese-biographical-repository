043-xieyue-wangyan"},{"id":"c-nanqishu-043-xieyue:p005:m0193","start":193,"end":194,"surface":"之","kind":"person","person_id":"dw5_ots_441","status":"contextual_provisional","interpretation_note":"晏甚憚之的之回指𤅢。","identity_decision_id":"d-nanqi043-xieyue-yue"}],"chapter_id":"c-nanqishu-043-xieyue","book_id":"b-nanqishu-043","work_id":"w-nanqishu","source_id":"s-nanqishu043-ws2400356"},{"id":"c-nanqishu-043-xieyue:p006","unit_id":"xieyue-complete","text":"加領右軍將軍。兄朏在吳興，論啓公事稽晚，𤅢輙代爲啓，上見非其手迹，被問，見原。轉侍中，領太子中庶子，豫州中正。永泰元年，轉散騎常侍，太子詹事。其年卒。年四十五。贈金紫光祿大夫。謚簡子。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":63,"last_line":63,"revision_id":2400356,"editorial_excerpt_boundary":true},"mentions":[{"id":"c-nanqishu-043-xieyue:p006:m0008","start":8,"end":9,"surface":"朏","kind":"person","person_id":"axl_06n_t2v","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-fei"},{"id":"c-nanqishu-043-xieyue:p006:m0020","start":20,"end":21,"surface":"𤅢","kind":"person","person_id":"dw5_ots_441","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-yue"},{"id":"c-nanqishu-043-xieyue:p006:m0026","start":26,"end":27,"surface":"上","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional","interpretation_note":"原文具名或局部代稱；身份依全傳及具體來源橋接，不按同字跨世代配人。","identity_decision_id":"d-nanqi043-xieyue-mingdi"},{"id":"c-nanqishu-043-xieyue:p006:m0029","start":29,"end":30,"surface":"其","kind":"person","person_id":"axl_06n_t2v","status":"contextual_provisional","interpretation_note":"兄朏論啓、𤅢代啓，帝看出不是所署朏的手迹；此其依代啓句法暫繫朏，不作書法事實。","identity_decision_id":"d-nanqi043-xieyue-fei"}],"chapter_id":"c-nanqishu-043-xieyue","book_id":"b-nanqishu-043","work_id":"w-nanqishu","source_id":"s-nanqishu043-ws2400356"},{"text":"九年復北使。建武初，為王玄邈安北長史、廣陵太守。明帝以其在事無啟奏，代還責之，昭明曰：「臣不欲競執關鍵故耳。」昭明曆郡皆清勤，常謂人曰：「人生何事須聚畜，一身之外亦復何須。子孫若不才，我聚彼散。若能自立，則不如一經。」故終身一不事產業。中興二年卒。子子野。","source_position":{"start":9991,"end":10126,"raw":"九年復北使。建武初，為王玄邈安北長史、廣陵太守。明帝以其在事無啟奏，代還責之，昭明曰：「臣不欲競執關鍵故耳。」昭明曆郡皆清勤，常謂人曰：「人生何事須聚畜，一身之外亦復何須。子孫若不才，我聚彼散。若能自立，則不如一經。」故終身一不事產業。{{YL|中興二年}}卒。子子野。","raw_path":"sources/nanshi/wikisource-1554233-raw.wikitext"},"id":"c-nanshi-033-pei-family:p013","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanshi-033-pei-family:p013:m0011","start":11,"end":14,"surface":"王玄邈","kind":"person","person_id":"hgq_k4y_crp","status":"contextual_provisional","interpretation_note":"建武初昭明為王玄邈安北長史，名、官及時段暫登來源內身份，不與不相干同姓者合併。"},{"id":"c-nanshi-033-pei-family:p013:m0024","start":24,"end":26,"surface":"明帝","kind":"person","person_id":"w4m_9tw_147","status":"contextual_provisional","interpretation_note":"南齊書卷6固定2311630正文高宗明皇帝諱鸞，建武元年即位；南史昭明建武初代還責之的明帝與同朝同年號相合，辨鸞；本篇明帝原字不改。"},{"id":"c-nanshi-033-pei-family:p013:m0027","start":27,"end":28,"surface":"其","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional","interpretation_note":"駰子昭明、昭明子子野；梁030首段子野父昭明及祖駰同近世家系，父疾故事亦相合。"},{"id":"c-nanshi-033-pei-family:p013:m0037","start":37,"end":38,"surface":"之","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional","interpretation_note":"駰子昭明、昭明子子野；梁030首段子野父昭明及祖駰同近世家系，父疾故事亦相合。"},{"id":"c-nanshi-033-pei-family:p013:m0039","start":39,"end":41,"surface":"昭明","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional","interpretation_note":"駰子昭明、昭明子子野；梁030首段子野父昭明及祖駰同近世家系，父疾故事亦相合。"},{"id":"c-nanshi-033-pei-family:p013:m0044","start":44,"end":45,"surface":"臣","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional","interpretation_note":"駰子昭明、昭明子子野；梁030首段子野父昭明及祖駰同近世家系，父疾故事亦相合。"},{"id":"c-nanshi-033-pei-family:p013:m0055","start":55,"end":57,"surface":"昭明","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional","interpretation_note":"駰子昭明、昭明子子野；梁030首段子野父昭明及祖駰同近世家系，父疾故事亦相合。"},{"id":"c-nanshi-033-pei-family:p013:m0092","start":92,"end":93,"surface":"我","kind":"person","person_id":"vpy_180_2oi_AAAA","status":"contextual_provisional","interpretation_note":"駰子昭明、昭明子子野；梁030首段子野父昭明及祖駰同近世家系，父疾故事亦相合。"},{"id":"c-nanshi-033-pei-family:p013:m0125","start":125,"end":127,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"}],"chapter_id":"c-nanshi-033-pei-family","book_id":"b-nanshi-033","work_id":"w-nanshi","source_id":"s-nanshi033-ws1554233"}],"sources":[{"chapter_id":"c-nanqishu-043-xieyue","work_id":"w-nanqishu","book_id":"b-nanqishu-043","source_id":"s-nanqishu043-ws2400356","source":{"title":"《南齊書》卷四十三謝𤅢完整本傳（含兄顥附傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=南齊書/卷43&oldid=2400356","permalink":"https://zh.wikisource.org/w/index.php?title=南齊書/卷43&oldid=2400356","revision_id":2400356,"accessed_on":"2026-10-21","extent":"原行53至67共八完整段，謝𤅢本傳含顥附傳；止王思遠傳前，非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留數位歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未核底本影像","response_sha256":"3a6a97e651528165730c9449870379efdfddd44a36b17e7600fab6060b7b24ae","wikitext_sha256":"7a65e9b58b508ef0dbc64a4a650c99c30dcd94f8f13ea9a23d171f539174baed","normalization":{"character_conversion":{"{{!|𤅢|左「氵」右「𦿈」}}":"𤅢"},"extraction_note":"僅展開字形模板與YL日期連結，去兩全形縮排；不轉瀹、不改鞭除身或爲/爲等原字。"}}},{"chapter_id":"c-nanshi-033-pei-family","work_id":"w-nanshi","book_id":"b-nanshi-033","source_id":"s-nanshi033-ws1554233","source":{"title":"南史/卷33","revision_id":1554233,"revision_timestamp":"2019-03-29T02:35:39Z","status":200,"response_sha256":"8380abe50572203e436afe87e646878898cffb422d117948c0f7a802b0086a5a","raw_sha256":"03f36d2b463faf43738af65819a8afae18d17df2da3a2b6e7a824a322b14dc86","url":"https://zh.wikisource.org/w/index.php?title=%E5%8D%97%E5%8F%B2%2F%E5%8D%B733&oldid=155423