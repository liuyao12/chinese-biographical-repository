rth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-029","person_id":"fie_vij_hw2","surfaces":["王孫滿"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p056","quote":"定王元年，楚莊王伐陸渾之戎，次洛，使人問九鼎。王使王孫滿應設以辭，楚兵乃去。十年，楚莊王圍鄭，鄭伯降，已而復之。十六年，楚莊王卒。"},{"paragraph_id":"c-shiji-039-jin:p078","quote":"鄭人或賣其國於秦，秦繆公發兵往襲鄭。十二月，秦兵過我郊。襄公元年春，秦師過周，無禮，王孫滿譏之。兵至滑，鄭賈人絃髙將市于周，遇之，以十二牛勞秦師。秦師驚而還，滅滑而去。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji040-108","person_id":"fie_vij_hw2","surfaces":["王孫滿"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p056","quote":"定王元年，楚莊王伐陸渾之戎，次洛，使人問九鼎。王使王孫滿應設以辭，楚兵乃去。十年，楚莊王圍鄭，鄭伯降，已而復之。十六年，楚莊王卒。"},{"paragraph_id":"c-shiji-040-chu:p021","quote":"八年，伐陸渾戎，遂至洛，觀兵於周郊。周定王使王孫滿勞楚王。楚王問鼎小大輕重，對曰：「在德不在鼎。」莊王曰：「子無阻九鼎！楚國折鉤之喙，足以爲九鼎。」王孫滿曰：「嗚呼！君王其忘之乎？昔虞夏之盛，遠方皆至，貢金九牧，鑄鼎象物，百物而爲之備，使民知神姦。桀有亂德，鼎遷於殷，載祀六百。殷紂暴虐，鼎遷於周。德之休明，雖小必重；其姦回昏亂，雖大必輕。昔成王定鼎于郟鄏，卜世三十，卜年七百，天所命也。周德雖衰，天命未改。鼎之輕重，未可問也。」楚王乃歸。"}],"rationale":"兩篇均記楚莊王伐陸渾到洛、問鼎，周王使王孫滿答辭而楚兵去，按同一事件暫同指；長篇引語與年代仍各自保存，未聲稱問鼎辭全文已核古本。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p056","text":"定王元年，楚莊王伐陸渾之戎，次洛，使人問九鼎。王使王孫滿應設以辭，楚兵乃去。十年，楚莊王圍鄭，鄭伯降，已而復之。十六年，楚莊王卒。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m056-0000","start":0,"end":2,"surface":"定王","kind":"person","person_id":"3hy_4xq_wqu","status":"source_identified"},{"id":"c-shiji-004-zhou:m056-0005","start":5,"end":8,"surface":"楚莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"source_identified"},{"id":"c-shiji-004-zhou:m056-0025","start":25,"end":28,"surface":"王孫滿","kind":"person","person_id":"fie_vij_hw2","status":"source_identified"},{"id":"c-shiji-004-zhou:m056-0041","start":41,"end":44,"surface":"楚莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"source_identified"},{"id":"c-shiji-004-zhou:m056-0047","start":47,"end":49,"surface":"鄭伯","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m056-0060","start":60,"end":63,"surface":"楚莊王","kind":"person","person_id":"q8m_d0c_kq3","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-005-qin:p032","text":"鄭人有賣鄭於秦曰：「我主其城門，鄭可襲也。」繆公問蹇叔、百里傒，對曰：「徑數國千里而襲人，希有得利者。且人賣鄭，庸知我國人不有以我情告鄭者乎？不可。」繆公曰：「子不知也，吾已決矣。」遂發兵，使百里傒子孟明視，蹇叔子西乞術及白乙丙將兵。行日，百里傒、蹇叔二人哭之。繆公聞，怒曰：「孤發兵而子沮哭吾軍，何也？」二老曰：「臣非敢沮君軍。軍行，臣子與往；臣老，遲還恐不相見，故哭耳。」二老退，謂其子曰：「汝軍即敗，必於殽阨矣。」三十三年春，秦兵遂東，更晉地，過周北門。周王孫滿曰：「秦師無禮，不敗何待！」兵至滑，鄭販賣賈人弦高，持十二牛將賣之周，見秦兵，恐死虜，因獻其牛，曰：「聞大國將誅鄭，鄭君謹修守御備，使臣以牛十二勞軍士。」秦三將軍相謂曰：「將襲鄭，鄭今已覺之，往無及已。」滅滑。滑，晉之邊邑也。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m032-0000","start":0,"end":2,"surface":"鄭人","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m032-0022","start":22,"end":24,"surface":"繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0025","start":25,"end":27,"surface":"蹇叔","kind":"person","person_id":"7du_pfa_2s5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0028","start":28,"end":31,"surface":"百里傒","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0075","start":75,"end":77,"surface":"繆公","kind":"person","person_id":"y97_huh_vuz_AAAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0096","start":96,"end":99,"surface":"百里傒","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m032-0100","start":100,"end":103,"surface":"孟明視","kind":"person","person_id":"ylb_ttg_8dr_A","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m03