tus":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p007","chapter_id":"c-shiji-007-xiangyu"}],"relations":[{"id":"a-shiji007-006","subject_person_id":"cbr-p000683","predicate":"father","object_person_id":"cbr-p000601","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p007","quote":"田榮立田儋子市為齊王","chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"只保存本文明示親屬陳述；不推導闕代、同父同母或未見姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p058","text":"七月，戍卒陳勝等反故荊地，為「張楚」。勝自立為楚王，居陳，遣諸將徇地。山東郡縣少年苦秦吏，皆殺其守尉令丞反，以應陳涉，相立為侯王，合從西鄉，名為伐秦，不可勝數也。謁者使東方來，以反者聞二世。二世怒，下吏。後使者至，上問，對曰：「群盜，郡守尉方逐捕，今盡得，不足憂。」上悅。武臣自立為趙王，魏咎為魏王，田儋為齊王。沛公起沛。項梁舉兵會稽郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p058:m0005","start":5,"end":7,"surface":"陳勝","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0019","start":19,"end":20,"surface":"勝","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0023","start":23,"end":25,"surface":"楚王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、官稱或待核指代；未補姓名、闕代與親屬成員。"},{"id":"c-shiji-006-shihuang:p058:m0056","start":56,"end":58,"surface":"陳涉","kind":"person","person_id":"cbr-p000598","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0092","start":92,"end":94,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0095","start":95,"end":97,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0103","start":103,"end":105,"surface":"使者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、官稱或待核指代；未補姓名、闕代與親屬成員。"},{"id":"c-shiji-006-shihuang:p058:m0136","start":136,"end":138,"surface":"武臣","kind":"person","person_id":"cbr-p000599","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0144","start":144,"end":146,"surface":"魏咎","kind":"person","person_id":"cbr-p000600","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0150","start":150,"end":152,"surface":"田儋","kind":"person","person_id":"cbr-p000601","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0156","start":156,"end":158,"surface":"沛公","kind":"person","person_id":"cbr-p000602","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p058:m0161","start":161,"end":163,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-007-xiangyu:p007","text":"居數月，引兵攻亢父，與齊田榮、司馬龍且軍救東阿，大破秦軍於東阿。田榮即引兵歸，逐其王假。假亡走楚。假相田角亡走趙。角弟田閒故齊將，居趙不敢歸。田榮立田儋子市為齊王。項梁已破東阿下軍，遂追秦軍。數使使趣齊兵，欲與俱西。田榮曰：「楚殺田假，趙殺田角、田閒，乃發兵。」項梁曰：「田假為與國之王，窮來從我，不忍殺之。」趙亦不殺田角、田閒以市於齊。齊遂不肯發兵助楚。項梁使沛公及項羽別攻城陽，屠之。西破秦軍濮陽東，秦兵收入濮陽。沛公、項羽乃攻定陶。定陶未下，去，西略地至雝丘，大破秦軍，斬李由。還攻外黃，外黃未下。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m007-0012","start":12,"end":14,"surface":"田榮","kind":"person","person_id":"cbr-p000665","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0017","start":17,"end":19,"surface":"龍且","kind":"person","person_id":"cbr-p000666","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0032","start":32,"end":34,"surface":"田榮","kind":"person","person_id":"cbr-p000665","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m007-0042","start":42,"end":43,"surface":"假","kind":"person","person_id":"cbr-p000667","status":"contextual_provisional"},{"id":"c-shiji-007-xian