034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p018","quote":"文公十九年，齊威王卒。二十八年，蘇秦始來見，説文公。文公予車馬金帛以至趙，趙肅侯用之。因約六國，爲從長。秦惠王以其女爲燕太子婦。"}],"qualifiers":{"source_term":"燕太子婦","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示子、其女、婦、夫人及祖先說；九世不補闕名或直接父親，未見子字的繼位不自動推父子。太子平／燕昭王身份與攻燕年代尚待覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji034-016","subject_person_id":"cbr-p001349","predicate":"father","object_person_id":"cbr-p001347","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p020","quote":"易王初立，齊宣王因燕喪伐我，取十城；蘇秦説齊，使復歸燕十城。十年，燕君爲王。蘇秦與燕文公夫人私通，懼誅，乃説王使齊爲反閒，欲以亂齊。易王立十二年卒，子燕噲立。"}],"qualifiers":{"source_term":"子燕噲","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示子、其女、婦、夫人及祖先說；九世不補闕名或直接父親，未見子字的繼位不自動推父子。太子平／燕昭王身份與攻燕年代尚待覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji069-003","subject_person_id":"cbr-p004047","predicate":"spouse","object_person_id":"cbr-p004056","status":"source_attested","evidence":[{"chapter_id":"c-shiji-069-su","source_id":"s-shiji-069-su","paragraph_id":"c-shiji-069-su:p040","quote":"秦惠王以其女為燕太子婦。是歲，文侯卒，太子立，是為燕易王。易王初立，齊宣王因燕喪伐燕，取十城。易王謂蘇秦曰：「往日先生至燕，而先王資先生見趙，遂約六國從。今齊先伐趙，次至燕，以先生之故為天下笑，先生能為燕得侵地乎？」蘇秦大慚，曰：「請為王取之。」"}],"qualifiers":{"source_term":"為燕太子婦","historicity":"historical_tradition"},"interpretation_note":"按明示弟、女、母、婦與夫人保存，兄弟不推定同父同母。故事夫妻只在蘇秦引述故事內，不作獨立史實確證；燕太子與易王按篇內繼位暫接。繼位、先王、嗣及婚的未定姻親不補父子或兩人配偶。未名家屬、太后與穰侯不補姓名，版本與年代仍待覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji069-006","subject_person_id":"cbr-p004047","predicate":"mother","object_person_id":"cbr-p004057","status":"source_attested","evidence":[{"chapter_id":"c-shiji-069-su","source_id":"s-shiji-069-su","paragraph_id":"c-shiji-069-su:p043","quote":"易王母，文侯夫人也，與蘇秦私通。燕王知之，而事之加厚。蘇秦恐誅，乃說燕王曰：「臣居燕不能使燕重，而在齊則燕必重。」燕王曰：「唯先生之所為。」於是蘇秦詳為得罪於燕而亡走齊，齊宣王以為客卿。"}],"qualifiers":{"source_term":"易王母","historicity":"historical_tradition"},"interpretation_note":"按明示弟、女、母、婦與夫人保存，兄弟不推定同父同母。故事夫妻只在蘇秦引述故事內，不作獨立史實確證；燕太子與易王按篇內繼位暫接。繼位、先王、嗣及婚的未定姻親不補父子或兩人配偶。未名家屬、太后與穰侯不補姓名，版本與年代仍待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji034-029","person_id":"cbr-p001347","title":"易王","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p019","quote":"二十九年，文公卒，太子立，是爲易王。"}],"attestations":[{"id":"th-shiji034-029:a001","paragraph_id":"c-shiji-034-yan:p019","start":15,"end":17,"surface":"易王","person_mention_id":"c-shiji-034-yan:m019-0009","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"侯、公及諡號等暫作敘事追稱，不把繼位當當時授予諡號；未知曆日與終點不按卒日補造。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji034-039","person_id":"cbr-p001347","title":"太子","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p019","quote":"二十九年，文公卒，太子立，是爲易王。"}],"attestations":[{"id":"th-shiji034-039:a001","paragraph_id":"c-shiji-034-yan:p019","start":9,"end":11,"surface":"太子","person_mention_id":"c-shiji-034-yan:m019-0009","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"太子繼立易王的明示異稱，但太子用稱不推任命日，也不單據太子一詞補父親。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji034-042","person_id":"cbr-p001347","title":"王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p020","quote":"十年，燕君爲王。"}],"attestations":[{"id":"th-shiji034-042:a001","paragraph_id":"c-shiji-034-yan:p020","start":36,"end":37,"surface":"王","person_mention_id":"c-shiji-034-yan:m020-0033","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"十年燕君為王的用稱／轉變敘事，未明授予或自立方式，時段起點仍待核；易王追稱不表示此前已有王位。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji069-007","person_id":"cbr-p004047","title":"太子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-069-su","source_id":"s-shiji-069-su","paragraph_id":"c-shiji-069-su:p040","quote":"秦惠王以其女為燕太子婦。是歲，文侯卒，太子立，是為燕易王。易王初立，齊宣王因燕喪伐燕，取十城。易王謂蘇秦曰：「往日先生至燕，而先王資先生見趙，遂約六國從。今齊先伐趙，次至燕，以先生之故為天下笑，先生能為燕得侵地乎？」蘇秦大慚，曰：「請為王取之。」"}],"attestations":[{"id":"th-shiji069-007:a001","paragraph_id":"c-shiji-069-su:p040","start":8,"end":10,"surface":"太子","person_mention_id":"c-shiji-069-su:m040-0007","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"只按本篇明示授封、任事與文獻用稱保存；未知起訖不補曆日，死後王號與傳世敘事年代仍待版本及研究覆核。擬議三帝與未受宋地不當已持有；不因去國、被刺或卒而終止全部官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji034-091","person_id":"cbr-p001347","surfaces":["太子","易王","燕君","燕太子"],"scope":"same_chapter","chapter_ids":["c-shiji-034-yan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-034-yan:p018","quote":"文公十九年，齊威王卒。二十八年，蘇秦始來見，説文公。文公予車馬金帛以至趙，趙肅侯用之。因約六國，爲從長。秦惠王以其女爲燕太子婦。"},{"paragraph_id":"c-shiji-034-yan:p019","quote":"二十九年，文公卒，太子立，是爲易王。"},{"paragraph_id":"c-shiji-034-yan:p020","quote":"易王初立，齊宣王因燕喪伐我，取十城；蘇秦説齊，使復歸燕十城。十年，燕君爲王。蘇秦與燕文公夫人私通，懼誅，乃説王使齊爲反閒，欲以亂齊。易王立十二年卒，子燕噲立。"}],"rationale":"依周初封建、燕君世系、割地救燕、讓國及秦滅諸國的具體語境暫定異稱。繼位不自動證父子；同爵者分國別與前後世代。太子平／燕昭王依本篇明示，不表示年代及世系已校定。作君奭為書名，君奭不説之君奭才暫解召公稱呼。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji069-026","person_id":"cbr-p004047","scope":"same_chapter","chapter_ids":["c-shiji-069-su"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["大王","太子","易王","燕太子","燕易王","燕王"],"evidence":[{"paragraph_id":"c-shiji-069-su:p040","quote":"秦惠王以其女為燕太子婦。是歲，文侯卒，太子立，是為燕易王。易王初立，齊宣王因燕喪伐燕，取十城。易王謂蘇秦曰：「往日先生至燕，而先王資先生見趙，遂約六國從。今齊先伐趙，次至燕，以先生之故為天下笑，先生能為燕得侵地乎？」蘇秦大慚，曰：「請為王取之。」"},{"paragraph_id":"c-shiji-069-su:p042","quote":"人有毀蘇秦者曰：「左右賣國反覆之臣也，將作亂。」蘇秦恐得罪歸，而燕王不復官也。蘇秦見燕王曰：「臣，東周之鄙人也，無有分寸之功，而王親拜之於廟而禮之於廷。今臣為王卻齊之兵而攻得十城，宜以益親。今來而王不官臣者，人必有以不信傷臣於王者。臣之不信，王之福也。臣聞忠信者，所以自為也；進取者，所以為人也。且臣之說齊王，曾非欺之也。臣棄老母於東周，固去自為而行進取也。今有孝如曾參，廉如伯夷，信如尾生。得此三人者以事大王，何若？」王曰：「足矣。」蘇秦曰：「孝如曾參，義不離其親一宿於外，王又安能使之步行千里而事弱燕之危王哉？廉如伯夷，義不為孤竹君之嗣，不肯為武王臣，不受封侯而餓死首陽山下。有廉如此，王又安能使之步行千里而行進取於齊哉？信如尾生，與女子期於梁下，女子不來，水至不去，抱柱而死。有信如此，王又安能使之步行千里卻齊之彊兵哉？臣所謂以忠信得罪於上者也。」燕王曰：「若不忠信耳，豈有以忠信而得罪者乎？」蘇秦曰：「不然。臣聞客有遠為吏而其妻私於人者，其夫將來，其私者憂之，妻曰『勿憂，吾已作藥酒待之矣』。居三日，其夫果至，妻使妾舉藥酒進之。妾欲言酒之有藥，則恐其逐主母也，欲勿言乎，則恐其殺主父也。於是乎詳僵而棄酒。主父大怒，笞之五十。故妾一僵而覆酒，上存主父，下存主母，然而不免於笞，惡在乎忠信之無罪也？夫臣之過，不幸而類是乎！」燕王曰：「先生復就故官。」益厚遇之。"},{"paragraph_id":"c-shiji-069-su:p043","quote":"易王母，文侯夫人也，與蘇秦私通。燕王知之，而事之加厚。蘇秦恐誅，乃說燕王曰：「臣居燕不能使燕重，而在齊則燕必重。」燕王曰：「唯先生之所為。」於是蘇秦詳為得罪於燕而亡走齊，齊宣王以為客卿。"},{"paragraph_id":"c-shiji-069-su:p044","quote":"齊宣王卒，湣王即位，說湣王厚葬以明孝，高宮室大苑囿以明得意，欲破敝齊而為燕。燕易王卒，燕噲立為王。其後齊大夫多與蘇秦爭寵者，而使人刺蘇秦，不死，殊而走。齊王使人求賊，不得。蘇秦且死，乃謂齊王曰：「臣即死，車裂臣以徇於市，曰『蘇秦為燕作亂於齊』，如此則臣之賊必得矣。」於是如其言，而殺蘇秦者果自出，齊王因而誅之。燕聞之曰：「甚矣，齊之為蘇生報仇也！」"}],"rationale":"按姓名、字稱、遊說對象及嵌入書信局部暫接。蘇代初見燕王、過魏魏王齊王及書信秦王楚王等另存候選，未按歷史年代補熟名；不斷言這些候選必為異人。燕噲讓位段與燕昭王書信分辨，書信內外王稱按引語範圍。穰侯舅與太后母局部暫接，未補姓名或秦王親屬世系。故事家屬與蘇秦家屬分存；全67段明示姓名首輪已存，版本年代、匿名者代詞及其他身份尚待覆核。 第42段大王在蘇秦對燕易王的引語中歸燕易王；其中另述齊王保留齊宣王。"}],"equivalence_decisions":[{"id":"eq-shiji069-yi","person_ids":["cbr-p001347","cbr-p004047"],"canonical_person_id":"cbr-p001347","scope":"cross_chapter","chapter_ids":["c-shiji-034-yan","c-shiji-069-su"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-034-yan","source_id":"s-shiji-034-yan","paragraph_id":"c-shiji-034-yan:p020","quote":"易王初立，齊宣王因燕喪伐我，取十城；蘇秦説齊，使復歸燕十城。十年，燕君爲王。蘇秦與燕文公夫人私通，懼誅，乃説王使齊爲反閒，欲以亂齊。易王立十二年卒，子燕噲立。","mention_ids":["c-shiji-034-yan:m020-0000","c-shiji-034-yan:m020-0033","c-shiji-034-yan:m020-0066"]},{"chapter_id":"c-shiji-069-su","source_id":"s-shiji-069-su","paragraph_id":"c-shiji-069-su:p040","quote":"秦惠王以其女為燕太子婦。是歲，文侯卒，太子立，是為燕易王。易王初立，齊宣王因燕喪伐燕，取十城。易王謂蘇秦曰：「往日先生至燕，而先王資先生見趙，遂約六國從。今齊先伐趙，次至燕，以先生之故為天下笑，先生能為燕得侵地乎？」蘇秦大慚，曰：「請為王取之。」","mention_ids":["c-shiji-069-su:m040-0007","c-shiji-069-su:m040-0019","c-shiji-069-su:m040-0025","c-shiji-069-su:m040-0029","c-shiji-069-su:m040-0047"]}],"rationale":"兩篇易王初立均遇齊宣王趁燕喪取十城，蘇秦出使請歸地，王稱與事件相配。 原ID與篇文保留，同書篇章不是獨立見證；本篇自述異時事附於蘇秦，同指不確證事件年代或全部生平。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-034-yan:p018","text":"文公十九年，齊威王卒。二十八年，蘇秦始來見，説文公。文公予車馬金帛以至趙，趙肅侯用之。因約六國，爲從長。秦惠王以其女爲燕太子婦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m018-0000","start":0,"end":2,"surface":"文公","kind":"person","person_id":"cbr-p001345","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m018-0006","start":6,"end":9,"surface":"齊威王","kind":"person","person_id":"cbr-p000448","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m018-0016","start":16,"end":18,"surface":"蘇秦","kind":"person","person_id":"cbr-p000624","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m018-0023","start":23,"end":25,"surface":"文公","kind":"person","person_id":"cbr-p001345","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m018-0026","start":26,"end":28,"surface":"文公","kind":"person","person_id":"cbr-p001345","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m018-0037","start":37,"end":40,"surface":"趙肅侯","kind":"person","person_id":"cbr-p001346","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m018-0045","start":45,"end":47,"surface":"六國","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m018-0049","start":49,"end":51,"surface":"從長","kind":"unresolved","person_id":null,"status":"unresolved","note":"本段從長主語尚未確定，不先指定蘇秦或趙肅侯。"},{"id":"c-shiji-034-yan:m018-0052","start":52,"end":55,"surface":"秦惠王","kind":"person","person_id":"cbr-p000290","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m018-0057","start":57,"end":58,"surface":"女","kind":"person","person_id":"cbr-p001373","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m018-0059","start":59,"end":62,"surface":"燕太子","kind":"person","person_id":"cbr-p001347","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-034-yan:p019","text":"二十九年，文公卒，太子立，是爲易王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m019-0005","start":5,"end":7,"surface":"文公","kind":"person","person_id":"cbr-p001345","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m019-0009","start":9,"end":11,"surface":"太子","kind":"person","person_id":"cbr-p001347","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m019-0015","start":15,"end":17,"surface":"易王","kind":"person","person_id":"cbr-p001347","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-034-yan:p020","text":"易王初立，齊宣王因燕喪伐我，取十城；蘇秦説齊，使復歸燕十城。十年，燕君爲王。蘇秦與燕文公夫人私通，懼誅，乃説王使齊爲反閒，欲以亂齊。易王立十二年卒，子燕噲立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m020-0000","start":0,"end":2,"surface":"易王","kind":"person","person_id":"cbr-p001347","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0005","start":5,"end":8,"surface":"齊宣王","kind":"person","person_id":"cbr-p001348","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0018","start":18,"end":20,"surface":"蘇秦","kind":"person","person_id":"cbr-p000624","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0033","start":33,"end":35,"surface":"燕君","kind":"person","person_id":"cbr-p001347","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0038","start":38,"end":40,"surface":"蘇秦","kind":"person","person_id":"cbr-p000624","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0041","start":41,"end":44,"surface":"燕文公","kind":"person","person_id":"cbr-p001345","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0044","start":44,"end":46,"surface":"夫人","kind":"person","person_id":"cbr-p001374","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0066","start":66,"end":68,"surface":"易王","kind":"person","person_id":"cbr-p001347","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m020-0075","start":75,"end":77,"surface":"燕噲","kind":"person","person_id":"cbr-p001349","status":"contextual_provisional"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-069-su:p040","text":"秦惠王以其女為燕太子婦。是歲，文侯卒，太子立，是為燕易王。易王初立，齊宣王因燕喪伐燕，取十城。易王謂蘇秦曰：「往日先生至燕，而先王資先生見趙，遂約六國從。今齊先伐趙，次至燕，以先生之故為天下笑，先生能為燕得侵地乎？」蘇秦大慚，曰：「請為王取之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m040-0000","start":0,"end":3,"surface":"秦惠王","kind":"person","person_id":"cbr-p004026","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0004","start":4,"end":6,"surface":"其女","kind":"person","person_id":"cbr-p004056","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0007","start":7,"end":10,"surface":"燕太子","kind":"person","person_id":"cbr-p004047","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0010","start":10,"end":11,"surface":"婦","kind":"person","person_id":"cbr-p004056","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0015","start":15,"end":17,"surface":"文侯","kind":"person","person_id":"cbr-p004030","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0019","start":19,"end":21,"surface":"太子","kind":"person","person_id":"cbr-p004047","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0025","start":25,"end":28,"surface":"燕易王","kind":"person","person_id":"cbr-p004047","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0029","start":29,"end":31,"surface":"易王","kind":"person","person_id":"cbr-p004047","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0034","start":34,"end":37,"surface":"齊宣王","kind":"person","person_id":"cbr-p004045","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0047","start":47,"end":49,"surface":"易王","kind":"person","person_id":"cbr-p004047","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0050","start":50,"end":52,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0057","start":57,"end":59,"surface":"先生","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0063","start":63,"end":65,"surface":"先王","kind":"person","person_id":"cbr-p004030","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0066","start":66,"end":68,"surface":"先生","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0088","start":88,"end":90,"surface":"先生","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0097","start":97,"end":99,"surface":"先生","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m040-0108","start":108,"end":110,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p042","text":"人有毀蘇秦者曰：「左右賣國反覆之臣也，將作亂。」蘇秦恐得罪歸，而燕王不復官也。蘇秦見燕王曰：「臣，東周之鄙人也，無有分寸之功，而王親拜之於廟而禮之於廷。今臣為王卻齊之兵而攻得十城，宜以益親。今來而王不官臣者，人必有以不信傷臣於王者。臣之不信，王之福也。臣聞忠信者，所以自為也；進取者，所以為人也。且臣之說齊王，曾非欺之也。臣棄老母於東周，固去自為而行進取也。今有孝如曾參，廉如伯夷，信如尾生。得此三人者以事大王，何若？」王曰：「足矣。」蘇秦曰：「孝如曾參，義不離其親一宿於外，王又安能使之步行千里而事弱燕之危王哉？廉如伯夷，義不為孤竹君之嗣，不肯為武王臣，不受封侯而餓死首陽山下。有廉如此，王又安能使之步行千里而行進取於齊哉？信如尾生，與女子期於梁下，女子不來，水至不去，抱柱而死。有信如此，王又安能使之步行千里卻齊之彊兵哉？臣所謂以忠信得罪於上者也。」燕王曰：「若不忠信耳，豈有以忠信而得罪者乎？」蘇秦曰：「不然。臣聞客有遠為吏而其妻私於人者，其夫將來，其私者憂之，妻曰『勿憂，吾已作藥酒待之矣』。居三日，其夫果至，妻使妾舉藥酒進之。妾欲言酒之有藥，則恐其逐主母也，欲勿言乎，則恐其殺主父也。於是乎詳僵而棄酒。主父大怒，笞之五十。故妾一僵而覆酒，上存主父，下存主母，然而不免於笞，惡在乎忠信之無罪也？夫臣之過，不幸而類是乎！」燕王曰：「先生復就故官。」益厚遇之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m042-0000","start":0,"end":3,"surface":"人有毀","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m042-0003","start":3,"end":5,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0024","start":24,"end":26,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0032","start":32,"end":34,"surface":"燕王","kind":"person","person_id":"cbr-p004047","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0039","start":39,"end":41,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0042","start":42,"end":44,"surface":"燕王","kind":"person","person_id":"cbr-p004047","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0128","start":128,"end":131,"surface":"忠信者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m042-0138","start":138,"end":141,"surface":"進取者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m042-0152","start":152,"end":154,"surface":"齊王","kind":"person","person_id":"cbr-p004045","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0163","start":163,"end":165,"surface":"老母","kind":"person","person_id":"cbr-p004055","status":"contextual_provisional"},{"id":"c-shiji-069-su:m042-0183","start":183,"end":185,"surface":"曾參","kind":"person","person_id":"cbr-p004048","status":"contextual_provisional"},{"id":"c-shiji-069-su:m04