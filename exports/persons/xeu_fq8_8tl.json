],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-guoshu:line131","text":"王澄聞其名，引為別駕。澄終日酣飲，不以眾務在意，舒常切諫之。及天下大亂，又勸澄修德養威，保完州境。澄以為亂自京都起，非復一州所能匡禦，雖不能從，然重其忠亮。荊土士人宗庾廞嘗因酒忤澄，澄怒，叱左右棒廞。舒厲色謂左右曰：「使君過醉，汝輩何敢妄動！」澄恚曰：「別駕狂邪，誑言我醉！」因遣掐其鼻，灸其眉頭，舒跪而受之。澄意少釋，而廞遂得免。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-guoshu:line131:m0000","start":0,"end":2,"surface":"王澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line131:m0011","start":11,"end":12,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line131:m0024","start":24,"end":25,"surface":"舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line131:m0038","start":38,"end":39,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line131:m0049","start":49,"end":50,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line131:m0082","start":82,"end":85,"surface":"宗庾廞","kind":"person","person_id":"xeu_fq8_8tl","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line131:m0089","start":89,"end":90,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line131:m0091","start":91,"end":92,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-guoshu:line131:m0098","start":98,"end":99,"surface":"廞","kind":"person","person_id":"xeu_fq8_8tl","status":"contextual_provisional","interpretation_note":"以來源原字標記。