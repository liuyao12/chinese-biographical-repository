{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000958","identity_policy":"contextual_provisional","person_ids":["cbr-p000958"],"persons":[{"id":"cbr-p000958","label":"汝南王（中六年候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"汝南王","mention_ids":["c-shiji-011-jingdi:m014-0035"]}],"evidence":[{"mention_id":"c-shiji-011-jingdi:m014-0035","chapter_id":"c-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p014","quote":"汝南王"}]}],"mentions":[{"id":"c-shiji-011-jingdi:m014-0035","start":35,"end":38,"surface":"汝南王","kind":"person","person_id":"cbr-p000958","status":"contextual_provisional","paragraph_id":"c-shiji-011-jingdi:p014","chapter_id":"c-shiji-011-jingdi"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-011-jingdi:p014","text":"中六年二月己卯，行幸雍，郊見五帝。三月，雨雹。四月，梁孝王、城陽共王、汝南王皆薨。立梁孝王子明為濟川王，子彭離為濟東王，子定為山陽王，子不識為濟陰王。梁分為五。封四侯。更命廷尉為大理，將作少府為將作大匠，主爵中尉為都尉，長信詹事為長信少府，將行為大長秋，大行為行人，奉常為太常，典客為大行，治粟內史為大農。以大內為二千石，置左右內官，屬大內。七月辛亥，日食。八月，匈奴入上郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-011-jingdi:m014-0014","start":14,"end":16,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或未定指代，不補未見姓名與成員。"},{"id":"c-shiji-011-jingdi:m014-0026","start":26,"end":29,"surface":"梁孝王","kind":"person","person_id":"cbr-p000956","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m014-0030","start":30,"end":34,"surface":"城陽共王","kind":"person","person_id":"cbr-p000957","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m014-0035","start":35,"end":38,"surface":"汝南王","kind":"person","person_id":"cbr-p000958","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m014-0042","start":42,"end":45,"surface":"梁孝王","kind":"person","person_id":"cbr-p000956","status":"contextual_provisional"},{"id":"c-shiji-011-jin