{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004021","identity_policy":"contextual_provisional","person_ids":["cbr-p004021"],"persons":[{"id":"cbr-p004021","label":"徙木者（商君列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"一人","mention_ids":["c-shiji-068-shang:m005-0061"]}],"evidence":[{"mention_id":"c-shiji-068-shang:m005-0061","chapter_id":"c-shiji-068-shang","paragraph_id":"c-shiji-068-shang:p005","quote":"一人"}]}],"mentions":[{"id":"c-shiji-068-shang:m005-0061","start":61,"end":63,"surface":"一人","kind":"person","person_id":"cbr-p004021","status":"contextual_provisional","paragraph_id":"c-shiji-068-shang:p005","chapter_id":"c-shiji-068-shang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji068-027","person_id":"cbr-p004021","surfaces":["一人"],"scope":"same_chapter","chapter_ids":["c-shiji-068-shang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-068-shang:p005","quote":"令既具，未布，恐民之不信，已乃立三丈之木於國都市南門，募民有能徙置北門者予十金。民怪之，莫敢徙。復曰「能徙者予五十金」。有一人徙之，輒予五十金，以明不欺。卒下令。"}],"rationale":"篇首明示商君名鞅公孫氏，入秦段續稱公孫鞅衛鞅，封號段號商君，局部暫接。魏惠王與梁惠王按魏徙都敘事暫接，秦太子立後秦惠王暫接而不補名。趙良對話夫子歸趙良；五羖大夫引古不補未載姓名。公叔座不按公叔與孫吳篇合併；公子驩不當新名，商君開塞耕戰書不作本人錨點。版本、年代及其他代詞仍待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-068-shang:p005","text":"令既具，未布，恐民之不信，已乃立三丈之木於國都市南門，募民有能徙置北門者予十金。民怪之，莫敢徙。復曰「能徙者予五十金」。有一人徙之，輒予五十金，以明不欺。卒下令。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-068-shang:m005-0008","start":8,"end":9,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、泛論或未定指代；不補族群成員、闕代或姓名。"},{"id":"c-shiji-068-shang:m005-0028","start":28,"end":29,"surface":"民","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、泛論或未定指代；不補族群成員、闕代或姓名。"},{"id":"c-shiji-068-shang:m005-0040","start":40,"end":41,