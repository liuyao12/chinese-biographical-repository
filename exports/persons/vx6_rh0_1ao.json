"preferred_relations":[{"id":"a-shiji122-007","subject_person_id":"fiy_rdu_4os","predicate":"mother","object_person_id":"vx6_rh0_1ao","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p026","quote":"義縱者，河東人也。爲少年時，嘗與張次公倶攻剽爲群盜。縱有姊姁，以醫幸王太后。王太后問：「有子兄弟爲官者乎？」姊曰：「有弟無行，不可。」太后乃告上，拜義姁弟縱爲中郎，補上黨郡中令。治敢行，少蘊藉，縣無逋事，舉爲第一。遷爲長陵及長安令，直法行治，不避貴戚。以捕案太后外孫修成君子仲，上以爲能，遷爲河内都尉。至則族滅其豪穰氏之屬，河内道不拾遺。而張次公亦爲郎，以勇悍從軍，敢深入，有功，爲岸頭侯。"}],"qualifiers":{"source_term":"太后外孫修成君子仲"},"interpretation_note":"原文稱仲為太后外孫、修成君之子，按此句母系親屬脈絡記錄母子；不補仲父姓名或修成君婚姻。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m026-0133","start":133,"end":136,"surface":"修成君","kind":"person","person_id":"vx6_rh0_1ao","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p026","chapter_id":"c-shiji-122-kuli"}],"relations":[{"id":"a-shiji122-007","subject_person_id":"fiy_rdu_4os","predicate":"mother","object_person_id":"vx6_rh0_1ao","status":"source_attested","evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p026","quote":"義縱者，河東人也。爲少年時，嘗與張次公倶攻剽爲群盜。縱有姊姁，以醫幸王太后。王太后問：「有子兄弟爲官者乎？」姊曰：「有弟無行，不可。」太后乃告上，拜義姁弟縱爲中郎，補上黨郡中令。治敢行，少蘊藉，縣無逋事，舉爲第一。遷爲長陵及長安令，直法行治，不避貴戚。以捕案太后外孫修成君子仲，上以爲能，遷爲河内都尉。至則族滅其豪穰氏之屬，河内道不拾遺。而張次公亦爲郎，以勇悍從軍，敢深入，有功，爲岸頭侯。"}],"qualifiers":{"source_term":"太后外孫修成君子仲"},"interpretation_note":"原文稱仲為太后外孫、修成君之子，按此句母系親屬脈絡記錄母子；不補仲父姓名或修成君婚姻。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p026","text":"義縱者，河東人也。爲少年時，嘗與張次公倶攻剽爲群盜。縱有姊姁，以醫幸王太后。王太后問：「有子兄弟爲官者乎？」姊曰：「有弟無行，不可。」太后乃告上，拜義姁弟縱爲中郎，補上黨郡中令。治敢行，少蘊藉，縣