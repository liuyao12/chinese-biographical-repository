m060-0036","chapter_id":"c-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p060","quote":"厲"}]},{"id":"cbr-p002131","label":"宋雍氏女（鄭世家突母候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"宋雍氏女","mention_ids":["c-shiji-042-zheng:m008-0004"]}],"evidence":[{"mention_id":"c-shiji-042-zheng:m008-0004","chapter_id":"c-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p008","quote":"宋雍氏女"}]}],"mentions":[{"id":"c-shiji-042-zheng:m008-0004","start":4,"end":8,"surface":"宋雍氏女","kind":"person","person_id":"cbr-p002131","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p008","chapter_id":"c-shiji-042-zheng"}],"relations":[{"id":"a-shiji042-011","subject_person_id":"cbr-p002128","predicate":"mother","object_person_id":"cbr-p002131","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p008","quote":"莊公又娶宋雍氏女，生厲公突。雍氏有寵於宋。宋莊公聞祭仲之立忽，乃使人誘召祭仲而執之，曰：「不立突，將死。」亦執突以求賂焉。祭仲許宋，與宋盟。以突歸，立之。昭公忽聞祭仲以宋要立其弟突，九月（辛）［丁］亥，忽出奔衞。己亥，突至鄭，立，是爲厲公。"}],"qualifiers":{"source_term":"宋雍氏女，生厲公突","historicity":"historical_tradition"},"interpretation_note":"保存本段明示子、生育、母稱與兄弟來源主張；不把繼位獨自作父子，不補未知母名或同父同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji042-037","person_id":"cbr-p002131","surfaces":["宋雍氏女"],"scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-042-zheng:p008","quote":"莊公又娶宋雍氏女，生厲公突。雍氏有寵於宋。宋莊公聞祭仲之立忽，乃使人誘召祭仲而執之，曰：「不立突，將死。」亦執突以求賂焉。祭仲許宋，與宋盟。以突歸，立之。昭公忽聞祭仲以宋要立其弟突，九月（辛）［丁］亥，忽出奔衞。己亥，突至鄭，立，是爲厲公。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-042-zheng:p008","text":"莊公又娶宋雍氏女，生厲公突。雍氏有寵於宋。宋莊公聞祭仲之立忽，乃使人誘召祭仲而執之，曰：「不立突，將死。」亦執突以求賂焉。祭仲許宋，與宋盟。以突歸，立之。昭公忽聞祭仲以宋要立其弟突，九月（辛）［丁］亥，忽出奔衞。己亥，突至鄭，立，是爲厲公。","annot