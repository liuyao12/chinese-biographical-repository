dings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-123-dayuan:p003","text":"居匈奴中，益寬，騫因與其屬亡鄉月氏，西走數十日至大宛。大宛聞漢之饒財，欲通不得，見騫，喜，問曰：「若欲何之？」騫曰：「為漢使月氏，而為匈奴所閉道。今亡，唯王使人導送我。誠得至，反漢，漢之賂遺王財物不可勝言。」大宛以為然，遣騫，為發導繹，抵康居，康居傳致大月氏。大月氏王已為胡所殺，立其太子為王。既臣大夏而居，地肥饒，少寇，志安樂，又自以遠漢，殊無報胡之心。騫從月氏至大夏，竟不能得月氏要領。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-123-dayuan:m003-0008","start":8,"end":9,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0041","start":41,"end":42,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0055","start":55,"end":56,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0077","start":77,"end":78,"surface":"王","kind":"person","person_id":"86r_v76_3mc","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0095","start":95,"end":96,"surface":"王","kind":"person","person_id":"86r_v76_3mc","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0111","start":111,"end":112,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0130","start":130,"end":134,"surface":"大月氏王","kind":"person","person_id":"vgg_tso_418","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0141","start":141,"end":144,"surface":"其太子","kind":"person","person_id":"vgg_tso_418_A","status":"contextual_provisional"},{"id":"c-shiji-123-dayuan:m003-0178","start":178,"end":179,"surface":"騫","kind":"person","person_id":"gqj_xdu_8rf","status":"contextual_provisional"}],"chapter_id":"c-shiji-123-dayuan","book_id":"b-shiji-123","work_id":"w-shiji","source_id":"s-shiji123-dayuan"}],"sources":[{"chapter_id":"c-shiji-123