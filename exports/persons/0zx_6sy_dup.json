nd":74,"surface":"終軍","kind":"person","person_id":"0zx_6sy_dup","status":"contextual_provisional","paragraph_id":"c-shiji-113-nanyue:p007","chapter_id":"c-shiji-113-nanyue"}],"relations":[],"title_holdings":[{"id":"th-shiji113-015","person_id":"0zx_6sy_dup","title":"諫大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-113-nanyue","source_id":"s-shiji113-nanyue","paragraph_id":"c-shiji-113-nanyue:p007","quote":"太子興代立，其母為太后。太后自未為嬰齊姬時，嘗與霸陵人安國少季通。及嬰齊薨後，元鼎四年，漢使安國少季往諭王、王太后以入朝，比內諸侯；令辯士諫大夫終軍等宣其辭，勇士魏臣等輔其缺，衛尉路博德將兵屯桂陽，待使者。王年少，太後中國人也，嘗與安國少季通，其使復私焉。國人頗知之，多不附太后。太后恐亂起，亦欲倚漢威，數勸王及群臣求內屬。即因使者上書，請比內諸侯，三歲一朝，除邊關。於是天子許之，賜其丞相呂嘉銀印，及內史、中尉、太傅印，餘得自置。除其故黥劓刑，用漢法，比內諸侯。使者皆留填撫之。王、王太后飭治行裝重齎，為入朝具。"}],"attestations":[{"id":"th-shiji113-015:a001","paragraph_id":"c-shiji-113-nanyue:p007","start":69,"end":72,"surface":"諫大夫","person_mention_id":"c-shiji-113-nanyue:m007-0072","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授受事件與文獻用稱分存；原文沒有確切任期終點則保留未知，死亡不自動終止官爵。故濟北相為追述舊官；去帝制與國內仍用帝號的差異另待處理。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi047-zhongjun","person_id":"0zx_6sy_dup","surfaces":["終軍"],"scope":"cross_chapter","chapter_ids":["c-nanqishu-047-compiler-appraisal","c-shiji-113-nanyue"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-047","source_id":"s-nanqishu-047-appraisal-kr787dd9a7","chapter_id":"c-nanqishu-047-compiler-appraisal","paragraph_id":"c-nanqishu-047-compiler-appraisal:p001","quote":"史臣曰晉世遷宅江表人無北歸之計英霸作輔芟定中原彌見金德之不競也元嘉冄畧河南師旅傾覆自此以來攻伐寢議雖有戰爭事存保境王融生遇永明軍國寧息以文敏才華不足進取經畧心㫖殷懃表奏若使宫車未晏有事邉關融之報効或不易限夫經國體遠許乆為難而立功立事信居物右其賈誼終軍之流亞乎"},{"work_id":"w-shiji","book_id":"b-shiji-113","source_id":"s-sh