entions":[{"id":"c-jinshu-063-guomo:p002:m0143","surface":"李龍","start":143,"end":145,"person_id":"4ej_623_1t3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-063-guomo:p002","chapter_id":"c-jinshu-063-guomo"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-063-guomo:p002","text":"太興初，除潁川太守。默與石匆戰敗，矩轉蹙弱，默深憂懼，解印授其參軍殷嶠，謂之曰：「李使君遇吾甚厚，今遂棄去，無顏謝之，三日可白吾去也。」乃奔陽翟。矩聞之，大怒，遣其將郭誦追默，至襄城，及之。默棄家人，單馬馳去。默至京都，明帝授征虜將軍。劉遐卒，以默為北中郎將、監淮北軍事、假節。遐故部曲李龍等謀反，詔默與右衛將軍趙胤討平之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":73,"last_line":73,"raw_start":6484,"raw_end":6648,"raw_character_offsets":[6486,6487,6488,6489,6490,6491,6492,6493,6494,6495,6496,6497,6498,6499,6500,6501,6502,6503,6504,6505,6506,6507,6508,6509,6510,6511,6512,6513,6514,6515,6516,6517,6518,6519,6520,6521,6522,6523,6524,6525,6526,6527,6528,6529,6530,6531,6532,6533,6534,6535,6536,6537,6538,6539,6540,6541,6542,6543,6544,6545,6546,6547,6548,6549,6550,6551,6552,6553,6554,6555,6556,6557,6558,6559,6560,6561,6562,6563,6564,6565,6566,6567,6568,6569,6570,6571,6572,6573,6574,6575,6576,6577,6578,6579,6580,6581,6582,6583,6584,6585,6586,6587,6588,6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647],"revision_id":2025242},"mentions":[{"id":"c-jinshu-063-guomo:p002:m0010","surface":"默","start":10,"end":11,"person_id":"799_f6c_778","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-063-guomo:p002:m0012","surface":"石匆","start":12,"end":14,"person_id":"u1r_1qn_z55","kind":"person","status":"contextual_provisional"},{"id"