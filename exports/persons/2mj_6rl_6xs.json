194,4195,4201,4202,4203,4204,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,4218,4219,4220,4221,4224,4227,4228,4229,4230,4231,4232,4233,4234,4237,4240,4241,4242,4243,4244,4245,4246,4247,4248,4251,4254,4255,4256,4257,4258,4259,4260,4261,4262,4263,4264,4270,4271,4272,4273,4276,4277,4278,4279,4280,4286,4287,4288,4289,4292,4293,4294,4295,4296,4297,4298,4299,4300,4301,4302,4303,4304,4305,4306,4309,4312,4313,4314,4315,4316,4317],"projection_sha256":"4c80dc6bbc31dae828e45e1d8d65fbfe0073d4501aa132666b6a2b972f688d8c","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-012-chen-wang-empress-and-zhize","book_id":"b-nanshi-012","work_id":"w-nanshi","source_id":"s-nanshi-012-chen-wang-empress-and-zhize-ws2060595"},{"id":"c-nanshi-021-wangyang:p001","text":"瑒字子瑛，沈靜有器局，美風儀。梁元帝時，位太子中庶子。陳武帝入輔，以爲司徒左長史。文帝即位，累遷太子中庶子、散騎常侍、侍中。父沖嘗爲瑒辭領中庶子，文帝顧沖曰：「所以久留瑒于承華，正欲使太子微有瑒風法耳。」","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"瑒","id":"c-nanshi-021-wangyang:p001:m0000","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":2,"end":4,"surface":"子瑛","id":"c-nanshi-021-wangyang:p001:m0002","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":63,"end":64,"surface":"沖","id":"c-nanshi-021-wangyang:p001:m0063","person_id":"7r6_k52_qji_ABAAAAAABAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作沖。"},{"start":66,"end":67,"surface":"瑒","id":"c-nanshi-021-wangyang:p001:m0066","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":76,"end":77,"surface":"沖","id":"c-nanshi-021-wangyang:p001:m0076","person_id":"7r6_k52_qji_ABAAAAAABAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作沖。"},{"start":84,"end":85,"surface":"瑒","id":"c-nanshi-021-wangyang:p001:m0084","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"},{"start":96,"end":97,"surface":"瑒","id":"c-nanshi-021-wangyang:p001:m0096","person_id":"7r6_k52_qji_ABAAAAAABAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瑒。"}],"source_position":{"revision_id":1752646,"source_layer":"received_biography","raw_start":7209,"raw_end":7319,"raw_character_offsets":[7209,7210,7211,7212,7213,7214,7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7274,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7291,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318],"projection_sha256":"4780646d309b2b8ec2e705c071269f6becf7b93540da69eea53d812a1487cb4b"},"chapter_id":"c-nanshi-021-wangyang","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangyang-ws1752646"},{"id":"c-nanshi-023-wanggu-zijian:p002","text":"承聖元年，為太子中庶子，遷尋陽太守。魏克荊州，固之鄱陽，隨兄質度東嶺，居信安縣。陳永定中，移居吳郡。文帝以固清靜，且欲申以婚姻。天嘉中，歷位中書令，散騎常侍，國子祭酒。以其女為皇太子妃，禮遇甚重。","mentions":[{"id":"c-nanshi-023-wanggu-zijian:p002:m0023","surface":"固","start":23,"end":24,"person_id":"q7m_r8k_2vn_ABAE","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wanggu-zijian:p002:m0030","surface":"質","start":30,"end":31,"person_id":"q7m_r8k_2vn_ABAD","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wanggu-zijian:p002:m0053","surface":"固","start":53,"end":54,"person_id":"q7m_r8k_2vn_ABAE","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"rec