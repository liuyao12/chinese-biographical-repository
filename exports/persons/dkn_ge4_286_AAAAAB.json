16,"end":117,"surface":"漼","kind":"person","person_id":"dkn_ge4_286_AAAAAD","status":"contextual_provisional"}],"source_position":{"first_line":28,"last_line":28,"revision_id":2444513,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-038-langye-near-family","book_id":"b-jinshu-038","work_id":"w-jinshu","source_id":"s-jinshu-038-langye-near-family"}],"sources":[{"chapter_id":"c-jinshu-038-langye-near-family","work_id":"w-jinshu","book_id":"b-jinshu-038","source_id":"s-jinshu-038-langye-near-family","source":{"title":"《晉書》卷038（琅邪宗室父子選段）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2444513","permalink":"https://zh.wikisource.org/w/index.php?oldid=2444513","revision_id":2444513,"accessed_on":"2026-10-18","extent":"宣帝九男、伷篇末兩完整原段，及覲、渾父子兩處節錄；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","wikitext_sha256":"0ccab16e0c18edff6af7aa242c765c728b3f3e64ab3487a528513843281c2bb3","normalization":{"character_conversion":{},"extraction_note":"原行中明示節錄邊界；首段止於中興初之前，次段止於為東安王。僅展開維基連結、單參數年號模板。未收入的宗祀後文與數位校注不作本次正文。 新增原行12、28完整原段，移出ref校注、展開連結與年號模板、去粗體排版。","excerpts":[{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:p001","source_lines":[31,31],"raw_quote":"覲字思祖，拜冗從僕射。{{YL|太熙元年}}薨，時年三十五。子睿立，是為[[晉書/卷006#元帝|元帝]]。","raw_quote_sha256":"92b6b1a02491ca0bae5ba6efbd862434aa4a11adf451ec62b694bc2526214b9f","selected_text_sha256":"fad93529001ada968dcc9e1c0122ec579701178c22f8e836f307f4272b62a778","begin_anchor":"覲字思祖，拜冗從僕射。太","end_anchor":"十五。子睿立，是為元帝。"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:p002","source_lines":[41,41],"raw_quote":"後立琅邪王覲子長樂亭侯渾為東安王","raw_quote_sha256":"c2d57dc545484c083d35eb612cab1ce7c6c23cf288caf48916340f3df5eac989","selected_text_sha256":"c2d57dc545484c083d35eb612cab1ce7c6c23cf288caf48916340f3df5eac989","begin_anchor":"後立琅邪王覲子長樂亭侯渾","end_anchor":"王覲子長樂亭侯渾為東安王"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:line012","source_lines":[12,12],"raw_quote":"宣帝九男，[[晉書/卷031#宣穆張皇后|穆張皇后]]生[[晋书/卷002|景帝、文帝]]、平原王幹，伏夫人生汝南文成王亮、琅邪武王伷、清惠亭侯京、扶風武王駿，張夫人生梁王肜，柏夫人生趙王倫。亮及倫[[晉書/卷059#汝南文成王亮|別有傳]]<ref>亮及倫別有傳亮上原衍「汝南王亮」四字，今從吳本。</ref>。","raw_quote_sha256":"9d741ee0b3e17e6ca567108a29100f3bc8d931a5024c637e80643acda1c75d4e","selected_text_sha256":"7bb98cf560424553df55c266814dfa416afbbb2135eea9b6178cb65e3749cef9","begin_anchor":"宣帝九男，穆張皇后生景帝","end_anchor":"生趙王倫。亮及倫別有傳。"},{"proposed_paragraph_id":"c-jinshu-038-langye-near-family:line028","source_lines":[28,28],"raw_quote":"伷既戚屬尊重，加有平吳之功，克己恭儉，無矜滿之色，僚吏盡力，百姓懷化。疾篤，賜床帳、衣服、錢帛、秔梁等物，遣侍中問焉。{{YL|太康四年}}薨，時年五十七。臨終表求葬母太妃陵次，並乞分國封四子，帝許之。子'''恭王覲'''立。又封次子澹為武陵王，繇為東安王，漼為淮陵王。","raw_quote_sha256":"ef2acda8c3066604221d94ec739fdff51de4c39b6a4f8c5081b690e40b4221b9","selected_text_sha256":"a385c4c93a02c7e1376b1354afeb7e1aa692098b28657e639422be5a3c9d9eb4","begin_anchor":"伷既戚屬尊重，加有平吳之","end_anchor":"繇為東安王，漼為淮陵王。"}],"removed_apparatus":[{"text_layer":"later_critical_apparatus","source_line":12,"raw_note":"亮及倫別有傳亮上原衍「汝南王亮」四字，今從吳本。","raw_note_sha256":"56487327592265c4717f825e825622e65455e9ec5597a1949119d7ec9afcae6d","collated_by_current_agent":false}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"dkn_ge4_286_AAAAAB","representative_source_person_id":"dkn_ge4_286_AAAAAB","source_person_ids":["dkn_ge4_286_AAAAAB"],"identity_equivalence_decision_ids":[],"parent_person_id":"dkn_ge4_286_AAAAA","source_assertion_id":"a-jinshu038-zhou-son-104","connection":"father","assembly_id":"family-sima-jun-near-ancestry","root_person_id":"dkn_ge4_286","status":"contextual_provisional","human_revi