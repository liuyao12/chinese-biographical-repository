-044-wei:p049","c-shiji-044-wei:p056"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-044-wei"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-044-wei:m049-0042","start":42,"end":44,"surface":"蘇代","kind":"person","person_id":"cbr-p002590","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p049","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m049-0070","start":70,"end":71,"surface":"代","kind":"person","person_id":"cbr-p002590","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p049","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m049-0100","start":100,"end":101,"surface":"代","kind":"person","person_id":"cbr-p002590","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p049","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m049-0133","start":133,"end":134,"surface":"代","kind":"person","person_id":"cbr-p002590","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p049","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m049-0152","start":152,"end":153,"surface":"代","kind":"person","person_id":"cbr-p002590","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p049","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m049-0189","start":189,"end":190,"surface":"代","kind":"person","person_id":"cbr-p002590","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p049","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m049-0264","start":264,"end":265,"surface":"代","kind":"person","person_id":"cbr-p002590","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p049","chapter_id":"c-shiji-044-wei"},{"id":"c-shiji-044-wei:m056-0086","start":86,"end":88,"surface":"蘇代","kind":"person","person_id":"cbr-p002590","status":"contextual_provisional","paragraph_id":"c-shiji-044-wei:p056","chapter_id":"c-shiji-044-wei"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-091","person_id":"cbr-p002590","surfaces":["代","蘇代"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p049","quote":"九年，與秦王會臨晉。張儀、魏章皆歸于魏。魏相田需死，楚害張儀、犀首、薛公。楚相昭魚謂蘇代曰：『田需死，吾恐張儀、犀首、薛公有一人相魏者也。』代曰：『然相者欲誰而君便之？』昭魚曰：『吾欲太子之自相也。』代曰：『請爲君北，必相之。』昭魚曰：『柰何？』對曰：『君其爲梁王，代請説君。』昭魚曰：『柰何？』對曰：『代也從楚來，昭魚甚憂，曰：「田需死，吾恐張儀、犀首、薛公有一人相魏者也。」代曰：「梁王，長主也，必不相張儀。張儀相，必右秦而左魏。犀首相，必右韓而左魏。薛公相，必右齊而左魏。梁王，長主也，必不便也。」王曰：「然則寡人孰相？」代曰：「莫若太子之自相。太子之自相，是三人者皆以太子爲非常相也，皆將務以其國事魏，欲得丞相璽也。以魏之彊，而三萬乘之國輔之，魏必安矣。故曰莫若太子之自相也。」』遂北見梁王，以此告之。太子果相魏。"},{"paragraph_id":"c-shiji-044-wei:p056","quote":"安釐王元年，秦拔我兩城。二年，又拔我二城，軍大梁下，韓來救，予秦温以和。三年，秦拔我四城，斬首四萬。四年，秦破我及韓、趙，殺十五萬人，走我將芒卯。魏將段干子請予秦南陽以和。蘇代謂魏王曰：『欲璽者段干子也，欲地者秦也。今王使欲地者制璽，使欲璽者制地，魏氏地不盡則不知已。且夫以地事秦，譬猶抱薪救火，薪不盡，火不滅。』王曰：『是則然也。雖然，事始已行，不可更矣。』對曰：『王獨不見夫博之所以貴梟者，便則食，不便則止矣。今王曰「事始已行，不可更」，是何王之用智不如用梟也？』"}],"rationale":"限本篇明示姓名、封號、繼位與連續對話。无忌／信陵君及增／景湣王按明示語句暫接；公子政不與秦王政按同名合併。太子自相、蘇代扮演梁王與秦王未名時段各保留，不補姓名；中旗馮琴讀法待底本核查。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-044-wei:p049","text":"九年，與秦王會臨晉。張儀、魏章皆歸于魏。魏相田需死，楚害張儀、犀首、薛公。楚相昭魚謂蘇代曰：『田需死，吾恐張儀、犀首、薛公有一人相魏者也。』代曰：『然相者欲誰而君便之？』昭魚曰：『吾欲太子之自相也。』代曰：『請爲君北，必相之。』昭魚曰：『柰何？』對曰：『君其爲梁王，代請説君。』昭魚曰：『柰何？』對曰：『代也從楚來，昭魚甚憂，曰：「田需死，吾恐張儀、犀首、薛公有一人相魏者也。」代曰：「梁王，長主也，必不相張儀。張儀相，必右秦而左魏。犀首相，必右韓而左魏。薛公相，必右齊而左魏。梁王，長主也，必不便也。」王曰：「然則寡人孰相？」代曰：「莫若太子之自相。太子之自相，是三人者皆以太子爲非常相也，皆將務以其國事魏，欲得丞相璽也。以魏之彊，而三萬乘之國輔之，魏必安矣。故曰莫若太子之自相也。」』遂北見梁王，以此告之。太子果相魏。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m049-0004","start":4,"end":6,"surface":"秦王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、假設人稱與未名者保留；游説中扮演梁王不當昭魚本人身份，安陵氏與阿衡不補熟知姓名。"},{"id":"c-shiji-044-wei:m049-0010","start":10,"end":12,"surface":"張儀","kind":"person","person_id":"cbr-p002576","status":"