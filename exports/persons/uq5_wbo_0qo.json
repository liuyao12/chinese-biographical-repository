ds":["c-nanqishu-042-xiaochen-complete:p005:m0167"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-042-xiaochen-complete-ws1507997"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi042-mozhiming-death","person_id":"uq5_wbo_0qo","event_type":"death","source_term":"死","source_anchor":{"paragraph_id":"c-nanqishu-042-xiaochen-complete:p005","start":169,"end":170,"surface":"死"},"date_expression":"至秋","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-042","chapter_id":"c-nanqishu-042-xiaochen-complete","source_id":"s-nanqishu-042-xiaochen-complete-ws1507997","paragraph_id":"c-nanqishu-042-xiaochen-complete:p005","quote":"　　二年六月，上幸華林園，宴諶及尚書令王晏等數人盡歡。坐罷，留諶晚出，至華林閤，仗身執還入省，上遣左右莫智明數諶曰：「隆昌之際，非卿無有今日。今一門二州，兄弟三封，朝廷相報，政可極此。卿恒懷怨望，乃云炊飯已熟，合甑與人邪？今賜卿死。」諶謂智明曰：「天去人亦復不遠，我與至尊殺高、武諸王，是君傳語來去。我今死，還取卿。」於省殺之，至秋而智明死，見諶爲祟。詔曰：「蕭諶擢自凡庸，識用輕險，因藉倖會，早預驅馳。永明之季，曲頒恩紀。鬱林昏悖，頗立誠效。寵靈優渥，期遇兼隆，內總戎柄，外暢蕃威，兄弟榮貴，震灼朝野。曾不感佩殊荷，少答萬一。自以勳高伊、霍，事均難賞，才冠當時，恥居物後。矯制王權，與奪由己。空懷疑懼，坐構嫌猜。覘候宮掖，希覬非望。蔽上罔下之心，誣君不臣之迹，固以彰暴民聽，喧聒遐邇。遂潛散金帛，招集不逞，交結禁衞，互爲脣齒，密契戚邸，將肆姦逆。朕以其任寄旣重，爵列河山，每加彌縫，弘以大信，庶能懷音，翻然悛改。而豺狼其性，凶謀滋甚。夫無將必戮，陽秋明義，況釁積禍盈，若斯之大。可收付廷尉，速正刑書。罪止元惡，餘無所問。」","person_mention_id":"c-nanqishu-042-xiaochen-complete:p005:m0051"}],"status":"source_attested","interpretation_note":"按同段人物與次第核所屬卒事。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"mentions":[{"id":"c-nanqishu-042-xiaochen-complete:p005:m0051","start":51,"end":54,"surface":"莫智明","kind":"person","person_id":"uq5_wbo_0qo","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-xiaochen-complete:p005","chapter_id":"c-nanqishu-042-xiaochen-complete"},{"id":"c-nanqishu-042-xiaochen-complete:p005:m0119","start":119,"end":121,"surface":"智明","kind":"person","person_id":"uq5_wbo_0qo","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-xiaochen-complete:p005","chapter_id":"c-nanqishu-042-xiaochen-complete"},{"id":"c-nanqishu-042-xiaochen-complete:p005:m0167","start":167,"end":169,"surface":"智明","kind":"person","person_id":"uq5_wbo_0qo","status":"contextual_provisional","paragraph_id":"c-nanqishu-042-xiaochen-complete:p005","chapter_id":"c-nanqishu-042-xiaochen-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-042-xiaochen-complete:p005","text":"　　二年六月，上幸華林園，宴諶及尚書令王晏等數人盡歡。坐罷，留諶晚出，至華林閤，仗身執還入省，上遣左右莫智明數諶曰：「隆昌之際，非卿無有今日。今一門二州，兄弟三封，朝廷相報，政可極此。卿恒懷怨望，乃云炊飯已熟，合甑與人邪？今賜卿死。」諶謂智明曰：「天去人亦復不遠，我與至尊殺高、武諸王，是君傳語來去。我今死，還取卿。」於省殺之，至秋而智明死，見諶爲祟。詔曰：「蕭諶擢自凡庸，識用輕險，因藉倖會，早預驅馳。永明之季，曲頒恩紀。鬱林昏悖，頗立誠效。寵靈優渥，期遇兼隆，內總戎柄，外暢蕃威，兄弟榮貴，震灼朝野。曾不感佩殊荷，少答萬一。自以勳高伊、霍，事均難賞，才冠當時，恥居物後。矯制王權，與奪由己。空懷疑懼，坐構嫌猜。覘候宮掖，希覬非望。蔽上罔下之心，誣君不臣之迹，固以彰暴民聽，喧聒遐邇。遂潛散金帛，招集不逞，交結禁衞，互爲脣齒，密契戚邸，將肆姦逆。朕以其任寄旣重，爵列河山，每加彌縫，弘以大信，庶能懷音，翻然悛改。而豺狼其性，凶謀滋甚。夫無將必戮，陽秋明義，況釁積禍盈，若斯之大。可收付廷尉，速正刑書。罪止元惡，餘無所問。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":40,"last_line":40,"raw_start":2866,"raw_end":3328,"raw_character_offsets":[2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,