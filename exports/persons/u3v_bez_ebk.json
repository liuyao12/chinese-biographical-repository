s_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":35,"end":37,"surface":"劉瓛","id":"c-nanshi-021-wangsengyou:p003:m0035","person_id":"u3v_bez_ebk","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瓛。","paragraph_id":"c-nanshi-021-wangsengyou:p003","chapter_id":"c-nanshi-021-wangsengyou"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-021-wangsengyou:p003","text":"雅好博古，善老、莊，不尚繁華。工草隸，善鼓琴，亭然獨立，不交當世。沛國劉瓛聞風而悅，上書薦之。爲著作佐郎，遷司空祭酒，謝病不與公卿遊。齊高帝謂王儉曰：「卿從可謂朝隱。」答曰：「臣從非敢妄同高人，直是愛閑多病耳。」經贈儉詩云：「汝家在市門，我家在南郭；汝家饒賓侶，我家多鳥雀。」儉時聲高一代，賓客填門，僧佑不爲之屈，時人嘉之。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":35,"end":37,"surface":"劉瓛","id":"c-nanshi-021-wangsengyou:p003:m0035","person_id":"u3v_bez_ebk","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作瓛。"},{"start":71,"end":73,"surface":"王儉","id":"c-nanshi-021-wangsengyou:p003:m0071","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作儉。"},{"start":108,"end":109,"surface":"儉","id":"c-nanshi-021-wangsengyou:p003:m0108","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作儉。"},{"start":138,"end":139,"surface":"儉","id":"c-nanshi-021-wangsengyou:p003:m0138","person_id":"7r6_k52_qji_ABAAAAEAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作儉。"},{"start":150,"end":152,"surface":"僧佑","id":"c-nanshi-021-wangsengyou:p003:m0150","person_id":"p93_tgr_t8r_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作佑。"}],"source_position":{"revision_id":1752646,"source_layer":"received_biography","raw_start":5781,"raw_end":