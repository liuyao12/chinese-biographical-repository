rt_codepoint":37,"end_codepoint":47,"human_reviewed":false,"chapter_id":"c-jinshu-070-ganzhuo","source_id":"s-jinshu-070-ganzhuo-ws2595540"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-070-ganzhuo:p008:m0044","surface":"卬","start":44,"end":45,"person_id":"phr_y7u_bil","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-ganzhuo:p008","chapter_id":"c-jinshu-070-ganzhuo"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-ganzhuo:p008","text":"卓雖懷義正，而性不果毅，且年老多疑，計慮猶豫，軍次豬口，累旬不前。敦大懼，遣卓兄子行參軍卬求和，謝卓曰：「君此自是臣節，不相責也。吾家計急，不得不爾。想便旋軍襄陽，當更結好。」時王師敗績，敦求臺騶虞幡駐卓。卓聞周顗、戴若思遇害，流涕謂卬曰：「吾之所憂，正謂今日。每得朝廷人書，常以胡寇爲先，不悟忽有蕭牆之禍。且使聖上元吉，太子無恙，吾臨敦上流，亦未敢便危社稷。吾適徑據武昌，敦勢逼，必劫天子以絕四海之望。不如還襄陽，更思後圖。」即命旋軍。都尉秦康說卓曰：「今分兵取敦不難，但斷彭澤，上下不得相赴，自然離散，可一戰擒也。將軍既有忠節，中道而廢，更爲敗軍將，恐將軍之下亦各便求西還，不可得守也。」卓不能從。樂道融亦日夜勸卓速下。卓性先寬和，忽便強塞，徑還襄陽，意氣騷擾，舉動失常，自照鏡不見其頭，視庭樹而頭在樹上，心甚惡之。其家金櫃鳴，聲似槌鏡，清而悲。巫云：「金櫃將離，是以悲鳴。」主簿何無忌及家人皆勸令自警。卓轉更很愎，聞諫輒怒。方散兵使大佃，而不爲備。功曹榮建固諫，不納。襄陽太守周慮等密承敦意，知卓無備，詐言湖中多魚，勸卓遣左右皆捕魚，乃襲害卓于寢，傳首于敦。四子散騎郎蕃等皆被害。太寧中，追贈驃騎將軍，諡曰敬。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":50,"last_line":50,"raw_start":4776,"raw_end":5291,"raw_character_offsets":[4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4799,4800,4801,4802,4803,4804,4805,4806,4807,4808,4809,4810,4811,4812,4813,4814,4815,4816,4817,4818,4819,4820,4821,4822,4823,4824,4825,4826,4827,4828,4829,4830,4831,4832,4833,4834,4835,4836,4837,4838,4839,4840,4841,4842,4843,4844,4845,4846,4847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,4858,4859,4860,4861,4862,486