{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004319","canonical_person_id":"6lu_kih_t5b","id_aliases":["cbr-p004319"],"identity_policy":"contextual_provisional","person_ids":["6lu_kih_t5b"],"persons":[{"id":"6lu_kih_t5b","label":"齊襄王（孟子荀卿列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"齊襄王","mention_ids":["c-shiji-074-mengxun:m011-0074"]}],"evidence":[{"mention_id":"c-shiji-074-mengxun:m011-0074","chapter_id":"c-shiji-074-mengxun","paragraph_id":"c-shiji-074-mengxun:p011","quote":"齊襄王"}],"id_aliases":["cbr-p004319"]}],"source_mention_summary":[{"source_id":"s-shiji-074-mengxun","work_id":"w-shiji","book_id":"b-shiji-074","chapter_id":"c-shiji-074-mengxun","mention_count":1,"mention_ids":["c-shiji-074-mengxun:m011-0074"],"paragraph_ids":["c-shiji-074-mengxun:p011"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-074-mengxun"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-074-mengxun:m011-0074","start":74,"end":77,"surface":"齊襄王","kind":"person","person_id":"6lu_kih_t5b","status":"contextual_provisional","paragraph_id":"c-shiji-074-mengxun:p011","chapter_id":"c-shiji-074-mengxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji074-043","person_id":"6lu_kih_t5b","scope":"same_chapter","chapter_ids":["c-shiji-074-mengxun"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依本段明示人名及局部敘事暫接，淳于髡髡先生、騶奭奭與晏嬰晏各限所述範圍；管引古不補管仲。薦髡客子稱及兩次獻馬獻謳者保留未名候選，不確證不同匿名人物。齊王命列大夫與齊宣、齊襄王分候選，未因敘事相鄰自動同指；群體之徒、之屬及學說合稱不補成員。欲以卿相待而謝去不當任官，李斯弟子不當子嗣，墨翟年代或曰異說保留。","surfaces":["齊襄王"],"evidence":[{"paragraph_id":"c-shiji-074-mengxun:p011","quote":"荀卿，趙人。年五十始來游學於齊。騶衍之術迂大而閎辯；奭也文具難施；淳于髡久與處，時有得善言。故齊人頌曰：「談天衍，雕龍奭，炙轂過髡。」田駢之屬皆已死齊襄王時，而荀卿最為老師。齊尚修列大夫之缺，而荀卿三為祭酒焉。齊人或讒荀卿，荀卿乃適楚，而春申君以為蘭陵令。春申君死而荀卿廢，因家蘭陵。李斯嘗為弟子，已而相秦。荀卿嫉濁世之政，亡國亂君相屬，不遂大道而營於巫祝，信禨祥，鄙儒小拘，如莊周等又猾稽亂俗，於是推儒、墨、道德之行事興壞，序列著數萬言而卒。因葬蘭陵。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-074-mengxun:p011","text":"荀卿，趙人。年五十始來游學於齊。騶衍之術迂大而閎辯；奭也文具難施；淳于髡久與處，時有得善言。故齊人頌曰：「談天衍，雕龍奭，炙轂過髡。」田駢之屬皆已死齊襄王時，而荀卿最為老師。齊尚修列大夫之缺，而荀卿三為祭酒焉。齊人或讒荀卿，荀卿乃適楚，而春申君以為蘭陵令。春申君死而荀卿廢，因家蘭陵。李斯嘗為弟子，已而相秦。荀卿嫉濁世之政，亡國亂君相屬，不遂大道而營於巫祝，信禨祥，鄙儒小拘，如莊周等又猾稽亂俗，於是推儒、墨、道德之行事興壞，序列著數萬言而卒。因葬蘭陵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-074-mengxun:m011-0000","start":0,"end":2,"surface":"荀卿","kind":"person","person_id":"wuo_ghc_ajx","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m011-0016","start":16,"end":18,"surface":"騶衍","kind":"person","person_id":"k22_9pd_uu4","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m011-0026","start":26,"end":27,"surface":"奭","kind":"person","person_id":"i56_shx_l9i","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m011-0033","start":33,"end":36,"surface":"淳于髡","kind":"person","person_id":"bpl_8yn_rrf","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m011-0055","start":55,"end":56,"surface":"衍","kind":"person","person_id":"k22_9pd_uu4","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m011-0059","start":59,"end":60,"surface":"奭","kind":"person","person_id":"i56_shx_l9i","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m011-0064","start":64,"end":65,"surface":"髡","kind":"person","person_id":"bpl_8yn_rrf","status":"contextual_provisional"},{"id":"c-shiji-074-mengxun:m011-0067","start":67,"end":69,"surface":"田駢","kind":"person","person_id":"yt5_lmc_ju