hi:p005","surface":"子輿之","start":0,"end":3}}],"status":"source_attested","interpretation_note":"原段子某承前段傳主。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-song060-wangzhunzhi-79-186-89","subject_person_id":"72e_1a7_3ac_A","object_person_id":"72e_1a7_3ac","predicate":"father","status":"source_attested","qualifiers":{"source_term":"子興之","lineage":"paternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangzhunzhi","source_id":"s-songshu-060-wangzhunzhi-ws1996694","paragraph_id":"c-songshu-060-wangzhunzhi:p004","quote":"遷司徒左長史，出為始興太守。元嘉二年，為江夏王義恭撫軍長史、歷陽太守，行州府之任，綏懷得理，軍民便之。尋入為侍中。明年，徙為都官尚書，改領吏部。性峭急，頗失縉紳之望。出為丹陽尹。准之究識舊儀，問無不對，時大將軍彭城王義康錄尚書事，每歎曰：「何須高論玄虛，正得如王准之兩三人，天下便治矣。」然寡乏風素，不為時流所重。撰儀注，朝廷至今遵用之。十年，卒，時年五十六。追贈太常。子興之，征虜主簿。","subject_person_mention_id":"c-songshu-060-wangzhunzhi:p004:m0186","object_person_mention_id":"c-songshu-060-wangzhunzhi:p004:m0089","relationship_anchor":{"paragraph_id":"c-songshu-060-wangzhunzhi:p004","start":185,"end":188,"surface":"子興之"}}],"interpretation_note":"原段父祖或子輩次序、具名人物及家世上下文。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[{"connection":"father","generation_distance":1,"parent_person_id":"72e_1a7_3ac","source_assertion_id":"a-song060-wangzhunzhi-79-186-89","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangzhunzhi","source_id":"s-songshu-060-wangzhunzhi-ws1996694","paragraph_id":"c-songshu-060-wangzhunzhi:p004","quote":"遷司徒左長史，出為始興太守。元嘉二年，為江夏王義恭撫軍長史、歷陽太守，行州府之任，綏懷得理，軍民便之。尋入為侍中。明年，徙為都官尚書，改領吏部。性峭急，頗失縉紳之望。出為丹陽尹。准之究識舊儀，問無不對，時大將軍彭城王義康錄尚書事，每歎曰：「何須高論玄虛，正得如王准之兩三人，天下便治矣。」然寡乏風素，不為時流所重。撰儀注，朝廷至今遵用之。十年，卒，時年五十六。追贈太常。子興之，征虜主簿。","subject_person_mention_id":"c-songshu-060-wangzhunzhi:p004:m0186","object_person_mention_id":"c-songshu-060-wangzhunzhi:p004:m0089","relatio