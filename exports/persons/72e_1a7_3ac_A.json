n_id":"c-songshu-060-wangzhunzhi:p003:r0127"},{"work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangzhunzhi","source_id":"s-songshu-060-wangzhunzhi-ws1996694","paragraph_id":"c-songshu-060-wangzhunzhi:p004","quote":"之","kind":"person_reference","mention_id":"c-songshu-060-wangzhunzhi:p004:r0049"}],"identity_note":"本批完整傳文來源候選；不因同姓或同名接族。","review":"ai_provisional"},{"id":"72e_1a7_3ac_A","label":"王興之（王准之子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"興之","mention_ids":["c-songshu-060-wangzhunzhi:p004:m0186"]}],"evidence":[{"mention_id":"c-songshu-060-wangzhunzhi:p004:m0186","paragraph_id":"c-songshu-060-wangzhunzhi:p004","chapter_id":"c-songshu-060-wangzhunzhi","quote":"興之"}],"review":"ai_provisional","identity_note":"王興之（王准之子）；據本段具名及所列對讀證據。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"72e_1a7_3ac","source_assertion_id":"a-song060-wangzhunzhi-79-186-89","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangzhunzhi","source_id":"s-songshu-060-wangzhunzhi-ws1996694","paragraph_id":"c-songshu-060-wangzhunzhi:p004","quote":"遷司徒左長史，出為始興太守。元嘉二年，為江夏王義恭撫軍長史、歷陽太守，行州府之任，綏懷得理，軍民便之。尋入為侍中。明年，徙為都官尚書，改領吏部。性峭急，頗失縉紳之望。出為丹陽尹。准之究識舊儀，問無不對，時大將軍彭城王義康錄尚書事，每歎曰：「何須高論玄虛，正得如王准之兩三人，天下便治矣。」然寡乏風素，不為時流所重。撰儀注，朝廷至今遵用之。十年，卒，時年五十六。追贈太常。子興之，征虜主簿。","subject_person_mention_id":"c-songshu-060-wangzhunzhi:p004:m0186","object_person_mention_id":"c-songshu-060-wangzhunzhi:p004:m0089","relationship_anchor":{"paragraph_id":"c-songshu-060-wangzhunzhi:p004","start":185,"end":188,"surface":"子興之"},"source_term":"子興之"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"本段列屬已具名，與同書及對讀本互核。"}}],"source_mention_summary":[{"source_id":"s-songshu-060-wangzhunzhi-ws1996694","work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangzhunzhi","raw_mention_count":1,"mention_ids":["c-songshu-060-wangzhunzhi:p004:m0186"],"paragraph_ids":["c-son