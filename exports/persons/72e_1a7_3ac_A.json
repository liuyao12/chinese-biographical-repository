4-wangjinzhi:p001:m0000"}],"review":"ai_provisional","identity_note":"王興之（王准之子）；據本段具名及所列對讀證據。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"72e_1a7_3ac","source_assertion_id":"a-song060-wangzhunzhi-79-186-89","evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","chapter_id":"c-songshu-060-wangzhunzhi","source_id":"s-songshu-060-wangzhunzhi-ws1996694","paragraph_id":"c-songshu-060-wangzhunzhi:p004","quote":"遷司徒左長史，出為始興太守。元嘉二年，為江夏王義恭撫軍長史、歷陽太守，行州府之任，綏懷得理，軍民便之。尋入為侍中。明年，徙為都官尚書，改領吏部。性峭急，頗失縉紳之望。出為丹陽尹。准之究識舊儀，問無不對，時大將軍彭城王義康錄尚書事，每歎曰：「何須高論玄虛，正得如王准之兩三人，天下便治矣。」然寡乏風素，不為時流所重。撰儀注，朝廷至今遵用之。十年，卒，時年五十六。追贈太常。子興之，征虜主簿。","subject_person_mention_id":"c-songshu-060-wangzhunzhi:p004:m0186","object_person_mention_id":"c-songshu-060-wangzhunzhi:p004:m0089","relationship_anchor":{"paragraph_id":"c-songshu-060-wangzhunzhi:p004","start":185,"end":188,"surface":"子興之"},"source_term":"子興之"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"本段列屬已具名，與同書及對讀本互核。"}},{"id":"72e_1a7_3ac_AA","label":"王進之（王輿之子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"進之","mention_ids":["c-nanshi-024-wangjinzhi:p001:m0003","c-nanshi-024-wangjinzhi:p001:m0038","c-nanshi-024-wangjinzhi:p001:m0045","c-nanshi-024-wangqing:p001:m0000"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangjinzhi-ws1765279","chapter_id":"c-nanshi-024-wangjinzhi","paragraph_id":"c-nanshi-024-wangjinzhi:p001","quote":"進之","mention_id":"c-nanshi-024-wangjinzhi:p001:m0003"},{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangjinzhi-ws1765279","chapter_id":"c-nanshi-024-wangjinzhi","paragraph_id":"c-nanshi-024-wangjinzhi:p001","quote":"進之","mention_id":"c-nanshi-024-wangjinzhi:p001:m0038"},{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangjinzhi-ws1765279","chapter_id":"c-nanshi-024-wangjinzhi","paragraph_id":"c-nanshi-024-wangjinzhi:p001","quote":"進之","