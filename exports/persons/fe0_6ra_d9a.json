殘奄，遷其君薄泵。成王自奄歸，在宗周，作《多方》。既絀殷命，襲淮夷，歸在豐，作《周官》。興正禮樂，度制於是改，而民和睦，頌聲興。成王既伐東夷，息慎來賀，王賜榮伯作《賄息慎之命》。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m023-0000","start":0,"end":2,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0006","start":6,"end":8,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0014","start":14,"end":16,"surface":"武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0019","start":19,"end":21,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0064","start":64,"end":66,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0072","start":72,"end":74,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0090","start":90,"end":92,"surface":"召公","kind":"person","person_id":"7m7_qvm_4oj","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0095","start":95,"end":97,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0109","start":109,"end":111,"surface":"其君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m023-0114","start":114,"end":116,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0169","start":169,"end":171,"surface":"成王","kind":"person","person_id":"qna_m75_pj8","status":"source_identified"},{"id":"c-shiji-004-zhou:m023-0183","start":183,"end":185,"surface":"榮伯","kind":"person","person_id":"fe0_6ra_d9a","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-0