ther"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p002","quote":"僧孺幼聰慧，年五歲便機警，初讀孝經，問授者曰：「此書何所述？」曰：「論忠孝二事。」僧孺曰：「若爾，願常讀之。」又有饋其父冬李，先以一與之，僧孺不受，曰：「大人未見，不容先嘗。」七歲能讀十萬言，及長篤愛墳籍。家貧，常傭書以養母，寫畢諷誦亦了。","subject_person_mention_id":"c-nanshi-059-wangsengru:p002:m0000","object_person_reference_id":"c-nanshi-059-wangsengru:p002:r0111"}],"status":"source_attested","interpretation_note":"傭書養母，舊書證為同一人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[],"relations":[{"id":"a-liang033-wangsengru-mother","subject_person_id":"59d_72d_924_AAA","object_person_id":"ijq_9tc_b3l","predicate":"mother","qualifiers":{"source_term":"母","liang033_wangsengru_reading":"mother"},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-wangsengru-ws1514481","chapter_id":"c-liangshu-033-wangsengru","paragraph_id":"c-liangshu-033-wangsengru:p002","quote":"僧孺年五歲，讀《孝經》，問授者此書所載述，曰：「論忠孝二事。」僧孺曰：「若爾，常願讀之。」六歲能屬文，旣長好學。家貧，常傭書以養母，所寫旣畢，諷誦亦通。","subject_person_mention_id":"c-liangshu-033-wangsengru:p002:m0000","object_person_reference_id":"c-liangshu-033-wangsengru:p002:r0064"}],"status":"source_attested","interpretation_note":"傭書以養母，另段敘攜子上市。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-nanshi059-wangsengru-mother","subject_person_id":"59d_72d_924_AAA","object_person_id":"ijq_9tc_b3l","predicate":"mother","qualifiers":{"source_term":"養母","nanshi059_wangsengru_reading":"mother"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p002","quote":"僧孺幼聰慧，年五歲便機警，初讀孝經，問授者曰：「此書何所述？」曰：「論忠孝二事。」僧孺曰：「若爾，願常讀之。」又有饋其父冬李，先以一與之，僧孺不受，曰：「大人未見，不容先嘗。」七歲能讀十萬言，及長篤愛墳籍。家貧，常傭書以養母，寫畢諷誦亦了。","subject_person_mention_id":"c-nanshi-059-wangsengru:p002:m0000","object_person_reference_id":"c-nanshi-059-wangsengru:p002:r0111"}],"status":"source_attested","interpretation_note":"傭書養母，舊書證為同一人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-liangshu-033-wangsengru:p002:r0064","surface":"母","start":64,"end":65,"person_id":"ijq_9tc_b3l","referent_role":"third_person","paragraph_id":"c-liangshu-033-wangsengru:p002","quote":"僧孺年五歲，讀《孝經》，問授者此書所載述，曰：「論忠孝二事。」僧孺曰：「若爾，常願讀之。」六歲能屬文，旣長好學。家貧，常傭書以養母，所寫旣畢，諷誦亦通。","note":"依原有文體、發言者、受話人、王府或本傳前後文。","chapter_id":"c-liangshu-033-wangsengru","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangsengru-ws1514481"},{"id":"c-liangshu-033-wangsengru:p004:r0205","surface":"其母","start":205,"end":207,"person_id":"ijq_9tc_b3l","referent_role":"third_person","paragraph_id":"c-liangshu-033-wangsengru:p004","quote":"天監初，除臨川王後軍記室參軍，待詔文德省。尋出爲南海太守。郡常有高涼生口及海舶每歲數至，外國賈人以通貨易。舊時州郡以半價就市，又買而卽賣，其利數倍，歷政以爲常。僧孺乃歎曰：「昔人爲蜀部長史，終身無蜀物，吾欲遺子孫者，不在越裝。」並無所取。視事朞月，有詔徵還，郡民道俗六百人詣闕請留，不許。旣至，拜中書郎、領著作，復直文德省，撰《中表簿》及《起居注》。遷尚書左丞，領著作如故。俄除遊擊將軍，兼御史中丞。僧孺幼貧，其母鬻紗布以自業，嘗攜僧孺至市，道遇中丞鹵簿，驅迫溝中。及是拜日，引騶清道，悲感不自勝。尋以公事降爲雲騎將軍，兼職如故，頃之卽真。是時高祖制《春景明志詩》五百字，敕在朝之人沈約已下同作，高祖以僧孺詩爲工。遷少府卿，出監吳郡。還除尚書吏部郎，參大選，請謁不行。","note":"依原有文體、發言者、受話人、王府或本傳前後文。","chapter_id":"c-liangshu-033-wangsengru","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangsengru-ws1514481"},{"id":"c-nanshi-059-wangsengru:p002:r0111","surface":"母","start":111,"end":112,"person_id":"ijq_9tc_b3l","referent_role":"third_person","paragraph_id":"c-nanshi-059-wangsengru:p002","quote":"僧孺幼聰慧，年五歲便機警，初讀孝經，問授者曰：「此書何所述？」曰：「論忠孝二事。」僧孺曰：「若爾，願常讀之。」又有饋其父冬李，先以一與之，僧孺不受，曰：「大人未見，不容先嘗。」七歲能讀十萬言，及長篤愛墳籍。家貧，常傭書以養母，寫畢諷誦亦了。","note":"從本段發言者、受話人或所記府主覆核。","chapter_id":"c-nanshi-059-wangsengru","book_id":"b-nanshi-059","work_id":"w-nanshi","source_id":"s-nanshi-059-wangsengru-ws1553912"},{"id":"c-nanshi-059-wangsengru:p004:r0205","surface":"其母","start":205,"end":207,"person_id":"ijq_9tc_b3l","referent_role":"third_person","paragraph_id":"c-nanshi-059-wangsengru:p004","quote":"梁天監初，除臨川王后軍記室，待詔文德省。出為南海太守。南海俗殺牛，曾無限忌，僧孺至便禁斷。又外國舶物、高涼生口歲數至，皆外國賈人以通貨易。舊時州郡就市，回而即賣，其利數倍，曆政以為常。僧孺歎曰：「昔人為蜀部長史，終身無蜀物，吾欲遺子孫者，不在越裝。」並無所取。視事二歲，聲績有聞。詔征將還，郡中道俗六百人詣闕請留，不許。至，拜中書侍郎，領著作，復直文德省。撰起居注、中表簿，遷尚書左丞，俄兼御史中丞。僧孺幼貧，其母鬻紗布以自業，嘗攜僧孺至市，道遇中丞鹵簿，驅迫墜溝中。及是拜日，引騶清道，悲感不自勝。頃之即真。","note":"從本段發言者、受話人或所記府主覆核。","chapter_id":"c-nanshi-059-wangsengru","book_id":"b-nanshi-059","work_id":"w-nanshi","source_id":"s-nanshi-059-wangsengru-ws1553912"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-033-wangsengru:p002","text":"僧孺年五歲，讀《孝經》，問授者此書所載述，曰：「論忠孝二事。」僧孺曰：「若爾，常願讀之。」六歲能屬文，旣長好學。家貧，常傭書以養母，所寫旣畢，諷誦亦通。","mentions":[{"id":"c-liangshu-033-wangsengru:p002:m0000","surface":"僧孺","start":0,"end":2,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p002:m0031","surface":"僧孺","start":31,"end":33,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1514481,"source_layer":"received_biography","first_line":15,"last_line":15,"line_start":2,"line_end":78,"raw_start":241,"raw_end":317,"raw_character_offsets":[241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316],"projection_sha256":"722ea62d00edd869ab2bfc1a3f07e96e8304bf26ed004178c70aa9654adcc823","editorial_excerpt_boundary":true},"chapter_id":"c-liangshu-033-wangsengru","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangsengru-ws1514481"},{"id":"c-liangshu-033-wangsengru:p004","text":"天監初，除臨川王後軍記室參軍，待詔文德省。尋出爲南海太守。郡常有高涼生口及海舶每歲數至，外國賈人以通貨易。舊時州郡以半價就市，又買而卽賣，其利數倍，歷政以爲常。僧孺乃歎曰：「昔人爲蜀部長史，終身無蜀物，吾欲遺子孫者，不在越裝。」並無所取。視事朞月，有詔徵還，郡民道俗六百人詣闕請留，不許。旣至，拜中書郎、領著作，復直文德省，撰《中表簿》及《起居注》。遷尚書左丞，領著作如故。俄除遊擊將軍，兼御史中丞。僧孺幼貧，其母鬻紗布以自業，嘗攜僧孺至市，道遇中丞鹵簿，驅迫溝中。及是拜日，引騶清道，悲感不自勝。尋以公事降爲雲騎將軍，兼職如故，頃之卽真。是時高祖制《春景明志詩》五百字，敕在朝之人沈約已下同作，高祖以僧孺詩爲工。遷少府卿，出監吳郡。還除尚書吏部郎，參大選，請謁不行。","mentions":[{"id":"c-liangshu-033-wangsengru:p004:m0080","surface":"僧孺","start":80,"end":82,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p004:m0200","surface":"僧孺","start":200,"end":202,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p004:m0216","surface":"僧孺","start":216,"end":218,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p004:m0291","surface":"沈約","start":291,"end":293,"person_id":"p8b_7w1_y3q","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p004:m0301","surface":"僧孺","start":301,"end":303,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1514481,"source_layer":"received_biography","first_line":19,"last_line":19,"line_start":2,"line_end":336,"raw_start":802,"raw_end":1136,"raw_character_offsets":[802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,8