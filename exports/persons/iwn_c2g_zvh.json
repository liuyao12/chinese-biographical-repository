4:m0032","start":32,"end":34,"surface":"東宫","person_id":"iwn_c2g_zvh","kind":"person","status":"resolved_contextual","paragraph_id":"c-songshu-085-xiezhuang:p014","chapter_id":"c-songshu-085-xiezhuang"},{"id":"c-songshu-085-xiezhuang:p014:m0054","start":54,"end":56,"surface":"東宫","person_id":"iwn_c2g_zvh","kind":"person","status":"resolved_contextual","paragraph_id":"c-songshu-085-xiezhuang:p014","chapter_id":"c-songshu-085-xiezhuang"},{"id":"c-songshu-085-xiezhuang:p014:m0062","start":62,"end":63,"surface":"帝","person_id":"iwn_c2g_zvh","kind":"person","status":"resolved_contextual","paragraph_id":"c-songshu-085-xiezhuang:p014","chapter_id":"c-songshu-085-xiezhuang"},{"id":"c-songshu-085-xiezhuang:p014:m0105","start":105,"end":106,"surface":"帝","person_id":"iwn_c2g_zvh","kind":"person","status":"resolved_contextual","paragraph_id":"c-songshu-085-xiezhuang:p014","chapter_id":"c-songshu-085-xiezhuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-nanqi043-xieyue-jinghe","person_id":"iwn_c2g_zvh","surfaces":["景和"],"scope":"cross_chapter","chapter_ids":["c-nanqishu-043-xieyue","c-songshu-060-xunbozi"],"status":"contextual_provisional","evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-043","chapter_id":"c-nanqishu-043-xieyue","source_id":"s-nanqishu043-ws2400356","paragraph_id":"c-nanqishu-043-xieyue:p002","quote_passage_ref":"data/corpus/nanqishu/043-xieyue.json"},{"work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","chapter_id":"c-songshu-060-xunbozi","paragraph_id":"c-songshu-060-xunbozi:p008","quote_passage_ref":"data/corpus/songshu/060.json"}],"rationale":"值景和敗是宋朝前廢帝的時局代稱；固定宋007首名子業與改景和及末被殺敘述核對，接既有宋前廢帝子業；不把此處當𤅢死年。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null,"external_reference_readings":[{"raw_path":"source-evidence/nanqi043-xieyue-reading/external/song007-fixed.wikitext","metadata_path":"source-evidence/nanqi043-xieyue-reading/external/song007-metadata.json","revision_id":2368147,"raw_sha256":"7e6630235b2a9b47a66cc65aaf7da851b16bde182a7c9f3150267a652e4f07e6","read_segments":[{"first_line":3,"last_line":3,"raw_start":132,"raw_end":212,"raw_quote":"前廢帝諱子業，小字法師，孝武帝長子也。{{YL|元嘉二十六年}}正月甲申生。世祖鎮尋陽，子業留京邑。三十年，世祖入伐元凶，被囚侍中下省，將見害者數矣，卒得無恙。"},{"first_line":37,"last_line":37,"raw_start":2459,"raw_end":2862,"raw_quote":"改元為{{YL|景和元年}}。文武賜位二等。以領軍將軍建安王休仁為安西將軍、雍州刺史，衞將軍湘東王彧還為南豫州刺史。甲戌，司徒、揚州刺史豫章王子尚領尚書令，射聲校尉沈文秀為青州刺史，左軍司馬崔道固為冀州刺史。乙亥，詔曰：「昔凝神佇逸，磻溪讚道，湛慮思才，傅巖毗化。朕位御三極，風澄萬宇，資鈇電斷，正卯斯戮。思所以仰宣遺烈，俯弘景祚，每結夢庖鼎，瞻言板築，有劬日昃，無忘昧旦。可甄訪郡國，招聘閭部：其有孝性忠節，幽居遯棲，信誠義行，廉正表俗，文敏博識，幹事治民，務加旌舉，隨才引擢。庶官克順，彝倫咸叙。主者精加詳括，稱朕意焉。」以始興公沈慶之為太尉，鎮北將軍、青冀二州刺史王玄謨為領軍將軍。庚辰，以石頭城為長樂宮，東府城為未央宮。罷東揚州并揚州。甲申，以北邸為建章宮，南第為長楊宮。以冠軍將軍邵陵王子元為湘州刺史。丙戌，原除吳、吳興、義興、晉陵、琅邪五郡{{YL|大明八年}}以前逋租。己丑，復立南北二馳道。"},{"first_line":45,"last_line":45,"raw_start":3597,"raw_end":3765,"raw_quote":"時帝凶悖日甚，誅殺相繼，內外百司，不保首領。先是訛言云：「湘中出天子。」帝將南巡荊、湘二州以厭之。先欲誅諸叔，然後發引。太宗與左右阮佃夫、王道隆、李道兒密結帝左右壽寂之、姜產之等十一人，謀共廢帝。戊午夜，帝於華林園竹林堂射鬼。時巫覡云：「此堂有鬼。」故帝自射之。壽寂之懷刀直入，姜產之為副。帝欲走，寂之追而殞之。時年十七。太皇太后令曰："}],"scope":"前廢帝首名諱、景和改元與末弒殺紀事；非全卷。"}]},{"id":"d-song047-iwn_c2g_zvh","person_id":"iwn_c2g_zvh","surfaces":["前廢帝"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-047-liuhuaisu:p004:m0045"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","source_id":"s-songshu-047-liuhuaisu","chapter_id":"c-songshu-047-liuhuaisu","paragraph_id":"c-songshu-047-liuhuaisu:p004","quote_passage_ref":"data/corpus/songshu/047-liuhuaisu.json"}],"rationale":"完整本傳敘事、時段、發言人與官稱辨指；新身份僅限此來源。劉統字界另有固定通鑑／御覽名列主證；王奐與升卿平行候選不作canonical接合。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null},{"id":"d-songshu060-imperial-007","person_id":"iwn_c2g_zvh","surfaces":["前廢帝"],"scope":"same_chapter","chapter_ids":["c-songshu-060-xunbozi"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-060-xunbozi:p008:m0073"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","chapter_id":"c-songshu-060-xunbozi","paragraph_id":"c-songshu-060-xunbozi:p008","quote_passage_ref":"data/corpus/songshu/060.json"}],"references":[{"title":"《宋書》卷7","url":"https://zh.wikisource.org/w/index.php?title=%E5%AE%8B%E6%9B%B8%2F%E5%8D%B77&oldid=2368147","source_revision":2368147,"source_position":{"first_line":3,"last_line":3},"quote":"前廢帝諱子業，小字法師，孝武帝長子也。","source_line_sha256":"fa92c06579a2c5e3fd8610080a06230813e6eaea1f278caa8a2ebfef029c78e2","scope":"primary_parallel_identification_only","image_verified":false}],"rationale":"荀萬秋官歷續世祖後前廢帝末，連本書前廢帝子業。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-nanqishu-043-xieyue","work_id":"w-nanqishu","book_id":"b-nanqishu-043","source_id":"s-nanqishu043-ws2400356","source_ref":"corpus/nanqishu/043-xieyue.json"},{"chapter_id":"c-songshu-047-liuhuaisu","work_id":"w-songshu","book_id":"b-songshu-047","source_id":"s-songshu-047-liuhuaisu","source_ref":"corpus/songshu/047-liuhuaisu.json"},{"chapter_id":"c-songshu-060-xunbozi","work_id":"w-songshu","book_id":"b-songshu-060","source_id":"s-songshu-060-xunbozi","source_ref":"corpus/songshu/060.json"},{"chapter_id":"c-songshu-075-wangsengda","work_id":"w-songshu","book_id":"b-songshu-075","source_id":"s-songshu-075-wangsengda","source_ref":"corpus/songshu/075-wangsengda.json"},{"chapter_id":"c-songshu-085-xiezhuang","work_id":"w-songshu","book_id":"b-songshu-085","source_id":"s-songshu-085-xiezhuang","source_ref":"corpus/songshu/085-xiezhuang.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_l