{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"rxf_qqr_to2","canonical_person_id":"rxf_qqr_to2","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["rxf_qqr_to2"],"persons":[{"id":"rxf_qqr_to2","label":"章邯（平津侯主父列傳上書候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"章邯","mention_ids":["c-shiji-112-pingjin:m013-0333"]}],"evidence":[{"mention_id":"c-shiji-112-pingjin:m013-0333","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p013","quote":"章邯"}]}],"source_mention_summary":[{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":1,"mention_ids":["c-shiji-112-pingjin:m013-0333"],"paragraph_ids":["c-shiji-112-pingjin:p013"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji112-pingjin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m013-0333","start":333,"end":335,"surface":"章邯","kind":"person","person_id":"rxf_qqr_to2","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p013","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p013","text":"及至高皇帝定天下，略地於邊，聞匈奴聚於代谷之外而欲擊之。御史成進諫曰：「不可。夫匈奴之性，獸聚而鳥散，從之如搏影。今以陛下盛德攻匈奴，臣竊危之。」高帝不聽，遂北至於代谷，果有平城之圍。高皇帝蓋悔之甚，乃使劉敬往結和親之約，然後天下忘干戈之事。故兵法曰「興師十萬，日費千金」。夫秦常積眾暴兵數十萬人，雖有覆軍殺將系虜單于之功，亦適足以結怨深讎，不足以償天下之費。夫上虛府庫，下敝百姓，甘心於外國，非完事也。夫匈奴難得而制，非一世也。行盜侵驅，所以為業也，天性固然。上及虞夏殷周，固弗程督，禽獸畜之，不屬為人。夫上不觀虞夏殷周之統，而下（修）［循］近世之失，此臣之所大憂，百姓之所疾苦也。且夫兵久則變生，事苦則慮易。乃使邊境之民獘靡愁苦而有離心，將吏相疑而外市，故尉佗、章邯得以成其私也。夫秦政之所以不行者，權分乎二子，此得失之效也。故《周書》曰「安危在出令，存亡在所用」。願陛下詳察之，少加意而熟慮焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-112-pingjin:m013-0002","start":2,"end":5,"surface":"高皇帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0030","start":30,"end":32,"surface":"成進","kind":"person","person_id":"lve_fqh_8v6","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0059","start":59,"end":61,"surface":"陛下","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0073","start":73,"end":75,"surface":"高帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0092","start":92,"end":95,"surface":"高皇帝","kind":"person","person_id":"1c0_c3k_jno","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0102","start":102,"end":104,"surface":"劉敬","kind":"person","person_id":"5vm_33p_472","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0157","start":157,"end":159,"surface":"單于","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m013-0330","start":330,"end":332,"surface":"尉佗","kind":"person","person_id":"qig_axh_3z6","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0333","start":333,"end":335,"surface":"章邯","kind":"person","person_id":"rxf_qqr_to2","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m013-0355","start":355,"end":357,"surface":"二子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-112-pingjin:m013-0386","start":386,"end":388,"surface":"陛下","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-112-pingjin","book_id":"b-shiji-112","work_id":"w-shiji","source_id":"s-shiji112-pingjin"}],"sources":[{"chapter_id":"c-shiji-112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","source_id":"s-shiji112-pingjin","source":{"title":"史記／卷112","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷112","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷112&oldid=2089420","revision_id":2089420,"accessed_on":"2026-10-11","extent":"固定數位見證31段；末三段分為後附詔書、班固贊及索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、__TOC__與現代節標題；去行首冒號排版符號，保留正文、異體、方括弧與圓括弧校字。未核底本影像。","note":"太皇太后詔及班固贊均按見證附載分層，不自行確認編入者。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
