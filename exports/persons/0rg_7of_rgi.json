":["c-shiji-069-su:m022-0002","c-shiji-069-su:m022-0008","c-shiji-069-su:m022-0129","c-shiji-069-su:m022-0229","c-shiji-069-su:m023-0057","c-shiji-069-su:m023-0213","c-shiji-069-su:m024-0042","c-shiji-069-su:m024-0085","c-shiji-069-su:m025-0000"],"paragraph_ids":["c-shiji-069-su:p022","c-shiji-069-su:p023","c-shiji-069-su:p024","c-shiji-069-su:p025"],"passage_count":4}],"most_mentioned_source_ids":["s-shiji-069-su"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-069-su:m022-0002","start":2,"end":5,"surface":"魏襄王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p022","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m022-0008","start":8,"end":10,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p022","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m022-0129","start":129,"end":131,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p022","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m022-0229","start":229,"end":231,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p022","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m023-0057","start":57,"end":59,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p023","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m023-0213","start":213,"end":215,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p023","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m024-0042","start":42,"end":44,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p024","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m024-0085","start":85,"end":87,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p024","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m025-0000","start":0,"end":2,"surface":"魏王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p025","chapter_id":"c-shiji-069-su"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji069-020","person_id":"0rg_7of_rgi","scope":"same_chapter","chapter_ids":["c-shiji-069-su"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["大王","魏王","魏襄王"],"evidence":[{"paragraph_id":"c-shiji-069-su:p022","quote":"又說魏襄王曰：「大王之地，南有鴻溝、陳、汝南、許、郾、昆陽、召陵、舞陽、新都、新郪，東有淮、潁、煑棗、無胥，西有長城之界，北有河外、卷、衍、酸棗，地方千里。地名雖小，然而田舍廬廡之數，曾無所芻牧。人民之衆，車馬之多，日夜行不絕，輷輷殷殷，若有三軍之衆。臣竊量大王之國不下楚。，然衡人怵王交彊虎狼之秦以侵天下，卒有秦患，不顧其禍。夫挾彊秦之勢以內劫其主，罪無過此者。魏，天下之彊國也；王，天下之賢王也。今乃有意西面而事秦，稱東藩，築帝宮，受冠帶，祠春秋，臣竊為大王恥之。"},{"paragraph_id":"c-shiji-069-su:p023","quote":"「臣聞越王句踐戰敝卒三千人，禽夫差於干遂；武王卒三千人，革車三百乘，制紂於牧野：豈其士卒衆哉，誠能奮其威也。今竊聞大王之卒，武士二十萬，蒼頭二十萬，奮擊二十萬，廝徒十萬，車六百乘，騎五千匹。此其過越王句踐、武王遠矣，今乃聽於羣臣之說而欲臣事秦。夫事秦必割地以效實，故兵未用而國已虧矣。凡羣臣之言事秦者，皆姦人，非忠臣也。夫為人臣，割其主之地以求外交，偷取一時之功而不顧其後，破公家而成私門，外挾彊秦之勢以內劫其主，以求割地，願大王孰察之。"},{"paragraph_id":"c-shiji-069-su:p024","quote":"「周書曰：『緜緜不絕，蔓蔓奈何？毫釐不伐，將用斧柯。』前慮不定，後有大患，將奈之何？大王誠能聽臣，六國從親，專心并力壹意，則必無彊秦之患。故敝邑趙王使臣效愚計，奉明約，在大王之詔詔之。」"},{"paragraph_id":"c-shiji-069-su:p025","quote":"魏王曰：「寡人不肖，未嘗得聞明敎。今主君以趙王之詔詔之，敬以國從。」"}],"rationale":"按姓名、字稱、遊說對象及嵌入書信局部暫接。蘇代初見燕王、過魏魏王齊王及書信秦王楚王等另存候選，未按歷史年代補熟名；不斷言這些候選必為異人。燕噲讓位段與燕昭王書信分辨，書信內外王稱按引語範圍。穰侯舅與太后母局部暫接，未補姓名或秦王親屬世系。故事家屬與蘇秦家屬分存；全67段明示姓名首輪已存，版本年代、匿名者代詞及其他身份尚待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-069-su:p022","text":"又說魏襄王曰：「大王之地，南有鴻溝、陳、汝南、許、郾、昆陽、召陵、舞陽、新都、新郪，東有淮、潁、煑棗、無胥，西有長城之界，北有河外、卷、衍、酸棗，地方千里。地名雖小，然而田舍廬廡之數，曾無所芻牧。人民之衆，車馬之多，日夜行不絕，輷輷殷殷，若有三軍之衆。臣竊量大王之國不下楚。，然衡人怵王交彊虎狼之秦以侵天下，卒有秦患，不顧其禍。夫挾彊秦之勢以內劫其主，罪無過此者。魏，天下之彊國也；王，天下之賢王也。今乃有意西面而事秦，稱東藩，築帝宮，受冠帶，祠春秋，臣竊為大王恥之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m022-0002","start":2,"end":5,"surface":"魏襄王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional"},{"id":"c-shiji-069-su:m022-0008","start":8,"end":10,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional"},{"id":"c-shiji-069-su:m022-0098","start":98,"end":100,"surface":"人民","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m022-0129","start":129,"end":131,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional"},{"id":"c-shiji-069-su:m022-0139","start":139,"end":141,"surface":"衡人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m022-0173","start":173,"end":175,"surface":"其主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m022-0229","start":229,"end":231,"surface":"大王","kind":"person","person_id":"0rg_7of_rgi","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p023","text":"「臣聞越王句踐戰敝卒三千人，禽夫差於干遂；武王卒三千人，革車三百乘，制紂於牧野：豈其士卒衆哉，誠能奮其威也。今竊聞大王之卒，武士二十萬，蒼頭二十萬，奮擊二十萬，廝徒十萬，車六百乘，騎五千匹。此其過越王句踐、武王遠矣，今乃聽於羣臣之說而欲臣事秦。夫事秦必割地以效實，故兵未用而國已虧矣。凡羣臣之言事秦者，皆姦人，非忠臣也。夫為人臣，割其主之地以求外交，偷取一時之功而不顧其後，破公家而成私門，外挾彊秦之勢以內劫其主，以求割地，願大王孰察之。","annotation_status":"nam