_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m041-0096","start":96,"end":98,"surface":"思王","kind":"person","person_id":"cbr-p003283","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p041","chapter_id":"c-shiji-052-qidaohui"}],"relations":[{"id":"a-shiji052-031","subject_person_id":"cbr-p003283","predicate":"father","object_person_id":"cbr-p003282","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p041","quote":"天子因徙濟北王志王菑川。志亦齊悼惠王子，以安都侯王濟北。菑川王反，毋後，乃徙濟北王王菑川。凡立三十五年卒，謚為懿王。子建代立，是為靖王。二十年卒，子遺代立，是為頃王。三十六年卒，子終古立，是為思王。二十八年卒，子尚立，是為孝王。五年卒，子橫立，至建始三年，十一歲，卒。"}],"qualifiers":{"source_term":"子終古立","historicity":"historical_tradition"},"interpretation_note":"明示子、生、母、兄弟姊及婚姻分型，繼位不補未記血親；校勘名、母家與未名家屬不擅定姓名，案件敘事不冒稱獨立核定。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji052-032","subject_person_id":"cbr-p003284","predicate":"father","object_person_id":"cbr-p003283","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p041","quote":"天子因徙濟北王志王菑川。志亦齊悼惠王子，以安都侯王濟北。菑川王反，毋後，乃徙濟北王王菑川。凡立三十五年卒，謚為懿王。子建代立，是為靖王。二十年卒，子遺代立，是為頃王。三十六年卒，子終古立，是為思王。二十八年卒，子尚立，是為孝王。五年卒，子橫立，至建始三年，十一歲，卒。"}],"qualifiers":{"source_term":"子尚立","historicity":"historical_tradition"},"interpretation_note":"明示子、生、母、兄弟姊及婚姻分型，繼位不補未記血親；校勘名、母家與未名家屬不擅定姓名，案件敘事不冒稱獨立核定。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji052-068","person_id":"cbr-p003283","title":"思王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p041","quote":"天子因徙濟北王志王菑川。志亦齊悼惠王子，以安都侯王濟北。菑川王反，毋後，乃徙濟北王王菑川。凡立三十五年卒，謚為懿王。子建代立，是為靖王。二十年卒，子遺代立，是為頃王。三十六年卒，子終古立，是為思王。二十八年卒，子尚立，是為孝王。五年卒，子橫立，至建始三年，十一歲，卒。"}],"attestations":[{"id":"th-shiji052-068:a001","paragraph_id":"c-shiji-052-qidaohui:p041","start":96,"end":98,"surface":"思