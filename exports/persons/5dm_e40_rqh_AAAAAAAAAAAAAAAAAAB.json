:[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p003","quote":"周章卒，子熊遂立，熊遂卒，子柯相立。柯相卒，子彊鳩夷立。彊鳩夷卒，子餘橋疑吾立。餘橋疑吾卒，子柯盧立。柯盧卒，子周繇立。周繇卒，子屈羽立。屈羽卒，子夷吾立。夷吾卒，子禽處立。禽處卒，子轉立。轉卒，子頗髙立。頗髙卒，子句卑立。是時晉獻公滅周北虞公，以開晉伐虢也。句卑卒，子去齊立。去齊卒，子壽夢立。壽夢立而吳始益大，稱王。","source_term":"子"}],"source_assertion_id":"a-shiji031-024","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAA"}},{"id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAA","label":"諸樊","status":"active","historicity":"historical_tradition","aliases":[{"surface":"諸樊","mention_ids":["c-shiji-031-wu:m006-0019","c-shiji-031-wu:m006-0060","c-shiji-031-wu:m007-0006","c-shiji-086-cike:m005-0009","c-shiji-086-cike:m005-0031","c-shiji-086-cike:m005-0059"]},{"surface":"王諸樊","mention_ids":["c-shiji-031-wu:m007-0000","c-shiji-031-wu:m008-0004","c-shiji-031-wu:m021-0024"]},{"surface":"呉王諸樊","mention_ids":["c-shiji-086-cike:m005-0004"]}],"evidence":[{"mention_id":"c-shiji-031-wu:m006-0019","chapter_id":"c-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p006","quote":"諸樊"},{"mention_id":"c-shiji-031-wu:m006-0060","chapter_id":"c-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p006","quote":"諸樊"},{"mention_id":"c-shiji-031-wu:m007-0000","chapter_id":"c-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p007","quote":"王諸樊"},{"mention_id":"c-shiji-031-wu:m007-0006","chapter_id":"c-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p007","quote":"諸樊"},{"mention_id":"c-shiji-031-wu:m008-0004","chapter_id":"c-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p008","quote":"王諸樊"},{"mention_id":"c-shiji-031-wu:m021-0024","chapter_id":"c-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p021","quote":"王諸樊"},{"mention_id":"c-shiji-086-cike:m005-0004","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p005","quote":"呉王諸樊"},{"mention_id":"c-shiji-086-cike:m005-0009","chapter_id":"c-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p005","quote":"諸樊"},{"m