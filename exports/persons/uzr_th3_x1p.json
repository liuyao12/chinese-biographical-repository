{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"uzr_th3_x1p","canonical_person_id":"uzr_th3_x1p","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["uzr_th3_x1p"],"persons":[{"id":"uzr_th3_x1p","label":"劉韙（劉繇從父）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"韙","mention_ids":["c-sanguozhi-049-liuyou-complete:p004:m0009"]}],"evidence":[{"mention_id":"c-sanguozhi-049-liuyou-complete:p004:m0009","paragraph_id":"c-sanguozhi-049-liuyou-complete:p004","chapter_id":"c-sanguozhi-049-liuyou-complete","quote":"韙"}],"review":"ai_provisional","identity_note":"劉韙（劉繇從父），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-sanguozhi-049-liuyou-complete-ws2075209","work_id":"w-sanguozhi","book_id":"b-sanguozhi-049","chapter_id":"c-sanguozhi-049-liuyou-complete","raw_mention_count":1,"mention_ids":["c-sanguozhi-049-liuyou-complete:p004:m0009"],"paragraph_ids":["c-sanguozhi-049-liuyou-complete:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-049-liuyou-complete:p004:m0009","mention_ids":["c-sanguozhi-049-liuyou-complete:p004:m0009"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-049-liuyou-complete-ws2075209"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-049-liuyou-complete:p004:m0009","surface":"韙","start":9,"end":10,"kind":"person","person_id":"uzr_th3_x1p","status":"contextual_provisional","paragraph_id":"c-sanguozhi-049-liuyou-complete:p004","chapter_id":"c-sanguozhi-049-liuyou-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-049-liuyou-complete:p004","text":"　　繇年十九，從父韙為賊所劫質。繇篡取以歸，由是顯名。舉孝廉，為郎中，除下邑長。時郡守以貴戚托之，遂棄官去。州辟部濟南，濟南相中常侍子，貪穢不循，繇奏免之。平原陶丘洪薦繇，欲令舉茂才。刺吏曰：「前年舉公山。奈何復舉正禮乎？」洪曰：「若明使君用公山於前，擢正禮於後，所謂御二龍於長塗，騁騏驥於千里，不亦可乎！」會辟司空掾，除侍御史，不就。避亂淮浦，詔書以為揚州刺史。時袁術在淮南，繇畏憚，不敢之州。欲南渡江，吳景，孫賁迎置曲阿。術圖為僭逆，攻沒諸郡縣。繇遣樊能、張英屯江邊以拒之。以景、賁術所授用，乃迫逐使去。於是術乃自置揚州刺史，與景、賁並力攻英、能等，歲余不下。漢命加繇為牧，振武將軍，眾數萬人。孫策東渡，破英、能等。繇奔丹徒，遂泝江南保豫章，駐彭澤。笮融先至。殺太守朱皓，入居郡中。繇進討融，為融所破，更復招合屬縣，攻破融，融敗走入山。為民所殺。繇尋病卒，時年四十二。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":13,"last_line":13,"raw_start":770,"raw_end":1393,"raw_character_offsets":[770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810,811,812,813,814,815,816,817,818,819,820,821,822,823,824,825,826,827,828,829,830,831,832,833,834,835,836,837,838,839,840,841,842,843,844,845,846,847,848,849,850,851,852,853,854,855,856,857,858,859,860,861,862,863,864,865,866,867,868,869,870,871,872,873,874,875,876,877,878,879,880,881,882,883,884,885,886,887,888,889,890,891,892,893,894,895,896,897,898,899,900,901,902,903,904,905,906,907,908,909,910,911,912,913,914,915,916,917,918,919,920,921,922,923,924,925,926,927,928,929,930,931,932,933,934,935,936,937,938,939,940,941,942,943,944,945,946,947,948,949,950,951,952,