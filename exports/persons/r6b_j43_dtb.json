:[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-renyin-literal","person_id":"r6b_j43_dtb","surname":"任","ming":"愔","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p018","person_mention_id":"c-jinshu-098-wangdun-comparison:p018:m0254","source_anchor":{"start":254,"end":256,"surface":"任愔"},"quote":"敦至石頭，欲攻劉隗，其將杜弘曰：「劉隗死士眾多，未易可克，不如攻石頭。周劄少恩，兵不為用，攻之必敗。劄敗，則隗自走。」敦從之。劄果開城門納弘。諸將與敦戰，王師敗績。既入石頭，擁兵不朝，放肆兵士劫掠內外。官省奔散，惟有侍中二人侍帝。帝脫戎衣，著朝服，顧而言曰：「欲得我處，但當早道，我自還琅邪，何至困百姓如此！」敦收周顗、戴若思害之。以敦為丞相、江州牧，進爵武昌郡公，邑萬戶，使太常荀崧就拜，又加羽葆鼓吹，並偽讓不受。還屯武昌，多害忠良，寵樹親戚，以兄含為衛將軍、都督沔南軍事、領南蠻校尉、荊州刺史，以義陽太守任愔督河北諸軍事、南中郎將，敦又自督寧、益二州。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p018:m0254","start":254,"end":256,"surface":"任愔","person_id":"r6b_j43_dtb","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p018","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p018","text":"敦至石頭，欲攻劉隗，其將杜弘曰：「劉隗死士眾多，未易可克，不如攻石頭。周劄少恩，兵不為用，攻之必敗。劄敗，則隗自走。」敦從之。劄果開城門納弘。諸將與敦戰，王師敗績。既入石頭，擁兵不朝，放肆兵士劫掠內外。官省奔散，惟有侍中二人侍帝。帝脫戎衣，著朝服，顧而言曰：「欲得我處，但當早道，我自還琅邪，何至困百姓如此！」敦收周顗、戴若思害之。以敦為丞相、江州牧，進爵武昌郡公，邑萬戶，使太常荀崧就拜，又加羽葆鼓吹，並偽讓不受。還屯武昌，多害忠良，寵樹親戚，以兄含為衛將軍、都督沔南軍事、領南蠻校尉、荊州刺史，以義陽太守任愔督河北諸軍事、南中郎將，敦又自督寧、益二州。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":45,"last_line":45,"revision_id":2614273,"raw_projection_ref":"so