{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003264","identity_policy":"contextual_provisional","person_ids":["cbr-p003264"],"persons":[{"id":"cbr-p003264","label":"柴將軍（齊悼惠王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"棘蒲侯柴將軍","mention_ids":["c-shiji-052-qidaohui:m037-0189"]}],"evidence":[{"mention_id":"c-shiji-052-qidaohui:m037-0189","chapter_id":"c-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p037","quote":"棘蒲侯柴將軍"}]}],"source_mention_summary":[{"source_id":"s-shiji-052-qidaohui","work_id":"w-shiji","book_id":"b-shiji-052","chapter_id":"c-shiji-052-qidaohui","mention_count":1,"mention_ids":["c-shiji-052-qidaohui:m037-0189"],"paragraph_ids":["c-shiji-052-qidaohui:p037"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-052-qidaohui"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-052-qidaohui:m037-0189","start":189,"end":195,"surface":"棘蒲侯柴將軍","kind":"person","person_id":"cbr-p003264","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p037","chapter_id":"c-shiji-052-qidaohui"}],"relations":[],"title_holdings":[{"id":"th-shiji052-058","person_id":"cbr-p003264","title":"棘蒲侯","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p037","quote":"孝文帝二年，以齊之濟北郡立興居為濟北王，與城陽王俱立。立二年，反。始大臣誅呂氏時，朱虛侯功尤大，許盡以趙地王朱虛侯，盡以梁地王東牟侯。及孝文帝立，聞朱虛、東牟之初欲立齊王，故絀其功。及二年，王諸子，乃割齊二郡以王章、興居。章、興居自以失職奪功。章死，而興居聞匈奴大入漢，漢多發兵，使丞相灌嬰擊之，文帝親幸太原，以為天子自擊胡，遂發兵反於濟北。天子聞之，罷丞相及行兵，皆歸長安。使棘蒲侯柴將軍擊破虜濟北王，王自殺，地入于漢，為郡。"}],"attestations":[{"id":"th-shiji052-058:a001","paragraph_id":"c-shiji-052-qidaohui:p037","start":189,"end":192,"surface":"棘蒲侯","person_mention_id":"c-shiji-052-qidaohui:m037-0189","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji052-059","person_id":"cbr-p003264","title":"將軍","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p037","quote":"孝文帝二年，以齊之濟北郡立興居為濟北王，與城陽王俱立。立二年，反。始大臣誅呂氏時，朱虛侯功尤大，許盡以趙地王朱虛侯，盡以梁地王東牟侯。及孝文帝立，聞朱虛、東牟之初欲立齊王，故絀其功。及二年，王諸子，乃割齊二郡以王章、興居。章、興居自以失職奪功。章死，而興居聞匈奴大入漢，漢多發兵，使丞相灌嬰擊之，文帝親幸太原，以為天子自擊胡，遂發兵反於濟北。天子聞之，罷丞相及行兵，皆歸長安。使棘蒲侯柴將軍擊破虜濟北王，王自殺，地入于漢，為郡。"}],"attestations":[{"id":"th-shiji052-059:a001","paragraph_id":"c-shiji-052-qidaohui:p037","start":193,"end":195,"surface":"將軍","person_mention_id":"c-shiji-052-qidaohui:m037-0189","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、任事、提議、回敘及用稱分開；年號僅留原語，不反算公曆起訖。朱虛、東牟許封趙梁而未實現不記實授，死亡不自動終止全部稱號。章與興居授王兩處年表述各留原段，不擅調和。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji052-051","person_id":"cbr-p003264","surfaces":["棘蒲侯柴將軍"],"scope":"same_chapter","chapter_ids":["c-shiji-052-qidaohui"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-052-qidaohui:p037","quote":"孝文帝二年，以齊之濟北郡立興居為濟北王，與城陽王俱立。立二年，反。始大臣誅呂氏時，朱虛侯功尤大，許盡以趙地王朱虛侯，盡以梁地王東牟侯。及孝文帝立，聞朱虛、東牟之初欲立齊王，故絀其功。及二年，王諸子，乃割齊二郡以王章、興居。章、興居自以失職奪功。章死，而興居聞匈奴大入漢，漢多發兵，使丞相灌嬰擊之，文帝親幸太原，以為天子自擊胡，遂發兵反於濟北。天子聞之，罷丞相及行兵，皆歸長安。使棘蒲侯柴將軍擊破虜濟北王，王自殺，地入于漢，為郡。"}],"rationale":"依明示名與王國、世次的局部敘事暫接；齊、城陽與菑川同諡者分開，興居與志分開。校勘建延及內史勳士未擅選讀法，未名帝后不補姓名，案件只保存來源敘事。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-052-qidaohui:p037","text"