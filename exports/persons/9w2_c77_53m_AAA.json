0132","start":132,"end":134,"surface":"戎姬","kind":"person","person_id":"o0m_w07_a7p","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0140","start":140,"end":142,"surface":"靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0144","start":144,"end":146,"surface":"莊公","kind":"person","person_id":"9w2_c77_53m_AAAA","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0150","start":150,"end":153,"surface":"太子牙","kind":"person","person_id":"zf3_s9n_ty5","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0165","start":165,"end":167,"surface":"崔杼","kind":"person","person_id":"xgd_r31_cmr","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m061-0168","start":168,"end":170,"surface":"高厚","kind":"person","person_id":"yti_e9l_fle","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-039-jin:p118","text":"平公元年，伐齊，齊靈公與戰靡下，齊師敗走。晏嬰曰：「君亦毋勇，何不止戰？」遂去。晉追，遂圍臨菑，盡燒屠其郭中。東至膠，南至沂，齊皆城守，晉乃引兵歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m118-0000","start":0,"end":2,"surface":"平公","kind":"person","person_id":"0p8_ug5_eja","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m118-0008","start":8,"end":11,"surface":"齊靈公","kind":"person","person_id":"9w2_c77_53m_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m118-0021","start":21,"end":23,"surface":"晏嬰","kind":"person","person_id":"jcn_rp4_qap","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-062-guanyan:p007","text":"晏平仲嬰者，萊之夷維人也。事齊靈公、莊公、景公，以節儉力行重於齊。既相齊，食不重肉，妾不衣帛。其在朝，君語及之，即危言；語不及之，即危行。國有道，即順命；無道，即衡命。以此三世顯名於諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-062-guanyan:m007-0000","start":0,"end":4,"surface":"晏平仲嬰","kind":"person","person_id":"axg_i3i_ioc","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m007-0014","start":14,"end":17,"surface":"齊靈公","kind":"person","person_id":"odm_1yx_6o6","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m007-0018","start":18,"end":20,"surface":"莊公","kind":"person","person_id":"ttt_f6l_4dk","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m007-0021","start":21,"end":23,"surface":"景公","kind":"person","person_id":"ngn_nzv_4gr","status":"contextual_provisional"},{"id":"c-shiji-062-guanyan:m007-0042","start":42,"end":43,"surface":"妾","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代；不補姓名、成員與特定齊君。"},{"id":"c-shiji-062-guanyan:m007-0051","start":51,"end":52,"surface":"君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代；不補姓名、成員與特定齊君。"},{"id":"c-shiji-062-guanyan:m007-0091","start":91,"end":93,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代；不補姓名、成員與特定齊君。"}],"chapter_id":"c-shiji-062-guanyan","book_id":"b-shiji-062","work_id":"w-shiji","source_id":"s-shiji-062-guanyan"}],"sources":[{"chapter_id":"c-shiji-032-qi","work_id":"w-shiji","book_id":"b-shiji-032","source_id":"s-shiji-032-qi","source":{"title":"史記／卷032","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷032","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷032&oldid=445042","revision_id":445042,"accessed_on":"2026-10-09","extent":"正文85個p區塊，自太公望呂尚者至太史公論贊；排除頂部君主摘要、跨站導覽及索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"保留彨、薄泵、慈母、無忌等原字與姓名，未按熟知讀法改寫。","note":"固定版本與實讀HTML一致；全85段首輪標註，代詞、版本與身份覆核未完；未核底本、影像或專門研究。"}}},{"chapter_id":"c-shiji-039-jin","work_id":"w-shiji","book_id":"b-shiji-039","source_id":"s-shiji-039-jin","source":{"title":"史記／卷0