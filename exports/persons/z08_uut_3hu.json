:"c-shiji-120-jizheng:m011-0066","start":66,"end":67,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m011-0076","start":76,"end":77,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m011-0087","start":87,"end":88,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m011-0094","start":94,"end":96,"surface":"陛下","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m011-0097","start":97,"end":99,"surface":"群臣","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m011-0111","start":111,"end":112,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m011-0117","start":117,"end":118,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m011-0120","start":120,"end":121,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m011-0133","start":133,"end":134,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-120-jizheng:p013","text":"居數年，會更五銖錢，民多盜鑄錢，楚地尤甚。上以為淮陽，楚地之郊，乃召拜黯為淮陽太守。黯伏謝不受印，詔數彊予，然後奉詔。詔召見黯，黯為上泣曰：「臣自以為填溝壑，不復見陛下，不意陛下復收用之。臣常有狗馬病，力不能任郡事，臣願為中郎，出入禁闥，補過拾遺，臣之願也。」上曰：「君薄淮陽邪？吾今召君矣。顧淮陽吏民不相得，吾徒得君之重，臥而治之。」黯既辭行，過大行李息，曰：「黯棄居郡，不得與朝廷議也。然御史大夫張湯智足以拒諫，詐足以飾非，務巧佞之語，辯數之辭，非肯正為天下言，專阿主意。主意所不欲，因而毀之；主意所欲，因而譽之。好興事，舞文法，內懷詐以御主心，外挾賊吏以為威重。公列九卿，不早言之，公與之俱受其僇矣。」息畏湯，終不敢言。黯居郡如故治，淮陽政清。後張湯果敗，上聞黯與息言，抵息罪。令黯以諸侯相秩居淮陽。七歲而卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m013-0021","start":21,"end":22,"surface":"上","kind"