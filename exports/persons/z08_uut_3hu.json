olved"},{"id":"c-shiji-120-jizheng:m013-0304","start":304,"end":305,"surface":"息","kind":"person","person_id":"oyo_84y_ukl","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m013-0306","start":306,"end":307,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m013-0313","start":313,"end":314,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m013-0326","start":326,"end":328,"surface":"張湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m013-0331","start":331,"end":332,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m013-0333","start":333,"end":334,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m013-0335","start":335,"end":336,"surface":"息","kind":"person","person_id":"oyo_84y_ukl","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m013-0339","start":339,"end":340,"surface":"息","kind":"person","person_id":"oyo_84y_ukl","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m013-0343","start":343,"end":344,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-121-rulin:p015","text":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m015-0000","start":0,"end":2,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"con