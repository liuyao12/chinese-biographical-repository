m015-0168","start":168,"end":169,"surface":"湯","kind":"person","person_id":"z08_uut_3hu","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p015","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m015-0194","start":194,"end":196,"surface":"張湯","kind":"person","person_id":"z08_uut_3hu","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p015","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[{"id":"th-shiji120-012","person_id":"04o_yps_sg0","title":"御史大夫","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p011","quote":"始黯列為九卿，而公孫弘、張湯為小吏。及弘、湯稍益貴，與黯同位，黯又非毀弘、湯等。已而弘至丞相，封為侯；湯至御史大夫；故黯時丞相史皆與黯同列，或尊用過之。黯褊心，不能無少望，見上，前言曰：「陛下用群臣如積薪耳，后來者居上。」上默然。有閒黯罷，上曰：「人果不可以無學，觀黯之言也日益甚。」"}],"attestations":[{"id":"th-shiji120-012:a001","paragraph_id":"c-shiji-120-jizheng:p011","start":53,"end":57,"surface":"御史大夫","person_mention_id":"c-shiji-120-jizheng:m011-0012","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p011","quote":"始黯列為九卿，而公孫弘、張湯為小吏。及弘、湯稍益貴，與黯同位，黯又非毀弘、湯等。已而弘至丞相，封為侯；湯至御史大夫；故黯時丞相史皆與黯同列，或尊用過之。黯褊心，不能無少望，見上，前言曰：「陛下用群臣如積薪耳，后來者居上。」上默然。有閒黯罷，上曰：「人果不可以無學，觀黯之言也日益甚。」"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。莊為太史保留底本，不校改為大農。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji121-033","person_id":"z08_uut_3hu","title":"御史大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p015","quote":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。"}],"attestations":[{"id":"th-shiji121-033:a001","paragraph_id":"c-shiji-121-rulin:p015","start":170,"end":174,"surface":"御史大夫","person_mention_id":"c-shiji-121-rulin:m015-0098","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依原文區分授任、貶任與用稱；未明日期保持未知，死亡不自動終止官爵。敘事時長不反推公元年。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[{"id":"eq-shiji121-cross-002","person_ids":["04o_yps_sg0","z08_uut_3hu"],"canonical_person_id":"04o_yps_sg0","scope":"cross_chapter","chapter_ids":["c-shiji-120-jizheng","c-shiji-121-rulin"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-120-jizheng","source_id":"s-shiji120-jizheng","paragraph_id":"c-shiji-120-jizheng:p011","quote":"始黯列為九卿，而公孫弘、張湯為小吏。及弘、湯稍益貴，與黯同位，黯又非毀弘、湯等。已而弘至丞相，封為侯；湯至御史大夫；故黯時丞相史皆與黯同列，或尊用過之。黯褊心，不能無少望，見上，前言曰：「陛下用群臣如積薪耳，后來者居上。」上默然。有閒黯罷，上曰：「人果不可以無學，觀黯之言也日益甚。」","mention_ids":["c-shiji-120-jizheng:m011-0012","c-shiji-120-jizheng:m011-0021","c-shiji-120-jizheng:m011-0037","c-shiji-120-jizheng:m011-0051"]},{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p015","quote":"伏生教濟南張生及歐陽生，歐陽生教千乘兒寬。兒寬既通尚書，以文學應郡舉，詣博士受業，受業孔安國。兒寬貧無資用，常為弟子都養，及時時閒行傭賃，以給衣食。行常帶經，止息則誦習之。以試第次，補廷尉史。是時張湯方鄉學，以為奏讞掾，以古法議決疑大獄，而愛幸寬。寬為人溫良，有廉智，自持，而善著書、書奏，敏於文，口不能發明也。湯以為長者，數稱譽之。及湯為御史大夫，以兒寬為掾，薦之天子。天子見問，說之。張湯死后六年，兒寬位至御史大夫。九年而以官卒。寬在三公位，以和良承意從容得久，然無有所匡諫；於官，官屬易之，不為盡力。張生亦為博士。而伏生孫以治尚書徵，不能明也。","mention_ids":["c-shiji-121-rulin:m015-0098","c-shiji-121-rulin:m015-0156","c-shiji-121-rulin:m015-0168","c-shiji-121-rulin:m015-0194"]}],"rationale":"兩篇同記張湯升至御史大夫，並處當朝天子任用群臣的仕宦脈絡；姓名與官職支持暫同指，尚未對所有紀年及死亡來源作校定。 原始ID保留，同書平行敘事不作獨立見證。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-120-jizheng:p006","text":"張湯方以更定律令為廷尉，黯數質責湯於上前，曰：「公為正卿，上不能褒先帝之功業，下不能抑天下之邪心，安國富民，使囹圄空虛，二者無一焉。非苦就行，放析就功，何乃取斑皇帝約束紛更之為？公以此無種矣。」黯時與湯論議，湯辯常在文深小苛，黯伉厲守高不能屈，忿發罵曰：「天下謂刀筆吏不可以為公卿，果然。必湯也，令天下重足而立，側目而視矣！」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m006-0000","start":0,"end":2,"surface":"張湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m006-0012","start":12,"end":13,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m006-0016","start":16,"end":17,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m006-0033","start":33,"end":35,"surface":"先帝","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m006-0080","start":80,"end":82,"surface":"皇帝","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m006-0097","start":97,"end":98,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m006-0100","start":100,"end":101,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m006-0104","start":104,"end":105,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m006-0113","start":113,"end":114,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m006-0131","start":131,"end":134,"surface":"刀筆吏","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m006-0138","start":138,"end":140,"surface":"公卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m006-0145","start":145,"end":146,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"},{"id":"c-shiji-120-jizheng:p007","text":"是時，漢方征匈奴，招懷四夷。黯務少事，乘上閒，常言與胡和親，無起兵。上方向儒術，尊公孫弘。及事益多，吏民巧弄。上分別文法，湯等數奏決讞以幸。而黯常毀儒，面觸弘等徒懷詐飾智以阿人主取容，而刀筆吏專深文巧詆，陷人於罪，使不得反其真，以勝為功。上愈益貴弘、湯，弘、湯深心疾黯，唯天子亦不說也，欲誅之以事。弘為丞相，乃言上曰：「右內史界部中多貴人宗室，難治，非素重臣不能任，請徙黯為右內史。」為右內史數歲，官事不廢。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m007-0014","start":14,"end":15,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m007-0020","start":20,"end":21,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m007-0034","start":34,"end":35,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m007-0041","start":41,"end":44,"surface":"公孫弘","kind":"person","person_id":"199_63i_sqy","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m007-0050","start":50,"end":52,"surface":"吏民","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m007-0055","start":55,"end":56,"surface":"上","kind":"person","person_id":"36n_3tt_pt4","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m007-0061","start":61,"end":62,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m007-0071","start":71,"end":72,"surface":"黯","kind":"person","person_id":"g2z_cl6_w4r","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m007-0078","start":78,"end":79,"surface":"弘","kind":"person","person_id":"199_63i_sqy","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m007-0093","start":93,"end":96,"surface":"刀筆吏","kind":"unre