d":18,"surface":"寄","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0020","start":20,"end":21,"surface":"況","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0023","start":23,"end":25,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0028","start":28,"end":30,"surface":"高后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0039","start":39,"end":41,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0050","start":50,"end":53,"surface":"太尉勃","kind":"person","person_id":"s8n_dgg_60b","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0065","start":65,"end":67,"surface":"酈商","kind":"person","person_id":"bni_7nd_jnt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0071","start":71,"end":72,"surface":"況","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0073","start":73,"end":75,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0076","start":76,"end":78,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0087","start":87,"end":90,"surface":"太尉勃","kind":"person","person_id":"s8n_dgg_60b","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0104","start":104,"end":105,"surface":"商","kind":"person","person_id":"bni_7nd_jnt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0113","start":113,"end":114,"surface":"寄","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m014-0120","start":120,"end":122,"surface":"酈況","kind":"person","person_id":"bni_7nd_jnt_B","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p032","text":"嬰自破布歸，高帝崩，嬰以列侯事孝惠帝及呂太后。太后崩，呂祿等以趙王自置為將軍，軍長安，為亂。齊哀王聞之，舉兵西，且入誅不當為王者。上將軍呂祿等聞之，乃遣嬰為大將，將軍往擊之。嬰行至滎陽，乃與絳侯等謀，因屯兵滎陽，風齊王以誅呂氏事，齊兵止不前。絳侯等既誅諸呂，齊王罷兵歸，嬰亦罷兵自滎陽歸，與絳侯、陳平共立代王為孝文皇帝。孝文皇帝於是益封嬰三千戶，賜黃金千斤，拜為太尉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m032-0000","start":0,"end":1,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0003","start":3,"end":4,"surface":"布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0006","start":6,"end":8,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0010","start":10,"end":11,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0015","start":15,"end":18,"surface":"孝惠帝","kind":"person","person_id":"2u6_7bk_902","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0019","start":19,"end":22,"surface":"呂太后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0023","start":23,"end":25,"surface":"太后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0027","start":27,"end":29,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0046","start":46,"end":49,"surface":"齊哀王","kind":"person","person_id":"ybw_usv_89e","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m032-0068","start":68,"end":70,"surface":"呂祿","kind":"person","person_id":"699_ven_lj5","status":"contextual