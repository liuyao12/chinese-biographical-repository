chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p033","text":"三歲，絳侯勃免相就國，嬰為丞相，罷太尉官。是歲，匈奴大入北地、上郡，令丞相嬰將騎八萬五千往擊匈奴。匈奴去，濟北王反，詔乃罷嬰之兵。後歲餘，嬰以丞相卒，謚曰懿侯。子平侯阿代侯。二十八年卒，子彊代侯。十三年，彊有罪，絕二歲。元光三年，天子封灌嬰孫賢為臨汝侯，續灌氏後，八歲，坐行賕有罪，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m033-0003","start":3,"end":6,"surface":"絳侯勃","kind":"person","person_id":"s8n_dgg_60b","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0011","start":11,"end":12,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0037","start":37,"end":38,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0053","start":53,"end":56,"surface":"濟北王","kind":"person","person_id":"l2k_zrx_xfr","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0061","start":61,"end":62,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0069","start":69,"end":70,"surface":"嬰","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0083","start":83,"end":84,"surface":"阿","kind":"person","person_id":"mdl_l60_pwy_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0094","start":94,"end":95,"surface":"彊","kind":"person","person_id":"mdl_l60_pwy_AA","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0102","start":102,"end":103,"surface":"彊","kind":"person","person_id":"mdl_l60_pwy_AA","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0115","start":115,"end":117,"surface":"天子","kind":"person","person_id":"6cm_dc1_y12","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m033-0118","start":118,"end":122,"surface":"灌嬰孫賢","kind":"pers