g:m006-0189","start":189,"end":190,"surface":"豨","kind":"person","person_id":"ht1_kdz_izj","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0194","start":194,"end":196,"surface":"王黃","kind":"person","person_id":"frp_bsu_g43","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0203","start":203,"end":205,"surface":"韓信","kind":"person","person_id":"39e_wj9_6m0","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0215","start":215,"end":217,"surface":"韓信","kind":"person","person_id":"39e_wj9_6m0","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0219","start":219,"end":220,"surface":"豨","kind":"person","person_id":"ht1_kdz_izj","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0228","start":228,"end":230,"surface":"趙既","kind":"person","person_id":"r5i_kqz_a0i","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0235","start":235,"end":237,"surface":"馮梁","kind":"person","person_id":"6hu_5eu_5t3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0239","start":239,"end":241,"surface":"孫奮","kind":"person","person_id":"hsg_oao_yjg","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0244","start":244,"end":246,"surface":"王黃","kind":"person","person_id":"frp_bsu_g43","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0256","start":256,"end":258,"surface":"解福","kind":"person","person_id":"q0l_cnu_l8r","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0278","start":278,"end":280,"surface":"盧綰","kind":"person","person_id":"4k0_mri_buk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0282","start":282,"end":283,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0287","start":287,"end":289,"surface":"盧綰","kind":"person","person_id":"4k0_mri_buk","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p008","text":"先黥布反時，高祖嘗病甚，惡見人，臥禁中，詔戶者無得入群臣。群臣絳、灌等莫敢入。十餘日，噲乃排闥直入，大臣隨之。上獨枕一宦者臥。噲等見上流涕曰：「始陛下與臣等起豐沛，定天下，何其壯也！今天下已定，又何憊也！且陛下病甚，大臣震恐，不見臣等計事，顧獨與一宦者絕乎？且陛下獨不見趙高之事乎？」高帝笑而起。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m008-0001","start":1,"end":3,"surface":"黥布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m008-0006","start":6,"end":8,"surface":"高祖","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m008-0031","start":31,"end":32,"surface":"絳","kind":"person","person_id":"s8n_dgg_60b","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m008-0033","start":33,"end":34,"surface":"灌","kind":"person","person_id":"mdl_l60_pwy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m008-0043","start":43,"end":44,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m008-0063","start":63,"end":64,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m008-0135","start":135,"end":137,"surface":"趙高","kind":"person","person_id":"jyd_5a2_cil","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m008-0142","start":142,"end":144,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p009","text":"其後盧綰反，高帝使噲以相國擊燕。是時高帝病甚，人有惡噲黨於呂氏，即上一日宮車晏駕，則噲欲以兵盡誅滅戚氏、趙王如意之屬。高帝聞之大怒，乃使陳平載絳侯代將，而即軍中斬噲。陳平畏呂后，執噲詣長安。至則高祖已崩，呂后釋噲，使復爵邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m009-0002","start":2,"end":4,"surface":"盧綰","kind":"person","person_id":"4k0_mri_buk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0006","start":6,"end":8,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0009","start":9,"end":10,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0018","start":18,"end":20,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0026","start":26,"end":27,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0042","start":42,"end":43,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0052","start":52,"end":56,"surface":"趙王如意","kind":"person","person_id":"37x_h50_3ls","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0059","start":59,"end":61,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0068","start":68,"end":70,"surface":"陳平","kind":"person","person_id":"z6m_hs4_r4a","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0071","start":71,"end":73,"surface":"絳侯","kind":"person","person_id":"s8n_dgg_60b","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0081","start":81,"end":82,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0083","start":83,"end":85,"surface":"陳平","kind":"person","person_id":"z6m_hs4_r4a","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0086","start":86,"end":88,"surface":"呂后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0090","start":90,"end":91,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0097","start":97,"end":99,"surface":"高祖","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0102","start":102,"end":104,"surface":"呂后","kind":"person","person_id":"mrj_1jl_2tk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0105","start":105,"end":106,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p013","text":"項羽既已死，漢王為帝。其秋，燕王臧荼反，商以將軍從擊荼，戰龍脫，先登陷陣，破荼軍易下，卻敵，遷為右丞相，賜爵列侯，與諸侯剖符，世世勿絕，食邑涿五千戶，號曰涿侯。以右丞相別定上谷，因攻代，受趙相國印。以右丞相趙相國別與絳侯等定代、鴈門，得代丞相程縱、守相郭同、將軍已下至六百石十九人。還，以將軍為太上皇衛一歲七月。以右丞相擊陳豨，殘東垣。又以右丞相從高帝擊黥布，攻其前拒，陷兩陳，得以破布軍，更食曲周五千一百戶，除前所食，凡別破軍三，降定郡六，縣七十三，得丞相、守相、大將各一人，小將二人，二千石已下至六百石十九人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m013-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"qcp_ou0_2g1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0006","start":6,"end":8,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0016","start":16,"end":18,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0020","start":20,"end":21,"surface":"商","kind":"person","person_id":"bni_7nd_jnt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0026","start":26,"end":27,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0038","start":38,"end":39,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0108","start":108,"end":110,"surface":"絳侯","kind":"person","person