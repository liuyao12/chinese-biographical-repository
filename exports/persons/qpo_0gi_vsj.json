face":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0406","start":406,"end":407,"surface":"禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0410","start":410,"end":411,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0440","start":440,"end":442,"surface":"天子","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0462","start":462,"end":463,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0470","start":470,"end":471,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0481","start":481,"end":483,"surface":"陛下","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0497","start":497,"end":498,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m023-0501","start":501,"end":504,"surface":"三長史","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p038","text":"減宣者，楊人也。以佐史無害給事河東守府。衞將軍靑使買馬河東，見宣無害，言上，徴爲大廐丞。官事辨，稍遷至御史及中丞。使治主父偃及治淮南反獄，所以微文深詆，殺者甚衆，稱爲敢決疑。數廢數起，爲御史及中丞者幾二十歳。王温舒免中尉，而宣爲左内史。其治米鹽，事大小皆關其手，自部署縣名曹實物，官吏令丞不得擅搖，痛以重法繩之。居官數年，一切郡中爲小治辨，然獨宣以小致大，能因力行之，難以爲經。中廢。爲右扶風，坐怨成信，信亡藏上林中，宣使郿令格殺信，吏卒格信時，射中上林苑門，宣下吏詆罪，以爲大逆，當族，自殺。而杜周任用。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m038-0000","start":0,"end":2,"surface":"減宣","kind":"person","person_id":"qpo_0gi_vsj","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m038-0020","start":20,"end":24,"surface":"衞將軍靑","kind":"person","person_id":"up1_nzr_gq1","sta