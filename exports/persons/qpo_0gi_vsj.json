on_id":"gbb_0p6_20p","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m038-0230","start":230,"end":231,"surface":"宣","kind":"person","person_id":"qpo_0gi_vsj","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m038-0248","start":248,"end":250,"surface":"杜周","kind":"person","person_id":"dxx_6m8_7o6","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p039","text":"杜周者，南陽杜衍人。義縱爲南陽守，以爲爪牙，舉爲廷尉史。事張湯，湯數言其無害，至御史。使案邊失亡，所論殺甚衆。奏事中上意，任用，與減宣相編，更爲中丞十餘歳。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m039-0000","start":0,"end":2,"surface":"杜周","kind":"person","person_id":"dxx_6m8_7o6","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m039-0010","start":10,"end":12,"surface":"義縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m039-0029","start":29,"end":31,"surface":"張湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m039-0032","start":32,"end":33,"surface":"湯","kind":"person","person_id":"04o_yps_sg0","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m039-0058","start":58,"end":59,"surface":"上","kind":"person","person_id":"ln1_tyi_kei","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m039-0065","start":65,"end":67,"surface":"減宣","kind":"person","person_id":"qpo_0gi_vsj","status":"contextual_provisional"}],"chapter_id":"c-shiji-122-kuli","book_id":"b-shiji-122","work_id":"w-shiji","source_id":"s-shiji122-kuli"},{"id":"c-shiji-122-kuli:p040","text":"其治與宣相放，然重遲，外寬，内深次骨。宣爲左内史，周爲廷尉，其治大放張湯而善候伺。上所欲擠者，因而陷之；上所欲釋者，久繫待問而微見其冤狀。客有讓周曰：「君爲天子決平，不循三尺法，專以人主意指爲獄。獄者固如是乎？」周曰：「三尺安出哉？前主所是著爲律，後主所是疎爲令，當時爲是，何古之法乎！」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m040-0003","start":3,"end":4,"surface":"宣","kind":"person","person_id":