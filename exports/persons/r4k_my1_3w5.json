"c-shiji-121-rulin:p008","c-shiji-121-rulin:p011"],"passage_count":4}],"most_mentioned_source_ids":["s-shiji121-rulin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji121-004","person_id":"r4k_my1_3w5","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-121-rulin","source_id":"s-shiji121-rulin","paragraph_id":"c-shiji-121-rulin:p005","quote":"及今上即位，趙綰、王臧之屬明儒學，而上亦鄉之，於是招方正賢良文學之士。自是之后，言詩於魯則申培公，於齊則轅固生，於燕則韓太傅。言尚書自濟南伏生。言禮自魯高堂生。言易自菑川田生。言春秋於齊魯自胡毋生，於趙自董仲舒。及竇太后崩，武安侯田蚡為丞相，絀黃老、刑名百家之言，延文學儒者數百人，而公孫弘以春秋白衣為天子三公，封以平津侯。天下之學士靡然鄉風矣。","person_mention_id":"c-shiji-121-rulin:m005-0107"}],"interpretation_note":"原文明示卒、死或崩；先存本篇來源記錄，未由敘事時長反推公元年或合併其他來源的死亡說法。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-121-rulin:m004-0226","start":226,"end":229,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p004","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m005-0107","start":107,"end":110,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p005","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m008-0205","start":205,"end":208,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p008","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m011-0000","start":0,"end":3,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p011","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m011-0029","start":29,"end":31,"surface":"太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p011","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m011-0056","start":56,"end":58,"surface":"太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p011","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m011-0091","start":91,"end":93,"surface":"太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p011","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-121-rulin:p004","text":"及高皇帝誅項籍，舉兵圍魯，魯中諸儒尚講誦習禮樂，弦歌之音不絕，豈非聖人之遺化，好禮樂之國哉？故孔子在陳曰：「歸與！歸與！吾黨之小子狂簡，斐然成章，不知所以裁之。」夫齊魯之閒於文學，自古以來，其天性也。故漢興，然後諸儒始得修其經藝，講習大射鄉飲之禮。叔孫通作漢禮儀，因為太常，諸生弟子共定者，咸為選首，於是喟然嘆興於學。然尚有干戈，平定四海，亦未暇遑庠序之事也。孝惠、呂后時，公卿皆武力有功之臣。孝文時頗徵用，然孝文帝本好刑名之言。及至孝景，不任儒者，而竇太后又好黃老之術，故諸博士具官待問，未有進者。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m004-0001","start":1,"end":4,"surface":"高皇帝","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0005","start":5,"end":7,"surface":"項籍","kind":"person","person_id":"mtg_mtp_8oz","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0013","start":13,"end":17,"surface":"魯中諸儒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0033","start":33,"end":35,"surface":"聖人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0047","start":47,"end":49,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","st