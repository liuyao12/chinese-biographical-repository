15,"end":117,"surface":"田蚡","kind":"person","person_id":"aax_0zm_3jf","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0133","start":133,"end":137,"surface":"文學儒者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0142","start":142,"end":145,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0151","start":151,"end":153,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0162","start":162,"end":167,"surface":"天下之學士","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p008","text":"蘭陵王臧既受詩，以事孝景帝為太子少傅，免去。今上初即位，臧乃上書宿衛上，累遷，一歲中為郎中令。及代趙綰亦嘗受詩申公，綰為御史大夫。綰、臧請天子，欲立明堂以朝諸侯，不能就其事，乃言師申公。於是天子使使束帛加璧安車駟馬迎申公，弟子二人乘軺傳從。至，見天子。天子問治亂之事，申公時已八十餘，老，對曰：「為治者不在多言，顧力行何如耳。」是時天子方好文詞，見申公對，默然。然已招致，則以為太中大夫，舍魯邸，議明堂事。太皇竇太后好老子言，不說儒術，得趙綰、王臧之過以讓上，上因廢明堂事，盡下趙綰、王臧吏，後皆自殺。申公亦疾免以歸，數年卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m008-0002","start":2,"end":4,"surface":"王臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0010","start":10,"end":13,"surface":"孝景帝","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0022","start":22,"end":24,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0028","start":28,"end":29,"surface":"臧","kind":"person","person_id":"fhl_wxh_rfr","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0034","start":34,"end":35,"surface":"上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0049","start":49,"end":51,"surface":"趙綰","kind":"person","person