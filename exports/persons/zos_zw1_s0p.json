entioned_source_ids":["s-jinshu036-wei-ws2108231-rendered-comparison"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-036-wei-comparison:p007:m0156","start":156,"end":160,"surface":"清河王遐","kind":"person","person_id":"zos_zw1_s0p","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p007","chapter_id":"c-jinshu-036-wei-comparison"},{"id":"c-jinshu-036-wei-comparison:p007:m0166","start":166,"end":167,"surface":"遐","kind":"person","person_id":"zos_zw1_s0p","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p007","chapter_id":"c-jinshu-036-wei-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin036-wei-qinghe_xia","person_id":"zos_zw1_s0p","surfaces":["清河王遐","遐"],"scope":"same_chapter","chapter_ids":["c-jinshu-036-wei-comparison"],"status":"contextual_provisional","confidence_level":"high","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-036","source_id":"s-jinshu036-wei-ws2108231-rendered-comparison","chapter_id":"c-jinshu-036-wei-comparison","paragraph_id":"c-jinshu-036-wei-comparison:p007","quote":"惠帝即位，復瓘千兵。及楊駿誅，以瓘錄尚書事，加綠綟綬，劍履上殿，入朝不趨，給騎司馬，與汝南王亮共輔朝政。亮奏遣諸王還籓，與朝臣廷議，無敢應者，唯瓘贊其事，楚王瑋由是憾焉。賈后素怨瓘，且忌其方直，不得騁己淫虐；又聞瓘與瑋有隙，遂謗瓘與亮欲為伊霍之事，啟帝作手詔，使瑋免瓘等官。黃門齎詔授瑋，瑋性輕險，欲聘私怨，夜使清河王遐收瓘。左右疑遐矯詔，咸諫曰：「禮律刑名，台輔大臣，未有此比，且請距之。須自表得報，就戮未晚也。」瓘不從，遂與子恆、嶽、裔及孫等九人同被害，時年七十二。恆二子璪、玠，時在醫家得免。","mention_ids":["c-jinshu-036-wei-comparison:p007:m0156","c-jinshu-036-wei-comparison:p007:m0166"]}],"rationale":"完整本傳/嵌入書勢/引語時層逐處判讀。清河王遐〔瑋遣收瓘者〕；不是全域同字配對，未由本次標記推任官、同場或親屬世距。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-036-wei-comparison:p007","text":"惠帝即位，復瓘千兵。及楊駿誅，以瓘錄尚書事，加綠綟綬，劍履上殿，入朝不趨，給騎司馬，與汝南王亮共輔朝政。亮奏遣諸王還籓，與朝臣廷議，無敢應者，唯瓘贊其事，楚王瑋由是憾焉。賈后素怨瓘，且忌其方直，不得騁己淫虐；又聞瓘與瑋有隙，遂謗瓘與亮欲為伊霍之事，啟帝作手詔，使瑋免瓘等官。黃門齎詔授瑋，瑋性輕險，欲聘私怨，夜使清河王遐收瓘。左右疑遐矯詔，咸諫曰：「禮律刑名，台輔大臣，未有此比，且請距之。須自表得報，就戮未晚也。」瓘不從，遂與子恆、嶽、裔及孫等九人同被害，時年七十二。恆二子璪、玠，時在醫家得免。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","captured_source_position":{"unit_key":"p007","projection_ref":"source-evidence/jin036-wei-comparison/projection.json","capture_sha256":"6db27cbd14cb251ba7ab4e58e9064b02d808cd893b02c044e359c7ccedd73659","source_response_sha256":"6dc95bd5962acbb6d2e8d3854ee215d7693d07f11b5224e5bcaa53af7d531dfb","capture_kind":"fixed_revision_HTML_rendered_text_extract","revision_id":2108231,"parsed_block_index":9},"mentions":[{"id":"c-jinshu-036-wei-comparison:p007:m0000","start":0,"end":2,"surface":"惠帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p007:m0006","start":6,"end":7,"surface":"瓘","kind":"person","person_id":"q1l_utb_rfn_**AA","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p007:m0011","start":11,"end":13,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p007:m0016","start":16,"end":17,"surface":"瓘","kind":"person","person_id":"q1l_utb_rfn_**AA","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p007:m0043","start":43,"end":47,"surface":"汝南王亮","kind":"person","person_id":"dkn_ge4_286_AAAAC","status":"contextual_provisional"},{"id":"c-jinshu-036-wei-comparison:p007:m0052","sta