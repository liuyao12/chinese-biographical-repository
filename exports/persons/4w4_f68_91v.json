tion_id":"c-liangshu-021-wangfen:p012:m0000","object_person_reference_id":"c-liangshu-021-wangfen:p012:r0014"}],"status":"contextual_provisional","interpretation_note":"弟傳首承錫，第76行明載錫為王琳第二子，第83行明稱其弟八歲丁父憂。","human_reviewed":false}}],"source_mention_summary":[{"source_id":"s-liangshu-021-wangfen-ws1544250","work_id":"w-liangshu","book_id":"b-liangshu-021","chapter_id":"c-liangshu-021-wangfen","raw_mention_count":1,"mention_ids":["c-liangshu-021-wangfen:p012:m0135"],"paragraph_ids":["c-liangshu-021-wangfen:p012"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-021-wangfen:p012:m0135","mention_ids":["c-liangshu-021-wangfen:p012:m0135"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanshi-023-wangqian-mothers-ws2478204","work_id":"w-nanshi","book_id":"b-nanshi-023","chapter_id":"c-nanshi-023-wangqian-mothers","raw_mention_count":1,"mention_ids":["c-nanshi-023-wangqian-mothers:p001:m0039"],"paragraph_ids":["c-nanshi-023-wangqian-mothers:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-023-wangqian-mothers:p001:m0039","mention_ids":["c-nanshi-023-wangqian-mothers:p001:m0039"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-021-wangfen-ws1544250","s-nanshi-023-wangqian-mothers-ws2478204"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_ki