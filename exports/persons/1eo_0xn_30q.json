eferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin043-wyd-wangrong-c-jinshu-043-wangrong-p013-m0114","person_id":"1eo_0xn_30q","surfaces":["黃公"],"scope":"cross_chapter","chapter_ids":["c-jinshu-043-wyd1739-wangrong","c-jinshu-043-wangrong"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-wyd1739-wangrong","chapter_id":"c-jinshu-043-wyd1739-wangrong","paragraph_id":"c-jinshu-043-wyd1739-wangrong:p009","quote":"一單衣婚訖而更責取家有好李常出貨之恐人得種恒鑽其核以此獲譏於世其後從帝北伐王師敗績於蕩陰戎復詣鄴隨帝還洛陽車駕之西遷也戎出奔于郟在危難之間親接鋒刃談笑自若未嘗有懼容時召親賓歡娛永日永興二年薨于郟縣時年七十二諡曰元戎有人倫鑒識常目山濤如璞玉渾金人皆欽其寳莫知名其器王衍神姿高徹如瑤林瓊樹自然是風塵表物謂裴頠拙於用長荀勖工於用短陳道寧〓〓如束長竿族弟敦有高名戎惡之敦每候戎輒託疾不見敦後果為逆亂其鑒賞先見如此嘗經黃公酒壚下過","mention_ids":["c-jinshu-043-wyd1739-wangrong:p009:m0204"]},{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-wangrong","chapter_id":"c-jinshu-043-wangrong","paragraph_id":"c-jinshu-043-wangrong:p013","quote":"戎有人倫鑒識，嘗目山濤如璞玉渾金，人皆欽其寶，莫知名其器；王衍神姿高徹，如瑤林瓊樹，自然是風塵表物。謂裴頠拙於用長，荀勖工於用短，陳道寧𦃩𦃩如束長竿。族弟敦有高名，戎惡之。敦每候戎，輒托疾不見。敦後果為逆亂。其鑒嘗先見如此。嘗經黃公酒壚下過，顧謂後車客曰：「吾昔與嵇叔夜、阮嗣宗酣暢于此，竹林之遊亦預其末。自嵇、阮雲亡，吾便為時之所羈絏。今日視之雖近，邈若山河！」初，孫秀為琅邪郡吏，求品於鄉議。戎從弟衍將不許，戎勸品之。及秀得志，朝士有宿怨者皆被誅，而戎、衍獲濟焉。","mention_id":"c-jinshu-043-wangrong:p013:m0114"}],"rationale":"同一王戎完整本傳相同敘事、角色與引語域的跨見證首選；綁既有真MID/完整原段及動態現役端點，不以label或ID推同人。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p013","text":"戎有人倫鑒識，嘗目山濤如璞玉渾金，人皆欽其寶，莫知名其器；王衍神姿高徹，如瑤林瓊樹，自然是風塵表物。謂裴頠拙於用長，荀勖工於用短，陳道寧𦃩𦃩如束長竿。族弟敦有高名，戎惡之。敦每候戎，輒托疾不見。敦後果為逆亂。其鑒嘗先見如此。嘗經黃公酒壚下過，顧謂後車客曰：「吾昔與嵇叔夜、阮嗣宗酣暢于此，竹林之遊亦預其末。自嵇、阮雲亡，吾便為時之所羈絏。今日視之雖近，邈若山河！」初，孫秀為琅邪郡吏，求品於鄉議。戎從弟衍將不許，戎勸品之。及秀得志，朝士有宿怨者皆被誅，而戎、衍獲濟焉。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p013:m0000","start":0,"end":1,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","resolution_note":"人倫鑒識與黃公酒壚回憶分域；嵇叔夜/阮嗣宗按同段嵇阮及既有字證