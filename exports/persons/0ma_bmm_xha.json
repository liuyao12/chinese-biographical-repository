start":3452,"raw_end":3573,"raw_character_offsets":[3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3474,3475,3476,3477,3478,3479,3480,3481,3482,3483,3484,3485,3486,3487,3488,3489,3490,3491,3492,3493,3494,3495,3496,3497,3498,3499,3500,3501,3502,3503,3504,3505,3506,3507,3508,3509,3510,3511,3512,3513,3514,3515,3516,3517,3518,3519,3520,3521,3522,3523,3524,3525,3526,3527,3528,3529,3530,3531,3532,3533,3534,3535,3536,3537,3538,3539,3540,3541,3542,3543,3544,3545,3546,3547,3548,3549,3550,3551,3552,3553,3554,3555,3556,3557,3558,3559,3560,3561,3562,3563,3564,3565,3566,3567,3568,3569,3570,3571,3572],"revision_id":1511897},"mentions":[{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0002","start":2,"end":4,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0009","start":9,"end":11,"surface":"慧曉","kind":"person","person_id":"jss_82r_1ct_AA","status":"contextual_provisional"},{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0017","start":17,"end":19,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0042","start":42,"end":46,"surface":"武陵王曅","kind":"person","person_id":"i1v_ajd_qr0","status":"contextual_provisional"},{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0058","start":58,"end":60,"surface":"慧曉","kind":"person","person_id":"jss_82r_1ct_AA","status":"contextual_provisional"},{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0072","start":72,"end":74,"surface":"劉璡","kind":"person","person_id":"0ma_bmm_xha","status":"contextual_provisional"},{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0083","start":83,"end":84,"surface":"璡","kind":"person","person_id":"0ma_bmm_xha","status":"contextual_provisional"},{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0091","start":91,"end":93,"surface":"張融","kind":"person","person_id":"d50_8f5_wul_AAABAC","status":"contextual_provisional"},{"id":"c-nanqishu-046-luhuixiao-complete:p003:m0094","start":94,"end":97,"surface":"陸慧曉","kind":"person","person_id":"jss_82r_1ct_AA","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-046-luhuixiao-complete","book_id":"b-nanqishu-046","work_id":"w-nanqishu","source_id":"s-nanqishu-046-luhuixiao-complete-ws1511897"},{"id":"c-nanqishu-055-filial-complete:p027","text":"　　朱謙之字處光，吳郡錢唐人也。父昭之，以學解稱於鄉里。謙之年數歲，所生母亡，昭之假葬田側，爲族人朱幼方燎火所焚。同產姉密語之，謙之雖小，便哀戚如持喪。年長不婚娶。永明中，手刃殺幼方，詣獄自繫。縣令申靈勗表上，別駕孔稚珪、兼記室劉璡、司徒左西掾張融牋與刺史豫章王曰：「禮開報仇之典，以申孝義之情；法斷相殺之條，以表權時之制。謙之揮刃斬冤，旣申私禮；繫頸就死，又明公法。今仍殺之，則成當世罪人；宥而活之，即爲盛朝孝子。殺一罪人，未足弘憲；活一孝子，實廣風德。張緒陸澄，是其鄉舊，應具來由。融等與謙之竝不相識，區區短見，深有恨然。」豫章王言之世祖，時吳郡太守王慈、太常張緒、尚書陸澄竝表論其事，世祖嘉其義，慮相復報，乃遣謙之隨曹虎西行。將發，幼方子惲於津陽門伺殺謙之，謙之之兄選之又刺殺惲，有司以聞。世祖曰：「此皆是義事，不可問。」悉赦之。吳興沈顗聞而歎曰：「弟死於孝，兄殉於義。孝友之節，萃此一門。」選之字處林，有志節，著辯相論。幼時顧歡見而異之，以女妻焉。官至江夏王參軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":115,"last_line":115,"raw_start":3751,"raw_end":4187,"raw_character_offsets":[3751,3752,3753,3754,3755,3756,3757,3758,3759,3760,3761,3762,3763,3764,3765,3766,3767,3768,3769,3770,3771,3772,3773,3774,3775,3776,3777,3778,3779,3780,3781,3782,3783,3784,3785,3786,3787,3788,3789,3790,3791,3792,3793,3794,3795,3796,3797,3798,3799,3800,3801,3802,3803,3804,3805,3806,3807,3808,3809,3810,3811,3812,3813,3814,3815,3816,3817,3818,3819,3820,3821,3822,3823,3824,3825,3826,3827,3828,3829,3830,3831,3832,3833,3834,3835,3836,3837,3838,3839,3840,3841,3842,3843,3844,3845,3846,3847,3848,3849,3850,3851,3852,3853,3854,3855,3856,3857,3858,3859,3860,3861,3862,3863,3864,3865,3866,3867,3868,3869,3870,3871,3872,3873,3874,3875,3876,3877,3878,3879,3880,3881,3882,3883,3884,3885,3886,3887,3888,3889,3890,3891,3892,3893,3894,3895,3896,3897,3898,3899,3900,3901,3902,3903,3904,3905,3906,3907,3908,3909,3910,3911,3912,3913,3914,3915,3916,3917,3918,3919,3920,3921,3922,3923,3924,3925,3926,3927,3928,3929,3930,3931,3932,3933,3934,3935,3936,3937,3938,3939,3940,3941,3942,3943,3944,3945,3946,3947,3