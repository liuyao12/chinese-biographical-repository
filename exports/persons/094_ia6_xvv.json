_required":false},"family_paths":[],"mentions":[{"id":"c-chenshu-014-wangyong:p001:m0024","surface":"戴智烈","start":24,"end":27,"person_id":"094_ia6_xvv","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-014-wangyong:p001","chapter_id":"c-chenshu-014-wangyong"},{"id":"c-chenshu-014-wangyong:p001:m0109","surface":"智烈","start":109,"end":111,"person_id":"094_ia6_xvv","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-014-wangyong:p001","chapter_id":"c-chenshu-014-wangyong"},{"id":"c-chenshu-014-wangyong:p001:m0112","surface":"智烈","start":112,"end":114,"person_id":"094_ia6_xvv","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-chenshu-014-wangyong:p001","chapter_id":"c-chenshu-014-wangyong"},{"id":"c-nanshi-024-wangmeng:p004:m0087","surface":"戴智烈","start":87,"end":90,"person_id":"094_ia6_xvv","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanshi-024-wangmeng:p004","chapter_id":"c-nanshi-024-wangmeng"}],"relations":[],"title_holdings":[{"id":"th-nanshi024-wangmeng-c1-20","person_id":"094_ia6_xvv","title":"高州刺史","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-wangmeng-c1-20:a","person_mention_id":"c-chenshu-014-wangyong:p001:m0024","usage":"narrative","date_expression":null,"paragraph_id":"c-chenshu-014-wangyong:p001","surface":"高州刺史","start":20,"end":24}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-014","source_id":"s-chenshu-014-wangyong-ws2262003","chapter_id":"c-chenshu-014-wangyong","paragraph_id":"c-chenshu-014-wangyong:p001","quote":"禎明三年，隋師濟江，〔東〕衡州刺史王勇遣高州刺史戴智烈將五百騎迎方慶，欲令承制總督征討諸軍事。是時隋行軍總管韋洸帥兵度嶺，宣隋文帝敕云：「若嶺南平定，留勇與豐州刺史鄭萬頃且依舊職。」方慶聞之，恐勇賣己，乃不從，率兵以拒智烈。智烈與戰，敗之，斬方慶於廣州，虜其妻子。","person_mention_id":"c-chenshu-014-wangyong:p001:m0024"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-nanshi024-wangmeng-m4-83","person_id":"094_ia6_xvv","title":"高州刺史","kind":"office","mode":"attestation","attestations":[{"id":"th-nanshi024-wangmeng-m4-83:a","person_mention_id":"c-nanshi-024-wangmeng:p004:m0087","usage":"narrative","date_expression":null,"paragraph_id":"c-nanshi-024-wangmeng:p004","surface":"高州刺史","start":83,"end":87}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-024","source_id":"s-nanshi-024-wangmeng-ws1765279","chapter_id":"c-nanshi-024-wangmeng","paragraph_id":"c-nanshi-024-wangmeng:p004","quote":"禎明二年，詔授鎭南大將軍、都督二十四州諸軍事，尋命徙鎭廣州。未之鎭，而隋師濟江，猛總督所部赴援。時廣州刺史臨汝侯方慶、西衡州刺史衡陽王伯信並隸猛督府，各觀望不至。猛使高州刺史戴智烈、清遠太守曾孝遠各以輕兵就斬之而發其兵。及聞台城不守，乃舉哀素服，藉稿不食，歎曰：「申包胥獨何人哉。」因勒兵緣江拒守，以固誠節。及審後主不死，乃遣其部將辛昉馳驛赴京師歸款。隋文帝大悅，謂昉曰：「猛懷其舊主，送故情深，即是我之誠臣。保守一方，不勞兵甲，又是我之功臣。」即日拜昉開府儀同三司，仍詔猛與行軍總管韋洸便留嶺表經略。","person_mention_id":"c-nanshi-024-wangmeng:p004:m0087"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-014-wangyong:p001","text":"禎明三年，隋師濟江，〔東〕衡州刺史王勇遣高州刺史戴智烈將五百騎迎方慶，欲令承制總督征討諸軍事。是時隋行軍總管韋洸帥兵度嶺，宣隋文帝敕云：「若嶺南平定，留勇與豐州刺史鄭萬頃且依舊職。」方慶聞之，恐勇賣己，乃不從，率兵以拒智烈。智烈與戰，敗之，斬方慶於廣州，虜其妻子。","mentions":[{"id":"c-chenshu-014-wangyong:p001:m0017","surface":"王勇","start":17,"end":19,"person_id":"72e_1a7_3ac_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-chenshu-014-wangyong:p001:m0024","surface":"戴智烈","start":24,"end":27,"person_id"