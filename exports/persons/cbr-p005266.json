{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005266","identity_policy":"contextual_provisional","person_ids":["cbr-p005266"],"persons":[{"id":"cbr-p005266","label":"侯家舍人未名（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"侯家舍人","mention_ids":["c-shiji-095-fankuang:m010-0125"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m010-0125","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p010","quote":"侯家舍人"}]}],"mentions":[{"id":"c-shiji-095-fankuang:m010-0125","start":125,"end":129,"surface":"侯家舍人","kind":"person","person_id":"cbr-p005266","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p010","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-016","person_id":"cbr-p005266","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["侯家舍人"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p010","quote":"孝惠六年，樊噲卒，謚為武侯。子伉代侯。而伉母呂須亦為臨光侯，高后時用事專權，大臣盡畏之。伉代侯九歲，高后崩。大臣誅諸呂、呂須婘屬，因誅伉。舞陽侯中絕數月。孝文帝既立，乃復封噲他庶子市人為舞陽侯，復故爵邑。市人立二十九歲卒，謚為荒侯。子他廣代侯。六歲，侯家舍人得罪他廣，怨之，乃上書曰：「荒侯市人病不能為人，令其夫人與其弟亂而生他廣，他廣實非荒侯子，不當代後。」詔下吏。孝景中六年，他廣奪侯為庶人，國除。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p010","text":"孝惠六年，樊噲卒，謚為武侯。子伉代侯。而伉母呂須亦為臨光侯，高后時用事專權，大臣盡畏之。伉代侯九歲，高后崩。大臣誅諸呂、呂須婘屬，因誅伉。舞陽侯中絕數月。孝文帝既立，乃復封噲他庶子市人為舞陽侯，復故爵邑。市人立二十九歲卒，謚為荒侯。子他廣代侯。六歲，侯家舍人得罪他廣，怨之，乃上書曰：「荒侯市人病不能為人，令其夫人與其弟亂而生他廣，他廣實非荒侯子，不當代後。」詔下吏。孝景中六年，他廣奪侯為庶人，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m010-0000","start":0,"end":2,"surface":"孝惠","kind":"person","person_id":"cbr-p005290","status":"contextual_provis