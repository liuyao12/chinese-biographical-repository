{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005401","canonical_person_id":"srh_4ts_334","id_aliases":["cbr-p005401"],"identity_policy":"contextual_provisional","person_ids":["srh_4ts_334"],"persons":[{"id":"srh_4ts_334","label":"漢惠帝（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孝惠","mention_ids":["c-shiji-096-zhang:m016-0037"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m016-0037","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p016","quote":"孝惠"}],"id_aliases":["cbr-p005401"]}],"source_mention_summary":[{"source_id":"s-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","chapter_id":"c-shiji-096-zhang","mention_count":1,"mention_ids":["c-shiji-096-zhang:m016-0037"],"paragraph_ids":["c-shiji-096-zhang:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-096-zhang:m016-0037","start":37,"end":39,"surface":"孝惠","kind":"person","person_id":"srh_4ts_334","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p016","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-043","person_id":"srh_4ts_334","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["孝惠"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p016","quote":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p016","text":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m016-0000","start":0,"end":5,"surface":"申屠丞相嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0016","start":16,"end":18,"surface":"高帝","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0019","start":19,"end":21,"surface":"項籍","kind":"person","person_id":"jej_8s3_01z","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0029","start":29,"end":31,"surface":"黥布","kind":"person","person_id":"e4c_pkg_cq7","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0037","start":37,"end":39,"surface":"孝惠","kind":"person","person_id":"srh_4ts_334","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0046","start":46,"end":49,"surface":"孝文帝","kind":"person","person_id":"gum_f2l_s4k","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0060","start":60,"end":63,"surface":"高皇帝","kind":"person","person_id":"h8q_zyo_i2l","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0080","start":80,"end":83,"surface":"申屠嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0089","start":89,"end":91,"surface":"張蒼","kind":"person","pe