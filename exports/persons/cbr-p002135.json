":175,"end":178,"surface":"公子嬰","kind":"person","person_id":"cbr-p002135","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m012-0186","start":186,"end":188,"surface":"鄭子","kind":"person","person_id":"cbr-p002135","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m012-0192","start":192,"end":195,"surface":"齊襄公","kind":"person","person_id":"cbr-p002134","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m012-0196","start":196,"end":198,"surface":"彭生","kind":"person","person_id":"cbr-p002136","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m012-0201","start":201,"end":204,"surface":"魯桓公","kind":"person","person_id":"cbr-p002137","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p013","text":"鄭子八年，齊人管至父等作亂，弒其君襄公。十二年，宋人長萬弒其君湣公。鄭祭仲死。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m013-0000","start":0,"end":2,"surface":"鄭子","kind":"person","person_id":"cbr-p002135","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m013-0007","start":7,"end":10,"surface":"管至父","kind":"person","person_id":"cbr-p002138","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m013-0017","start":17,"end":19,"surface":"襄公","kind":"person","person_id":"cbr-p002134","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m013-0026","start":26,"end":28,"surface":"長萬","kind":"person","person_id":"cbr-p002139","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m013-0031","start":31,"end":33,"surface":"湣公","kind":"person","person_id":"cbr-p002140","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m013-0034","start":34,"end":37,"surface":"鄭祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p014","text":"十四年，故鄭亡厲公突在櫟者使人誘劫鄭大夫甫假，要以求入。假曰：「捨我，我爲君殺鄭子而入君。」厲公與盟，乃捨之。六月甲子，假殺鄭子及其二子而迎厲公突，突自櫟復入卽位。初，内蛇與外蛇鬬於鄭南門中，内蛇死。居六年，厲公果復入。入而讓其伯父原曰：「我亡國外居，伯父無意入我，亦甚矣。」原曰：「事君無二心，人臣之職也。原知罪矣。」遂自殺。厲公於是謂甫假曰：「子之事君有二心矣。」遂誅之。假曰：「重德不報，誠然哉！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m014-0007","start":7,"end":10,"surface":"厲公突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0017","start":17,"end":22,"surface":"鄭大夫甫假","kind":"person","person_id":"cbr-p002141","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0028","start":28,"end":29,"surface":"假","kind":"person","person_id":"cbr-p002141","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0039","start":39,"end":41,"surface":"鄭子","kind":"person","person_id":"cbr-p002135","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0046","start":46,"end":48,"surface":"厲公","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0060","start":60,"end":61,"surface":"假","kind":"person","person_id":"cbr-p002141","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0062","start":62,"end":64,"surface":"鄭子","kind":"person","person_id":"cbr-p002135","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0065","start":65,"end":68,"surface":"其二子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m014-0070","start":70,"end":73,"surface":"厲公突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0074","start":74,"end":75,"surface":"突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m014-0104","start":104,"end":106,"surface":"厲公","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zh