:[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-chenban-literal","person_id":"0o6_6rp_1m1","surname":"陳","ming":"頒","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p011","person_mention_id":"c-jinshu-098-wangdun-comparison:p011:m0166","source_anchor":{"start":166,"end":168,"surface":"陳頒"},"quote":"初，敦務自矯厲，雅尚清談，口不言財色。既素有重名，又立大功于江左，專任閫外，手控強兵，群從貴顯，威權莫貳，遂欲專制朝廷，有問鼎之心。帝畏而惡之，遂引劉隗、刁協等以為心膂。敦益不能平，於是嫌隙始構矣。每酒後輒詠魏武帝樂府歌曰：「老驥伏櫪，志在千里。烈士暮年，壯心不已。」以如意打唾壺為節，壺邊盡缺。及湘州刺史甘卓遷梁州，敦欲以從事中郎陳頒代卓，帝不從，更以譙王承鎮湘州。敦復上表陳古今忠臣見疑于君，而蒼蠅之人交構其間，欲以感動天子。帝愈忌憚之。俄加敦羽葆鼓吹，增從事中郎、掾屬、舍人各二人。帝以劉隗為鎮北將軍，戴若思為征西將軍，悉發揚州奴為兵，外以討胡，實禦敦也。永昌元年，敦率眾內向，以誅隗為名，上疏曰：","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p011:m0166","start":166,"end":168,"surface":"陳頒","person_id":"0o6_6rp_1m1","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p011","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p011","text":"初，敦務自矯厲，雅尚清談，口不言財色。既素有重名，又立大功于江左，專任閫外，手控強兵，群從貴顯，威權莫貳，遂欲專制朝廷，有問鼎之心。帝畏而惡之，遂引劉隗、刁協等以為心膂。敦益不能平，於是嫌隙始構矣。每酒後輒詠魏武帝樂府歌曰：「老驥伏櫪，志在千里。烈士暮年，壯心不已。」以如意打唾壺為節，壺邊盡缺。及湘州刺史甘卓遷梁州，敦欲以從事中郎陳頒代卓，帝不從，更以譙王承鎮湘州。敦復上表陳古今忠臣見疑于君，而蒼蠅之人交構其間，欲以感動天子。帝愈忌憚之。俄加敦羽葆鼓吹，增從事中郎、掾屬、舍人各二人。帝以劉隗為鎮北將軍，戴若思為征西將軍，悉發揚州奴為兵，外以討胡，實禦敦也。永昌元年，敦率眾內向，以誅隗為名，上疏曰：","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":31,"last_line":