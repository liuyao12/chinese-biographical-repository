戊辰，崇拜帝所生陳昭華為皇太妃。庚午，司空長史謝朏、衞軍長史江斅、中書侍郎褚炫、武陵王文學劉候入直殿省，參侍文義。齊王固讓司空，庚辰，以為驃騎大將軍、開府儀同三司。","text_layer":"received_chapter","read_scope":"完整昇明元年八月原段，明同四人入直殿省；其中劉候與主文劉俁異字不校。","image_verified":false,"human_reviewed":false}]}],"equivalence_decisions":[],"sources":[{"chapter_id":"c-liangshu-015-xiefei","work_id":"w-liangshu","book_id":"b-liangshu-015","source_id":"s-liangshu015-ws1506954","source_ref":"corpus/liangshu/015-xiefei.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"passage_refs":[{"chapter":"corpus/liangshu/015-xiefei.json","id":"c-liangshu-015-xiefei:p003"}]}
