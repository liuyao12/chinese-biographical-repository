_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-057-yufan"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0119","start":119,"end":121,"surface":"阚泽","kind":"person","person_id":"r2b_2xl_58l","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-057-yufan:line029-pei01-01","chapter_id":"c-sanguozhi-057-yufan"},{"id":"c-sanguozhi-057-yufan:line031-pei01-01:m1327","start":1327,"end":1329,"surface":"阚泽","kind":"person","person_id":"r2b_2xl_58l","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-057-yufan:line031-pei01-01","chapter_id":"c-sanguozhi-057-yufan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-057-yufan:line029-pei01-01","text":"《会稽典录》曰：◎览字孝连，八岁而孤，家又单微，清身立行，用意不苟，推财从弟，以义让称。仕郡至功曹，守始平长。为人精微絜净，门无杂宾。孙权深贵待之，未及擢用，会病卒，甚见痛惜，殊其门户。览子固，字子贱，本名密，避滕密，改作固。固在襁褓中，阚泽见而异之，曰：“此兒后必致公辅。”固少丧父，独与母居，家贫守约，色养致敬，族弟孤弱，与同寒温。翻与固同僚书曰：“丁子贱塞渊好德，堂构克举，野无遗薪，斯之为懿，其美优矣。令德之后，惟此君嘉耳。”历显位，孙休时固为左御史大夫，孙皓即位，迁司徒。皓悖虐，固与陆凯、孟宗同心忧国，年七十六卒。子弥，字钦远，仕晋，至梁州刺史。孙潭，光禄大夫。◎徐陵字元大，历三县长，所在著称，迁零陵太守。时朝廷俟以列卿之位，故翻书曰：“元大受上卿之遇，叔向在晋，未若於今。”其见重如此。陵卒，僮客土田或见侵夺，骆统为陵家讼之，求与丁览、卜清等为比，权许焉。陵子平，字伯先，童龀知名，翻甚爱之，屡称叹焉。诸葛恪为丹杨太守，讨山越，以平威重思虑，可与效力，请平为丞，稍迁武昌左部督，倾心接物，士卒皆为尽力。初，平为恪从事，意甚薄，及恪辅政，待平益疏。恪被害，子建亡走，为平部曲所得，平使遣去，别为佗军所获。平两妇归宗，敬奉情过乎厚。其行义敦笃，皆此类也。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0009","start":9,"end":10,"surface":"览","kind":"person","person_id":"592_gk9_2zw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0011","start":11,"end":13,"surface":"孝连","kind":"person","person_id":"592_gk9_2zw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0067","start":67,"end":69,"surface":"孙权","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0093","start":93,"end":94,"surface":"览","kind":"person","person_id":"592_gk9_2zw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0095","start":95,"end":96,"surface":"固","kind":"person","person_id":"uxk_94s_ndu","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0098","start":98,"end":100,"surface":"子贱","kind":"person","person_id":"uxk_94s_ndu","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0103","surface":"密","start":103,"end":104,"kind":"person","person_id":"uxk_94s_ndu","status":"contextual_provisional","interpretation_note":"按本段具名及前後親稱、官職定位。"},{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0106","start":106,"end":108,"surface":"滕密","kind":"person","person_id":"edq_wkv_8v7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-057-yufan:line029-pei01-01:m0111","start":111,"end":112,"surface":"固","kind":"person","person_id":"uxk_94s_ndu","status":"conte