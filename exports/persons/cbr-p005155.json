relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-005","person_id":"ne5_ers_49u","surfaces":["項梁"],"scope":"same_chapter","chapter_ids":["c-shiji-093-hanlu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-093-hanlu:p001","quote":"韓王信者，故韓襄王孽孫也，長八尺五寸。及項梁之立楚後懷王也，燕、齊、趙、魏皆已前王，唯韓無有後，故立韓諸公子橫陽君成為韓王，欲以撫定韓故地。項梁敗死定陶，成奔懷王。沛公引兵擊陽城，使張良以韓司徒降下韓故地，得信，以為韓將，將其兵從沛公入武關。"}],"rationale":"按韓王信開篇姓名及局部王序兵事承接；成昌與信分人，不按同名合併淮陰侯韓信。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-093-hanlu:p001","text":"韓王信者，故韓襄王孽孫也，長八尺五寸。及項梁之立楚後懷王也，燕、齊、趙、魏皆已前王，唯韓無有後，故立韓諸公子橫陽君成為韓王，欲以撫定韓故地。項梁敗死定陶，成奔懷王。沛公引兵擊陽城，使張良以韓司徒降下韓故地，得信，以為韓將，將其兵從沛公入武關。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-093-hanlu:m001-0000","start":0,"end":3,"surface":"韓王信","kind":"person","person_id":"xnj_cjk_pcj_*A","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0006","start":6,"end":9,"surface":"韓襄王","kind":"person","person_id":"xnj_cjk_pcj","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0020","start":20,"end":22,"surface":"項梁","kind":"person","person_id":"ne5_ers_49u","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0026","start":26,"end":28,"surface":"懷王","kind":"person","person_id":"ncc_ycr_r40","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0054","start":54,"end":58,"surface":"橫陽君成","kind":"person","person_id":"c1o_5sb_6my","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0070","start":70,"end":72,"surface":"項梁","kind":"person","person_id":"ne5_ers_49u","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0077","start":77,"end":78,"surface":"成","kind":"person","person_id":"c1o_5sb_6my","status":"contextual_provisional"},{"id":"c-shiji-093-hanlu:m001-0079","start":79,"end":81,"surface":"懷王