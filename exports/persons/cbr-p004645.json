{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004645","identity_policy":"contextual_provisional","person_ids":["cbr-p004645"],"persons":[{"id":"cbr-p004645","label":"即墨大夫未名（田單列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"即墨大夫","mention_ids":["c-shiji-082-tiandan:m001-0181"]}],"evidence":[{"mention_id":"c-shiji-082-tiandan:m001-0181","chapter_id":"c-shiji-082-tiandan","paragraph_id":"c-shiji-082-tiandan:p001","quote":"即墨大夫"}]}],"mentions":[{"id":"c-shiji-082-tiandan:m001-0181","start":181,"end":185,"surface":"即墨大夫","kind":"person","person_id":"cbr-p004645","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p001","chapter_id":"c-shiji-082-tiandan"}],"relations":[],"title_holdings":[{"id":"th-shiji082-002","person_id":"cbr-p004645","title":"即墨大夫","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-082-tiandan","source_id":"s-shiji-082-tiandan","paragraph_id":"c-shiji-082-tiandan:p001","quote":"田單者，齊諸田疏屬也。湣王時，單為臨菑市掾，不見知。及燕使樂毅伐破齊，齊湣王出奔，已而保莒城。燕師長驅平齊，而田單走安平，令其宗人盡斷其車軸末而傅鐵籠。已而燕軍攻安平，城壞，齊人走，爭涂，以轊折車敗，為燕所虜，唯田單宗人以鐵籠故得脫，東保即墨。燕既盡降齊城，唯獨莒、即墨不下。燕軍聞齊王在莒，并兵攻之。淖齒既殺湣王於莒，因堅守，距燕軍，數年不下。燕引兵東圍即墨，即墨大夫出與戰，敗死。城中相與推田單，曰：「安平之戰，田單宗人以鐵籠得全，習兵。」立以為將軍，以即墨距燕。"}],"attestations":[{"id":"th-shiji082-002:a001","paragraph_id":"c-shiji-082-tiandan:p001","start":181,"end":185,"surface":"即墨大夫","person_mention_id":"c-shiji-082-tiandan:m001-0181","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱與授任分存，未知起訖保持未定；即墨大夫敗死不自動終止所有爵位，王蠋誘授將及封萬家固謝不當實授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji082-006","person_id":"cbr-p004645","surfaces":["即墨大夫"],"scope":"same_chapter","chapter_ids":["c-shiji-082-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-082-tiandan:p001","quote":"田單者，齊諸田疏屬也。湣王時，單為臨菑市掾，不見知。及燕使樂毅伐破齊，齊湣王出奔，已而保莒城。燕師長驅平齊，而田單走安平，令其宗人盡斷其車軸末而傅鐵籠。已而燕軍攻安平，城壞，齊人走，爭涂，以轊折車敗，為燕所虜，唯田單宗人以鐵籠故得脫，東保即墨。燕既盡降齊城，唯獨莒、即墨不下。燕軍聞齊王在莒，并兵攻之。淖齒既殺湣王於莒，因堅守，距燕軍，數年不下。燕引兵東圍即墨，即墨大夫出與戰，敗死。城中相與推田單，曰：「安平之戰，田單宗人以鐵籠得全，習兵。」立以為將軍，以即墨距燕。"}],"rationale":"依9段明示姓名、君序與復齊事件暫接；法章立齊王與襄王迎莒、末段立襄王依同一復國敘事接。嬓女太史氏女君王后按明示，嬓與女先處完整稱謂。假神師是未名卒、臣其自稱，君指田單；燕將未名不盲接騎劫，宗族不補父母。誘王蠋授將被固謝，不當實授。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-082-tiandan:p001","text":"田單者，齊諸田疏屬也。湣王時，單為臨菑市掾，不見知。及燕使樂毅伐破齊，齊湣王出奔，已而保莒城。燕師長驅平齊，而田單走安平，令其宗人盡斷其車軸末而傅鐵籠。已而燕軍攻安平，城壞，齊人走，爭涂，以轊折車敗，為燕所虜，唯田單宗人以鐵籠故得脫，東保即墨。燕既盡降齊城，唯獨莒、即墨不下。燕軍聞齊王在莒，并兵攻之。淖齒既殺湣王於莒，因堅守，距燕軍，數年不下。燕引兵東圍即墨，即墨大夫出與戰，敗死。城中相與推田單，曰：「安平之戰，田單宗人以鐵籠得全，習兵。」立以為將軍，以即墨距燕。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-082-tiandan:m001-0000","start":0,"end":2,"surface":"田單","kind":"person","person_id":"cbr-p004641","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0004","start":4,"end":9,"surface":"齊諸田疏屬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存；神為策略敘事，不補具名神祇或宗族親屬。"},{"id":"c-shiji-082-tiandan:m001-0011","start":11,"end":13,"surface":"湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0015","start":15,"end":16,"surface":"單","kind":"person","person_id":"cbr-p004641","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0029","start":29,"end":31,"surface":"樂毅","kind":"person","person_id":"cbr-p004643","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0035","start":35,"end":38,"surface":"齊湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0055","start":55,"end":57,"surface":"田單","kind":"person","person_id":"cbr-p004641","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0063","start":63,"end":65,"surface":"宗人","ki