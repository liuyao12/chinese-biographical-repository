n","person_id":"cbr-p002115","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m004-0110","start":110,"end":111,"surface":"段","kind":"person","person_id":"cbr-p002115","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m004-0117","start":117,"end":119,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m004-0122","start":122,"end":124,"surface":"武姜","kind":"person","person_id":"cbr-p002113","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m004-0153","start":153,"end":158,"surface":"潁谷之考叔","kind":"person","person_id":"cbr-p002117","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m004-0167","start":167,"end":169,"surface":"考叔","kind":"person","person_id":"cbr-p002117","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m004-0172","start":172,"end":175,"surface":"臣有母","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m004-0180","start":180,"end":182,"surface":"臣母","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m004-0184","start":184,"end":186,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m004-0202","start":202,"end":204,"surface":"考叔","kind":"person","person_id":"cbr-p002117","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p005","text":"二十四年，宋繆公卒，公子馮奔鄭。鄭侵周地，取禾。二十五年，衞州吁弒其君桓公自立，與宋伐鄭，以馮故也。二十七年，始朝周桓王。桓王怒其取禾，弗禮也。二十九年，莊公怒周弗禮，與魯易祊、許田。三十三年，宋殺孔父。三十七年，莊公不朝周，周桓王率陳、蔡、虢、衞伐鄭。莊公與祭仲、髙渠彌發兵自救，王師大敗。祝聸射中王臂。祝聸請從之，鄭伯止之，曰：「犯長且難之，況敢陵天子乎？」乃止。夜令祭仲問王疾。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m005-0005","start":5,"end":8,"surface":"宋繆公","kind":"person","person_id":"cbr-p002118","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0010","start":10,"end":13,"surface":"公子馮","kind":"person","person_id":"cbr-p002119","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0029","start":29,"end":32,"surface":"衞州吁","kind":"person","person_id":"cbr-p002120","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0033","start":33,"end":37,"surface":"其君桓公","kind":"person","person_id":"cbr-p002121","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0046","start":46,"end":47,"surface":"馮","kind":"person","person_id":"cbr-p002119","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0057","start":57,"end":60,"surface":"周桓王","kind":"person","person_id":"cbr-p002122","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0061","start":61,"end":63,"surface":"桓王","kind":"person","person_id":"cbr-p002122","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0077","start":77,"end":79,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0099","start":99,"end":101,"surface":"孔父","kind":"person","person_id":"cbr-p002123","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0107","start":107,"end":109,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0113","start":113,"end":116,"surface":"周桓王","kind":"person","person_id":"cbr-p002122","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0127","start":127,"end":129,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0130","start":130,"end":132,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0133","start":133,"end":136,"surface":"髙渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0146","start":146,"end":148,"surface":"祝聸","kind":"person","person_id":"cbr-p002125","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0153","start":153,"end":155,"surface":"祝聸","kind":"person","person_id":"cbr-p002125","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0159","start":159,"end":161,"surface":"鄭伯","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m005-0186","start":186,"end":188,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p007","text":"四十三年，鄭莊公卒。初，祭仲甚有寵於莊公，莊公使爲卿；公使娶鄧女，生太子忽，故祭仲立之，是爲昭公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m007-0005","start":5,"end":8,"surface":"鄭莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m007-0012","start":12,"end":14,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m007-0018","start":18,"end":20,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m007-0021","start":21,"end":23,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m007-0030","start":30,"end":32,"surface":"鄧女","kind":"person","person_id":"cbr-p002130","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m007-0034","start":34,"end":37,"surface":"太子忽","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m007-0039","start":39,"end":41,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m007-0046","start":46,"end":48,"surface":"昭公","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p008","text":"莊公又娶宋雍氏女，生厲公突。雍氏有寵於宋。宋莊公聞祭仲之立忽，乃使人誘召祭仲而執之，曰：「不立突，將死。」亦執突以求賂焉。祭仲許宋，與宋盟。以突歸，立之。昭公忽聞祭仲以宋要立其弟突，九月（辛）［丁］亥，忽出奔衞。己亥，突至鄭，立，是爲厲公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m008-0000","start":0,"end":2,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0004","start":4,"end":8,"surface":"宋雍氏女","kind":"person","person_id":"cbr-p002131","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0010","start":10,"end":13,"surface":"厲公突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0014","start":14,"end":16,"surface":"雍氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名、群體、泛稱或指代待核；不補姓名、成員或親屬關係。"},{"id":"c-shiji-042-zheng:m008-0022","start":22,"end":24,"surface":"莊公","kind":"person","person_id":"cbr-p002148","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0025","start":25,"end":27,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0029","start":29,"end":30,"surface":"忽","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0036","start":36,"end":38,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0047","start":47,"end":48,"surface":"突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0055","start":55,"end":56,"surface":"突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0061","start":61,"end":63,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0071","start":71,"end":72,"surface":"突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0077","start":77,"end":80,"surface":"昭公忽","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0081","start":81,"end":83,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0089","start":89,"end":90,"surface":"突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0101","start":101,"end":102,"surface":"忽","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0109","start":109,"end":110,"surface":"突","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m008-0117","start":117,"end":119,"surface":"厲公","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p011","text":"昭公二年，自昭公爲太子時，父莊公欲以髙渠彌爲卿，太子忽惡之，莊公弗聽，卒用渠彌爲卿。及昭公卽位，懼其殺己，冬十月辛卯，渠彌與昭公出獵，射殺昭公於野。祭仲與渠彌不敢入厲公，乃更立昭公弟子亹爲君，是爲子亹也，無謚號。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-042-zheng:m011-0000","start":0,"end":2,"surface":"昭公","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0006","start":6,"end":8,"surface":"昭公","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0014","start":14,"end":16,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0018","start":18,"end":21,"surface":"髙渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0024","start":24,"end":27,"surface":"太子忽","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0030","start":30,"end":32,"surface":"莊公","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0037","start":37,"end":39,"surface":"渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0043","start":43,"end":45,"surface":"昭公","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0059","start":59,"end":61,"surface":"渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0062","start":62,"end":64,"surface":"昭公","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0069","start":69,"end":71,"surface":"昭公","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0074","start":74,"end":76,"surface":"祭仲","kind":"person","person_id":"cbr-p002116","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0077","start":77,"end":79,"surface":"渠彌","kind":"person","person_id":"cbr-p002124","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0082","start":82,"end":84,"surface":"厲公","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0088","start":88,"end":90,"surface":"昭公","kind":"person","person_id":"cbr-p002126","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0091","start":91,"end":93,"surface":"子亹","kind":"person","person_id":"cbr-p002129","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m011-0098","start":98,"end":100,"surface":"子亹","kind":"person","person_id":"cbr-p002129","status":"contextual_provisional"}],"chapter_id":"c-shiji-042-zheng","book_id":"b-shiji-042","work_id":"w-shiji","source_id":"s-shiji-042-zheng"},{"id":"c-shiji-042-zheng:p060","text":"厲王之子，得封於鄭。代職司徒，緇衣在詠。虢、鄶獻邑，祭祝專命。莊既犯王，厲亦奔命。居櫟克入，夢蘭毓慶。伯服生囚，叔瞻屍聘。釐、簡之後，公室不競。負黍雖還，韓哀日盛。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-042-zheng:m060-0000","start":0,"end":2,"surface":"厲王","kind":"person","person_id":"cbr-p002096","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m060-0026","start":26,"end":28,"surface":"祭祝","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、述贊省稱、譬喻或未定指代保留，不補姓名或關係。"},{"id":"c-shiji-042-zheng:m060-0031","start":31,"end":32,"surface":"莊","kind":"person","person_id":"cbr-p002114","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m060-0033","start":33,"end":35,"surface":"犯王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、述贊省稱、譬喻或未定指代保留，不補姓名或關係。"},{"id":"c-shiji-042-zheng:m060-0036","start":36,"end":37,"surface":"厲","kind":"person","person_id":"cbr-p002128","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m060-0046","start":46,"end":48,"surface":"夢蘭","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、述贊省稱、譬喻或未定指代保留，不補姓名或關係。"},{"id":"c-shiji-042-zheng:m060-0051","start":51,"end":53,"surface":"伯服","kind":"person","person_id":"cbr-p002154","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m060-0056","start":56,"end":58,"surface":"叔瞻","kind":"person","person_id":"cbr-p002152","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m060-0061","start":61,"end":62,"surface":"釐","kind":"person","person_id":"cbr-p002185","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m060-0063","start":63,"end":64,"surface":"簡","kind":"person","person_id":"cbr-p002187","status":"contextual_provisional"},{"id":"c-shiji-042-zheng:m060-0077","start":77,"end":79,"surface":"韓哀","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、述贊省稱、譬喻或未