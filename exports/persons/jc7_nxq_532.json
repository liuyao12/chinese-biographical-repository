tated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji052-012","person_id":"jc7_nxq_532","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-052-qidaohui","source_id":"s-shiji-052-qidaohui","paragraph_id":"c-shiji-052-qidaohui:p026","quote":"齊初圍急，陰與三國通謀，約未定，會聞路中大夫從漢來，喜，及其大臣乃復勸王毋下三國。居無何，漢將欒布、平陽侯等兵至齊，擊破三國兵，解齊圍。已而復聞齊初與三國有謀，將欲移兵伐齊。齊孝王懼，乃飲藥自殺。景帝聞之，以為齊首善，以迫劫有謀，非其罪也，乃立孝王太子壽為齊王，是為懿王，續齊後。而膠西、膠東、濟南、菑川王咸誅滅，地入于漢。徙濟北王王菑川。齊懿王立二十二年卒，子次景立，是為厲王。","person_mention_id":"c-shiji-052-qidaohui:m026-0087"}],"source_term":"齊孝王懼，乃飲藥自殺","interpretation_note":"本篇明示死亡，回述合併並保留各段證據；原相對年數不借別人紀年，年齡不倒推生年，擊破與擬誅不直接推死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-052-qidaohui:m024-0019","start":19,"end":24,"surface":"齊孝王將閭","kind":"person","person_id":"jc7_nxq_532","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p024","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m025-0000","start":0,"end":3,"surface":"齊孝王","kind":"person","person_id":"jc7_nxq_532","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p025","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m025-0061","start":61,"end":64,"surface":"齊孝王","kind":"person","person_id":"jc7_nxq_532","status":"contextual_provisional","paragraph_id":"c-shiji-052-qidaohui:p025","chapter_id":"c-shiji-052-qidaohui"},{"id":"c-shiji-052-qidaohui:m025-0079","start":79,"end":81,"surface":"齊王","kind":"person","person_id":"jc7_nxq_532","status":"contextual_provisional","paragraph_id":"c-shiji-052-