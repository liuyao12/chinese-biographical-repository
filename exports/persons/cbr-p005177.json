{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005177","identity_policy":"contextual_provisional","person_ids":["cbr-p005177"],"persons":[{"id":"cbr-p005177","label":"陳平（韓信盧綰列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳平","mention_ids":["c-shiji-093-hanlu:m005-0256"]}],"evidence":[{"mention_id":"c-shiji-093-hanlu:m005-0256","chapter_id":"c-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p005","quote":"陳平"}]}],"mentions":[{"id":"c-shiji-093-hanlu:m005-0256","start":256,"end":258,"surface":"陳平","kind":"person","person_id":"cbr-p005177","status":"contextual_provisional","paragraph_id":"c-shiji-093-hanlu:p005","chapter_id":"c-shiji-093-hanlu"}],"relations":[],"title_holdings":[{"id":"th-shiji093-010","person_id":"cbr-p005177","title":"護軍中尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p005","quote":"七年冬，上自往擊，破信軍銅鞮，斬其將王喜。信亡走匈奴。（與）其與白土人曼丘臣、王黃等立趙苗裔趙利為王，復收信敗散兵，而與信及冒頓謀攻漢。匈奴仗左右賢王將萬餘騎與王黃等屯廣武以南，至晉陽，與漢兵戰，漢大破之，追至于離石，復破之。匈奴復聚兵樓煩西北，漢令車騎擊破匈奴。匈奴常敗走，漢乘勝追北，聞冒頓居代（上）谷，高皇帝居晉陽，使人視冒頓，還報曰「可擊」。上遂至平城。上出白登，匈奴騎圍上，上乃使人厚遺閼氏。閼氏乃說冒頓曰：「今得漢地，猶不能居；且兩主不相緱」居七日，胡騎稍引去。時天大霧，漢使人往來，胡不覺。護軍中尉陳平言上曰：「胡者全兵，請令彊弩傅兩矢外向，徐行出圍。」入平城，漢救兵亦到，胡騎遂解去。漢亦罷兵歸。韓信為匈奴將兵往來擊邊。"}],"attestations":[{"id":"th-shiji093-010:a001","paragraph_id":"c-shiji-093-hanlu:p005","start":252,"end":256,"surface":"護軍中尉","person_mention_id":"c-shiji-093-hanlu:m005-0256","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按實授、自立與用稱保存；許韓王在先不作已授。明示相對年月保持原文，死亡、降漢、失侯之後裔敘事不替本人任期補終點。虜綰原字保留，以本段盧綰主語承接授爵，未核底本影像。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji093-027","person_id":"cbr-p005177","scope":"same_chapter",