ke:m025-0043","c-shiji-086-cike:m033-0030","c-shiji-086-cike:m036-0031","c-shiji-086-cike:m036-0123","c-shiji-086-cike:m036-0213","c-shiji-086-cike:m036-0252","c-shiji-086-cike:m036-0281"],"paragraph_ids":["c-shiji-086-cike:p025","c-shiji-086-cike:p033","c-shiji-086-cike:p036"],"passage_count":3}],"most_mentioned_source_ids":["s-shiji-086-cike"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m025-0016","start":16,"end":19,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p025","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m025-0030","start":30,"end":33,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p025","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m025-0043","start":43,"end":46,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p025","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m033-0030","start":30,"end":33,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p033","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m036-0031","start":31,"end":34,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p036","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m036-0123","start":123,"end":126,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p036","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m036-0213","start":213,"end":216,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p036","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m036-0252","start":252,"end":255,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p036","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m036-0281","start":281,"end":284,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p036","chapter_id":"c-shiji-086-cike"}],"relations":[],"title_holdings":[{"id":"th-shiji086-018","person_id":"cbr-p004847","title":"上客","kind":"unclassified","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p036","quote":"其明年，秦并天下，立號爲皇帝。於是秦逐太子丹、荊軻之客，皆亡。髙漸離變名姓爲人庸保，匿作於宋子。久之，作苦，聞其家堂上客撃筑，傍偟不能去。毎出言曰：「彼有善有不善。」從者以告其主，曰：「彼庸乃知音，竊言是非。」家丈人召使前撃筑，一坐稱善，賜酒。而髙漸離念久隱畏約無窮時，乃退，出其裝匣中筑與其善衣，更容貌而前。舉坐客皆驚，下與抗禮，以爲上客。使撃筑而歌，客無不流涕而去者。宋子傳客之，聞於秦始皇。秦始皇召見，人有識者，乃曰：「髙漸離也。」秦皇帝惜其善撃筑，重赦之，乃矐其目。使撃筑，未嘗不稱善。稍益近之，髙漸離乃以鉛置筑中，復進得近，舉筑樸秦皇帝，不中。於是遂誅髙漸離，終身不復近諸侯之人。"}],"attestations":[{"id":"th-shiji086-018:a001","paragraph_id":"c-shiji-086-cike:p036","start":168,"end":170,"surface":"上客","person_mention_id":"c-shiji-086-cike:m036-0123","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p036","quote":"其明年，秦并天下，立號爲皇帝。於是秦逐太子丹、荊軻之客，皆亡。髙漸離變名姓爲人庸保，匿作於宋子。久之，作苦，聞其家堂上客撃筑，傍偟不能去。毎出言曰：「彼有善有不善。」從者以告其主，曰：「彼庸乃知音，竊言是非。」家丈人召使前撃筑，一坐稱善，賜酒。而髙漸離念久隱畏約無窮時，乃退，出其裝匣中筑與其善衣，更容貌而前。舉坐客皆驚，下與抗禮，以爲上客。使撃筑而歌，客無不流涕而去者。宋子傳客之，聞於秦始皇。秦始皇召見，人有識者，乃曰：「髙漸離也。」秦皇帝惜其善撃筑，重赦之，乃矐其目。使撃筑，未嘗不稱善。稍益近之，髙漸離乃以鉛置筑中，復進得近，舉筑樸秦皇帝，不中。於是遂誅髙漸離，終身不復近諸侯之人。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任與文獻用稱分存；四月丙子依本段事件，不換算絕對年。皇帝其明年保留相對日期；上客為禮遇。懸賞金邑、職稱首見、死亡、被虜或亡逃不推定任期起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-036","person_id":"cbr-p004847","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依荊軻入燕敘事及明示異稱暫接；慶卿、荊卿指荊軻，田光之光限第28至29段，丹限太子丹敘事。魯句踐不與其他句踐合併；狗屠、主人及被虜韓趙王保留未名。嵌套代詞仍待逐處核定。","reviewer":"Codex（AI 代理）","surfaces":["髙漸離"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p025","quote":"荊軻既至燕，愛燕之狗屠及善撃筑者髙漸離。荊軻嗜酒，日與狗屠及髙漸離飲於燕市，酒酣以往，髙漸離撃筑，荊軻和而歌於市中，相樂也，已而相泣，旁若無人者。荊軻雖游於酒人乎，然其爲人沈深好書；其所游諸侯，盡與其賢豪長者相結。其之燕，燕之處士田光先生亦善待之，知其非庸人也。"},{"paragraph_id":"c-shiji-086-cike:p033","quote":"太子及賓客知其事者，皆白衣冠以送之。至易水之上，既祖，取道，髙漸離撃筑，荊軻和而歌，爲變徴之聲，士皆垂涙涕泣。又前而爲歌曰：「風蕭蕭兮易水寒，壯士一去兮不復還！」復爲羽聲慨，士皆瞋目，發盡上指冠。於是荊軻就車而去，終已不顧。"},{"paragraph_id":"c-shiji-086-cike:p036","quote":"其明年，秦并天下，立號爲皇帝。於是秦逐太子丹、荊軻之客，皆亡。髙漸離變名姓爲人庸保，匿作於宋子。久之，作苦，聞其家堂上客撃筑，傍偟不能去。毎出言曰：「彼有善有不善。」從者以告其主，曰：「彼庸乃知音，竊言是非。」家丈人召使前撃筑，一坐稱善，賜酒。而髙漸離念久隱畏約無窮時，乃退，出其裝匣中筑與其善衣，更容貌而前。舉坐客皆驚，下與抗禮，以爲上客。使撃筑而歌，客無不流涕而去者。宋子傳客之，聞於秦始皇。秦始皇召見，人有識者，乃曰：「髙漸離也。」秦皇帝惜其善撃筑，重赦之，乃矐其目。使撃筑，未嘗不稱善。稍益近之，髙漸離乃以鉛置筑中，復進得近，舉筑樸秦皇帝，不中。於是遂誅髙漸離，終身不復近諸侯之人。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-086-cike:p025","text":"荊軻既至燕，愛燕之狗屠及善撃筑者髙漸離。荊軻嗜酒，日與狗屠及髙漸離飲於燕市，酒酣以往，髙漸離撃筑，荊軻和而歌於市中，相樂也，已而相泣，旁若無人者。荊軻雖游於酒人乎，然其爲人沈深好書；其所游諸侯，盡與其賢豪長者相結。其之燕，燕之處士田光先生亦善待之，知其非庸人也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m025-0000","start":0,"end":2,"surface":"荊軻","kind":"person","person_id":"cbr-p004841","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m025-0009","start":9,"end":11,"surface":"狗屠","kind":"person","person_id":"cbr-p004846","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m025-0016","start":16,"end":19,"surface":"髙漸離","kind":"person","person_id":"cbr-p004847","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m025-0020","start":20,"end":22,"surface":"荊軻","kind":"person","person_id":"cbr-p004841","status":"contextual_provisional"},{"id":"c-shi