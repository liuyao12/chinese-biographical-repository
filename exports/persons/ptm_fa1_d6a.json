inds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-yong:p004:m0217","surface":"樓褒","start":217,"end":219,"person_id":"ptm_fa1_d6a","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yong:p004","chapter_id":"c-jinshu-059-prince-yong"},{"id":"c-jinshu-059-prince-yong:p004:m0285","surface":"樓褒","start":285,"end":287,"person_id":"ptm_fa1_d6a","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yong:p004","chapter_id":"c-jinshu-059-prince-yong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-prince-yong:p004","text":"左衛將軍陳眕奉天子伐穎，顒又遣方率兵二萬救鄴。天子已幸鄴。方屯兵洛陽。及王浚等伐穎，穎挾天子歸洛陽。方將兵入殿中，逼帝幸其壘，掠府庫，將焚宮廟以絕眾心。盧志諫，乃止。方又逼天子幸長安。顒及選置百官，改秦州為定州。及東海王越起兵徐州，西迎大駕，關中大懼，方謂顒曰：「方所領猶有十餘萬眾，奉送大駕還洛宮，使成都王反鄴，公自留鎮關中，方北討博陵。如此，天下可小安，無復舉手者。」顒慮事大難濟，不許。乃假劉喬節，進位鎮東大將軍，遣成都王穎總統樓褒、王闡等諸軍，據河橋以距越。王浚遣督護劉根，將三百騎至河上。闡出戰，為根所殺。穎頓軍張方故壘，范陽王虓遣鮮卑騎與平昌、博陵眾襲河橋，樓褒西走，追騎至新安，道路死者不可勝數。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":176,"last_line":176,"raw_start":17930,"raw_end":18264,"raw_character_offsets":[17932,17933,17934,17935,17936,17937,17938,17939,17940,17941,17942,17943,17944,17945,17946,17947,17948,17949,17950,17951,17952,17953,17954,17955,17956,17957,17958,17959,17960,17961,17962,17963,17964,17965,17966,17967,17968,17969,17970,17971,17972,17973,17974,17975,17976,17977,17978,17979,17980,17981,17982,17983,179