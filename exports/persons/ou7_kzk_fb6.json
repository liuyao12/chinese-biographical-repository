plete:p060","text":"　　測善畫，自圖阮籍遇蘇門於行障上，坐卧對之。又畫永業佛影臺，皆爲妙作。頗好音律，善《易老》，續皇甫謐《高士傳》三卷。又嘗遊衡山七嶺，著《衡山》、《廬山記》。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":154,"last_line":154,"raw_start":8261,"raw_end":8340,"raw_character_offsets":[8261,8262,8263,8264,8265,8266,8267,8268,8269,8270,8271,8272,8273,8274,8275,8276,8277,8278,8279,8280,8281,8282,8283,8284,8285,8286,8287,8288,8289,8290,8291,8292,8293,8294,8295,8296,8297,8298,8299,8300,8301,8302,8303,8304,8305,8306,8307,8308,8309,8310,8311,8312,8313,8314,8315,8316,8317,8318,8319,8320,8321,8322,8323,8324,8325,8326,8327,8328,8329,8330,8331,8332,8333,8334,8335,8336,8337,8338,8339],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p060:m0002","start":2,"end":3,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"}],"sources":[{"chapter_id":"c-nanqishu-054-recluses-complete","work_id":"w-nanqishu","book_id":"b-nanqishu-054","source_id":"s-nanqishu-054-recluses-complete-ws1762878","source":{"title":"南齊書卷五十四·褚伯玉、顧歡等高逸列傳","provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?oldid=1762878","url":"https://zh.wikisource.org/w/index.php?oldid=1762878","revision_id":1762878,"edition":"維基文庫固定修訂","accessed_on":"2026-11-21","review_status":"text_checked","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫授權。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","extent":"南齊書卷五十四·褚伯玉、顧歡等高逸列傳","text_scope":"complete_biography_unit","raw_path":"source-evidence/liang027-complete/external/nanqi054-ws1762878.wikitext","raw_file_sha256":"acdda954790fed4481bbfb7d99611d07a4531f390d67c5daa291fb68f6c9a976","collation_witnesses":["source-evidence/nanqi054-roll/recluses-reading.json"]}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"da