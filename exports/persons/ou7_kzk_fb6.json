747,7748,7749,7750,7751,7752,7753,7754,7755,7756,7757,7758,7759,7760,7761,7762,7763,7764,7765,7766,7767,7768,7769,7770,7771,7772,7773,7774,7775,7776,7777,7778,7779],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p055:m0002","start":2,"end":4,"surface":"宗測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p055:m0005","start":5,"end":7,"surface":"敬微","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p055:m0015","start":15,"end":16,"surface":"炳","kind":"person","person_id":"nwk_pqi_g48","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p055:m0024","start":24,"end":25,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p056","text":"　　州舉秀才，主簿，不就。驃騎豫章王徵爲參軍，測答府召云：「何爲謬傷海鳥，橫斤山木？」母喪，身負土植松柏。豫章王復遣書請之，辟爲參軍。測答曰：「性同鱗羽，愛止山壑，眷戀松筠，輕迷人路。縱宕巖流，有若狂者，忽不知老至，而今鬢已白，豈容課虛責有，限魚慕鳥哉！」永明三年，詔徵太子舍人，不就。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":146,"last_line":146,"raw_start":7782,"raw_end":7925,"raw_character_offsets":[7782,7783,7784,7785,7786,7787,7788,7789,7790,7791,7792,7793,7794,7795,7796,7797,7798,7799,7800,7801,7802,7803,7804,7805,7806,7807,7808,7809,7810,7811,7812,7813,7814,7815,7816,7817,7818,7819,7820,7821,7822,7823,7824,7825,7826,7827,7828,7829,7830,7831,7832,7833,7834,7835,7836,7837,7838,7839,7840,7841,7842,7843,7844,7845,7846,7847,7848,7849,7850,7851,7852,7853,7854,7855,7856,7857,7858,7859,7860,7861,7862,7863,7864,7865,7866,7867,7868,7869,7870,7871,7872,7873,7874,7875,7876,7877,7878,7879,7880,7881,7882,7883,7884,7885,7886,7887,7888,7889,7890,7891,7892,7893,7894,7895,7896,7897,7898,7899,7900,7901,7902,7903,7904,7905,7906,7907,7908,7909,7910,7911,7912,7913,7914,7915,7916,7917,7918,7919,7920,7921,7922,7923,7924],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p056:m0015","start":15,"end":18,"surface":"豫章王","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p056:m0023","start":23,"end":24,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p056:m0053","start":53,"end":56,"surface":"豫章王","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p056:m0067","start":67,"end":68,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p057","text":"　　欲遊名山，乃寫祖炳所畫尚子平圖於壁上。測長子宦在京師，知父此旨，便求祿還爲南郡丞，付以家事。刺史安陸王子敬、長史劉寅以下皆贈送之，測無所受。齎《老子》《莊子》二書自隨。子孫拜辭悲泣，測長嘯不視，遂往廬山，止祖炳舊宅。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":148,"last_line":148,"raw_start":7927,"raw_end":8037,"raw_character_offsets":[7927,7928,7929,7930,7931,7932,7933,7934,7935,7936,7937,7938,7939,7940,7941,7942,7943,7944,7945,7946,7947,7948,7949,7950,7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,7965,7966,7967,7968,7969,7970,7971,7972,7973,7974,7975,7976,7977,7978,7979,7980,7981,7982,7983,7984,7985,7986,7987,7988,7989,7990,7991,7992,7993,7994,7995,7996,7997,7998,7999,8000,8001,8002,8003,8004,8005,8006,8007,8008,8009,8010,8011,8012,8013,8014,8015,8016,8017,8018,8019,8020,8021,8022,8023,8024,8025,8026,8027,8028,8029,8030,8031,8032,8033,8034,8035,8036],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p057:m0010","start":10,"end":11,"surface":"炳","kind":"person","person_id":"nwk_pqi_g48","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p057:m0021","start":21,"end":22,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p057:m0050","start":50,"end":55,"surface":"安陸王子敬","kind":"person","person_id":"kix_r92_2ed_A","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p057:m0058","start":58,"end":60,"surface":"劉寅","kind":"person","person_id":"s6k_8ll_f5i","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p057:m0067","start":67,"end":68,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p057:m0093","start":93,"end":94,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p057:m0106","start":106,"end":107,"surface":"炳","kind":"person","person_id":"nwk_pqi_g48","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p058","text":"　　魚復侯子響爲江州，厚遣贈遺。測曰：「少有狂疾，尋山採藥，遠來至此。量腹而進松朮，度形而衣薜蘿，淡然已足，豈容當此橫施！」子響命駕造之，測避不見。後子響不告而來，奄至所住，測不得已，巾褐對之，竟不交言，子響不悅而退。尚書令王儉餉測蒲褥。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":150,"last_line":150,"raw_start":8039,"raw_end":8158,"raw_character_offsets":[8039,8040,8041,8042,8043,8044,8045,8046,8047,8048,8049,8050,8051,8052,8053,8054,8055,8056,8057,8058,8059,8060,8061,8062,8063,8064,8065,8066,8067,8068,8069,8070,8071,8072,8073,8074,8075,8076,8077,8078,8079,8080,8081,8082,8083,8084,8085,8086,8087,8088,8089,8090,8091,8092,8093,8094,8095,8096,8097,8098,8099,8100,8101,8102,8103,8104,8105,8106,8107,8108,8109,8110,8111,8112,8113,8114,8115,8116,8117,8118,8119,8120,8121,8122,8123,8124,8125,8126,8127,8128,8129,8130,8131,8132,8133,8134,8135,8136,8137,8138,8139,8140,8141,8142,8143,8144,8145,8146,8147,8148,8149,8150,8151,8152,8153,8154,8155,8156,8157],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p058:m0002","start":2,"end":7,"surface":"魚復侯子響","kind":"person","person_id":"kix_r92_2ed_G","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p058:m0016","start":16,"end":17,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p058:m0062","start":62,"end":64,"surface":"子響","kind":"person","person_id":"kix_r92_2ed_G","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p058:m0069","start":69,"end":70,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p058:m0075","start":75,"end":77,"surface":"子響","kind":"person","person_id":"kix_r92_2ed_G","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p058:m0087","start":87,"end":88,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p058:m0102","start":102,"end":104,"surface":"子響","kind":"person","person_id":"kix_r92_2ed_G","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p058:m0112","start":112,"end":114,"surface":"王儉","kind":"person","person_id":"7r6_k52_qji_ABAAAAEAA","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p058:m0115","start":115,"end":116,"surface":"測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:p059","text":"　　頃之，測送弟喪還西，仍留舊宅永業寺，絕賔友，唯與同志庾易、劉虯、宗人尚之等往來講說。刺史隨王子隆至鎮，遣別駕宗哲致勞問，測笑曰：「貴賤理隔，何以及此。」竟不答。建武二年，徵爲司徒主簿，不就，卒。","text_layer":"received_chapter","annotat