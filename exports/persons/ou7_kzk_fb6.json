canonical_mention_id":"c-nanqishu-054-recluses-complete:p058:m0087","mention_ids":["c-nanqishu-054-recluses-complete:p058:m0087"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p058:m0115","mention_ids":["c-nanqishu-054-recluses-complete:p058:m0115"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p059:m0005","mention_ids":["c-nanqishu-054-recluses-complete:p059:m0005"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p059:m0062","mention_ids":["c-nanqishu-054-recluses-complete:p059:m0062"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-054-recluses-complete:p060:m0002","mention_ids":["c-nanqishu-054-recluses-complete:p060:m0002"],"kind":"paragraph"}],"mention_count":17,"duplicate_mention_count":0,"paragraph_occurrence_count":17,"table_occurrence_count":0,"passage_count":7,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"17處獨立位置，17個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-054-recluses-complete-ws1762878"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-054-recluses-complete:source_review55-0","kind":"source_review","person_id":"ou7_kzk_fb6","source_quote":"　　宗測字敬微，南陽人，宋徵士炳孫也。世居江陵。測少靜退，不樂人間。歎曰：「家貧親老，不擇官而仕，先哲以爲美談，余竊有惑。誠不能潛感地金，冥致江鯉，但當用天道，分地利。孰能食人厚祿，憂人重事乎？」","reading":"宗測是宗炳之孫。原說南陽、世居江陵並存。","note":"宗測是宗炳之孫。原說南陽、世居江陵並存。","paragraph_id":"c-nanqishu-054-recluses-complete:p055","start_codepoint":0,"end_codepoint":98,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review56-0","kind":"source_review","person_id":"ou7_kzk_fb6","source_quote":"　　州舉秀才，主簿，不就。驃騎豫章王徵爲參軍，測答府召云：「何爲謬傷海鳥，橫斤山木？」母喪，身負土植松柏。豫章王復遣書請之，辟爲參軍。測答曰：「性同鱗羽，愛止山壑，眷戀松筠，輕迷人路。縱宕巖流，有若狂者，忽不知老至，而今鬢已白，豈容課虛責有，限魚慕鳥哉！」永明三年，詔徵太子舍人，不就。","reading":"悼母植柏與豫章王辟參軍分事。永明三年太子舍人不就。","note":"悼母植柏與豫章王辟參軍分事。永明三年太子舍人不就。","paragraph_id":"c-nanqishu-054-recluses-complete:p056","start_codepoint":0,"end_codepoint":143,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review57-0","kind":"source_review","person_id":"ou7_kzk_fb6","source_quote":"　　欲遊名山，乃寫祖炳所畫尚子平圖於壁上。測長子宦在京師，知父此旨，便求祿還爲南郡丞，付以家事。刺史安陸王子敬、長史劉寅以下皆贈送之，測無所受。齎《老子》《莊子》二書自隨。子孫拜辭悲泣，測長嘯不視，遂往廬山，止祖炳舊宅。","reading":"宗測長子回任南郡丞接家事；劉寅是此處長史。尚子平見宗炳圖題。","note":"宗測長子回任南郡丞接家事；劉寅是此處長史。尚子平見宗炳圖題。","paragraph_id":"c-nanqishu-054-recluses-complete:p057","start_codepoint":0,"end_codepoint":110,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review58-0","kind":"source_review","person_id":"ou7_kzk_fb6","source_quote":"　　魚復侯子響爲江州，厚遣贈遺。測曰：「少有狂疾，尋山採藥，遠來至此。量腹而進松朮，度形而衣薜蘿，淡然已足，豈容當此橫施！」子響命駕造之，測避不見。後子響不告而來，奄至所住，測不得已，巾褐對之，竟不交言，子響不悅而退。尚書令王儉餉測蒲褥。","reading":"魚復侯子響先贈物，後到山居相見。王儉餉物另記。","note":"魚復侯子響先贈物，後到山居相見。王儉餉物另記。","paragraph_id":"c-nanqishu-054-recluses-complete:p058","start_codepoint":0,"end_codepoint":119,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review59-0","kind":"source_review","person_id":"ou7_kzk_fb6","source_quote":"　　頃之，測送弟喪還西，仍留舊宅永業寺，絕賔友，唯與同志庾易、劉虯、宗人尚之等往來講說。刺史隨王子隆至鎮，遣別駕宗哲致勞問，測笑曰：「貴賤理隔，何以及此。」竟不答。建武二年，徵爲司徒主簿，不就，卒。","reading":"宗測弟喪後的行止列庾、劉、宗三位同道。建武二年徵而不就，卒。","note":"宗測弟喪後的行止列庾、劉、宗三位同道。建武二年徵而不就，卒。","paragraph_id":"c-nanqishu-054-recluses-complete:p059","start_codepoint":0,"end_codepoint":99,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:source_review60-0","kind":"source_review","person_id":"ou7_kzk_fb6","source_quote":"　　測善畫，自圖阮籍遇蘇門於行障上，坐卧對之。又畫永業佛影臺，皆爲妙作。頗好音律，善《易老》，續皇甫謐《高士傳》三卷。又嘗遊衡山七嶺，著《衡山》、《廬山記》。","reading":"宗測善畫、續高士傳及著山水記，所舉人物不繫直接會面。","note":"宗測善畫、續高士傳及著山水記，所舉人物不繫直接會面。","paragraph_id":"c-nanqishu-054-recluses-complete:p060","start_codepoint":0,"end_codepoint":79,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-054-recluses-complete:variant_review57-21","kind":"variant_review","person_id":"ou7_kzk_fb6","source_quote":"測長子宦在京師","reading":"以宅與傳主家事推動行程，長子無名。劉寅明為此時長史，勿與卷53寅之混。","note":"以宅與傳主家事推動行程，長子無名。劉寅明為此時長史，勿與卷53寅之混。","paragraph_id":"c-nanqishu-054-recluses-complete:p057","start_codepoint":21,"end_codepoint":28,"human_reviewed":false,"chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-qi054-zongce-grandfather","subject_person_id":"ou7_kzk_fb6","object_person_id":"nwk_pqi_g48","predicate":"grandfather","qualifiers":{"source_term":"宋徵士炳孫也","lineage":"paternal"},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-054","chapter_id":"c-nanqishu-054-recluses-complete","source_id":"s-nanqishu-054-recluses-complete-ws1762878","paragraph_id":"c-nanqishu-054-recluses-complete:p055","quote":"　　宗測字敬微，南陽人，宋徵士炳孫也。世居江陵。測少靜退，不樂人間。歎曰：「家貧親老，不擇官而仕，先哲以爲美談，余竊有惑。誠不能潛感地金，冥致江鯉，但當用天道，分地利。孰能食人厚祿，憂人重事乎？」","subject_person_mention_id":"c-nanqishu-054-recluses-complete:p055:m0002","object_person_mention_id":"c-nanqishu-054-recluses-complete:p055:m0015"}],"status":"source_attested","interpretation_note":"後文又稱祖炳及舊宅。","reviewer":"Codex（AI代理）","model":null,"human_reviewed