"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-037","chapter_id":"c-jinshu-037-zhangchangzhi-huaisu","source_id":"s-jinshu-037-zhangchangzhi-huaisu-ws2630018","paragraph_id":"c-jinshu-037-zhangchangzhi-huaisu:p001","quote":"甯朔將軍張暢之、高平相劉懷肅自沔攻振，走之。","person_mention_id":"c-jinshu-037-zhangchangzhi-huaisu:p001:m0004"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"th-songshu-047-liuhuaisu-received-2-120","title":"江夏相","kind":"office","mode":"attestation","person_id":"adl_wec_ik4","attestations":[{"id":"th-songshu-047-liuhuaisu-received-2-120:a","paragraph_id":"c-songshu-047-liuhuaisu-received:p002","start":120,"end":123,"surface":"江夏相","person_mention_id":"c-songshu-047-liuhuaisu-received:p002:m0123","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-047","chapter_id":"c-songshu-047-liuhuaisu-received","source_id":"s-songshu-047-liuhuaisu-received-ws2190557","paragraph_id":"c-songshu-047-liuhuaisu-received:p002","quote":"初為劉敬宣寧朔府司馬，東征孫恩，有戰功，又為龍驤司馬、費令。聞高祖起義，棄縣來奔。京邑平定，振武將軍道規追桓玄，以懷肅為司馬。玄留何澹之、郭銓等戍桑落洲，進擊破之。潁川太守劉統平，除高平太守。玄既死，從子振大破義軍於楊林，義軍退尋陽。懷肅與江夏相張暢之攻澹之於西塞，破之。偽鎮東將軍馮該戍夏口東岸，孟山圖據魯山城，桓仙客守偃月壘，皆連壁相望。懷肅與道規攻之，躬擐甲冑，陷二城，馮該走石城，生擒仙客。義熙元年正月，振敗走，道規遣懷肅平石城，斬馮該及其子山靖。三月，桓振復襲江陵，荊州刺史司馬休之出奔，懷肅自雲杜馳赴，日夜兼行，七日而至。振勒兵三萬，旗幟蔽野，躍馬橫矛，躬自突陳。流矢傷懷肅額，眾懼欲奔，懷肅瞋目奮戰，士氣益壯。於是士卒爭先，臨陣斬振首。江陵既平，休之反鎮，執懷肅手曰：「微子之力，吾無所歸矣。」偽輔國將軍符嗣、馬孫、偽龍驤將軍金符青、樂志等屯結江夏，懷肅又討之，梟樂志等。道規加懷肅督江夏九郡，權鎮夏口。","person_mention_id":"c-songshu-047-liuhuaisu-received:p002:m0123"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-037-zhangchangzhi-huaisu:p001","text":"甯朔將軍張暢之、高平相劉懷肅自沔攻振，走之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":212,"last_line":212,"raw_start":16118,"raw_end":16140,"raw_character_offsets":[16118,16119,16120,16121,16122,16123,16124,16125,16126,16127,16128,16129,16130,16131,16132,16133,16134,16135,16136,16137,16138,16139],"revision_id":2630018},"mentions":[{"id":"c-jinshu-037-zhangchangzhi-huaisu:p001:m0004","start":4,"end":7,"surface":"張暢之","kind":"person","person_id":"adl_wec_ik4","status":"contextual_provisional"},{"id":"c-jinshu-037-zhangchangzhi-huaisu:p001:m0011","start":11,"end":14,"surface":"劉懷肅","kind":"person","person_id":"olf_c6j_hmg","status":"contextual_provisional"},{"id":"c-jinshu-037-zhangchangzhi-huaisu:p001:m0017","start":17,"end":18,"surface":"振","kind":"person","person_id":"u9s_w6j_8mc_ACAC","status":"contextual_provisional"}],"chapter_id":"c-jinshu-037-zhangchangzhi-huaisu","book_id":"b-jinshu-037","work_id":"w-jinshu","source_id":"s-jinshu-037-zhangchangzhi-huaisu-ws2630018"},{"id":"c-jinshu-064-simadaozi:p015","text":"大軍將發，玄從兄驃騎長史石生馳使告玄。玄進次尋陽，傳檄京師，罪狀元顯。俄而玄至西陽，帝戎服餞元顯于西池，始登舟而玄至新亭。元顯棄船退屯國子學堂。明日，列陣于宣陽門外，元顯佐吏多散走。或言玄已至大桁，劉牢之遂降于玄。元顯回入宣陽門，牢之參軍張暢之率眾遂之，眾潰。元顯奔入相府，唯張法順隨之。問計于道子，道子對之泣。玄遣太傅從事中郎毛泰收元顯送於新亭，縛於舫前而數之。元顯答曰：「為王誕、張法順所誤。」於是送付廷尉，並其六子皆害之。玄又奏：「道子酣縱不孝，當棄市。」詔徒安成郡，使御史杜竹林防衛，竟承玄旨酖殺之，時年三十九。帝三日哭於西堂。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":141,"last_line":141,"raw_start":11943,"raw_end":12213,"raw_character_offsets":[11945,11946,11947,11948,11949,11950,11951,11952,11953,11954,11955,11956,11957,11958,11959,11960,11961,11962,11963,11964,11965,11966,11967,11968,11969,11970,11971,11972,11973,11974,11975,11976,11977,11978,11979,11980,11981,11982,11983,11984,11985,11986,11987,11988,11989,11990,11991,11992,1