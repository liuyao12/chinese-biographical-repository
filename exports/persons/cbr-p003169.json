ess_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji050-023","person_id":"cbr-p003169","surfaces":["嫂","巨嫂"],"scope":"same_chapter","chapter_ids":["c-shiji-050-chuyuan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-050-chuyuan:p002","quote":"高祖兄弟四人，長兄伯，伯蚤卒。始高祖微時，嘗辟事，時時與賓客過巨嫂食。嫂厭叔，叔與客來，嫂詳為羹盡，櫟釜，賓客以故去。已而視釜中尚有羹，高祖由此怨其嫂。及高祖為帝，封昆弟，而伯子獨不得封。太上皇以為言，高祖曰：「某非忘封之也，為其母不長者耳。」於是乃封其子信為羹頡侯。而王次兄仲於代。"}],"rationale":"明示名、字與楚趙世系局部回指暫接；兩支文王分開，副詞遂降不當劉遂，王作動詞不當人稱。索隱述贊保留自身層次，未名署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-050-chuyuan:p002","text":"高祖兄弟四人，長兄伯，伯蚤卒。始高祖微時，嘗辟事，時時與賓客過巨嫂食。嫂厭叔，叔與客來，嫂詳為羹盡，櫟釜，賓客以故去。已而視釜中尚有羹，高祖由此怨其嫂。及高祖為帝，封昆弟，而伯子獨不得封。太上皇以為言，高祖曰：「某非忘封之也，為其母不長者耳。」於是乃封其子信為羹頡侯。而王次兄仲於代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-050-chuyuan:m002-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"cbr-p003167","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m002-0002","start":2,"end":6,"surface":"兄弟四人","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、泛稱或未定指代；不補未見人物成員與姓名。"},{"id":"c-shiji-050-chuyuan:m002-0009","start":9,"end":10,"surface":"伯","kind":"person","person_id":"cbr-p003168","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m002-0011","start":11,"end":12,"surface":"伯","kind":"person","person_id":"cbr-p003168","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m002-0016","start":16,"end":18,"surface":"高祖","kind":"person","person_id":"cbr-p003167","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m002-0028","start":28,"end":30,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved","note":"集體、泛稱或未定指代；不補未見人物成員與姓名。"},{"id":"c-shiji-050-chuyuan:m002-0031","start":31,"end":33,"surface":"巨嫂","kind":"person","person_id":"cbr-p003169","status":"contextual_provisional"},{"id":"c-shiji-050-chuyuan:m002-0035","start":35,"end":3