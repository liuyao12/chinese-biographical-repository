{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"8a9_3wc_bf6","canonical_person_id":"8a9_3wc_bf6","id_aliases":["cbr-p002044"],"identity_policy":"contextual_provisional","person_ids":["8a9_3wc_bf6"],"persons":[{"id":"8a9_3wc_bf6","label":"許君（楚成王伐許時未名）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"許君","mention_ids":["c-shiji-040-chu:m016-0123"]}],"evidence":[{"mention_id":"c-shiji-040-chu:m016-0123","chapter_id":"c-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p016","quote":"許君"}],"id_aliases":["cbr-p002044"]}],"source_mention_summary":[{"source_id":"s-shiji-040-chu","work_id":"w-shiji","book_id":"b-shiji-040","chapter_id":"c-shiji-040-chu","mention_count":1,"mention_ids":["c-shiji-040-chu:m016-0123"],"paragraph_ids":["c-shiji-040-chu:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-040-chu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-040-chu:m016-0123","start":123,"end":125,"surface":"許君","kind":"person","person_id":"8a9_3wc_bf6","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p016","chapter_id":"c-shiji-040-chu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji040-169","person_id":"8a9_3wc_bf6","surfaces":["許君"],"scope":"same_chapter","chapter_ids":["c-shiji-040-chu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-040-chu:p016","quote":"成王惲元年，初卽位，布德施惠，結舊好於諸侯。使人獻天子，天子賜胙，曰：「鎭爾南方夷越之亂，無侵中國。」於是楚地千里。十六年，齊桓公以兵侵楚，至陘山。楚成王使將軍屈完以兵御之，與桓公盟。桓公數以周之賦不入王室，楚許之，乃去。十八年，成王以兵北伐許，許君肉袒謝，乃釋之。二十二年，伐黃。二十六年，滅英。三十三年，宋襄公欲爲盟會，召楚。楚王怒曰：「召我，我將好往襲辱之。」遂行，至盂，遂執辱宋公，已而歸之。三十四年，鄭文公南朝楚。楚成王北伐宋，敗之泓，射傷宋襄公，襄公遂病創死。三十五年，晉公子重耳過楚，成王以諸侯客禮饗，而厚送之於秦。三十九年，魯僖公來請兵以伐齊，楚使申侯將兵伐齊，取穀，置齊桓公子雍焉。齊桓公七子皆奔楚，楚盡以爲上大夫。滅夔，夔不祀祝融、鬻熊故也。"}],"rationale":"本段個別國君、質子、使者或任職者保留未名／字面候選，不補未見姓名；職稱相同不自動連到他段或他篇人物。左徒與下段春申君另待具體證據決定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-040-chu:p016","text":"成王惲元年，初卽位，布德施惠，結舊好於諸侯。使人獻天子，天子賜胙，曰：「鎭爾南方夷越之亂，無侵中國。」於是楚地千里。十六年，齊桓公以兵侵楚，至陘山。楚成王使將軍屈完以兵御之，與桓公盟。桓公數以周之賦不入王室，楚許之，乃去。十八年，成王以兵北伐許，許君肉袒謝，乃釋之。二十二年，伐黃。二十六年，滅英。三十三年，宋襄公欲爲盟會，召楚。楚王怒曰：「召我，我將好往襲辱之。」遂行，至盂，遂執辱宋公，已而歸之。三十四年，鄭文公南朝楚。楚成王北伐宋，敗之泓，射傷宋襄公，襄公遂病創死。三十五年，晉公子重耳過楚，成王以諸侯客禮饗，而厚送之於秦。三十九年，魯僖公來請兵以伐齊，楚使申侯將兵伐齊，取穀，置齊桓公子雍焉。齊桓公七子皆奔楚，楚盡以爲上大夫。滅夔，夔不祀祝融、鬻熊故也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m016-0000","start":0,"end":3,"surface":"成王惲","kind":"person","person_id":"osu_yvw_bwr","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m016-0025","start":25,"end":27,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"獻天子、天子賜胙的周王稱尚待核明任時身份，不按推算紀年補名。"},{"id":"c-shiji-040-chu:m016-0028","start":28,"end":30,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"同段賜胙的天子稱與前句相應，身份仍未定。"},{"id":"c-shiji-040-chu:m016-0062","start":62,"end":65,"surface":"齊桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m016-0074","start":74,"end":77,"surface":"楚成王","kind":"person","person_id":"osu_yvw_bwr","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m016-0080","start":80,"end":82,"surface":"屈完","kind":"person","person_id":"xqc_j54_rtn","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m016-0088","start":88,"end":90,"surface":"桓公","kind":"person","person_id":"9w2_c77_53m","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m016-0092","sta