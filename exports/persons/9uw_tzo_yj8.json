nd":375,"surface":"芮子","kind":"person","person_id":"48a_5al_4n8","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m074-0378","start":378,"end":380,"surface":"孺子","kind":"person","person_id":"wuz_yxe_b9k_B","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-046-tian:p010","text":"田乞使人之魯，迎陽生。陽生至齊，匿田乞家。請諸大夫曰：「常之母有魚菽之祭，幸而來會飲。」會飲田氏。田乞盛陽生橐中，置坐中央。發橐，出陽生，曰：「此乃齊君矣。」大夫皆伏謁。將盟立之，田乞誣曰：「吾與鮑牧謀共立陽生也。」鮑牧怒曰：「大夫忘景公之命乎？」諸大夫欲悔，陽生乃頓首曰：「可則立之，不可則已。」鮑牧恐禍及己，乃復曰：「皆景公之子，何爲不可！」遂立陽生於田乞之家，是爲悼公。乃使人遷晏孺子於駘，而殺孺子荼。悼公旣立，田乞爲相，專齊政。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-046-tian:m010-0000","start":0,"end":2,"surface":"田乞","kind":"person","person_id":"lmu_nbm_rzo_AAAAAAAB","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0008","start":8,"end":10,"surface":"陽生","kind":"person","person_id":"yht_8tu_hv4_B","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0011","start":11,"end":13,"surface":"陽生","kind":"person","person_id":"yht_8tu_hv4_B","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0017","start":17,"end":19,"surface":"田乞","kind":"person","person_id":"lmu_nbm_rzo_AAAAAAAB","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0028","start":28,"end":31,"surface":"常之母","kind":"person","person_id":"26q_bpg_wb6","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0046","start":46,"end":48,"surface":"田氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、卜辭或未定指代，未補成員姓名與親屬。"},{"id":"c-shiji-046-tian:m010-0049","start":49,"end":51,"surface":"田乞","kind":"person","person_id":"lmu_nbm_rzo_AAAAAAAB","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0052","start":52,"end":54,"surface":"陽生","kind":"person","person_id":"yht_8tu_hv4_B","status":"contextual_provisional"},{"id":"c-shiji-046-tian:m010-0066","start":66,"end":68,"surface":"陽生","k