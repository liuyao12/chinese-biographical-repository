in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m024-0000","start":0,"end":3,"surface":"燕昭王","kind":"person","person_id":"5pw_05i_uhv","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0017","start":17,"end":19,"surface":"賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0021","start":21,"end":23,"surface":"郭隗","kind":"person","person_id":"eyc_8y6_02q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0053","start":53,"end":55,"surface":"賢士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0061","start":61,"end":63,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0071","start":71,"end":73,"surface":"先生","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0083","start":83,"end":85,"surface":"郭隗","kind":"person","person_id":"eyc_8y6_02q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0092","start":92,"end":93,"surface":"士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0096","start":96,"end":97,"surface":"隗","kind":"person","person_id":"eyc_8y6_02q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0102","start":102,"end":103,"surface":"隗","kind":"person","person_id":"eyc_8y6_02q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0114","start":114,"end":116,"surface":"昭王","kind":"person","person_id":"5pw_05i_uhv","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0117","start":117,"end":118,"surface":"隗","kind":"person","person_id":"eyc_8y6_02q","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0126","start":126,"end":128,"surface":"樂毅","kind":"person","person_id":"gz0_xuu_ont","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0132","start":132,"end":134,"surface":"鄒衍","kind":"person","person_id":"toi_62h_6fm","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0138","start":138,"end":140,"surface":"劇辛","kind":"person","person_id":"qsp_sme_975","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0144","start":144,"end":145,"surface":"士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"},{"id":"c-shiji-034-yan:m024-0149","start":149,"end":152,"surface":"燕王噲","kind":"person","person_id":"n4f_fqh_04q_A","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m024-0157","start":157,"end":159,"surface":"百姓","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者、未定稱呼、書名或數位疑讀；不補姓名、性別與成員。"}],"chapter_id":"c-shiji-034-yan","book_id":"b-shiji-034","work_id":"w-shiji","source_id":"s-shiji-034-yan"},{"id":"c-shiji-080-leyi:p002","text":"樂毅賢，好兵，趙人舉之。及武靈王有沙丘之亂，乃去趙適魏。聞燕昭王以子之之亂而齊大敗燕，燕昭王怨齊，未嘗一日而忘報齊也。燕國小，辟遠，力不能制，於是屈身下士，先禮郭隗以招賢者。樂毅於是為魏昭王使於燕，燕王以客禮待之。樂毅辭讓，遂委質為臣，燕昭王以為亞卿，久之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m002-0000","start":0,"end":2,"surface":"樂毅","kind":"person","person_id":"gz0_xuu_ont","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0013","start":13,"end":16,"surface":"武靈王","kind":"person","person_id":"txj_z8z_5me_A","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0029","start":29,"end":32,"surface":"燕昭王","kind":"person","person_id":"5pw_05i_uhv","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0033","start":33,"end":35,"surface":"子之","kind":"person","person_id":"esz_z17_u3u","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0043","start":43,"end":46,"surface":"燕昭王","kind":"person","person_id":"5pw_05i_uhv","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m0