n_id":"59u_70h_y1y","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yue:p006","chapter_id":"c-jinshu-059-prince-yue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-prince-ying:p007","text":"安北將軍王浚、甯北將軍東嬴公騰殺穎所置幽州刺史和演，穎征浚，浚屯冀州不進，與騰及烏丸、羯硃襲穎。候騎至鄴，穎遣幽州刺史王斌及石超、李毅等距浚，為羯硃等所敗。鄴中大震，百僚奔走，士卒分散。穎懼，將帳下數十騎，擁天子，與中書監慮志單車而走，五日至洛。羯硃追至朝歌，不及而還。河間王顒遣張方率甲卒二萬救穎，至洛，方乃挾帝，擁穎及豫章王並高光、慮志等歸於長安。顒廢穎歸籓，以豫章王為皇太弟。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":161,"last_line":161,"raw_start":16414,"raw_end":16695,"raw_character_offsets":[16416,16417,16418,16419,16420,16421,16469,16470,16471,16472,16473,16474,16475,16476,16477,16478,16479,16480,16481,16482,16483,16484,16485,16486,16487,16488,16489,16490,16491,16492,16493,16494,16495,16496,16497,16498,16499,16500,16501,16502,16503,16504,16505,16506,16507,16508,16509,16551,16552,16553,16554,16555,16556,16557,16558,16559,16560,16561,16562,16563,16564,16565,16566,16567,16568,16569,16570,16571,16572,16573,16574,16575,16576,16577,16578,16579,16580,16581,16582,16583,16584,16585,16586,16587,16588,16589,16590,16591,16592,16593,16594,16595,16596,16597,16598,16599,16600,16601,16602,16603,16604,16605,16606,16607,16608,16609,16610,16611,16612,16613,16614,16615,16616,16617,16618,16619,16620,16621,16622,16623,16624,16625,16626,16627,16628,16629,16630,16631,16632,16633,16634,16635,16636,16637,16638,16639,16640,16641,16642,16643,16644,16645,16646,16647,16648,16649,16650,16651,16652,16653,16654,16655,16656,16657,16658,16659,16660,16661,16662,16663,16664,16665,16666,16667,16668,16669,16670,16671,16672,16673,16674,16675,16676,16677,16678,16679,16680,16681,16682,16683,16684,16685,16686,16687,16688,16689,16690,16691,16692,16693,16694],"revision_id":2650517},"mentions":[{"id":"c-j