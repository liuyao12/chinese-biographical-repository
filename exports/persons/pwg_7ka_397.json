son_id":"pwg_7ka_397","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p020","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-128-guice:p020","text":"故云神至能見夢於元王，而不能自出漁者之籠。身能十言盡當，不能通使於河，還報於江，賢能令人戰勝攻取，不能自解於刀鋒，免剝刺之患。聖能先知亟見，而不能令衛平無言。言事百全，至身而攣；當時不利，又焉事賢！賢者有恒常，士有適然。是故明有所不見，聽有所不聞；人雖賢，不能左畫方，右畫圓；日月之明，而時蔽於浮雲。羿名善射，不如雄渠、蜂門；禹名為辯智，而不能勝鬼神。地柱折，天故毋椽，又柰何責人於全？孔子聞之曰：「神龜知吉凶，而骨直空枯。日為德而君於天下，辱於三足之烏。月為刑而相佐，見食於蝦蟆。猬辱於鵲，騰蛇之神而殆於即且。竹外有節理，中直空虛；松柏為百木長，而守門閭。日辰不全，故有孤虛。黃金有疵，白玉有瑕。事有所疾，亦有所徐。物有所拘，亦有所據。罔有所數，亦有所疏。人有所貴，亦有所不如。何可而適乎？物安可全乎？天尚不全，故世為屋，不成三瓦而陳之，以應之天。天下有階，物不全乃生也。」","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-128-guice:m020-0008","start":8,"end":10,"surface":"元王","kind":"person","person_id":"a4t_7hv_0s6","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m020-0074","start":74,"end":76,"surface":"衛平","kind":"person","person_id":"p27_7v5_rgy","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m020-0150","start":150,"end":151,"surface":"羿","kind":"person","person_id":"8fm_xgr_9dc","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m020-0157","start":157,"end":159,"surface":"雄渠","kind":"person","person_id":"pwg_7ka_397","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m020-0160","start":160,"end":162,"surface":"蜂門","kind":"person","person_id":"1ux_z2g_fxh","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m020-0163","start":163,"end":164,"surface":"禹","kind":"person","person_id":"fw5_vd1_4xy","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m020-0193","start":193,"end":195,"surface":"孔子","kind":"person","person_id":"44y_n3n_ovn","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m020-0200","start":200,"end":202,"surface":"神龜"