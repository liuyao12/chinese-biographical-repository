e_components":[{"kind":"table_cell","person_id":"yqp_nlb_p1p_ABFAB","title":"繚嫈侯","surname":"劉","ming":"福","additional_names":[],"work_id":"w-shiji","book_id":"b-shiji-020","chapter_id":"table-chapter-shiji-020","source_id":"table-witness-shiji-020","source_revision":"2607036","table_id":"shiji-020","table_cell_id":"shiji-020-t1-r059-c06","person_mention_id":"shiji-020-t1-r059-c06-m000","references":[{"title":"《史記・東越列傳》相關爵官及舊爵","url":"https://zh.wikisource.org/w/index.php?title=史記/卷114&oldid=8735633","quote":"故越衍侯吳陽前在漢，漢使歸諭餘善，餘善弗聽。及橫海將軍先至，越衍侯吳陽以其邑七百人反，攻越軍於漢陽。從建成侯敖，與其率，從繇王居股謀曰：「餘善首惡，劫守吾屬。今漢兵至，眾彊，計殺餘善，自歸諸將，儻幸得脫。」乃遂俱殺餘善，以其眾降橫海將軍，故封繇王居股為東成侯，萬戶；封建成侯敖為開陵侯；封越衍侯吳陽為北石侯；封橫海將軍說為案道侯；封橫海校尉福為繚嫈侯。福者，成陽共王子，故為海常侯，坐法失侯。舊從軍無功，以宗室故侯。諸將皆無成功，莫封。東越將多軍，漢兵至，棄其軍降，封為無錫侯。","scope":"received_parallel_title_and_identity","image_verified":false}],"note":"姓劉名福據原表完整姓名；本傳未冠姓原字不改。山州故爵與海常失侯分源，不由頂端稱號補有效年。","status":"editorial_provisional","human_reviewed":false,"quote_passage_ref":"data/historical-tables/shiji-020.json"}],"mentions":[{"id":"c-shiji-114-dongyue:m009-0170","start":170,"end":171,"surface":"福","kind":"person","person_id":"yqp_nlb_p1p_ABFAB","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p009","chapter_id":"c-shiji-114-dongyue"},{"id":"c-shiji-114-dongyue:m009-0176","start":176,"end":177,"surface":"福","kind":"person","person_id":"yqp_nlb_p1p_ABFAB","status":"contextual_provisional","paragraph_id":"c-shiji-114-dongyue:p009","chapter_id":"c-shiji-114-dongyue"}],"relations":[{"id":"a-table-shiji021-chengyang-2","subject_person_id":"yqp_nlb_p1p_ABFAB","predicate":"father","object_person_id":"yqp_nlb_p1p_ABFA","status":"source_attested","evidence":[{"kind":"table_cell","relationship_layout":"first_holder_with_parent_label","table_id":"shiji-021","table_cell_id":"shiji-021-t1-r099-c01","subject_table_cell_id":"shiji-021-t1-r099-c03","subject_quote":"三。四年三月乙丑，侯劉福元年。","subject_mention_id":"shiji-021-t1-r099-c03-m000","object_mention_id":"shiji-021-t1-r099-c01-m000","work_id":