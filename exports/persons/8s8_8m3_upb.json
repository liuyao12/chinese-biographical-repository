atus":"contextual_provisional"},{"id":"c-shiji-121-rulin:m010-0234","start":234,"end":236,"surface":"景帝","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m010-0253","start":253,"end":255,"surface":"學者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m010-0257","start":257,"end":258,"surface":"湯","kind":"person","person_id":"l5k_25n_03y","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m010-0258","start":258,"end":259,"surface":"武","kind":"person","person_id":"6pa_648_s1q","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m010-0272","start":272,"end":274,"surface":"學者","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p011","text":"竇太后好老子書，召轅固生問老子書。固曰：「此是家人言耳。」太后怒曰：「安得司空城旦書乎？」乃使固入圈刺豕。景帝知太后怒而固直言無罪，乃假固利兵，下圈刺豕，正中其心，一刺，豕應手而倒。太后默然，無以復罪，罷之。居頃之，景帝以固為廉直，拜為清河王太傅。久之，病免。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m011-0000","start":0,"end":3,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0004","start":4,"end":6,"surface":"老子","kind":"person","person_id":"iwu_5oj_dcv","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0009","start":9,"end":12,"surface":"轅固生","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0013","start":13,"end":15,"surface":"老子","kind":"person","person_id":"iwu_5oj_dcv","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0017","start":17,"end":18,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0029","start":29,"end":31,"surface":"太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0047","start":47,"end":48,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0053","start":53,"end":55,"surface":"景帝","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0056","start":56,"end":58,"surface":"太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0060","start":60,"end":61,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0068","start":68,"end":69,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0091","start":91,"end":93,"surface":"太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0108","start":108,"end":110,"surface":"景帝","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m011-0111","start":111,"end":112,"surface":"固","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p013","text":"韓生者，燕人也。孝文帝時為博士，景帝時為常山王太傅。韓生推詩之意而為內外傳數萬言，其語頗與齊魯閒殊，然其歸一也。淮南賁生受之。自是之後，而燕趙閒言詩者由韓生。韓生孫商為今上博士。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m013-0000","start":0,"end":2,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0008","start":8,"end":11,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0016","start":16,"end":18,"surface":"景帝","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0026","start":26,"end":28,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0058","start":58,"end":60,"surface":"賁生","kind":"person","person_id":"lls_je1_d6d","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0076","start":76,"end":78,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0079","start":79,"end":81,"surface":"韓生","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0082","start":82,"end":83,"surface":"商","kind":"person","person_id":"r6c_fhk_jo9_*A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m013-0084","start":84,"end":86,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p020","text":"董仲舒，廣川人也。以治春秋，孝景時為博士。下帷講誦，弟子傳以久次相受業，或莫見其面，蓋三年董仲舒不觀於舍園，其精如此。進退容止，非禮不行，學士皆師尊之。今上即位，為江都相。以春秋災異之變推陰陽所以錯行，故求雨閉諸陽，縱諸陰，其止雨反是。行之一國，未嘗不得所欲。中廢為中大夫，居舍，著災異之記。是時遼東高廟災，主父偃疾之，取其書奏之天子。天子召諸生示其書，有刺譏。董仲舒弟子呂步舒不知其師書，以為下愚。於是下董仲舒吏，當死，詔赦之。於是董仲舒竟不敢復言災異。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m020-0000","start":0,"end":3,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0014","start":14,"end":16,"surface":"孝景","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0026","start":26,"end":28,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0045","start":45,"end":48,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0069","start":69,"end":71,"surface":"學士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0076","start":76,"end":78,"surface":"今上","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0154","start":154,"end":157,"surface":"主父偃","kind":"person","person_id":"65g_b5h_fvh","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0165","start":165,"end":167,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0168","start":168,"end":170,"surface":"天子","kind":"person","person_id":"o7s_89o_zka","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0171","start":171,"end":173,"surface":"諸生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0181","start":181,"end":184,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0184","start":184,"end":186,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m020-0186","start":186,"end":189,"surface":"呂步舒","kind":"person","person_id":"r6k_uj1_o5h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0203","start":203,"end":206,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m020-0217","start":217,"end":220,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p022","text":"胡毋生，齊人也。孝景時為博士，以老歸教授。齊之言春秋者多受胡毋生，公孫弘亦頗受焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m022-0000","start":0,"end":3,"surface":"胡毋生","kind":"person","person_id":"08q_8bd_lr8","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m022-0008","start":8,"end":10,"surface":"孝景","kind":"person","person_id":"8s8_8m3_upb","status":"contex