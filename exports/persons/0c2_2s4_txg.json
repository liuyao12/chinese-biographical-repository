rue,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-w076r-gz-yao","person_id":"0c2_2s4_txg","event_type":"death","source_term":"與賊戰沒","date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-guzhong","source_id":"s-jinshu-076-guzhong","paragraph_id":"c-jinshu-076-guzhong:line120","quote":"峻遣將弘徽領甲卒五百，鼓行而前。衆與颺、悊要擊徽，戰于高莋，大破之，收其軍實。謨以冰當還任，故便去郡。衆遣颺率諸軍屯無錫。冰至，鎮禦亭，恐賊從海虞道入，衆自往備之。而賊率張健、馬流攻無錫，颺等大敗，庚冰亦失守，健等遂據吳城。衆自海虞由婁縣東倉與賊別率交戰，破之，義軍又集進屯烏苞。會稽內史王舒、吳興內史虞潭並檄衆為五郡大督護，統諸義軍討健。潭遣將姚休為衆前鋒，與賊戰沒。衆還守紫壁。","person_mention_id":"c-jinshu-076-guzhong:line120:m0173"}],"interpretation_note":"依本來源登記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-076-guzhong:line120:m0173","start":173,"end":175,"surface":"姚休","kind":"person","person_id":"0c2_2s4_txg","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-guzhong:line120","chapter_id":"c-jinshu-076-guzhong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-guzhong:line120","text":"峻遣將弘徽領甲卒五百，鼓行而前。衆與颺、悊要擊徽，戰于高莋，大破之，收其軍實。謨以冰當還任，故便去郡。衆遣颺率諸軍屯無錫。冰至，鎮禦亭，恐賊從海虞道入，衆自往備之。而賊率張健、馬流攻無錫，颺等大敗，庚冰亦失守，健等遂據吳城。衆自海虞由婁縣東倉與賊別率交戰，破之，義軍又集進屯烏苞。會稽內史王舒、吳興內史虞潭並檄衆為五郡大督護，統諸義軍討健。潭遣將姚休為衆前鋒，與賊戰沒。衆還守紫壁。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-guzhong:line120:m0000","start":0,"end":1,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line120:m0003","start":3,"end":5,"surface":"弘徽","kind":"person","person_id":"875_36b_0ca","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jins