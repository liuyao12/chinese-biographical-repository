{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"zlv_jok_rba","canonical_person_id":"zlv_jok_rba","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["zlv_jok_rba"],"persons":[{"id":"zlv_jok_rba","label":"杜少（酷吏列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"杜少","mention_ids":["c-shiji-122-kuli:m037-0062"]}],"evidence":[{"mention_id":"c-shiji-122-kuli:m037-0062","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p037","quote":"杜少"}]}],"source_mention_summary":[{"source_id":"s-shiji122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","chapter_id":"c-shiji-122-kuli","mention_count":1,"mention_ids":["c-shiji-122-kuli:m037-0062"],"paragraph_ids":["c-shiji-122-kuli:p037"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji122-kuli"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m037-0062","start":62,"end":64,"surface":"杜少","kind":"person","person_id":"zlv_jok_rba","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p037","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p037","text":"自温舒等以惡爲治，而郡守、都尉、諸侯二千石欲爲治者，其治大抵盡放温舒，而吏民益輕犯法，盜賊滋起。南陽有梅免、白政，楚有殷中、杜少，齊有徐勃，燕趙之閒有堅盧、范生之屬。大群至數千人，擅自號，攻城邑，取庫兵，釋死罪，縛辱郡太守、都尉，殺二千石，爲檄告縣趣具食；小群以百數，掠鹵鄕里者，不可勝數也。於是天子始使御史中丞、丞相長史督之。猶弗能禁也，乃使光祿大夫范昆、諸輔都尉及故九卿張德等衣繡衣，持節，虎符發兵以興撃，斬首大部或至萬餘級，及以法誅通飲食，坐連諸郡，甚者數千人。數歳，乃頗得其渠率。散卒失亡，復聚黨阻山川者，往往而群居，無可柰何。於是作「沈命法」，曰群盜起不發覺，發覺而捕弗滿品者，二千石以下至小吏主者皆死。其後小吏畏誅，雖有盜不敢發，恐不能得，坐課累府，府亦使其不言。故盜賊寖多，上下相爲匿，以文辭避法焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m037-0001","start":1,"end":3,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0010","start":10,"end":12,"surface":"郡守","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m037-0013","start":13,"end":15,"surface":"都尉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-122-kuli:m037-0032","start":32,"end":34,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0051","start":51,"end":53,"surface":"梅免","kind":"person","person_id":"vws_wz0_hsv","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0054","start":54,"end":56,"surface":"白政","kind":"person","person_id":"438_hqd_ydb","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0059","start":59,"end":61,"surface":"殷中","kind":"person","person_id":"xuq_4z2_6go","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0062","start":62,"end":64,"surface":"杜少","kind":"person","person_id":"zlv_jok_rba","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0067","start":67,"end":69,"surface":"徐勃","kind":"person","person_id":"lry_byk_0kt","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0075","start":75,"end":77,"surface":"堅盧","kind":"person","person_id":"8ej_u7b_qpl","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0078","start":78,"end":80,"surface":"范生","kind":"person","person_id":"tem_nwk_wxr","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m037-0108","start":108,"end":111,"surface":"郡太守","kind":"unresolved","person_id":null,"st