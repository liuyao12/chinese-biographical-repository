。初為黃門侍郎，出領部曲，拜偏將軍。凱亡後，入為太子中庶子。右國史華覈表薦禕曰：\"禕體質方剛，器干強固，董率之才，魯肅不過。及被召當下，逕還赴都，道由武昌，曾不回顧，器械軍資，一無所取，在戎果毅，臨財有節。夫夏口，賊之沖要，直選名將以鎮戍之，臣竊思惟，莫善於禕。\"","person_mention_id":"c-sanguozhi-061-lukai:line044:m0037"}],"attestations":[{"id":"t-wu061-t-wu061-lukai19:a","paragraph_id":"c-sanguozhi-061-lukai:line044","person_mention_id":"c-sanguozhi-061-lukai:line044:m0037","start":34,"end":37,"surface":"右國史","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null},{"id":"t-wu061-t-wu061-luyin8","person_id":"idb_k2n_p9s","kind":"office","title":"中書丞","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-061","chapter_id":"c-sanguozhi-061-luyin","source_id":"s-sanguozhi-061-luyin","paragraph_id":"c-sanguozhi-061-luyin:line068","quote":"　　永安元年，徵為西陵督，封都亭侯，後轉左虎林。中書丞華覈表薦胤曰：","person_mention_id":"c-sanguozhi-061-luyin:line068:m0027"}],"attestations":[{"id":"t-wu061-t-wu061-luyin8:a","paragraph_id":"c-sanguozhi-061-luyin:line068","person_mention_id":"c-sanguozhi-061-luyin:line068:m0027","start":24,"end":27,"surface":"中書丞","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"person_references":[{"id":"c-sanguozhi-053-xueying:line066:r0118","paragraph_id":"c-sanguozhi-053-xueying:line066","start":118,"end":119,"surface":"臣","person_id":"idb_k2n_p9s","referent_role":"speaker_self","quote":"、薛瑩、梁廣及臣五人，訪求往事","note":"依對話說話者、受書者及上下句定位。","chapter_id":"c-sanguozhi-053-xueying","book_id":"b-sanguozhi-053","work_id":"w-sanguozhi","source_id":"s-sanguozhi-053-xueying"},{"id":"c-sanguozhi-053-xueying:line066:r0171","paragraph_id":"c-sanguozhi-053-xueying:line066","start":171,"end":172,"surface":"臣","person_id":"idb_k2n_p9s","referent_role":"speaker_self","quote":"，迄今末撰奏。臣愚淺才劣，適可","note":"依對話說話者、受書者及上下句定位。","chapter_id":"c-sanguozhi-053-xueying","book_id":"b-sanguozhi-053","work_id":"w-sanguozhi","source_id":"s-sanguozhi-053-xueying"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-zhouzhao-complete:line120","text":"周昭者字恭遠，與韋曜、薛瑩、華覈並述《呉書》，後爲中書郎，坐事下獄，覈表救之，孫休不聽，遂伏法云。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0000","start":0,"end":2,"surface":"周昭","kind":"person","person_id":"5sl_p6s_iab","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0004","start":4,"end":6,"surface":"恭遠","kind":"person","person_id":"5sl_p6s_iab","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0008","start":8,"end":10,"surface":"韋曜","kind":"person","person_id":"4qw_13i_jn6","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0011","start":11,"end":13,"surface":"薛瑩","kind":"person","person_id":"57a_8f8_a32","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0014","start":14,"end":16,"surface":"華覈","kind":"person","person_id":"idb_k2n_p9s","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0034","start":34,"end":35,"surface":"覈","kind":"person","person_id":"idb_k2n_p9s","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhouzhao-complete:line120:m0039","start":39,"end":41,"surface":"孫休","kind":"person","person_id":"0fo_c5c_4yh","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":120,"l