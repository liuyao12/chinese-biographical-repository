ings":[{"id":"th-shiji031-008","person_id":"78u_8ii_bnr_A","title":"卿","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p024","quote":"闔廬乃以專諸子爲卿。"}],"attestations":[{"id":"th-shiji031-008:a001","paragraph_id":"c-shiji-031-wu:p024","start":308,"end":309,"surface":"卿","person_mention_id":"c-shiji-031-wu:m024-0306","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-031-wu","source_id":"s-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p024","quote":"闔廬乃以專諸子爲卿。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源授予、自立與用稱分開；日期只錄原表述，不以死亡自動終止官爵。夫槩自立與闔廬爭位分存，不選唯一合法王號。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji086-004","person_id":"78u_8ii_bnr_A","title":"上卿","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote_passage_ref":"data/corpus/shiji/086.json"}],"attestations":[{"id":"th-shiji086-004:a001","paragraph_id":"c-shiji-086-cike:p007","start":163,"end":165,"surface":"上卿","person_mention_id":"c-shiji-086-cike:m007-0157","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"四月丙子","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote_passage_ref":"data/corpus/shiji/086.json"}],"normalized_date":{"era":"BCE","era_year":515,"year":-514,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote_passage_ref":"data/corpus/shiji/086.json"}],"references":[{"title":"《史記·十二諸侯年表》原紀年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","quote":"十二公子光使專諸殺僚，自立。","scope":"received_parallel_event","image_verified":false,"table_cell_id":"shiji-014-r327-c15"},{"title":"《史記·十二諸侯年表》數位年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","quote":"515","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"table_cell_id":"shiji-014-r327-c00"}],"rationale":"按本篇具體事件與固定年表原格對讀；西元數字取數位編者附加對照，不是受傳文本原有紀年。未核書影或曆表，只到年，不換算月日。 封專諸子屬刺僚後光自立的同段事件序列；只採同年暫定，不據四月丙子推授卿同日。","reviewer":"Codex（AI 代理）","human_reviewed":false,"basis":{"kind":"parallel_event","source_event_quote":"闔閭乃封專諸之子以爲上卿","reference_url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","reference_event_quote":"十二公子光使專諸殺僚，自立。","reference_year_quote":"515"}}},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任與文獻用稱分存；四月丙子依本段事件，不換算絕對年。皇帝其明年保留相對日期；上客為禮遇。懸賞金邑、職稱首見、死亡、被虜或亡逃不推定任期起訖。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[{"era":"BCE","era_year":515,"year":-514,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","quote_passage_ref":"data/corpus/shiji/086.json"}],"references":[{"title":"《史記·十二諸侯年表》原紀年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","quote":"十二公子光使專諸殺僚，自立。","scope":"received_parallel_event","image_verified":false,"table_cell_id":"shiji-014-r327-c15"},{"title":"《史記·十二諸侯年表》數位年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷