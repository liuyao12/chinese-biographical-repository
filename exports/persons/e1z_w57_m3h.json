onnection":"father","parent_person_id":"e1z_w57_m3h","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-teng","source_id":"s-sanguozhi-050-teng","paragraph_id":"c-sanguozhi-050-teng:line062","quote":"孫皓滕夫人，故太常胤之族女也。胤夷滅，夫人父牧，以疏遠徙邊郡。孫休即位，大赦，得還，以牧為五官中郎。皓既封烏程侯，聘牧女為妃。皓即位，立為皇后，封牧高密侯，拜衛將軍，錄尚書事。後朝士以牧尊戚，頗推令諫爭。而夫人寵漸衰，皓滋不悅，皓母何恆左右之。又太史言，於運歷，后不可易，皓信巫覡，故得不廢，常供養昇平宮。牧見遣居蒼梧郡，雖爵位不奪，其實裔也，遂道路憂死。長秋官僚，備員而已，受朝賀表疏如故。而皓內諸寵姬，佩皇后璽紱者多矣。天紀四年，隨皓遷於洛陽。","source_term":"夫人父牧"}],"source_assertion_id":"a-wu050-teng-0","interpretation_note":"本句所記父子；識別後綴不表示長幼。","reviewer":"Codex（AI 代理）"}}],"source_mention_summary":[{"source_id":"s-sanguozhi-050-teng","work_id":"w-sanguozhi","book_id":"b-sanguozhi-050","chapter_id":"c-sanguozhi-050-teng","raw_mention_count":6,"mention_ids":["c-sanguozhi-050-teng:line062:m0022","c-sanguozhi-050-teng:line062:m0043","c-sanguozhi-050-teng:line062:m0058","c-sanguozhi-050-teng:line062:m0073","c-sanguozhi-050-teng:line062:m0092","c-sanguozhi-050-teng:line062:m0153"],"paragraph_ids":["c-sanguozhi-050-teng:line062"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-050-teng:line062:m0022","mention_ids":["c-sanguozhi-050-teng:line062:m0022"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-050-teng:line062:m0043","mention_ids":["c-sanguozhi-050-teng:line062:m0043"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-050-teng:line062:m0058","mention_ids":["c-sanguozhi-050-teng:line062:m0058"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-050-teng:line062:m0073","mention_ids":["c-sanguozhi-050-teng:line062:m0073"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-050-teng:line062:m0092","mention_ids":["c-sanguozhi-050-teng:line062:m0092"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-050-teng:line062:m0153","mention_ids":["c-sanguozhi-050-teng:line062:m0153"],"kind":"paragraph"}],"mention_co