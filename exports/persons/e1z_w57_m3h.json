ion","person_id":"e1z_w57_m3h","attestations":[{"id":"th-sanguozhi-065-wangfan-complete-3-70:a","paragraph_id":"c-sanguozhi-065-wangfan-complete:p003","start":70,"end":73,"surface":"衛將軍","person_mention_id":"c-sanguozhi-065-wangfan-complete:p003:m0073","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-065","chapter_id":"c-sanguozhi-065-wangfan-complete","source_id":"s-sanguozhi-065-wangfan-complete-ws2589669","paragraph_id":"c-sanguozhi-065-wangfan-complete:p003","quote":"　　甘露二年，丁忠使晉還，皓大會群臣，蕃沉醉頓伏。皓疑而不悅，舉蕃出外。頃之請還，酒亦不解。蕃性有威嚴，行止自若，皓大怒，呵左右於殿下斬之。衛將軍滕牧、征西將軍留平請，不能得。","person_mention_id":"c-sanguozhi-065-wangfan-complete:p003:m0073"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-048-sun-hao:p002","text":"元興元年八月，以上大將軍施績、大將軍丁奉爲左右大司馬，張布爲驃騎將軍，加侍中，諸增位班賞，一皆如舊。九月，貶太后爲景皇后，追謚父和曰文皇帝，尊母何爲太后。十月，封休太子𩅦爲豫章王，次子汝南王，次子梁王，次子陳王，立皇后滕氏。皓旣得志，麤暴驕盈，多忌諱，好酒色，大小失望。興、布竊悔之。或以譖皓，十一月，誅興、布。十二月，孫休葬定陵。封后父滕牧爲高密侯，舅何洪等三人皆列侯。是歲，魏置交阯太守之郡。晉文帝爲魏相國，遣昔吳壽春城降將徐紹、孫彧銜命齎書，陳事勢利害，以申喻皓。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":56,"last_line":56,"raw_start":7561,"raw_end":8494,"raw_character_offsets":[7573,7574,7575,7576,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653,7654,76