ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-luzhi:line064:m0104","start":104,"end":106,"surface":"劉陶","kind":"person","person_id":"icd_he2_xzh","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-luzhi:line064","chapter_id":"c-jinshu-044-luzhi"},{"id":"c-jinshu-059-prince-ying:p008:m0127","surface":"劉陶","start":127,"end":129,"person_id":"icd_he2_xzh","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-ying:p008","chapter_id":"c-jinshu-059-prince-ying"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-luzhi:line064","text":"及東海王越奉迎大駕，顒啟帝復穎還鄴，以志為魏郡太守，加左將軍，隨穎北鎮。行達洛陽，而平昌公模遣前鋒督護馮嵩距穎。穎還長安，未至而聞顒斬張方，求和於越。穎住華陰，志進長安，詣闕陳謝，即還就穎于武關。奔南陽，復為劉陶所驅，回詣河北。及穎薨，官屬奔散，唯志親自殯送，時人嘉之。越命志為軍諮祭酒，遷衛尉，永嘉末，轉尚書。洛陽沒，志將妻子北投并州刺史劉琨。至陽邑，為劉粲所虜，與次子謐、詵等俱遇害於平陽。長子諶。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luzhi:line064:m0001","start":1,"end":5,"surface":"東海王越","kind":"person","person_id":"9o2_vhv_r7y","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0010","start":10,"end":11,"surface":"顒","kind":"person","person_id":"ed0_313_bea","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0014","start":14,"end":15,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0019","start":19,"end":20,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line064:m0032","start":32,"end":33,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"context