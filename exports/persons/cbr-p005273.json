{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005273","identity_policy":"contextual_provisional","person_ids":["cbr-p005273"],"persons":[{"id":"cbr-p005273","label":"王武（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"王武","mention_ids":["c-shiji-095-fankuang:m005-0134","c-shiji-095-fankuang:m024-0039","c-shiji-095-fankuang:m024-0251","c-shiji-095-fankuang:m024-0275"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m005-0134","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p005","quote":"王武"},{"mention_id":"c-shiji-095-fankuang:m024-0039","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p024","quote":"王武"},{"mention_id":"c-shiji-095-fankuang:m024-0251","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p024","quote":"王武"},{"mention_id":"c-shiji-095-fankuang:m024-0275","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p024","quote":"王武"}]}],"source_mention_summary":[{"source_id":"s-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","chapter_id":"c-shiji-095-fankuang","mention_count":4,"mention_ids":["c-shiji-095-fankuang:m005-0134","c-shiji-095-fankuang:m024-0039","c-shiji-095-fankuang:m024-0251","c-shiji-095-fankuang:m024-0275"],"paragraph_ids":["c-shiji-095-fankuang:p005","c-shiji-095-fankuang:p024"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-095-fankuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m005-0134","start":134,"end":136,"surface":"王武","kind":"person","person_id":"cbr-p005273","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p005","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m024-0039","start":39,"end":41,"surface":"王武","kind":"person","person_id":"cbr-p005273","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p024","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m024-0251","start":251,"end":253,"surface":"王武","kind":"person","person_id":"cbr-p005273","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p024","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m024-0275","start":275,"end":277,"surface":"王武","kind":"person","person_id":"cbr-p005273","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p024","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-023","person_id":"cbr-p005273","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["王武"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p005","quote":"還定三秦，別擊西丞白水北，雍輕車騎於雍南，破之。從攻雍、斄城，先登。擊章平軍好畤，攻城，先登陷陣，斬縣令丞各一人，首十一級，虜二十人，遷郎中騎將。從擊秦車騎壤東，卻敵，遷為將軍。攻趙賁，下郿、槐裏、柳中、咸陽；灌廢丘，最。至櫟陽，賜食邑杜之樊鄉。從攻項籍，屠煮棗。擊破王武、程處軍於外黃。攻鄒、魯、瑕丘、薛。項羽敗漢王於彭城，盡復取魯、梁地。噲還至滎陽，益食平陰二千戶，以將軍守廣武。一歲，項羽引而東。從高祖擊項籍，下陽夏，虜楚周將軍卒四千人。圍項籍於陳，大破之。屠胡陵。"},{"paragraph_id":"c-shiji-095-fankuang:p024","quote":"復以中謁者從降下碭，以至彭城。項羽擊，大破漢王。漢王遁而西，嬰從還，軍於雍丘。王武、魏公申徒反，從擊破之。攻下黃，西收兵，軍於滎陽。楚騎來眾，漢王乃擇軍中可為（車）騎將者，皆推故秦騎士重泉人李必、駱甲習騎兵，今為校尉，可為騎將。漢王欲拜之，必、甲曰：「臣故秦民，恐軍不信臣，臣願得大王左右善騎者傅之。」灌嬰雖少，然數力戰，乃拜灌嬰為中大夫，令李必、駱甲為左右校尉，將郎中騎兵擊楚騎於滎陽東，大破之。受詔別擊楚軍後，絕其餉道，起陽武至襄邑。擊項羽之將項冠於魯下，破之，所將卒斬右司馬、騎將各一人。擊破柘公王武，軍於燕西，所將卒斬樓煩將五人，連尹一人。擊王武別將桓嬰白馬下，破之，所將卒斬都尉一人。以騎渡河南，送漢王到雒陽，使北迎相國韓信軍於邯鄲。還至敖倉，嬰遷為御史大夫。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p005","text":"還定三秦，別擊西丞白水北，雍輕車騎於雍南，破之。從攻雍、斄城，先登。擊章平軍好畤，攻城，先登陷陣，斬縣令丞各一人，首十一級，虜二十人，遷郎中騎將。從擊秦車騎壤東，卻敵，遷為將軍。攻趙賁，下郿、槐裏、柳中、咸陽；灌廢丘，最。至櫟陽，賜食邑杜之樊鄉。從攻項籍，屠煮棗。擊破王武、程處軍於外黃。攻鄒、魯、瑕丘、薛。項羽敗漢王於彭城，盡復取魯、梁地。噲還至滎陽，益食平陰二千戶，以將軍守廣武。一歲，項羽引而東。從高祖擊項籍，下陽夏，虜楚周將軍卒四千人。圍項籍於陳，大破之。屠胡陵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m005-0035","start":35,"end":37,"surface":"章平","kind":"person","person_id":"cbr-p005272","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0090","start":90,"end":92,"surface":"趙賁","kind":"person","person_id":"cbr-p005256","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0125","start":125,"end":127,"surface":"項籍","kind":"person","person_id":"cbr-p005258","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0134","start":134,"end":136,"surface":"王武","kind":"person","person_id":"cbr-p005273","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0137","start":137,"end":139,"surface":"程處","kind":"person","person_id":"cbr-p005274","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0154","start":154,"end":156,"surface":"項羽","kind":"person","person_id":"cbr-p005258","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0157","start":157,"end":159,"surface":"漢王","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0171","start":171,"end":172,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0195","start":195,"end":197,"surface":"項羽","kind":"person","person_id":"cbr-p005258","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0202","start":202,"end":204,"surface":"高祖","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0205","start":205,"end":207,"surface":"項籍","kind":"person","person_id":"cbr-p005258","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0214","start":214,"end":217,"surface":"周將軍","kind":"person","person_id":"cbr-p005267","status":"contextual_provisional"},{"id":"c-shij