i-125-ningxing:p003","chapter_id":"c-shiji-125-ningxing"},{"id":"c-shiji-125-ningxing:m003-0133","start":133,"end":136,"surface":"江都王","kind":"person","person_id":"sj1_tvz_ilh","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p003","chapter_id":"c-shiji-125-ningxing"},{"id":"c-shiji-125-ningxing:m003-0161","start":161,"end":164,"surface":"江都王","kind":"person","person_id":"sj1_tvz_ilh","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p003","chapter_id":"c-shiji-125-ningxing"}],"relations":[],"title_holdings":[{"id":"th-shiji125-010","person_id":"sj1_tvz_ilh","title":"江都王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-125-ningxing","source_id":"s-shiji125-ningxing","paragraph_id":"c-shiji-125-ningxing:p003","quote":"嫣者，弓高侯孽孫也。今上為膠東王時，嫣與上學書相愛。及上為太子，愈益親嫣。嫣善騎射，善佞。上即位，欲事伐匈奴，而嫣先習胡兵，以故益尊貴，官至上大夫，賞賜擬於鄧通。時嫣常與上臥起。江都王入朝，有詔得從入獵上林中。天子車駕蹕道未行，而先使嫣乘副車，從數十百騎，騖馳視獸。江都王望見，以為天子，辟從者，伏謁道傍。嫣驅不見。既過，江都王怒，為皇太后泣曰：「請得歸國入宿衛，比韓嫣。」太后由此嗛嫣。嫣侍上，出入永巷不禁，以姦聞皇太后。皇太后怒，使使賜嫣死。上為謝，終不能得，嫣遂死。而案道侯韓說，其弟也，亦佞幸。"}],"attestations":[{"id":"th-shiji125-010:a001","paragraph_id":"c-shiji-125-ningxing:p003","start":89,"end":92,"surface":"江都王","person_mention_id":"c-shiji-125-ningxing:m003-0089","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示官爵或稱號用語按原字存錄；官至不作初任年，用稱不作授予，未知起訖保持未知。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-125-ningxing:p003","text":"嫣者，弓高侯孽孫也。今上為膠東王時，嫣與上學書相愛。及上為太子，愈益親嫣。嫣善騎射，善佞。上即位，欲事伐匈奴，而嫣先習胡兵，以故益尊貴，官至上大夫，賞賜擬於鄧通。時嫣常與上臥起。江都王入朝，有詔得從入獵上林中。天子車駕蹕道未行，而先使嫣乘副車，從數十百騎，騖馳視獸。江都王望見，以為天子，辟從者，伏謁道傍。嫣驅不見。既過，江都王怒，為皇太后泣曰：「請得歸國入宿衛，比韓嫣。」太后由此嗛嫣。嫣侍上，出入永巷不禁，以姦聞皇太后。皇太后怒，使使賜嫣死。上為謝，終不能得，嫣遂死。而案道侯韓說，其弟也，亦佞幸。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-125-ningxing:m003-0000","start":0,"end":1,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0003","start":3,"end":6,"surface":"弓高侯","kind":"person","person_id":"l9e_fbr_36a_*AB","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0010","start":10,"end":12,"surface":"今上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0018","start":18,"end":19,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0020","start":20,"end":21,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0027","start":27,"end":28,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0035","start":35,"end":36,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0037","start":37,"end":38,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0045","start":45,"end":46,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0056","start":56,"end":57,"surface":"嫣","kind":"person","person_id":"l9e_fbr_36a_*AB*A","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0070","start":70,"end":71,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-125-ningxing:m003-0078","start":78,"end":80,"surface":"鄧通","kind":"person","person_id":"qow_wy0_7d2","status":"contextual_provisional"},{"id":"c-shiji-125-n