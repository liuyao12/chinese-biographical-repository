ji-036-chenqi:m017-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"cbr-p001490","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p017","chapter_id":"c-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:m017-0170","start":170,"end":173,"surface":"太子午","kind":"person","person_id":"cbr-p001490","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p017","chapter_id":"c-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:m017-0187","start":187,"end":189,"surface":"成公","kind":"person","person_id":"cbr-p001490","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p017","chapter_id":"c-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:m018-0033","start":33,"end":35,"surface":"成公","kind":"person","person_id":"cbr-p001490","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p018","chapter_id":"c-shiji-036-chenqi"}],"relations":[{"id":"a-shiji036-033","subject_person_id":"cbr-p001490","predicate":"father","object_person_id":"cbr-p001485","status":"source_attested","evidence":[{"chapter_id":"c-shiji-036-chenqi","source_id":"s-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p016","quote":"十四年，靈公與其大夫孔寧、儀行父皆通於夏姬，衷其衣以戲於朝。泄冶諫曰：「君臣淫亂，民何效焉？」靈公以告二子，二子請殺泄冶，公弗禁，遂殺泄冶。十五年，靈公與二子飲於夏氏。公戲二子曰：「徵舒似汝。」二子曰：「亦似公。」徵舒怒。靈公罷酒出，徵舒伏弩廏門射殺靈公。孔寧、儀行父皆奔楚，靈公太子午奔晉。徵舒自立為陳侯。徵舒，故陳大夫也。夏姬，御叔之妻，舒之母也。"}],"qualifiers":{"source_term":"靈公太子午","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示子、生、妻、兄弟及祖先原稱；不由繼位補父子，不把舜／禹之後改直接父親，不補世系闕代或同父同母。未核底本與現代研究，來源主張不表示已確證史實。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji036-036","subject_person_id":"cbr-p001403","predicate":"father","object_person_id":"cbr-p001490","status":"source_attested","evidence":[{"chapter_id":"c-shiji-036-chenqi","source_id":"s-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p018","quote":"二十八年，楚莊王卒。二十九年，陳倍楚盟。三十年，楚共王伐陳。是歲，成公卒，子哀公弱立。楚以陳喪，罷兵去。"}],"qualifiers":{"source_term":"子哀公弱","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示子、生、妻、兄弟及祖先原稱；不由繼位補父子，不把舜／禹之後改直接父親，不補世系闕代或同父同母。未核底本與現代研究，來源主張不表示已確證史實。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji036-020","person_id":"cbr-p001490","title":"成公","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-036-chenqi","source_id":"s-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p017","quote":"成公元年冬，楚莊王為夏徵舒殺靈公，率諸侯伐陳。謂陳曰：「無驚，吾誅徵舒而已。」已誅徵舒，因縣陳而有之，群臣畢賀。申叔時使於齊來還，獨不賀。莊王問其故，對曰：「鄙語有之，牽牛徑人田，田主奪之牛。徑則有罪矣，奪之牛，不亦甚乎？今王以徵舒為賊弒君，故徵兵諸侯，以義伐之，已而取之，以利其地，則後何以令於天下！是以不賀。」莊王曰：「善。」乃迎陳靈公太子午於晉而立之，復君陳如故，是為成公。孔子讀史記至楚復陳，曰：「賢哉楚莊王！輕千乘之國而重一言。」"}],"attestations":[{"id":"th-shiji036-020:a001","paragraph_id":"c-shiji-036-chenqi:p017","start":0,"end":2,"surface":"成公","person_mention_id":"c-shiji-036-chenqi:m017-0000","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"侯、公及諡號等暫作敘事追稱，不把繼位當當時授予諡號；未知曆日與終點不按卒日補造。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji036-056","person_id":"cbr-p001490","title":"太子","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-036-chenqi","source_id":"s-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p016","quote":"靈公太子午奔晉。"}],"attestations":[{"id":"th-shiji036-056:a001","paragraph_id":"c-shiji-036-chenqi:p016","start":140,"end":142,"surface":"太子","person_mention_id":"c-shiji-036-chenqi:m016-0140","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"太子午用稱，奔晉不是初授或自動廢太子日期。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji036-089","person_id":"cbr-p001490","surfaces":["太子午","成公"],"scope":"same_chapter","chapter_ids":["c-shiji-036-chenqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-036-chenqi:p016","quote":"十四年，靈公與其大夫孔寧、儀行父皆通於夏姬，衷其衣以戲於朝。泄冶諫曰：「君臣淫亂，民何效焉？」靈公以告二子，二子請殺泄冶，公弗禁，遂殺泄冶。十五年，靈公與二子飲於夏氏。公戲二子曰：「徵舒似汝。」二子曰：「亦似公。」徵舒怒。靈公罷酒出，徵舒伏弩廏門射殺靈公。孔寧、儀行父皆奔楚，靈公太子午奔晉。徵舒自立為陳侯。徵舒，故陳大夫也。夏姬，御叔之妻，舒之母也。"},{"paragraph_id":"c-shiji-036-chenqi:p017","quote":"成公元年冬，楚莊王為夏徵舒殺靈公，率諸侯伐陳。謂陳曰：「無驚，吾誅徵舒而已。」已誅徵舒，因縣陳而有之，群臣畢賀。申叔時使於齊來還，獨不賀。莊王問其故，對曰：「鄙語有之，牽牛徑人田，田主奪之牛。徑則有罪矣，奪之牛，不亦甚乎？今王以徵舒為賊弒君，故徵兵諸侯，以義伐之，已而取之，以利其地，則後何以令於天下！是以不賀。」莊王曰：「善。」乃迎陳靈公太子午於晉而立之，復君陳如故，是為成公。孔子讀史記至楚復陳，曰：「賢哉楚莊王！輕千乘之國而重一言。」"},{"paragraph_id":"c-shiji-036-chenqi:p018","quote":"二十八年，楚莊王卒。二十九年，陳倍楚盟。三十年，楚共王伐陳。是歲，成公卒，子哀公弱立。楚以陳喪，罷兵去。"}],"rationale":"本篇第16、17、18段按明示名與稱號、陳／杞世系及具體敘事暫定「太子午／成公」同指；引句均保留，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-036-chenqi:p016","text":"十四年，靈公與其大夫孔寧、儀行父皆通於夏姬，衷其衣以戲於朝。泄冶諫曰：「君臣淫亂，民何效焉？」靈公以告二子，二子請殺泄冶，公弗禁，遂殺泄冶。十五年，靈公與二子飲於夏氏。公戲二子曰：「徵舒似汝。」二子曰：「亦似公。」徵舒怒。靈公罷酒出，徵舒伏弩廏門射殺靈公。孔寧、儀行父皆奔楚，靈公太子午奔晉。徵舒自立為陳侯。徵舒，故陳大夫也。夏姬，御叔之妻，舒之母也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m016-0004","start":4,"end":6,"surface":"靈公","kind":"person","person_id":"cbr-p001485","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m016-0010","start":10,"end":12,"surface":"孔寧","kind":"person","person_id":"cbr-p001486","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m016-0013","start":13,"end":16,"surface":"儀行父","kind":"person","person_id":"cbr-p001487","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m016-0019","start":19,"end":21,"surface":"夏姬","kind":"person","person_id":"cbr-p001488","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m016-0030","start":30,"end":32,"surface":"泄冶","kind":"person","person_id":"cbr-p001489","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m016-0047","start":47,"end":49,"surface":"靈公","kind":"person","person_id":"cbr-p001485","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m016-0058","start":58,