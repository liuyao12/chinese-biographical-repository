古人闔棺而定諡，《春秋》大居正，崇王父之命，未有受戮於天子而圖形於群下。」命削去之。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-wenqiao:line030:m0004","start":4,"end":5,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0006","start":6,"end":8,"surface":"王導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0009","start":9,"end":11,"surface":"郗鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0012","start":12,"end":14,"surface":"庾亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0015","start":15,"end":17,"surface":"陸曄","kind":"person","person_id":"h07_7e5_0jk","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0018","start":18,"end":20,"surface":"卞壼","kind":"person","person_id":"4z4_ujq_8yo","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0031","start":31,"end":33,"surface":"蘇峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0047","start":47,"end":49,"surface":"陶侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0065","start":65,"end":66,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0077","start":77,"end":79,"surface":"應詹","kind":"person","person_id":"4kn_kz5_zrm","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0112","start":112,"end":115,"surface":"徐孺子","kind":"person","person_id":"gnp_pzu_b4z","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0201","start":201,"end":203,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0209","start":209,"end":210,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line030:m0221","start":221,"end":223,"surface":"崔杼","kind":"person","person_id":"xgd_r31_cmr","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":30,"last_line":30,"revision_id":2592755},"source_quote":{"witness":"j67","quote":"帝疾篤，嶠與王導、郗鑒、庾亮、陸曄、卞壼等同受顧命。時歷陽太守蘇峻藏匿亡命，朝廷疑之。征西將軍陶侃有威名於荊楚，又以西夏為虞，故使嶠為上流形援。咸和初，代應詹為江州刺史、持節、都督、平南將軍，鎮武昌，甚有惠政，甄異行能，親祭徐孺子之墓。又陳豫章十郡之要，宜以刺史居之。尋陽濱江，都督應鎮其地。今以州帖府，進退不便。且古鎮將多不領州，皆以文武形勢不同故也。宜選單車刺史別撫豫章，專理黎庶。」詔不許。在鎮見王敦畫像，曰：「敦大逆，宜加斲棺之戮，受崔杼之刑。古人闔棺而定諡，《[[春秋]]》大居正，崇王父之命，未有受戮於天子而圖形於群下。」命削去之。","raw_start":2791,"raw_end":3063,"raw_line":30},"chapter_id":"c-jinshu-067-wenqiao","book_id":"b-jinshu-067","work_id":"w-jinshu","source_id":"s-jinshu-067-wenqiao"},{"id":"c-jinshu-098-jin033-wangji:line047","text":"及帝崩，太甯元年，敦諷朝廷徵己，明帝乃手詔徵之，語在《明帝紀》。又使兼太常應詹拜授加黃龯，班劍武賁二十人，奏事不名，入朝不趨，劍覆上殿。敦移鎮姑孰，帝使侍中阮孚齎牛酒犒勞，敦稱疾不見，使主簿受詔。以王導為司徒，敦自為揚州牧。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line047:m0009","start":9,"end":10,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line047:m0016","start":16,"end":18,"surface":"明帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line047:m0027","start":27,"end":29,"surface":"明帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line047:m0037","start":37,"end":39,"surface":"應詹","kind":"person","person_id":"4kn_kz5_zrm","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line047:m0068","start":68,"end":69,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line047:m0078","start":78,"end":80,"surface":"阮孚","kind":"person","person_id":"cui_d13_g21","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line047:m0086","start":86,"end":87,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line047:m0099","start":99,"end":101,"surface":"王導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line047:m0105","start":105,"end":106,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":47,"last_line":47,"revision_id":2614273},"source_quote":{"witness":"j98","quote":"及帝崩，太甯元年，敦諷朝廷徵己，明帝乃手詔徵之，語在《明帝紀》。又使兼太常應詹拜授加黃龯，班劍武賁二十人，奏事不名，入朝不趨，劍覆上殿。敦移鎮姑孰，帝使侍中阮孚齎牛酒犒勞，敦稱疾不見，使主簿受詔。以王導為司徒，敦自為揚州牧。","raw_start":3887,"raw_end":3999,"raw_line":47},"chapter_id":"c-jinshu-098-jin033-wangji","book_id":"b-jinshu-098","work_id":"w-jinshu","source_id":"s-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line057","text":"今遣司徒導，鎮南將軍、丹陽尹嶠，建威將軍趙胤武旅三萬，十道並進；平西將軍邃率兗州刺史遐、奮武將軍峻、奮威將軍贍精銳三萬，水陸齊勢；朕親禦六軍，左衛將軍亮，右衛將軍胤，護軍將軍詹，領軍將軍瞻，中軍將軍壺，驍騎將軍艾，驃騎將軍、南頓王宗，鎮軍將軍、汝南王祐，太宰、西陽王羕被練三千，組甲三萬，總統諸軍，討鳳之罪。罪止一人，朕不濫刑。有能殺鳳送首，封五千戶侯，賞布五千匹。","annotation_status":"reviewed","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-098-jin033-wangji:line057:m0004","start":4,"end":5,"surface":"導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0014","start":14,"end":15,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0020","start":20,"end":22,"surface":"趙胤","kind":"person","person_id":"cdb_09c_d8d","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0036","start":36,"end":37,"surface":"邃","kind":"person","person_id":"i4e_4wq_2qc","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0042","start":42,"end":43,"surface":"遐","kind":"person","person_id":"1eg_4i2_q9u","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0048","start":48,"end":49,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0054","start":54,"end":55,"surface":"贍","kind":"person","person_id":"5r7_x6g_gtf","status":"contextual_provisional","interpretation_note":"固定數位見證原形。殿本、平行史料確認所指；本處異體或誤字不作人物通用別名。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0075","start":75,"end":76,"surface":"亮","kind":"person","person_id":"4qr_wrk_3vd_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0081","start":81,"end":82,"surface":"胤","kind":"person","person_id":"c78_98b_f74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-098-jin033-wangji:line057:m0087","start":87,"end":88,"surface":"詹","kind":"person","person_id":"4kn_kz5_zrm","status":"contextual_provisional","interpretation_note":"以來源原字標記。"