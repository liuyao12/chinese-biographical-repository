hu-057-zhang-guang:p006","chapter_id":"c-jinshu-057-zhang-guang"},{"id":"c-jinshu-067-wenqiao:line030:m0077","start":77,"end":79,"surface":"應詹","kind":"person","person_id":"4kn_kz5_zrm","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-wenqiao:line030","chapter_id":"c-jinshu-067-wenqiao"},{"id":"c-jinshu-098-jin033-wangji:line047:m0037","start":37,"end":39,"surface":"應詹","kind":"person","person_id":"4kn_kz5_zrm","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line047","chapter_id":"c-jinshu-098-jin033-wangji"},{"id":"c-jinshu-098-jin033-wangji:line057:m0087","start":87,"end":88,"surface":"詹","kind":"person","person_id":"4kn_kz5_zrm","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-098-jin033-wangji:line057","chapter_id":"c-jinshu-098-jin033-wangji"}],"relations":[],"title_holdings":[{"id":"th-w043-cheng-122-10","person_id":"4kn_kz5_zrm","title":"南平太守","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-wangcheng","source_id":"s-jinshu-043-wangcheng","paragraph_id":"c-jinshu-043-wangcheng:line122","quote":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","person_mention_id":"c-jinshu-043-wangcheng:line122:m0346"}],"attestations":[{"id":"th-w043-cheng-122-10:a","paragraph_id":"c-jinshu-043-wangcheng:line122","start":342,"end":346,"surface":"南平太守","person_mention_id":"c-jinshu-043-wangcheng:line122:m0346","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-w098-dun-main-27","person_id":"4kn_kz5_zrm","title":"護軍將軍","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-098","chapter_id":"c-jinshu-098-jin033-wangji","source_id":"s-jinshu-098-jin033-wangji","paragraph_id":"c-jinshu-098-jin033-wangji:line057","quote":"今遣司徒導，鎮南將軍、丹陽尹嶠，建威將軍趙胤武旅三萬，十道並進；平西將軍邃率兗州刺史遐、奮武將軍峻、奮威將軍贍精銳三萬，水陸齊勢；朕親禦六軍，左衛將軍亮，右衛將軍胤，護軍將軍詹，領軍將軍瞻，中軍將軍壺，驍騎將軍艾，驃騎將軍、南頓王宗，鎮軍將軍、汝南王祐，太宰、西陽王羕被練三千，組甲三萬，總統諸軍，討鳳之罪。罪止一人，朕不濫刑。有能殺鳳送首，封五千戶侯，賞布五千匹。","person_mention_id":"c-jinshu-098-jin033-wangji:line057:m0087"}],"attestations":[{"id":"th-w043-dun-main-27:a","paragraph_id":"c-jinshu-098-jin033-wangji:line057","start":83,"end":87,"surface":"護軍將軍","person_mention_id":"c-jinshu-098-jin033-wangji:line057:m0087","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangcheng:line122","text":"澄既至鎮，日夜縱酒，不親庶事，雖寇戎急務，亦不以在懷。擢順陽人郭舒於寒悴之中，以為別駕，委以州府。時京師危逼，澄率眾軍，將赴國難，而飄風折其節柱。會王如寇襄陽，澄前鋒至宜城，遣使詣山簡，為如党嚴嶷所獲。嶷偽使人從襄陽來而問之曰：「襄陽拔未？」答云：「昨旦破城，已獲山簡。」乃陰緩澄使，令得亡去。澄聞襄陽陷，以為信然，散眾而還。既而恥之，托糧運不贍，委罪長史蔣俊而斬之，竟不能進。巴蜀流人散在荊、湘者，與土人忿爭，遂殺縣令，屯聚樂鄉。澄使成都內史王機討之。賊請降，澄偽許之，既而襲之於寵洲，以其妻子為賞，沈八千餘人于江中。於是益、梁流人四五萬家一時俱反，推杜弢為主，，南破零桂，東掠武昌，敗王機于巴陵。澄亦無憂懼之意，但與機日夜縱酒，投壺博戲，數十局俱起。殺富人李才，取其家資以賜郭舒。南平太守應詹驟諫，不納。於是上下離心，內外怨叛。澄望實雖損，猶傲然自得。後出軍擊杜弢，次於作塘。山簡參軍王沖叛於豫州，自稱荊州刺史。澄懼，使杜蕤守江陵。澄遷於孱陵，尋奔遝中。郭舒諫曰：「使君臨州，雖無異政，未失眾心。今西收華容向義之兵，足以擒此小丑，奈何自棄。」澄不能從。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line122:m0000","start":0,"end":1,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0031","start":31,"end":33,"surface":"郭舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0055","start":55,"end":56,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0074","start":74,"end":76,"surface":"王如","kind":"person","person_id":"als_c6t_b83","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0080","start":80,"end":81,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0090","start":90,"end":92,"surface":"山簡","kind":"person","person_id":"82k_3oi_qf8","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0094","start":94,"end":95,"surface":"如","kind":"person","person_id":"als_c6t_b83","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-jinshu-043-wangcheng:line122:m0096","start":96,"end":98,"surface":"嚴嶷","kind":"person","person_id":"me6_2ff_svi","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0101","start":101,"end":102,"surface":"嶷","kind":"person","person_id":"me6_2ff_svi","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0132","start":132,"end":134,"surface":"山簡","kind":"person"