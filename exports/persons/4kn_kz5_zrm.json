e":"郭舒","kind":"person","person_id":"nyu_drp_roe","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line122:m0473","start":473,"end":474,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":122,"last_line":122,"raw_start":9272,"raw_end":9752,"revision_id":2618531},"chapter_id":"c-jinshu-043-wangcheng","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-wangcheng"},{"id":"c-jinshu-057-zhang-guang:p006","text":"炅少辟太宰掾。邁多才略，有父風。州人推邁權領州事，與賊戰沒。別駕範曠及督護王喬奉光妻息，率其遺眾，還據魏興。其後義陽太守任愔為梁州，光妻子歸本郡。南平太守應詹白都督王敦，稱「光在梁州能興微繼絕，威振巴漢。值中原傾覆，征鎮失守，外無救助，內闕資儲，以寡敵眾，經年抗禦，厲節不撓，宜應追論顯贈，以慰存亡」。敦不能從。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":90,"last_line":90,"raw_start":7450,"raw_end":7606,"raw_character_offsets":[7450,7451,7452,7453,7454,7455,7456,7457,7458,7459,7460,7461,7462,7463,7464,7465,7466,7467,7468,7469,7470,7471,7472,7473,7474,7475,7476,7477,7478,7479,7480,7481,7482,7483,7484,7485,7486,7487,7488,7489,7490,7491,7492,7493,7494,7495,7496,7497,7498,7499,7500,7501,7502,7503,7504,7505,7506,7507,7508,7509,7510,7511,7512,7513,7514,7515,7516,7517,7518,7519,7520,7521,7522,7523,7524,7525,7526,7527,7528,7529,7530,7531,7532,7533,7534,7535,7536,7537,7538,7539,7540,7541,7542,7543,7544,7545,7546,7547,7548,7549,7550,7551,7552,7553,7554,7555,7556,7557,7558,7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605],"revision_id":2413329},"mentions":[{"id":"c-jinshu-057-zhang-guang:p006:m0000","surface":"炅","start":0,"end":1,"person_id":"zc4_3gf_dcf","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-057-zhang-guang:p006:m0007","surface":"邁","start":7,"end":8,"person_id":"lil_j6z_oct","kind":"person",