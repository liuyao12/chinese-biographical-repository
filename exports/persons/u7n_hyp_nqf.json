iji-065-sun:p005","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m005-0189","start":189,"end":191,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p005","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m005-0344","start":344,"end":346,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p005","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m014-0065","start":65,"end":67,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p014","chapter_id":"c-shiji-065-sun"}],"relations":[{"id":"a-shiji065-001","subject_person_id":"3jf_ru8_mz9","predicate":"ancestor","object_person_id":"vax_w2r_0za","status":"source_attested","evidence":[{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p002","quote":"孫武既死，後百餘歲有孫臏。臏生阿鄄之閒，臏亦孫武之後世子孫也。孫臏嘗與龐涓俱學兵法。龐涓既事魏，得為惠王將軍，而自以為能不及孫臏，乃陰使召孫臏。臏至，龐涓恐其賢於己，疾之，則以法刑斷其兩足而黥之，欲隱勿見。"}],"qualifiers":{"source_term":"孫武之後世子孫","historicity":"historical_tradition"},"interpretation_note":"依明示取妻、母、其子及故事局部父稱保存。孫武後世子孫只記祖先，不補直接父子；病卒家屬不接吳起親屬，公叔公主不接試延吳起公主。引語與來源故事保留範圍，不作獨立史實確證。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji065-005","person_id":"3jf_ru8_mz9","title":"師","kind":"unclassified","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p003","quote":"齊使者如梁，孫臏以刑徒陰見，說齊使。齊使以為奇，竊載與之齊。齊將田忌善而客待之。忌數與齊諸公子馳逐重射。孫子見其馬足不甚相遠，馬有上、中、下、輩。於是孫子謂田忌曰：「君弟重射，臣能令君勝。」田忌信然之，與王及諸公子逐射千金。及臨質，孫子曰：「今以君之下駟與彼上駟，取君上駟與彼中駟，取君中駟與彼下駟。」既馳三輩畢，而田忌一不勝而再勝，卒得王千金。於是忌進孫子於威王。威王問兵法，遂以為師。"}],"attestations":[{"id":"th-shiji065-005:a001","paragraph_id":"c-shiji-065-sun:p003","start":192,"end":193,"surface":"師","person_mention_id":"c-shiji-065-sun:m003-0177","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p003","quote":"齊使者如梁，孫臏以刑徒陰見，說齊使。齊使以為奇，竊載與之齊。齊將田忌善而客待之。忌數與齊諸公子馳逐重射。孫子見其馬足不甚相遠，馬有上、中、下、輩。於是孫子謂田忌曰：「君弟重射，臣能令君勝。」田忌信然之，與王及諸公子逐射千金。及臨質，孫子曰：「今以君之下駟與彼上駟，取君上駟與彼中駟，取君中駟與彼下駟。」既馳三輩畢，而田忌一不勝而再勝，卒得王千金。於是忌進孫子於威王。威王問兵法，遂以為師。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"威王問兵法遂以為師保存任用；後段孫臏辭將不記已任將，師與將分辨，日期未知。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji065-007","person_id":"3jf_ru8_mz9","title":"師","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p004","quote":"其後魏伐趙，趙急，請救於齊。齊威王欲將孫臏，臏辭謝曰：「刑餘之人不可。」於是乃以田忌為將，而孫子為師，居輜車中，坐為計謀。田忌欲引兵之趙，孫子曰：「夫解雜亂紛糾者不控棬，救鬬者不搏撠，批亢擣虛，形格勢禁，則自為解耳。今梁趙相攻，輕兵銳卒必竭於外，老弱罷於內。君不若引兵疾走大梁，據其街路，衝其方虛，彼必釋趙而自救。是我一舉解趙之圍而收獘於魏也。」田忌從之，魏果去邯鄲，與齊戰於桂陵，大破梁軍。"}],"attestations":[{"id":"th-shiji065-007:a001","paragraph_id":"c-shiji-065-sun:p004","start":49,"end":50,"surface":"師","person_mention_id":"c-shiji-065-sun:m004-0046","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授任與來源用稱分存，制度未定者保留未分類；死亡、首次提及或被刑不補有效任期，諡稱不當生前已授同字稱號。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji044-060","person_id":"u7n_hyp_nqf","surfaces":["孫臏"],"scope":"same_chapter","chapter_ids":["c-shiji-044-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-044-wei:p033","quote":"十七年，與秦戰元裏，秦取我少梁。圍趙邯鄲。十八年，拔邯鄲。趙請救于齊，齊使田忌、孫臏救趙，敗魏桂陵。"}],"rationale":"限本篇明示姓名、是為及同段連續語境；外黃徐子／客按同一勸還對話暫接，龐涓／涓按同一馬陵戰暫接。孫子與孫臏、公子赫與襄王、齊王與齊宣王仍分候選；武下將識國別待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji065-002","person_id":"3jf_ru8_mz9","surfaces":["孫子","孫臏","臏"],"scope":"same_chapter","chapter_ids":["c-shiji-065-sun"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-065-sun:p002","quote":"孫武既死，後百餘歲有孫臏。臏生阿鄄之閒，臏亦孫武之後世子孫也。孫臏嘗與龐涓俱學兵法。龐涓既事魏，得為惠王將軍，而自以為能不及孫臏，乃陰使召孫臏。臏至，龐涓恐其賢於己，疾之，則以法刑斷其兩足而黥之，欲隱勿見。"},{"paragraph_id":"c-shiji-065-sun:p003","quote":"齊使者如梁，孫臏以刑徒陰見，說齊使。齊使以為奇，竊載與之齊。齊將田忌善而客待之。忌數與齊諸公子馳逐重射。孫子見其馬足不甚相遠，馬有上、中、下、輩。於是孫子謂田忌曰：「君弟重射，臣能令君勝。」田忌信然之，與王及諸公子逐射千金。及臨質，孫子曰：「今以君之下駟與彼上駟，取君上駟與彼中駟，取君中駟與彼下駟。」既馳三輩畢，而田忌一不勝而再勝，卒得王千金。於是忌進孫子於威王。威王問兵法，遂以為師。"},{"paragraph_id":"c-shiji-065-sun:p004","quote":"其後魏伐趙，趙急，請救於齊。齊威王欲將孫臏，臏辭謝曰：「刑餘之人不可。」於是乃以田忌為將，而孫子為師，居輜車中，坐為計謀。田忌欲引兵之趙，孫子曰：「夫解雜亂紛糾者不控棬，救鬬者不搏撠，批亢擣虛，形格勢禁，則自為解耳。今梁趙相攻，輕兵銳卒必竭於外，老弱罷於內。君不若引兵疾走大梁，據其街路，衝其方虛，彼必釋趙而自救。是我一舉解趙之圍而收獘於魏也。」田忌從之，魏果去邯鄲，與齊戰於桂陵，大破梁軍。"},{"paragraph_id":"c-shiji-065-sun:p005","quote":"後十三歲，魏與趙攻韓，韓告急於齊。齊使田忌將而往，直走大梁。魏將龐涓聞之，去韓而歸，齊軍既已過而西矣。孫子謂田忌曰：「彼三晉之兵素悍勇而輕齊，齊號為怯，善戰者因其勢而利導之。兵法，百里而趣利者蹶上將，五十里而趣利者軍半至。使齊軍入魏地為十萬灶，明日為五萬灶，又明日為三萬灶。」龐涓行三日，大喜，曰：「我固知齊軍怯，入吾地三日，士卒亡者過半矣。」乃棄其步軍，與其輕銳倍日并行逐之。孫子度其行，暮當至馬陵。馬陵道陜，而旁多阻隘，可伏兵，乃斫大樹白而書之曰「龐涓死于此樹之下」。於是令齊軍善射者萬弩，夾道而伏，期曰「暮見火舉而俱發」。龐涓果夜至斫木下，見白書，乃鉆火燭之。讀其書未畢，齊軍萬弩俱發，魏軍大亂相失。龐涓自知智窮兵敗，乃自剄，曰：「遂成豎子之名！」齊因乘勝盡破其軍，虜魏太子申以歸。孫臏以此名顯天下，世傳其兵法。"},{"paragraph_id":"c-shiji-065-sun:p014","quote":"太史公曰：世俗所稱師旅，皆道孫子十三篇，吳起兵法，世多有，故弗論，論其行事所施設者。語曰：「能行之者未必能言，能言之者未必能行。」孫子籌策龐涓明矣，然不能蚤救患於被刑。吳起說武侯以形勢不如德，然行之於楚，以刻暴少恩亡其軀。悲夫！"}],"rationale":"依明示姓名、局部短稱及敘事範圍暫接；孫子在闔廬試兵指孫武，在孫臏龐涓敘事指臏。魏相田文不接孟嘗君，未名與公主指代保留待核，故事及史實確證分開，不補姓名或闕代。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji065-bin","person_ids":["u7n_hyp_nqf","3jf_ru8_mz9"],"canonical_person_id":"u7n_hyp_nqf","scope":"cross_chapter","chapter_ids":["c-shiji-044-wei","c-shiji-065-sun"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-044-wei","source_id":"s-shiji-044-wei","paragraph_id":"c-shiji-044-wei:p033","quote":"十七年，與秦戰元裏，秦取我少梁。圍趙邯鄲。十八年，拔邯鄲。趙請救于齊，齊使田忌、孫臏救趙，敗魏桂陵。","mention_ids":["c-shiji-044-wei:m033-0040"]},{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p004","quote":"其後魏伐趙，趙急，請救於齊。齊威王欲將孫臏，臏辭謝曰：「刑餘之人不可。」於是乃以田忌為將，而孫子為師，居輜車中，坐為計謀。田忌欲引兵之趙，孫子曰：「夫解雜亂紛糾者不控棬，救鬬者不搏撠，批亢擣虛，形格勢禁，則自為解耳。今梁趙相攻，輕兵銳卒必竭於外，老弱罷於內。君不若引兵疾走大梁，據其街路，衝其方虛，彼必釋趙而自救。是我一舉解趙之圍而收獘於魏也。」田忌從之，魏果去邯鄲，與齊戰於桂陵，大破梁軍。","mention_ids":["c-shiji-065-sun:m004-0019","c-shiji-065-sun:m004-0022","c-shiji-065-sun:m004-0046","c-shiji-065-sun:m004-0069"]}],"rationale":"兩篇同記孫臏田忌救趙與桂陵敗魏，人物及戰事相配，不與闔廬段孫武按孫子合併。 已發ID與各篇原文保留，同書各篇不當獨立見證；身份暫接不確證史實、年代或稱號時段。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-044-wei:p033","text":"十七年，與秦戰元裏，秦取我少梁。圍趙邯鄲。十八年，拔邯鄲。趙請救于齊，齊使田忌、孫臏救趙，敗魏桂陵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-044-wei:m033-0037","start":37,"end":39,"surface":"田忌","kind":"person","person_id":"dyh_neb_15u","status":"contextual_provisional"},{"id":"c-shiji-044-wei:m033-0040","start":40,"end":42,"surface":"孫臏","kind":"person","person_id":"u7n_hyp_nqf","status":"contextual_provisional"}],"chapter_id":"c-shiji-044-wei","book_id":"b-shiji-044","work_id":"w-shiji","source_id":"s-shiji-044-wei"},{"id":"c-shiji-065-sun:p002","text":"孫武既死，後百餘歲有孫臏。臏生阿鄄之閒，臏亦孫武之後世子孫也。孫臏嘗與龐涓俱學兵法。龐涓既事魏，得為惠王將軍，而自以為能不及孫臏，乃陰使召孫臏。臏至，龐涓恐其賢於己，疾之，則以法刑斷其兩足而黥之，欲隱勿見。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m002-0000","start":0,"end":2,"surface":"孫武","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0010","start":10,"end":12,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0013","start":13,"end":14,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0020","start":20,"end":21,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0022","start":22,"end":24,"surface":"孫武","kind":"person","person_id":"vax_w2r_0za","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0031","start":31,"end":33,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0035","start":35,"end":37,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0042","start":42,"end":44,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0050","start":50,"end":52,"surface":"惠王","kind":"person","person_id":"t8k_az0_xk2","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0062","start":62,"end":64,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0069","start":69,"end":71,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0072","start":72,"end":73,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m002-0075","start":75,"end":77,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-065-sun:p003","text":"齊使者如梁，孫臏以刑徒陰見，說齊使。齊使以為奇，竊載與之齊。齊將田忌善而客待之。忌數與齊諸公子馳逐重射。孫子見其馬足不甚相遠，馬有上、中、下、輩。於是孫子謂田忌曰：「君弟重射，臣能令君勝。」田忌信然之，與王及諸公子逐射千金。及臨質，孫子曰：「今以君之下駟與彼上駟，取君上駟與彼中駟，取君中駟與彼下駟。」既馳三輩畢，而田忌一不勝而再勝，卒得王千金。於是忌進孫子於威王。威王問兵法，遂以為師。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m003-0000","start":0,"end":3,"surface":"齊使者","kind":"person","person_id":"no0_6y9_swo","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0006","start":6,"end":8,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0015","start":15,"end":17,"surface":"齊使","kind":"person","person_id":"no0_6y9_swo","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0018","start":18,"end":20,"surface":"齊使","kind":"person","person_id":"no0_6y9_swo","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0032","start":32,"end":34,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0040","start":40,"end":41,"surface":"忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0043","start":43,"end":47,"surface":"齊諸公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代；不補姓名、成員或肯定公主同一性。"},{"id":"c-shiji-065-sun:m003-0052","start":52,"end":54,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0075","start":75,"end":77,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0078","start":78,"end":80,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0095","start":95,"end":97,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0102","start":102,"end":103,"surface":"王","kind":"person","person_id":"1d2_lvj_esk","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0104","start":104,"end":107,"surface":"諸公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代；不補姓名、成員或肯定公主同一性。"},{"id":"c-shiji-065-sun:m003-0116","start":116,"end":118,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0158","start":158,"end":160,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0169","start":169,"end":170,"surface":"王","kind":"person","person_id":"1d2_lvj_esk","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0175","start":175,"end":176,"surface":"忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0177","start":177,"end":179,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0180","start":180,"end":182,"surface":"威王","kind":"person","person_id":"1d2_lvj_esk","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0183","start":183,"end":185,"surface":"威王","kind":"person","person_id":"1d2_lvj_esk","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-065-sun:p004","text":"其後魏伐趙，趙急，請救於齊。齊威王欲將孫臏，臏辭謝曰：「刑餘之人不可。」於是乃以田忌為將，而孫子為師，居輜車中，坐為計謀。田忌欲引兵之趙，孫子曰：「夫解雜亂紛糾者不控棬，救鬬者不搏撠，批亢擣虛，形格勢禁，則自為解耳。今梁趙相攻，輕兵銳卒必竭於外，老弱罷於內。君不若引兵疾走大梁，據其街路，衝其方虛，彼必釋趙而自救。是我一舉解趙之圍而收獘於魏也。」田忌從之，魏果去邯鄲，與齊戰於桂陵，大破梁軍。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m004-0014","start":14,"end":17,"surface":"齊威王","kind":"person","person_id":"1d2_lvj_esk","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m004-0019","start":19,"end":21,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m004-0022","start":22,"end":23,"surface":"臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m004-0040","start":40,"end":42,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m004-0046","start":46,"end":48,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m004-0061","start":61,"end":63,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m004-0069","start":69,"end":71,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m004-0173","start":173,"end":175,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-065-sun:p005","text":"後十三歲，魏與趙攻韓，韓告急於齊。齊使田忌將而往，直走大梁。魏將龐涓聞之，去韓而歸，齊軍既已過而西矣。孫子謂田忌曰：「彼三晉之兵素悍勇而輕齊，齊號為怯，善戰者因其勢而利導之。兵法，百里而趣利者蹶上將，五十里而趣利者軍半至。使齊軍入魏地為十萬灶，明日為五萬灶，又明日為三萬灶。」龐涓行三日，大喜，曰：「我固知齊軍怯，入吾地三日，士卒亡者過半矣。」乃棄其步軍，與其輕銳倍日并行逐之。孫子度其行，暮當至馬陵。馬陵道陜，而旁多阻隘，可伏兵，乃斫大樹白而書之曰「龐涓死于此樹之下」。於是令齊軍善射者萬弩，夾道而伏，期曰「暮見火舉而俱發」。龐涓果夜至斫木下，見白書，乃鉆火燭之。讀其書未畢，齊軍萬弩俱發，魏軍大亂相失。龐涓自知智窮兵敗，乃自剄，曰：「遂成豎子之名！」齊因乘勝盡破其軍，虜魏太子申以歸。孫臏以此名顯天下，世傳其兵法。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m005-0019","start":19,"end":21,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0032","start":32,"end":34,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0051","start":51,"end":53,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0054","start":54,"end":56,"surface":"田忌","kind":"person","person_id":"vns_z44_maf","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0138","start":138,"end":140,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0163","start":163,"end":165,"surface":"士卒","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代；不補姓名、成員或肯定公主同一性。"},{"id":"c-shiji-065-sun:m005-0189","start":189,"end":191,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0226","start":226,"end":228,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0241","start":241,"end":244,"surface":"善射者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代；不補姓名、成員或肯定公主同一性。"},{"id":"c-shiji-065-sun:m005-0264","start":264,"end":266,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0303","start":303,"end":305,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0337","start":337,"end":341,"surface":"魏太子申","kind":"person","person_id":"yh1_ob5_1qm","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m005-0344","start":344,"end":346,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"}],"chapter_id":"c-shiji-065-sun","book_id":"b-shiji-065","work_id":"w-shiji","source_id":"s-shiji-065-sun"},{"id":"c-shiji-065-sun:p014","text":"太史公曰：世俗所稱師旅，皆道孫子十三篇，吳起兵法，世多有，故弗論，論其行事所施設者。語曰：「能行之者未必能言，能言之者未必能行。」孫子籌策龐涓明矣，然不能蚤救患於被刑。吳起說武侯以形勢不如德，然行之於楚，以刻暴少恩亡其軀。悲夫！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m014-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"fy2_9h4_gdt","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0020","start":20,"end":22,"surface":"吳起","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0065","start":65,"end":67,"surface":"孫子","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0069","start":69,"end":71,"surface":"龐涓","kind":"person","person_id":"id5_d3k_vsc","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0084","start":84,"end":86,"surface":"吳起","kind":"person","person_id":"61h_0sk_4pb","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m014-0087","start":87,"end":89,"surface":"武侯","kind":"person","person_id":"p9l_wy7_y7m_A"