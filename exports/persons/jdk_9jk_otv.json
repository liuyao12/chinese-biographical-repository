,3969,3970,3971,3972,3973,3974,3975,3976,3977,3978,3979,3980,3981,3982,3983,3984,3985,3986,3987,3988,3989,3990,3991,3992,3993,3994,3995,3996,3997,3998,3999,4000,4001,4002,4003,4004,4005,4006,4007,4008,4009,4010,4011,4012,4013,4014,4015,4016,4017,4018,4019,4020,4021,4022,4023,4024,4025,4026,4027,4028,4029,4030,4031,4032,4033,4034,4035,4036,4037,4038,4039,4040,4041,4042,4043,4044,4045,4046,4047,4048,4049,4050,4051],"revision_id":1504716},"mentions":[{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0002","start":2,"end":4,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0005","start":5,"end":9,"surface":"宣德太后","kind":"person","person_id":"m9u_v4i_tk5","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0012","start":12,"end":13,"surface":"帝","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0030","start":30,"end":32,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0033","start":33,"end":35,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0054","start":54,"end":55,"surface":"覺","kind":"person","person_id":"kv7_cgf_xrf","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0056","start":56,"end":58,"surface":"恭祖","kind":"person","person_id":"jdk_9jk_otv","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0061","start":61,"end":63,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0067","start":67,"end":69,"surface":"恭祖","kind":"person","person_id":"jdk_9jk_otv","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0070","start":70,"end":72,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0080","start":80,"end":82,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0123","start":123,"end":125,"surface":"恭祖","kind":"person","person_id":"jdk_9jk_otv","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","book_id":"b-nanqishu-051","work_id":"w-nanqishu","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p020","text":"　　先是衞尉蕭懿爲征虜將軍、豫州刺史，自歷陽步道征壽陽。帝遣密使告之，懿率軍主胡松、李居士等數千人自采石濟岸，頓越城，舉火，臺城中鼓呌稱慶。恭祖先勸慧景遣二千人斷西岸軍，令不得渡，慧景以城旦夕降，外救自然應散。至是恭祖請擊義師，又不許。乃遣子覺將精手數千人渡南岸。義師昧旦進戰，數合，士皆致死，覺大敗，赴淮死者二千餘人，覺單馬退，開桁阻淮。其夜，崔恭祖與驍將劉靈運詣城降，慧景衆情離壞，乃將腹心數人潛去，欲北渡江，城北諸軍不知，猶爲拒戰。城內出盪，殺數百人。義軍渡北岸，慧景餘衆皆奔。慧景圍城凡十二日，軍旅散在京師，不爲營壘。及走，衆於道稍散，單馬至蟹浦，爲漁父所斬，以頭內魚籃，檐送至京師，時年六十三。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":50,"last_line":50,"raw_start":4054,"raw_end":4356,"raw_character_offsets":[4054,4055,4056,4057,4058,4059,4060,4061,4062,4063,4064,4065,4066,4067,4068,4069,4070,4071,4072,4073,4074,4075,4076,4077,4078,4079,4080,4081,4082,4083,4084,4085,4086,4087,4088,4089,4090,4091,4092,4093,4094,4095,4096,4097,4098,4099,4100,4101,4102,4103,4104,4105,4106,4107,4108,4109,4110,4111,4112,4113,4114,4115,4116,4117,4118,4119,4120,4121,4122,4123,4124,4125,4126,4127,4128,4129,4130,4131,4132,4133,4134,4135,4136,4137,4138,4139,4140,4141,4142,4143,4144,4145,4146,4147,4148,4149,4150,4151,4152,4153,4154,4155,4156,4157,4158,4159,4160,4161,4162,4163,4164,4165,4166,4167,4168,4169,4170,4171,4172,4173,4174,4175,4176,4177,4178,4179,4180,4181,4182,4183,4184,4185,4186,4187,4188,4189,4190,4191,4192,4193,4194,4195,4196,4197,4198,4199,4200,4201,4202,4203,4204,4205,4206,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,