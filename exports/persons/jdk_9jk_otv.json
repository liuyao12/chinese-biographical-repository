2","start":22,"end":23,"surface":"帝","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0032","start":32,"end":34,"surface":"幼主","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0085","start":85,"end":88,"surface":"崔恭祖","kind":"person","person_id":"jdk_9jk_otv","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0098","start":98,"end":99,"surface":"帝","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0111","start":111,"end":114,"surface":"左興盛","kind":"person","person_id":"plc_j8k_c4c","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0125","start":125,"end":127,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0140","start":140,"end":145,"surface":"江夏王寶玄","kind":"person","person_id":"w4m_9tw_147_B","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0157","start":157,"end":159,"surface":"寶玄","kind":"person","person_id":"w4m_9tw_147_B","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","book_id":"b-nanqishu-051","work_id":"w-nanqishu","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p017","text":"　　臺遣驍騎將軍張佛護、直閤將軍徐元稱、屯騎校尉姚景珍、西中郎參軍徐景智、游盪軍主董伯珍、騎官桓靈福等據竹里爲數城。寶玄遣信謂佛護曰：「身自還朝，君何意苦相斷遏？」佛護答曰：「小人荷國重恩，使於此創立小戍。殿下還朝，但自直過，豈敢干斷。」遂射慧景軍，因合戰。慧景子覺及崔恭祖領前鋒，皆傖楚善戰；又輕行不爨食，以數舫緣江載酒肉爲軍糧。每見臺軍城中煙火起，輙盡力攻擊，臺軍不復得食，以此饑困。元稱等議欲降，佛護不許。十二日，恭祖等復攻之，城陷，佛護單馬走，追得斬首，徐元稱降，餘軍主皆死。慧景至臨沂，令李玉之發橋斷路，慧景收殺之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":44,"last_line":44,"raw_start":3371,"raw_end":3634,"raw_character_offsets":[3371,3372,3373,3374,