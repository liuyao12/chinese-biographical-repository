:["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review22-0","kind":"source_review","person_id":"jdk_9jk_otv","source_quote":"　　恭祖者，慧景宗人，驍果便馬槊，氣力絕人，頻經軍陣。討王敬則，與左興盛軍容袁文曠爭敬則首，訴明帝曰：「恭祖禿馬絳衫，手刺倒賊。故文曠得斬其首。以死易勳，而見枉奪。若失此勳，要當刺殺左興盛。」帝以其勇，使謂興盛曰：「何容令恭祖與文曠爭功。」遂封二百戶。慧景平後，恭祖繫尚方，少時殺之。","reading":"宗人恭祖另有討敬則爭功、封戶與伏殺。袁文曠只在爭首公案具名。","note":"宗人恭祖另有討敬則爭功、封戶與伏殺。袁文曠只在爭首公案具名。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p022","start_codepoint":0,"end_codepoint":142,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:variant_review16-93","kind":"variant_review","person_id":"jdk_9jk_otv","source_quote":"開門納之","reading":"南史卷四十五另述崔恭祖先閉門不出，保留兩敘。","note":"南史卷四十五另述崔恭祖先閉門不出，保留兩敘。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p016","start_codepoint":93,"end_codepoint":97,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-qi051-gongzu-death","person_id":"jdk_9jk_otv","event_type":"death","source_term":"殺之","source_anchor":{"paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p022","start":139,"end":141,"surface":"殺之"},"date_expression":null,"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-051","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p022","quote":"　　恭祖者，慧景宗人，驍果便馬槊，氣力絕人，頻經軍陣。討