plete:p032:m0015","start":15,"end":18,"surface":"蔡興宗","kind":"person","person_id":"fcu_pw8_tkw","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p032:m0023","start":23,"end":25,"surface":"珪之","kind":"person","person_id":"lem_xaq_m5o","status":"contextual_provisional"},{"id":"c-nanqishu-053-local-officials-complete:p032:m0060","start":60,"end":62,"surface":"珪之","kind":"person","person_id":"lem_xaq_m5o","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-053-local-officials-complete","book_id":"b-nanqishu-053","work_id":"w-nanqishu","source_id":"s-nanqishu-053-local-officials-complete-ws1501803"},{"id":"c-nanshi-024-wangsiyuan:p004","text":"思遠立身簡潔，諸客有詣己者，覘知衣服垢穢，方便不前，形儀新楚，乃與促膝。雖然，及去之後，猶令二人交帚拂其坐處。明帝從祖弟季敞性甚豪縱，使詣思遠，令見禮度。都水使者李珪之常曰：「見王思遠終日匡坐，不妄言笑，簪帽衣領，無不整潔，便憶丘明士。見明士蓬頭散帶，終日酣醉，吐論從橫，唐突卿宰，便復憶見思遠。」言其兩反也。","mentions":[{"id":"c-nanshi-024-wangsiyuan:p004:m0000","surface":"思遠","start":0,"end":2,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p004:m0060","surface":"季敞","start":60,"end":62,"person_id":"fgw_1jr_4gk","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p004:m0069","surface":"思遠","start":69,"end":71,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p004:m0081","surface":"李珪之","start":81,"end":84,"person_id":"lem_xaq_m5o","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p004:m0089","surface":"王思遠","start":89,"end":92,"person_id":"0cf_pqs_mnm","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-024-wangsiyuan:p004:m0114","surface":"丘明士","start":114,"end":117,"person_id":"gyc_zkg_t21","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id"