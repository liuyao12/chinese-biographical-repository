4,15795,15796,15797,15798,15799,15800,15801,15802,15803,15804,15805,15806,15807,15808,15809,15810,15811,15812,15813,15814],"revision_id":2602668},"mentions":[{"id":"c-sanguozhi-047-sun-quan:p078:m0010","surface":"建昌侯慮","start":10,"end":14,"kind":"person","person_id":"572_278_cba_D","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p078:m0022","surface":"周賀","start":22,"end":24,"kind":"person","person_id":"ad3_ncg_7fk","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p078:m0027","surface":"裴潛","start":27,"end":29,"kind":"person","person_id":"c46_ile_6k8","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p078:m0041","surface":"田豫","start":41,"end":43,"kind":"person","person_id":"f19_165_168","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p078:m0047","surface":"賀","start":47,"end":48,"kind":"person","person_id":"ad3_ncg_7fk","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p078:m0061","surface":"公孫淵","start":61,"end":64,"kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p078:m0067","surface":"宿舒","start":67,"end":69,"kind":"person","person_id":"r95_caz_t7k","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p078:m0073","surface":"孫綜","start":73,"end":75,"kind":"person","person_id":"bii_34k_mlb","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p078:m0090","surface":"淵","start":90,"end":91,"kind":"person","person_id":"z0r_ri5_noq","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-047-sun-quan","book_id":"b-sanguozhi-047","work_id":"w-sanguozhi","source_id":"s-sanguozhi-047-sun-quan-ws2602668"},{"id":"c-sanguozhi-047-sun-quan:p080","text":"　　二年春正月，詔曰：「朕以不德，肇受元命，夙夜兢兢，不遑假寢。思平世難，救濟黎庶，上答神祗，下慰民望；是以眷眷，勤求俊傑，將與戮力，共定海內。苟在同心，與之偕老。今使持節督幽州領靑州牧遼東太守燕王，久脅賊虜，隔在一方，雖乃心於國，其路靡緣。今因天命。遠遣二使，款誠顯露，章表殷勤，朕之得此，何喜如之！雖湯遇伊尹，周獲呂望，世祖未定而得河右，方之今日。豈復是過？普天一統，於是定矣。《書》不云乎。『一人有慶，兆民賴之』。其大赦天下，與之更始，其明下州郡，咸使聞知。特下燕國，奉宣詔恩，今普天率土備聞斯慶。」三月，遣舒、綜還，使太常張彌、執金吾許晏、將軍賀達等將兵萬人，金寶珍貨，九錫備物，乘海授淵。舉朝大臣，自丞相雍已下皆諫，以爲淵未可信，而寵待太厚。但可遣吏兵數百護送舒、綜，權終不聽。淵果斬彌等，送其首於魏，沒其兵資。權大怒，欲自征淵，尚書僕射薛綜等切諫乃止。是歳，權嚮合肥新城，遣將軍全瓊征六安，皆不克還。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":91,"last_line":91,"raw_start":16463,"raw_end":18561,"raw_character_offsets":[16463,16464,16465,16466,16467,16468,16469,16470,16471,16472,16473,16474,16475,16476,16477,16478,16479,16480,16481,16482,16483,16484,16485,16486,16487,16488,16489,16490,16491,16492,16493,16494,16495,16496,16497,16498,16499,16500,16501,16502,16503,16504,16505,16506,16507,16508,16509,16510,16511,16512,16513,16514,16515,16516,16517,16518,16519,16520,16521,16522,16523,16524,16525,16526,16527,16528,16529,16530,16531,16532,16533,16534,16535,16536,16537,16538,16539,16540,16541,16542,16543,16544,16545,16546,16547,16548,16549,16550,16551,16552,16553,16554,16555,16556,16557,16558,16559,16560,16561,16562,16563,16564,16565,16566,16567,16568,16569,16570,16571,16572,16573,16574,16575,16576,16577,16578,16579,16580,16581,16582,16583,16584,16585,16586,16587,16588,16589,16590,16591,16592,16593,16594,16595,16596,16597,16598,16599,16600,16601,16602,16603,16604,16605,16606,16607,16608,16609,16610,16611,16612,16613,16614,16615,16616,16624,16625,16628,16629,16630,16638,16639,16642,16643,16644,16645,16646,16647,16648,16649,16650,16651,16652,16653,16654,16655,16656,16657,16658,16659,16660,16661,16662,16663,16664,16665,16666,16667,16668,16669,16670,16671,16672,16678,16681,16682,16685,16688,16689,16690,16691,16692,16693,16694,16695,16696,16697,16698,16699,16700,16701,16702,16703,16704,16705,16706,16707,16708,16709,16710,16711,16712,16713,16714,16715,16716,16717,16718,16721,16724,16725,16726,16727,16728,16729,16730,16731,16732,16733,16734,16735,16736,16737,16738,16739,16740,16741,16742,16743,16744,16745,16746,16747,16748,16749,16750,16751,16752,16753,16754,16755,16756,16757,16758,16759,16760,16761,16762,16763,16764,16765,16766,16774,16775,16778,16779,16780,16788,1678