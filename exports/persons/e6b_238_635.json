ult":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-phase4-j-001","person_id":"e6b_238_635","event_type":"death","status":"source_attested","date_expression":null,"source_term":"為羌虜所害","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-liang-yang","chapter_id":"c-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line018","quote":"汝南文成王亮，字子翼，宣帝第四子也。少清警有才用，仕魏為散騎侍郎、萬歲亭侯，拜東中郎將，進封廣陽鄉侯。討諸葛誕于壽春，失利，免官。頃之，拜左將軍，加散騎常侍、假節，出監豫州諸軍事。五等建，改封祁陽伯，轉鎮西將軍。武帝踐阼，封扶風郡王，邑萬戶，置騎司馬，增參軍掾屬，持節、都督關中雍、涼諸軍事。會秦州刺史胡烈為羌虜所害，亮遣將軍劉旂、騎督敬琰赴救，不進，坐是貶為平西將軍。旂當斬，亮與軍司曹冏上言，節度之咎由亮而出，乞丐旂死。詔曰：「高平困急，計城中及旂足以相拔，就不能徑至，尚當深進。今奔突有投，而坐視覆敗，故加旂大戮。今若罪不在旂，當有所在。」有司又奏免亮官，削爵土。詔惟免官。頃之，拜撫軍將軍。是歲，吳將步闡來降，假亮節都督諸軍事以納之。尋加侍中之服。","person_mention_id":"c-jinshu-059-liang-yang:line018:m0151"}],"interpretation_note":"保留本篇死亡原詞及敘事主語。紀年未直接明載則不補單年；不倒推出生年，不改官爵終點。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-036-wei-comparison:p002:m0249","start":249,"end":251,"surface":"胡烈","kind":"person","person_id":"e6b_238_635","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p002","chapter_id":"c-jinshu-036-wei-comparison"},{"id":"c-jinshu-036-wei-comparison:p002:m0298","start":298,"end":300,"surface":"胡烈","kind":"person","person_id":"e6b_238_635","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p002","chapter_id":"c-jinshu-036-wei-comparison"},{"id":"c-jinshu-036-wei-comparison:p002:m0322","start":322,"end":324,"surface":"胡烈","kind":"person","person_id":"e6b_238_635","status":"contextual_provisional","paragraph_id":"c-jinshu-036-wei-comparison:p002","chapter_id":"c-jinshu-036-wei-comparison"},{"start":151,"end":153,"surface":"胡烈","kind":"person","person_id":"e6b_238_635","id":"c-jinshu-059-liang-yang:line018:m0151","paragraph_id":"c-jinshu-059-liang-yang:line018","chapter_id":"c-jinshu-059-liang-yang"}],"relations":[],"title_holdings":[{"id":"th-phase4-j-061","person_id":"e6b_238_635","title":"秦州刺史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-liang-yang","chapter_id":"c-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line018","quote":"汝南文成王亮，字子翼，宣帝第四子也。少清警有才用，仕魏為散騎侍郎、萬歲亭侯，拜東中郎將，進封廣陽鄉侯。討諸葛誕于壽春，失利，免官。頃之，拜左將軍，加散騎常侍、假節，出監豫州諸軍事。五等建，改封祁陽伯，轉鎮西將軍。武帝踐阼，封扶風郡王，邑萬戶，置騎司馬，增參軍掾屬，持節、都督關中雍、涼諸軍事。會秦州刺史胡烈為羌虜所害，亮遣將軍劉旂、騎督敬琰赴救，不進，坐是貶為平西將軍。旂當斬，亮與軍司曹冏上言，節度之咎由亮而出，乞丐旂死。詔曰：「高平困急，計城中及旂足以相拔，就不能徑至，尚當深進。今奔突有投，而坐視覆敗，故加旂大戮。今若罪不在旂，當有所在。」有司又奏免亮官，削爵土。詔惟免官。頃之，拜撫軍將軍。是歲，吳將步闡來降，假亮節都督諸軍事以納之。尋加侍中之服。","person_mention_id":"c-jinshu-059-liang-yang:line018:m0151"}],"attestations":[{"id":"th-phase4-j-061:a001","paragraph_id":"c-jinshu-059-liang-yang:line018","start":147,"end":151,"surface":"秦州刺史","person_mention_id":"c-jinshu-059-liang-yang:line018:m0151","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源限定用稱或任授；不把未載紀年補成單年，不以死亡結束全部職爵。兼領與職掌按原詞保留。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[{"id":"pa-phase4-j-005","person_id":"e6b_238_635","relation":"service_location","place":{"source_name":"秦州","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"秦州刺史","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-liang-yang","chapter_id":"c-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line018","quote":"汝南文成王亮，字子翼，宣帝第四子也。少清警有才用，仕魏為散騎侍郎、萬歲亭侯，拜東中郎將，進封廣陽鄉侯。討諸葛誕于壽春，失利，免官。頃之，拜左將軍，加散騎常侍、假節，出監豫州諸軍事。五等建，改封祁陽伯，轉鎮西將軍。武帝踐阼，封扶風郡王，邑萬戶，置騎司馬，增參軍掾屬，持節、都督關中雍、涼諸軍事。會秦州刺史胡烈為羌虜所害，亮遣將軍劉旂、騎督敬琰赴救，不進，坐是貶為平西將軍。旂當斬，亮與軍司曹冏上言，節度之咎由亮而出，乞丐旂死。詔曰：「高平困急，計城中及旂足以相拔，就不能徑至，尚當深進。今奔突有投，而坐視覆敗，故加旂大戮。今若罪不在旂，當有所在。」有司又奏免亮官，削爵土。詔惟免官。頃之，拜撫軍將軍。是歲，吳將步闡來降，假亮節都督諸軍事以納之。尋加侍中之服。","person_mention_id":"c-jinshu-059-liang-yang:line018:m0151"}],"interpretation_note":"原地名照錄；官地、遷行地及食邑分開，不當出生地或籍貫，不補現代座標。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"qualifiers":{"source_position":"秦州刺史"}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin036-wei-hu_lie","person_id":"e6b_238_635","surfaces":["胡烈"],"scope":"cross_chapter","chapter_ids":["c-jinshu-036-wei-comparison","c-jinshu-059-liang-yang"],"status":"contextual_provisional","confidence_level":"high","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-036","source_id":"s-jinshu036-wei-ws2108231-rendered-comparison","chapter_id":"c-jinshu-036-wei-comparison","paragraph_id":"c-jinshu-036-wei-comparison:p002","quote":"鄧艾、鐘會之伐蜀也，瓘以本官持節監艾、會軍事，行鎮西軍司，給兵千人。蜀既平，艾輒承制封拜。會陰懷異志，因艾專擅，密與瓘俱奏其狀。詔使檻車徵之，會遣瓘先收艾。會以瓘兵少，欲令艾殺瓘，因加艾罪。瓘知欲危己，然不可得而距，乃夜至成都，檄艾所統諸將，稱詔收艾，其餘一無所問。若來赴官軍，爵賞如先；敢有不出，誅及三族。比至雞鳴，悉來赴瓘，唯艾帳內在焉。平旦開門，瓘乘使者車，徑入至成都殿前。艾臥未起，父子俱被執。艾諸將圖欲劫艾，整仗趣瓘營。瓘輕出迎之，偽作表草，將申明艾事，諸將信之而止。俄而會至，乃悉請諸將胡烈等，因執之，囚益州解舍，遂發兵反。於是士卒思歸，內外騷動，人情憂懼。會留瓘謀議，乃書版云「欲殺胡烈等」，舉以示瓘，瓘不許，因相疑貳。瓘如廁，見胡烈故給使，使宣語三軍，言會反。會逼瓘定議，經宿不眠，各橫刀膝上。在外諸軍已潛欲攻會。瓘既不出，未敢先發。會使瓘慰勞諸軍。瓘心欲去，且堅其意，曰：「卿三軍主，宜自行。」會曰：「卿監司，且先行，吾當後出。」瓘便下殿。會悔遣之，使呼瓘。瓘辭眩疾動，詐僕地。比出閣，數十信追之。瓘至外解，服鹽湯，大吐。瓘素羸，便似困篤。會遣所親人及醫視之，皆言不起，會由是無所憚。及暮，門閉，瓘作檄宣告諸軍。諸軍並已唱義，陵旦共攻會。會率左右距戰，諸將擊敗之，唯帳下數百人隨會繞殿而走，盡殺之。瓘於是部分諸將，群情肅然。鄧艾本營將士復追破檻車出艾，還向成都。瓘自以與會共陷艾，懼為變，又欲專誅會之功，乃遣護軍田續至綿竹，夜襲艾於三造亭，斬艾及其子忠。初，艾之入江由也，以續不進，將斬之，既而赦焉。及瓘遣續，謂之曰：「可以報江由之辱矣。」","mention_ids":["c-jinshu-036-wei-comparison:p002:m0249","c-jinshu-036-wei-comparison:p002:m0298","c-jinshu-036-wei-comparison:p002:m0322"]},{"work_id":"w-jinshu","book_id":"b-jinshu-059","source_id":"s-jinshu-059-liang-yang","chapter_id":"c-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line018","quote":"汝南文成王亮，字子翼，宣帝第四子也。少清警有才用，仕魏為散騎侍郎、萬歲亭侯，拜東中郎將，進封廣陽鄉侯。討諸葛誕于壽春，失利，免官。頃之，拜左將軍，加散騎常侍、假節，出監豫州諸軍事。五等建，改封祁陽伯，轉鎮西將軍。武帝踐阼，封扶風郡王，邑萬戶，置騎司馬，增參軍掾屬，持節、都督關中雍、涼諸軍事。會秦州刺史胡烈為羌虜所害，亮遣將軍劉旂、騎督敬琰赴救，不進，坐是貶為平西將軍。旂當斬，亮與軍司曹冏上言，節度之咎由亮而出，乞丐旂死。詔曰：「高平困急，計城中及旂足以相拔，就不能徑至，尚當深進。今奔突有投，而坐視覆敗，故加旂大戮。今若罪不在旂，當有所在。」有司又奏免亮官，削爵土。詔惟免官。頃之，拜撫軍將軍。是歲，吳將步闡來降，假亮節都督諸軍事以納之。尋加侍中之服。","mention_ids":["c-jinshu-059-liang-yang:line018:m0151"]}],"rationale":"完整本傳/嵌入書勢/引語時層逐處判讀。胡烈；不是全域同字配對，未由本次標記推任官、同場或親屬世距。","human_reviewed":false,"model":null},{"id":"d-jinshu059-new-e6b_238_635","person_id":"e6b_238_635","surfaces":["胡烈"],"scope":"same_chapter","chapter_ids":["c-jinshu-059-liang-yang"],"status":"contextual_provisional","confidence_level":"moderate","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-059","chapter_id":"c-jinshu-059-liang-yang","source_id":"s-jinshu-059-liang-yang","paragraph_id":"c-jinshu-059-liang-yang:line018","quote":"胡烈","mention_id":"c-jinshu-059-liang-yang:line018:m0151","person_mention_id":"c-jinshu-059-liang-yang:line018:m0151"}],"rationale":"同一完整敘事單元的具名與短稱；人物ID為私有stage提案，父系依各自原文證據，沒有按同名跨篇合併。","references":[],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-036-wei-comparison:p002","text":"鄧艾、鐘會之伐蜀也，瓘以本官持節監艾、會軍事，行鎮西軍司，給兵千人。蜀既平，艾輒承制封拜。會陰懷異志，因艾專擅，密與瓘俱奏其狀。詔使檻車徵之，會遣瓘先收艾。會以瓘兵少，欲令艾殺瓘，因加艾罪。瓘知欲危己，然不可得而距，乃夜至成都，檄艾所統諸將，稱詔收艾，其餘一無所問。若來赴官軍，爵賞如先；敢有不出，誅及三族。比至雞鳴，悉來赴瓘，唯艾帳內在焉。平旦開門，瓘乘使者車，徑入至成都殿前。艾臥未起，父子俱被執。艾諸將圖欲劫艾，整仗趣瓘營。瓘輕出迎之，偽作表草，將申明艾事，諸將信之而止。俄而會至，乃悉請諸將胡烈等，因執之，囚益州解舍，遂發兵反。於是士卒思歸，內外騷動，人情憂懼。會留瓘謀議，乃書版云「欲殺胡烈等」，舉以示瓘，瓘不許，因相疑貳。瓘如廁，見胡烈故給使，使宣語三軍，言會反。會逼瓘定議，經宿不眠，各橫刀膝上。在外諸軍已潛欲攻會。瓘既不出，未敢先發。會使瓘慰勞諸軍。瓘心欲去，且堅其意，曰：「卿三軍主，宜自行。」會曰：「卿監司，且先行，吾當後出。」瓘便下殿。會悔遣之，使呼瓘。瓘辭眩疾動，詐僕地。比出閣，數十信追之。瓘至外解，服鹽湯，大吐。瓘素羸，便似困篤。會遣所親人及醫視之，皆言不起，會由是無所憚。及暮，門閉，瓘作檄宣告諸軍。諸軍並已唱義，陵旦共攻會。會率左右距戰，諸將擊敗之，唯帳下數百人隨會繞殿而走，盡殺之。瓘於是部分諸將，群情肅然。鄧艾本營將士復追破檻車出艾，還向成都。瓘自以與會共陷艾，懼為變，又欲專誅會之功，乃遣護軍田續至綿竹，夜襲艾於三造亭，斬艾及其子忠。初，艾之入江由也，以續不進，將斬之，既而赦焉。及瓘遣續，謂之曰：「可以報江由之辱矣。」","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","captured_source_position":{"unit_key":"p002","projection_ref":"source-evidence/jin036-wei-comparison/projection.json","capture