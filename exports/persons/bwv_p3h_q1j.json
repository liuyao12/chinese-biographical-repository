id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m004-0297","start":297,"end":299,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名署稱、群體、學說合稱或代詞待核，不補姓名、親屬成員或全域帝號。"},{"id":"c-shiji-054-cao:m004-0301","start":301,"end":303,"surface":"項羽","kind":"person","person_id":"s5o_lxl_fqe","status":"contextual_provisional"}],"chapter_id":"c-shiji-054-cao","book_id":"b-shiji-054","work_id":"w-shiji","source_id":"s-shiji-054-cao"},{"id":"c-shiji-057-zhou:p002","text":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m002-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0004","start":4,"end":6,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0009","start":9,"end":10,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0076","start":76,"end":78,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0140","start":140,"end":143,"surface":"單父令","kind":"person","person_id":"8ao_2is_pmk","status":"contextual_provisional","note":"依本段可分辨受得官員、軍事主體或說話者記未名候選，不補姓名；獄吏教策前後同一敘事，末句安知獄吏之貴泛論未強併。"},{"id":"c-shiji-057-zhou:m002-0162","start":162,"end":164,"surface":"李由","kind":"person","person_id":"49g_7az_e4i_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0181","start":181,"end":183,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0185","start":185,"end":187,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0188","start":188,"end":190,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0191","start":191,"end":193,"surface":"項羽","kind":"person","person_id":"qi8_m09_rfs","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0212","start":212,"end":215,"surface":"楚懷王","kind":"person","person_id":"p92_3b3_lai","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0216","start":216,"end":218,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0228","start":228,"end":230,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0231","start":231,"end":232,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0240","start":240,"end":242,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0247","start":247,"end":250,"surface":"東郡尉","kind":"person","person_id":"s4f_hyi_z66","status":"contextual_provisional","note":"依本段可分辨受得官員、軍事主體或說話者記未名候選，不補姓名；獄吏教策前後同一敘事，末句安知獄吏之貴泛論未強併。"},{"id":"c-shiji-057-zhou:m002-0258","start":258,"end":260,"surface":"王離","kind":"person","person_id":"pgw_7wx_2g6","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0284","start":284,"end":286,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0292","start":292,"end":296,"surface":"南陽守齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"}],"chapter_id":"c-shiji-057-zhou","book_id":"b-shiji-057","work_id":"w-shiji","source_id":"s-shiji-057-zhou"},{"id":"c-shiji-057-zhou:p003","text":"項羽至，以沛公為漢王。漢王賜勃爵為威武侯。從入漢中，拜為將軍。還定三秦，至秦，賜食邑懷德。攻槐裏、好畤，最。擊趙賁、內史保於咸陽，最。北攻漆。擊章平、姚卬軍。西定汧。還下郿、頻陽。圍章邯廢丘。破西丞。擊盜巴軍，破之。攻上邽。東守峣關。轉擊項籍。攻曲逆，最。還守敖倉，追項籍。籍已死，因東定楚地泗（川）［水］、東海郡，凡得二十二縣。還守雒陽、櫟陽，賜與潁（陽）［陰］侯共食鐘離。以將軍從高帝反者燕王臧荼，破之易下。所將卒當馳道為多。賜爵列侯，剖符世世勿絕。食絳八千一百八十戶，號絳侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m003-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"qi8_m09_rfs","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0005","start":5,"end":7,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0008","start":8,"end":10,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0011","start":11,"end":13,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0014","start":14,"end":15,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0055","start":55,"end":57,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0058","start":58,"end":61,"surface":"內史保","kind":"person","person_id":"rw2_ntu_kgz","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0072","start":72,"end":74,"surface":"章平","kind":"person","person_id":"fs1_3m9_rj3","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0075","start":75,"end":77,"surface":"姚卬","kind":"person","person_id":"j5e_759_c2b","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0091","start":91,"end":93,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0097","start":97,"end":99,"surface":"西丞","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m003-0101","start":101,"end":104,"surface":"盜巴軍","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m003-0119","start":119,"end":121,"surface":"項籍","kind":"person","person_id":"qi8_m09_rfs","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0134","start":134,"end":136,"surface":"項籍","kind":"person","person_id":"qi8_m09_rfs","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0137","start":137,"end":138,"surface":"籍","kind":"person","person_id":"qi8_m09_rfs","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0175","start":175,"end":183,"surface":"潁（陽）［陰］侯","kind":"person","person_id":"dpq_m7y_b7q","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0192","start":192,"end":194,"surface":"高帝","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0196","start":196,"end":200,"surface":"燕王臧荼","kind":"person","person_id":"9tl_u6l_vyp","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m003-0238","start":238,"end":240,"surface":"絳侯","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"}],"chapter_id":"c-shiji-057-zhou","book_id":"b-shiji-057","work_id":"w-shiji","source_id":"s-shiji-057-zhou"},{"id":"c-shiji-095-fankuang:p002","text":"初從高祖起豐，攻下沛。高祖為沛公，以噲為舍人。從攻胡陵、方與，還守豐，擊泗水監豐下，破之。復東定沛，破泗水守薛西。與司馬夷戰碭東，卻敵，斬首十五級，賜爵國大夫。常從，沛公擊章邯軍濮陽，攻城先登，斬首二十三級，賜爵列大夫。復常從，從攻城陽，先登。下戶牖，破李由軍，斬首十六級，賜上閒爵。從攻圍東郡守尉於成武，卻敵，斬首十四級，捕虜十一人，賜爵五大夫。從擊秦軍，出亳南。河閒守軍於杠里，破之。擊破趙賁軍開封北，以卻敵先登，斬候一人，首六十八級，捕虜二十七人，賜爵卿。從攻破楊熊軍於曲遇。攻宛陵，先登，斬首八級，捕虜四十四人，賜爵封號賢成君。從攻長社、轘轅，絕河津，東攻秦軍於尸，南攻秦軍於犨。破南陽守齮於陽城。東攻宛城，先登。西至酈，以卻敵，斬首二十四級，捕虜四十人，賜重封。攻武關，至霸上，斬都尉一人，首十級，捕虜百四十六人，降卒二千九百人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m002-0002","start":2,"end":4,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0011","start":11,"end":13,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0014","start":14,"end":16,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0018","start":18,"end":19,"surface":"噲","kind":"person","person_id":"b1r_inb_fts","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0058","start":58,"end":61,"surface":"司馬夷","kind":"person","person_id":"m8o_g61_go9","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0083","start":83,"end":85,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0086","start":86,"end":88,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0127","start":127,"end":129,"surface":"李由","kind":"person","person_id":"49g_7az_e4i_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0196","start":196,"end":198,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0234","start":234,"end":236,"surface":"楊熊","kind":"person","person_id":"v4m_7yp_xr3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0298","start":298,"end":299,"surface":"齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p005","text":"還定三秦，別擊西丞白水北，雍輕車騎於雍南，破之。從攻雍、斄城，先登。擊章平軍好畤，攻城，先登陷陣，斬縣令丞各一人，首十一級，虜二十人，遷郎中騎將。從擊秦車騎壤東，卻敵，遷為將軍。攻趙賁，下郿、槐裏、柳中、咸陽；灌廢丘，最。至櫟陽，賜食邑杜之樊鄉。從攻項籍，屠煮棗。擊破王武、程處軍於外黃。攻鄒、魯、瑕丘、薛。項羽敗漢王於彭城，盡復取魯、梁地。噲還至滎陽，益食平陰二千戶，以將軍守廣武。一歲，項羽引而東。從高祖擊項籍，下陽夏，虜楚周將軍卒四千人。圍項籍於陳，大破之。屠胡陵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m005-0035","start":35,"end":37,"surface":"章平","kind":"person","person_id":"fs1_3m9_rj3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0090","start":90,"end":92,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0125","start":125,"end":127,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0134","start":134,"end":136,"surface":"王武","kind":"person","person_id":"qxu_jqe_evi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0137","start":137,"end":139,"surface":"程處","kind":"person","person_id":"k9m_d4o_f34","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0154","start":154,"end":156,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0157","start":157,"end":159,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0171","start":171,"end":172,"surface":"噲","kind":"person","person_id":"b1r_inb_fts","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0195","start":195,"end":197,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0202","start":202,"end":204,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0205","start":205,"end":207,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0214","start":214,"end":217,"surface":"周將軍","kind":"person","person_id":"q19_wxu_gyl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m005-0223","start":223,"end":225,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p017","text":"高祖之初與徒屬欲攻沛也，嬰時以縣令史為高祖使。上降沛一日，高祖為沛公，賜嬰爵七大夫，以為太僕。從攻胡陵，嬰與蕭何降泗水監平，平以胡陵降，賜嬰爵五大夫。從擊秦軍碭東，攻濟陽，下戶牖，破李由軍雍丘下，以兵車趣攻戰疾，賜爵執帛。常以太僕奉車從擊章邯軍東阿、濮陽下，以兵車趣攻戰疾，破之，賜爵執珪。復常奉車從擊趙賁軍開封，楊熊軍曲遇。嬰從捕虜六十八人，降卒八百五十人，得印一匱。因復常奉車從擊秦軍雒陽東，以兵車趣攻戰疾，賜爵封轉為滕公。因復奉車從攻南陽，戰於藍田、芷陽，以兵車趣攻戰疾，至霸上。項羽至，滅秦，立沛公為漢王。漢王賜嬰爵列侯，號昭平侯，復為太僕，從入蜀、漢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m017-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0012","start":12,"end":13,"surface":"嬰","kind":"person","person_id":"li9_cmb_8ci","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0019","start":19,"end":21,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0029","start":29,"end":31,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0032","start":32,"end":34,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0036","start":36,"end":37,"surface":"嬰","kind":"person","person_id":"li9_cmb_8ci","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0052","start":52,"end":53,"surface":"嬰","kind":"person","person_id":"li9_cmb_8ci","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0054","start":54,"end":56,"surface":"蕭何","kind":"person","person_id":"xd8_uww_5ok","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0057","start":57,"end":61,"surface":"泗水監平","kind":"person","person_id":"vlp_yy3_ufh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0069","start":69,"end":70,"surface":"嬰","kind":"person","person_id":"li9_cmb_8ci","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0091","start":91,"end":93,"surface":"李由","kind":"person","person_id":"49g_7az_e4i_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0119","start":119,"end":121,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0151","start":151,"end":153,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0157","start":157,"end":159,"surface":"楊熊","kind":"person","person_id":"v4m_7yp_xr3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0163","start":163,"end":164,"surface":"嬰","kind":"person","person_id":"li9_cmb_8ci","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0243","start":243,"end":245,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0251","start":251,"end":253,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0254","start":254,"end":256,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0257","start":257,"end":259,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m017-0260","start":260,"end":261,"surface":"嬰","kind":"person","person_id":"li9_cmb_8ci","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-098-fujin:p001","text":"陽陵侯傅寬，以魏五大夫騎將從，為舍人，起橫陽。從攻安陽、杠里，擊趙賁軍於開封，及擊楊熊曲遇、陽武，斬首十二級，賜爵卿。從至霸上。沛公立為漢王，漢王賜寬封號共德君。從入漢中，遷為右騎將。從定三秦，賜食邑雕陰。從擊項籍，待懷，賜爵通德侯。從擊項冠、周蘭、龍且，所將卒斬騎將一人敖下，益食邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":