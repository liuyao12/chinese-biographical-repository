served":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-huanwen:p008:m0124","start":124,"end":126,"surface":"郭敬","kind":"person","person_id":"jaj_wtk_lgm","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-098-huanwen:p008","chapter_id":"c-jinshu-098-huanwen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-huanwen:p008","text":"進位太尉，固讓不拜。時殷浩至洛陽修復園陵，經涉數年，屢戰屢敗，器械都盡。溫復進督司州，因朝野之怨，乃奏廢浩，自此內外大權一歸溫矣。溫遂統步騎四萬發江陵，水軍自襄陽入均口。至南鄉，步自淅川以征關中，命梁州刺史司馬勳出子午道。別軍攻上洛，獲苻健荊州刺史郭敬，進擊青泥，破之。健又遣子生、弟雄眾數萬屯嶢柳、愁思塠以距溫，遂大戰，生親自陷陣，殺溫將應庭、劉泓，死傷千數。溫軍力戰，生眾乃散。雄又與將軍桓沖戰白鹿原，又為沖所破。雄遂馳襲司馬勳，勳退次女媧堡。溫進至霸上，健以五千人深溝自固，居人皆安堵復業，持牛酒迎溫于路者十八九，耆老感泣曰：「不圖今日復見官軍！」初，溫恃麥熟，取以為軍資。而健芟苗清野，軍糧不屬，收三千餘口而還。帝使侍中黃門勞溫於襄陽。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2614273-raw.wikitext","raw_start":9598,"raw_end":9920,"character_positions":[9598,9599,9600,9601,9602,9603,9604,9605,9606,9607,9608,9609,9610,9611,9612,9613,9614,9615,9616,9617,9618,9619,9620,9621,9622,9623,9624,9625,9626,9627,9628,9629,9630,9631,9632,9633,9634,9635,9636,9637,9638,9639,9640,9641,9642,9643,9644,9645,9646,9647,9648,9649,9650,9651,9652,9653,9654,9655,9656,9657,9658,9659,9660,9661,9662,9663,9664,9665,9666,9667,9668,9669,9670,9671,9672,9673,9674,9675,9676,9677,9678,9679,9680,9681,9682,9683,9684,9685,9686,9687,9688,9689,9690,9691,9692,9693,9694,9695,9696,9697,9698,9699,9700,9701,9702,9703,9704,9705,9706,9707,9708,9709,9710,9711,9712,9713,9714,9715,9716,9717,9718,9719,9720,9721,9722,9723,9724,9725,9726,9727,9728,9729,9730,9731,9732,9733,9734,9735,9736,9737,9738,9739,9740,9741,9742,9743,9744,9745,9746,9747,9748,9749,9750,9751,9752,9753,9754,9755,9756,9757,9758,9759,9760,9761,9762,97