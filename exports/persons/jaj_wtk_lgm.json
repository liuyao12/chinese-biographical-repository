,"person_id":"smf_swf_i2l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0262","surface":"硃燾","start":262,"end":264,"person_id":"iw7_qrr_3td","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0282","surface":"蕭敬文","start":282,"end":285,"person_id":"cve_v72_q40","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0293","surface":"楊謹","start":293,"end":295,"person_id":"bw0_zhf_nay","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0311","surface":"鄧遐","start":311,"end":313,"person_id":"okp_6uz_rfi","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0314","surface":"撫","start":314,"end":315,"person_id":"smf_swf_i2l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0332","surface":"司馬勳","start":332,"end":335,"person_id":"8dm_11s_z5x","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0337","surface":"撫","start":337,"end":338,"person_id":"smf_swf_i2l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0341","surface":"敬文","start":341,"end":343,"person_id":"cve_v72_q40","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0358","surface":"撫","start":358,"end":359,"person_id":"smf_swf_i2l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-058-zhou-fu:p002:m0401","surface":"楚","start":401,"end":402,"person_id":"aiu_ulx_ejj","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-058-zhou-fu","book_id":"b-jinshu-058","work_id":"w-jinshu","source_id":"s-jinshu-058-zhou-fu-ws1775463"},{"id":"c-jinshu-066-taokan:p017","text":"遣子斌與南中郎將桓宣西伐樊城，走石勒將郭敬。使兄子臻、竟陵太守李陽等共破新野，遂平襄陽。拜大將軍，劍履上殿，入朝不趨，贊拜不名。上表固讓，曰：「臣非貪於疇昔，而虛讓於今日。事有合于時宜，臣豈敢與陛下有違；理有益於聖世，臣豈與朝廷作異。臣常欲除諸浮長之事，遣諸虛假之用，非獨臣身而已。若臣杖國威靈，梟雄斬勒，則又何以加！」咸和七年六月疾篤，又上表遜位曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":61,"last_line":61,"raw_start":7557,"raw_end":7742,"raw_character_offsets":[7559,7560,7561,7562,7563,7564,7565,7566,7567,7568,7569,7570,7571,7572,7573,7574,7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594,7595,7596,7597,7598,7599,7600,7601,7602,7603,7604,7605,7606,7607,7608,7609,7610,7611,7612,7613,7614,7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653,7654,7655,7656,7657,7658,7659,7660,7661,7662,7663,7664,7665,7666,7667,7668,7669,7670,7671,7672,7673,7674,7675,7676,7677,7678,7679,7680,7681,7682,7683,7684,7685,7686,7687,7688,7689,7690,7691,7692,7693,7694,7695,7696,7697,7698,7699,7700,7701,7702,7703,7704,7705,7706,7707,7708,7709,7710,7711,7712,7713,7714,7715,7716,7717,7718,7724,7725,7726,7727,7730,7731,7732,7733,7734,7735,7736,7737,7738,7739,7740,7741],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taokan:p017:m0002","surface":"斌","start":2,"end":3,"person_id":"byj_6mo_vpe","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0008","surface":"桓宣","start":8,"end":10,"person_id":"qak_wzz_t6i","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0016","surface":"石勒","start":16,"end":18,"person_id":"0c9_95a_18b","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0019","surface":"郭敬","start":19,"end":21,"person_id":"jaj_wtk_lgm","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0025","surface":"臻","start":25,"end":26,"person_id":"zyf_30n_e5t","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p017:m0031","surface":"李陽","start":31,"end":33,"person_id":"3se_4j0_fhb","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-ws1527632"},{"id":"c-jinshu-098-huanwen:p008","text":"進位太尉，固讓不拜。時殷浩至洛陽修復園陵，經涉數年，屢戰屢敗，器械都盡。溫復進督司州，因朝野之怨，乃奏廢浩，自此內外大權一歸溫矣。溫遂統步騎四萬發江陵，水軍自襄陽入均口。至南鄉，步自淅川以征關中，命梁州刺史司馬勳出子午道。別軍攻上洛，獲苻健荊州刺史郭敬，進擊青泥，破之。健又遣子生、弟雄眾數萬屯嶢柳、愁思塠以距溫，遂大戰，生親自陷陣，殺溫將應庭、劉泓，死傷千數。溫軍力戰，生眾乃散。雄又與將軍桓沖戰白鹿原，又為沖所破。雄遂馳襲司馬勳，勳退次女媧堡。溫進至霸上，健以五千人深溝自固，居人皆安堵復業，持牛酒迎溫于路者十八九，耆老感泣曰：「不圖今日復見官軍！」初，溫恃麥熟，取以為軍資。而健芟苗清野，軍糧不屬，收三千餘口而還。帝使侍中黃門勞溫於襄陽。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2614273-raw.wikitext","raw_start":9598,"raw_end":9920,"character_positions":[9598,9599,9600,9601,9602,9603,9604,9605,9606,9607,9608,9609,9610,9611,9612,9613,9614,9615,9616,9617,9618,9619,9620,9621,9622,9623,9624,9625,9626,9627,9628,9629,9630,9631,9632,9633,9634,9635,9636,9637,9638,9639,9640,9641,9642,9643,9644,9645,9646,9647,9648,9649,9650,9651,9652,9653,9654,9655,9656,9657,9658,9659,9660,9661,9662,9663,9664,9665,9666,9667,9668,9669,9670,9671,9672,9673,9674,9675,9676,9677,9678,9679,9680,9681,9682,9683,9684,9685,9686,9687,9688,9689,9690,9691,9692,9693,9694,9695,9696,9697,9698,9699,9700,9701,9702,9703,9704,9705,9706,9707,9708,9709,9710,9711,9712,9713,9714,9715,9716,9717,9718,9719,9720,9721,9722,9723,9724,9725,9726,9727,9728,9729,9730,9731,9732,9733,9734,9735,9736,9737,9738,9739,9740,9741,9742,9743,9744,9745,9746,9747,9748,9749,9750,9751,9752,9753,9754,9755,9756,9757,9758,9759,9760,9761,9762,9763,9764,9765,9766,9767,9768,9769,9770,9771,9772,9773,9774,9775,9776,9777,9778,9779,9780,9781,9782,9783,9784,9785,9786,9787,9788,9789,9790,9791,9792,9793,9794,9795,9796,9797,9798,9799,9800,9801,9802,9803,9804,9805,9806,9807,9808,9809,9810,9811,9812,9813,9814,9815,9816,9817,9818,9819,9820,9821,9822,9823,9824,9825,9826,9827,9828,9829,9830,9831,9832,9833,9834,9835,9836,9837,9838,9839,9840,9841,9842,9843,9844,9845,9846,9847,9848,9849,9850,9851,9852,9853,9854,9855,9856,9857,9858,9859,9860,9861,9862,9863,9864,9865,9866,9867,9868,9869,9870,9871,9872,9873,9874