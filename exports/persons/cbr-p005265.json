病甚，人有惡噲黨於呂氏，即上一日宮車晏駕，則噲欲以兵盡誅滅戚氏、趙王如意之屬。高帝聞之大怒，乃使陳平載絳侯代將，而即軍中斬噲。陳平畏呂后，執噲詣長安。至則高祖已崩，呂后釋噲，使復爵邑。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m009-0002","start":2,"end":4,"surface":"盧綰","kind":"person","person_id":"cbr-p005284","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0006","start":6,"end":8,"surface":"高帝","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0009","start":9,"end":10,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0018","start":18,"end":20,"surface":"高帝","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0026","start":26,"end":27,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0042","start":42,"end":43,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0052","start":52,"end":56,"surface":"趙王如意","kind":"person","person_id":"cbr-p005265","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0059","start":59,"end":61,"surface":"高帝","kind":"person","person_id":"cbr-p005253","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0068","start":68,"end":70,"surface":"陳平","kind":"person","person_id":"cbr-p005289","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0071","start":71,"end":73,"surface":"絳侯","kind":"person","person_id":"cbr-p005276","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0081","start":81,"end":82,"surface":"噲","kind":"person","person_id":"cbr-p005252","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m009-0083","start":83,"end":85,"surface":"陳平","kind":"person","person_id":"cbr-p005289","status":"contextual_provisional"},{"id":"c-