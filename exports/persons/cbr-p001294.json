{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001294","identity_policy":"contextual_provisional","person_ids":["cbr-p001294"],"persons":[{"id":"cbr-p001294","label":"晉君（內昭公議事未名）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"晉君","mention_ids":["c-shiji-033-lu:m077-0030","c-shiji-033-lu:m077-0033"]}],"evidence":[{"mention_id":"c-shiji-033-lu:m077-0030","chapter_id":"c-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p077","quote":"晉君"},{"mention_id":"c-shiji-033-lu:m077-0033","chapter_id":"c-shiji-033-lu","paragraph_id":"c-shiji-033-lu:p077","quote":"晉君"}]}],"source_mention_summary":[{"source_id":"s-shiji-033-lu","work_id":"w-shiji","book_id":"b-shiji-033","chapter_id":"c-shiji-033-lu","mention_count":2,"mention_ids":["c-shiji-033-lu:m077-0030","c-shiji-033-lu:m077-0033"],"paragraph_ids":["c-shiji-033-lu:p077"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-033-lu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-033-lu:m077-0030","start":30,"end":32,"surface":"晉君","kind":"person","person_id":"cbr-p001294","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p077","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m077-0033","start":33,"end":35,"surface":"晉君","kind":"person","person_id":"cbr-p001294","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p077","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-165","person_id":"cbr-p001294","surfaces":["晉君"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p077","quote":"二十八年，昭公如晉，求入。季平子私於晉六卿，六卿受季氏賂，諫晉君，晉君乃止，居昭公乾矦。二十九年，昭公如鄆。齊景公使人賜昭公書，自謂『主君』。昭公恥之，怒而去乾矦。三十一年，晉欲內昭公，召季平子。平子布衣跣行，因六卿謝罪。六卿爲言曰：『晉欲內昭公，眾不從。』晉人止。三十二年，昭公卒於乾矦。魯人共立昭公弟宋爲君，是爲定公。"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p077","text":"二十八年，昭公如晉，求入。季平子私於晉六卿，六卿受季氏賂，諫晉君，晉君乃止，居昭公乾矦。二十九年，昭公如鄆。齊景公使人賜昭公書，自謂『主君』。昭公恥之，怒而去乾矦。三十一年，晉欲內昭公，召季平子。平子布衣跣行，因六卿謝罪。六卿爲言曰：『晉欲內昭公，眾不從。』晉人止。三十二年，昭公卒於乾矦。魯人共立昭公弟宋爲君，是爲定公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m077-0005","start":5,"end":7,"surface":"昭公","kind":"person","person_id":"cbr-p001178","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m077-0013","start":13,"end":16,"surface":"季平子","kind":"person","person_id":"cbr-p001280","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m077-0019","start":19,"end":21,"surface":"六卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m077-0022","start":22,"end":24,"surface":"六卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m077-0025","start":25,"end":27,"surface":"季氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未指名者、論贊署稱、地點氏稱或未定指代；不補姓名、爵位與成員。"},{"id":"c-shiji-033-lu:m077-0030","start":30,"end":32,"surface":"晉君","kind":"person","person_id":"cbr-p001294","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m077-0033","start":33,"end":35,"surface":"晉君","kind":"person","person_id":"cbr-p001294","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m077-0039","start":39,"end":41,"surface":"昭公","kind":"person","person_id":"cbr-p001178","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m077-0049","start":49,"end":51,"surface":"昭公","kind":"person","person_id":"cbr-p001178","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m077-0054","start":54,"end":57,"surface":"齊景公","kind":"person