tatus":"contextual_provisional"}],"chapter_id":"c-jinshu-060-suojing","book_id":"b-jinshu-060","work_id":"w-jinshu","source_id":"s-jinshu-060-suojing-ws2413335"},{"id":"c-jinshu-061-liuqiao:p001","text":"劉喬，字仲彥，南陽人也。其先漢宗室，封安眾侯，傳襲曆三代。祖廙，魏侍中。父阜，陳留相。喬少為秘書郎，建威將軍王戎引為參軍。伐吳之役，戎使喬與參軍羅尚濟江，破武昌，還授滎陽令，遷太子洗馬。以誅楊駿功，賜爵關中侯，拜尚書右丞。豫誅賈謐，封安眾男，累遷散騎常侍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":104,"last_line":104,"raw_start":8441,"raw_end":8571,"raw_character_offsets":[8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453,8454,8455,8456,8457,8458,8459,8460,8461,8462,8463,8464,8465,8466,8467,8468,8469,8470,8471,8472,8473,8474,8475,8476,8477,8478,8479,8480,8481,8482,8483,8484,8485,8486,8487,8488,8489,8490,8491,8492,8493,8494,8495,8496,8497,8498,8499,8500,8501,8502,8503,8504,8505,8506,8507,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523,8524,8525,8526,8527,8528,8529,8530,8531,8532,8533,8534,8535,8536,8537,8538,8539,8540,8541,8542,8543,8544,8545,8546,8547,8548,8549,8550,8551,8552,8553,8554,8555,8556,8557,8558,8559,8560,8561,8562,8563,8564,8565,8566,8567,8568,8569,8570],"revision_id":7903772},"mentions":[{"id":"c-jinshu-061-liuqiao:p001:m0000","surface":"劉喬","start":0,"end":2,"person_id":"7xd_7vq_fwl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0030","surface":"廙","start":30,"end":31,"person_id":"7i3_di7_l5h","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0037","surface":"阜","start":37,"end":38,"person_id":"bic_puf_mq3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0043","surface":"喬","start":43,"end":44,"person_id":"7xd_7vq_fwl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0054","surface":"王戎","start":54,"end":56,"person_id":"48e_04a_3d8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0066","surface":"戎","start":66,"end":67,"person_id":"48e_04a_3d8","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0068","surface":"喬","start":68,"end":69,"person_id":"7xd_7vq_fwl","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0072","surface":"羅尚","start":72,"end":74,"person_id":"ma5_8sy_w9i","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0095","surface":"楊駿","start":95,"end":97,"person_id":"603_131_11e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-liuqiao:p001:m0113","surface":"賈謐","start":113,"end":115,"person_id":"ga3_phu_mfa","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-061-liuqiao","book_id":"b-jinshu-061","work_id":"w-jinshu","source_id":"s-jinshu-061-liuqiao-ws7903772"},{"id":"c-jinshu-066-liuhong:p004","text":"弘於是勸課農桑，寬刑省賦，歲用有年，百姓愛悅。弘嘗夜起，聞城上持更者歎聲甚苦，遂呼省之。兵年過六十，羸疾無襦。弘湣之，乃謫罰主者，遂給韋袍復帽，轉以相付。舊制，峴方二山澤中不聽百姓捕魚，弘下教曰：「禮，名山大澤不封，與共其利。今公私並兼，百姓無復厝手地，當何謂邪！速改此法。」又「酒室中雲齊中酒、聽事酒、猥酒，同用曲米，而優劣三品。投醪當與三軍同其薄厚，自今不得分別。」時益州刺史羅尚為李特所敗，遣使告急，請糧。弘移書贍給，而州府綱紀以運道懸遠，文武匱乏，欲以零陵一運米五千斛與尚。弘曰：「諸君未之思耳。天下一家，彼此無異，吾今給之，則無西顧之憂矣。」遂以零陵米三萬斛給之。尚賴以自固。于時流人在荊州十餘萬戶，羈旅貧乏，多為盜賊。弘乃給其田種糧食，擢其賢才，隨資敘用。時總章太樂伶人，避亂多至荊州，或勸可作樂者。弘曰：「昔劉景升以禮壞樂崩，命杜夔為天子合樂，樂成，欲庭作之。夔曰：'為天子合樂而庭作之，恐非將軍本意。'吾常為之歎息。今主上蒙塵，吾未能展效臣節，雖有家伎，猶不宜聽，況禦樂哉！」乃下郡縣，使安慰之，須朝廷旋返，送還本署。論平張昌功，應封次子一人縣侯，弘上疏固讓，許之。進拜侍中、鎮南大將軍、開府儀同三司。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":16,"last_line":16,"raw_start":1485,"raw_end":1996,"raw_character_offsets":[1487,1488,1489,1490,1491,1492,1493,1494,1495,1496,1497,1498,1499,1500,1501,1502,1503,1504,1505,1506,1507,1508,1509,1510,1511,1512,1513,1514,1515,1516,1517,1518,1519,1520,1521,1522,1523,1524,1525,1526,1527,1528,1529,1530,1531,1532,1533,1534,1535,1536,1537,1538,1539,1540,1541,1542,1543,1544,1545,1546,1547,1548,1549,1550,1551,1552,1553,1554,1555,1556,1557,1558,1559,1560,1561,1562,1563,1564,1565,1566,1567,1568,1569,1570,1571,1572,1573,1574,1575,1576,1