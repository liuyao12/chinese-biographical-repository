not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-jinshu-057-luo-shang:source_review1-0","kind":"source_review","person_id":"ma5_8sy_w9i","source_quote":"尚字敬之，一名仲。父式，牂柯太守。尚少孤，依叔父憲。善屬文。荊州刺史王戎以尚及劉喬為參軍，並委任之。太康末，為梁州刺史。及趙廞反于蜀，尚表曰：「廞非雄才，必無所成，計日聽其敗耳。」乃假尚節為平西將軍、益州刺史、西戎校尉。性貪，少斷，蜀人言曰：「尚之所愛，非邪則佞，尚之所憎，非忠則正。富擬魯、衛，家成市里；貪如豺狼，無復極已。」又曰：「蜀賊尚可，羅尚殺我。平西將軍，反更為禍。」時李特亦起於蜀，攻蜀，殺趙廞。又攻尚于成都，尚退保江陽，初，尚乞師方岳，荊州刺史宗岱率建平太守孫阜救之，次於江州，岱、阜兵盛，諸為寇所逼者，人有奮志。尚乃使兵曹從事任銳偽降，因出密宣告於外，克日俱擊，遂大破之，斬李特，傳首洛陽。特子雄僭號，都於郫城。尚遣將軍隗伯攻之，不克。俄而尚卒，雄遂據有蜀土。","reading":"羅尚字敬之，一名仲；父式，依叔父憲。益州事記趙廞、李特、李雄與援軍。","note":"羅尚字敬之，一名仲；父式，依叔父憲。益州事記趙廞、李特、李雄與援軍。","paragraph_id":"c-jinshu-057-luo-shang:p001","start_codepoint":0,"end_codepoint":338,"human_reviewed":false,"chapter_id":"c-jinshu-057-luo-shang","source_id":"s-jinshu-057-luo-shang-ws2413329"},{"id":"c-jinshu-057-luo-shang:source_relationship1-17","kind":"source_relationship","person_id":"ma5_8sy_w9i","source_quote":"尚少孤，依叔父憲","reading":"與卷首兄子稱謂互證。","note":"與卷首兄子稱謂互證。","paragraph_id":"c-jinshu-057-luo-shang:p001","start_codepoint":17,"end_codepoint":25,"human_reviewed":false,"related_person_id":"q05_0zd_hux","chapter_id":"c-jinshu-057-luo-shang","source_id":"s-jinshu-057-luo-shang-ws2413329"},{"id":"c-jinshu-057-luo-xian:source_relationship3-25","kind":"source_relationship","person_id":"ma5_8sy_w9i","source_quote":"兄子尚","reading":"羅憲傳尾明稱兄子。","note":"羅憲傳尾明稱兄子。","paragraph_id":"c-jinshu-057-luo-xian:p003","start_codepoint":25,"end_codepoint":28,"human_reviewed":false,"related_person_id":"q05_0zd_hux","chapter_id":"c-jinshu-057-luo-xian","source_id":"s-jinshu-057-luo-xian-ws2413329"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin057-volume-luo-shi","subject_person_id":"ma5_8sy_w9i","object_person_id":"el7_dms_xl7","predicate":"father","qualifiers":{"source_term":"父式"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-luo-shang","source_id":"s-jinshu-057-luo-shang-ws2413329","paragra