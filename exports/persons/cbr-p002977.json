{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002977","identity_policy":"contextual_provisional","person_ids":["cbr-p002977"],"persons":[{"id":"cbr-p002977","label":"孝文王（陳涉世家秦褚氏引文候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"孝文王","mention_ids":["c-shiji-048-chenshe:m024-0002"]}],"evidence":[{"mention_id":"c-shiji-048-chenshe:m024-0002","chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p024","quote":"孝文王"}]}],"mentions":[{"id":"c-shiji-048-chenshe:m024-0002","start":2,"end":5,"surface":"孝文王","kind":"person","person_id":"cbr-p002977","status":"contextual_provisional","paragraph_id":"c-shiji-048-chenshe:p024","chapter_id":"c-shiji-048-chenshe"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji048-015","person_id":"cbr-p002977","surfaces":["孝文王"],"scope":"same_chapter","chapter_ids":["c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-048-chenshe:p024","quote":"施及孝文王、莊襄王，享國之日淺，國家無事。及至始皇，奮六世之余烈，振長策而御宇內，吞二周而亡諸侯，履至尊而制六合，執敲樸以鞭笞天下，威振四海。南取百越之地，以為桂林、象郡，百越之君俛首系頸，委命下吏。乃使蒙恬北筑長城而守藩籬，卻匈奴七百余里，胡人不敢南下而牧馬，士亦不敢貫弓而報怨。於是廢先王之道，燔百家之言，以愚黔首。墮名城，殺豪俊，收天下之兵聚之咸陽，銷鋒鍉，鑄以為金人十二，以弱天下之民。然後踐華為城，因河為池，據億丈之城，臨不測之谿以為固。良將勁弩，守要害之處，信臣精卒，陳利兵而誰何。天下已定，始皇之心，自以為關中之固，金城千里，子孫帝王萬世之業也。"}],"rationale":"限明示名、字及局部軍事角色；陳勝涉、吳廣叔、蔡賜房君與周文周章暫接，吳廣韓廣分開。引文四君短稱及比擬人物另留候選，詐稱扶蘇項燕不合陳吳，褚賈署稱不補姓名。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-048-chenshe:p024","text":"施及孝文王、莊襄王，享國之日淺，國家無事。及至始皇，奮六世之余烈，振長策而御宇內，吞二周而亡諸侯，履至尊而制六合，執敲樸以鞭笞天下，威振四海。南取百越之地，以為桂林、象郡，百越之君俛首系頸，委命下吏。乃使蒙恬北筑長城而守藩籬，卻匈奴七百余里，胡人不敢南下而牧馬，士亦不敢貫弓而報怨。於是廢先王之道，燔百家之言，以愚黔首。墮名城，殺豪俊，收天下之兵聚之咸陽，銷鋒鍉，鑄以為金人十二，以弱天下之民。然後踐華為城，因河為池，據億丈之城，臨不測之谿以為固。良將勁弩，守要害之處，信臣精卒，陳利兵而誰何。天下已定，始皇之心，自以為關中之固，金城千里，子孫帝王萬世之業也。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-048-chenshe:m024-0002","start":2,"end":5,"surface":"孝文王","kind":"person","person_id":"cbr-p002977","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m024-0006","start":6,"end":9,"surface":"莊襄王","kind":"person","person_id":"cbr-p002978","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m024-0023","start":23,"end":25,"surface":"始皇","kind":"person","person_id":"cbr-p003043","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m024-0086","start":86,"end":90,"surface":"百越之君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m024-0102","start":102,"end":104,"surface":"蒙恬","kind":"person","person_id":"cbr-p003044","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m024-0224","start":224,"end":226,"surface":"良將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m024-0235","start":235,"end":237,"surface":"信臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m024-0252","start":252,"end":254,"surface":"始皇","kind":"person","person_id":"cbr-p003043","status":"contextual_provisional"}],"chapter_id":"c-shiji-048-chenshe","book_id":"b-shiji-048","work_id":"w-shiji","source_id":"s-shiji-048-chenshe"}],"sources":[{"chapter_id":"c-shiji-048-chenshe","work_id":"w-shiji","book_id":"b-shiji-048","source_id":"s-shiji-048-chenshe","source":{"title":"史記／卷048","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷048","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷048&oldid=2531218","revision_id":2531218,"accessed_on":"2026-10-09","extent":"26段史文；前20段篇文，後6段明署褚先生曰及所引賈生文字另分層，排除註釋版導覽與2個dd。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extra