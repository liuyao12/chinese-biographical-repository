tart":56,"end":58,"surface":"叔瞻","kind":"person","person_id":"67y_7vs_x2g","status":"contextual_provisional","paragraph_id":"c-shiji-042-zheng:p060","chapter_id":"c-shiji-042-zheng"}],"relations":[{"id":"a-shiji042-020","subject_person_id":"67y_7vs_x2g","predicate":"brother","object_person_id":"muq_yy8_8er_BA","status":"source_attested","evidence":[{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p019","quote":"三十六年，晉公子重耳過，文公弗禮。文公弟叔詹曰：「重耳賢，且又同姓，窮而過君，不可無禮。」文公曰：「諸侯亡公子過者多矣，安能盡禮之！」詹曰：「君如弗禮，遂殺之；弗殺，使卽反國，爲鄭憂矣。」文公弗聽。"}],"qualifiers":{"source_term":"文公弟叔詹","historicity":"historical_tradition"},"interpretation_note":"依明示子、母、兄弟及祖系保存來源主張；不把繼位當父子，不由兄弟推同母。傳說及夢中祖先主張保留敘事性，不冒稱已證史實。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji038-083","person_id":"4bx_x9i_210","surfaces":["叔瞻"],"scope":"same_chapter","chapter_ids":["c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-038-song:p038","quote":"楚成王已救鄭，鄭享之；去而取鄭二姬以歸。叔瞻曰：「成王无禮，其不沒乎？爲禮卒於无別，有以知其不遂霸也。」"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-121","person_id":"4bx_x9i_210","surfaces":["叔瞻","鄭叔瞻"],"scope":"cross_chapter","chapter_ids":["c-shiji-038-song","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-038-song:p038","quote":"楚成王已救鄭，鄭享之；去而取鄭二姬以歸。叔瞻曰：「成王无禮，其不沒乎？爲禮卒於无別，有以知其不遂霸也。」"},{"paragraph_id":"c-shiji-039-jin:p057","quote":"過鄭，鄭文公弗禮。鄭叔瞻諫其君曰：「晉公子賢，而其從者皆國相，且又同姓。鄭之出自厲王，而晉之出自武王。」鄭君曰：「諸侯亡公子過此者衆，安可盡禮！」叔瞻曰：「君不禮，不如殺之，且後爲國患。」鄭君不聽。"},{"paragraph_id":"c-shiji-039-jin:p076","quote":"七年，晉文公、秦繆公共圍鄭，以其無禮於文公亡過時，及城濮時鄭助楚也。圍鄭，欲得叔瞻。叔瞻聞之，自殺。鄭持叔瞻告晉。晉曰：「必得鄭君而甘心焉。」鄭恐，乃閒令使謂秦繆公曰：「亡鄭厚晉，於晉得矣，而秦未爲利。君何不解鄭，得爲東道交？」秦伯説，罷兵。晉亦罷兵。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji042-058","person_id":"67y_7vs_x2g","scope":"same_chapter","chapter_ids":["c-shiji-042-zheng"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["叔瞻","叔詹","詹"],"evidence":[{"paragraph_id":"c-shiji-042-zheng:p019","quote":"三十六年，晉公子重耳過，文公弗禮。文公弟叔詹曰：「重耳賢，且又同姓，窮而過君，不可無禮。」文公曰：「諸侯亡公子過者多矣，安能盡禮之！」詹曰：「君如弗禮，遂殺之；弗殺，使卽反國，爲鄭憂矣。」文公弗聽。"},{"paragraph_id":"c-shiji-042-zheng:p021","quote":"四十一年，助楚撃晉。自晉文公之過無禮，故背晉助楚。四十三年，晉文公與秦穆公共圍鄭，討其助楚攻晉者，及文公過時之無禮也。初，鄭文公有三夫人，寵子五人，皆以罪蚤死。公怒，溉逐群公子。子蘭奔晉，從晉文公圍鄭。時蘭事晉文公甚謹，愛幸之，乃私於晉，以求入鄭爲太子。晉於是欲得叔詹爲僇。鄭文公恐，不敢謂叔詹言。詹聞，言於鄭君曰：「臣謂君，君不聽臣，晉卒爲患。然晉所以圍鄭，以詹，詹死而赦鄭國，詹之願也。」乃自殺。鄭人以詹尸與晉。晉文公曰：「必欲一見鄭君，辱之而去。」鄭人患之，乃使人私於秦曰：「破鄭益晉，非秦之利也。」秦兵罷。晉文公欲入蘭爲太子，以告鄭。鄭大夫石癸曰：「吾聞姞姓乃后稷之元妃，其後當有興者。子蘭母，其後也。且夫人子盡已死，餘庶子無如蘭賢。今圍急，晉以爲請，利孰大焉！」遂許晉，與盟，而卒立子蘭爲太子，晉兵乃罷去。"},{"paragraph_id":"c-shiji-042-zheng:p060","quote":"厲王之子，得封於鄭。代職司徒，緇衣在詠。虢、鄶獻邑，祭祝專命。莊既犯王，厲亦奔命。居櫟克入，夢蘭毓慶。伯服生囚，叔瞻屍聘。釐、簡之後，公室不競。負黍雖還，韓哀日盛。"}],"rationale":"依本篇名字、是為、世系及連續事件暫接異稱；同諡不同國分開，建子勝與聲公勝不合併，如兄弟為譬喻不作親屬。述贊與正文不算獨立來源，省稱、古字與校勘仍待核。"}],"equivalence_decisions":[{"id":"eq-shiji042-shuzhan","person_ids":["4bx_x9i_210","67y_7vs_x2g"],"canonical_person_id":"4bx_x9i_210","scope":"cross_chapter","chapter_ids":["c-shiji-039-jin","c-shiji-042-zheng"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p076","quote":"七年，晉文公、秦繆公共圍鄭，以其無禮於文公亡過時，及城濮時鄭助楚也。圍鄭，欲得叔瞻。叔瞻聞之，自殺。鄭持叔瞻告晉。晉曰：「必得鄭君而甘心焉。」鄭恐，乃閒令使謂秦繆公曰：「亡鄭厚晉，於晉得矣，而秦未爲利。君何不解鄭，得爲東道交？」秦伯説，罷兵。晉亦罷兵。","mention_ids":["c-shiji-039-jin:m076-0039","c-shiji-039-jin:m076-0042","c-shiji-039-jin:m076-0052"]},{"chapter_id":"c-shiji-042-zheng","source_id":"s-shiji-042-zheng","paragraph_id":"c-shiji-042-zheng:p021","quote":"四十一年，助楚撃晉。自晉文公之過無禮，故背晉助楚。四十三年，晉文公與秦穆公共圍鄭，討其助楚攻晉者，及文公過時之無禮也。初，鄭文公有三夫人，寵子五人，皆以罪蚤死。公怒，溉逐群公子。子蘭奔晉，從晉文公圍鄭。時蘭事晉文公甚謹，愛幸之，乃私於晉，以求入鄭爲太子。晉於是欲得叔詹爲僇。鄭文公恐，不敢謂叔詹言。詹聞，言於鄭君曰：「臣謂君，君不聽臣，晉卒爲患。然晉所以圍鄭，以詹，詹死而赦鄭國，詹之願也。」乃自殺。鄭人以詹尸與晉。晉文公曰：「必欲一見鄭君，辱之而去。」鄭人患之，乃使人私於秦曰：「破鄭益晉，非秦之利也。」秦兵罷。晉文公欲入蘭爲太子，以告鄭。鄭大夫石癸曰：「吾聞姞姓乃后稷之元妃，其後當有興者。子蘭母，其後也。且夫人子盡已死，餘庶子無如蘭賢。今圍急，晉以爲請，利孰大焉！」遂許晉，與盟，而卒立子蘭爲太子，晉兵乃罷去。","mention_ids":["c-shiji-042-zheng:m021-0132","c-shiji-042-zheng:m021-0145","c-shiji-042-zheng:m021-0149","c-shiji-042-zheng:m021-0181","c-shiji-042-zheng:m021-0183","c-shiji-042-zheng:m021-0190","c-shiji-042-zheng:m021-0203"]}],"rationale":"同記晉圍鄭欲得鄭臣、該臣自殺而鄭交其尸；叔詹／叔瞻各原字保留，暫同指，不校改文字。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-038-song:p038","text":"楚成王已救鄭，鄭享之；去而取鄭二姬以歸。叔瞻曰：「成王无禮，其不沒乎？爲禮卒於无別，有以知其不遂霸也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-038-song:m038-0000","start":0,"end":3,"surface":"楚成王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"},{"id":"c-shiji-038-song:m038-0014","start":14,"end":17,"surface":"鄭二姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"泛稱、政制、群體、神異、匿名者或未定指代；不補未見人名、闕代、制度爵等或成員。"},{"id":"c-shiji-038-song:m038-0020","start":20,"end":22,"surface":"叔瞻","kind":"person","person_id":"4bx_x9i_210","status":"contextual_provisional"},{"id":"c-shiji-038-song:m038-0025","start":25,"end":27,"surface":"成王","kind":"person","person_id":"2d3_fsd_1dh","status":"contextual_provisional"}],"chapter_id":"c-shiji-038-song","book_id":"b-shiji-038","work_id":"w-shiji","source_id":"s-shiji-038-song"},{"id":"c-shiji-039-jin:p057","text":"過鄭，鄭文公弗禮。鄭叔瞻諫其君曰：「晉公子賢，而其從者皆國相，且又同姓。鄭之出自厲王，而晉之出自武王。」鄭君曰：「諸侯亡公子過此者衆，安可盡禮！」叔瞻曰：「君不禮，不如殺之，且後爲國患。」鄭君不聽。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m057-0004","start":4,"end":6,"surface":"文公","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m057-0009","start":9,"end":12,"surface":"鄭叔瞻","kind":"person","person_id":"4bx_x9i_210","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m057-0018","start":18,"end":21,"surface":"晉公子","kind":"person","person_id":"6di_ywz_ju4_AAA","status":"contextual