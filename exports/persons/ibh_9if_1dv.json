{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ibh_9if_1dv","canonical_person_id":"ibh_9if_1dv","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ibh_9if_1dv"],"persons":[{"id":"ibh_9if_1dv","label":"范蠡（滑稽列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"范蠡","mention_ids":["c-shiji-126-huaji:m016-0567"]}],"evidence":[{"mention_id":"c-shiji-126-huaji:m016-0567","chapter_id":"c-shiji-126-huaji","paragraph_id":"c-shiji-126-huaji:p016","quote":"范蠡"}]}],"source_mention_summary":[{"source_id":"s-shiji126-huaji","work_id":"w-shiji","book_id":"b-shiji-126","chapter_id":"c-shiji-126-huaji","mention_count":1,"mention_ids":["c-shiji-126-huaji:m016-0567"],"paragraph_ids":["c-shiji-126-huaji:p016"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji126-huaji"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-126-huaji:m016-0567","start":567,"end":569,"surface":"范蠡","kind":"person","person_id":"ibh_9if_1dv","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p016","chapter_id":"c-shiji-126-huaji"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-126-huaji:p016","text":"時會聚宮下博士諸先生與論議，共難之曰：「蘇秦、張儀一當萬乘之主，而都卿相之位，澤及後世。今子大夫修先王之術，慕聖人之義，諷誦詩書百家之言，不可勝數。著於竹帛，自以為海內無雙，即可謂博聞辯智矣。然悉力盡忠以事聖帝，曠日持久，積數十年，官不過侍郎，位不過執戟，意者尚有遺行邪？其故何也？」東方生曰：「是固非子所能備也。彼一時也，此一時也，豈可同哉！夫張儀、蘇秦之時，周室大壞，諸侯不朝，力政爭權，相禽以兵，并為十二國，未有雌雄，得士者彊，失士者亡，故說聽行通，身處尊位，澤及後世，子孫長榮。今非然也。聖帝在上，德流天下，諸侯賓服，威振四夷，連四海之外以為帶，安於覆盂，天下平均，合為一家，動發舉事，猶如運之掌中。賢與不肖，何以異哉？方今以天下之大，士民之眾，竭精馳說，并進輻湊者，不可勝數。悉力慕義，困於衣食，或失門戶。使張儀、蘇秦與仆并生於今之世，曾不能得掌故，安敢望常侍侍郎乎！傳曰：『天下無害菑，雖有聖人，無所施其才；上下和同，雖有賢者，無所立功。』故曰時異則事異；雖然，安可以不務修身乎？《詩》曰：『鼓鐘于宮，聲聞于外。鶴鳴九皋，聲聞于天。』苟能修身，何患不榮！太公躬行仁義七十二年，逢文王，得行其說，封於齊，七百歲而不絕。此士之所以日夜孜孜，修學行道，不敢止也。今世之處士，時雖不用，崛然獨立，塊然獨處，上觀許由，下察接輿，策同范蠡，忠合子胥，天下和平，與義相扶，寡偶少徒，固其常也。子何疑於余哉！」於是諸先生默然無以應也。","annotation_status":"in_progress","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-126-huaji:m016-0007","start":7,"end":10,"surface":"諸先生","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-126-huaji:m016-0020","start":20,"end":22,"surface":"蘇秦","kind":"person","person_id":"5pz_90e_hzm","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m016-0023","start":23,"end":25,"surface":"張儀","kind":"person","person_id":"vsm_g44_lxu","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m016-0103","start":103,"end":105,"surface":"聖帝","kind":"person","person_id":"kq8_9zr_p86","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m016-0142","start":142,"end":145,"surface":"東方生","kind":"person","person_id":"s11_z5r_y2z","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m016-0173","start":173,"end":175,"surface":"張儀","kind":"person","person_id":"vsm_g44_lxu","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m016-0176","start":176,"end":178,"surface":"蘇秦","kind":"person","person_id":"5pz_90e_hzm","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m016-0248","start":248,"end":250,"surface":"聖帝","kind":"person","person_id":"kq8_9zr_p86","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m016-0359","start":359,"end":361,"surface":"張儀","kind":"person","person_id":"vsm_g44_lxu","status":"contextual_provisional"},{"id":"c-shiji-126-huaji:m016-0362","start":362,"end":364,"surface":"蘇秦","kind":"per