i-061-panjun:line014-pei04-01:m0129","mention_ids":["c-sanguozhi-061-panjun:line014-pei04-01:m0129"],"kind":"paragraph"},{"canonical_mention_id":"c-sanguozhi-061-panjun:line014-pei04-01:m0243","mention_ids":["c-sanguozhi-061-panjun:line014-pei04-01:m0243"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-062-huzong"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-sanguozhi-062-huzong:line040:reading-000-367","kind":"received_sentence","paragraph_id":"c-sanguozhi-062-huzong:line040","start_codepoint":0,"end_codepoint":367,"source_quote":"　　二年，青州人隱蕃歸吳。上書曰：“臣聞紂為無道，微子先出。高祖寬明，陳平先入。臣年二十二，委棄封域，歸命有道，賴蒙天靈，得自全致。臣至北有日，而主者同之降人，未見精別，使臣徽言妙旨，不得上達。於邑三歎，曷惟其已。謹詣闕拜章，乞蒙引見。”權即召入。蕃謝答問，及陳時務，甚有辭觀。綜時侍坐，權問何如。綜對曰：\"蕃上書，大語有似東方朔，巧捷詭辯有似彌衡。而才皆不及。\"權又問可堪何官？綜對曰：\"未可以治民，且試以都輦小職。\"權以蕃盛論刑獄，用為廷尉監。左將軍朱據、廷尉郝普稱蕃有王佐之才，普尤與之親善，常怨歎其屈。後蕃謀叛，事覺伏誅，普見責自殺。據禁止，歷時乃解。拜綜偏將軍，兼左執法，領辭訟。遼東之事，輔吳將軍張昭以諫權言辭切至，權亦大怒，其和協彼此，使之無隙，綜有力焉。性嗜酒，酒後歡呼極意，或推引杯觴，搏擊左右。權愛其才，弗之責也。","person_id":"m1d_x3i_xci","related_person_ids":["lwx_9yq_ad7","buv_igi_gpn_A","yqp_nlb_p1p_A","i3f_9l9_g53","572_278_cba","qfk_09j_fhe","s11_z5r_y2z","in5_6bb_w6y","ejj_vdz_hxw","w6s_yzx_gu2","roi_rz4_ute"],"reading":"隱蕃自言二十二。郝普見責自殺，朱據被禁後解，和潘濬責子翥不宜親蕃互讀。","chapter_id":"c-sanguozhi-062-huzong","source_id":"s-sanguozhi-062-huzong"},{"id":"c-sanguozhi-062-huzong:line040-pei01-01:reading-000-140","kind":"annotation_sentence","paragraph_id":"c-sanguozhi-062-huzong:line040-pei01-01","start_codepoint":0,"end_codepoint":140,"source_quote":"吴录曰：蕃有口才，魏明帝使诈叛如吴，令求作廷尉职，重案大臣以离间之。既为廷尉监，众人以据、普与蕃亲善，常车马云集，宾客盈堂。及至事觉，蕃亡走，捕得，考问党与，蕃无所言。吴主使将入，谓曰：“何乃以肌肉为人受毒乎？”蕃曰：“孙君，丈夫图事，岂有无伴！烈士死，不足相牵耳。”遂闭口而死。","person_id":"m1d_x3i_xci","related_person_ids":["932_46f_026","ejj_vdz_hxw","w6s_yzx_gu2"],"reading":"吳錄謂魏明帝使詐叛，對話中孫君為權；未將他書細節移進正文。","chapter_id":"c-sanguozhi-062-huzong","source_id":"s-sanguozhi-062-huzong"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu061-panjun3","person_id":"m1d_x3i_xci","event_type":"death","source_term":"蕃果图叛诛夷","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-061","chapter_id":"c-sanguozhi-061-panjun","source_id":"s-sanguozhi-061-panjun","paragraph_id":"c-sanguozhi-061-panjun:line014-pei04-01","quote":"吴书曰：骠骑将军步骘屯沤口，求召募诸郡以增兵。权以问濬，濬曰：「豪将在民间，耗乱为害，加骘有名势，在所所媚，不可听也。」权从之。中郎将豫章徐宗，有名士也，尝到京师，与孔融交结，然儒生诞节，部曲宽纵，不奉节度，为众作殿，濬遂斩之。其奉法不惮私议，皆此类也。归义隐蕃，以口辩为豪杰所善，濬子翥亦与周旋，馈饷之。濬闻大怒，疏责翥曰：「吾受国厚恩，志报以命，尔辈在都，当念恭顺，亲贤慕善，何故与降虏交，以粮饷之？在远闻此，心震面热，惆怅累旬。疏到，急就往使受杖一百，促责所饷。」当时人咸怪濬，而蕃果图叛诛夷，众乃归服。","person_mention_id":"c-sanguozhi-061-panjun:line014-pei04-01:m0129"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"le-wu062-huzong1","person_id":"m1d_x3i_xci","event_type":"death","source_term":"事覺伏誅","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-062","chapter_id":"c-sanguozhi-062-huzong","source_id":"s-sanguozhi-062-huzong","paragraph_id":"c-sanguozhi-062-huzong:line040","quote":"　　二年，青州人隱蕃歸吳。上書曰：“臣聞紂為無道，微子先出。高祖寬明，陳平先入。臣年二十二，委棄封域，歸命有道，賴蒙天靈，得自全致。臣至北有日，而主者同之降人，未見精別，使臣徽言妙旨，不得上達。於邑三歎，曷惟其已。謹詣闕拜章，乞蒙引見。”權即召入。蕃謝答問，及陳時務，甚有辭觀。綜時侍坐，權問何如。綜對曰：\"蕃上書，大語有似東方朔，巧捷詭辯有似彌衡。而才皆不及。\"權又問可堪何官？綜對曰：\"未可以治民，且試