0,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,1313,1314,1315,1316,1317,1318,1319,1320,1321,1322,1323]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"吳書","attribution_marker":"吴书曰：","quoted_work":"吳書"},"attachment":{"received_paragraph_id":"c-sanguozhi-061-panjun:line014","received_codepoint":108,"note_ordinal":4,"source_ordinal":1},"chapter_id":"c-sanguozhi-061-panjun","book_id":"b-sanguozhi-061","work_id":"w-sanguozhi","source_id":"s-sanguozhi-061-panjun"},{"id":"c-sanguozhi-062-huzong:line040","text":"　　二年，青州人隱蕃歸吳。上書曰：“臣聞紂為無道，微子先出。高祖寬明，陳平先入。臣年二十二，委棄封域，歸命有道，賴蒙天靈，得自全致。臣至北有日，而主者同之降人，未見精別，使臣徽言妙旨，不得上達。於邑三歎，曷惟其已。謹詣闕拜章，乞蒙引見。”權即召入。蕃謝答問，及陳時務，甚有辭觀。綜時侍坐，權問何如。綜對曰：\"蕃上書，大語有似東方朔，巧捷詭辯有似彌衡。而才皆不及。\"權又問可堪何官？綜對曰：\"未可以治民，且試以都輦小職。\"權以蕃盛論刑獄，用為廷尉監。左將軍朱據、廷尉郝普稱蕃有王佐之才，普尤與之親善，常怨歎其屈。後蕃謀叛，事覺伏誅，普見責自殺。據禁止，歷時乃解。拜綜偏將軍，兼左執法，領辭訟。遼東之事，輔吳將軍張昭以諫權言辭切至，權亦大怒，其和協彼此，使之無隙，綜有力焉。性嗜酒，酒後歡呼極意，或推引杯觴，搏擊左右。權愛其才，弗之責也。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-062-huzong:line040:m0008","start":8,"end":10,"surface":"隱蕃","kind":"person","person_id":"m1d_x3i_xci","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line040:m0020","start":20,"end":21,"surface":"紂","kind":"person","person_id":"lwx_9yq_ad7","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line040:m0025","start":25,"end":27,"surface":"微子","kind":"person","person_id":"buv_igi_gpn_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line040:m0030","start":30,"end":32,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line040:m0035","start":35,"end":37,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-062-huzong:line040:m0119","star