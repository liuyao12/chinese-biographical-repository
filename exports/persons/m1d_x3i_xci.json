uzong:line040","person_mention_id":"c-sanguozhi-062-huzong:line040:m0008","start":220,"end":223,"surface":"廷尉監","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"person_references":[{"id":"c-sanguozhi-062-huzong:line040:r0040","paragraph_id":"c-sanguozhi-062-huzong:line040","start":40,"end":41,"surface":"臣","person_id":"m1d_x3i_xci","referent_role":"speaker_self","quote":"明，陳平先入。臣年二十二，委棄","note":"依對話說話者、受書者及上下句定位。","chapter_id":"c-sanguozhi-062-huzong","book_id":"b-sanguozhi-062","work_id":"w-sanguozhi","source_id":"s-sanguozhi-062-huzong"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-deng:line012-pei02-02","text":"《吳書》曰：衜初爲中庶子，年二十。時廷尉監隱蕃交結豪傑，自衞將軍全琮等皆傾心敬待，惟衜及宣詔郎豫章楊迪拒絕不與通，時人咸怪之。而蕃後叛逆，衆乃服之。　","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-059-deng:line012-pei02-02:m0006","start":6,"end":7,"surface":"衜","kind":"person","person_id":"5tz_96t_bu3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012-pei02-02:m0021","start":21,"end":23,"surface":"隱蕃","kind":"person","person_id":"m1d_x3i_xci","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012-pei02-02:m0032","start":32,"end":34,"surface":"全琮","kind":"person","person_id":"984_9e1_5e9","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012-pei02-02:m0042","start":42,"end":43,"surface":"衜","kind":"person","person_id":"5tz_96t_bu3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012-pei02-02:m0049","start":49,"end":51,"surface":"楊迪","kind":"person","person_id":"1qh_0n6_ln9","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-deng:line012-pei02-02:m0064","start":64,"end":65,"surface":"蕃","kind":"person","person_id":"m1d_x3i_xci","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":12,"last_line":12,"revision_id":2085159,"raw_start":717,"raw_end":796,"character_positions":[717,720,721,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"吳書","attribution_marker":"《吳書》曰：","quoted_work":"吳書"},"attachment":{"received_paragraph_id":"c-sanguozhi-059-deng:line012","received_codepoint":293,"note_ordinal":2,"source_ordinal":2},"chapter_id":"c-sanguozhi-059-deng","book_id":"b-sanguozhi-059","work_id":"w-sanguozhi","source_id":"s-sanguozhi-059-deng"},{"id":"c-sanguozhi-061-panjun:line014-pei04-01","text":"吴书曰：骠骑将军步骘屯沤口，求召募诸郡以增兵。权以问濬，濬曰：「豪将在民间，耗乱为害，加骘有名势，在所所媚，不可听也。」权从之。中郎将豫章徐宗，有名士也，尝到京师，与孔融交结，然儒生诞节，部曲宽纵，不奉节度，为众作殿，濬遂斩之。其奉法不惮私议，皆此类也。归义隐蕃，以口辩为豪杰所善，濬子翥亦与周旋，馈饷之。濬闻大怒，疏责翥曰：「吾受国厚恩，志报以命，尔辈在都，当念恭顺，亲贤慕善，何故与降虏交，以粮饷之？在远闻此，心震面热，惆怅累旬。疏到，急就往使受杖一百，促责所饷。」当时人咸怪濬，而蕃果图叛诛夷，众乃归服。","text_layer":"witness_appended_pei_songzhi_note","mentions":[{"id":"c-sanguozhi-061-panjun:line014-pei04-01:m0008","start":8,"end":10,"surface":"步骘","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-panjun:line014-pei04-01:m0023","start":23,"end":24,"surface":"权","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-panjun:line014-pei04-01:m0026","start":26,"end":27,"surface":"濬","kind":"person","person_id":"pac_tt7_hs3","status":"contextual_provisional","int