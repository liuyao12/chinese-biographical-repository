","kind":"person","person_id":"30b_08l_rxm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-lukang:line077","chapter_id":"c-sanguozhi-058-lukang"},{"id":"c-sanguozhi-061-lukai:line042:m0071","start":71,"end":73,"surface":"樓玄","kind":"person","person_id":"30b_08l_rxm","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-lukai:line042","chapter_id":"c-sanguozhi-061-lukai"}],"relations":[],"title_holdings":[{"id":"t-wu058-k20","person_id":"30b_08l_rxm","kind":"office","title":"大司農","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-058","chapter_id":"c-sanguozhi-058-lukang","source_id":"s-sanguozhi-058-lukang","paragraph_id":"c-sanguozhi-058-lukang:line075","quote":"夫俊乂者，國家之良寶，社稷之貴資。庶政所以倫敘，四門所以穆清也。故大司農樓玄、散騎中常侍王蕃、少府李勖，皆當世秀穎，一時顯器，既蒙初寵，從容列位，而並旋受誅殛，或圮族替祀，或投棄荒裔。蓋《周禮》有赦賢之辟，《春秋》有宥善之義。","person_mention_id":"c-sanguozhi-058-lukang:line075:m0036"}],"attestations":[{"id":"t-wu058-k20:a","paragraph_id":"c-sanguozhi-058-lukang:line075","person_mention_id":"c-sanguozhi-058-lukang:line075:m0036","start":33,"end":36,"surface":"大司農","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-lukang:line075","text":"夫俊乂者，國家之良寶，社稷之貴資。庶政所以倫敘，四門所以穆清也。故大司農樓玄、散騎中常侍王蕃、少府李勖，皆當世秀穎，一時顯器，既蒙初寵，從容列位，而並旋受誅殛，或圮族替祀，或投棄荒裔。蓋《周禮》有赦賢之辟，《春秋》有宥善之義。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-lukang:line075:m0036","start":36,"end":38,"surface":"樓玄","kind":"person","pers