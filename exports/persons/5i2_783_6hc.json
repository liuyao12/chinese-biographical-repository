licy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-059-he:line030:m0048","start":48,"end":50,"surface":"丁晏","kind":"person","person_id":"5i2_783_6hc","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line030","chapter_id":"c-sanguozhi-059-he"},{"id":"c-sanguozhi-059-he:line030:m0051","start":51,"end":52,"surface":"晏","kind":"person","person_id":"5i2_783_6hc","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line030","chapter_id":"c-sanguozhi-059-he"},{"id":"c-sanguozhi-059-he:line030:m0058","start":58,"end":59,"surface":"晏","kind":"person","person_id":"5i2_783_6hc","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-059-he:line030","chapter_id":"c-sanguozhi-059-he"},{"id":"c-sanguozhi-064-suncong-complete:p001:m0152","surface":"丁晏","start":152,"end":154,"kind":"person","person_id":"5i2_783_6hc","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p001","chapter_id":"c-sanguozhi-064-suncong-complete"},{"id":"c-sanguozhi-064-suncong-complete:p001:m0177","surface":"晏","start":177,"end":178,"kind":"person","person_id":"5i2_783_6hc","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p001","chapter_id":"c-sanguozhi-064-suncong-complete"}],"relations":[],"title_holdings":[{"id":"th-sanguozhi-064-suncong-complete-1-149","title":"中書丞","kind":"office","mode":"attestation","person_id":"5i2_783_6hc","attestations":[{"id":"th-sanguozhi-064-suncong-complete-1-149:a","paragraph_id":"c-sanguozhi-064-suncong-complete:p001","start":149,"end":152,"surface":"中書丞","person_mention_id":"c-sanguozhi-064-suncong-complete:p001:m0152","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","source_id":"s-sanguozhi-064-suncong-complete-ws2263487","paragraph_id":"c-sanguozhi-064-suncong-complete:p001","quote":"　　孫綝字子通，與峻同祖。綝父綽為安民都尉。綝始為偏將軍，及峻死，為待中武衛將軍，領中外諸軍事，代知朝政。呂據聞之大恐，與諸督將連名，共表薦滕胤為丞相，綝以胤為大司馬，代呂岱駐武昌。據引兵還，使人報胤，欲共廢綝。綝聞之，遣從兄慮將兵逆據於江都，使中使敕文欽、劉纂、唐諮等合眾擊據，遣侍中左將軍華融、中書丞丁晏告胤取據，並喻胤宜速去意，胤自以禍及，因留融、晏，勒兵自衛，召典軍揚崇、將軍孫諮，告以綝為亂，迫融等使有書難綝。綝不聽，表言胤反，許將軍劉丞以封爵，使率兵騎急攻圍胤。胤又劫融等使詐詔發兵。融等不從，胤皆殺之。胤顏色不變，談笑若常。或勸胤引兵至蒼龍門，「將士見公出，必皆委綝就公」。時夜已半，胤恃與據期。又難舉兵向富，乃約令部曲，說呂侯以在近道，故皆為胤盡死，無離散者。時大風，比曉，據不至。綝兵大會，遂殺及將士數十人，夷胤三族。","person_mention_id":"c-sanguozhi-064-suncong-complete:p001:m0152"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-059-he:line030","text":"是時有司頗以條書問事，和以爲姦妄之人，將因事錯意，以生禍心，不可長也，表宜絕之。又都督劉寶白庶子丁晏，晏亦白寶，和謂晏曰：「文武在事，當能幾人，因隙構簿，圖相危害，豈有福哉？」遂兩釋之，使之從厚。常言當世士人宜講脩術學，校習射御，以周世務，而但交游博弈以妨事業，非進取之謂。後羣寮侍宴，言及博弈，以爲妨事費日而無益於用，勞精損思而終無所成，非所以進德脩業，積累功緒者也。且志士愛日惜力，君子慕其大者，高山景行，恥非其次。夫以天地長乆，而人居其間，有白駒過隙之喻，年齒一暮，榮華不再。凡所患者，在於人情所不能絕，誠能絕無益之欲以奉德義之塗，棄不急之務以脩功業之基，其於名行，豈不善哉？夫人情猶不能無嬉娛，嬉娛之好，亦在於飲宴琴書射御之間，何必博弈，然後爲歡。乃命侍坐者八人，各著論以矯之。於是中庶子韋曜退而論奏，和以示賔客。時蔡穎好弈，直事在署者頗斆焉，故以此諷之。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-059-he:line030:m0011","start":11,"end":12,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-059-he:line030