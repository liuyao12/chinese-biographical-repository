iod":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p004","quote":"於是上曰：「本言都秦地者婁敬，『婁』者乃『劉』也。」賜姓劉氏，拜為郎中，號為奉春君。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"敘事用稱與實授分存；和親建議未實行，不作呂后女已嫁單于。家人子名為長公主不推高祖親生女。叔孫通徙官記任期變動，不以高帝死亡單獨終止所有官爵。秦漢博士分兩次明示授予，儒宗為太史公評稱。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji099-005","person_id":"yv1_5v4_pjs-","title":"奉春君","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p004","quote":"於是上曰：「本言都秦地者婁敬，『婁』者乃『劉』也。」賜姓劉氏，拜為郎中，號為奉春君。"}],"attestations":[{"id":"th-shiji099-005:a001","paragraph_id":"c-shiji-099-liushu:p004","start":38,"end":41,"surface":"奉春君","person_mention_id":"c-shiji-099-liushu:m004-0012","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p004","quote":"於是上曰：「本言都秦地者婁敬，『婁』者乃『劉』也。」賜姓劉氏，拜為郎中，號為奉春君。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"敘事用稱與實授分存；和親建議未實行，不作呂后女已嫁單于。家人子名為長公主不推高祖親生女。叔孫通徙官記任期變動，不以高帝死亡單獨終止所有官爵。秦漢博士分兩次明示授予，儒宗為太史公評稱。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji099-007","person_id":"yv1_5v4_pjs-","title":"關內侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p005","quote":"漢七年，韓王信反，高帝自往擊之。至晉陽，聞信與匈奴欲共擊漢，上大怒，使人使匈奴。匈奴匿其壯士肥牛馬，但見老弱及羸畜。使者十輩來，皆言匈奴可擊。上使劉敬復往使匈奴，還報曰：「兩國相擊，此宜夸矜見所長。今臣往，徒見羸瘠老弱，此必欲見短，伏奇兵以爭利。愚以為匈奴不可擊也。」是時漢兵已踰句注，二十餘萬兵已業行。上怒，罵劉敬曰：「齊虜！以口舌得官，今乃妄言沮吾軍。」械系敬廣武。遂往，至平城，匈奴果出奇兵圍高帝白登，七日然後得解。高帝至廣武，赦敬，曰：「吾不用公言，以困平城。吾皆已斬前使十輩言可擊者矣。」乃封敬二千戶，為關內侯，號為建信侯。"}],"attestations":[{"id":"th-shiji099-007:a001","paragraph_id":"c-shiji-099-liushu:p005","start":257,"end":260,"surface":"關內侯","person_mention_id":"c-shiji-099-liushu:m005-0251","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"漢七年","evidence":[{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p005","quote":"漢七年，韓王信反，高帝自往擊之。至晉陽，聞信與匈奴欲共擊漢，上大怒，使人使匈奴。匈奴匿其壯士肥牛馬，但見老弱及羸畜。使者十輩來，皆言匈奴可擊。上使劉敬復往使匈奴，還報曰：「兩國相擊，此宜夸矜見所長。今臣往，徒見羸瘠老弱，此必欲見短，伏奇兵以爭利。愚以為匈奴不可擊也。」是時漢兵已踰句注，二十餘萬兵已業行。上怒，罵劉敬曰：「齊虜！以口舌得官，今乃妄言沮吾軍。」械系敬廣武。遂往，至平城，匈奴果出奇兵圍高帝白登，七日然後得解。高帝至廣武，赦敬，曰：「吾不用公言，以困平城。吾皆已斬前使十輩言可擊者矣。」乃封敬二千戶，為關內侯，號為建信侯。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"敘事用稱與實授分存；和親建議未實行，不作呂后女已嫁單于。家人子名為長公主不推高祖親生女。叔孫通徙官記任期變動，不以高帝死亡單獨終止所有官爵。秦漢博士分兩次明示授予，儒宗為太史公評稱。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji099-008","person_id":"yv1_5v4_pjs-","title":"建信侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p005","quote":"漢七年，韓王信反，高帝自往擊之。至晉陽，聞信與匈奴欲共擊漢，上大怒，使人使匈奴。匈奴匿其壯士肥牛馬，但見老弱及羸畜。使者十輩來，皆言匈奴可擊。上使劉敬復往使匈奴，還報曰：「兩國相擊，此宜夸矜見所長。今臣往，徒見羸瘠老弱，此必欲見短，伏奇兵以爭利。愚以為匈奴不可擊也。」是時漢兵已踰句注，二十餘萬兵已業行。上怒，罵劉敬曰：「齊虜！以口舌得官，今乃妄言沮吾軍。」械系敬廣武。遂往，至平城，匈奴果出奇兵圍高帝白登，七日然後得解。高帝至廣武，赦敬，曰：「吾不用公言，以困平城。吾皆已斬前使十輩言可擊者矣。」乃封敬二千戶，為關內侯，號為建信侯。"}],"attestations":[{"id":"th-shiji099-008:a001","paragraph_id":"c-shiji-099-liushu:p005","start":263,"end":266,"surface":"建信侯","person_mention_id":"c-shiji-099-liushu:m005-0251","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"漢七年","evidence":[{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p005","quote":"漢七年，韓王信反，高帝自往擊之。至晉陽，聞信與匈奴欲共擊漢，上大怒，使人使匈奴。匈奴匿其壯士肥牛馬，但見老弱及羸畜。使者十輩來，皆言匈奴可擊。上使劉敬復往使匈奴，還報曰：「兩國相擊，此宜夸矜見所長。今臣往，徒見羸瘠老弱，此必欲見短，伏奇兵以爭利。愚以為匈奴不可擊也。」是時漢兵已踰句注，二十餘萬兵已業行。上怒，罵劉敬曰：「齊虜！以口舌得官，今乃妄言沮吾軍。」械系敬廣武。遂往，至平城，匈奴果出奇兵圍高帝白登，七日然後得解。高帝至廣武，赦敬，曰：「吾不用公言，以困平城。吾皆已斬前使十輩言可擊者矣。」乃封敬二千戶，為關內侯，號為建信侯。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"敘事用稱與實授分存；和親建議未實行，不作呂后女已嫁單于。家人子名為長公主不推高祖親生女。叔孫通徙官記任期變動，不以高帝死亡單獨終止所有官爵。秦漢博士分兩次明示授予，儒宗為太史公評稱。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji099-001","person_id":"yv1_5v4_pjs-","relation":"biographical_origin","place":{"source_name":"齊","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-liushu:p001","quote":"劉敬者，齊人也。漢五年，戍隴西，過洛陽，高帝在焉。婁敬脫輓輅，衣其羊裘，見齊人虞將軍曰：「臣願見上言便事。」虞將軍欲與之鮮衣，婁敬曰：「臣衣帛，衣帛見；衣褐，衣褐見：終不敢易衣。」於是虞將軍入言上。上召入見，賜食。"}],"source_term":"齊人也","interpretation_note":"明示出身按原語保存；戍隴西不作劉敬籍貫，不推今日行政區或出生地。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji055-042","person_id":"cbr-p003400","surfaces":["劉敬"],"scope":"same_chapter","chapter_ids":["c-shiji-055-liu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-055-liu:p020","quote":"劉敬說高帝曰：「都關中。」上疑之。左右大臣皆山東人，多勸上都雒陽：「雒陽東有成皋，西有殽黽，倍河，向伊雒，其固亦足恃。」留侯曰：「雒陽雖有此固，其中小，不過數百里，田地薄，四面受敵，此非用武之國也。夫關中左殽函，右隴蜀，沃野千里，南有巴蜀之饒，北有胡苑之利，阻三面而守，獨以一面東制諸侯。諸侯安定，河渭漕輓天下，西給京師；諸侯有變，順流而下，足以委輸。此所謂金城千里，天府之國也，劉敬說是也。」於是高帝即日駕，西都關中。"}],"rationale":"依明示名字、局部任事、授封及引語暫接；良久、每上冢與愛子之上排除人物短稱。老父場景的父不接張良父平；韓悼惠王不接齊王，秦王子嬰不接博浪沙秦皇帝，未名者不補姓名。神異與古代比擬不表示人物當時在場或神蹟已證。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji099-009","person_id":"yv1_5v4_pjs-","surfaces":["劉敬","奉春","婁敬","敬"],"scope":"same_chapter","chapter_ids":["c-shiji-099-liushu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-099-liushu:p001","quote":"劉敬者，齊人也。漢五年，戍隴西，過洛陽，高帝在焉。婁敬脫輓輅，衣其羊裘，見齊人虞將軍曰：「臣願見上言便事。」虞將軍欲與之鮮衣，婁敬曰：「臣衣帛，衣帛見；衣褐，衣褐見：終不敢易衣。」於是虞將軍入言上。上召入見，賜食。"},{"paragraph_id":"c-shiji-099-liushu:p002","quote":"已而問婁敬，婁敬說曰：「陛下都洛陽，豈欲與周室比隆哉？」上曰：「然。」婁敬曰：「陛下取天下與周室異。周之先自后稷，堯封之邰，積德累善十有餘世。公劉避桀居豳。太王以狄伐故，去豳，杖馬箠居岐，國人爭隨之。及文王為西伯，斷虞芮之訟，始受命，呂望、伯夷自海濱來歸之。武王伐紂，不期而會孟津之上八百諸侯，皆曰紂可伐矣，遂滅殷。成王即位，周公之屬傅相焉，乃營成周洛邑，以此為天下之中也，諸侯四方納貢職，道裏均矣，有德則易以王，無德則易以亡。凡居此者，欲令周務以德致人，不欲依阻險，令後世驕奢以虐民也。及周之盛時，天下和洽，四夷鄉風，慕義懷德，附離而并事天子，不屯一卒，不戰一士，八夷大國之民莫不賓服，效其貢職。及周之衰也，分而為兩，天下莫朝，周不能制也。非其德薄也，而形勢弱也。今陛下起豐沛，收卒三千人，以之徑往而卷蜀漢，定三秦，與項羽戰滎陽，爭成皋之口，大戰七十，小戰四十，使天下之民肝腦涂地，父子暴骨中野，不可勝數，哭泣之聲未絕，傷痍者未起，而欲比隆於成康之時，臣竊以為不侔也。且夫秦地被山帶河，四塞以為固，卒然有急，百萬之眾可具也。因秦之故，資甚美膏腴之地，此所謂天府者也。陛下入關而都之，山東雖亂，秦之故地可全而有也。夫與人鬬，不搤其亢，拊其背，未能全其勝也。今陛下入關而都，案秦之故地，此亦搤天下之亢而拊其背也。」"},{"paragraph_id":"c-shiji-099-liushu:p004","quote":"於是上曰：「本言都秦地者婁敬，『婁』者乃『劉』也。」賜姓劉氏，拜為郎中，號為奉春君。"},{"paragraph_id":"c-shiji-099-liushu:p005","quote":"漢七年，韓王信反，高帝自往擊之。至晉陽，聞信與匈奴欲共擊漢，上大怒，使人使匈奴。匈奴匿其壯士肥牛馬，但見老弱及羸畜。使者十輩來，皆言匈奴可擊。上使劉敬復往使匈奴，還報曰：「兩國相擊，此宜夸矜見所長。今臣往，徒見羸瘠老弱，此必欲見短，伏奇兵以爭利。愚以為匈奴不可擊也。」是時漢兵已踰句注，二十餘萬兵已業行。上怒，罵劉敬曰：「齊虜！以口舌得官，今乃妄言沮吾軍。」械系敬廣武。遂往，至平城，匈奴果出奇兵圍高帝白登，七日然後得解。高帝至廣武，赦敬，曰：「吾不用公言，以困平城。吾皆已斬前使十輩言可擊者矣。」乃封敬二千戶，為關內侯，號為建信侯。"},{"paragraph_id":"c-shiji-099-liushu:p006","quote":"高帝罷平城歸，韓王信亡入胡。當是時，冒頓為單于，兵彊，控弦三十萬，數苦北邊。上患之，問劉敬。劉敬曰：「天下初定，士卒罷於兵，未可以武服也。冒頓殺父代立，妻群母，以力為威，未可以仁義說也。獨可以計久遠子孫為臣耳，然恐陛下不能為。」上曰：「誠可，何為不能！顧為柰何？」劉敬對曰：「陛下誠能以適長公主妻之，厚奉遺之，彼知漢適女送厚，蠻夷必慕以為閼氏，生子必為太子。代單于。何者？貪漢重幣。陛下以歲時漢所餘彼所鮮數問遺，因使辯士風諭以禮節。冒頓在，固為子婿；死，則外孫為單于。豈嘗聞外孫敢與大父抗禮者哉？兵可無戰以漸臣也。若陛下不能遣長公主，而令宗室及後宮詐稱公主，彼亦知，不肯貴近，無益也。」高帝曰：「善。」欲遣長公主。呂后日夜泣，曰：「妾唯太子、一女，柰何棄之匈奴！」上竟不能遣長公主，而取家人子名為長公主，妻單于。使劉敬往結和親約。"},{"paragraph_id":"c-shiji-099-liushu:p007","quote":"劉敬從匈奴來，因言「匈奴河南白羊、樓煩王，去長安近者七百里，輕騎一日一夜可以至秦中。秦中新破，少民，地肥饒，可益實。夫諸侯初起時，非齊諸田，楚昭、屈、景莫能興。今陛下雖都關中，實少人。北近胡寇，東有六國之族，宗彊，一日有變，陛下亦未得高枕而臥也。臣願陛下徙齊諸田，楚昭、屈、景，燕、趙、韓、魏後，及豪桀名家居關中。無事，可以備胡；諸侯有變，亦足率以東伐。此彊本弱末之術也」。上曰：「善。」乃使劉敬徙所言關中十餘萬口。"},{"paragraph_id":"c-shiji-099-liushu:p020","quote":"太史公曰：語曰「千金之裘，非一狐之腋也；臺榭之榱，非一木之枝也；三代之際，非一士之智也。」信哉！夫高祖起微細，定海內，謀計用兵，可謂盡之矣。然而劉敬脫輓輅一說，建萬世之安，智豈可專邪！叔孫通希世度務，制禮進退，與時變化，卒為漢家儒宗。「大直若詘，道固委蛇」，蓋謂是乎？"},{"paragraph_id":"c-shiji-099-liushu:p021","quote":"【索隱述贊】廈藉眾幹，裘非一狐。委輅獻說，釂蕝陳書。皇帝始貴，車駕西都。既安太子，又和匈奴。奉春、稷嗣，其功可圖。"}],"rationale":"依婁敬賜姓劉氏及叔孫通叔孫生敘事承接；各引語依人物事件範圍定位。從遠祖不補父系，和親假設不當實際生育，太子未定錨點留待逐項整理。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji055-liujing","person_ids":["cbr-p000790","cbr-p003400"],"canonical_person_id":"cbr-p000790","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-055-liu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p058","quote":"高祖欲長都雒陽，齊人劉敬說，乃留侯勸上入都關中，高祖是日駕，入都關中。六月，大赦天下。","mention_ids":["c-shiji-008-gaozu:m058-0010"]},{"chapter_id":"c-shiji-055-liu","source_id":"s-shiji-055-liu","paragraph_id":"c-shiji-055-liu:p020","quote":"劉敬說高帝曰：「都關中。」上疑之。左右大臣皆山東人，多勸上都雒陽：「雒陽東有成皋，西有殽黽，倍河，向伊雒，其固亦足恃。」留侯曰：「雒陽雖有此固，其中小，不過數百里，田地薄，四面受敵，此非用武之國也。夫關中左殽函，右隴蜀，沃野千里，南有巴蜀之饒，北有胡苑之利，阻三面而守，獨以一面東制諸侯。諸侯安定，河渭漕輓天下，西給京師；諸侯有變，順流而下，足以委輸。此所謂金城千里，天府之國也，劉敬說是也。」於是高帝即日駕，西都關中。","mention_ids":["c-shiji-055-liu:m020-0000","c-shiji-055-liu:m020-0190"]}],"rationale":"姓名與勸都關中事件相配，不由同指判定他篇異名。 已發ID、原字與每篇證據保留，身份暫接不代替史實、年代或來源優先判斷，同書各篇不當獨立見證。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"eq-shiji099-jing","person_ids":["cbr-p000790","cbr-p003400","yv1_5v4_pjs-"],"canonical_person_id":"cbr-p000790","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-055-liu","c-shiji-099-liushu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p058","quote":"高祖欲長都雒陽，齊人劉敬說，乃留侯勸上入都關中，高祖是日駕，入都關中。六月，大赦天下。","mention_ids":["c-shiji-008-gaozu:m058-0010"]},{"chapter_id":"c-shiji-055-liu","source_id":"s-shiji-055-liu","paragraph_id":"c-shiji-055-liu:p020","quote":"劉敬說高帝曰：「都關中。」上疑之。左右大臣皆山東人，多勸上都雒陽：「雒陽東有成皋，西有殽黽，倍河，向伊雒，其固亦足恃。」留侯曰：「雒陽雖有此固，其中小，不過數百里，田地薄，四面受敵，此非用武之國也。夫關中左殽函，右隴蜀，沃野千里，南有巴蜀之饒，北有胡苑之利，阻三面而守，獨以一面東制諸侯。諸侯安定，河渭漕輓天下，西給京師；諸侯有變，順流而下，足以委輸。此所謂金城千里，天府之國也，劉敬說是也。」於是高帝即日駕，西都關中。","mention_ids":["c-shiji-055-liu:m020-0000","c-shiji-055-liu:m020-0190"]},{"chapter_id":"c-shiji-099-liushu","source_id":"s-shiji-099-liushu","paragraph_id":"c-shiji-099-lius