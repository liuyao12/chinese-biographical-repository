ph_id":"c-shiji-003-yin:p020","quote":"帝小辛崩，弟小乙立","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"弟","historicity":"historical_tradition","relative_age":"younger"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p020","text":"帝盤庚崩，弟小辛立，是為帝小辛。帝小辛立，殷復衰。百姓思盤庚，迺作盤庚三篇。帝小辛崩，弟小乙立，是為帝小乙。","mentions":[{"id":"c-shiji-003-yin:m020-0000","start":0,"end":3,"surface":"帝盤庚","kind":"person","person_id":"5k7_otk_r9v","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0006","start":6,"end":8,"surface":"小辛","kind":"person","person_id":"drr_o13_0jb","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0012","start":12,"end":15,"surface":"帝小辛","kind":"person","person_id":"drr_o13_0jb","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0016","start":16,"end":19,"surface":"帝小辛","kind":"person","person_id":"drr_o13_0jb","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0028","start":28,"end":30,"surface":"盤庚","kind":"person","person_id":"5k7_otk_r9v","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0038","start":38,"end":41,"surface":"帝小辛","kind":"person","person_id":"drr_o13_0jb","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0044","start":44,"end":46,"surface":"小乙","kind":"person","person_id":"blo_hqh_iqg","status":"source_identified"},{"id":"c-shiji-003-yin:m020-0050","start":50,"end":53,"surface":"帝小乙","kind":"person","person_id":"blo_hqh_iqg","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p021","text":"帝小乙崩，子帝武丁立。帝武丁即位，思復興殷，而未得其佐。三年不言，政事決定於冢宰，以觀國風。武丁夜夢得聖人，名曰說。以夢所見視群臣百吏，皆非也。於是迺使百工營求之野，得說於傅險中。是時說為胥靡，筑於傅險。見於武丁，武丁曰是也。得而與之語，果聖人，舉以為相，殷國大治。故遂以傅險姓之，號曰傅說。","mentions":[{"id":"c-shiji-003-yin:m021-0000","start":0,"end":3,"surface":"帝小乙","kind":"person","person_id":"blo_hqh_iqg","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0006","start":6,"end":9,"surface":"帝武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0011","start":11,"end":14,"surface":"帝武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0038","start":38,"end":40,"surface":"冢宰","kind":"unresolved","person_id":null,"status":"unresolved","note":"氏族、群體、官稱或未定個人指代；不由熟知故事補出姓名。"},{"id":"c-shiji-003-yin:m021-0046","start":46,"end":48,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0056","start":56,"end":57,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0084","start":84,"end":85,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0092","start":92,"end":93,"surface":"說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0104","start":104,"end":106,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0107","start":107,"end":109,"surface":"武丁","kind":"person","person_id":"cld_aan_e20","status":"source_identified"},{"id":"c-shiji-003-yin:m021-0143","start":143,"end":145,"surface":"傅說","kind":"person","person_id":"p77_x5q_v4n","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"}],"sources":[{"chapter_id":"c-shiji-003-yin","work_id":"w-shiji","book_id":"b-shiji-003","source_id":"s-shiji-003-yin","source":{"title":"史記／卷003","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷003","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷003&oldid=790