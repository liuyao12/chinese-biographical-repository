ed":false},"family_paths":[],"mentions":[{"id":"c-songshu-049-sunchu:p002:m0159","start":159,"end":162,"surface":"虞尫夫","kind":"person","person_id":"6nz_vax_c5w","status":"contextual_provisional","paragraph_id":"c-songshu-049-sunchu:p002","chapter_id":"c-songshu-049-sunchu"}],"relations":[],"title_holdings":[{"id":"th-songshu-049-sunchu-2-157","title":"司馬","kind":"office","mode":"attestation","person_id":"6nz_vax_c5w","attestations":[{"id":"th-songshu-049-sunchu-2-157:a","paragraph_id":"c-songshu-049-sunchu:p002","start":157,"end":159,"surface":"司馬","person_mention_id":"c-songshu-049-sunchu:p002:m0159","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-049","chapter_id":"c-songshu-049-sunchu","source_id":"s-songshu-049-sunchu-ws2118585","paragraph_id":"c-songshu-049-sunchu:p002","quote":"盧循之難，於石頭扞柵，戍越城、查浦，破賊於新亭。高祖謂季高曰：「此賊行破。應先傾其巢窟，令奔走之日，無所歸投，非卿莫能濟事。」遣季高率眾三千，汎海襲番禺。初，賊不以海道為防，季高至東衝，去城十餘里，城內猶未知。循守戰士猶有數千人，城池甚固。季高先焚舟艦，悉力登岸，會天大霧，四面陵城，即日克拔。循父嘏、長史孫建之、司馬虞尫夫等，輕舟奔始興。即分遣振武將軍沈田子等討平始興、南康、臨賀、始安嶺表諸郡。循於左里奔走，而眾力猶盛，自嶺道還襲廣州。季高距戰二十餘日，循乃破走，所殺萬餘人，追奔至鬱林，會病，不得窮討，循遂得走向交州。","person_mention_id":"c-songshu-049-sunchu:p002:m0159"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-049-sunchu:p002","text":"盧循之難，於石頭扞柵，戍越城、查浦，破賊於新亭。高祖謂季高曰：「此賊行破。應先傾其巢窟，令奔走之日，無所歸投，非卿莫能濟事。」遣季高率眾三千，汎海襲番禺。初，賊不以海道為防，季高至東衝，去城十餘里，城內猶未知。循守戰士猶有數千人，城池甚固。季高先焚舟艦，悉力登岸，會天大霧，四面陵城，即日克拔。循父嘏、長史孫建之、司馬虞尫夫等，輕舟奔始興。即分遣振武將軍沈田子等討平始興、南康、臨賀、始安嶺表諸郡。循於左里奔走，而眾力猶盛，自嶺道還襲廣州。季高距戰二十餘日，循乃破走，所殺萬餘人，追奔至鬱林，會病，不得窮討，循遂得走向交州。","text_layer":"received_chapter","annotation_s