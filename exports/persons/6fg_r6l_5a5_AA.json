n_id":"6fg_r6l_5a5_A","status":"source_attested","qualifiers":{"source_term":"長子軫","lineage":"paternal"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-089","chapter_id":"c-jinshu-089-jishao","source_id":"s-jinshu-089-jishao","paragraph_id":"c-jinshu-089-jishao:p008","quote":"紹誕於行己，不飾小節，然曠而有檢，通而不雜。與從子含等五人共居，撫恤如所同生。門人故吏思慕遺愛，行服墓次，畢三年者三十餘人。長子軫，有父風，早夭。以從孫翰襲封。成帝時追述紹忠，以翰為奉朝請。翰以無兄弟，自表還本宗。太元中，孝武帝詔曰：「褒德顯仁，哲王令典。故太尉、忠穆公執德高邈，在否彌宣，貞潔之風，義著千載。每念其事，愴然傷懷。忠貞之胤，蒸嘗宜遠，所以大明至節，崇獎名教。可訪其宗族，襲爵主祀。」於是復以翰孫曠為弋陽侯。","relationship_anchor":{"paragraph_id":"c-jinshu-089-jishao:p008","start":62,"end":65,"surface":"長子軫"},"subject_person_mention_id":"c-jinshu-089-jishao:p008:m0064","object_person_mention_id":"c-jinshu-089-jishao:p008:m0000"}],"interpretation_note":"本傳長子軫；平行WYG作眕分層保留，不改字。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-089-jishao:p002:m0197","start":197,"end":199,"surface":"長子","kind":"person","person_id":"6fg_r6l_5a5_AA","status":"contextual_provisional","interpretation_note":"與本傳末長子軫同一敘事，姓名未寫在此處，不改原稱。","paragraph_id":"c-jinshu-089-jishao:p002","chapter_id":"c-jinshu-089-jishao"},{"id":"c-jinshu-089-jishao:p008:m0064","start":64,"end":65,"surface":"軫","kind":"person","person_id":"6fg_r6l_5a5_AA","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。","paragraph_id":"c-jinshu-089-jishao:p008","chapter_id":"c-jinshu-089-jishao"}],"relations":[{"id":"a-jin089-jishao-002","subject_person_id":"6fg_r6l_5a5_AA","predicate":"father","object_person_id":"6fg_r6l_5a5_A","status":"source_attested","qualifiers":{"source_term":"長子軫","lineage":"paternal"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-089","chapter_id":"c-jinshu-089-jishao","source_id":"s-jinshu-089-jishao","paragraph_id":"c-jinshu-089-jishao:p008","quote":"紹誕於行己，不飾小節，然曠而有檢，通而不雜。與從子含等五人共居，撫恤如所同生。門人故吏思慕遺愛，行服墓次，畢三年者三十餘人。長子軫，有父風，早夭。以從孫翰襲封。成帝時追述紹忠，以翰為奉朝請。翰以無兄弟，自表還本宗。太元中，孝武帝詔曰：「褒德顯仁，哲王令典。故太尉、忠穆公執德高邈，在否彌宣，貞潔之風，義著千載。每念其事，愴然傷懷。忠貞之胤，蒸嘗宜遠，所以大明至節，崇獎名教。可訪其宗族，襲爵主祀。」於是復以翰孫曠為弋陽侯。","relationship_anchor":{"paragraph_id":"c-jinshu-089-jishao:p008","start":62,"end":65,"surface":"長子軫"},"subject_person_mention_id":"c-jinshu-089-jishao:p008:m0064","object_person_mention_id":"c-jinshu-089-jishao:p008:m0000"}],"interpretation_note":"本傳長子軫；平行WYG作眕分層保留，不改字。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-089-jishao:p002","text":"紹始入洛，或謂王戎曰：「昨于稠人中始見嵇紹，昂昂然如野鶴之在雞群。」戎曰：「君復未見其父耳。」累遷汝陰太守。尚書左僕射裴頠亦深器之，每曰：「使延祖為吏部尚書，可使天下無復遺才矣。」沛國戴晞少有才智，與紹從子含相友善，時人許以遠致，紹以為必不成器。晞後為司州主簿，以無行被斥，州黨稱紹有知人之明。轉豫章內史，以母憂，不之官。服闋，拜徐州刺史。時石崇為都督，性雖驕暴，而紹將之以道，崇甚親敬之。後以長子喪去職。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-jinshu-089-jishao:p002:m0000","start":0,"end":1,"surface":"紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0005","start":5,"end":6,"surface":"或","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"未名與王戎談話者，不補名。"},{"id":"c-jinshu-089-jishao:p002:m0007","start":7,"end":9,"surface":"王戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0019","start":19,"end":21,"surface":"嵇紹","kind":"person","person_id":"6fg_r6l_5a5_A","status":"contextual_provisional","interpretation_note":"依完整本傳敘事／引語主語辨識，不以最近姓名機械延續。"},{"id":"c-jinshu-089-jishao:p002:m0034","start":34,"end":35,"surface":"戎","kind":"person","person_id":"ehx_cqg_nfx_AA","status":"contextual_provisi