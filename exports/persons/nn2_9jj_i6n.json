{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"nn2_9jj_i6n","canonical_person_id":"nn2_9jj_i6n","id_aliases":["cbr-p004562"],"identity_policy":"contextual_provisional","person_ids":["nn2_9jj_i6n"],"persons":[{"id":"nn2_9jj_i6n","label":"魏昭王（樂毅列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"魏昭王","mention_ids":["c-shiji-080-leyi:m002-0092"]}],"evidence":[{"mention_id":"c-shiji-080-leyi:m002-0092","chapter_id":"c-shiji-080-leyi","paragraph_id":"c-shiji-080-leyi:p002","quote":"魏昭王"}],"id_aliases":["cbr-p004562"]}],"source_mention_summary":[{"source_id":"s-shiji-080-leyi","work_id":"w-shiji","book_id":"b-shiji-080","chapter_id":"c-shiji-080-leyi","mention_count":1,"mention_ids":["c-shiji-080-leyi:m002-0092"],"paragraph_ids":["c-shiji-080-leyi:p002"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-080-leyi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-080-leyi:m002-0092","start":92,"end":95,"surface":"魏昭王","kind":"person","person_id":"nn2_9jj_i6n","status":"contextual_provisional","paragraph_id":"c-shiji-080-leyi:p002","chapter_id":"c-shiji-080-leyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji080-008","person_id":"nn2_9jj_i6n","surfaces":["魏昭王"],"scope":"same_chapter","chapter_ids":["c-shiji-080-leyi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-080-leyi:p002","quote":"樂毅賢，好兵，趙人舉之。及武靈王有沙丘之亂，乃去趙適魏。聞燕昭王以子之之亂而齊大敗燕，燕昭王怨齊，未嘗一日而忘報齊也。燕國小，辟遠，力不能制，於是屈身下士，先禮郭隗以招賢者。樂毅於是為魏昭王使於燕，燕王以客禮待之。樂毅辭讓，遂委質為臣，燕昭王以為亞卿，久之。"}],"rationale":"樂閒明示為樂毅子，樂叔明示為孫，不補闕代父親；樂乘為樂閒宗不補兄弟。燕王喜來書及趙襄王君序各限本段，曹相國未見名字不回填。河上丈人至蓋公師承不作父子。依本篇明示姓名、君序與來書答書範圍暫接；燕惠王來書寡人指惠王、將軍指樂毅，樂毅答書先王指昭王、足下君王指惠王。伍子胥引古首吳王指闔閭，後吳王在夫差賜鴟夷後指夫差。父兄與群臣不補具體親屬，王齊為反間假說不作授王爵。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-080-leyi:p002","text":"樂毅賢，好兵，趙人舉之。及武靈王有沙丘之亂，乃去趙適魏。聞燕昭王以子之之亂而齊大敗燕，燕昭王怨齊，未嘗一日而忘報齊也。燕國小，辟遠，力不能制，於是屈身下士，先禮郭隗以招賢者。樂毅於是為魏昭王使於燕，燕王以客禮待之。樂毅辭讓，遂委質為臣，燕昭王以為亞卿，久之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-080-leyi:m002-0000","start":0,"end":2,"surface":"樂毅","kind":"person","person_id":"idh_bo6_4kq","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0013","start":13,"end":16,"surface":"武靈王","kind":"person","person_id":"knr_jfs_b93","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0029","start":29,"end":32,"surface":"燕昭王","kind":"person","person_id":"ly0_vry_w1c","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0033","start":33,"end":35,"surface":"子之","kind":"person","person_id":"esz_z17_u3u","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0043","start":43,"end":46,"surface":"燕昭王","kind":"person","person_id":"ly0_vry_w1c","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0080","start":80,"end":82,"surface":"郭隗","kind":"person","person_id":"py3_55c_1ad","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0084","start":84,"end":86,"surface":"賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定成員保留，不補未見姓名與直接父子關係。"},{"id":"c-shiji-080-leyi:m002-0087","start":87,"end":89,"surface":"樂毅","kind":"person","person_id":"idh_bo6_4kq","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-0092","start":92,"end":95,"surface":"魏昭王","kind":"person","person_id":"nn2_9jj_i6n","status":"contextual_provisional"},{"id":"c-shiji-080-leyi:m002-