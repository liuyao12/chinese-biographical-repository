一，則可以當秦。」因使人報趙。趙孝成王與平陽君、平原君計之。平陽君曰：「不如勿受。受之，禍大於所得。」平原君曰：「無故得一郡，受之便。」趙受之，因封馮亭為華陽君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m002-0021","start":21,"end":23,"surface":"其守","kind":"person","person_id":"cbr-p004241","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0023","start":23,"end":25,"surface":"馮亭","kind":"person","person_id":"cbr-p004241","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0100","start":100,"end":104,"surface":"趙孝成王","kind":"person","person_id":"cbr-p004242","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0105","start":105,"end":108,"surface":"平陽君","kind":"person","person_id":"cbr-p004243","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0109","start":109,"end":112,"surface":"平原君","kind":"person","person_id":"cbr-p004244","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0115","start":115,"end":118,"surface":"平陽君","kind":"person","person_id":"cbr-p004243","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0136","start":136,"end":139,"surface":"平原君","kind":"person","person_id":"cbr-p004244","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0159","start":159,"end":161,"surface":"馮亭","kind":"person","person_id":"cbr-p004241","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m002-0162","start":162,"end":165,"surface":"華陽君","kind":"person","person_id":"cbr-p004241","status":"contextual_provisional"}],"chapter_id":"c-shiji-073-baiwang","book_id":"b-shiji-073","work_id":"w-shiji","source_id":"s-shiji-073-baiwang"}],"sources":[{"chapter_id":"c-shiji-073-baiwang","work_id":"w-shiji","book_id":"b-shiji-073","source_id":"s-shiji-073-baiwang","source":{"title":"史記／卷073","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷073","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷073&oldid=7909285","revision_id":7909285,"accessed_on":"202