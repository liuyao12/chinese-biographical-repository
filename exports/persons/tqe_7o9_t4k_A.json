嚴道、邛都，帝許之。長未到處所，行病死，上憐之。後十六年，追尊淮南王長謚為厲王，立其子三人為淮南王、衡山王、廬江王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-010-wendi:m023-0006","start":6,"end":10,"surface":"淮南王長","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0017","start":17,"end":19,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0030","start":30,"end":32,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0039","start":39,"end":42,"surface":"棘蒲侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體或神祇指稱未定；不補未見姓名或血親。"},{"id":"c-shiji-010-wendi:m023-0042","start":42,"end":45,"surface":"太子奇","kind":"person","person_id":"qbh_lsz_ipx","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0081","start":81,"end":82,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0109","start":109,"end":110,"surface":"帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0123","start":123,"end":124,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0134","start":134,"end":138,"surface":"淮南王長","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-010-wendi:m023-0144","start":144,"end":148,"surface":"其子三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、群體或神祇指稱未定；不補未見姓名或血親。"},{"id":"c-shiji-010-wendi:m023-0149","start":149,"end":152,"surface":"淮南王","kind":"unresolved","person_id":null,"status":"unresolved","note":"此淮南王為長的三子所立王號之一，不是已死並追諡的長；本句未具名，不補成員姓名。"}],"chapter_id":"c-shiji-010-wendi","book_id":"b-shiji-010","work_id":"w-shiji","source_id":"s-shiji-010-wendi"},{"id":"c-shiji-101-yuanchao:p004","text":"淮南厲王朝，殺辟陽侯，居處驕甚。袁盎諫曰：「諸侯大驕必生患，可適削地。」上弗用。淮南王益橫。及棘蒲侯柴武太子謀反事覺，治，連淮南王，淮南王徵，上因遷之蜀，轞車傳送。袁盎時為中郎將，乃諫曰：「陛下素驕淮南王，弗稍禁，以至此，今又暴摧折之。淮南王為人剛，如有遇霧露行道死，陛下竟為以天下之大弗能容，有殺弟之名，柰何？」上弗聽，遂行之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-101-yuanchao:m004-0000","start":0,"end":4,"surface":"淮南厲王","kind":"person","person_id":"bq3_n3o_dyy","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0007","start":7,"end":10,"surface":"辟陽侯","kind":"person","person_id":"31b_36a_313","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0016","start":16,"end":18,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0036","start":36,"end":37,"surface":"上","kind":"person","person_id":"lm7_mia_aee","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0040","start":40,"end":43,"surface":"淮南王","kind":"person","person_id":"bq3_n3o_dyy","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0050","start":50,"end":52,"surface":"柴武","kind":"person","person_id":"tqe_7o9_t4k","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0052","start":52,"end":54,"surface":"太子","kind":"person","person_id":"tqe_7o9_t4k_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0062","start":62,"end":65,"surface":"淮南王","kind":"person","person_id":"bq3_n3o_dyy","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0066","start":66,"end":69,"surface":"淮南王","kind":"person","person_id":"bq3_n3o_dyy","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0071","start":71,"end":72,"surface":"上","kind":"person","person_id":"lm7_mia_aee","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0082","start":82,"end":84,"surface":"袁盎","kind":"person","person_id":"j32_wtj_khz_A","status":"contextual_provisional"},{"id":"c-shiji-101-yuanchao:m004-0099","