060-sanwang"},{"id":"c-shiji-104-tianshu:m010-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"nq4_rjk_iab","status":"contextual_provisional","paragraph_id":"c-shiji-104-tianshu:p010","chapter_id":"c-shiji-104-tianshu"},{"id":"c-shiji-126-huaji:m013-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"nq4_rjk_iab","status":"contextual_provisional","paragraph_id":"c-shiji-126-huaji:p013","chapter_id":"c-shiji-126-huaji"},{"id":"c-shiji-127-rizhe:m020-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"nq4_rjk_iab","status":"contextual_provisional","paragraph_id":"c-shiji-127-rizhe:p020","chapter_id":"c-shiji-127-rizhe"},{"id":"c-shiji-128-guice:m006-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"nq4_rjk_iab","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p006","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m021-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"nq4_rjk_iab","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p021","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[{"id":"th-shiji049-052","person_id":"nq4_rjk_iab","title":"郎","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p035","quote":"褚先生曰：臣為郎時，問習漢家故事者鐘離生。曰：王太后在民閒時所生（子）［一］女者，父為金王孫。王孫已死，景帝崩後，武帝已立，王太后獨在。而韓王孫名嫣素得幸武帝，承閒白言太后有女在長陵也。武帝曰：「何不蚤言！」乃使使往先視之，在其家。武帝乃自往迎取之。蹕道，先驅旄騎出橫城門，乘輿馳至長陵。當小市西入里，里門閉，暴開門，乘輿直入此里，通至金氏門外止，使武騎圍其宅，為其亡走，身自往取不得也。即使左右群臣入呼求之。家人驚恐，女亡匿內中床下。扶持出門，令拜謁。武帝下車泣曰：「嚄！大姊，何藏之深也！」詔副車載之，迴車馳還，而直入長樂宮。行詔門著引籍，通到謁太后。太后曰：「帝倦矣，何從來？」帝曰：「今者至長陵得臣姊，與俱來。」顧曰：「謁太后！」太后曰：「女某邪？」曰：「是也。」太后為下泣，女亦伏地泣。武帝奉酒前為壽，奉錢千萬，奴婢三百人，公田百頃，甲第，以賜姊。太后謝曰：「為帝費焉。」於是召平陽主、南宮主、林慮主三人俱來謁見姊，因號曰修成君。有子男一人，女一人。男號為修成子仲，女為諸侯王王后。此二子非劉氏，以故太后憐之。修成子仲驕恣，陵折吏民，皆患苦之。"}],"attestations":[{"id":"th-shiji049-052:a001","paragraph_id":"c-shiji-049-waiqi:p035","start":7,"end":8,"surface":"郎","person_mention_id":"c-shiji-049-waiqi:m035-0000","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、廢黜、追尊、制度秩比與一般用稱分開；未知時段不由卒日或首次提及推算。原段相對時序保留，未換算年月或選定篇文與褚氏附載的衝突。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji058-045","person_id":"nq4_rjk_iab","title":"郎","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-058-liang","source_id":"s-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p023","quote":"褚先生曰：臣為郎時，聞之於宮殿中老郎吏好事者稱道之也。竊以為令梁孝王怨望，欲為不善者，事從中生。今太后，女主也，以愛少子故，欲令梁王為太子。大臣不時正言其不可狀，阿意治小，私說意以受賞賜，非忠臣也。齊如魏其侯竇嬰之正言也，何以有後禍？景帝與王燕見，侍太后飲，景帝曰：「千秋萬歲之後傳王。」太后喜說。竇嬰在前，據地言曰：「漢法之約，傳子適孫，今帝何以得傳弟，擅亂高帝約乎！」於是景帝默然無聲。太后意不說。"}],"attestations":[{"id":"th-shiji058-045:a001","paragraph_id":"c-shiji-058-liang:p023","start":7,"end":8,"surface":"郎","person_mention_id":"c-shiji-058-liang:m023-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授封、改封、敘事用稱與諡稱分存；相對年數及來源年號保留，不換算公曆，不從首次用稱或死亡補任期。未名群體不造個別官爵。 自述為郎時只記用稱，不補全名或年代。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji060-022","person_id":"nq4_rjk_iab","title":"侍郎","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p018","quote":"褚先生曰：臣幸得以文學為侍郎，好覽觀太史公之列傳。傳中稱三王世家文辭可觀，求其世家終不能得。竊從長老好故事者取其封策書，編列其事而傳之，令後世得觀賢主之指意。"}],"attestations":[{"id":"th-shiji060-022:a001","paragraph_id":"c-shiji-060-sanwang:p018","start":12,"end":14,"surface":"侍郎","person_mention_id":"c-shiji-060-sanwang:m018-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依來源用稱保存，首次提及不補授職日；守、行事及兼攝不冒稱正式新授，單名及制度未定者不補姓或官制細節。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji126-006","person_id":"nq4_rjk_iab","title":"郎","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-126-huaji","source_id":"s-shiji126-huaji","paragraph_id":"c-shiji-126-huaji:p013","quote":"褚先生曰：臣幸得以經術為郎，而好讀外家傳語。竊不遜讓，復作故事滑稽之語六章，編之於左。可以覽觀揚意，以示後世好事者讀之，以游心駭耳，以附益上方太史公之三章。"}],"attestations":[{"id":"th-shiji126-006:a001","paragraph_id":"c-shiji-126-huaji:p013","start":12,"end":13,"surface":"郎","person_mention_id":"c-shiji-126-huaji:m013-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示封拜與文獻用稱分開；未知授任年及終點保持未知，不以死亡自動終止官爵。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji127-006","person_id":"nq4_rjk_iab","title":"郎","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-127-rizhe","source_id":"s-shiji127-rizhe","paragraph_id":"c-shiji-127-rizhe:p020","quote":"褚先生曰：臣爲郎時，游觀長安中，見卜筮之賢大夫，觀其起居行歩，坐起自動，誓正其衣冠而當鄕人也，有君子之風。見性好解婦來卜，對之顏色嚴振，未嘗見齒而笑也。從古以來，賢者避世，有居止舞澤者，有居民閒閉口不言，有隱居卜筮閒以全身者。夫司馬季主者，楚賢大夫，游學長安，通易經，術黃帝、老子，博聞遠見。觀其對二大夫貴人之談言，稱引古明王聖人道，固非淺聞小數之能。及卜筮立名聲千里者，各往往而在。傳曰：「富爲上，貴次之；既貴各各學一伎能立其身。」黃直，大夫也；陳君夫，婦人也：以相馬立名天下。齊張仲、曲成侯以善擊刺學用劍，立名天下。留長孺以相彘立名。滎陽褚氏以相牛立名。能以伎能立名者甚多，皆有高世絶人之風，何可勝言。故曰：「非其地，樹之不生；非其意，教之不成。」夫家之教子孫，當視其所以好，好含茍生活之道，因而成之。故曰：「制宅命子，足以觀士；子有處所，可謂賢人。」臣爲郎時，與太卜待詔爲郎者同署，言曰：「孝武帝時，聚會占家問之，某日可取婦乎？五行家曰可，堪輿家曰不可，建除家曰不吉，叢辰家曰大凶，歷家曰小凶，天人家曰小吉，太一家曰大吉。辯訟不決，以狀聞。制曰：『避諸死忌，以五行爲主。』」人取於五行者也。"}],"attestations":[{"id":"th-shiji127-006:a001","paragraph_id":"c-shiji-127-rizhe:p020","start":7,"end":8,"surface":"郎","person_mention_id":"c-shiji-127-rizhe:m020-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"文獻用稱不作授任日期；傅保留原稱，不改太傅，黃直大夫未定官階；未知起訖保持未知。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji128-001","person_id":"nq4_rjk_iab","title":"郎","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-128-guice","source_id":"s-shiji128-guice","paragraph_id":"c-shiji-128-guice:p006","quote":"褚先生曰：臣以通經術，受業博士，治春秋，以高第為郎，幸得宿衛，出入宮殿中十有餘年。竊好太史公傳。太史公之傳曰：「三王不同龜，四夷各異卜，然各以決吉凶，略闚其要，故作龜策列傳。」臣往來長安中，求龜策列傳不能得，故之大卜官，問掌故文學長老習事者，寫取龜策卜事，編于下方。"}],"attestations":[{"id":"th-shiji128-001:a001","paragraph_id":"c-shiji-128-guice:p006","start":24,"end":25,"surface":"郎","person_mention_id":"c-shiji-128-guice:m006-0000","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-128-guice","source_id":"s-shiji128-guice","paragraph_id":"c-shiji-128-guice:p006","quote":"褚先生曰：臣以通經術，受業博士，治春秋，以高第為郎，幸得宿衛，出入宮殿中十有餘年。竊好太史公傳。太史公之傳曰：「三王不同龜，四夷各異卜，然各以決吉凶，略闚其要，故作龜策列傳。」臣往來長安中，求龜策列傳不能得，故之大卜官，問掌故文學長老習事者，寫取龜策卜事，編于下方。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按原句官爵用稱記錄，不推實任年月；明示為郎或號為武王保存來源事件，未知起訖保持未知，死亡不自動終止官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji048-012","person_id":"nq4_rjk_iab","surfaces":["褚先生"],"scope":"same_chapter","chapter_ids":["c-shiji-048-chenshe"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-048-chenshe:p021","quote":"褚先生曰：地形險阻，所以為固也；兵革刑法，所以為治也。猶未足恃也。夫先王以仁義為本，而以固塞文法為枝葉，豈不然哉！吾聞賈生之稱曰："}],"rationale":"限明示名、字及局部軍事角色；陳勝涉、吳廣叔、蔡賜房君與周文周章暫接，吳廣韓廣分開。引文四君短稱及比擬人物另留候選，詐稱扶蘇項燕不合陳吳，褚賈署稱不補姓名。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji049-071","person_id":"nq4_rjk_iab","surfaces":["褚先生"],"scope":"same_chapter","chapter_ids":["c-shiji-049-waiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-049-waiqi:p035","quote":"褚先生曰：臣為郎時，問習漢家故事者鐘離生。曰：王太后在民閒時所生（子）［一］女者，父為金王孫。王孫已死，景帝崩後，武帝已立，王太后獨在。而韓王孫名嫣素得幸武帝，承閒白言太后有女在長陵也。武帝曰：「何不蚤言！」乃使使往先視之，在其家。武帝乃自往迎取之。蹕道，先驅旄騎出橫城門，乘輿馳至長陵。當小市西入里，里門閉，暴開門，乘輿直入此里，通至金氏門外止，使武騎圍其宅，為其亡走，身自往取不得也。即使左右群臣入呼求之。家人驚恐，女亡匿內中床下。扶持出門，令拜謁。武帝下車泣曰：「嚄！大姊，何藏之深也！」詔副車載之，迴車馳還，而直入長樂宮。行詔門著引籍，通到謁太后。太后曰：「帝倦矣，何從來？」帝曰：「今者至長陵得臣姊，與俱來。」顧曰：「謁太后！」太后曰：「女某邪？」曰：「是也。」太后為下泣，女亦伏地泣。武帝奉酒前為壽，奉錢千萬，奴婢三百人，公田百頃，甲第，以賜姊。太后謝曰：「為帝費焉。」於是召平陽主、南宮主、林慮主三人俱來謁見姊，因號曰修成君。有子男一人，女一人。男號為修成子仲，女為諸侯王王后。此二子非劉氏，以故太后憐之。修成子仲驕恣，陵折吏民，皆患苦之。"},{"paragraph_id":"c-shiji-049-waiqi:p038","quote":"褚先生曰：丈夫龍變。傳曰：「蛇化為龍，不變其文；家化為國，不變其姓。」丈夫當時富貴，百惡滅除，光耀榮華，貧賤之時何足累之哉！"},{"paragraph_id":"c-shiji-049-waiqi:p041","quote":"褚先生曰：浴不必江海，要之去垢；馬不必騏驥，要之善走；士不必賢世，要之知道；女不必貴種，要之貞好。傳曰：「女無美惡，入室見妒；士無賢不肖，入朝見嫉。」美女者，惡女之仇。豈不然哉！"}],"rationale":"按明示名、字及各帝后局部親屬敘事暫接；王夫人分景帝皇后與武帝趙妃，代王分文帝與後來少子武。未名者不補姓名，褚氏附載另留原語。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji-chu-author-cross-chapter","person_id":"nq4_rjk_iab","scope":"cross_chapter","chapter_ids":["c-shiji-060-sanwang","c-shiji-128-guice","c-shiji-104-tianshu","c-shiji-127-rizhe","c-shiji-058-liang","c-shiji-126-huaji","c-shiji-048-chenshe","c-shiji-049-waiqi"],"status":"contextual_provisional","confidence_level":"high","surfaces":["褚先生"],"identification_basis":{"kind":"source_context","target_mention_ids":["c-shiji-060-sanwang:m018-0000","c-shiji-128-guice:m006-0000","c-shiji-128-guice:m021-0000","c-shiji-104-tianshu:m010-0000","c-shiji-127-rizhe:m020-0000","c-shiji-058-liang:m023-0000","c-shiji-126-huaji:m013-0000","c-shiji-048-chenshe:m021-0000","c-shiji-049-waiqi:m035-0000","c-shiji-049-waiqi:m038-0000","c-shiji-049-waiqi:m041-0000"]},"evidence":[{"chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p018","quote":"褚先生曰：臣幸得以文學為侍郎，好覽觀太史公之列傳。傳中稱三王世家文辭可觀，求其世家終不能得。竊從長老好故事者取其封策書，編列其事而傳之，令後世得觀賢主之指意。"},{"chapter_id":"c-shiji-128-guice","paragraph_id":"c-shiji-128-guice:p006","quote":"褚先生曰：臣以通經術，受業博士，治春秋，以高第為郎，幸得宿衛，出入宮殿中十有餘年。竊好太史公傳。太史公之傳曰：「三王不同龜，四夷各異卜，然各以決吉凶，略闚其要，故作龜策列傳。」臣往來長安中，求龜策列傳不能得，故之大卜官，問掌故文學長老習事者，寫取龜策卜事，編于下方。"},{"chapter_id":"c-shiji-128-guice","paragraph_id":"c-shiji-128-guice:p021","quote":"褚先生曰：漁者舉網而得神龜，龜自見夢宋元王，元王召博士衛平告以夢龜狀，平運式，定日月，分衡度，視吉凶，占龜與物色同，平諫王留神龜以為國重寶，美矣。古者筮必稱龜者，以其令名，所從來久矣。余述而為傳。"},{"chapter_id":"c-shiji-104-tianshu","paragraph_id":"c-shiji-104-tianshu:p010","quote":"褚先生曰：臣為郎時，聞之曰田仁故與任安相善。任安，滎陽人也。少孤貧困，為人將車之長安，留，求事為小吏，未有因緣也，因占著名數。武功，扶風西界小邑也，谷口蜀道近山。安以為武功小邑，無豪，易高也，安留，代人為求盜亭父。後為亭長。邑中人民俱出獵，任安常為人分麋鹿雉兔，部署老小當壯劇易處，眾人皆喜，曰：「無傷也，任少卿分別平，有智略。」明日復合會，會者數百人。任少卿曰：「某子甲何為不來乎？」諸人皆怪其見之疾也。其後除為三老，舉為親民，出為三百石長，治民。坐上行出游共帳不辦，斥免。"},{"chapter_id":"c-shiji-127-rizhe","paragraph_id":"c-shiji-127-rizhe:p020","quote":"褚先生曰：臣爲郎時，游觀長安中，見卜筮之賢大夫，觀其起居行歩，坐起自動，誓正其衣冠而當鄕人也，有君子之風。見性好解婦來卜，對之顏色嚴振，未嘗見齒而笑也。從古以來，賢者避世，有居止舞澤者，有居民閒閉口不言，有隱居卜筮閒以全身者。夫司馬季主者，楚賢大夫，游學長安，通易經，術黃帝、老子，博聞遠見。觀其對二大夫貴人之談言，稱引古明王聖人道，固非淺聞小數之能。及卜筮立名聲千里者，各往往而在。傳曰：「富爲上，貴次之；既貴各各學一伎能立其身。」黃直，大夫也；陳君夫，婦人也：以相馬立名天下。齊張仲、曲成侯以善擊刺學用劍，立名天下。留長孺以相彘立名。滎陽褚氏以相牛立名。能以伎能立名者甚多，皆有高世絶人之風，何可勝言。故曰：「非其地，樹之不生；非其意，教之不成。」夫家之教子孫，當視其所以好，好含茍生活之道，因而成之。故曰：「制宅命子，足以觀士；子有處所，可謂賢人。」臣爲郎時，與太卜待詔爲郎者同署，言曰：「孝武帝時，聚會占家問之，某日可取婦乎？五行家曰可，堪輿家曰不可，建除家曰不吉，叢辰家曰大凶，歷家曰小凶，天人家曰小吉，太一家曰大吉。辯訟不決，以狀聞。制曰：『避諸死忌，以五行爲主。』」人取於五行者也。"},{"chapter_id":"c-shiji-058-liang","paragraph_id":"c-shiji-058-liang:p023","quote":"褚先生曰：臣為郎時，聞之於宮殿中老郎吏好事者稱道之也。竊以為令梁孝王怨望，欲為不善者，事從中生。今太后，女主也，以愛少子故，欲令梁王為太子。大臣不時正言其不可狀，阿意治小，私說意以受賞賜，非忠臣也。齊如魏其侯竇嬰之正言也，何以有後禍？景帝與王燕見，侍太后飲，景帝曰：「千秋萬歲之後傳王。」太后喜說。竇嬰在前，據地言曰：「漢法之約，傳子適孫，今帝何以得傳弟，擅亂高帝約乎！」於是景帝默然無聲。太后意不說。"},{"chapter_id":"c-shiji-126-huaji","paragraph_id":"c-shiji-126-huaji:p013","quote":"褚先生曰：臣幸得以經術為郎，而好讀外家傳語。竊不遜讓，復作故事滑稽之語六章，編之於左。可以覽觀揚意，以示後世好事者讀之，以游心駭耳，以附益上方太史公之三章。"},{"chapter_id":"c-shiji-048-chenshe","paragraph_id":"c-shiji-048-chenshe:p021","quote":"褚先生曰：地形險阻，所以為固也；兵革刑法，所以為治也。猶未足恃也。夫先王以仁義為本，而以固塞文法為枝葉，豈不然哉！吾聞賈生之稱曰："},{"chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p035","quote":"褚先生曰：臣為郎時，問習漢家故事者鐘離生。曰：王太后在民閒時所生（子）［一］女者，父為金王孫。王孫已死，景帝崩後，武帝已立，王太后獨在。而韓王孫名嫣素得幸武帝，承閒白言太后有女在長陵也。武帝曰：「何不蚤言！」乃使使往先視之，在其家。武帝乃自往迎取之。蹕道，先驅旄騎出橫城門，乘輿馳至長陵。當小市西入里，里門閉，暴開門，乘輿直入此里，通至金氏門外止，使武騎圍其宅，為其亡走，身自往取不得也。即使左右群臣入呼求之。家人驚恐，女亡匿內中床下。扶持出門，令拜謁。武帝下車泣曰：「嚄！大姊，何藏之深也！」詔副車載之，迴車馳還，而直入長樂宮。行詔門著引籍，通到謁太后。太后曰：「帝倦矣，何從來？」帝曰：「今者至長陵得臣姊，與俱來。」顧曰：「謁太后！」太后曰：「女某邪？」曰：「是也。」太后為下泣，女亦伏地泣。武帝奉酒前為壽，奉錢千萬，奴婢三百人，公田百頃，甲第，以賜姊。太后謝曰：「為帝費焉。」於是召平陽主、南宮主、林慮主三人俱來謁見姊，因號曰修成君。有子男一人，女一人。男號為修成子仲，女為諸侯王王后。此二子非劉氏，以故太后憐之。修成子仲驕恣，陵折吏民，皆患苦之。"},{"chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p038","quote":"褚先生曰：丈夫龍變。傳曰：「蛇化為龍，不變其文；家化為國，不變其姓。」丈夫當時富貴，百惡滅除，光耀榮華，貧賤之時何足累之哉！"},{"chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p041","quote":"褚先生曰：浴不必江海，要之去垢；馬不必騏驥，要之善走；士不必賢世，要之知道；女不必貴種，要之貞好。傳曰：「女無美惡，入室見妒；士無賢不肖，入朝見嫉。」美女者，惡女之仇。豈不然哉！"}],"rationale":"八篇均以同一傳本署稱褚先生發言；七篇有為郎／為侍郎、讀太史公傳、採集補綴的自述互合。陳涉附論亦沿用同一傳本署稱，不把不同篇章當不同歷史人物。原書作者歸屬與實際成文層次的爭議另記，不藉此重建八個分身。 同一傳本作者身份之辨識，不宣稱每篇每句均已證明為褚少孫親筆；不將博士受業改讀成博士任官，不由為郎十餘年推定任官起訖。","human_reviewed":false,"model":null},{"id":"d-shiji058-034","person_id":"nq4_rjk_iab","surfaces":["褚先生"],"scope":"same_chapter","chapter_ids":["c-shiji-058-liang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-058-liang:p023","quote":"褚先生曰：臣為郎時，聞之於宮殿中老郎吏好事者稱道之也。竊以為令梁孝王怨望，欲為不善者，事從中生。今太后，女主也，以愛少子故，欲令梁王為太子。大臣不時正言其不可狀，阿意治小，私說意以受賞賜，非忠臣也。齊如魏其侯竇嬰之正言也，何以有後禍？景帝與王燕見，侍太后飲，景帝曰：「千秋萬歲之後傳王。」太后喜說。竇嬰在前，據地言曰：「漢法之約，傳子適孫，今帝何以得傳弟，擅亂高帝約乎！」於是景帝默然無聲。太后意不說。"}],"rationale":"按明示姓名、世系與局部王號暫接。梁武、勝、參、登、義、買、襄等不按同王號合併；梁王勝與羊勝分辨。李太后陳太后分存；主張、指控、泛稱與授職分辨，正文與附述各保留。官爵全史與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji060-028","person_id":"nq4_rjk_iab","surfaces":["褚先生"],"scope":"same_chapter","chapter_ids":["c-shiji-060-sanwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-060-sanwang:p018","quote":"褚先生曰：臣幸得以文學為侍郎，好覽觀太史公之列傳。傳中稱三王世家文辭可觀，求其世家終不能得。竊從長老好故事者取其封策書，編列其事而傳之，令後世得觀賢主之指意。"}],"rationale":"按明示奏議署稱、封策、三王敘事與局部帝稱暫接；光與安依職事先分候選，單名不補姓。王夫人閎母與三王子嗣依來源所見稱謂，請議與實授、指控與史實分辨，原文及傳承限制保留。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji104-024","person_id":"nq4_rjk_iab","surfaces":["褚先生"],"scope":"same_chapter","chapter_ids":["c-shiji-104-tianshu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-104-tianshu:p010","quote":"褚先生曰：臣為郎時，聞之曰田仁故與任安相善。任安，滎陽人也。少孤貧困，為人將車之長安，留，求事為小吏，未有因緣也，因占著名數。武功，扶風西界小邑也，谷口蜀道近山。安以為武功小邑，無豪，易高也，安留，代人為求盜亭父。後為亭長。邑中人民俱出獵，任安常為人分麋鹿雉兔，部署老小當壯劇易處，眾人皆喜，曰：「無傷也，任少卿分別平，有智略。」明日復合會，會者數百人。任少卿曰：「某子甲何為不來乎？」諸人皆怪其見之疾也。其後除為三老，舉為親民，出為三百石長，治民。坐上行出游共帳不辦，斥免。"}],"rationale":"依本篇姓名、原稱及敘事回指暫定；褚補與正文分層，未按同名自動跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-048-chenshe:p021","text":"褚先生曰：地形險阻，所以為固也；兵革刑法，所以為治也。猶未足恃也。夫先王以仁義為本，而以固塞文法為枝葉，豈不然哉！吾聞賈生之稱曰：","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-048-chenshe:m021-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"nq4_rjk_iab","status":"contextual_provisional"},{"id":"c-shiji-048-chenshe:m021-0034","start":34,"end":36,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、對話或未名者待核；普通動詞、詐稱與矯命不當真實人物身份。"},{"id":"c-shiji-048-chenshe:m021-0059","start":59,"end":61,"surface":"賈生","kind":"person","person_id":"7jn_lg6_yg9","status":"contextual_provisional"}],"chapter_id":"c-shiji-048-chenshe","book_id":"b-shiji-048","work_id":"w-shiji","source_id":"s-shiji-048-chenshe"},{"id":"c-shiji-049-waiqi:p035","text":"褚先生曰：臣為郎時，問習漢家故事者鐘離生。曰：王太后在民閒時所生（子）［一］女者，父為金王孫。王孫已死，景帝崩後，武帝已立，王太后獨在。而韓王孫名嫣素得幸武帝，承閒白言太后有女在長陵也。武帝曰：「何不蚤言！」乃使使往先視之，在其家。武帝乃自往迎取之。蹕道，先驅旄騎出橫城門，乘輿馳至長陵。當小市西入里，里門閉，暴開門，乘輿直入此里，通至金氏門外止，使武騎圍其宅，為其亡走，身自往取不得也。即使左右群臣入呼求之。家人驚恐，女亡匿內中床下。扶持出門，令拜謁。武帝下車泣曰：「嚄！大姊，何藏之深也！」詔副車載之，迴車馳還，而直入長樂宮。行詔門著引籍，通到謁太后。太后曰：「帝倦矣，何從來？」帝曰：「今者至長陵得臣姊，與俱來。」顧曰：「謁太后！」太后曰：「女某邪？」曰：「是也。」太后為下泣，女亦伏地泣。武帝奉酒前為壽，奉錢千萬，奴婢三百人，公田百頃，甲第，以賜姊。太后謝曰：「為帝費焉。」於是召平陽主、南宮主、林慮主三人俱來謁見姊，因號曰修成君。有子男一人，女一人。男號為修成子仲，女為諸侯王王后。此二子非劉氏，以故太后憐之。修成子仲驕恣，陵折吏民，皆患苦之。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-049-waiqi:m035-0000","start":0,"end":3,"surface":"褚先生","kind":"person","person_id":"nq4_rjk_iab","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m035-0017","start":17,"end":20,"