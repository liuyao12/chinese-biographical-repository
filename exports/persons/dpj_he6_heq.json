uncong-complete:p005:m0276","surface":"恩","start":276,"end":277,"kind":"person","person_id":"dpj_he6_heq","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p005","chapter_id":"c-sanguozhi-064-suncong-complete"},{"id":"c-sanguozhi-064-suncong-complete:p006:m0054","surface":"恩","start":54,"end":55,"kind":"person","person_id":"dpj_he6_heq","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p006","chapter_id":"c-sanguozhi-064-suncong-complete"},{"id":"c-sanguozhi-064-suncong-complete:p006:m0181","surface":"恩","start":181,"end":182,"kind":"person","person_id":"dpj_he6_heq","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p006","chapter_id":"c-sanguozhi-064-suncong-complete"},{"id":"c-sanguozhi-064-suncong-complete:p011:m0340","surface":"恩","start":340,"end":341,"kind":"person","person_id":"dpj_he6_heq","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p011","chapter_id":"c-sanguozhi-064-suncong-complete"},{"id":"c-sanguozhi-064-suncong-complete:p012:m0104","surface":"恩","start":104,"end":105,"kind":"person","person_id":"dpj_he6_heq","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-suncong-complete:p012","chapter_id":"c-sanguozhi-064-suncong-complete"}],"relations":[],"title_holdings":[{"id":"th-sanguozhi-064-suncong-complete-6-50","title":"武衛將軍","kind":"office","mode":"attestation","person_id":"dpj_he6_heq","attestations":[{"id":"th-sanguozhi-064-suncong-complete-6-50:a","paragraph_id":"c-sanguozhi-064-suncong-complete:p006","start":50,"end":54,"surface":"武衛將軍","person_mention_id":"c-sanguozhi-064-suncong-complete:p006:m0054","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-064","chapter_id":"c-sanguozhi-064-suncong-complete","source_id":"s-sanguozhi-064-suncong-complete-ws2263487","paragraph_id":"c-sanguozhi-064-suncong-complete:p006","quote":"　　綝以孫亮始親政事，多所難問，甚懼。還建業，稱疾不朝。築室幹朱雀橋南，使弟威遠將軍據入蒼龍宿衛，弟武衛將軍恩、偏將軍幹、長水校尉闓分屯諸營，欲以專朝自固。亮內嫌綝，乃推魯育見殺本末，責怒虎林督朱熊、熊弟外部督朱損不匡正孫峻，乃令丁奉殺熊於虎林，殺損於建業。綝入諫不從，亮遂與公主魯班、太常全尚、將軍劉承議誅綝。亮妃，綝從姊女也，以其謀告綝。綝率眾夜襲全尚，遣弟恩殺劉承於蒼龍門外，遂圍宮。使光祿勳盂宗告廟廢亮，召群司儀曰：「少帝荒病昏亂，不可以處大位，承宗廟，以告先帝廢之。諸君若有不同者，下異議。」皆震怖。曰：「唯將軍令。」綝遣中書郎李祟奪亮璽綬，以亮罪狀班告遠近。尚書桓彝不肯署名，綝怒殺之。","person_mention_id":"c-sanguozhi-064-suncong-complete:p006:m0054"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-suncong-complete:p005","text":"　　魏大將軍諸葛誕舉壽春叛，保城請降。吳遣文欽、唐諮、全端、全懌等三萬人救之。魏鎮南將軍王基圍入誕。欽等突圍城。魏悉中外軍二十餘萬增誕之圍。朱異帥三萬人屯安豐城，為文欽勢。魏兗州刺史州泰據異於陽淵，異敗退，為泰所追，死傷二干人。林於是大發率出屯鑊裡，復遣異率將軍丁奉、黎斐等五萬人攻魏，留輜重於都陸。異屯黎漿，遣將軍任度、張震等慕勇敢六千人，於屯西六里為浮橋夜渡，築偃月壘。為魏監軍石苞及州泰所破，軍卻退就高。異復作車箱圍趣五木城。苞、泰攻異，異敗歸，而魏太山太守胡烈以奇兵五千詭道襲都陸，盡焚異資糧。綝授兵三萬人使異死戰，異不從，綝斬之於鑊裡，而遣弟恩救。會誕敗引還。綝既不能拔出誕，而喪敗士眾，自戮名將，莫不怨之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":82,"last_line":82,"raw_start":11043,"raw_end":11352,"raw_character_offsets":[11043,11044,11045,11046,11047,11048,11049,11050,11051,11052,11053,11054,11055,11056,11057,11058,11059,11060,11061,11062,11063,11064,11065,11066,11067,11068,11069,11070,11071,11072,11073,11074,11075,11076,11077,11078,11079,11080,11081,11082,11083,11084,11085,11086,11087,11088,11089,11090,11091,11092,11093,11094,11095,11096,11097,11098,11099,11100,11101,11102,11103,11104,11105,11106,11107,11108,11109,11110,11111,11112,11113,11114,11115,11116,11117,11118,11119,11120,11121,11122,11123,11124,11125,11126,11127,11128,11129,11130,11131,11132,11133,11134,11135,11136,11137,11138,11139,11140,11141,11142,11143,11144,11145,11146,11147,11148,11