birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-032-he-empress:line053","text":"穆章何皇后諱法倪，廬江灊人也。父準，見《外戚傳》。以名家膺選。升平元年八月，下璽書曰：「皇帝咨前太尉參軍何琦：混元資始，肇經人倫，爰及夫婦，以奉天地宗廟社稷。謀于公卿，咸以宜率由舊典。今使使持節太常彪之、宗正綜，以禮納采。」琦答曰：「前太尉參軍、都鄉侯糞土臣何琦稽首頓首再拜。皇帝嘉命，訪婚陋族，備數採擇。臣從祖弟故散騎侍郎準之遺女，未閑教訓，衣履若如人。欽承舊章，肅奉典制。」又使兼太保、武陵王晞，兼太尉、中領軍洽，持節奉冊立為皇后。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-he-empress:line053:m0000","start":0,"end":5,"surface":"穆章何皇后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0006","start":6,"end":8,"surface":"法倪","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0016","start":16,"end":17,"surface":"準","kind":"person","person_id":"3ea_uzt_2n2","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0044","start":44,"end":46,"surface":"皇帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0052","start":52,"end":54,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0099","start":99,"end":101,"surface":"彪之","kind":"person","person_id":"7r6_k52_qji_ABDBB","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0104","start":104,"end":105,"surface":"綜","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"待平行原文確認具體身份；保留原稱。"},{"id":"c-jinshu-032-he-empress:line053:m0112","start":112,"end":113,"surface":"琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0129","start":129,"end":131,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0138","start":138,"end":140,"surface":"皇帝","kind":"person","per