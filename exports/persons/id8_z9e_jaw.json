unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-032-he-empress:line053:m0052","start":52,"end":54,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line053","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-jinshu-032-he-empress:line053:m0112","start":112,"end":113,"surface":"琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line053","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-jinshu-032-he-empress:line053:m0129","start":129,"end":131,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional","paragraph_id":"c-jinshu-032-he-empress:line053","chapter_id":"c-jinshu-032-he-empress"},{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0147","start":147,"end":149,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional","paragraph_id":"c-nanqishu-043-jiangxiao-complete:p003","chapter_id":"c-nanqishu-043-jiangxiao-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-032-he-empress:line053","text":"穆章何皇后諱法倪，廬江灊人也。父準，見《外戚傳》。以名家膺選。升平元年八月，下璽書曰：「皇帝咨前太尉參軍何琦：混元資始，肇經人倫，爰及夫婦，以奉天地宗廟社稷。謀于公卿，咸以宜率由舊典。今使使持節太常彪之、宗正綜，以禮納采。」琦答曰：「前太尉參軍、都鄉侯糞土臣何琦稽首頓首再拜。皇帝嘉命，訪婚陋族，備數採擇。臣從祖弟故散騎侍郎準之遺女，未閑教訓，衣履若如人。欽承舊章，肅奉典制。」又使兼太保、武陵王晞，兼太尉、中領軍洽，持節奉冊立為皇后。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-he-empress:line053:m0000","start":0,"end":5,"surface":"穆章何皇后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0006","start":6,"end":8,"surface":"法倪","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0016","start":16,"end":17,"surface":"準","kind":"person","person_id":"3ea_uzt_2n2","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0044","start":44,"end":46,"surface":"皇帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0052","start":52,"end":54,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0099","start":99,"end":101,"surface":"彪之","kind":"person","person_id":"7r6_k52_qji_ABDBB","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0104","start":104,"end":105,"surface":"綜","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"待平行原文確認具體身份；保留原稱。"},{"id":"c-jinshu-032-he-empress:line053:m0112","start":112,"end":113,"surface":"琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0129","start":129,"end":131,"surface":"何琦","kind":"person","person_id":"id8_z9e_jaw","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0138","start":138,"end":140,"surface":"皇帝","kind":"person","person_id":"84i_4jp_gmc","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0162","start":162,"end":163,"surface":"準","kind":"person","person_id":"3ea_uzt_2n2","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0195","start":195,"end":199,"surface":"武陵王晞","kind":"person","person_id":"dkn_ge4_286_AAAAAAAD","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0207","start":207,"end":208,"surface":"洽","kind":"person","person_id":"7r6_k52_qji_ABAAA","status":"contextual_provisional"},{"id":"c-jinshu-032-he-empress:line053:m0215","start":215,"end":217,"surface":"皇后","kind":"person","person_id":"3ea_uzt_2n2_A","status":"contextual_provisional"}],"source_position":{"first_line":53,"last_line":53,"revision_id":1543614,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-032-he-empress","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-he-empress"},{"id":"c-nanqishu-043-jiangxiao-complete:p003","text":"　　初，宋明帝勑斆出繼從叔愻，爲從祖淳後。於是僕射王儉啓：「禮無後小宗之文，近世緣情，皆由父祖之命，未有旣孤之後，出繼宗族也。雖復臣子一揆，而義非天屬。江忠簡胤嗣所寄，唯斆一人，傍無眷屬。斆宜還本。若不欲江愻絕後，可以斆小兒繼愻爲孫。」尚書參議，謂「間世立後，禮無其文。荀顗無子立孫，墜禮之始。何琦又立此論，義無所據」。於是斆還本家，詔使自量立後者。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":15,"last_line":15,"raw_start":532,"raw_end":707,"raw_character_offsets":[532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706],"revision_id":2400356},"mentions":[{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0004","start":4,"end":7,"surface":"宋明帝","kind":"person","person_id":"cti_o52_4nz","status":"contextual_provisional"},{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0008","start":8,"end":9,"surface":"斆","kind":"person","person_id":"s2k_e90_mxi","status":"contextual_provisional"},{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0013","start":13,"end":14,"surface":"愻","kind":"person","person_id":"k44_d1k_2le","status":"contextual_provisional"},{"id":"c-nanqishu-043-jiangxiao-complete:p003:m0018","start":18,"end":19,"surface":"淳","kind":"person","person_id":"700_4nm_ab2","status":"contextual_provisional"},{"id"