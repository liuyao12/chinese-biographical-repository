nce":[{"work_id":"w-nanshi","book_id":"b-nanshi-051","source_id":"s-nanshi-051-xiaojing-sons-ws2027179","chapter_id":"c-nanshi-051-xiaojing-sons","paragraph_id":"c-nanshi-051-xiaojing-sons:p003","quote":"勸弟勉。","subject_person_mention_id":"c-nanshi-051-xiaojing-sons:p003:m0002","object_person_mention_id":"c-nanshi-051-xiaojing-sons:p003:m0000"}],"status":"source_attested","interpretation_note":"弟的具名兩端及相對長幼。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-liangshu-029-huili-complete-2-202","title":"西鄉侯","kind":"noble_rank","mode":"attestation","person_id":"mnv_izb_7w3_A","attestations":[{"id":"th-liangshu-029-huili-complete-2-202:a","paragraph_id":"c-liangshu-029-huili-complete:p002","start":202,"end":205,"surface":"西鄉侯","person_mention_id":"c-liangshu-029-huili-complete:p002:m0202","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-029","chapter_id":"c-liangshu-029-huili-complete","source_id":"s-liangshu-029-huili-complete-ws1538079","paragraph_id":"c-liangshu-029-huili-complete:p002","quote":"二年，侯景圍京邑，會理治嚴將入援，會北徐州刺史封山侯正表將應其兄正德，外託赴援，實謀襲廣陵，會理擊破之。方得進路，臺城陷，侯景遣前臨江太守董紹先以高祖手敕召會理，其僚佐咸勸距之。會理曰：「諸君心事，與我不同，天子年尊，受制賊虜，今有手敕召我入朝，臣子之心，豈得違背。且遠處江北，功業難成，不若身赴京都，圖之肘腋。吾計決矣。」遂席捲而行，以城輸紹先。至京，景以爲侍中、司空、兼中書令。雖在寇手，每思匡復，與西鄉侯勸等潛布腹心，要結壯士。時范陽祖皓斬紹先，據廣陵城起義，期以會理爲內應。皓敗，辭相連及，景矯詔免會理官，猶以白衣領尚書令。","person_mention_id":"c-liangshu-029-huili-complete:p002:m0202"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[{"older_person_id":"ik4_l58_n7y","younger_person_id":"mnv_izb_7w3_A","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null,"assertion_id":"a-nan023-wangmai-xiao