1-01:m0027","object_person_mention_id":"c-sanguozhi-057-lumao:line082-pei01-01:m0046"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-w076r-gu-lu0","person_id":"u3v_t2p_tcu","title":"長史","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-guzhong","source_id":"s-jinshu-076-guzhong","paragraph_id":"c-jinshu-076-guzhong:line116","quote":"及帝踐阼，徵拜駙馬都尉、奉朝請，轉尚書郎。大將軍王敦請為從事中郎，上補南康太守。會詔除鄱陽太守，加廣武將軍。衆徑之鄱陽，不過敦，敦甚怪焉。及敦構逆，令衆出軍，衆遲回不發。敦大怒，以軍期召衆還，詰之，聲色甚厲。衆不為動容，敦意漸釋。時敦又怒宣城內史陸喈，衆又辨明之。敦長史陸玩在坐，代衆危懼，出謂衆曰：「卿真所謂剛亦不吐，柔亦不茹，雖仲山甫何以加之！」敦事捷，欲以衆為吳興內史。衆固辭，舉吏部郎桓彝，彝亦讓衆，事並不行。敦鎮姑孰，復以衆為從事中郎。敦平，除太子中庶子，為義興太守，加揚威將軍。","person_mention_id":"c-jinshu-076-guzhong:line116:m0135"}],"attestations":[{"id":"th-w076r-gu-lu0:a","paragraph_id":"c-jinshu-076-guzhong:line116","start":133,"end":135,"surface":"長史","person_mention_id":"c-jinshu-076-guzhong:line116:m0135","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"t-wu057-lumao-4","person_id":"u3v_t2p_tcu","kind":"office","title":"司空","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-057","chapter_id":"c-sanguozhi-057-lumao","source_id":"s-sanguozhi-057-lumao","paragraph_id":"c-sanguozhi-057-lumao:line082-pei01-02","quote":"《晋阳秋》称玩器量淹雅，位至司空，追赠太尉。","person_mention_id":"c-sanguozhi-057-lumao:line082-pei01-02:m0006"}],"attestations":[{"id":"t-wu057-lumao-4:a","paragraph_id":"c-sanguozhi-057-lumao:line082-pei01-02","person_mention_id":"c-sanguozhi-057-lumao:line082-pei01-02:m0006","start":14,"end":16,"surface":"司空","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-wenqiao:line026","text":"時制王敦綱紀除名，參佐禁固，嶠上疏曰：「王敦剛愎不仁，忍行殺戮，親任小人，疎遠君子，朝廷所不能抑，骨肉所不能間。處其朝者恒懼危亡，故人士結舌，道路以目，誠賢人君子道窮數盡，遵養時晦之辰也。且敦為大逆之日，拘錄人士，自免無路，原其私心，豈遑晏處，如陸玩、羊曼、劉胤、蔡謨、郭璞常與臣言，備知之矣。必其凶悖，自可罪人斯得；如其枉入姦黨，宜施之以寬。加以玩等之誠，聞於聖聽，當受同賊之責，實負其心。陛下仁聖含弘，思求允中；臣階緣博納，干非其事，誠在愛才，不忘忠益。」帝從之。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-067-wenqiao:line026:m0002","start":2,"end":4,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line026:m0014","start":14,"end":15,"surface":"嶠","kind":"person","person_id":"6v8_pk9_7k5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line026:m0020","start":20,"end":22,"surface":"王敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line026:m0095","start":95,"end":96,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line026:m0123","start":123,"end":125,"surface":"陸玩","kind":"person","person_id":"u3v_t2p_tcu","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line026:m0126","start":126,"end":128,"surface":"羊曼","kind":"person","person_id":"n5l_y9p_afh","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-wenqiao:line026:m0129","start":129,"end"