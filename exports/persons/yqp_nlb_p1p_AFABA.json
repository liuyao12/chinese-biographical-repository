":2,"end":4,"surface":"廷尉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m023-0005","start":5,"end":8,"surface":"王孫建","kind":"person","person_id":"yqp_nlb_p1p_AFABA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m023-0010","start":10,"end":13,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m023-0013","start":13,"end":16,"surface":"太子遷","kind":"person","person_id":"5th_oxr_3i6","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m023-0020","start":20,"end":23,"surface":"廷尉監","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m023-0025","start":25,"end":29,"surface":"淮南中尉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m023-0032","start":32,"end":34,"surface":"太子","kind":"person","person_id":"5th_oxr_3i6","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m023-0039","start":39,"end":42,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AFA","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m023-0045","start":45,"end":47,"surface":"太子","kind":"person","person_id":"5th_oxr_3i6","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m023-0049","start":49,"end":50,"surface":"相","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m023-0062","start":62,"end":63,"surface":"相","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m023-0064","start":64,"end":65,"surface":"相","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m023-0067","start":67,"end":69,"surface":"內史","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m023-0074","start":74,"end":76,"surface":"中尉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-118-huainan:m023-0094","start":94,"end":95,"surface