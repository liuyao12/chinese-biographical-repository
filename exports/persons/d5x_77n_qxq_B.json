s4b_5bb","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-052-later-literature-complete","book_id":"b-nanqishu-052","work_id":"w-nanqishu","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:p009","text":"　　永明末，盛爲文章。吳興沈約、陳郡謝朓、琅邪王融以氣類相推轂。汝南周顒善識聲韻。約等文皆用宮商，以平上去入爲四聲，以此制韻，不可增減，世呼爲「永明體」。沈約《宋書謝靈運傳》後又論宮商。厥與約書曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":93,"last_line":93,"raw_start":4204,"raw_end":4303,"raw_character_offsets":[4204,4205,4206,4207,4208,4209,4210,4211,4212,4213,4214,4215,4216,4217,4218,4219,4220,4221,4222,4223,4224,4225,4226,4227,4228,4229,4230,4231,4232,4233,4234,4235,4236,4237,4238,4239,4240,4241,4242,4243,4244,4245,4246,4247,4248,4249,4250,4251,4252,4253,4254,4255,4256,4257,4258,4259,4260,4261,4262,4263,4264,4265,4266,4267,4268,4269,4270,4271,4272,4273,4274,4275,4276,4277,4278,4279,4280,4281,4282,4283,4284,4285,4286,4287,4288,4289,4290,4291,4292,4293,4294,4295,4296,4297,4298,4299,4300,4301,4302],"revision_id":2371079},"mentions":[{"id":"c-nanqishu-052-later-literature-complete:p009:m0013","start":13,"end":15,"surface":"沈約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p009:m0018","start":18,"end":20,"surface":"謝朓","kind":"person","person_id":"aa6_83c_juy_ABCBA","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p009:m0023","start":23,"end":25,"surface":"王融","kind":"person","person_id":"euq_wt7_i8i","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p009:m0034","start":34,"end":36,"surface":"周顒","kind":"person","person_id":"vkd_5ff_i23","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p009:m0041","start":41,"end":42,"surface":"約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p009:m0077","start":77,"end":79,"surface":"沈約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p009:m0093","start":93,"end":94,"surface":"厥","kind":"person","person_id":"d5x_77n_qxq_B","status":"contextual_provisional"},{"id":"c-nanqishu-052-later-literature-complete:p009:m0095","start":95,"end":96,"surface":"約","kind":"person","person_id":"p8b_7w1_y3q","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-052-later-literature-complete","book_id":"b-nanqishu-052","work_id":"w-nanqishu","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:p018","text":"　　士衡雖云「炳若縟錦」，寧有濯色江波，其中復有一片是衞文之服？此則陸生之言，卽復不盡者矣。韻與不韻，復有精麤，輪扁不能言，老夫亦不盡辨此。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":111,"last_line":111,"raw_start":5469,"raw_end":5540,"raw_character_offsets":[5470,5471,5472,5473,5474,5475,5476,5477,5478,5479,5480,5481,5482,5483,5484,5485,5486,5487,5488,5489,5490,5491,5492,5493,5494,5495,5496,5497,5498,5499,5500,5501,5502,5503,5504,5505,5506,5507,5508,5509,5510,5511,5512,5513,5514,5515,5516,5517,5518,5519,5520,5521,5522,5523,5524,5525,5526,5527,5528,5529,5530,5531,5532,5533,5534,5535,5536,5537,5538,5539],"revision_id":2371079},"mentions":[{"id":"c-nanqishu-052-later-literature-complete:p018:m0034","start":34,"end":36,"surface":"陸生","kind":"person","person_id":"d5x_77n_qxq_B","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-052-later-literature-complete","book_id":"b-nanqishu-052","work_id":"w-nanqishu","source_id":"s-nanqishu-052-later-literature-complete-ws2371079"},{"id":"c-nanqishu-052-later-literature-complete:p019","text":"　　永元元年，始安王遙光反，厥父閑被誅，厥坐繫尚方，尋有赦令，厥恨父不及，感慟而卒，年二十八。文集行於世。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":113,"last_line":113,"raw_start":5542,"raw_end":5595,"raw_character_offsets":[5542,5543,5544,5545,5546,5547,5548,55