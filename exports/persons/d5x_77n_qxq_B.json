mily_path":{"connection":"father","generation_distance":1,"parent_person_id":"d5x_77n_qxq","source_assertion_id":"a-liang027-xian-son-厥","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-048","chapter_id":"c-nanshi-048-luxiang-four-brothers","source_id":"s-nanshi-048-luxiang-four-brothers-ws2493997","paragraph_id":"c-nanshi-048-luxiang-four-brothers:p001","quote":"閑四子：厥、絳、完、襄也。絳字魏卿，時隨閑，抱頸求代死，不獲，遂以身蔽刀刃，行刑者俱害之。","subject_person_mention_id":"c-nanshi-048-luxiang-four-brothers:p001:m0004","object_person_mention_id":"c-nanshi-048-luxiang-four-brothers:p001:m0000","source_term":"閑四子：厥、絳、完、襄也"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"南史明列四子，以梁傳父兄互校。"}}],"source_mention_summary":[{"source_id":"s-nanqishu-052-later-literature-complete-ws2371079","work_id":"w-nanqishu","book_id":"b-nanqishu-052","chapter_id":"c-nanqishu-052-later-literature-complete","raw_mention_count":8,"mention_ids":["c-nanqishu-052-later-literature-complete:p008:m0002","c-nanqishu-052-later-literature-complete:p008:m0005","c-nanqishu-052-later-literature-complete:p008:m0021","c-nanqishu-052-later-literature-complete:p009:m0093","c-nanqishu-052-later-literature-complete:p018:m0034","c-nanqishu-052-later-literature-complete:p019:m0014","c-nanqishu-052-later-literature-complete:p019:m0020","c-nanqishu-052-later-literature-complete:p019:m0031"],"paragraph_ids":["c-nanqishu-052-later-literature-complete:p008","c-nanqishu-052-later-literature-complete:p009","c-nanqishu-052-later-literature-complete:p018","c-nanqishu-052-later-literature-complete:p019"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p008:m0002","mention_ids":["c-nanqishu-052-later-literature-complete:p008:m0002"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later-literature-complete:p008:m0005","mention_ids":["c-nanqishu-052-later-literature-complete:p008:m0005"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-052-later