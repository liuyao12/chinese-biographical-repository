tity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-027-luxiang-complete:p004","text":"二年，侯景舉兵圍宮城，以襄直侍中省。三年三月，城陷，襄逃還吳。賊尋寇東境，沒吳郡。景將宋子仙進攻錢塘，會海鹽人陸黯舉義，有衆數千人，夜出襲郡，殺偽太守蘇單于，推襄行郡事。時淮南太守文成侯蕭寧逃賊入吳，襄遣迎寧爲盟主，遣黯及兄子映公帥衆拒子仙。子仙聞兵起，乃退還，與黯等戰於松江，黯敗走，吳下軍聞之，亦各奔散。襄匿于墓下，一夜憂憤卒，時年七十。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":67,"last_line":67,"raw_start":5061,"raw_end":5232,"raw_character_offsets":[5061,5062,5063,5064,5065,5066,5067,5068,5069,5070,5071,5072,5073,5074,5075,5076,5077,5078,5079,5080,5081,5082,5083,5084,5085,5086,5087,5088,5089,5090,5091,5092,5093,5094,5095,5096,5097,5098,5099,5100,5101,5102,5103,5104,5105,5106,5107,5108,5109,5110,5111,5112,5113,5114,5115,5116,5117,5118,5119,5120,5121,5122,5123,5124,5125,5126,5127,5128,5129,5130,5131,5132,5133,5134,5135,5136,5137,5138,5139,5140,5141,5142,5143,5144,5145,5146,5147,5148,5149,5150,5151,5152,5153,5154,5155,5156,5157,5158,5159,5160,5161,5162,5163,5164,5165,5166,5167,5168,5169,5170,5171,5172,5173,5174,5175,5176,5177,5178,5179,5180,5181,5182,5183,5184,5185,5186,5187,5188,5189,5190,5191,5192,5193,5194,5195,5196,5197,5198,5199,5200,5201,5202,5203,5204,5205,5206,5207,5208,5209,5210,5211,5212,5213,5214,5215,5216,5217,5218,5219,5220,5221,5222,5223,5224,5225,5226,5227,5228,5229,5230,5231],"revision_id":1511478},"mentions":[{"id":"c-liangshu-027-luxiang-complete:p004:m0003","start":3,"end":5,"surface":"侯景","kind":"person","person_id":"5d1_8jg_amy","status":"contextual_provisional"},{"id":"c-liangshu-027-luxiang-complete:p004:m0012","start":12,"end":13,"surface":"襄","kind":"person","person_id":"d5x_77n_qxq_A","status":"contextual_provisional"},{"id":"c-liangshu-027-luxiang-complete:p004:m0026","start":26,"end":27,"surface":"襄","kind":"person","person_id":"d5x_77n_qxq_A","status":"contextual_provisional"},{"id":"c-liangshu-027-luxiang-complete:p004:m0041","start":41,"end":42,"surface":"景","kind":"person","person_id":"5d1_8jg_amy","status":"contextual_provisional"},{"id