":5,"end":8,"surface":"桓惠王","kind":"person","person_id":"c0i_eah_y59_A","status":"contextual_provisional"},{"id":"c-shiji-045-han:m033-0011","start":11,"end":13,"surface":"王安","kind":"person","person_id":"c0i_eah_y59_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-045-han","book_id":"b-shiji-045","work_id":"w-shiji","source_id":"s-shiji-045-han"}],"sources":[{"chapter_id":"c-shiji-045-han","work_id":"w-shiji","book_id":"b-shiji-045","source_id":"s-shiji-045-han","source":{"title":"史記／卷045","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷045","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷045&oldid=7903607","revision_id":7903607,"accessed_on":"2026-10-09","extent":"36段正文；排除註釋版導覽、2個dd及現代分節標題，只去除段落外緣空白。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致；現代分節標題及導覽不當古代正文。保留蟣蝨、韓姬、韓嚴、韓非與非等原字。","note":"已讀全36段數位正文；未核古籍影像、可靠底本或現代研究，首輪不是完成覆核。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
