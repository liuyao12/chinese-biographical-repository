referred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-080-wangxizhi-family:line126:m0057","start":57,"end":59,"surface":"師宜","person_id":"8ka_y3u_oin","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。","paragraph_id":"c-jinshu-080-wangxizhi-family:line126","chapter_id":"c-jinshu-080-wangxizhi-family"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi-family:line126","text":"贊曰：書契之興，肇乎中古，繩文鳥跡，不足可觀。末代去朴歸華，舒箋點翰，爭相跨尚，競其工拙。伯英臨池之妙，無復餘蹤；師宜懸帳之奇，罕有遺跡。逮乎鐘王以降，略可言焉。鐘雖擅美一時，亦為回絕，論其盡善，或有所疑。至於布纖濃，分疏密，霞舒雲卷，無所間然。但其體則古而不今，字則長而逾制，語其大量，以此為瑕。獻之雖有父風，殊非新巧。觀其字勢疏瘦，如隆冬之枯樹；覽其筆蹤拘束，若嚴家之餓隸。其枯樹也，雖槎枿而無屈伸；其餓隸也，則羈羸而不放縱。兼斯二者，故翰墨之病歙！子雲近出，擅名江表，然僅得成書，無丈夫之氣，行行若縈春蚓，字字如綰秋蛇；臥王濛於紙中，坐徐偃於筆下；雖禿千兔之翰，聚無一毫之筋，窮萬谷之皮，斂無半分之骨；以茲播美，非其濫名邪！此數子者，皆譽過其實。所以詳察古今，研精篆素，盡善盡美，其惟王逸少乎！觀其點曳之工，裁成之妙，煙霏露結，狀若斷而還連；鳳翥龍蟠，勢如斜而反直。玩之不覺為倦，覽之莫識其端，心慕手追，此人而已。其餘區區之類，何足論哉！","text_layer":"received_compiler_appraisal","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-080-wangxizhi-family:line126:m0045","start":45,"end":47,"surface":"伯英","person_id":"9xv_kho_tfy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0057","start":57,"end":59,"surface":"師宜","person_id":"8ka_y3u_oin","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0071","start":71,"end":72,"surface":"鐘","person_id":"9hu_q3h_aug","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line126:m0072","start":72