ue,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-057-tao-huang:p007:m0044","surface":"范熊","start":44,"end":46,"person_id":"06a_equ_k8n","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-tao-huang:p007","chapter_id":"c-jinshu-057-tao-huang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-057-tao-huang:p007","text":"交土荒裔，鬥絕一方，或重譯而言，連帶山海。又南郡去州海行千有餘里，外距林邑才七百里。夷帥范熊世為逋寇，自稱為王，數攻百姓。且連接扶南，種類猥多，朋黨相倚，負險不賓。往隸吳時，數作寇逆，攻破郡縣，殺害長吏。臣以尪駑，昔為故國所采，偏戍在南，十有餘年。雖前後征討，翦其魁桀，深山僻穴，尚有逋竄。又臣所統之卒本七千餘人，南土溫濕，多有氣毒，加累年征討，死亡減耗，其見在者二千四百二十人。今四海混同，無思不服，當卷甲清刃，禮樂是務。而此州之人，識義者寡，厭其安樂，好為禍亂。又廣州南岸，周旋六千餘里，不賓屬者乃五萬餘戶，及桂林不羈之輩，復當萬戶。至於服從官役，才五千餘家。二州脣齒，唯兵是鎮。又甯州興古接據上流，去交址郡千六百里，水陸並通，互相維衛。州兵未宜約損，以示單虛。夫風塵之變，出於非常。臣亡國之餘，議不足采，聖恩廣厚，猥垂飾擢，蠲其罪釁，改授方任，去辱即寵，拭目更視，誓念投命，以報所受，臨履所見，謹冒瞽陳。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":59,"last_line":59,"raw_start":4683,"raw_end":5098,"raw_character_offsets":[4691,4692,4693,4694,4695,4696,4697,4698,4699,4700,4701,4702,4703,4704,4705,4706,4707,4708,4709,4710,4711,4712,4713,4714,4715,4716,4717,4718,4719,4720,4721,4722,4723,4724,4725,4726,4727,4728,4729,4730,4731,4732,4733,4734,4735,4736,4737,4738,4739,4740,4741,4742,4743,4744,4745,4746,4747,4748,4749,4750,4751,4752,4753,4754,4755,4756,4757,4758,4759,4760,4761,4762,4763,4764,4765,4766,4767,4768,4769,4770,4771,4772,4773,4774,4775,4776,4777,4778,4779,4780,4781,4782,4783,4784,4785,4786,4787,4788,4789,4790,4791,4792,4793,4794,4795,4796,4797,4798,4799,4800,4801,4802,4803,4804,4805,4806,4807,4808,4809,4810,4811,4812,4813,4814,4815,4816,4817,4818,4819,4820,4821,4822,4823,4824,4825,4826,4827,4828,4829,4830,4831,4832,4833,4834,4835,4836,4837,4838,4839,4840,4841,4842,4843,4844,4845,4846,4847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,4858,4