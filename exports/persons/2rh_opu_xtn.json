policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-wangrong:p009:m0023","start":23,"end":25,"surface":"傅咸","kind":"person","person_id":"2rh_opu_xtn","status":"contextual_provisional","resolution_note":"傅咸奏文引用堯舜，賈郭通親只留氏族未決；湣懷太子廢事。","paragraph_id":"c-jinshu-043-wangrong:p009","chapter_id":"c-jinshu-043-wangrong"}],"relations":[],"title_holdings":[{"id":"th-jin043-011","person_id":"2rh_opu_xtn","title":"司隸","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-wangrong","source_id":"s-jinshu-043-ws2618531-wangrong","paragraph_id":"c-jinshu-043-wangrong:p009","quote":"戎始為甲午制，凡選舉皆先治百姓，然後授用。司隸傅咸奏戎，曰：「《書》稱『三載考績，三考黜陟幽明』。今內外群官，居職未期而戎奏還，既未定其優劣，且送故迎新，相望道路，巧詐由生，傷農害政。戎不仰依堯舜典謨，而驅動浮華，虧敗風俗，非徒無益，乃有大損。宜免戎官，以敦風俗。」戎與賈、郭通親，竟得不坐。尋轉司徒。以王政將圮，苟媚取容，屬湣懷太子之廢，竟無一言匡諫。","person_mention_id":"c-jinshu-043-wangrong:p009:m0023"}],"attestations":[{"id":"th-jin043-011:a001","paragraph_id":"c-jinshu-043-wangrong:p009","start":21,"end":23,"surface":"司隸","person_mention_id":"c-jinshu-043-wangrong:p009:m0023","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本傳用稱與授任動詞語境；無明確起訖年，不以年齡、平吳背景或死亡補任期。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p009","text":"戎始為甲午制，凡選舉皆先治百姓，然後授用。司隸傅咸奏戎，曰：「《書》稱『三載考績，三考黜陟幽明』。今內外群官，居職未期而戎奏還，既未定其優劣，且送故迎新，相望道路，巧詐由生，傷農害政。戎不仰依堯舜典謨，而驅動浮華，虧敗風俗，非徒無益，乃有大損。宜免戎官，以敦風俗。」戎與賈、郭通親，竟得不坐。尋轉司徒。以王政將圮，苟媚取容，屬湣懷太子之廢，竟無一言匡諫。","text_layer":"received_chapte