"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p026:m0087","start":87,"end":90,"surface":"王度人","kind":"person","person_id":"o4d_z10_yux","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p026","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-057-northern-wei-complete:p026","text":"是後宏亦欲南侵徐、豫，於淮、泗間大積馬蒭。十一年，遣露布并上書，稱當南寇。世祖發揚、徐州民丁，廣設召募。北地人支酉，聚數千人，於長安城北西山起義。遣使告梁州刺史陰智伯。秦州人王度人起義應酉，攻獲偽刺史劉藻，秦、雍間七州民皆響震，眾至十萬，各自保壁，望朝廷救其兵。宏遣弟偽河南王幹、尚書盧陽烏擊秦、雍義軍，幹大敗。酉迎戰，進至咸陽北濁谷，圍偽司空長洛王繆老生，合戰，又大破之，老生走還長安。梁州刺史陰智伯遣軍主席德仁、張弘林等數千人應接酉等，進向長安，所至皆靡。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":60,"last_line":60,"raw_start":6589,"raw_end":6940,"raw_character_offsets":[6589,6590,6591,6592,6593,6594,6595,6596,6597,6598,6599,6600,6601,6602,6603,6604,6605,6606,6607,6608,6609,6610,6611,6612,6613,6614,6615,6616,6617,6618,6619,6620,6621,6622,6623,6624,6625,6626,6627,6628,6629,6630,6631,6632,6633,6634,6635,6636,6637,6638,6639,6640,6641,6642,6643,6644,6645,6646,6647,6648,6649,6650,6651,6652,6653,6654,6655,6656,6657,6658,6659,6660,6661,6662,6663,6664,6665,6666,6667,6668,6669,6670,6671,6672,6673,6674,6675,6676,6677,6678,6679,6680,6681,6682,6683,6684,6685,6686,6687,6688,6689,6690,6691,6692,6693,6694,6695,6696,6697,6698,6699,6700,6701,6702,6703,6704,6705,6706,6707,6708,6709,6710,6711,6712,6713,6714,6715,6716,6717,6718,6719,6720,6721,6722,6723,6724,6725,6726,6727,6728,6729,6730,6731,6732,6733,6734,6735,6736,6737,6738,6739,6740,6794,6795,6796,6797,6798,6799,6800,6801,6802,68