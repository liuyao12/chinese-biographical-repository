ion_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-hanshu-041-fanli:m-jin-003-0176","start":176,"end":178,"surface":"項悍","kind":"person","person_id":"xtl_sr1_di0","status":"contextual_provisional","paragraph_id":"c-hanshu-041-fanli:p-jin-003","chapter_id":"c-hanshu-041-fanli"},{"id":"c-shiji-056-chen:m005-0081","start":81,"end":83,"surface":"項悍","kind":"person","person_id":"xtl_sr1_di0","status":"contextual_provisional","paragraph_id":"c-shiji-056-chen:p005","chapter_id":"c-shiji-056-chen"},{"id":"c-shiji-098-fujin:m007-0182","start":182,"end":184,"surface":"項悍","kind":"person","person_id":"xtl_sr1_di0","status":"contextual_provisional","paragraph_id":"c-shiji-098-fujin:p007","chapter_id":"c-shiji-098-fujin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-hanshu041-fujin-026","person_id":"xtl_sr1_di0","surfaces":["項悍"],"scope":"cross_chapter","chapter_ids":["c-hanshu-041-fanli","c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"work_id":"w-hanshu","book_id":"b-hanshu-041","chapter_id":"c-hanshu-041-fanli","source_id":"s-hanshu-041-fanli","paragraph_id":"c-hanshu-041-fanli:p-jin-003","quote":"別之河內，擊趙賁軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下十縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從降下邯鄲。別下平陽，身斬守相，所將卒斬兵守郡一人，降鄴。從攻朝歌、邯鄲，又別擊破趙郡，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠魯下。略地東至觞、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍軍陳下，破之。別定江陵，降柱國、大司馬以下八人，身得江陵王，致雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，為信武侯。","mention_ids":["c-hanshu-041-fanli:m-jin-003-0176"]},{"work_id":"w-shiji","book_id":"b-shiji-098","chapter_id":"c-shiji-098-fujin","source_id":"s-shiji-098-fujin","paragraph_id":"c-shiji-098-fujin:p007","quote":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。","mention_ids":["c-shiji-098-fujin:m007-0182"]}],"rationale":"依傅寬、靳歙兩傳主語及與史記同一戰事、同官同名對讀；官稱依其修飾的人分辨，不由最近姓名或全域字串決定。 兩書及同書版本互見不計獨立史實票數；原字與錨點分存。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"d-shiji056-013","person_id":"xtl_sr1_di0","surfaces":["項悍"],"scope":"same_chapter","chapter_ids":["c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-056-chen:p005","quote":"久之，項羽略地至河上，陳平往歸之，從入破秦，賜平爵卿。項羽之東王彭城也，漢王還定三秦而東，殷王反楚。項羽乃以平爲信武君，將魏王咎客在楚者以往，擊降殷王而還。項王使項悍拜平爲都尉，賜金二十溢。居無何，漢王攻下殷。項王怒，將誅定殷者將吏。陳平懼誅，乃封其金與印，使使歸項王，而平身間行杖劎亡。渡河，船人見其美丈夫獨行，疑其亡將，要中當有金玉寶器，目之，欲殺平。平恐，乃解衣躶而佐刺船。船人知其無有，乃止。"}],"rationale":"兩處項悍同為楚漢交戰時項羽一方人物，陳平篇明記奉項王命授都尉，本篇記擊其軍於濟陽。依姓名、所屬與敘事時段暫接所指，不與項羽或項冠同姓即合。 同指另存eq-shiji098-followup-xianghan，原文與來源人物錨點保留。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji098-024","person_id":"xtl_sr1_di0","surfaces":["項悍"],"scope":"same_chapter","chapter_ids":["c-shiji-098-fujin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-098-fujin:p007","quote":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。"}],"rationale":"兩處項悍同為楚漢交戰時項羽一方人物，陳平篇明記奉項王命授都尉，本篇記擊其軍於濟陽。依姓名、所屬與敘事時段暫接所指，不與項羽或項冠同姓即合。 同指另存eq-shiji098-followup-xianghan，原文與來源人物錨點保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji098-followup-xianghan","person_ids":["xtl_sr1_di0"],"canonical_person_id":"xtl_sr1_di0","scope":"cross_chapter","chapter_ids":["c-shiji-098-fujin","c-shiji-056-chen"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-098-fujin","source_id":"s-shiji-09