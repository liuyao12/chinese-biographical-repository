tart":184,"end":186,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-jin-003-0212","start":212,"end":215,"surface":"江陵王","kind":"person","person_id":"bwv_ob8_6xi_A","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-jin-003-0230","start":230,"end":233,"surface":"楚王信","kind":"person","person_id":"ofc_8ei_jb7","status":"contextual_provisional"},{"id":"c-hanshu-041-fanli:m-jin-003-0250","start":250,"end":253,"surface":"信武侯","kind":"person","person_id":"7dv_lqp_y4z","status":"contextual_provisional"}],"chapter_id":"c-hanshu-041-fanli","book_id":"b-hanshu-041","work_id":"w-hanshu","source_id":"s-hanshu-041-fanli"},{"id":"c-shiji-056-chen:p005","text":"久之，項羽略地至河上，陳平往歸之，從入破秦，賜平爵卿。項羽之東王彭城也，漢王還定三秦而東，殷王反楚。項羽乃以平爲信武君，將魏王咎客在楚者以往，擊降殷王而還。項王使項悍拜平爲都尉，賜金二十溢。居無何，漢王攻下殷。項王怒，將誅定殷者將吏。陳平懼誅，乃封其金與印，使使歸項王，而平身間行杖劎亡。渡河，船人見其美丈夫獨行，疑其亡將，要中當有金玉寶器，目之，欲殺平。平恐，乃解衣躶而佐刺船。船人知其無有，乃止。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-056-chen:m005-0003","start":3,"end":5,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0011","start":11,"end":13,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0023","start":23,"end":24,"surface":"平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0027","start":27,"end":29,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0036","start":36,"end":38,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0045","start":45,"end":47,"surface":"殷王","kind":"person","person_id":"mys_kcy_y9o","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0050","start":50,"end":52,"surface":"項羽","kind":"person","