atus":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0147","start":147,"end":149,"surface":"船人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-056-chen:m005-0176","start":176,"end":177,"surface":"平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0178","start":178,"end":179,"surface":"平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-056-chen:m005-0190","start":190,"end":192,"surface":"船人","kind":"unresolved","person_id":null,"status":"unresolved","note":"未名者、群體、泛稱官職、氏族或代詞待覆核，不補姓名或未見家屬。"}],"chapter_id":"c-shiji-056-chen","book_id":"b-shiji-056","work_id":"w-shiji","source_id":"s-shiji-056-chen"},{"id":"c-shiji-098-fujin:p007","text":"別之河內，擊趙將賁郝軍朝歌，破之，所將卒得騎將二人，車馬二百五十匹。從攻安陽以東，至棘蒲，下七縣。別攻破趙軍，得其將司馬二人，候四人，降吏卒二千四百人。從攻下邯鄲。別下平陽，身斬守相，所將卒斬兵守、郡守各一人，降鄴。從攻朝歌、邯鄲，及別擊破趙軍，降邯鄲郡六縣。還軍敖倉，破項籍軍成皋南，擊絕楚饟道，起滎陽至襄邑。破項冠軍魯下。略地東至繒、郯、下邳，南至蘄、竹邑。擊項悍濟陽下。還擊項籍陳下，破之。別定江陵，降江陵柱國、大司馬以下八人，身得江陵王，生致之雒陽，因定南郡。從至陳，取楚王信，剖符世世勿絕，定食四千六百戶，號信武侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-098-fujin:m007-0008","start":8,"end":10,"surface":"賁郝","kind":"person","person_id":"phx_lyu_9ym","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0136","start":136,"end":138,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0157","start":157,"end":159,"surface":"項冠","kind":"person","person_id":"uxv_exs_5k3","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0182","start":182,"end":184,"surface":"項悍","kind":"person","person_id":"xtl_sr1_di0","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0190","start":190,"end":192,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-098-fujin:m007-0219","start":219,"end":222,"surface":"江陵王",