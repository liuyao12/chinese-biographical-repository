tion_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"start":148,"end":150,"surface":"耿弇","id":"c-nanshi-019-xiehui:p007:m0148","person_id":"4an_rp5_4ir","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作耿弇。","paragraph_id":"c-nanshi-019-xiehui:p007","chapter_id":"c-nanshi-019-xiehui"},{"id":"c-songshu-044-wyd1739-xiehui:p005:m0173","start":173,"end":175,"surface":"耿弇","status":"contextual_provisional","interpretation_note":"原文明指單一人物，已登記為可查來源暫分個體；跨篇同指仍可覆核，本號不表示已證另人。","kind":"person","person_id":"4an_rp5_4ir","source_role_key":"gengyan","paragraph_id":"c-songshu-044-wyd1739-xiehui:p005","chapter_id":"c-songshu-044-wyd1739-xiehui"},{"id":"c-songshu-044-xiehui-digital:p010:m0315","start":315,"end":317,"surface":"耿弇","person_id":"4an_rp5_4ir","kind":"person","status":"contextual_provisional","interpretation_note":"依本句具名用字及語境聯繫現役人物。","paragraph_id":"c-songshu-044-xiehui-digital:p010","chapter_id":"c-songshu-044-xiehui-digital"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-song044-wyd-role-gengyan","person_id":"4an_rp5_4ir","surfaces":["耿弇"],"scope":"same_chapter","chapter_ids":["c-songshu-044-wyd1739-xiehui"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-songshu-044-wyd1739-xiehui:p005:m0173"]},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-044","source_id":"s-songshu-044-wyd1739-xiehui","chapter_id":"c-songshu-044-wyd1739-xiehui","paragraph_id":"c-songshu-044-wyd1739-xiehui:p005","quote":"凡淺感恩自厲送往事居誠貫幽顯逮營陽失德自絶宗廟朝野岌岌憂及禍難忠謀協契徇國忘己援登聖朝惟新皇祚陛下馳傳乘流曾不惟疑臨朝殷懃增崇封爵此則臣等赤心已亮於天鑒遠近萬邦咸達於聖旨若臣等志欲專權不顧國典便當協翼幼主孤背天日豈復虛館七旬仰望鸞旗者哉故廬陵王於營陽之世屢被猜嫌積怨犯上自貽非命天祚明德屬當昌運不有所廢將何以興成人之美春秋之高義立帝清館臣節之所司耿弇不以賊遺君父臣亦何負於宋室邪況釁結鬩牆禍成畏逼天下耳目豈伊可誣臣忝居蕃任乃誠匪懈為政小大必先啟聞糾剔羣蠻清夷境內分留弟姪並侍殿省陛下聿遵先志申以婚姻童稚之目猥荷齒召薦女遷子合門相送事君之道義盡於斯臣羡之總錄百揆翼亮三世年耆乞退屢抗表疏優旨綢繆未垂順許臣亮管司喉舌恪虔夙夜恭謹一心守死善道此皆皇宋之宗臣社稷之鎮衞而讒人傾覆妄生國釁天威震怒加以極刑并及臣門同被孥戮雖未知臣道濟問推理卽事不容獨存先帝顧託元臣翼命之佐勦於佞邪之手忠貞匪躬之輔不免夷滅之誅陛下春秋方富始覽萬機民之情偽未能鑒悉王弘兄弟"}],"rationale":"本源明確個體已暫分登記；現有召回尚不足以接合他篇，不代表已證異人或歷史上無完整姓名。 本源確指個體採暫分登記；跨篇同指保留覆核，不斷言必為新人。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-019-xiehui:p007","text":"文帝誅羨之等及晦子世休，收嚼、嚼子世平、兄子紹等。晦知訖，先舉羨之、亮哀，次發子弟凶問。旣而自出射堂，集得精兵三萬人，乃奉表，言：「臣等若志欲專權，不顧國典，便當輔翼幼主，孤背天日，豈得沿流二千，虛館三月，奉迎鑾駕，以遵下武。故廬陵王於營陽之世，屢彼猜嫌，積怨犯上，自貽非命。不有所廢，將何以興，耿弇不以賊遺君父，臣亦何負於宋室邪。」又言：「羨之、亮無罪見誅，王弘兄弟輕躁昧進，王華猜忌忍害」。帝時已戒嚴，尙書符荊州暴其罪狀。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":3,"end":5,"surface":"羨之","id":"c-nanshi-019-xiehui:p007:m0003","person_id":"4y6_myv_ojh","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作徐羨之。"},{"start":7,"end":8,"surface":"晦","id":"c-nanshi-019-xiehui:p007:m0007","person_id":"aa6_83c_juy_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝晦。"},{"start":9,"end":11,"surface":"世休","id":"c-nanshi-019-xiehui:p007:m0009","person_id":"aa6_83c_juy_AAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝世休。"},{"start":13,"end":14,"surface":"嚼","id":"c-nanshi-019-xiehui:p007:m0013","person_id":"aa6_83c_juy_AAAE","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作㬭。"},{"start":15,"end":16,"surface":"嚼","id":"c-nanshi-019-xiehui:p007:m0015","person_id":"aa6_83c_juy_AAAE","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作㬭。"},{"start":17,"end":19,"surface":"世平","id":"c-nanshi-019-xiehui:p007:m0017","person_id":"aa6_83c_juy_AAAEA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘