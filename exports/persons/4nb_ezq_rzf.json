rved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin077-f51-049","person_id":"4nb_ezq_rzf","title":null,"surname":null,"ming":null,"additional_names":["龍會"],"chapter_id":"c-jinshu-077-yinhao","paragraph_id":"c-jinshu-077-yinhao:p008","person_mention_id":"c-jinshu-077-yinhao:p008:m0276","quote":"案中軍將軍浩過蒙朝恩，叨竊非據，寵靈超卓，再司京輦，不能恭慎所任，恪居職次，而侵官離局，高下在心。前司徒臣謨執義履素，位居台輔，師傅先帝，朝之元老，年登七十，以禮請退，雖臨軒固辭，不順恩旨，適足以明遜讓之風，弘優賢之禮。而浩虛生狡說，疑誤朝聽，獄之有司，將致大辟。自羯胡夭亡，群凶殄滅，而百姓塗炭，企遲拯接。浩受專征之重，無雪恥之志，坐自封植，妄生風塵，遂使寇仇稽誅，奸逆並起，華夏鼎沸，黎元殄悴。浩懼罪將及，不容於朝，外聲進討，內求苟免。出次壽陽，頓甲彌年，傾天府之資，竭五州之力，收合無賴，以自強衛，爵命無章，猜害罔顧。故范豐之屬反叛於芍陂，奇德、龍會作變於肘腋。羌帥姚襄率眾歸化，遣其母弟入質京邑，浩不能撫而用之，陰圖殺害，再遣剌客，為襄所覺。襄遂惶懼，用致逆命。生長亂階，自浩始也。復不能以時掃滅，縱放小豎，鼓行毒害，身狼狽于山桑，軍破碎于梁國，舟車焚燒，輜重覆沒。三軍積實，反以資寇，精甲利器，更為賊用。神怒人怨，眾之所棄，傾危之憂，將及社稷。臣所以忘寢屏營，啟處無地。夫率正顯義，所以致訓，明罰敕法，所以齊眾，伏願陛下上追唐堯放命之刑下鑒《春秋》無君之典。若聖上含弘，末忍誅殛，且宜遐棄，擯之荒裔。雖未足以塞山海之責，粗可以宣誡於將來矣。","source_anchor":{"paragraph_id":"c-jinshu-077-yinhao:p008","start":276,"end":278,"surface":"龍會"},"note":"奇德／龍會只見原稱，未有可核姓／名分拆，不機械剝第一字作姓。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-077","source_id":"s-jinshu-077-yinhao"}],"mentions":[{"id":"c-jinshu-077-yinhao:p008:m0276","start":276,"end":278,"surface":"龍會","kind":"person","person_id":"4nb_ezq_rzf","status":"contextual_provisional","interpretation_note":"依完整敘事／引語主語逐段辨識；原字不校改。","paragraph_id":"c-jinshu-077-yinhao:p008","chapter_id":"c-jinshu-077-yinhao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-077-yinhao:p008","text":"案中軍將軍浩過蒙朝恩，叨竊非據，寵靈超卓，再司京輦，不能恭慎所任，恪居職次，而侵官離局，高下在心。前司徒臣謨執義履素，位居台輔，師傅先帝，朝之元老，年登七十，以禮請退，雖臨軒固辭，不順恩旨，適足以明遜讓之風，弘優賢之禮。而浩虛生狡說，疑誤朝聽，獄之有司，將致大辟。自羯胡夭亡，群凶殄滅，而百姓塗炭，企遲拯接。浩受專征之重，無雪恥之志，坐自封植，妄生風塵，遂使寇仇稽誅，奸逆並起，華夏鼎沸，黎元殄悴。浩懼罪將及，不容於朝，外聲進討，內求苟免。出次壽陽，頓甲彌年，傾天府之資，竭五州之力，