aragraph_id":"c-shiji-069-su:p015","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m016-0042","start":42,"end":44,"surface":"大王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p016","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m017-0000","start":0,"end":2,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p017","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m021-0040","start":40,"end":42,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p021","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m024-0072","start":72,"end":74,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p024","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m025-0021","start":21,"end":23,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p025","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m029-0034","start":34,"end":36,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p029","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m034-0154","start":154,"end":156,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p034","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m037-0002","start":2,"end":4,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p037","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m038-0012","start":12,"end":15,"surface":"趙肅侯","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p038","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m039-0027","start":27,"end":29,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p039","chapter_id":"c-shiji-069-su"}],"relations":[{"id":"a-shiji069-001","subject_person_id":"cbr-p004029","predicate":"brother","object_person_id":"cbr-p004028","status":"source_attested","evidence":[{"chapter_id":"c-shiji-069-su","source_id":"s-shiji-069-su","paragraph_id":"c-shiji-069-su:p004","quote":"乃東之趙。趙肅侯令其弟成為相，號奉陽君。奉陽君弗說之。"}],"qualifiers":{"source_term":"趙肅侯令其弟成","historicity":"historical_tradition"},"interpretation_note":"按明示弟、女、母、婦與夫人保存，兄弟不推定同父同母。故事夫妻只在蘇秦引述故事內，不作獨立史實確證；燕太子與易王按篇內繼位暫接。繼位、先王、嗣及婚的未定姻親不補父子或兩人配偶。未名家屬、太后與穰侯不補姓名，版本與年代仍待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji069-007","person_id":"cbr-p004028","surfaces":["君","大王","趙王","趙肅侯"],"scope":"same_chapter","chapter_ids":["c-shiji-069-su"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-069-su:p004","quote":"乃東之趙。趙肅侯令其弟成為相，號奉陽君。奉陽君弗說之。"},{"paragraph_id":"c-shiji-069-su:p008","quote":"於是資蘇秦車馬金帛以至趙。而奉陽君已死，即因說趙肅侯曰：「天下卿相人臣及布衣之士，皆高賢君之行義，皆願奉敎陳忠於前之日久矣。雖然，奉陽君妒而君不任事，是以賓客游士莫敢自盡於前者。今奉陽君捐館舍，君乃今復與士民相親也，臣故敢進其愚慮。"},{"paragraph_id":"c-shiji-069-su:p009","quote":"「竊為君計者，莫若安民無事，且無庸有事於民也。安民之本，在於擇交，擇交而得則民安，擇交而不得則民終身不安。請言外患：齊秦為兩敵而民不得安，倚秦攻齊而民不得安，倚齊攻秦而民不得安。故夫謀人之主，伐人之國，常苦出辭斷絕人之交也。願君慎勿出於口。請別白黑所以異，陰陽而已矣。君誠能聽臣，燕必致旃裘狗馬之地，齊必致魚鹽之海，楚必致橘柚之園，韓、魏、中山皆可使致湯沐之奉，而貴戚父兄皆可以受封侯。夫割地包利，五伯之所以覆軍禽將而求也；封侯貴戚，湯武之所以放弑而爭也。今君高拱而兩有之，此臣之所以為君願也。"},{"paragraph_id":"c-shiji-069-su:p010","quote":"「今大王與秦，則秦必弱韓、魏；與齊，則齊必弱楚、魏。魏弱則割河外，韓弱則效宜陽，宜陽效則上郡絕，河外割則道不通，楚弱則無援。此三策者，不可不孰計也。"},{"paragraph_id":"c-shiji-069-su:p011","quote":"「夫秦下軹道，則南陽危；劫韓包周，則趙氏自操兵；據衞取卷，則齊必入朝秦。秦欲已得乎山東，則必舉兵而嚮趙矣。秦甲渡河踰漳，據番吾，則兵必戰於邯鄲之下矣。此臣之所為君患也。"},{"paragraph_id":"c-shiji-069-su:p012","quote":"「當今之時，山東之建國莫彊於趙。趙地方二千餘里，帶甲數十萬，車千乘，騎萬匹，粟支數年。西有常山，南有河漳，東有清河，北有燕國。燕固弱國，不足畏也。秦之所害於天下者莫如趙，然而秦不敢舉兵伐趙者，何也？畏韓、魏之議其後也。然則韓、魏，趙之南蔽也。秦之攻韓、魏也，無有名山大川之限，稍蠶食之，傅國都而止。韓、魏不能支秦，必入臣於秦。秦無韓、魏之規，則禍必中於趙矣。此臣之所為君患也。"},{"paragraph_id":"c-shiji-069-su:p015","quote":"「夫衡人者，皆欲割諸侯之地以予秦。秦成，則高臺榭，美宮室，聽竽瑟之音，前有樓闕軒轅，後有長姣美人，國被秦患而不與其憂。是故夫衡人日夜務以秦權恐愒諸侯以求割地，故願大王孰計之也。"},{"paragraph_id":"c-shiji-069-su:p016","quote":"「臣聞明主絕疑去讒，屏流言之跡，塞朋黨之門，故尊主廣地彊兵之計臣得陳忠於前矣。故竊為大王計，莫如一韓、魏、齊、楚、燕、趙以從親，以畔秦。令天下之將相會於洹水之上，通質，刳白馬而盟。要約曰：『秦攻楚，齊、魏各出銳師以佐之，韓絕其糧道，趙涉河漳，燕守常山之北。秦攻韓魏，則楚絕其後，齊出銳師而佐之，趙涉河漳，燕守雲中。秦攻齊，則楚絕其後，韓守城皋，魏塞其道，趙涉河漳、博關，燕出銳師以佐之。秦攻燕，則趙守常山，楚軍武關，齊涉勃海，韓、魏皆出銳師以佐之。秦攻趙，則韓軍宜陽，楚軍武關，魏軍河外，齊涉清河，燕出銳師以佐之。諸侯有不如約者，以五國之兵共伐之。』六國從親以賓秦，則秦甲必不敢出於函谷以害山東矣。如此，則霸王之業成矣。」"},{"paragraph_id":"c-shiji-069-su:p017","quote":"趙王曰：「寡人年少，立國日淺，未嘗得聞社稷之長計也。今上客有意存天下，安諸侯。寡人敬以國從。」乃飾車百乘，黃金千溢，白璧百雙，錦繡千純，以約諸侯。"},{"paragraph_id":"c-shiji-069-su:p021","quote":"於是韓王勃然作色，攘臂瞋目，按劍仰天太息曰；「寡人雖不肖，必不能事秦。今主君詔以趙王之敎，敬奉社稷以從。」"},{"paragraph_id":"c-shiji-069-su:p024","quote":"「周書曰：『緜緜不絕，蔓蔓奈何？毫釐不伐，將用斧柯。』前慮不定，後有大患，將奈之何？大王誠能聽臣，六國從親，專心并力壹意，則必無彊秦之患。故敝邑趙王使臣效愚計，奉明約，在大王之詔詔之。」"},{"paragraph_id":"c-shiji-069-su:p025","quote":"魏王曰：「寡人不肖，未嘗得聞明敎。今主君以趙王之詔詔之，敬以國從。」"},{"paragraph_id":"c-shiji-069-su:p029","quote":"齊王曰：「寡人不敏，僻遠守海，窮道東境之國也，未嘗得聞餘教。今足下以趙王詔詔之，敬以國從。」"},{"paragraph_id":"c-shiji-069-su:p034","quote":"「夫秦，虎狼之國也，有吞天下之心。秦，天下之仇讎也。衡人皆欲割諸侯之地以事秦，此所謂養仇而奉讎者也。夫為人臣，割其主之地以外交彊虎狼之秦，以侵天下，卒有秦患，不顧其禍。夫外挾彊秦之威以內劫其主，以求割地，大逆不忠，無過此者。故從親則諸侯割地以事楚，衡合則楚割地以事秦，此兩策者相去遠矣，二者大王何居焉？故敝邑趙王使臣效愚計，奉明約，在大王詔之。」"},{"paragraph_id":"c-shiji-069-su:p037","quote":"北報趙王，乃行過雒陽，車騎輜重，諸侯各發使送之甚衆，疑於王者。周顯王聞之恐懼，除道，使人郊勞。蘇秦之昆弟妻嫂側目不敢仰視，俯伏侍取食。蘇秦笑謂其嫂曰：「何前倨而後恭也？」嫂委蛇蒲服，以面掩地而謝曰：「見季子位高金多也。」蘇秦喟然嘆曰：「此一人之身，富貴則親戚畏懼之，貧賤則輕易之，況衆人乎！且使我有雒陽負郭田二頃，吾豈能佩六國相印乎！」於是散千金以賜宗族朋友。初，蘇秦之燕，貸人百錢為資，乃得富貴，以百金償之。遍報諸所嘗見德者。其從者有一人獨未得報，乃前自言。蘇秦曰：「我非忘子。子之與我至燕，再三欲去我易水之上，方是時，我困，故望子深，是以後子，子今亦得之矣。"},{"paragraph_id":"c-shiji-069-su:p038","quote":"蘇秦既約六國從親，歸趙，趙肅侯封為武安君，乃投從約書於秦。秦兵不敢闚函谷關十五年。"},{"paragraph_id":"c-shiji-069-su:p039","quote":"其後秦使犀首欺齊、魏，與共伐趙，欲敗從約。齊、魏伐趙，趙王讓蘇秦。蘇秦恐，請使燕，必報齊。蘇秦去趙而從約皆解。"}],"rationale":"按姓名、字稱、遊說對象及嵌入書信局部暫接。蘇代初見燕王、過魏魏王齊王及書信秦王楚王等另存候選，未按歷史年代補熟名；不斷言這些候選必為異人。燕噲讓位段與燕昭王書信分辨，書信內外王稱按引語範圍。穰侯舅與太后母局部暫接，未補姓名或秦王親屬世系。故事家屬與蘇秦家屬分存；全67段明示姓名首輪已存，版本年代、匿名者代詞及其他身份尚待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-069-su:p004","text":"乃東之趙。趙肅侯令其弟成為相，號奉陽君。奉陽君弗說之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m004-0005","start":5,"end":8,"surface":"趙肅侯","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m004-0011","start":11,"end":12,"surface":"成","kind":"person","person_id":"cbr-p004029","status":"contextual_provisional"},{"id":"c-shiji-069-su:m004-0016","start":16,"end":19,"surface":"奉陽君","kind":"person","person_id":"cbr-p004029","status":"contextual_provisional"},{"id":"c-shiji-069-su:m004-0020","start":20,"end":23,"surface":"奉陽君","kind":"person","person_id":"cbr-p004029","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p008","text":"於是資蘇秦車馬金帛以至趙。而奉陽君已死，即因說趙肅侯曰：「天下卿相人臣及布衣之士，皆高賢君之行義，皆願奉敎陳忠於前之日久矣。雖然，奉陽君妒而君不任事，是以賓客游士莫敢自盡於前者。今奉陽君捐館舍，君乃今復與士民相親也，臣故敢進其愚慮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m008-0003","start":3,"end":5,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m008-0014","start":14,"end":17,"surface":"奉陽君","kind":"person","person_id":"cbr-p004029","status":"contextual_provisional"},{"id":"c-shiji-069-su:m008-0023","start":23,"end":26,"surface":"趙肅侯","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m008-0031","start":31,"end":35,"surface":"卿相人臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m008-0036","start":36,"end":40,"surface":"布衣之士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m008-0044","start":44,"end":45,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m008-0065","start":65,"end":68,"surface":"奉陽君","kind":"person","person_id":"cbr-p004029","status":"contextual_provisional"},{"id":"c-shiji-069-su:m008-0070","start":70,"end":71,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m008-0077","start":77,"end":81,"surface":"賓客游士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m008-0090","start":90,"end":93,"surface":"奉陽君","kind":"person","person_id":"cbr-p004029","status":"contextual_provisional"},{"id":"c-shiji-069-su:m008-0097","start":97,"end":98,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m008-0102","start":102,"end":104,"surface":"士民","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p009","text":"「竊為君計者，莫若安民無事，且無庸有事於民也。安民之本，在於擇交，擇交而得則民安，擇交而不得則民終身不安。請言外患：齊秦為兩敵而民不得安，倚秦攻齊而民不得安，倚齊攻秦而民不得安。故夫謀人之主，伐人之國，常苦出辭斷絕人之交也。願君慎勿出於口。請別白黑所以異，陰陽而已矣。君誠能聽臣，燕必致旃裘狗馬之地，齊必致魚鹽之海，楚必致橘柚之園，韓、魏、中山皆可使致湯沐之奉，而貴戚父兄皆可以受封侯。夫割地包利，五伯之所以覆軍禽將而求也；封侯貴戚，湯武之所以放弑而爭也。今君高拱而兩有之，此臣之所以為君願也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m009-0003","start":3,"end":4,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m009-0113","start":113,"end":114,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m009-0134","start":134,"end":135,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m009-0182","start":182,"end":186,"surface":"貴戚父兄","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m009-0199","start":199,"end":201,"surface":"五伯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m009-0217","start":217,"end":218,"surface":"湯","kind":"person","person_id":"cbr-p004039","status":"contextual_provisional"},{"id":"c-shiji-069-su:m009-0218","start":218,"end":219,"surface":"武","kind":"person","person_id":"cbr-p004040","status":"contextual_provisional"},{"id":"c-shiji-069-su:m009-0229","start":229,"end":230,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m009-0243","start":243,"end":244,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p010","text":"「今大王與秦，則秦必弱韓、魏；與齊，則齊必弱楚、魏。魏弱則割河外，韓弱則效宜陽，宜陽效則上郡絕，河外割則道不通，楚弱則無援。此三策者，不可不孰計也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m010-0002","start":2,"end":4,"surface":"大王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p011","text":"「夫秦下軹道，則南陽危；劫韓包周，則趙氏自操兵；據衞取卷，則齊必入朝秦。秦欲已得乎山東，則必舉兵而嚮趙矣。秦甲渡河踰漳，據番吾，則兵必戰於邯鄲之下矣。此臣之所為君患也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m011-0018","start":18,"end":20,"surface":"趙氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m011-0080","start":80,"end":81,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p012","text":"「當今之時，山東之建國莫彊於趙。趙地方二千餘里，帶甲數十萬，車千乘，騎萬匹，粟支數年。西有常山，南有河漳，東有清河，北有燕國。燕固弱國，不足畏也。秦之所害於天下者莫如趙，然而秦不敢舉兵伐趙者，何也？畏韓、魏之議其後也。然則韓、魏，趙之南蔽也。秦之攻韓、魏也，無有名山大川之限，稍蠶食之，傅國都而止。韓、魏不能支秦，必入臣於秦。秦無韓、魏之規，則禍必中於趙矣。此臣之所為君患也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m012-0184","start":184,"end":185,"surface":"君","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p015","text":"「夫衡人者，皆欲割諸侯之地以予秦。秦成，則高臺榭，美宮室，聽竽瑟之音，前有樓闕軒轅，後有長姣美人，國被秦患而不與其憂。是故夫衡人日夜務以秦權恐愒諸侯以求割地，故願大王孰計之也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m015-0002","start":2,"end":4,"surface":"衡人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m015-0009","start":9,"end":11,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m015-0046","start":46,"end":48,"surface":"美人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m015-0062","start":62,"end":64,"surface":"衡人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m015-0072","start":72,"end":74,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m015-0081","start":81,"end":83,"surface":"大王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p016","text":"「臣聞明主絕疑去讒，屏流言之跡，塞朋黨之門，故尊主廣地彊兵之計臣得陳忠於前矣。故竊為大王計，莫如一韓、魏、齊、楚、燕、趙以從親，以畔秦。令天下之將相會於洹水之上，通質，刳白馬而盟。要約曰：『秦攻楚，齊、魏各出銳師以佐之，韓絕其糧道，趙涉河漳，燕守常山之北。秦攻韓魏，則楚絕其後，齊出銳師而佐之，趙涉河漳，燕守雲中。秦攻齊，則楚絕其後，韓守城皋，魏塞其道，趙涉河漳、博關，燕出銳師以佐之。秦攻燕，則趙守常山，楚軍武關，齊涉勃海，韓、魏皆出銳師以佐之。秦攻趙，則韓軍宜陽，楚軍武關，魏軍河外，齊涉清河，燕出銳師以佐之。諸侯有不如約者，以五國之兵共伐之。』六國從親以賓秦，則秦甲必不敢出於函谷以害山東矣。如此，則霸王之業成矣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m016-0003","start":3,"end":5,"surface":"明主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m016-0042","start":42,"end":44,"surface":"大王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m016-0072","start":72,"end":74,"surface":"將相","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m016-0257","start":257,"end":259,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p017","text":"趙王曰：「寡人年少，立國日淺，未嘗得聞社稷之長計也。今上客有意存天下，安諸侯。寡人敬以國從。」乃飾車百乘，黃金千溢，白璧百雙，錦繡千純，以約諸侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m017-0000","start":0,"end":2,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m017-0027","start":27,"end":29,"surface":"上客","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m017-0036","start":36,"end":38,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"},{"id":"c-shiji-069-su:m017-0070","start":70,"end":72,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱、氏族、未名者或未定指代，不補姓名、成員及闕代。"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p021","text":"於是韓王勃然作色，攘臂瞋目，按劍仰天太息曰；「寡人雖不肖，必不能事秦。今主君詔以趙王之敎，敬奉社稷以從。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m021-0002","start":2,"end":4,"surface":"韓王","kind":"person","person_id":"cbr-p004038","status":"contextual_provisional"},{"id":"c-shiji-069-su:m021-0036","start":36,"end":38,"surface":"主君","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m021-0040","start":40,"end":42,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p024","text":"「周書曰：『緜緜不絕，蔓蔓奈何？毫釐不伐，將用斧柯。』前慮不定，後有大患，將奈之何？大王誠能聽臣，六國從親，專心并力壹意，則必無彊秦之患。故敝邑趙王使臣效愚計，奉明約，在大王之詔詔之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m024-0042","start":42,"end":44,"surface":"大王","kind":"person","person_id":"cbr-p004041","status":"contextual_provisional"},{"id":"c-shiji-069-su:m024-0072","start":72,"end":74,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m024-0085","start":85,"end":87,"surface":"大王","kind":"person","person_id":"cbr-p004041","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p025","text":"魏王曰：「寡人不肖，未嘗得聞明敎。今主君以趙王之詔詔之，敬以國從。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m025-0000","start":0,"end":2,"surface":"魏王","kind":"person","person_id":"cbr-p004041","status":"contextual_provisional"},{"id":"c-shiji-069-su:m025-0018","start":18,"end":20,"surface":"主君","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m025-0021","start":21,"end":23,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p029","text":"齊王曰：「寡人不敏，僻遠守海，窮道東境之國也，未嘗得聞餘教。今足下以趙王詔詔之，敬以國從。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m029-0000","start":0,"end":2,"surface":"齊王","kind":"person","person_id":"cbr-p004045","status":"contextual_provisional"},{"id":"c-shiji-069-su:m029-0034","start":34,"end":36,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p034","text":"「夫秦，虎狼之國也，有吞天下之心。秦，天下之仇讎也。衡人皆欲割諸侯之地以事秦，此所謂養仇而奉讎者也。夫為人臣，割其主之地以外交彊虎狼之秦，以侵天下，卒有秦患，不顧其禍。夫外挾彊秦之威以內劫其主，以求割地，大逆不忠，無過此者。故從親則諸侯割地以事楚，衡合則楚割地以事秦，此兩策者相去遠矣，二者大王何居焉？故敝邑趙王使臣效愚計，奉明約，在大王詔之。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m034-0026","start":26,"end":28,"surface":"衡人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m034-0031","start":31,"end":33,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m034-0116","start":116,"end":118,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m034-0145","start":145,"end":147,"surface":"大王","kind":"person","person_id":"cbr-p004046","status":"contextual_provisional"},{"id":"c-shiji-069-su:m034-0154","start":154,"end":156,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m034-0167","start":167,"end":169,"surface":"大王","kind":"person","person_id":"cbr-p004046","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p037","text":"北報趙王，乃行過雒陽，車騎輜重，諸侯各發使送之甚衆，疑於王者。周顯王聞之恐懼，除道，使人郊勞。蘇秦之昆弟妻嫂側目不敢仰視，俯伏侍取食。蘇秦笑謂其嫂曰：「何前倨而後恭也？」嫂委蛇蒲服，以面掩地而謝曰：「見季子位高金多也。」蘇秦喟然嘆曰：「此一人之身，富貴則親戚畏懼之，貧賤則輕易之，況衆人乎！且使我有雒陽負郭田二頃，吾豈能佩六國相印乎！」於是散千金以賜宗族朋友。初，蘇秦之燕，貸人百錢為資，乃得富貴，以百金償之。遍報諸所嘗見德者。其從者有一人獨未得報，乃前自言。蘇秦曰：「我非忘子。子之與我至燕，再三欲去我易水之上，方是時，我困，故望子深，是以後子，子今亦得之矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m037-0002","start":2,"end":4,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0016","start":16,"end":18,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m037-0028","start":28,"end":30,"surface":"王者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m037-0031","start":31,"end":34,"surface":"周顯王","kind":"person","person_id":"cbr-p004024","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0042","start":42,"end":44,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m037-0047","start":47,"end":49,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0050","start":50,"end":53,"surface":"昆弟妻","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m037-0053","start":53,"end":54,"surface":"嫂","kind":"person","person_id":"cbr-p004054","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0067","start":67,"end":69,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0072","start":72,"end":73,"surface":"嫂","kind":"person","person_id":"cbr-p004054","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0085","start":85,"end":86,"surface":"嫂","kind":"person","person_id":"cbr-p004054","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0101","start":101,"end":103,"surface":"季子","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0110","start":110,"end":112,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0127","start":127,"end":129,"surface":"親戚","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m037-0141","start":141,"end":143,"surface":"衆人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m037-0175","start":175,"end":179,"surface":"宗族朋友","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、未名者或未定指代，未補成員、姓名及世系。"},{"id":"c-shiji-069-su:m037-0182","start":182,"end":184,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0188","start":188,"end":189,"surface":"人","kind":"person","person_id":"cbr-p004064","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0215","start":215,"end":217,"surface":"從者","kind":"person","person_id":"cbr-p004063","status":"contextual_provisional"},{"id":"c-shiji-069-su:m037-0230","start":230,"end":232,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p038","text":"蘇秦既約六國從親，歸趙，趙肅侯封為武安君，乃投從約書於秦。秦兵不敢闚函谷關十五年。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m038-0000","start":0,"end":2,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m038-0012","start":12,"end":15,"surface":"趙肅侯","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p039","text":"其後秦使犀首欺齊、魏，與共伐趙，欲敗從約。齊、魏伐趙，趙王讓蘇秦。蘇秦恐，請使燕，必報齊。蘇秦去趙而從約皆解。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m039-0004","start":4,"end":6,"surface":"犀首","kind":"person","person_id":"cbr-p004035","status":"contextual_provisional"},{"id":"c-shiji-069-su:m039-0027","start":27,"end":29,"surface":"趙王","kind":"person","person_id":"cbr-p004028","status":"contextual_provisional"},{"id":"c-shiji-069-su:m039-0030","start":30,"end":32,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m039-0033","start":33,"end":35,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"},{"id":"c-shiji-069-su:m039-0045","start":45,"end":47,"surface":"蘇秦","kind":"person","person_id":"cbr-p004022","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"}],"sources":[{"chapter_id":"c-shiji-069-su","work_id":"w-shiji","book_id":"b-shiji-069","source_id":"s-shiji-069-su","source":{"title":"史記／卷069","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷069","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷069&oldid=2621145","revision_id":2621145,"accessed_on":"2026-10-09","extent":"67段正文，自蘇秦者至太史公論贊；排除ws-header弟名導覽與空段、後附索隱述贊及現代版權告示。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白。保留雒、衞、嘑、敎、㕹等原字及數位標點疑點，未按現代研究改寫時序。","note":"全67段已核讀，人物標註待逐段處理；未核底本、影像、出土縱橫家材料或現代研究。"}}}