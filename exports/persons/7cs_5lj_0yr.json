vent_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-116-xinanyi","source_id":"s-shiji116-xinanyi","paragraph_id":"c-shiji-116-xinanyi:p007","quote":"及至南越反，上使馳義侯因犍為發南夷兵。且蘭君恐遠行，旁國虜其老弱，乃與其眾反，殺使者及犍為太守。漢乃發巴蜀罪人嘗擊南越者八校尉擊破之。會越已破，漢八校尉不下，即引兵還，行誅頭蘭。頭蘭，常隔滇道者也。已平頭蘭，遂平南夷為牂柯郡。夜郎侯始倚南越，南越已滅，會還誅反者，夜郎遂入朝。上以為夜郎王。","person_mention_id":"c-shiji-116-xinanyi:m007-0040"}],"interpretation_note":"依明示殺或誅記個人死亡；頭蘭、且蘭國名及群體不另拆死亡人物。跨段未知紀年不補，死亡不自動終止所有稱號。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-116-xinanyi:m007-0040","start":40,"end":42,"surface":"使者","kind":"person","person_id":"7cs_5lj_0yr","status":"contextual_provisional","paragraph_id":"c-shiji-116-xinanyi:p007","chapter_id":"c-shiji-116-xinanyi"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-116-xinanyi:p007","text":"及至南越反，上使馳義侯因犍為發南夷兵。且蘭君恐遠行，旁國虜其老弱，乃與其眾反，殺使者及犍為太守。漢乃發巴蜀罪人嘗擊南越者八校尉擊破之。會越已破，漢八校尉不下，即引兵還，行誅頭蘭。頭蘭，常隔滇道者也。已平頭蘭，遂平南夷為牂柯郡。夜郎侯始倚南越，南越已滅，會還誅反者，夜郎遂入朝。上以為夜郎王。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-116-xinanyi:m007-0006","start":6,"end":7,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m007-0008","start":8,"end":11,"surface":"馳義侯","kind":"person","person_id":"dzl_mvt_l93","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m007-0019","start":19,"end":22,"surface":"且蘭君","kind":"person","person_id":"2u1_loj_let","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m007-0040","start":40,"end":42,"surface":"使者","kind":"person","person_id":"7cs_5lj_0yr","status":"contextual_provisional"},{"id":"c-shiji-116-xinanyi:m007-0043","start":43,"end":47,"surface":"犍為太守","kind":"person","person_id":"l36_ftl_d44","status