hiji-067-disciples"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["路","顏無繇","顏路"],"evidence":[{"paragraph_id":"c-shiji-067-disciples:p080","quote":"顏無繇字路。路者，顏回父，父子嘗各異時事孔子。"},{"paragraph_id":"c-shiji-067-disciples:p081","quote":"顏回死，顏路貧，請孔子車以葬。孔子曰：「材不材，亦各言其子也。鯉也死，有棺而無槨，吾不徒行以爲之槨，以吾從大夫之後，不可以徒行。」"}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-067-disciples:p080","text":"顏無繇字路。路者，顏回父，父子嘗各異時事孔子。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m080-0000","start":0,"end":3,"surface":"顏無繇","kind":"person","person_id":"cbr-p003919","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m080-0004","start":4,"end":5,"surface":"路","kind":"person","person_id":"cbr-p003919","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m080-0006","start":6,"end":7,"surface":"路","kind":"person","person_id":"cbr-p003919","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m080-0009","start":9,"end":11,"surface":"顏回","kind":"person","person_id":"cbr-p003862","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m080-0013","start":13,"end":15,"surface":"父子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m080-0020","start":20,"end":22,"surface":"孔子","kind":"person","person_id":"cbr-p003861","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p081","text":"顏回死，顏路貧，請孔子車以葬。孔子曰：「材不材，亦各言其子也。鯉也死，有棺而無槨，吾不徒行以爲之槨，以吾從大夫之後，不可以徒行。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-di