":"c-shiji-100-jibu:m008-0189","start":189,"end":191,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p008","chapter_id":"c-shiji-100-jibu"},{"id":"c-shiji-100-jibu:m008-0213","start":213,"end":215,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p008","chapter_id":"c-shiji-100-jibu"},{"id":"c-shiji-100-jibu:m008-0226","start":226,"end":228,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p008","chapter_id":"c-shiji-100-jibu"},{"id":"c-shiji-100-jibu:m008-0249","start":249,"end":251,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p008","chapter_id":"c-shiji-100-jibu"},{"id":"c-shiji-100-jibu:m008-0287","start":287,"end":289,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p008","chapter_id":"c-shiji-100-jibu"},{"id":"c-shiji-100-jibu:m011-0120","start":120,"end":122,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional","paragraph_id":"c-shiji-100-jibu:p011","chapter_id":"c-shiji-100-jibu"}],"relations":[],"title_holdings":[{"id":"th-shiji100-011","person_id":"j8g_yef_isr","title":"梁王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-100-jibu","source_id":"s-shiji-100-jibu","paragraph_id":"c-shiji-100-jibu:p007","quote":"欒布者，梁人也。始梁王彭越爲家人時，嘗與布游。窮困，賃傭於齊，爲酒人保。數歳，彭越去之巨野中爲盜，而布爲人所略賣，爲奴於燕。爲其家主報仇，燕將臧荼舉以爲都尉。臧荼後爲燕王，以布爲將。及臧荼反，漢撃燕，虜布。梁王彭越聞之，乃言上，請贖布以爲梁大夫。"}],"attestations":[{"id":"th-shiji100-011:a001","paragraph_id":"c-shiji-100-jibu:p007","start":9,"end":11,"surface":"梁王","person_mention_id":"c-shiji-100-jibu:m007-0011","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"用稱、實授與明示請贖分存；請贖布以爲梁大夫只存敘事，不冒作明示拜授。欲以季布爲御史大夫而見罷不作已任。死亡不自動終止官爵，兪侯保留本見證原字。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji100-026","person_id":"j8g_yef_isr","surfaces":["彭王","彭越","越"],"scope":"same_chapter","chapter_ids":["c-shiji-100-jibu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-100-jibu:p007","quote":"欒布者，梁人也。始梁王彭越爲家人時，嘗與布游。窮困，賃傭於齊，爲酒人保。數歳，彭越去之巨野中爲盜，而布爲人所略賣，爲奴於燕。爲其家主報仇，燕將臧荼舉以爲都尉。臧荼後爲燕王，以布爲將。及臧荼反，漢撃燕，虜布。梁王彭越聞之，乃言上，請贖布以爲梁大夫。"},{"paragraph_id":"c-shiji-100-jibu:p008","quote":"使於齊，未還，漢召彭越，責以謀反，夷三族。已而梟彭越頭於雒陽下，詔曰：「有敢收視者，輒捕之。」布從齊還，奏事彭越頭下，祠而哭之。吏捕布以聞。上召布，罵曰：「若與彭越反邪？吾禁人勿收，若獨祠而哭之，與越反明矣。趣亨之。」方提趣湯，布顧曰：「願一言而死。」上曰：「何言？」布曰：「方上之困於彭城，敗滎陽、成皋閒，項王所以（遂）不能［遂］西，徒以彭王居梁地，與漢合從苦楚也。當是之時，彭王一顧，與楚則漢破，與漢而楚破。且垓下之會，微彭王，項氏不亡。天下已定，彭王剖符受封，亦欲傳之萬世。今陛下一徵兵於梁，彭王病不行，而陛下疑以爲反，反形未見，以苛小案誅滅之，臣恐功臣人人自危也。今彭王已死，臣生不如死，請就亨。」於是上乃釋布罪，拜爲都尉。"},{"paragraph_id":"c-shiji-100-jibu:p011","quote":"太史公曰：以項羽之氣，而季布以勇顯於楚，身屨（典）軍搴旗者數矣，可謂壯士。然至被刑戮，爲人奴而不死，何其下也！彼必自負其材，故受辱而不羞，欲有所用其未足也，故終爲漢名將。賢者誠重其死。夫婢妾賤人感慨而自殺者，非能勇也，其計畫無復之耳。欒布哭彭越，趣湯如歸者，彼誠知所處，不自重其死。雖往古烈士，何以加哉！"}],"rationale":"依季布及欒布兩傳敘事承接，同名單字布分段處理；母弟詮釋有分歧，暫不定世系，長事弟畜不當血親，欲授未授不作實任。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-100-jibu:p007","text":"欒布者，梁人也。始梁王彭越爲家人時，嘗與布游。窮困，賃傭於齊，爲酒人保。數歳，彭越去之巨野中爲盜，而布爲人所略賣，爲奴於燕。爲其家主報仇，燕將臧荼舉以爲都尉。臧荼後爲燕王，以布爲將。及臧荼反，漢撃燕，虜布。梁王彭越聞之，乃言上，請贖布以爲梁大夫。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m007-0000","start":0,"end":2,"surface":"欒布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0011","start":11,"end":13,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0020","start":20,"end":21,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0039","start":39,"end":41,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0050","start":50,"end":51,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0063","start":63,"end":66,"surface":"其家主","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱或待辨匿名指代，不補成員。"},{"id":"c-shiji-100-jibu:m007-0071","start":71,"end":73,"surface":"臧荼","kind":"person","person_id":"0lb_ygj_t93","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0079","start":79,"end":81,"surface":"臧荼","kind":"person","person_id":"0lb_ygj_t93","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0087","start":87,"end":88,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0092","start":92,"end":94,"surface":"臧荼","kind":"person","person_id":"0lb_ygj_t93","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0101","start":101,"end":102,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0105","start":105,"end":107,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m007-0116","start":116,"end":117,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"}],"chapter_id":"c-shiji-100-jibu","book_id":"b-shiji-100","work_id":"w-shiji","source_id":"s-shiji-100-jibu"},{"id":"c-shiji-100-jibu:p008","text":"使於齊，未還，漢召彭越，責以謀反，夷三族。已而梟彭越頭於雒陽下，詔曰：「有敢收視者，輒捕之。」布從齊還，奏事彭越頭下，祠而哭之。吏捕布以聞。上召布，罵曰：「若與彭越反邪？吾禁人勿收，若獨祠而哭之，與越反明矣。趣亨之。」方提趣湯，布顧曰：「願一言而死。」上曰：「何言？」布曰：「方上之困於彭城，敗滎陽、成皋閒，項王所以（遂）不能［遂］西，徒以彭王居梁地，與漢合從苦楚也。當是之時，彭王一顧，與楚則漢破，與漢而楚破。且垓下之會，微彭王，項氏不亡。天下已定，彭王剖符受封，亦欲傳之萬世。今陛下一徵兵於梁，彭王病不行，而陛下疑以爲反，反形未見，以苛小案誅滅之，臣恐功臣人人自危也。今彭王已死，臣生不如死，請就亨。」於是上乃釋布罪，拜爲都尉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m008-0009","start":9,"end":11,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0024","start":24,"end":26,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0047","start":47,"end":48,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0054","start":54,"end":56,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0066","start":66,"end":67,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0072","start":72,"end":73,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0080","start":80,"end":82,"surface":"彭越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0099","start":99,"end":100,"surface":"越","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0114","start":114,"end":115,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0134","start":134,"end":135,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0154","start":154,"end":156,"surface":"項王","kind":"person","person_id":"cxt_wg1_9qm","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0170","start":170,"end":172,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0189","start":189,"end":191,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0213","start":213,"end":215,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0226","start":226,"end":228,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0249","start":249,"end":251,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0287","start":287,"end":289,"surface":"彭王","kind":"person","person_id":"j8g_yef_isr","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m008-0308","start":308,"end":309,"surface":"布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"}],"chapter_id":"c-shiji-100-jibu","book_id":"b-shiji-100","work_id":"w-shiji","source_id":"s-shiji-100-jibu"},{"id":"c-shiji-100-jibu:p011","text":"太史公曰：以項羽之氣，而季布以勇顯於楚，身屨（典）軍搴旗者數矣，可謂壯士。然至被刑戮，爲人奴而不死，何其下也！彼必自負其材，故受辱而不羞，欲有所用其未足也，故終爲漢名將。賢者誠重其死。夫婢妾賤人感慨而自殺者，非能勇也，其計畫無復之耳。欒布哭彭越，趣湯如歸者，彼誠知所處，不自重其死。雖往古烈士，何以加哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m011-0000","start":0,"end":3,"surface":"太史公","kind":"person","person_id":"nuz_py4_4la","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0006","start":6,"end":8,"surface":"項羽","kind":"person","person_id":"cxt_wg1_9qm","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0012","start":12,"end":14,"surface":"季布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0093","start":93,"end":97,"surface":"婢妾賤人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、合稱或待辨匿名指代，不補成員。"},{"id":"c-shiji-100-jibu:m011-0117","start":117,"end":119,"surface":"欒布","kind":"person","person_id":"jx9_cov_qe0","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m011-0120","start":120,"end":122,"surface":