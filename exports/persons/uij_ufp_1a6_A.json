gies-ws2371079","chapter_id":"c-nanqishu-052-jiayuan-genealogies","paragraph_id":"c-nanqishu-052-jiayuan-genealogies:p002","quote":"弼之","mention_id":"c-nanqishu-052-jiayuan-genealogies:p002:m0033"},{"mention_id":"c-nanqishu-052-later-literature-complete:p040:m0016","paragraph_id":"c-nanqishu-052-later-literature-complete:p040","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"弼之"},{"mention_id":"c-nanqishu-052-later-literature-complete:p043:m0013","paragraph_id":"c-nanqishu-052-later-literature-complete:p043","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"弼之"},{"mention_id":"c-nanqishu-052-later-literature-complete:p043:m0035","paragraph_id":"c-nanqishu-052-later-literature-complete:p043","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"弼之"}],"review":"ai_provisional","identity_note":"兩書同敘晉員外郎、太元收集譜、十八州及其子孫傳業。"},{"id":"uij_ufp_1a6_A","label":"賈匪之（譜家，賈弼之子）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"匪之","mention_ids":["c-nanshi-059-wangsengru:p007:m0425","c-nanshi-059-wangsengru:p007:m0428","c-nanqishu-052-jiayuan-genealogies:p001:m0023","c-nanqishu-052-later-literature-complete:p040:m0025"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p007","quote":"匪之","mention_id":"c-nanshi-059-wangsengru:p007:m0425"},{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p007","quote":"匪之","mention_id":"c-nanshi-059-wangsengru:p007:m0428"},{"work_id":"w-nanqishu","book_id":"b-nanqishu-052","source_id":"s-nanqishu-052-jiayuan-genealogies-ws2371079","chapter_id":"c-nanqishu-052-jiayuan-genealogies","paragraph_id":"c-nanqishu-052-jiayuan-genealogies:p001","quote":"匪之","mention_id":"c-nanqishu-052-jiayuan-genealogies:p001:m0023"},{"mention_id":"c-nanqishu-052-later-literature-complete:p040:m0025","paragraph_id":"c-nanqishu-052-later-literature-complete:p040","chapter_id":"c-nanqishu-052-later-literature-complete","quote":"匪之"}],"review":"ai_provisional","identity_note":"齊書載賈淵父驃騎參軍，南史載太宰參軍。宋書71僧綽門客同名，兩端未有直接接證。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"uij_ufp_1a6","source_assertion_id":"a-nanshi059-wangsengru-feizhi","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-059","source_id":"s-nanshi-059-wangsengru-ws1553912","chapter_id":"c-nanshi-059-wangsengru","paragraph_id":"c-nanshi-059-wangsengru:p007","quote":"轉北中郎諮議參軍，入直西省，知撰譜事。先是，尚書令沈約以為「晉咸和初，蘇峻作亂，文籍無遺。後起咸和二年以至於宋，所書並皆詳實，並在下省左戶曹前廂，謂之晉籍，有東西二庫。此籍既並精詳，實可寶惜，位宦高卑，皆可依案。宋元嘉二十七年，始以七條徵發，既立此科，人奸互起，偽狀巧籍，歲月滋廣。以至於齊，患其不實，於是東堂校籍，置郎令史以掌之。競行奸貨，以新換故，昨日卑細，今日便成士流。凡此奸巧，並出愚下，不辨年號，不識官階。或注隆安在元興之後，或以義熙在甯康之前。此時無此府，此時無此國。元興唯有三年，而猥稱四、五，詔書甲子，不與長曆相應。校籍諸郎亦所不覺，不才令史固自忘言。臣謂宋、齊二代，士庶不分，雜役減闕，職由於此。竊以晉籍所餘，宜加寶愛」。武帝以是留意譜籍，州郡多離其罪，因詔僧孺改定百家譜。始晉太元中，員外散騎侍郎平陽賈弼篤好簿狀，乃廣集眾家，大搜群族，所撰十八州一百一十六郡，合七百一十二卷。凡諸大品，略無遺闕，藏在秘閣，副在左戶。及弼子太宰參軍匪之、匪之子長水校尉深世傳其業。太保王弘、領軍將軍劉湛並好其書。弘日對千客，不犯一人之諱。湛為選曹，始撰百家以助銓序，而傷於寡略。齊衛將軍王儉復加去取，得繁省之衷。僧孺之撰，通范陽張等九族以代雁門解等九姓。其東南諸族別為一部，不在百家之數焉。普通二年卒。","subject_person_mention_id":"c-nanshi-059-wangsengru:p007:m0425","object_person_mention_id":"c-nanshi-059-wangsengru:p007:m0419"}],"status":"contextual_provisional","interpretation_note":"匪之為弼之子。","human_reviewed":false}},{"id":"uij_ufp_1a6_AA","label":"賈淵（字希鏡，南史作深）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"深","mention_ids":["c-nanshi-059-wangsengru:p007:m0435"]},{"surface":"賈淵","mention_ids":["c-nanqishu-052-jiayuan-genealogies:p001:m0000","c-nanqishu-052-later-literature-complete:p040:m0002"]},{"surface":"希鏡","mention_ids":["c-nanqishu-052-jiayuan-genealogies:p001:m0003","c-nanqishu-052-later-literature-complete:p040:m0005"]},{"surface":"淵","mention_ids":["c-nanqishu-052-jiayuan-genealogies:p002:m0009","c-nanqishu-052-jiayuan-genealogies:p002:m0053","c-nanqishu-052-jiayuan-ge