aph_id":"c-jinshu-039-wangxun-feng:xu-sons:p001","quote":"勖有十子，其達者輯、藩、組。"}],"qualifiers":{"lineage":"paternal","source_term":"勖有十子，其達者輯、藩、組。"},"interpretation_note":"其達者只是本段選列三人，不能據列舉順序填絕對排行；另七名未列者不造姓名。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu075-xunfan-cross-spelling","person_id":"yoo_ox0_545_FAAAA","surfaces":["籓","藩"],"scope":"cross_chapter","chapter_ids":["c-jinshu-039-wangxun-feng","c-jinshu-075-xunsong-families"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-039-wangxun-feng:xu-sons:p001:m0010","c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0079"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-039","chapter_id":"c-jinshu-039-wangxun-feng","source_id":"s-jinshu-039-wangxun-feng","paragraph_id":"c-jinshu-039-wangxun-feng:xu-sons:p001","quote":"勖有十子，其達者輯、藩、組。"},{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","quote":"王彌入洛，崧與百官奔於密，未至而母亡。賊追將及，同旅散走，崧被髮從車，守喪號泣。賊至，棄其母屍於地，奪車而去。崧被四創，氣絕，至夜方蘇。葬母於密山。服闋，族父籓承制，以崧監江北軍事、南中郎將、後將軍、假節、襄城太守。時山陵發掘，崧遣主簿石覽將兵入洛，修復山陵。以勳進爵舞陽縣公，遷都督荊州江北諸軍事、平南將軍，鎮宛，改封曲陵公。為賊杜曾所圍。石覽時為襄城太守，崧力弱食盡，使其小女灌求救于覽及南中郎將周訪。訪即遣子撫率兵三千人會石覽，俱救崧。賊聞兵至，散走。崧既得免，乃遣南陽中部尉王國、劉願等潛軍襲穰縣，獲曾從兄偽新野太守保，斬之。"}],"references":[{"title":"《晉書》卷三十九·荀藩傳","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷039&oldid=2108782","quote":"永嘉末，轉司空，未拜而洛陽陷沒，藩出奔密。","source_revision":2108782,"source_position":{"first_line":107,"last_line":107},"source_line_sha256":"a3e910b13913a6c26eaa0641b47c2b4d2406392db5ddb3da675db3accba44fd8","scope":"primary_cross_chapter_office_and_location_context","image_verified":false}],"rationale":"卷39荀勖子藩及其傳的永嘉末司空、洛陽陷沒後奔密，與卷75荀崧在洛陽亂後所依族父籓承制的時地及同族長輩身分交叉，暫作同一人。兩見證藩／籓原字分存；不把該字形套用到其他同名者，未核影像及全傳。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-039-wangxun-feng:xu-sons:p001","text":"勖有十子，其達者輯、藩、組。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-039-wangxun-feng:xu-sons:p001:m0000","start":0,"end":1,"surface":"勖","kind":"person","person_id":"yoo_ox0_545_FAAA","status":"contextual_provisional"},{"id":"c-jinshu-039-wangxun-feng:xu-sons:p001:m0008","start":8,"end":9,"surface":"輯","kind":"person","person_id":"yoo_ox0_545_FAAAB","status":"contextual_provisional"},{"id":"c-jinshu-039-wangxun-feng:xu-sons:p001:m0010","start":10,"end":11,"surface":"藩","kind":"person","person_id":"yoo_ox0_545_FAAAA","status":"contextual_provisional"},{"id":"c-jinshu-039-wangxun-feng:xu-sons:p001:m0012","start":12,"end":13,"surface":"組","kind":"person","person_id":"yoo_ox0_545_FAAAC","status":"contextual_provisional"}],"source_position":{"first_line":100,"last_line":100,"revision_id":2108782,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-039-wangxun-feng","book_id":"b-jinshu-039","work_id":"w-jinshu","source_id":"s-jinshu-039-wangxun-feng"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","text":"王彌入洛，崧與百官奔於密，未至而母亡。賊追將及，同旅散走，崧被髮從車，守喪號泣。賊至，棄其母屍於地，奪車而去。崧被四創，氣絕，至夜方蘇。葬母於密山。服闋，族父籓承制，以崧監江北軍事、南中郎將、後將軍、假節、襄城太守。時山陵發掘，崧遣主簿石覽將兵入洛，修復山陵。以勳進爵舞陽縣公，遷都督荊州江北諸軍事、平南將軍，鎮宛，改封曲陵公。為賊杜曾所圍。石覽時為襄城太守，崧力弱食盡，使其小女灌求救于覽及南中郎將周訪。訪即遣子撫率兵三千人會石覽，俱救崧。賊聞兵至，散走。崧既得免，乃遣南陽中部尉王國、劉願等潛軍襲穰縣，獲曾從兄偽新野太守保，斬之。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0000","start":0,"end":2,"surface":"王彌","kind":"person","person_id":"tyf_qc0_xq2","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0005","start":5,"end":6,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"}