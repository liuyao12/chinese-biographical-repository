{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"tgg_rko_ryw","canonical_person_id":"tgg_rko_ryw","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["tgg_rko_ryw"],"persons":[{"id":"tgg_rko_ryw","label":"李延年（平津侯主父列傳末段候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"李延年","mention_ids":["c-shiji-112-pingjin:m030-0257"]}],"evidence":[{"mention_id":"c-shiji-112-pingjin:m030-0257","chapter_id":"c-shiji-112-pingjin","paragraph_id":"c-shiji-112-pingjin:p030","quote":"李延年"}]}],"source_mention_summary":[{"source_id":"s-shiji112-pingjin","work_id":"w-shiji","book_id":"b-shiji-112","chapter_id":"c-shiji-112-pingjin","mention_count":1,"mention_ids":["c-shiji-112-pingjin:m030-0257"],"paragraph_ids":["c-shiji-112-pingjin:p030"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji112-pingjin"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-112-pingjin:m030-0257","start":257,"end":260,"surface":"李延年","kind":"person","person_id":"tgg_rko_ryw","status":"contextual_provisional","paragraph_id":"c-shiji-112-pingjin:p030","chapter_id":"c-shiji-112-pingjin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-112-pingjin:p030","text":"班固稱曰：公孫弘、卜式、兒寬皆以鴻漸之翼困於燕雀，遠跡羊豕之閒，非遇其時，焉能致此位乎？是時漢興六十餘載，海內乂安，府庫充實，而四夷未賓，制度多闕，上方欲用文武，求之如弗及。始以蒲輪迎枚生，見主父而嘆息。群臣慕向，異人并出。卜式試於芻牧，弘羊擢於賈豎，衛青奮於奴仆，日磾出於降虜，斯亦曩時版筑飯牛之朋矣。漢之得人，於茲為盛。儒雅則公孫弘、董仲舒、兒寬，篤行則石建、石慶，質直則汲黯、卜式，推賢則韓安國、鄭當時，定令則趙禹、張湯，文章則司馬遷、相如，滑稽則東方朔、枚皋，應對則嚴助、朱買臣，歷數則唐都、落下閎，協律則李延年，運籌則桑弘羊，奉使則張騫、蘇武，將帥則衛青、霍去病，受遺則霍光、金日磾。其餘不可勝紀。是以興造功業，制度遺文，後世莫及。孝宣承統，纂修洪業，亦講論六藝，招選茂異，而蕭望之、梁丘賀、夏侯勝、韋玄成、嚴彭祖、尹更始以儒術進，劉向、王褒以文章顯。將相則張安世、趙充國、魏相、邴吉、于定國、杜延年，治民則黃霸、王成、龔遂、鄭弘、邵信臣、韓延壽、尹翁歸、趙廣漢之屬，皆有功跡見述於後。累其名臣，亦其次也。","annotation_status":"in_progress","text_layer":"witness_appended_bangu_note","mentions":[{"id":"c-shiji-112-pingjin:m030-0000","start":0,"end":2,"surface":"班固","kind":"person","person_id":"9z0_8lu_63q","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0005","start":5,"end":8,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0009","start":9,"end":11,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0012","start":12,"end":14,"surface":"兒寬","kind":"person","person_id":"y7w_938_ch8","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0074","start":74,"end":75,"surface":"上","kind":"person","person_id":"a05_brz_8xe","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0092","start":92,"end":94,"surface":"枚生","kind":"person","person_id":"3ce_wh3_q9a","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0096","start":96,"end":98,"surface":"主父","kind":"person","person_id":"vbr_ff1_yc4","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0112","start":112,"end":114,"surface":"卜式","kind":"person","person_id":"h6s_hqj_u6k","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0119","start":119,"end":121,"surface":"弘羊","kind":"person","person_id":"fi2_2cl_w22","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0126","start":126,"end":128,"surface":"衛青","kind":"person","person_id":"ges_7zm_vut","status":"contextual_provisional"},{"id":"c-shiji-112-pingjin:m030-0133","start":133,"end":135,"surface":"日磾","kind":"person","person_id":"6tp_ke1_h68","