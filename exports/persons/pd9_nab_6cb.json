complete:p009:m0211","mention_ids":["c-sanguozhi-049-liuyou-complete:p009:m0211"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-049-liuyou-complete-ws2075209"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-wu049-liuji-brother-pd9_nab_6cb","subject_person_id":"pd9_nab_6cb","object_person_id":"0l7_5ov_1hf","predicate":"brother","qualifiers":{"source_term":"基二弟，鑠、尚"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-049","chapter_id":"c-sanguozhi-049-liuyou-complete","source_id":"s-sanguozhi-049-liuyou-complete-ws2075209","paragraph_id":"c-sanguozhi-049-liuyou-complete:p009","quote":"　　繇長子基，字敬輿。年十四，居繇喪盡禮，故吏饋餉，皆無所受。姿容美好，孫權愛敬之。權為驃騎將軍，辟東曹掾，拜輔義校尉、建忠中郎將。權為吳王，遷基大農。權嘗宴飲，騎都尉虞翻醉酒犯忤，權欲殺之，威怒甚盛，由基諫爭，翻以得免。權大暑時，嘗於船中宴飲，於船樓上值雷雨，權以蓋自覆，又命覆基，餘人不得也。其見待如此。徙郎中令。權稱尊號，改為光祿勳，分平尚書事。年四十九卒。後權為子霸納基女，賜第一區。四時寵賜，與全、張比。基二弟，鑠、尚，皆騎都尉。","subject_person_mention_id":"c-sanguozhi-049-liuyou-complete:p009:m0211","object_person_mention_id":"c-sanguozhi-049-liuyou-complete:p009:m0005"}],"status":"source_attested","interpretation_note":"據基二弟並稱。二人同為騎都尉。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-049-l