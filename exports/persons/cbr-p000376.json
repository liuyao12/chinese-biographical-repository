h_id":"c-shiji-005-qin:p037","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-039-jin:m034-0213","start":213,"end":216,"surface":"百里奚","kind":"person","person_id":"cbr-p000376","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p034","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m044-0014","start":14,"end":17,"surface":"百里奚","kind":"person","person_id":"cbr-p000376","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p044","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m044-0018","start":18,"end":21,"surface":"百里奚","kind":"person","person_id":"cbr-p000376","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p044","chapter_id":"c-shiji-039-jin"}],"relations":[{"id":"a-shiji005-045","subject_person_id":"cbr-p000392","predicate":"father","object_person_id":"cbr-p000376","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-005-qin:p032","quote":"百里傒子孟明視","chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存本文明示親屬主張；母弟原詞保留，不另補母親姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji005-015","person_id":"cbr-p000376","surfaces":["百里傒","傒"],"scope":"same_chapter","chapter_ids":["c-shiji-005-qin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p027","quote":"晉旱，來請粟。丕豹說繆公勿與，因其饑而伐之。繆公問公孫支，支曰：「饑穰更事耳，不可不與。」問百里傒，傒曰：「夷吾得罪於君，其百姓何罪？」於是用百里傒、公孫支言，卒與之粟。以船漕車轉，自雍相望至絳。"}],"rationale":"依本卷同一敘事中的明示稱號、即位說明或短稱暫定；不作全庫字串匹配。穆／繆的通用關係只據此卷的繼立敘事判讀。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-049","person_id":"cbr-p000376","surfaces":["百里奚"],"scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-005-qin:p022","quote":"五年，晉獻公滅虞、虢，虜虞君與其大夫百里傒，以璧馬賂於虞故也。既虜百里傒，以為秦繆公夫人媵於秦。百里傒亡秦走宛，楚鄙人執之。繆公聞百里傒賢，欲重贖之，恐楚人不與，乃使人謂楚曰：「吾媵臣百里傒在焉，請以五羖羊皮贖之。」。楚人遂許與之。當是時，百里傒年已七十餘。繆公釋其囚，與語國事。謝曰：「臣亡國之臣，何足問！」繆公曰：「虞君不用子，故亡，非子罪也。」固問，語三日，繆公大說，授之國政，號曰五羖大夫。百里傒讓曰：「臣不及臣友蹇叔，蹇叔賢而世莫知。臣常游困於齊而乞食銍人，蹇叔收臣。臣因而欲事齊君無知，蹇叔止臣，臣得脫齊難，遂之周。周王子穨好牛，臣以養牛干之。及穨欲用臣，蹇叔止臣，臣去，得不誅。事虞君，蹇叔止臣。臣知虞君不用臣，臣誠私利祿爵，且留。再用其言，得脫，一不用，及虞君難：是以知其賢。」於是繆公使人厚幣迎蹇叔，以為上大夫。"},{"paragraph_id":"c-shiji-039-jin:p034","quote":"是歳也，晉復假道於虞以伐虢。虞之大夫宮之奇諫虞君曰：「晉不可假道也，是且滅虞。」虞君曰：「晉我同姓，不宜伐我。」宮之奇曰：「太伯、虞仲，太王之子也，太伯亡去，是以不嗣。虢仲、虢叔，王季之子也，爲文王卿士，其記勳在王室，藏於盟府。將虢是滅，何愛于虞？且虞之親能親於桓、莊之族乎？桓、莊之族何罪，盡滅之。虞之與虢，脣之與齒，脣亡則齒寒。」虞公不聽，遂許晉。宮之奇以其族去虞。其冬，晉滅虢，虢公丑奔周。還，襲滅虞，虜虞公及其大夫井伯百里奚以媵秦穆姬，而修虞祀。荀息牽曩所遺虞屈産之乘馬奉之獻公，獻公笑曰：「馬則吾馬，齒亦老矣！」"},{"paragraph_id":"c-shiji-039-jin:p044","quote":"四年，晉饑，乞糴於秦。繆公問百里奚，百里奚曰：「天菑流行，國家代有，救菑恤鄰，國之道也。與之。」邳鄭子豹曰：「伐之。」繆公曰：「其君是惡，其民何罪！」卒與粟，自雍屬絳。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p022","text":"五年，晉獻公滅虞、虢，虜虞君與其大夫百里傒，以璧馬賂於虞故也。既虜百里傒，以為秦繆公夫人媵於秦。百里傒亡秦走宛，楚鄙人執之。繆公聞百里傒賢，欲重贖之，恐楚人不與，乃使人謂楚曰：「吾媵臣百里傒在焉，請以五羖羊皮贖之。」。楚人遂許與之。當是時，百里傒年已七十餘。繆公釋其囚，與語國事。謝曰：「臣亡國之臣，何足問！」繆公曰：「虞君不用子，故亡，非子罪也。」固問，語三日，繆公大說，授之國政，號曰五羖大夫。百里傒讓曰：「臣不及臣友蹇叔，蹇叔賢而世莫知。臣常游困於齊而乞食銍人，蹇叔收臣。臣因而欲事齊君無知，蹇叔止臣，臣得脫齊難，遂之周。周王子穨好牛，臣以養牛干之。及穨欲用臣，蹇叔止臣，臣去，得不誅。事虞君，蹇叔止臣。臣知虞君不用臣，臣誠私利祿爵，且留。再用其言，得脫，一不用，及虞君難：是以知其賢。」於是繆公使人厚幣迎蹇叔，以為上大夫。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m022-0003","start":3,"end":6,"surface":"晉獻公","kind":"person","person_id":"cbr-p000374","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m022-0012","start":12,"end":14,"surface":"虞君","kind":"person","person_id":"cbr-p000375","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m022-0018","start":18,"end":21,"surface":"百里傒","kind":"person","person_id":"cbr-p000376","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m022-0033","start":33,"end":36,"surface":"百里傒","kind":"person","person_id":"cbr-p000376","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m022-0040","start":40,"end":42,"surface":"繆公","kind":"person","person_id":"cbr-