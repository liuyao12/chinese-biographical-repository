jin:m034-0218","start":218,"end":221,"surface":"秦穆姬","kind":"person","person_id":"cbr-p000391","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0227","start":227,"end":229,"surface":"荀息","kind":"person","person_id":"cbr-p000382","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p044","text":"四年，晉饑，乞糴於秦。繆公問百里奚，百里奚曰：「天菑流行，國家代有，救菑恤鄰，國之道也。與之。」邳鄭子豹曰：「伐之。」繆公曰：「其君是惡，其民何罪！」卒與粟，自雍屬絳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m044-0011","start":11,"end":13,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m044-0014","start":14,"end":17,"surface":"百里奚","kind":"person","person_id":"cbr-p000376","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m044-0018","start":18,"end":21,"surface":"百里奚","kind":"person","person_id":"cbr-p000376","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m044-0029","start":29,"end":31,"surface":"國家","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m044-0048","start":48,"end":52,"surface":"邳鄭子豹","kind":"person","person_id":"cbr-p000387","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m044-0059","start":59,"end":61,"surface":"繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"}],"sources":[{"chapter_id":"c-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","source_id":"s-shiji-005-qin","source":{"title":"史記／卷005","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷005","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷005&oldid=8744286","revision_id":8744286,"accessed_on":"2026-10-09","extent":"77段數位正文；排除註釋版導覽與註號，見證行內校勘符號暫原樣保留。","