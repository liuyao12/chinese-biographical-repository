i-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p031","quote":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji037-045","person_id":"cbr-p001428","surfaces":["殤公"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-037-wei"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p031","quote":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。"},{"paragraph_id":"c-shiji-037-wei:p012","quote":"宣公七年，魯弒其君隱公。九年，宋督弒其君殤公，及孔父。十年，晉曲沃莊伯弒其君哀侯。"}],"rationale":"宋督弒殤公、孔父的具體同一事件，與管蔡篇宋華父督弒殤公及大夫孔父相接；保留宋督的本篇字形，不按督字全域合併。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji038-046","person_id":"cbr-p001428","surfaces":["殤公"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p031","quote":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。"},{"paragraph_id":"c-shiji-038-song:p029","quote":"穆公九年，病，召大司馬孔父謂曰：「先君宣公捨太子與夷而立我，我不敢忘。我死，必立與夷也。」孔父曰：「羣臣皆願立公子馮。」穆公曰：「毋立馮，吾不可以負宣公。」於是穆公使馮出居于鄭。八月庚辰，穆公卒，兄宣公子與夷立，是爲殤公。君子聞之，曰：「宋宣公可謂知人矣，立其弟以成義，然卒其子復享之。"},{"paragraph_id":"c-shiji-038-song:p030","quote":"殤公元年，衛公子州吁弒其君完自立，欲得諸矦，使告於宋曰：「馮在鄭，必爲亂，可與我伐之。」宋許之，與伐鄭，至東門而還。二年，鄭伐宋，以報東門之役。其後諸矦數來侵伐。"},{"paragraph_id":"c-shiji-038-song:p031","quote":"九年，大司馬孔父嘉妻好，出，道遇太宰華督，督說，目而觀之。督利孔父妻，乃使人宣言國中曰：「殤公即位十年耳，而十一戰，民苦不堪，皆孔父爲之，我且殺孔父以寧民。」是歲，魯弒其君隱公。十年，華督攻殺孔父，取其妻。殤公怒，遂弒殤公，而迎穆公子馮於鄭而立之，是爲莊公。"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji038-067","person_id":"cbr-p001635","surfaces":["太子與夷","與夷"],"scope":"same_chapter","chapter_ids":["c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-038-song:p028","quote":"宣公有太子與夷。十九年，宣公病，讓其弟和，曰：「父死子繼，兄死弟及，天下通義也。我其立和。」和亦三讓而受之。宣公卒，弟和立，是爲穆公。"},{"paragraph_id":"c-shiji-038-song:p029","quote":"穆公九年，病，召大司馬孔父謂曰：「先君宣公捨太子與夷而立我，我不敢忘。我死，必立與夷也。」孔父曰：「羣臣皆願立公子馮。」穆公曰：「毋立馮，吾不可以負宣公。」於是穆公使馮出居于鄭。八月庚辰，穆公卒，兄宣公子與夷立，是爲殤公。君子聞之，曰：「宋宣公可謂知人矣，立其弟以成義，然卒其子復享之。"}],"rationale":"本篇宣公太子與夷被穆公復立為殤公的明示敘事，與既有殤公兩個已發ID保留，另存eq-shiji038-yuyi-shang來源明示同指決定，以較早ID為組裝代表，不重指錨點。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji038-yuyi-shang","person_ids":["cbr-p001428","cbr-p001635"],"canonical_person_id":"cbr-p001428","scope":"same_chapter","chapter_ids":["c-shiji-038-song"],"status":"source_explicit","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p029","quote":"八月庚辰，穆公卒，兄宣公子與夷立，是爲殤公。","mention_ids":["c-shiji-038-song:m029-0102","c-shiji-038-song:m029-0108"]}],"rationale":"本篇明示宣公子與夷立，是為殤公，兩個已發ID保存，以較早殤公ID為組裝代表；不改舊提及、別稱、親屬主張或殤字的全域映射。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-035-guancai:p031","text":"桓公三十五年，魯隱公立。四十五年，魯弒其君隱公。四十六年，宋華父督弒其君殤公，及孔父。五十五年，桓公卒，子莊公夕姑立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m031-0000","start":0,"end":2,"surface":"桓公","kind":"person","person_id":"cbr-p001426","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m031-0007","start":7,"end":10,"surface":"魯隱公","kind":"person","person_id":"cbr-p000225","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m031-0017","start":17,"end":18,"surface":"魯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定稱呼、國別指代或數位校勘字樣；不補人名、成員與闕代。"},{"id":"c-shiji-035-guancai:m031-0021","start":21,"end":23,"surface":"隱公","kind":"person","person_id":"cbr-p000225","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m031-0029","start":29,"end":33,"surface":"宋華父督","kind":"person","person_id":"cbr-p001427","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m031-0036","start":36,"end":38,"surface":"殤公","kind":"person","pers