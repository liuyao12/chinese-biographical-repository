erson_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0135","start":135,"end":137,"surface":"去齊","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0139","start":139,"end":141,"surface":"去齊","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0144","start":144,"end":146,"surface":"壽夢","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m003-0148","start":148,"end":150,"surface":"壽夢","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-031-wu","book_id":"b-shiji-031","work_id":"w-shiji","source_id":"s-shiji-031-wu"},{"id":"c-shiji-039-jin:p034","text":"是歳也，晉復假道於虞以伐虢。虞之大夫宮之奇諫虞君曰：「晉不可假道也，是且滅虞。」虞君曰：「晉我同姓，不宜伐我。」宮之奇曰：「太伯、虞仲，太王之子也，太伯亡去，是以不嗣。虢仲、虢叔，王季之子也，爲文王卿士，其記勳在王室，藏於盟府。將虢是滅，何愛于虞？且虞之親能親於桓、莊之族乎？桓、莊之族何罪，盡滅之。虞之與虢，脣之與齒，脣亡則齒寒。」虞公不聽，遂許晉。宮之奇以其族去虞。其冬，晉滅虢，虢公丑奔周。還，襲滅虞，虜虞公及其大夫井伯百里奚以媵秦穆姬，而修虞祀。荀息牽曩所遺虞屈産之乘馬奉之獻公，獻公笑曰：「馬則吾馬，齒亦老矣！」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m034-0018","start":18,"end":21,"surface":"宮之奇","kind":"person","person_id":"nu4_0wz_9o2","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0022","start":22,"end":24,"surface":"虞君","kind":"person","person_id":"2en_16a_r4i","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0040","start":40,"end":42,"surface":"虞君","kind":"person","person_id":"2en_16a_r4i","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0056","start":56,"end":59,"surface":"宮之奇","kind":"person","person_id":"nu4_0wz_9o2","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-0062","start":62,"end":64,"surface":"太伯","kind":"person","person_id":"5dm_e40_rqh_B","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m034-006