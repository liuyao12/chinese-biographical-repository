m0035","object_person_mention_id":"c-nanqishu-020-chendaozhi:p002:m0026"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"庶生二子同繫宣帝。兩書明載陳后生高帝。"}}],"source_mention_summary":[{"source_id":"s-nanqishu-002-chendaozhi-zhuizun-ws2312009","work_id":"w-nanqishu","book_id":"b-nanqishu-002","chapter_id":"c-nanqishu-002-chendaozhi-zhuizun","raw_mention_count":1,"mention_ids":["c-nanqishu-002-chendaozhi-zhuizun:p002:m0005"],"paragraph_ids":["c-nanqishu-002-chendaozhi-zhuizun:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-002-chendaozhi-zhuizun:p002:m0005","mention_ids":["c-nanqishu-002-chendaozhi-zhuizun:p002:m0005"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanqishu-020-chendaozhi-ws2074177","work_id":"w-nanqishu","book_id":"b-nanqishu-020","chapter_id":"c-nanqishu-020-chendaozhi","raw_mention_count":1,"mention_ids":["c-nanqishu-020-chendaozhi:p002:m0035"],"paragraph_ids":["c-nanqishu-020-chendaozhi:p002"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-020-chendaozhi:p002:m0035","mention_ids":["c-nanqishu-020-chendaozhi:p002:m0035"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-nanqishu-020-chendaozhi-wyd","work_id":"w-nanqishu","book_id":"b-nanqishu-020","chapter_id":"c-nanqishu-020-chendaozhi-wyd","raw_mention_count":1,"mention_ids":["c-nanqishu-020-chendaozhi-wyd:p002:m0029"],"paragraph_ids":["c-nanqishu-020-chendaozhi-wyd:p002"],"table_cell_ids":[],"occurrence_groups":[{"canoni