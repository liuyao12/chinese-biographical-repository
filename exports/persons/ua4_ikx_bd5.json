眾圍朐山，戍主玄元度嬰城固守。青冀二州刺史盧紹之遣子奐領兵助之。城中無食，紹之出頓州南石頭亭，隔海運糧柴供給城內。虜圍斷海道，緣岸攻城，會潮水大至，虜渰溺，元度出兵奮擊，大破之。臺遣軍主崔靈建、楊法持、房靈民萬餘人從淮入海，船艦至夜各舉兩火，虜眾望見，謂是南軍大至，一時奔退。","reading":"朐山主玄元度守城，盧紹之調運，遣子奐。援軍另有楊法持等，前卷已有其獨立附傳。","note":"朐山主玄元度守城，盧紹之調運，遣子奐。援軍另有楊法持等，前卷已有其獨立附傳。","paragraph_id":"c-nanqishu-057-northern-wei-complete:p011","start_codepoint":0,"end_codepoint":163,"human_reviewed":false,"chapter_id":"c-nanqishu-057-northern-wei-complete","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p011:m0032","start":32,"end":35,"surface":"玄元度","kind":"person","person_id":"ua4_ikx_bd5","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p011","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p011:m0103","start":103,"end":105,"surface":"元度","kind":"person","person_id":"ua4_ikx_bd5","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p011","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p012:m0002","start":2,"end":4,"surface":"元度","kind":"person","person_id":"ua4_ikx_bd5","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p012","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p012:m0029","start":29,"end":31,"surface":"元度","kind":"person","person_id":"ua4_ikx_bd5","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p012","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p012:m0053","start":53,"end":55,"surface":"元度","kind":"person","person_id":"ua4_ikx_bd5","status":"