1:m0046","start":46,"end":49,"surface":"盧紹之","kind":"person","person_id":"tze_8ng_ef5","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p011:m0051","start":51,"end":52,"surface":"奐","kind":"person","person_id":"qu3_uh2_995","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p011:m0062","start":62,"end":64,"surface":"紹之","kind":"person","person_id":"tze_8ng_ef5","status":"contextual_provisional"},{"id":"c-nanqishu-057-northern-wei-complete:p011:m0103","start":103,"end":105,"surface":"元度","kind":"person","person_id":"ua4_ikx_bd5","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-057-northern-wei-complete","book_id":"b-nanqishu-057","work_id":"w-nanqishu","source_id":"s-nanqishu-057-northern-wei-complete-ws1999801"},{"id":"c-nanqishu-057-northern-wei-complete:p012","text":"初，元度自云臂上有封侯志，宋世以示世祖，時世祖在東宮，書與元度曰：「努力成臂上之相也。」虜退，上議加封爵，元度歸功於紹之，紹之又讓，故竝見寢。上乃擢紹之為黃門郎。鬱州呼石頭亭為平虜亭。紹之字子緒，范陽人，自云盧諶玄孫。宋大明中，預攻廣陵，勳上，紹之拔迹自投，上以為州治中，受心腹之任。官至光祿大夫。永明八年，卒。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":32,"last_line":32,"raw_start":2612,"raw_end":2775,"raw_character_offsets":[2612,2613,2614,2615,2616,2617,2618,2619,2620,2621,2622,2623,2624,2625,2626,2627,2628,2629,2630,2631,2632,2633,2634,2635,2636,2637,2638,2639,2640,2641,2642,2643,2644,2645,2646,2647,2648,2649,2650,2651,2652,2653,2654,2655,2656,2657,2658,2659,2660,2661,2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2766,2767,2768,2769,2772,2773,2774],"revision_id":1999801},"mentions":[{"id":