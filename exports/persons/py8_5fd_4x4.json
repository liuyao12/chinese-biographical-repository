hu-023-wangyang-complete:p001","quote":"王瑒字子璵，司空沖之第十二子也。沈靜有器局，美風儀，舉止醞藉。梁大同中，起家祕書郎，遷太子洗馬。元帝承制，徵為中書侍郎，直殿省，仍掌相府管記。出為東宮內史，遷太子中庶子。丁所生母憂，歸于丹陽。江陵陷，梁敬帝承制，除仁威將軍、尚書吏部郎中。貞陽侯僭位，以敬帝為太子，授瑒散騎常侍，侍東宮。尋遷長（史）兼侍中。","subject_person_mention_id":"c-chenshu-023-wangyang-complete:p001:m0000","object_person_reference_id":"c-chenshu-023-wangyang-complete:p001:r0086"}],"status":"source_attested","interpretation_note":"傳首具名王瑒，下文丁所生母憂。未載母名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[],"relations":[{"id":"a-chen023-yang-mother","subject_person_id":"7r6_k52_qji_ABAAAAAABAAA","object_person_id":"py8_5fd_4x4","predicate":"mother","qualifiers":{"source_term":"丁所生母憂","reading_basis":{"kind":"chen023_wangyang_birth_mother","relationship_anchor":{"paragraph_id":"c-chenshu-023-wangyang-complete:p001","start":86,"end":89,"surface":"所生母"}}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-023","chapter_id":"c-chenshu-023-wangyang-complete","source_id":"s-chenshu-023-wangyang-complete-ws1514496","paragraph_id":"c-chenshu-023-wangyang-complete:p001","quote":"王瑒字子璵，司空沖之第十二子也。沈靜有器局，美風儀，舉止醞藉。梁大同中，起家祕書郎，遷太子洗馬。元帝承制，徵為中書侍郎，直殿省，仍掌相府管記。出為東宮內史，遷太子中庶子。丁所生母憂，歸于丹陽。江陵陷，梁敬帝承制，除仁威將軍、尚書吏部郎中。貞陽侯僭位，以敬帝為太子，授瑒散騎常侍，侍東宮。尋遷長（史）兼侍中。","subject_person_mention_id":"c-chenshu-023-wangyang-complete:p001:m0000","object_person_reference_id":"c-chenshu-023-wangyang-complete:p001:r0086"}],"status":"source_attested","interpretation_note":"傳首具名王瑒，下文丁所生母憂。未載母名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-chenshu-023-wangyang-complete:p001:r0086","paragraph_id":"c-chenshu-023-wangyang-complete:p001","start":86,"end":89,"surface":"所生母","person_id":"py8_5fd_4x4","referent_role":"third_person","quote":"王瑒字子璵，司空沖之第十二子也。沈靜有器局，美風儀，舉止醞藉。梁大同中，起家祕書