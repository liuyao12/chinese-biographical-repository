sertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji012-016","person_id":"cbr-p000585","surfaces":["羨門"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-012-wudi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p039","quote":"三十二年，始皇之碣石，使燕人盧生求羨門、高誓。刻碣石門。壞城郭，決通隄防。其辭曰："},{"paragraph_id":"c-shiji-012-wudi:p017","quote":"其春，樂成侯上書言欒大。欒大，膠東宮人，故嘗與文成將軍同師，已而為膠東王尚方。而樂成侯姊為康王后，毋子。康王死，他姬子立為王。而康后有淫行，與王不相中（得），相危以法。康后聞文成已死，而欲自媚於上，乃遣欒大因樂成侯求見言方。天子既誅文成，後悔恨其早死，惜其方不盡，及見欒大，大悅。大為人長美，言多方略，而敢為大言，處之不疑。大言曰：「臣嘗往來海中，見安期、羨門之屬。顧以為臣賤，不信臣。又以為康王諸侯耳，不足予方。臣數言康王，康王又不用臣。臣之師曰：『黃金可成，而河決可塞，不死之藥可得，僊人可致也。』臣恐效文成，則方士皆掩口，惡敢言方哉！」上曰：「文成食馬肝死耳。子誠能修其方，我何愛乎！」大曰：「臣師非有求人，人者求之。陛下必欲致之，則貴其使者，令有親屬，以客禮待之，勿卑，使各佩其信印，乃可使通言於神人。神人尚肯邪不邪。致尊其使，然後可致也。」於是上使先驗小方，鬬旗，旗自相觸擊。"}],"rationale":"依本篇封禪、方士、授官與神異引語的明示語境判讀異稱；神祇或傳說不轉為已確證生平，跨篇同指仍待版本與專門研究核對。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p039","text":"三十二年，始皇之碣石，使燕人盧生求羨門、高誓。刻碣石門。壞城郭，決通隄防。其辭曰：","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p039:m0005","start":5,"end":7,"surface":"始皇","kind":"person","person_id":"cbr-p000533","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0012","start":12,"end":16,"surface":"燕人盧生","kind":"person","person_id":"cbr-p000584","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0017","start":17,"end":19,"surface":"羨門","kind":"person","person_id":"cbr-p000585","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0020","start":20,"end":22,"surface":"高誓","kind":"person","person_id":"cbr-p000586","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-012-wudi:p017","text":"其春，樂成侯上書言欒大。欒大，膠東宮人，故嘗與文成將軍同師，已而為膠東王尚方。而樂成侯姊為康王后，毋子。康王死，他姬子立為王。而康后有淫行，與王不相中（得），相危以法。康后聞文成已死，而欲自媚於上，乃遣欒大因樂成侯求見言方。天子既誅文成，後悔恨其早死，惜其方不盡，及見欒大，大悅。大為人長美，言多方略，而敢為大言，處之不疑。大言曰：「臣嘗往來海中，見安期、羨門之屬。顧以為臣賤，不信臣。又以為康王諸侯耳，不足予方。臣數言康王，康王又不用臣。臣之師曰：『黃金可成，而河決可塞，不死之藥可得，僊人可致也。』臣恐效文成，則方士皆掩口，惡敢言方哉！」上曰：「文成食馬肝死耳。子誠能修其方，我何愛乎！」大曰：「臣師非有求人，人者求之。陛下必欲致之，則貴其使者，令有親屬，以客禮待之，勿卑，使各佩其信印，乃可使通言於神人。神人尚肯邪不邪。致尊其使，然後可致也。」於是上使先驗小方，鬬旗，旗自相觸擊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m017-0003","start":3,"end":6,"surface":"樂成侯","kind":"person","person_id":"cbr-p000986","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0009","start":9,"end":11,"surface":"欒大","kind":"person","person_id":"cbr-p000987","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0012","start":12,"end":14,"surface":"欒大","kind":"person","person_id":"cbr-p000987","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0023","start":23,"end":27,"surface":"文成將軍","kind":"person","person_id":"cbr-p000982","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0033","start":33,"end":36,"surface":"膠東王","kind":"person","person_id":"cbr-p000989","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0040","start":40,"end":43,"surface":"樂成侯","kind":"person","person_id":"cbr-p000986","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0045","start":45,"end":48,"surface":"康王后","kind":"person","person_id":"cbr-p000988","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0052","start":52,"end":54,"surface":"康王","kind":"person","person_id":"cbr-p000989","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0056","start":56,"end":59,"surface":"他姬子","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m017-0064","start":64,"end":66,"surface":"康后","kind":"person","person_id":"cbr-p000988","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0084","start":84,"end":86,"surface":"康后","kind":"person","person_id":"cbr-p000988"