{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005382","identity_policy":"contextual_provisional","person_ids":["cbr-p005382"],"persons":[{"id":"cbr-p005382","label":"紂（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"紂","mention_ids":["c-shiji-096-zhang:m005-0069"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m005-0069","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p005","quote":"紂"}]}],"mentions":[{"id":"c-shiji-096-zhang:m005-0069","start":69,"end":70,"surface":"紂","kind":"person","person_id":"cbr-p005382","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p005","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-024","person_id":"cbr-p005382","surfaces":["紂"],"scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-096-zhang:p005","quote":"昌為人彊力，敢直言，自蕭、曹等皆卑下之。昌嘗燕時入奏事，高帝方擁戚姬，昌還走，高帝逐得，騎周昌項，問曰：「我何如主也？」昌仰曰：「陛下即桀紂之主也。」於是上笑之，然尤憚周昌。及帝欲廢太子，而立戚姬子如意為太子，大臣固爭之，莫能得；上以留侯策即止。而周昌廷爭之彊，上問其說，昌為人吃，又盛怒，曰：「臣口不能言，然臣期期知其不可。陛下雖欲廢太子，臣期期不奉詔。」上欣然而笑。既罷，呂后側耳於東箱聽，見周昌，為跪謝曰：「微君，太子幾廢。」"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p005","text":"昌為人彊力，敢直言，自蕭、曹等皆卑下之。昌嘗燕時入奏事，高帝方擁戚姬，昌還走，高帝逐得，騎周昌項，問曰：「我何如主也？」昌仰曰：「陛下即桀紂之主也。」於是上笑之，然尤憚周昌。及帝欲廢太子，而立戚姬子如意為太子，大臣固爭之，莫能得；上以留侯策即止。而周昌廷爭之彊，上問其說，昌為人吃，又盛怒，曰：「臣口不能言，然臣期期知其不可。陛下雖欲廢太子，臣期期不奉詔。」上欣然而笑。既罷，呂后側耳於東箱聽，見周昌，為跪謝曰：「微君，太子幾廢。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m005-0000","start":0,"end":1,"surface":"昌","kind":"person","person_id":"cbr-p005370","status":"context