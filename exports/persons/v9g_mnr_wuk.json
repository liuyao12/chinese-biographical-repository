_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-064-zhugeke-complete:p003:m0223","surface":"範慎","start":223,"end":225,"kind":"person","person_id":"v9g_mnr_wuk","status":"contextual_provisional","paragraph_id":"c-sanguozhi-064-zhugeke-complete:p003","chapter_id":"c-sanguozhi-064-zhugeke-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-064-zhugeke-complete:p003","text":"恪別傳曰：權嘗饗蜀使費禕，先逆敕群臣：「使至，伏食勿起。」禕至，權為輟食，而群下不起。禕啁之曰：「鳳皇來翔，騏驎吐哺，驢騾無知，伏食如故。」恪答曰：「爰植梧桐，以待鳳皇，有何燕雀，自稱來翔？何不彈射，使還故鄉！」禕停食餅，索筆作麥賦，恪亦請筆作磨賦，咸稱善焉。權嘗問恪：「頃何以自娛，而更肥澤？」恪對曰：「臣聞富潤屋，德潤身，臣非敢自娛，脩己而已。」又問：「卿何如滕胤？」恪答曰：「登階躡履，臣不如胤；回籌轉策，胤不如臣。」恪嘗獻權馬，先𨪕其耳。範慎時在坐，嘲恪曰：「馬雖大畜，禀氣於天，今殘其耳，豈不傷仁？」恪答曰：「母之於女，恩愛至矣，穿耳附珠，何傷於仁？」太子嘗嘲恪：「諸葛元遜可食馬矢。」恪曰：「原太子食雞卵。」權曰：「人令卿食馬矢，卿使人食雞卵何也？」恪曰：「所出同耳。」權大笑。《江表傳》曰：曾有白頭鳥集殿前，權曰：「此何鳥也？」恪曰：「白頭翁也。」張昭自以坐中最老，疑恪以鳥戲之，因曰：「恪欺陛下，未嘗聞鳥名白頭翁者，試使恪复求白頭母。」恪曰：「鳥名鸚母，未必有對，試使輔吳复求鸚父。」昭不能答，坐中皆歡笑。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":12,"last_line":12,"raw_start":659,"raw_end":1136,"raw_character_offsets":[659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,745,746,747,748,749,750,751,752,753,754,755,756,757,758,759,760,761,762,763,764,765,766,767,768,769,770,771,772,773,774,775,776,777,778,779,780,781,782,783,784,785,786,787,788,789,790,791,792,793,794,795,796,797,798,799,800,801,802,803,804,805,806,807,808,809,810