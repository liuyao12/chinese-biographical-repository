al"},{"id":"c-shiji-057-zhou:m024-0029","start":29,"end":31,"surface":"高祖","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m024-0040","start":40,"end":42,"surface":"諸呂","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、假設侯嗣、職署或未定回指；不補姓名、親屬成員或爵位所指。"},{"id":"c-shiji-057-zhou:m024-0046","start":46,"end":47,"surface":"勃","kind":"person","person_id":"cbr-p003468","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m024-0058","start":58,"end":60,"surface":"伊尹","kind":"person","person_id":"cbr-p003536","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m024-0061","start":61,"end":63,"surface":"周公","kind":"person","person_id":"cbr-p003537","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m024-0069","start":69,"end":71,"surface":"亞夫","kind":"person","person_id":"cbr-p003470","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m024-0083","start":83,"end":85,"surface":"穰苴","kind":"person","person_id":"cbr-p003538","status":"contextual_provisional"}],"chapter_id":"c-shiji-057-zhou","book_id":"b-shiji-057","work_id":"w-shiji","source_id":"s-shiji-057-zhou"}],"sources":[{"chapter_id":"c-shiji-057-zhou","work_id":"w-shiji","book_id":"b-shiji-057","source_id":"s-shiji-057-zhou","source":{"title":"史記／卷057","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷057","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷057&oldid=1569360","revision_id":1569360,"accessed_on":"2026-10-09","extent":"24段篇文及1段索隱述贊，無需排除數位欄題。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白；保留泗（川）［水］、潁（陽）［陰］侯、吏［事］、乃［封］、［唯］徐盧、櫡、圂、遬、屍北與鹹克等見證原字及符號，索隱另分層。","note":"全25段已讀並作明示人物首輪；未核底本、影像或現代研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not