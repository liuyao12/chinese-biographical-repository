57-zhou:p008","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m018-0125","start":125,"end":128,"surface":"高皇帝","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p018","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-057-zhou:m024-0029","start":29,"end":31,"surface":"高祖","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p024","chapter_id":"c-shiji-057-zhou"}],"relations":[],"title_holdings":[{"id":"th-shiji057-005","person_id":"cbr-p003471","title":"安武侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。"}],"attestations":[{"id":"th-shiji057-005:a001","paragraph_id":"c-shiji-057-zhou:p002","start":219,"end":222,"surface":"安武侯","person_mention_id":"c-shiji-057-zhou:m002-0216","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji057-006","person_id":"cbr-p003471","title":"碭郡長","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。"}],"attestations":[{"id":"th-shiji057-006:a001","paragraph_id":"c-shiji-057-zhou:p002","start":224,"end":227,"surface":"碭郡長","person_mention_id":"c-shiji-057-zhou:m002-0228","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji057-010","person_id":"cbr-p003471","title":"漢王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p003","quote":"項羽至，以沛公為漢王。漢王賜勃爵為威武侯。從入漢中，拜為將軍。還定三秦，至秦，賜食邑懷德。攻槐裏、好畤，最。擊趙賁、內史保於咸陽，最。北攻漆。擊章平、姚卬軍。西定汧。還下郿、頻陽。圍章邯廢丘。破西丞。擊盜巴軍，破之。攻上邽。東守峣關。轉擊項籍。攻曲逆，最。還守敖倉，追項籍。籍已死，因東定楚地泗（川）［水］、東海郡，凡得二十二縣。還守雒陽、櫟陽，賜與潁（陽）［陰］侯共食鐘離。以將軍從高帝反者燕王臧荼，破之易下。所將卒當馳道為多。賜爵列侯，剖符世世勿絕。食絳八千一百八十戶，號絳侯。"}],"attestations":[{"id":"th-shiji057-010:a001","paragraph_id":"c-shiji-057-zhou:p003","start":8,"end":10,"surface":"漢王","person_mention_id":"c-shiji-057-zhou:m003-0008","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p003","quote":"項羽至，以沛公為漢王。漢王賜勃爵為威武侯。從入漢中，拜為將軍。還定三秦，至秦，賜食邑懷德。攻槐裏、好畤，最。擊趙賁、內史保於咸陽，最。北攻漆。擊章平、姚卬軍。西定汧。還下郿、頻陽。圍章邯廢丘。破西丞。擊盜巴軍，破之。攻上邽。東守峣關。轉擊項籍。攻曲逆，最。還守敖倉，追項籍。籍已死，因東定楚地泗（川）［水］、東海郡，凡得二十二縣。還守雒陽、櫟陽，賜與潁（陽）［陰］侯共食鐘離。以將軍從高帝反者燕王臧荼，破之易下。所將卒當馳道為多。賜爵列侯，剖符世世勿絕。食絳八千一百八十戶，號絳侯。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji057-004","person_id":"cbr-p003471","surfaces":["沛公","漢王","高帝","高皇帝","高祖"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。"},{"paragraph_id":"c-shiji-057-zhou:p003","quote":"項羽至，以沛公為漢王。漢王賜勃爵為威武侯。從入漢中，拜為將軍。還定三秦，至秦，賜食邑懷德。攻槐裏、好畤，最。擊趙賁、內史保於咸陽，最。北攻漆。擊章平、姚卬軍。西定汧。還下郿、頻陽。圍章邯廢丘。破西丞。擊盜巴軍，破之。攻上邽。東守峣關。轉擊項籍。攻曲逆，最。還守敖倉，追項籍。籍已死，因東定楚地泗（川）［水］、東海郡，凡得二十二縣。還守雒陽、櫟陽，賜與潁（陽）［陰］侯共食鐘離。以將軍從高帝反者燕王臧荼，破之易下。所將卒當馳道為多。賜爵列侯，剖符世世勿絕。食絳八千一百八十戶，號絳侯。"},{"paragraph_id":"c-shiji-057-zhou:p004","quote":"以將軍從高帝擊反韓王信於代，降下霍人。以前至武泉，擊胡騎，破之武泉北。轉攻韓信軍銅鞮，破之。還，降太原六城。擊韓信胡騎晉陽下，破之，下晉陽。後擊韓信軍於硰石，破之，追北八十里。還攻樓煩三城，因擊胡騎平城下，所將卒當馳道為多。勃遷為太尉。"},{"paragraph_id":"c-shiji-057-zhou:p006","quote":"燕王盧綰反，勃以相國代樊噲將，擊下薊，得綰大將抵、丞相偃、守陘、太尉弱、御史大夫施，屠渾都。破綰軍上蘭，復擊破綰軍沮陽。追至長城，定上谷十二縣，右北平十六縣，遼西、遼東二十九縣，漁陽二十二縣。最從高帝得相國一人，丞相二人，將軍、二千石各三人；別破軍二，下城三，定郡五，縣七十九，得丞相、大將各一人。"},{"paragraph_id":"c-shiji-057-zhou:p007","quote":"勃為人木彊敦厚，高帝以為可屬大事。勃不好文學，每召諸生說士，東鄉坐而責之：「趣為我語。」其椎少文如此。"},{"paragraph_id":"c-shiji-057-zhou:p008","quote":"勃既定燕而歸，高祖已崩矣，以列侯事孝惠帝。孝惠帝六年，置太尉官，以勃為太尉。十歲，高后崩。呂祿以趙王為漢上將軍，呂產以呂王為漢相國，秉漢權，欲危劉氏。勃為太尉，不得入軍門。陳平為丞相，不得任事。於是勃與平謀，卒誅諸呂而立孝文皇帝。其語在呂后、孝文事中。"},{"paragraph_id":"c-shiji-057-zhou:p018","quote":"竇太后曰：「皇后兄王信可侯也。」景帝讓曰：「始南皮、章武侯先帝不侯，及臣即位乃侯之。信未得封也。」竇太后曰：「人主各以時行耳。自竇長君在時，竟不得侯，死後乃［封］其子彭祖顧得侯。吾甚恨之。帝趣侯信也！」景帝曰：「請得與丞相議之。」丞相議之，亞夫曰：「高皇帝約『非劉氏不得王，非有功不得侯。不如約，天下共擊之』。今信雖皇后兄，無功，侯之，非約也。」景帝默然而止。"},{"paragraph_id":"c-shiji-057-zhou:p024","quote":"太史公曰：絳侯周勃始為布衣時，鄙樸人也，才能不過凡庸。及從高祖定天下，在將相位，諸呂欲作亂，勃匡國家難，復之乎正。雖伊尹、周公，何以加哉！亞夫之用兵，持威重，執堅刃，穰苴曷有加焉！足己而不學，守節不遜，終以窮困。悲夫！"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-057-zhou:p002","text":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m002-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0004","start":4,"end":6,"surface":"沛公","kind":"person","person_id":"cbr-p003471","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0009","start":9,"end":10,"surface":"勃","kind":"person","person_id":"cbr-p003468","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0076","start":76,"end":78,"surface":"章邯","kind":"person","person_id":"cbr-p003472","status":"cont