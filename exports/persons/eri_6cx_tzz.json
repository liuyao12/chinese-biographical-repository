riginal_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-029-huili-complete:p003:m0106","start":106,"end":108,"surface":"王偉","kind":"person","person_id":"eri_6cx_tzz","status":"contextual_provisional","paragraph_id":"c-liangshu-029-huili-complete:p003","chapter_id":"c-liangshu-029-huili-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-029-huili-complete:p003","text":"是冬，景往晉熙，景師虛弱，會理復與柳敬禮謀之。敬禮曰：「舉大事必有所資，今無寸兵，安可以動？」會理曰：「湖熟有吾舊兵三千餘人，昨來相知，克期響集，聽吾日定，便至京師。計賊守兵不過千人耳，若大兵外攻，吾等內應，直取王偉，事必有成。縱景後歸，無能爲也。」敬禮曰「善」，因贊成之。于時百姓厭賊，咸思用命，自丹陽至于京口，靡不同之。後事不果，與弟祁陽侯通理並遇害。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":21,"last_line":21,"raw_start":1185,"raw_end":1363,"raw_character_offsets":[1185,1186,1187,1188,1189,1190,1191,1192,1193,1194,1195,1196,1197,1198,1199,1200,1201,1202,1203,1204,1205,1206,1207,1208,1209,1210,1211,1212,1213,1214,1215,1216,1217,1218,1219,1220,1221,1222,1223,1224,1225,1226,1227,1228,1229,1230,1231,1232,1233,1234,1235,1236,1237,1238,1239,1240,1241,1242,1243,1244,1245,1246,1247,1248,1249,1250,1251,1252,1253,1254,1255,1256,1257,1258,1259,1260,1261,1262,1263,1264,1265,1266,1267,1268,1269,1270,1271,1272,1273,1274,1275,1276,1277,1278,1279,1280,1281,1282,1283,1284,1285,1286,1287,1288,1289,1290,1291,1292,1293,1294,1295,1296,1297,1298,1299,1300,1301,1302,1303,1304,1305,1306,1307,1308,1309,1310,1311,1312,1313,1314,1315,1316,1317,1318,1319,1320,1321,1322,1323,1324,1325,1326,1327,1328,1329,1330,1331,1332,1333,1334,1335,1336,1337,1338,1339,1340,1341,1342,1343,1344,1345,1346,1347,1348,1349,1350,1351,1352,1353,1354,1355,1356,1357,1358,1359,1360,1361,1362],"revision_id":1538079},"mentions":[{"id":"c-liangshu-029-huili-complete:p003