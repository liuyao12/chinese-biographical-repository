7,"end":120,"surface":"竇廣國","kind":"person","person_id":"cbr-p005389","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0133","start":133,"end":135,"surface":"廣國","kind":"person","person_id":"cbr-p005389","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0137","start":137,"end":139,"surface":"廣國","kind":"person","person_id":"cbr-p005389","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0155","start":155,"end":157,"surface":"高帝","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m016-0177","start":177,"end":178,"surface":"嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p017","text":"嘉為人廉直，門不受私謁。是時太中大夫鄧通方隆愛幸，賞賜累巨萬。文帝嘗燕飲通家，其寵如是。是時丞相入朝，而通居上傍，有怠慢之禮。丞相奏事畢，因言曰：「陛下愛幸臣，則富貴之；至於朝廷之禮，不可以不肅！」上曰：「君勿言，吾私之。」罷朝坐府中，嘉為檄召鄧通詣丞相府，不來，且斬通。通恐，入言文帝。文帝曰：「汝第往，吾今使人召若。」通至丞相府，免冠，徒跣，頓首謝。嘉坐自如，故不為禮，責曰：「夫朝廷者，高皇帝之朝廷也。通小臣，戲殿上，大不敬，當斬。吏今行斬之！」通頓首，首盡出血，不解。文帝度丞相已困通，使使者持節召通，而謝丞相曰：「此吾弄臣，君釋之。」鄧通既至，為文帝泣曰：「丞相幾殺臣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m017-0000","start":0,"end":1,"surface":"嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0018","start":18,"end":20,"surface":"鄧通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0031","start":31,"end":33,"surface":"文帝","kind":"person","person_id":"cbr-p005384","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0036","start":36,"end":37,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0052","start":52,"end":53,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0118","start":118,"end":119,"surface":"嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0122","start":122,"end":124,"surface":"鄧通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0134","start":134,"end":135,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0136","start":136,"end":137,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0141","start":141,"end":143,"surface":"文帝","kind":"person","person_id":"cbr-p005384","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0144","start":144,"end":146,"surface":"文帝","kind":"person","person_id":"cbr-p005384","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0161","start":161,"end":162,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0177","start":177,"end":178,"surface":"嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0196","start":196,"end":199,"surface":"高皇帝","kind":"person","person_id":"cbr-p005364","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0204","start":204,"end":205,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0226","start":226,"end":227,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0238","start":238,"end":240,"surface":"文帝","kind":"person","person_id":"cbr-p005384","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0245","start":245,"end":246,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0253","start":253,"end":254,"surface":"通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0272","start":272,"end":274,"surface":"鄧通","kind":"person","person_id":"cbr-p005403","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m017-0278","start":278,"end":280,"surface":"文帝","kind":"person","person_id":"cbr-p005384","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p018","text":"嘉為丞相五歲，孝文帝崩，孝景帝即位。二年，晁錯為內史，貴幸用事，諸法令多所請變更，議以謫罰侵削諸侯。而丞相嘉自絀所言不用，疾錯。錯為內史，門東出，不便，更穿一門南出。南出者，太上皇廟堧垣。嘉聞之，欲因此以法錯擅穿宗廟垣為門，奏請誅錯。錯客有語錯，錯恐，夜入宮上謁，自歸景帝。至朝，丞相奏請誅內史錯。景帝曰：「錯所穿非真廟垣，乃外堧垣，故他官居其中，且又我使為之，錯無罪。」罷朝，嘉謂長史曰：「吾悔不先斬錯，乃先請之，為錯所賣。」至舍，因歐血而死。謚為節侯。子共侯蔑代，三年卒。子侯去病代，三十一年卒。子侯臾代，六歲，坐為九江太守受故官送有罪，國除。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m018-0000","start":0,"end":1,"surface":"嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0007","start":7,"end":10,"surface":"孝文帝","kind":"person","person_id":"cbr-p005384","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0012","start":12,"end":15,"surface":"孝景帝","kind":"person","person_id":"cbr-p005388","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0021","start":21,"end":23,"surface":"晁錯","kind":"person","person_id":"cbr-p005404","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0053","start":53,"end":54,"surface":"嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0062","start":62,"end":63,"surface":"錯","kind":"person","person_id":"cbr-p005404","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0064","start":64,"end":65,"surface":"錯","kind":"person","person_id":"cbr-p005404","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0087","start":87,"end":90,"surface":"太上皇","kind":"perso