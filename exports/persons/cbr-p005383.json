,{"id":"c-shiji-096-zhang:m018-0209","start":209,"end":210,"surface":"錯","kind":"person","person_id":"cbr-p005404","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0231","start":231,"end":232,"surface":"蔑","kind":"person","person_id":"cbr-p005415","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0240","start":240,"end":242,"surface":"去病","kind":"person","person_id":"cbr-p005405","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m018-0252","start":252,"end":253,"surface":"臾","kind":"person","person_id":"cbr-p005416","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p019","text":"自申屠嘉死之後，景帝時開封侯陶青、桃侯劉舍為丞相。及今上時，柏至侯許昌、平棘侯薛澤、武彊侯莊青翟、高陵侯趙周等為丞相。皆以列侯繼嗣，娖娖廉謹，為丞相備員而已，無所能發明功名有著於當世者。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m019-0001","start":1,"end":4,"surface":"申屠嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m019-0008","start":8,"end":10,"surface":"景帝","kind":"person","person_id":"cbr-p005388","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m019-0014","start":14,"end":16,"surface":"陶青","kind":"person","person_id":"cbr-p005406","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m019-0019","start":19,"end":21,"surface":"劉舍","kind":"person","person_id":"cbr-p005407","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m019-0026","start":26,"end":28,"surface":"今上","kind":"person","person_id":"cbr-p005411","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m019-0033","start":33,"end":35,"surface":"許昌","kind":"person","person_id":"cbr-p005408","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m019-0039","start":39,"end":41,"surface":"薛澤","kind":"person","person_id":"cbr-p005409","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m019-0