kind":"person","person_id":"cbr-p005413","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p030","text":"張蒼主計，天下作程。孫臣始絀，秦曆尚行。禦史亞相，相國阿衡。申屠面折，周子廷爭。其他娖娖，無所發明。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-096-zhang:m030-0000","start":0,"end":2,"surface":"張蒼","kind":"person","person_id":"cbr-p005362","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m030-0010","start":10,"end":12,"surface":"孫臣","kind":"person","person_id":"cbr-p005387","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m030-0030","start":30,"end":32,"surface":"申屠","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m030-0035","start":35,"end":37,"surface":"周子","kind":"person","person_id":"cbr-p005370","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"}],"sources":[{"chapter_id":"c-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","source_id":"s-shiji-096-zhang","source":{"title":"史記／卷096","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷096","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷096&oldid=8770206","revision_id":8770206,"accessed_on":"2026-10-09","extent":"29段傳世文字含兩處太史公論，另附1段分層索隱述贊；首HTML區塊即正文，不刪頭2段。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"固定HTML一致，只去外緣空白；亨周苛、（不）、困妯囡及邴丞相等原字保留。","note":"全30個HTML區塊已讀，未核底本影像。後段征和以後丞相記述在此見證未署補作者，不冒署褚先生。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astr