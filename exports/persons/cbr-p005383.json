-096-zhang"},{"id":"c-shiji-096-zhang:m018-0094","start":94,"end":95,"surface":"嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p018","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m018-0189","start":189,"end":190,"surface":"嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p018","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m019-0001","start":1,"end":4,"surface":"申屠嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p019","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m020-0062","start":62,"end":65,"surface":"申屠嘉","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p020","chapter_id":"c-shiji-096-zhang"},{"id":"c-shiji-096-zhang:m030-0030","start":30,"end":32,"surface":"申屠","kind":"person","person_id":"cbr-p005383","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p030","chapter_id":"c-shiji-096-zhang"}],"relations":[{"id":"a-shiji096-010","subject_person_id":"cbr-p005415","predicate":"father","object_person_id":"cbr-p005383","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p018","quote":"嘉為丞相五歲，孝文帝崩，孝景帝即位。二年，晁錯為內史，貴幸用事，諸法令多所請變更，議以謫罰侵削諸侯。而丞相嘉自絀所言不用，疾錯。錯為內史，門東出，不便，更穿一門南出。南出者，太上皇廟堧垣。嘉聞之，欲因此以法錯擅穿宗廟垣為門，奏請誅錯。錯客有語錯，錯恐，夜入宮上謁，自歸景帝。至朝，丞相奏請誅內史錯。景帝曰：「錯所穿非真廟垣，乃外堧垣，故他官居其中，且又我使為之，錯無罪。」罷朝，嘉謂長史曰：「吾悔不先斬錯，乃先請之，為錯所賣。」至舍，因歐血而死。謚為節侯。子共侯蔑代，三年卒。子侯去病代，三十一年卒。子侯臾代，六歲，坐為九江太守受故官送有罪，國除。"}],"qualifiers":{"source_term":"子共侯蔑代","historicity":"historical_tradition"},"interpretation_note":"按原文明示親屬保存；父事不作生父，繼位不自行推父子，不補闕代或同母。","reviewer":"Codex（AI 代理）"}],"title_holdings":[{"id":"th-shiji096-041","person_id":"cbr-p005383","title":"隊率","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p016","quote":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。"}],"attestations":[{"id":"th-shiji096-041:a001","paragraph_id":"c-shiji-096-zhang:p016","start":24,"end":26,"surface":"隊率","person_mention_id":"c-shiji-096-zhang:m016-0000","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p016","quote":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、轉任、用稱與諡稱分存；未明示時任期起訖未知。欲任竇廣國及欲令周苛將皆不作實授；死亡或首次用稱不自動作任期端點。十四年、四年、二年等先保留原語，不擅定年號或西曆。曹窋免職段含（不）異文，未先強定其終點。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji096-042","person_id":"cbr-p005383","title":"都尉","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p016","quote":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。"}],"attestations":[{"id":"th-shiji096-042:a001","paragraph_id":"c-shiji-096-zhang:p016","start":34,"end":36,"surface":"都尉","person_mention_id":"c-shiji-096-zhang:m016-0000","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、轉任、用稱與諡稱分存；未明示時任期起訖未知。欲任竇廣國及欲令周苛將皆不作實授；死亡或首次用稱不自動