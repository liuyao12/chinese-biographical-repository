flicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji122-008","person_id":"gzs_074_bja","event_type":"death","status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-122-kuli","source_id":"s-shiji122-kuli","paragraph_id":"c-shiji-122-kuli:p022","quote":"河東人李文嘗與湯有卻，已而爲御史中丞，恚，數從中文書事有可以傷湯者，不能爲地。湯有所愛史魯謁居，知湯不平，使人上蜚變告文姦事，事下湯，湯治論殺文，而湯心知謁居爲之。上問曰：「言變事縱跡安起？」湯詳驚曰：「此殆文故人怨之。」謁居病臥閭里主人，湯自往視疾，爲謁居摩足。趙國以冶鑄爲業，王數訟鐵官事，湯常排趙王。趙王求湯陰事。謁居嘗案趙王，趙王怨之，并上書告：「湯，大臣也，史謁居有病，湯至爲摩足，疑與爲大姦。」事下廷尉。謁居病死，事連其弟，弟繋導官。湯亦治他囚導官，見謁居弟，欲陰爲之，而詳不省。謁居弟弗知，怨湯，使人上書告湯與謁居謀，共變告李文。事下減宣。宣嘗與湯有卻，及得此事，窮竟其事，未奏也。會人有盜發孝文園瘞錢，丞相靑翟朝，與湯約倶謝，至前，湯念獨丞相以四時行園，當謝，湯無與也，不謝。丞相謝，上使御史案其事。湯欲致其文丞相見知，丞相患之。三長史皆害湯，欲陷之。","person_mention_id":"c-shiji-122-kuli:m022-0003"}],"source_term":"湯治論殺文","interpretation_note":"原文明示死亡、執行或自殺；各次回顧未另造死亡事件。未知公元年保持未知，後一歳、十餘年等相對時間保留原文待核。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-122-kuli:m022-0003","start":3,"end":5,"surface":"李文","kind":"person","person_id":"gzs_074_bja","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p022","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m022-0059","start":59,"end":60,"surface":"文","kind":"person","person_id":"gzs_074_bja","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p022","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m022-0071","start":71,"end":72,"surface":"文","kind":"person","person_id":"gzs_074_bja","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p022","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m022-0104","start":104,"end":105,"surface":"文","kind":"person","person_id":"gzs_074_bja","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p022","chapter_id":"c-shiji-122-kuli"},{"id":"c-shiji-122-kuli:m022-0269","start":269,"end":271,"surface":"李文","kind":"person","person_id":"gzs_074_bja","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p022","chapter_id":