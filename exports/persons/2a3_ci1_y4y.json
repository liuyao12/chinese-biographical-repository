,"surface":"澄","kind":"person","person_id":"p3f_nlh_ukk","identification_status":"contextual_provisional","interpretation_note":"誌稱任城文宣王，《魏書》卷十九中〈任城王〉同載澄與文宣諡。"},{"id":"c-epitaph-wanglingyuan-excerpts:p001:m0068","start":68,"end":70,"surface":"令媛","kind":"person","person_id":"q7m_r8k_2vn_AAAAA","identification_status":"contextual_provisional","interpretation_note":"依墓誌家系、官銜及志主姓名辨識。"},{"id":"c-epitaph-wanglingyuan-excerpts:p001:m0082","start":82,"end":83,"surface":"奐","kind":"person","person_id":"q7m_r8k_2vn_AA","identification_status":"contextual_provisional","interpretation_note":"依墓誌家系、官銜及志主姓名辨識。"}],"witness_locator":{"image_parts":[1],"locus":"圖版000756292右葉，右起第2欄「祖琛」至第8欄「曾孫也」。父翊在第4欄下部；母河南元氏、父澄在第5欄下部，其封諡續第6欄。"},"chapter_id":"c-epitaph-wanglingyuan-excerpts","book_id":"b-epitaph-wanglingyuan-excerpts","work_id":"w-epitaph-wanglingyuan","source_id":"s-epitaph-wanglingyuan-daitof00792"},{"id":"c-epitaph-wanglingyuan-excerpts:p002","text":"亦既有行，來儀蕃邸，率禮公宮，剋循法度。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[],"witness_locator":{"image_parts":[1],"locus":"圖版000756292左葉，右起第3欄下端至第4欄中部。"},"chapter_id":"c-epitaph-wanglingyuan-excerpts","book_id":"b-epitaph-wanglingyuan-excerpts","work_id":"w-epitaph-wanglingyuan","source_id":"s-epitaph-wanglingyuan-daitof00792"},{"id":"c-epitaph-wanglingyuan-excerpts:p003","text":"粵以武定二年歲在甲子八月庚申合葬於武城之北原。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[],"witness_locator":{"image_parts":[1],"locus":"圖版000756292左葉，右起第8欄中部至第9欄下端。"},"chapter_id":"c-epitaph-wanglingyuan-excerpts","book_id":"b-epitaph-wanglingyuan-excerpts","work_id":"w-epitaph-wanglingyuan","source_id":"s-epitaph-wanglingyuan-daitof00792"},{"id":"c-epitaph-yuanzhan-excerpts:p001","text":"魏故使持節假黃鉞侍中太傅大司馬尚書令定州刺史廣陽文獻王銘。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-epitaph-yuanzhan-excerpts:p001:m0022","start":22,"end":27,"surface":"廣陽文獻王","kind":"person","person_id":"2a3_ci1_y4y","identification_status":"contextual_provisional","interpretation_note":"元湛本誌題署，與其名段及王妃誌同號。"}],"witness_locator":{"image_parts":[1],"locus":"圖版000756311右葉，右起第1至第3欄。"},"chapter_id":"c-epitaph-yuanzhan-excerpts","book_id":"b-epitaph-yuanzhan-excerpts","work_id":"w-epitaph-yuanzhan","source_id":"s-epitaph-yuanzhan-daitof00794"},{"id":"c-epitaph-yuanzhan-excerpts:p002","text":"公諱湛，字士深，河南洛陽人也。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-epitaph-yuanzhan-excerpts:p002:m0002","start":2,"end":3,"surface":"湛","kind":"person","person_id":"2a3_ci1_y4y","identification_status":"contextual_provisional","interpretation_note":"誌主原用單名，姓據郡王身分與館藏書目補入標籤。"},{"id":"c-epitaph-yuanzhan-excerpts:p002:m0005","start":5,"end":7,"surface":"士深","kind":"person","person_id":"2a3_ci1_y4y","identification_status":"contextual_provisional","interpretation_note":"誌首明書字士深。"}],"witness_locator":{"image_parts":[1],"locus":"圖版000756311左葉，最左欄。"},"chapter_id":"c-epitaph-yuanzhan-excerpts","book_id":"b-epitaph-yuanzhan-excerpts","work_id":"w-epitaph-yuanzhan","source_id":"s-epitaph-yuanzhan-daitof00794"},{"id":"c-epitaph-yuanzhan-excerpts:p003","text":"春秋卅有五，以武定二年歲在甲子五月十四日丁酉薨於鄴。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[],"witness_locator":{"image_parts":[2],"locus":"圖版000756316右葉，右起第3欄末至第5欄。"},"chapter_id":"c-epitaph-yuanzhan-excerpts","book_id":"b-epitaph-yuanzhan-excerpts","work_id":"w-epitaph-yuanzhan","source_id":"s-epitaph-yuanzhan-daitof00794"},{"id":"c-epitaph-yuanzhan-excerpts:p004","text":"王如故，謚曰文獻，禮也。粵以其年八月庚申葬於武城之北原。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[],"witness_locator":{"image_parts":[3],"locus":"圖版000756318右葉，右起第2欄「王如故」至第4欄「北原」。"},"chapter_id":"c-epitaph-yuanzhan-excerpts","book_id":"b-epitaph-yuanzhan-excerpts","work_id":"w-epitaph-yuanzhan","source_id":"s-epitaph-yuanzhan-daitof00794"},{"id":"c-epitaph-yuanzhan-excerpts:p005","text":"芒阜臨北，魚山望東，安厝不異，託葬攸同。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[],"witness_locator":{"image_parts":[4],"locus":"圖版000756319左葉，右起第3欄及第4欄上端。"},"chapter_id":"c-epitaph-yuanzhan-excerpts","book_id":"b-epitaph-yuanzhan-excerpts","work_id":"w-epitaph-yuanzhan","source_id":"s-epitaph-yuanzhan-daitof00794"},{"id":"c-weishu-weishou-018-yuanzhan-falun:p001","text":"湛子法輪，紫光所生也。齊王矜湛覆滅，乃啟原之，復其爵土。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-weishu-weishou-018-yuanzhan-falun:p001:m0000","start":0,"end":1,"surface":"湛","kind":"person","person_id":"2a3_ci1_y4y","identification_status":"contextual_provisional","interpretation_note":"段首「湛子」承前太尉廣陽文獻王湛。"},{"id":"c-weishu-weishou-018-yuanzhan-falun:p001:m0002","start":2,"end":4,"surface":"法輪","kind":"person","person_id":"2a3_ci1_y4y_A","identification_status":"contextual_provisional","interpretation_note":"原文明言湛子法輪。"},{"id":"c-weishu-weishou-018-yuanzhan-falun:p001:m0005","start":5,"end":7,"surface":"紫光","kind":"person","person_id":"ndd_nmw_kcl","identification_status":"contextual_provisional","interpretation_note":"原文「所生」明指生母。"},{"id":"c-weishu-weishou-018-yuanzhan-falun:p001:m0014","start":14,"end":15,"surface":"湛","kind":"person","person_id":"2a3_ci1_y4y","identification_status":"contextual_provisional","interpretation_note":"齊王所矜之湛仍是本段法輪之父。"}],"chapter_id":"c-weishu-weishou-018-yuanzhan-falun","book_id":"b-weishu-weishou-018","work_id":"w-weishu-weishou","source_id":"s-weishu-weishou-018-yuanzhan-falun-ws1550395"}],"sources":[{"chapter_id":"c-beishi-016-yuanzhan-falun","work_id":"w-beishi","book_id":"b-beishi-016","source_id":"s-beishi-016-yuanzhan-falun-ws1518816","source":{"title":"北史廣陽王傳元湛附傳末","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=北史/卷016&oldid=1518816","permalink":"https://zh.wikisource.org/w/index.php?title=北史/卷016&oldid=1518816","revision_id":1518816,"accessed_on":"2026-11-19","edition":"維基文庫固定數位見證；本錄文的刻本底本待核。","extent":"廣陽王家傳中元湛附傳末「湛子法輪」一段。","tex