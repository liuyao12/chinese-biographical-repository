shu-054-recluses-complete:p049","text":"　　建元初，豫章王爲荊州，教辟虯爲別駕，與同郡宗測、新野庾易竝遣書禮請，虯等各修牋答，而不應辟命。永明三年，刺史廬陵王子卿表虯及同郡宗測、宗尚之、庾易、劉昭五人，請加蒲車束帛之命。詔徵爲通直郎，不就。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":128,"last_line":128,"raw_start":7113,"raw_end":7213,"raw_character_offsets":[7113,7114,7115,7116,7117,7118,7119,7120,7121,7122,7123,7124,7125,7126,7127,7128,7129,7130,7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p049:m0006","start":6,"end":9,"surface":"豫章王","kind":"person","person_id":"ijh_3fs_6u2","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0015","start":15,"end":16,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0023","start":23,"end":25,"surface":"宗測","kind":"person","person_id":"ou7_kzk_fb6","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0028","start":28,"end":30,"surface":"庾易","kind":"person","person_id":"e3g_qwe_o7m","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0036","start":36,"end":37,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0056","start":56,"end":61,"surface":"廬陵王子卿","kind":"person","person_id":"kix_r92_2ed_E","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p049:m0062","start":62,"end":63,"surface":"虯","kind":"person","person_id":"rp9_3uw_714","status":"contextual_provisional"},{