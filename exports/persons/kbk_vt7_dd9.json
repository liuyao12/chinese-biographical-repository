_paths":[],"mentions":[{"id":"c-shiji-117-xiangru:m016-0110","start":110,"end":112,"surface":"偓佺","kind":"person","person_id":"kbk_vt7_dd9","status":"contextual_provisional","interpretation_note":"《史記集解》引《漢書音義》明言「偓佺，仙人名也」，故連至傳說中的仙人偓佺；「之倫」表示同類。此為賦體仙境中的文學指涉，不證明偓佺實際到場，亦不據此推生平、年代或世系。","paragraph_id":"c-shiji-117-xiangru:p016","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji117-wuquan-commentary","person_id":"kbk_vt7_dd9","surfaces":["偓佺"],"scope":"same_chapter","chapter_ids":["c-shiji-117-xiangru"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"ancient_commentary_explicit_identification","target_mention_ids":["c-shiji-117-xiangru:m016-0110"],"historical_event_attendance_not_inferred":true},"evidence":[{"chapter_id":"c-shiji-117-xiangru","paragraph_id":"c-shiji-117-xiangru:p016","quote":"偓佺之倫暴於南榮","mention_ids":["c-shiji-117-xiangru:m016-0110"]}],"references":[{"title":"《史記集解》卷117引《漢書音義》釋偓佺","url":"https://github.com/kanripo/KR2a0002/blob/73c4d2ba067d99a6de924ac952fd6921a958c7e7/KR2a0002_117.txt#L237","quote":"(人名/也)偓佺之倫暴於南榮(漢書音義曰偓/佺僊人名也)醴泉涌於清¶\n室通川過乎中庭槃石祳崖(徐廣曰/祳音脣)嶔巖倚傾嵳峩磼¶\n礏(徐廣曰峩一作池磼/音雜礏音五合反)刻削峥嶸玟瑰碧琳珊瑚叢生¶","source_commit":"73c4d2ba067d99a6de924ac952fd6921a958c7e7","source_blob":"ccded97eee2542083010172d857d6251a09a126c","verified_extent":{"start_line":237,"end_line":239},"scope":"ancient_commentary_identification","image_verified":false}],"rationale":"《漢書音義》明言偓佺為仙人名；正文「之倫」表偓佺同類。據此標為傳說人物提及，但本句是賦中仙境景象，不推作歷史到場、交遊、年代或親屬證據。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-117-xiangru:p016","text":"「於是乎離宮別館，彌山跨谷，高廊四注，重坐曲閣，華榱璧璫，輦道纚屬，步朓周流，長途中宿。夷顒築堂，累台增成，岩穾洞房，俯杳眇而無見，仰攀橑而捫天，奔星更於閨闥，宛虹拖於楯軒。青虯蚴蟉於東箱，象輿婉蟬於西清，靈圉燕於間觀，偓佺之倫暴於南榮，醴泉湧於清室，通川過乎中庭。槃石裖崖，嶔岩倚傾，嵯峨磼酺，刻削崢嶸，玫瑰碧琳，珊瑚叢生，渼玉旁唐，瑸斒文鱗，赤瑕駁犖，雜臿其間，垂綏琬琰，和氏出焉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m016-0103","start":103,"end":105,"surface":"靈圉","kind":"person","person_id":"93v_7o4_i4q","status":"contextual_provisional","interpretation_note":"《集解》郭璞注「靈圉，淳圉，仙人名也」；與本篇另兩見「靈圉」按同一篇賦的連續神仙敘事暫同指。保留正文用字，不把注文「淳圉」改作正文別名。"},{"id":"c-shiji-117-xiangru:m016-0110","start":110,"end":112,"surface":"偓佺","kind":"person","person_id":"kbk_vt7_dd9","status":"contextual_provisional","interpretation_note":"《史記集解》引《漢書音義》明言「偓佺，仙人名也」，故連至傳說中的仙人偓佺；「之倫」表示同類。此為賦體仙境中的文學指涉，不證明偓佺實際到場，亦不據此推生平、年代或世系。"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-117-xiangru","work_id":"w-shiji","book_id":"b-shiji-117","source_id":"s-shiji117-xiangru","source":{"title":"史記／卷117","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷117","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷117&oldid=10371549","revision_id":10371549,"accessed_on":"2026-10-11","extent":"固定修訂全文71段，包括賦、書與末段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"去header2、目錄標記及現代節標；quote模板保留全文，br轉段落；罕字模板保留第一參數字形，描述未作正文；連結保留顯示字。未核影像。 移除防轉換控制外殼，保留內字云。","note":"第58段U+E0FA私用字缺字與頌中重句原樣保存，不猜補；末段索隱述贊分層。 p063頌句重複及截漏尚待核所選底本，差異存於annotation.transcription_discrepancies，不改現存轉錄。 p064「俎／徂」另存待核差異；不據比較轉錄逕改正文。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
