red":false},"family_paths":[],"mentions":[{"id":"c-jinshu-071-xiongyuan:p001:m0019","surface":"石崇","start":19,"end":21,"person_id":"59x_76l_vd6","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-071-xiongyuan:p001","chapter_id":"c-jinshu-071-xiongyuan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-071-xiongyuan:p001","text":"熊遠，字孝文，豫章南昌人也。祖翹，嘗為石崇蒼頭，而性廉直，有士風。黃門郎潘嶽見而稱異，勸崇免之，乃還鄉里。遠有志尚，縣召為功曹，不起，強與衣幘，扶之使謁。十餘日薦於郡，由是辟為文學掾。遠曰：「辭大不辭小也。」固請留縣。太守察遠孝廉。屬太守討氐羌，遠遂不行，送至隴右而還。後太守會稽夏靜辟為功曹。及靜去職，遠送至會稽以歸。州辟主簿、別駕，舉秀才，除監軍華軼司馬、領武昌太守、甯遠護軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":27,"last_line":27,"raw_start":1770,"raw_end":1961,"raw_character_offsets":[1770,1771,1772,1773,1774,1775,1776,1777,1778,1779,1780,1781,1782,1783,1784,1785,1786,1787,1788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798,1799,1800,1801,1802,1803,1804,1805,1806,1807,1808,1809,1810,1811,1812,1813,1814,1815,1816,1817,1818,1819,1820,1821,1822,1823,1824,1825,1826,1827,1828,1829,1830,1831,1832,1833,1834,1835,1836,1837,1838,1839,1840,1841,1842,1843,1844,1845,1846,1847,1848,1849,1850,1851,1852,1853,1854,1855,1856,1857,1858,1859,1860,1861,1862,1863,1864,1865,1866,1867,1868,1869,1870,1871,1872,1873,1874,1875,1876,1877,1878,1879,1880,1881,1882,1883,1884,1885,1886,1887,1888,1889,1890,1891,1892,1893,1894,1895,1896,1897,1898,1899,1900,1901,1902,1903,1904,1905,1906,1907,1908,1909,1910,1911,1912,1913,1914,1915,1916,1917,1918,1919,1920,1921,1922,1923,1924,1925,1926,1927,1928,1929,1930,1931,1932,1933,1934,1935,1936,1937,1938,1939,1940,1941,1942,1943,1944,1945,1946,1947,1948,1949,1950,1951,1952,1953,1954,1955,1956,1957,1958,1959,1960],"revision_id":2595541},"mentions":[{"id":"c-jinshu-071-xiongyuan:p001:m0000","surface":"熊遠","start":0,"end":2,"person_i