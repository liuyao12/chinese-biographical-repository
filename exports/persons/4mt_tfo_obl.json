ons":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-128-guice:m004-0041","start":41,"end":43,"surface":"武王","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p004","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m015-0092","start":92,"end":93,"surface":"武","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p015","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m017-0395","start":395,"end":398,"surface":"太子發","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p017","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m017-0403","start":403,"end":405,"surface":"武王","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p017","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m018-0153","start":153,"end":154,"surface":"武","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p018","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m018-0177","start":177,"end":178,"surface":"武","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p018","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m018-0364","start":364,"end":365,"surface":"武","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p018","chapter_id":"c-shiji-128-guice"},{"id":"c-shiji-128-guice:m018-0376","start":376,"end":378,"surface":"武王","kind":"person","person_id":"4mt_tfo_obl","status":"contextual_provisional","paragraph_id":"c-shiji-128-guice:p018","chapter_id":"c-shiji-128-guice"}],"relations":[],"title_holdings":[{"id":"th-shiji128-006","person_id":"4mt_tfo_obl","title":"太子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-128-guice","source_id":"s-shiji128-guice","paragraph_id":"c-shiji-128-guice:p017","quote":"元王曰：「不然。寡人聞之，諫者福也，諛者賊也。人主聽諛，是愚惑也。雖然，禍不妄至，福不徒來。天地合氣，以生百財。陰陽有分，不離四時，十有二月，日至為期。聖人徹焉，身乃無災。明王用之，人莫敢欺。故云福之至也，人自生之；禍之至也，人自成之。禍與福同，刑與德雙。聖人察之，以知吉凶。桀紂之時，與天爭功，擁遏鬼神，使不得通。是固已無道矣，諛臣有眾。桀有諛臣，名曰趙梁。教為無道，勸以貪狼。繋湯夏臺，殺關龍逢。左右恐死，偷諛於傍。國危於累卵，皆曰無傷。稱樂萬歲，或曰未央。蔽其耳目，與之詐狂。湯卒伐桀，身死國亡。聽其諛臣，身獨受殃。春秋著之，至今不忘。紂有諛臣，名為左彊。誇而目巧，教為象郎。將至於天，又有玉床。犀玉之器，象箸而羹。聖人剖其心，壯士斬其胻。箕子恐死，被髪佯狂。殺周太子歷，囚文王昌。投之石室，將以昔至明。陰兢活之，與之俱亡。入於周地，得太公望。興卒聚兵，與紂相攻。文王病死，載尸以行。太子發代將，號為武王。戰於牧野，破之華山之陽。紂不勝敗而還走，圍之象郎。自殺宣室，身死不葬。頭懸車軫，四馬曳行。寡人念其如此，腸如涫湯。是人皆富有天下而貴至天子，然而大傲。欲無猒時，舉事而喜高，貪很而驕。不用忠信，聽其諛臣，而為天下笑。今寡人之邦，居諸侯之閒，曾不如秋毫。舉事不當，又安亡逃！」"}],"attestations":[{"id":"th-shiji128-006:a001","paragraph_id":"c-shiji-128-guice:p017","start":395,"end":397,"surface":"太子","person_mention_id":"c-shiji-128-guice:m017-0395","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按原句官爵用稱記錄，不推實任年月；明示為郎或號為武王保存來源事件，未知起訖保持未知，死亡不自動終止官爵。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji128-007","person_id":"4mt_tfo_obl","title":"武王","kind":"royal_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-128-guice","source_id":"s-shiji128-guice","paragraph_id":"c-shiji-128-guice:p017","quote":"元王曰：「不然。寡人聞之，諫者福也，諛者賊也。人主聽諛，是愚惑也。雖然，禍不妄至，福不徒來。天地合氣，以生百財。陰陽有分，不離四時，十有二月，日至為期。聖人徹焉，身乃無災。明王用之，人莫敢欺。故云福之至也，人自生之；禍之至也，人自成之。禍與福同，刑與德雙。聖人察之，以知吉凶。桀紂之時，與天爭功，擁遏鬼神，使不得通。是固已無道矣，諛臣有眾。桀有諛臣，名曰趙梁。教為無道，勸以貪狼。繋湯夏臺，殺關龍逢。左右恐死，偷諛於傍。國危於累卵，皆曰無傷。稱樂萬歲，或曰未央。蔽其耳目，與之詐狂。湯卒伐桀，身死國亡。聽其諛臣，身獨受殃。春秋著之，至今不忘。紂有諛臣，名為左彊。誇而目巧，教為象郎。將至於天，又有玉床。犀玉之器，象箸而羹。聖人剖其心，壯士斬其胻。箕子恐死，被髪佯狂。殺周太子歷，囚文王昌。投之石室，將以昔至明。陰兢活之，與之俱亡。入於周地，得太公望。興卒聚兵，與紂相攻。文王病死，載尸以行。太子發代將，號為武王。戰於牧野，破之華山之陽。紂不勝敗而還走，圍之象郎。自殺宣室，身死不葬。頭懸車軫，四馬曳行。寡人念其如此，腸如涫湯。是人皆富有天下而貴至天子，然而大傲。欲無猒時，舉事而喜高，貪很而驕。不用忠信，聽其諛臣，而為天下笑。今寡人之邦，居諸侯之閒，曾不如秋毫。舉事不當，又安亡逃！」"}],"attestations":[{"id":"th-shiji128-007:a001","paragraph_id":"c-shiji-128-guice:p017","start":403,"end":405,"surface":"武王","person_mention_id":"c-shiji-128-guice:m017-0395","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-128-guice","source_id":"s-shiji128-guice","paragraph_id":"c-shiji-128-guice:p017","quote":"元王曰：「不然。寡人聞之，諫者福也，諛者賊也。人主聽諛，是愚惑也。雖然，禍不妄至，福不徒來。天地合氣，以生百財。陰陽有分，不離四時，十有二月，日至為期。聖人徹焉，身乃無災。明王用之，人莫敢欺。故云福之至也，人自生之；禍之至也，人自成之。禍與福同，刑與德雙。聖人察之，以知吉凶。桀紂之時，與天爭功，擁遏鬼神，使不得通。是固已無道矣，諛臣有眾。桀有諛臣，名曰趙梁。教為無道，勸以貪狼。繋湯夏臺，殺關龍逢。左右恐死，偷諛於傍。國危於累卵，皆曰無傷。稱樂萬歲，或曰未央。蔽其耳目，與之詐狂。湯卒伐桀，身死國亡。聽其諛臣，身獨受殃。春秋著之，至今不忘。紂有諛臣，名為左彊。誇而目巧，教為象郎。將至於天，又有玉床。犀玉之器，象箸而羹。聖人剖其心，壯士斬其胻。箕子恐死，被髪佯狂。殺周太子歷，囚文王昌。投之石室，將以昔至明。陰兢活之，與之俱亡。入於周地，得太公望。興卒聚兵，與紂相攻。文王病死，載尸以行。太子發代將，號為武王。戰於牧野，破之華山之陽。紂不勝敗而還走，圍之象郎。自殺宣室，身死不葬。頭懸車軫，四馬曳行。寡人念其如此，腸如涫湯。是人皆富有天下而貴至天子，然而大傲。欲無猒時，舉事而喜高，貪很而驕。不用忠信，聽其諛臣，而為天下笑。今寡人之邦，居諸侯之閒，曾不如秋毫。舉事不當，又安亡逃！」"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"按原句官爵用稱記錄，不推實任年月；明示為郎或號為武王保存來源事件，未知起訖保持未知，死亡不自動終止官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-128-guice:p004","text":"夫摓策定數，灼龜觀兆，變化無窮，是以擇賢而用占焉，可謂聖人重事者乎！周公卜三龜，而武王有瘳。紂為暴虐，而元龜不占。晉文將定襄王之位，卜得黃帝之兆，卒受彤弓之命。獻公貪驪姬之色，卜而兆有口象，其禍竟流五世。楚靈將背周室，卜而龜逆，終被乾谿之敗。兆應信誠於內，而時人明察見之於外，可不謂兩合者哉！君子謂夫輕卜筮，無神明者，悖；背人道，信禎祥者，鬼神不得其正。故書建稽疑，五謀而卜筮居其二，五占從其多，明有而不專之道也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-128-guice:m004-0034","start":34,"end":36,"surface":"周公","kind":"person","person_id":"7bh_cjo_tgj","status":"contextual_provisional"},{"id":"c-shiji-128-guice:m004-0041","start":41,"end":43,"surf