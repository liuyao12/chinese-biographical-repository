cy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-055-chengpu:line014:m0036","start":36,"end":38,"surface":"于麋","kind":"person","person_id":"77h_kqa_ghe","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-055-chengpu:line014","chapter_id":"c-sanguozhi-055-chengpu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-055-chengpu:line014","text":"堅薨，復隨孫策在淮南，從攻廬江，拔之，還俱東渡。策到橫江、當利，破張英、于麋等，轉下秣陵、湖熟、句容、曲阿，普皆有功，增兵二千，騎五十匹。進破烏程、石木、波門、陵傳、餘杭，普功爲多。策入會稽，以普爲吳郡都尉，治錢唐。後徙丹楊都尉，居石城。復討宣城、涇、安吳、陵陽、春穀諸賊，皆破之。策甞攻祖郎，大爲所圍，普與一騎共蔽扞策，驅馬疾呼，以矛突賊，賊披，策因隨出。後拜盪寇中郎將，領零陵太守，從討劉勳於尋陽，進攻黃祖於沙羨，還鎮石城。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-055-chengpu:line014:m0000","start":0,"end":1,"surface":"堅","kind":"person","person_id":"ki7_rgz_3l4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0005","start":5,"end":7,"surface":"孫策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0024","start":24,"end":25,"surface":"策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0033","start":33,"end":35,"surface":"張英","kind":"person","person_id":"ql3_zdn_qpd","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengpu:line014:m0036","start":36,"end":38,"surface":"于麋","kind":"person","person_id":"77h_kqa_ghe","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-055-chengp