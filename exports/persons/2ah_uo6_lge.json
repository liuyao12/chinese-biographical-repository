ty_decisions":[{"id":"d-shiji007-044","person_id":"2ah_uo6_lge","surfaces":["侯公","平國君"],"scope":"same_chapter","chapter_ids":["c-shiji-007-xiangyu"],"status":"source_explicit","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p038","quote":"是時，漢兵盛食多，項王兵罷食絕。漢遣陸賈說項王，請太公，項王弗聽。漢王復使侯公往說項王，項王乃與漢約，中分天下，割鴻溝以西者為漢，鴻溝而東者為楚。項王許之，即歸漢王父母妻子。軍皆呼萬歲。漢王乃封侯公為平國君。匿弗肯復見。曰：「此天下辯士，所居傾國，故號為平國君。」項王已約，乃引兵解而東歸。"}],"rationale":"漢使侯公與平國君由封侯公為平國君明示；與前卷方士侯公不按同稱合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-007-xiangyu:p038","text":"是時，漢兵盛食多，項王兵罷食絕。漢遣陸賈說項王，請太公，項王弗聽。漢王復使侯公往說項王，項王乃與漢約，中分天下，割鴻溝以西者為漢，鴻溝而東者為楚。項王許之，即歸漢王父母妻子。軍皆呼萬歲。漢王乃封侯公為平國君。匿弗肯復見。曰：「此天下辯士，所居傾國，故號為平國君。」項王已約，乃引兵解而東歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m038-0009","start":9,"end":11,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m038-0018","start":18,"end":20,"surface":"陸賈","kind":"person","person_id":"fpv_2sb_uay","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m038-0021","start":21,"end":23,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m038-0025","start":25,"end":27,"surface":"太公","kind":"person","person_id":"yqp_nlb_p1p","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m038-0028","start":28,"end":30,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m038-0033","start":33,"end":35,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m038-0037","start":37,"end":39,"surface":"侯公","kind":"person","person_id":"2ah_uo6_lge","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m038-0041","start":41,"end":43,"surface":"項王","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-