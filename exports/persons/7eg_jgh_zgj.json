d":"c-jinshu-062-liukun:p003:m0049","surface":"杜育","start":49,"end":51,"person_id":"7eg_jgh_zgj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-062-liukun:p003","chapter_id":"c-jinshu-062-liukun"},{"id":"c-jinshu-069-liune:p001:m0058","surface":"杜方叔","start":58,"end":61,"person_id":"7eg_jgh_zgj","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-069-liune:p001","chapter_id":"c-jinshu-069-liune"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-gouxi:p012","text":"五年，帝復詔晞曰：「太傅信用奸佞，阻兵專權，內不遵奉皇憲，外不協比方州，遂令戎狄充斥，所在犯暴。留軍何倫抄掠宮寺，劫剝公主，殺害賢士，悖亂天下，不可忍聞。雖惟親親，宜明九伐。詔至之日，其宣告天下，率齊大舉，桓文之績，一以委公。其思盡諸宜，善建弘略。道澀，故練寫副，手筆示意。」晞表曰：「奉被手詔，委臣征討，喻以桓文，紙練兼備，伏讀跪歎，五情惶怛。自頃宰臣專制，委杖佞邪，內擅朝威，外殘兆庶，矯詔專征，遂圖不軌，縱兵寇掠，陵踐宮寺。前司隸校尉劉暾、御史中丞溫畿、右將軍杜育，並見攻劫。廣平、武安公主，先帝遺體，咸被逼辱。逆節虐亂，莫此之甚。輒祗奉前詔，部分諸軍，遣王贊率陳午等將兵詣項，龔行天罰。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":88,"last_line":88,"raw_start":6763,"raw_end":7063,"raw_character_offsets":[6765,6766,6767,6768,6769,6770,6771,6772,6773,6774,6775,6776,6777,6778,6779,6780,6781,6782,6783,6784,6785,6786,6787,6788,6789,6790,6791,6792,6793,6794,6795,6796,6797,6798,6799,6800,6801,6802,6803,6804,6805,6806,6807,6808,6809,6810,6811,6812,6813,6814,6815,6816,6817,6818,6819,6820,6821,6822,6823,6824,6825,6826,6827,6828,6829,6830,6831,6832,6833,6834,6835,6836,6837,6838,6839,6840,6841,6842,6843,6844,6845,6846,6847,6848,6849,6850,6851,6852,6853,6854,6855,6856,6857,6858,6859,6860,6861,6862,6863,6864,6865,6866,6867,6868,6869,6870,6871,6872,6873,6874,6875,6876,6877,6878,6879,6880,6881,6882,6883,6884,6885,6886,6887,6888,6889,6890,6891,6892,6893,6894,6895,6896,6897,6898,6899,6900,6901,6902,6903,6904,6905,6906,6907,6908,6909,6910,6911,6912,6913,6914,6915,6916,6917,6918,6919,6920,6921,6922,6923,6924,