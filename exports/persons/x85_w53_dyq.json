mentions":[{"id":"c-shiji-121-rulin:m004-0001","start":1,"end":4,"surface":"高皇帝","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p004","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m007-0008","start":8,"end":10,"surface":"高祖","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p007","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m007-0022","start":22,"end":24,"surface":"高祖","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p007","chapter_id":"c-shiji-121-rulin"},{"id":"c-shiji-121-rulin:m010-0218","start":218,"end":220,"surface":"高帝","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional","paragraph_id":"c-shiji-121-rulin:p010","chapter_id":"c-shiji-121-rulin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-121-rulin:p004","text":"及高皇帝誅項籍，舉兵圍魯，魯中諸儒尚講誦習禮樂，弦歌之音不絕，豈非聖人之遺化，好禮樂之國哉？故孔子在陳曰：「歸與！歸與！吾黨之小子狂簡，斐然成章，不知所以裁之。」夫齊魯之閒於文學，自古以來，其天性也。故漢興，然後諸儒始得修其經藝，講習大射鄉飲之禮。叔孫通作漢禮儀，因為太常，諸生弟子共定者，咸為選首，於是喟然嘆興於學。然尚有干戈，平定四海，亦未暇遑庠序之事也。孝惠、呂后時，公卿皆武力有功之臣。孝文時頗徵用，然孝文帝本好刑名之言。及至孝景，不任儒者，而竇太后又好黃老之術，故諸博士具官待問，未有進者。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m004-0001","start":1,"end":4,"surface":"高皇帝","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0005","start":5,"end":7,"surface":"項籍","kind":"person","person_id":"mtg_mtp_8oz","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0013","start":13,"end":17,"surface":"魯中諸儒","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0033","start":33,"end":35,"surface":"聖人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0047","start":47,"end":49,"surface":"孔子","kind":"person","person_id":"t0d_uf0_f2f","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0124","start":124,"end":127,"surface":"叔孫通","kind":"person","person_id":"o57_ilh_v3i","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0137","start":137,"end":141,"surface":"諸生弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0180","start":180,"end":182,"surface":"孝惠","kind":"person","person_id":"f2v_ue2_c9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0183","start":183,"end":185,"surface":"呂后","kind":"person","person_id":"neq_81h_l49","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0187","start":187,"end":189,"surface":"公卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m004-0197","start":197,"end":199,"surface":"孝文","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0205","start":205,"end":208,"surface":"孝文帝","kind":"person","person_id":"vz8_68e_j99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0217","start":217,"end":219,"surface":"孝景","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0226","start":226,"end":229,"surface":"竇太后","kind":"person","person_id":"r4k_my1_3w5","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m004-0237","start":237,"end":240,"surface":"諸博士","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p007","text":"申公者，魯人也。高祖過魯，申公以弟子從師入見高祖于魯南宮。呂太后時，申公游學長安，與劉郢同師。已而郢為楚王，令申公傅其太子戊。戊不好學，疾申公。及王郢卒，戊立為楚王，胥靡申公。申公恥之，歸魯，退居家教，終身不出門，復謝絕賓客，獨王命召之乃往。弟子自遠方至受業者百餘人。申公獨以詩經為訓以教，無傳（疑），疑者則闕不傳。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m007-0000","start":0,"end":2,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0008","start":8,"end":10,"surface":"高祖","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0013","start":13,"end":15,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0016","start":16,"end":18,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0019","start":19,"end":20,"surface":"師","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0022","start":22,"end":24,"surface":"高祖","kind":"person","person_id":"x85_w53_dyq","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0029","start":29,"end":32,"surface":"呂太后","kind":"person","person_id":"neq_81h_l49","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0034","start":34,"end":36,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0042","start":42,"end":44,"surface":"劉郢","kind":"person","person_id":"ibz_19q_kow","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0045","start":45,"end":46,"surface":"師","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0049","start":49,"end":50,"surface":"郢","kind":"person","person_id":"ibz_19q_kow","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0055","start":55,"end":57,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0059","start":59,"end":62,"surface":"太子戊","kind":"person","person_id":"ibz_19q_kow_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0063","start":63,"end":64,"surface":"戊","kind":"person","person_id":"ibz_19q_kow_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0069","start":69,"end":71,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0074","start":74,"end":75,"surface":"郢","kind":"person","person_id":"ibz_19q_kow","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0077","start":77,"end":78,"surface":"戊","kind":"person","person_id":"ibz_19q_kow_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0085","start":85,"end":87,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0088","start":88,"end":90,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m007-0110","start":110,"end":112,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0121","start":121,"end":123,"surface":"弟子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m007-0134","start":134,"end":136,"surface":"申公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p010","text":"清河王太傅轅固生者，齊人也。以治詩，孝景時為博士。與黃生爭論景帝前。黃生曰：「湯武非受命，乃弒也。」轅固生曰：「不然。夫桀紂虐亂，天下之心皆歸湯武，湯武與天下之心而誅桀紂，桀紂之民不為之使而歸湯武，湯武不得已而立，非受命為何？」黃生曰：「冠雖敝，必加於首；履雖新，必關於足。何者，上下之分也。今桀紂雖失道，然君上也；湯武雖聖，臣下也。夫主有失行，臣下不能正言匡過以尊天子，反因過而誅之，代立踐南面，非弒而何也？」轅固生曰：「必若所云，是高帝代秦即天子之位，非邪？」於是景帝曰：「食肉不食馬肝，不為不知味；言學者無言湯武受命，不為愚。」遂罷。是後學者莫敢明受命放殺者。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m010-0005","start":5,"end":8,"surface":"轅固生","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m010-0018","start":18,"end":20,"surface":"孝景","kind":"person","person_id":"8s8_8m3_upb","status":"contextual_prov