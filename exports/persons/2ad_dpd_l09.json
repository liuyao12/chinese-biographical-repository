orted_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-059-western-polities-complete:p033:m0209","start":209,"end":212,"surface":"劉洛羊","kind":"person","person_id":"2ad_dpd_l09","status":"contextual_provisional","paragraph_id":"c-nanqishu-059-western-polities-complete:p033","chapter_id":"c-nanqishu-059-western-polities-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-059-western-polities-complete:p033","text":"宕昌，羌種也。各有酋豪，領部眾汧、隴閒。宋末，宕昌王梁彌機為使持節、督河涼二州、安西將軍、東羌校尉、河涼二州刺史、隴西公。建元元年，太祖進號鎮西將軍。又征虜將軍、西涼州刺史羌王像舒彭亦進為持節、平西將軍。後叛降〔虜〕。永明元年，八座奏，前使持節、都督河涼二州軍事、鎮西將軍，東羌校尉、河涼二州刺史、隴西公、宕昌王梁彌機，前使持節、平北將軍、西涼州刺史、羌王像舒彭，竝著勤西垂，寧安邊境，可復先官爵。詔又可以隴右都帥羌王劉洛羊為輔國將軍。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":78,"last_line":78,"raw_start":5634,"raw_end":5882,"raw_character_offsets":[5634,5635,5636,5637,5638,5639,5640,5641,5642,5643,5644,5645,5646,5647,5648,5649,5650,5651,5652,5653,5654,5655,5656,5657,5658,5659,5660,5661,5662,5663,5664,5665,5666,5667,5668,5669,5670,5671,5672,5673,5674,5675,5676,5677,5678,5679,5680,5681,5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694,5695,5696,5697,5698,5699,5700,5701,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715,5716,5717,5718,5719,5720,5721,5722,5723,5724,5725,5726,5727,5728,5729,5730,5731,5732,5733,5734,5735,5736,5737,5738,5739,5740,5741,5742,5773,5774,5775,5776,5777,5778,5779,5780,5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,