白爽子弟不宜干犯法度，爽深納之，而罰其弟。除尚書郎。爽誅，免官。後為侍御史，襲父爵大利亭侯，累遷琅邪太守。宣帝為太傅，辟從事中郎，出為陽平太守，遷淮北都督、伏波將軍，甚有稱績。徵拜散騎常侍、大司農，遷吏部尚書，進封大梁侯。武帝受禪，以為都督沔北諸軍事、平南將軍、假節，給追鋒軺臥車各一乘、第二駙馬二乘、騎具刀器、禦府人馬鎧等，及錢三十萬。欽在鎮寬猛得中，疆埸無虞。入為尚書僕射，加侍中、奉車都尉，領吏部。以清貧，特賜絹百匹。欽舉必以材，稱為廉平。","raw_start":3351,"raw_end":3647,"raw_line":45},"chapter_id":"c-jinshu-044-luqin","book_id":"b-jinshu-044","work_id":"w-jinshu","source_id":"s-jinshu-044-luqin"}],"sources":[{"chapter_id":"c-jinshu-044-luqin","work_id":"w-jinshu","book_id":"b-jinshu-044","source_id":"s-jinshu-044-luqin","source":{"title":"晉書卷四十四","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1775345","permalink":"https://zh.wikisource.org/w/index.php?oldid=1775345","revision_id":1775345,"accessed_on":"2026-11-21","extent":"固定數位題「盧欽」題下全文。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代本文及維基文庫數位轉錄。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫固定修訂1775345","raw_path":"sources/jinshu/wikisource-1775345-raw.wikitext","wikitext_sha256":"09742e651b479fea881fd24c7734451de2b78b9f0410adda36ba210c31a0b5c8","raw_file_sha256":"09742e651b479fea881fd24c7734451de2b78b9f0410adda36ba210c31a0b5c8","collation_witnesses":["source-evidence/jin044-luqin-lufu-luting/reading.json"]}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
