er","mentions":[{"id":"c-shiji-007-xiangyu:m003-0000","start":0,"end":3,"surface":"秦二世","kind":"person","person_id":"ao3_0fy_d45_AAAA","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0008","start":8,"end":10,"surface":"陳涉","kind":"person","person_id":"pom_ycp_ha5","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0020","start":20,"end":24,"surface":"會稽守通","kind":"person","person_id":"32m_9wz_1y5","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0025","start":25,"end":26,"surface":"梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0065","start":65,"end":67,"surface":"桓楚","kind":"person","person_id":"0ri_3st_fjq","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0072","start":72,"end":74,"surface":"桓楚","kind":"person","person_id":"0ri_3st_fjq","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0079","start":79,"end":80,"surface":"梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0083","start":83,"end":85,"surface":"桓楚","kind":"person","person_id":"0ri_3st_fjq","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0094","start":94,"end":95,"surface":"籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0100","start":100,"end":101,"surface":"梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0105","start":105,"end":106,"surface":"籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0112","start":112,"end":113,"surface":"梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m003-0117","start":117,"end":118,"surface":"守","kind":"person","person_id":"32m_9wz_1y5","status":"contextual_provisional"},{"id":"c-shiji-007-x