rfaces":["盜跖"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p024","quote":"共承嘉惠兮，俟罪長沙。側聞屈原兮，自沈汨羅。造讬湘流兮，敬弔先生。遭世罔極兮，乃隕厥身。嗚呼哀哉，逢時不祥！鸞鳳伏竄兮，鴟梟翺翔：闒茸尊顯兮，讒諛得志；賢聖逆曳兮，方正倒植。世謂伯夷貪兮，謂盜跖廉；莫邪為頓兮，鉛刀為銛。于嗟嚜嚜兮，生之無故！斡棄周鼎兮寶康瓠，騰駕罷牛兮驂蹇驢，驥垂兩耳兮服鹽車。章甫薦屨兮，漸不可久；嗟苦先生兮，獨離此咎！"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p024","text":"共承嘉惠兮，俟罪長沙。側聞屈原兮，自沈汨羅。造讬湘流兮，敬弔先生。遭世罔極兮，乃隕厥身。嗚呼哀哉，逢時不祥！鸞鳳伏竄兮，鴟梟翺翔：闒茸尊顯兮，讒諛得志；賢聖逆曳兮，方正倒植。世謂伯夷貪兮，謂盜跖廉；莫邪為頓兮，鉛刀為銛。于嗟嚜嚜兮，生之無故！斡棄周鼎兮寶康瓠，騰駕罷牛兮驂蹇驢，驥垂兩耳兮服鹽車。章甫薦屨兮，漸不可久；嗟苦先生兮，獨離此咎！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m024-0013","start":13,"end":15,"surface":"屈原","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m024-0030","start":30,"end":32,"surface":"先生","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m024-0071","start":71,"end":73,"surface":"讒諛","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m024-0076","start":76,"end":78,"surface":"賢聖","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未能逐一辨識的後裔，保留原稱，不補造姓名與闕代。"},{"id":"c-shiji-084-qujia:m024-0089","start":89,"end":91,"surface":"伯夷","kind":"person","person_id":"5zv_8nc_ifz","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m024-0095","start":95,"end":97,"surface":"盜跖","kind":"person","person_id":"xu5_0nl_f5z","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m024-0161","start":161,"end":163,"surface":"先生","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"}],"sources":[{"chapter_id":"c-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","source":{"title":"史記／卷084","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷084","