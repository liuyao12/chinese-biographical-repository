{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002830","identity_policy":"contextual_provisional","person_ids":["cbr-p002830"],"persons":[{"id":"cbr-p002830","label":"正考父（孔子世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"正考父","mention_ids":["c-shiji-047-kong:m004-0051"]},{"surface":"正考","mention_ids":["c-shiji-047-kong:m086-0015"]}],"evidence":[{"mention_id":"c-shiji-047-kong:m004-0051","chapter_id":"c-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p004","quote":"正考父"},{"mention_id":"c-shiji-047-kong:m086-0015","chapter_id":"c-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p086","quote":"正考"}]}],"mentions":[{"id":"c-shiji-047-kong:m004-0051","start":51,"end":54,"surface":"正考父","kind":"person","person_id":"cbr-p002830","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p004","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m086-0015","start":15,"end":17,"surface":"正考","kind":"person","person_id":"cbr-p002830","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p086","chapter_id":"c-shiji-047-kong"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji047-008","person_id":"cbr-p002830","surfaces":["正考","正考父"],"scope":"same_chapter","chapter_ids":["c-shiji-047-kong"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-047-kong:p004","quote":"孔子年十七，魯大夫孟釐子病且死，誡其嗣懿子曰：「孔丘，聖人之後，滅於宋。其祖弗父何始有宋而嗣讓厲公。及正考父佐戴、武、宣公，三命茲益恭，故鼎銘云：『一命而僂，再命而傴，三命而俯，循牆而走，亦莫敢余侮。饘於是，粥於是，以餬余口。』其恭如是。吾聞聖人之後，雖不當世，必有達者。今孔丘年少好禮，其達者歟？吾即沒，若必師之。」及釐子卒，懿子與魯人南宮敬叔往學禮焉。是歲，季武子卒，平子代立。"},{"paragraph_id":"c-shiji-047-kong:p086","quote":"孔子之胄，出于商國。弗父能讓，正考銘勒。防叔來奔，鄒人掎足。尼丘誕聖，闕里生德。七十升堂，四方取則。卯誅兩觀，攝相夾谷。歌鳳遽衰，泣麟何促！九流仰鏡，萬古欽躅。"}],"rationale":"限本篇明示名、字、對話自稱、世系及附贊局部對應；世系求與冉求分開，武不接漢武帝，今皇帝與高皇帝不補姓名。子路仲由明示同指另存，冉有冉求與秦繆秦穆仍待核；附贊不當獨立作者正文或獨立見證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"