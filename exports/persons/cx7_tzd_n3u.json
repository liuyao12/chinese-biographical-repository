ed","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-050-liuqianzhi-qian:p001:m0096","start":96,"end":99,"surface":"孫長庸","kind":"person","person_id":"cx7_tzd_n3u","status":"contextual_provisional","paragraph_id":"c-songshu-050-liuqianzhi-qian:p001","chapter_id":"c-songshu-050-liuqianzhi-qian"}],"relations":[],"title_holdings":[{"id":"th-songshu-050-liuqianzhi-qian-1-94","title":"參軍","kind":"office","mode":"attestation","person_id":"cx7_tzd_n3u","attestations":[{"id":"th-songshu-050-liuqianzhi-qian-1-94:a","paragraph_id":"c-songshu-050-liuqianzhi-qian:p001","start":94,"end":96,"surface":"參軍","person_mention_id":"c-songshu-050-liuqianzhi-qian:p001:m0096","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-050","chapter_id":"c-songshu-050-liuqianzhi-qian","source_id":"s-songshu-050-liuqianzhi-qian-ws2371899","paragraph_id":"c-songshu-050-liuqianzhi-qian:p001","quote":"虔之誕節，不營產業，輕財好施。高祖西征司馬休之、魯宗之等，遣參軍檀道濟、朱超石步騎出襄陽，虔之時為江夏相，率府郡兵力出溳城，屯三連，立橋聚糧以待。道濟等積日不至，為宗之子軌所襲，眾寡不敵。參軍孫長庸流涕勸退軍，虔之厲色曰：「我仗順伐罪，理無不克。如其不幸，命也。」戰敗見殺，追贈梁、秦二州刺史，封新康縣男，食邑五百戶。","person_mention_id":"c-songshu-050-liuqianzhi-qian:p001:m0096"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-050-liuqianzhi-qian:p001","text":"虔之誕節，不營產業，輕財好施。高祖西征司馬休之、魯宗之等，遣參軍檀道濟、朱超石步騎出襄陽，虔之時為江夏相，率府郡兵力出溳城，屯三連，立橋聚糧以待。道濟等積日不至，為宗之子軌所襲，眾寡不敵。參軍孫長庸流涕勸退軍，虔之厲色曰：「我仗順伐罪，理無不克。如其不幸，命也。」戰敗見殺，追贈梁、秦二州刺史，封新康縣男，食邑五百戶。","text_layer":"received_chapter","annotation_status"