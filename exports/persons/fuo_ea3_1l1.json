preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-huanwen:p023:m0036","start":36,"end":39,"surface":"矯陽之","kind":"person","person_id":"fuo_ea3_1l1","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-098-huanwen:p023","chapter_id":"c-jinshu-098-huanwen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-huanwen:p023","text":"袁真病死，其將朱輔立其子瑾以嗣事。慕容暐、苻堅並遣軍授瑾，溫使督護竺瑤、矯陽之等與水軍擊之。時暐軍已至，瑤等與戰于武丘，破之。溫率二萬人自廣陵又至，瑾嬰城固守，溫築長圍守之。苻堅乃使其將王鑒、張蠔等率兵以救瑾，屯洛澗，先遣精騎五千次於肥水北。溫遣桓伊及弟子石虔等逆擊，大破之，瑾眾遂潰，生擒之，並其宗族數十人及硃輔送於京都而斬之，所侍養乞活數百人悉坑之，以妻子為賞。溫以功，詔加班劍十人，犒軍于路次，文武論功賞賜各有差。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2614273-raw.wikitext","raw_start":12900,"raw_end":13110,"character_positions":[12900,12901,12902,12903,12904,12905,12906,12907,12908,12909,12910,12911,12912,12913,12914,12915,12916,12917,12918,12919,12920,12921,12922,12923,12924,12925,12926,12927,12928,12929,12930,12931,12932,12933,12934,12935,12936,12937,12938,12939,12940,12941,12942,12943,12944,12945,12946,12947,12948,12949,12950,12951,12952,12953,12954,12955,12956,12957,12958,12959,12960,12961,12962,12963,12964,12965,12966,12967,12968,12969,12970,12971,12972,12973,12974,12975,12976,12977,12978,12979,12980,12981,12982,12983,12984,12985,12986,12987,12988,12989,12990,12991,12992,12993,12994,12995,12996,12997,12998,12999,13000,13001,13002,13003,13004,13005,13006,13007,13008,13009,13010,13011,13012,13013,13014,13015,13016,13017,13018,13019,13020,13021,13022,13023,13024,13025,13026,13027,13028,13029,13030,13031,13032,13033,13034,13035,13036,13037,13038,13039,13040,13041,13042,13043,13044,13045,13046,13047,13048,13049,13050,13051,13052,13053,13054,13055