e":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangqiu-lu-ws2478204","chapter_id":"c-nanshi-023-wangqiu-lu","paragraph_id":"c-nanshi-023-wangqiu-lu:p001","quote":"球字蒨玉，司徒謐之子、惠從父弟也，少與惠齊名。宋武帝受命，為太子中舍人，宜都王友，轉諮議參軍。文帝即位，王弘兄弟貴動朝廷，球終日端拱，未嘗相往來，弘亦雅敬之。歷位侍中，中書令，吏部尚書。時中書舍人徐爰有寵於上，上嘗命球及殷景仁與之相知。球辭曰：「士庶區別，國之章也。臣不敢奉詔。」上改容謝焉。","person_mention_id":"c-nanshi-023-wangqiu-lu:p001:m0098"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-nanshi-023-wangqiu-lu:p001:r0114","surface":"之","start":114,"end":115,"person_id":"rq3_n56_efd","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangqiu-lu:p001","quote":"球字蒨玉，司徒謐之子、惠從父弟也，少與惠齊名。宋武帝受命，為太子中舍人，宜都王友，轉諮議參軍。文帝即位，王弘兄弟貴動朝廷，球終日端拱，未嘗相往來，弘亦雅敬之。歷位侍中，中書令，吏部尚書。時中書舍人徐爰有寵於上，上嘗命球及殷景仁與之相知。球辭曰：「士庶區別，國之章也。臣不敢奉詔。」上改容謝焉。","note":"依說話人、所指者及本卷時序。","chapter_id":"c-nanshi-023-wangqiu-lu","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangqiu-lu-ws2478204"},{"id":"c-nanshi-023-wangyu-jingwen:p008:r0019","surface":"徐","start":19,"end":20,"person_id":"rq3_n56_efd","referent_role":"third_person","paragraph_id":"c-nanshi-023-wangyu-jingwen:p008","quote":"人居貴要，但問心若為耳。大明之世，巢、徐二戴位不過執戟，權亢人主；顏師伯白衣僕射，橫行尚書中。袁粲作僕射領選，而人往往不知有粲。粲遷為令，居之不疑。今既省錄，令便居昔之錄任，置省事及幹僮，並依錄格。粲作令來亦不異為僕射，人情向粲，淡然亦復不改常。以此居貴位要任，當有致憂兢不？卿今雖作揚州、太子太傅，位雖貴而不關朝政，可安不懼，差於粲也。卿虛心受榮，有而不為累。貴高有危殆之懼，卑賤有溝壑之憂，張單雙災，木雁兩失。有心于避禍，不如無心于任運。夫千仞之木，既摧於斧斤，一寸之草，亦悴於踐蹋。高崖之修幹，與深谷之淺條，存亡之要，巨細一揆耳。晉將畢萬七戰皆獲，死於牖下，蜀相費禕從容坐談，斃于刺客。故甘心于履危，未必逢禍，縱意于處安，不必全福。但貴者自惜，故每憂其身，賤者自輕，故易忘其己。然為教者每誡貴不誡賤，言其貴滿好自恃也。凡名位貴達，人以存懷，泰則觸人改容，否則行路嗟愕。至如賤者，否泰不足以動人，存亡不足以絓數，死於溝瀆，困于塗路者，天地之間，亦復何限，人不系意耳。以此而推，貴何必難處，賤何必易安。但人生自應卑慎為道，行己用心，務思謹惜。","note":"按說話人、受話人及詔內上下文。","chapter_id":"c-nanshi-023-wangyu-jingwen","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangyu-jingwen-ws2478204"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-023-wangqiu-lu:p001","text":"球字蒨玉，司徒謐之子、惠從父弟也，少與惠齊名。宋武帝受命，為太子中舍人，宜都王友，轉諮議參軍。文帝即位，王弘兄弟貴動朝廷，球終日端拱，未嘗相往來，弘亦雅敬之。歷位侍中，中書令，吏部尚書。時中書舍人徐爰有寵於上，上嘗命球及殷景仁與之相知。球辭曰：「士庶區別，國之章也。臣不敢奉詔。」上改容謝焉。","mentions":[{"id":"c-nanshi-023-wangqiu-lu:p001:m0000","surface":"球","start":0,"end":1,"person_id":"3c9_d1d_870_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p001:m0002","surface":"蒨玉","start":2,"end":4,"person_id":"3c9_d1d_870_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p001:m0007","surface":"謐","start":7,"end":8,"person_id":"3c9_d1d_870","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p001:m0011","surface":"惠","start":11,"end":12,"person_id":"7r6_k52_qji_ABAAEEB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p001:m0019","surface":"惠","start":19,"end":20,"person_id":"7r6_k52_qji_ABAAEEB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p001:m0052","surface":"王弘","start":52,"end":54,"person_id":"7r6_k52_qji_ABAAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p001:m0061","surface":"球","start":61,"end":62,"person_id":"3c9_d1d_870_B","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p001:m0073","surface":"弘","start":73,"end":74,"person_id":"7r6_k52_qji_ABAAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangqiu-lu:p001:m0098","surface":"徐爰","start":98,"end":100,"person_id":"rq3_n56_efd","kind":"person","status":"contextual_provisional","interpretati