，便程西成。夜中，星虛，以正中秋。其民夷易，鳥獸毛毨。申命和叔，居北方，曰幽都。便在伏物。日短，星昴，以正中冬。其民燠，鳥獸氄毛。歲三百六十六日，以閏月正四時。信飭百官，衆功皆興。","mentions":[{"id":"c-shiji-001-wudi:m012-0002","start":2,"end":5,"surface":"羲、和","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m012-0025","start":25,"end":27,"surface":"羲仲","kind":"person","person_id":"dcp_1gr_65s","status":"source_identified"},{"id":"c-shiji-001-wudi:m012-0068","start":68,"end":70,"surface":"羲叔","kind":"person","person_id":"drx_32r_pdh","status":"source_identified"},{"id":"c-shiji-001-wudi:m012-0105","start":105,"end":107,"surface":"和仲","kind":"person","person_id":"ycy_hv8_q6d","status":"source_identified"},{"id":"c-shiji-001-wudi:m012-0149","start":149,"end":151,"surface":"和叔","kind":"person","person_id":"pen_hn0_sk9","status":"source_identified"}],"chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"}],"sources":[{"chapter_id":"c-shiji-001-wudi","work_id":"w-shiji","book_id":"b-shiji-001","source_id":"s-shiji-001-wudi","source":{"title":"史記／卷001","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷001","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷001&oldid=7903634","revision_id":7903634,"accessed_on":"2026-10-09","extent":"正文全文；不含現代章節標題、跨維基說明與校勘記","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及版本連結。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"弃":"棄","异":"異"},"note":"保留古代異體；移除現代註號，兩個簡體字形明記轉換。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
