ntions":[{"id":"c-jinshu-071-sunhui:p001:m0228","surface":"梁俊","start":228,"end":230,"person_id":"4wr_5ab_eli","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-071-sunhui:p001","chapter_id":"c-jinshu-071-sunhui"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-071-sunhui:p001","text":"孫惠，字德施，吳國富陽人，吳豫章太守賁曾孫也。父祖並仕吳。惠口訥，好學有才識，州辟不就，寓居蕭沛之間。永甯初，赴齊王冏義，討趙王倫，以功封晉興縣侯，辟大司馬戶曹掾，轉東曹屬。冏驕矜僭侈，天下失望。惠獻言於冏，諷以五難、四不可，勸令歸籓，辭甚切至。冏不納。惠懼罪，辭疾去。頃之，冏果敗。成都王穎薦惠為大將軍參軍、領奮威將軍、白沙督。是時，穎將征長沙王乂，以陸機為前鋒都督。惠與機同鄉里，憂其致禍，勸機讓都督于王粹。及機兄弟被戮，惠甚傷恨之。時惠又擅殺穎牙門將梁俊，懼罪，因改姓名以遁。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":10,"last_line":10,"raw_start":167,"raw_end":408,"raw_character_offsets":[167,168,169,170,171,172,173,174,175,176,177,178,179,180,181,182,183,184,185,186,187,188,189,190,191,192,193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211,212,213,214,215,216,217,218,219,220,221,222,223,224,225,226,227,228,229,230,231,232,233,234,235,236,237,238,239,240,241,242,243,244,245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260,261,262,263,264,265,266,267,268,269,270,271,272,273,274,275,276,277,278,279,280,281,282,283,284,285,286,287,288,289,290,291,292,293,294,295,296,297,298,299,300,301,302,303,304,305,306,307,308,309,310,311,312,313,314,315,316,317,318,319,320,321,322,323,324,325,326,327,328,329,330,331,332,333,334,335,336,337,338,339,340,341,342,343,344,345,346,347,348,349,350,351,352,353,354,355,356,357,358,359,360,361,362,363,364,365,366,367,368,369,370,371,372,373,374,375,376,377,378,379,380,381,382,383,384,385,386,387,388,389,390,391,392,393,394,395,396,397,398,399,400,401,402,403,404,405,406,407],"revision_id":2595541},"mentions":[{"id":"c-jinshu-071-sunhui:p001:m0000","surface":"孫惠","start":0,"end":