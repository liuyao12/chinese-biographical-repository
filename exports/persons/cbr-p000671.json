us":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m011-0580","start":580,"end":583,"surface":"蒲將軍","kind":"person","person_id":"cbr-p000657","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m011-0585","start":585,"end":587,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:p012","text":"項羽已殺卿子冠軍，威震楚國，名聞諸侯。乃遣當陽君、蒲將軍將卒二萬渡河，救鉅鹿。戰少利，陳餘復請兵。項羽乃悉引兵渡河，皆沈船，破釜甑，燒廬舍，持三日糧，以示士卒必死，無一還心。於是至則圍王離，與秦軍遇，九戰，絕其甬道，大破之，殺蘇角，虜王離。涉閒不降楚，自燒殺。當是時，楚兵冠諸侯。諸侯軍救鉅鹿下者十餘壁，莫敢縱兵。及楚擊秦，諸將皆從壁上觀。楚戰士無不一以當十，楚兵呼聲動天，諸侯軍無不人人惴恐。於是已破秦軍，項羽召見諸侯將，入轅門，無不膝行而前，莫敢仰視。項羽由是始為諸侯上將軍，諸侯皆屬焉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m012-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0004","start":4,"end":8,"surface":"卿子冠軍","kind":"person","person_id":"cbr-p000671","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0021","start":21,"end":24,"surface":"當陽君","kind":"person","person_id":"cbr-p000680","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0025","start":25,"end":28,"surface":"蒲將軍","kind":"person","person_id":"cbr-p000657","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0043","start":43,"end":45,"surface":"陳餘","kind":"person","person_id":"cbr-p000675","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0049","start":49,"end":51,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0092","start":92,"end":94,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0113","start":113,"end":115,"surface":"蘇角","kind":"person","person_id":"cbr-p000681","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0117","start":117,"end":119,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0120","start":120,"end":122,"surface":"涉閒","kind":"person","person_id":"cbr-p000677","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0162","start":162,"end":164,"surface":"諸將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或短稱尚待逐處覆核；不補姓名或推造個別成員。"},{"id":"c-shiji-007-xiangyu:m012-0204","start":204,"end":206,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m012-0208","start":208,"end":211,"surface":"諸侯將","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱或短稱尚待逐處覆核；不補姓名或推造個別成員。"},{"id":"c-shiji-007-xiangyu:m012-0228","start":228,"end":230,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:p014","text":"項梁再破秦軍，有驕色。宋義諫，不聽。秦益章邯兵，夜銜枚擊項梁，大破之定陶，項梁死。沛公與項羽方攻陳留，聞項梁死，引兵與呂將軍俱東。呂臣軍彭城東，項羽軍彭城西，沛公軍碭。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m014-0000","start":0,"end":2,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0011","start":11,"end":13,"surface":"宋義","kind":"person","person_id":"cbr-p000671","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0020","start":20,"end":22,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0028","start":28,"end":30,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0037","start":37,"end":39,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0041","start":41,"end":43,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0044","start":44,"end":46,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0052","start":52,"end":54,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0059","start":59,"end":62,"surface":"呂將軍","kind":"person","person_id":"cbr-p000673","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0065","start":65,"end":67,"surface":"呂臣","kind":"person","person_id":"cbr-p000673","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0072","start":72,"end":74,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m014-0079","start":79,"end":81,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p017","text":"趙數請救，懷王乃以宋義為上將軍，項羽為次將，范增為末將，北救趙。令沛公西略地入關。與諸將約，先入定關中者王之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m017-0005","start":5,"end":7,"surface":"懷王","kind":"person","person_id":"cbr-p000682","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m017-0009","start":9,"end":11,"surface":"宋義","kind":"person","person_id":"cbr-p000671","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m017-0016","start":16,"end":18,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m017-0022","start":22,"end":24,"surface":"范增","kind":"person","person_id":"cbr-p000663","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m017-0033","start":33,"end":35,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p021","text":"初，項羽與宋義北救趙，及項羽殺宋義，代為上將軍，諸將黥布皆屬，破秦將王離軍，降章邯，諸侯皆附。及趙高已殺二世，使人來，欲約分王關中。沛公以為詐，乃用張良計，使酈生、陸賈往說秦將，啗以利，因襲攻武關，破之。又與秦軍戰於藍田南，益張疑兵旗幟，諸所過毋得掠鹵，秦人喜，秦軍解，因大破之。又戰其北，大破之。乘勝，遂破之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m021-0002","start":2,"end":4,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0005","start":5,"end":7,"surface":"宋義","kind":"person","person_id":"cbr-p000671","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0012","start":12,"end":14,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0015","start":15,"end":17,"surface":"宋義","kind":"person","person_id":"cbr-p000671","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0026","start":26,"end":28,"surface":"黥布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0034","start":34,"end":36,"surface":"王離","kind":"person","person_id":"cbr-p000575","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0039","start":39,"end":41,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0048","start":48,"end":50,"surface":"趙高","kind":"person","person_id":"cbr-p000535","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0052","start":52,"end":54,"surface":"二世","kind":"person","person_id":"cbr-p000534","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0066","start":66,"end":68,"surface":"沛公","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0074","start":74,"end":76,"surface":"張良","kind":"person","person_id":"cbr-p000687","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0079","start":79,"end":81,"surface":"酈生","kind":"person","person_id":"cbr-p000764","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m021-0082","start":82,"end":84,"surface":"陸賈","kind":"person","person_id":"cbr-p000733","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-008-gaozu:p048","text":"楚漢久相持未決，丁壯苦軍旅，老弱罷轉饢。漢王項羽相與臨廣武之閒而語。項羽欲與漢王獨身挑戰。漢王數項羽曰：「始與項羽俱受命懷王，曰先入定關中者王之，項羽負約，王我於蜀漢，罪一。秦項羽矯殺卿子冠軍而自尊，罪二。項羽已救趙，當還報，而擅劫諸侯兵入關，罪三。懷王約入秦無暴掠，項羽燒秦宮室，掘始皇帝冢，私收其財物，罪四。又彊殺秦降王子嬰，罪五。詐阬秦子弟新安二十萬，王其將，罪六。項羽皆王諸將善地，而徙逐故主，令臣下爭叛逆，罪七。項羽出逐義帝彭城，自都之，奪韓王地，并王梁楚，多自予，罪八。項羽使人陰弒義帝江南，罪九。夫為人臣而弒其主，殺已降，為政不平，主約不信，天下所不容，大逆無道，罪十也。吾以義兵從諸侯誅殘賊，使刑餘罪人擊殺項羽，何苦乃與公挑戰！」項羽大怒，伏弩射中漢王。漢王傷匈，乃捫足曰：「虜中吾指！」漢王病創臥，張良彊請漢王起行勞軍，以安士卒，毋令楚乘勝於漢。漢王出行軍，病甚，因馳入成皋。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m048-0020","start":20,"end":22,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m048-0022","start":22,"end":24,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m048-0034","start":34,"end":36,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m048-0038","start":38,"end":40,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m048-0045","start":45,"end":47,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m048-0048","start":48,"end":50,"surface":"項羽","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-008-gao