ter_id":"c-shiji-060-sanwang"}],"relations":[{"id":"a-shiji060-013","subject_person_id":"cbr-p003672","predicate":"ancestor","object_person_id":"cbr-p003671","status":"source_attested","evidence":[{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p027","quote":"其後胥果作威福，通楚王使者。楚王宣言曰：「我先元王，高帝少弟也，封三十二城。今地邑益少，我欲與廣陵王共發兵云。［立］廣陵王為上，我復王楚三十二城，如元王時。」事發覺，公卿有司請行罰誅。天子以骨肉之故，不忍致法於胥，下詔書無治廣陵王，獨誅首惡楚王。傳曰「蓬生麻中，不扶自直；白沙在泥中，與之皆黑」者，土地教化使之然也。其後胥復祝詛謀反，自殺，國除。"}],"qualifiers":{"source_term":"我先元王","historicity":"historical_tradition"},"interpretation_note":"依立子、生子、四子／兩子、少弟及祖先自稱保存來源主張；不同位階的子字不互換，祖先不作直接父親，未名侯子不補姓名。宗正陳昭帝為武帝子與旦指大將軍子的引語分辨，指控不當已確證生平。楚王所稱先元王保留自稱性，不補闕代或爵位三十二城。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji060-040","person_id":"cbr-p003672","surfaces":["楚王"],"scope":"same_chapter","chapter_ids":["c-shiji-060-sanwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-060-sanwang:p027","quote":"其後胥果作威福，通楚王使者。楚王宣言曰：「我先元王，高帝少弟也，封三十二城。今地邑益少，我欲與廣陵王共發兵云。［立］廣陵王為上，我復王楚三十二城，如元王時。」事發覺，公卿有司請行罰誅。天子以骨肉之故，不忍致法於胥，下詔書無治廣陵王，獨誅首惡楚王。傳曰「蓬生麻中，不扶自直；白沙在泥中，與之皆黑」者，土地教化使之然也。其後胥復祝詛謀反，自殺，國除。"}],"rationale":"按明示奏議署稱、封策、三王敘事與局部帝稱暫接；光與安依職事先分候選，單名不補姓。王夫人閎母與三王子嗣依來源所見稱謂，請議與實授、指控與史實分辨，原文及傳承限制保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-060-sanwang:p027","text":"其後胥果作威福，通楚王使者。楚王宣言曰：「我先元王，高帝少弟也，封三十二城。今地邑益少，我欲與廣陵王共發兵云。［立］廣陵王為上，我復王楚三十二城，如元王時。」事發覺，公卿有司請行罰誅。天子以骨肉之故，不忍致法於胥，下詔書無治廣陵王，獨誅首惡楚王。傳曰「蓬生麻中，不扶自直；白沙在泥中，與之皆黑」者，土地教化使之然也。其後胥復祝詛謀反，自殺，國除。","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_chu_note","mentions":[{"id":"c-shiji-060-sanwang:m027-0002","start":2,"end":3,"surface":"胥","kind":"person","person_id":"cbr-p003649","status":"contextual_provisional"},{"id":"c-shiji-060-sanwang:m027-0009","start":9,"end":11,"surface":"楚王","kind":"person","person_id":"cbr-p003672","