_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"b41_78d_047","title":null,"surname":"劉","ming":"固","additional_names":[],"chapter_id":"c-sanguozhi-027-wangchang","paragraph_id":"c-sanguozhi-027-wangchang:unit016","quote":"昭先名嘏别傳曰嘏樂安博昌人世為著姓夙智早成故鄉人為之語曰蔣氏翁任氏童父旐字子旟以至行稱漢末黄巾賊起天下饑荒人民相食寇到博昌聞旐姓字乃相謂曰宿聞任子旟天下賢人也今雖作賊那可入其鄉邪遂相帥而去由是聲聞逺近州郡並招舉孝廉歴酸棗祝阿令嘏八嵗喪母號泣不絶聲自然之哀同於成人故㓜以至性見稱年十四始學疑不再問三年中誦五經皆究其義兼包羣言無不綜覧於時學者號之神童遂遇荒亂家貧賣魚㑹官税魚魚貴數倍嘏取直如常又與人共買生口各雇八匹後生口家來贖時價直六十匹共買者欲随時價取贖嘏自取本價八匹共買者慙亦還取本價比居者擅耕嘏地數十畝種之人以語嘏嘏曰我自以借之耳耕者聞之慙謝還地及邑中爭訟皆詣嘏質之然後意厭其子弟有不順者父兄竊數之曰汝所行豈可令任君知邪其禮教所化率皆如此㑹太祖創業召海内至徳嘏應其舉為臨菑侯庶子相國東曹屬尚書郎文帝時為黄門侍郎每納忠言輒手書懐本自在禁省歸書不封帝嘉其淑慎累遷東郡趙郡河東太守所在化行有遺風餘教嘏為人淳粹愷悌虛己若不足恭敬如有畏其脩身履義皆沉黙潛行不顯其美故時人少得稱之著書三十八篇凡四萬餘言嘏卒後故吏東郡程威趙國劉固河東上官崇等錄其事行及所著書奏之詔下祕書以貫羣言","note":"本源姓名構件追加出處，不覆寫既有主名、姓或字；異體各存。","status":"editorial_provisional","human_reviewed":false,"source_proposal_id":"proposal-wang34-026","work_id":"w-sanguozhi","book_id":"b-sanguozhi-027","source_id":"s-sanguozhi-027-wangchang"}],"mentions":[{"id":"c-sanguozhi-027-wangchang:unit016:m0457","start":457,"end":459,"surface":"劉固","kind":"person","person_id":"b41_78d_047","status":"contextual_provisional","interpretation_note":"依本完整敘事與固定平行語境辨識；原稱保留。","paragraph_id":"c-sanguozhi-027-wangchang:unit016","chapter_id":"c-sanguozhi-027-wangchang"}],"relations":[],"title_holdings":[],"address_assertions":[{"id":"pa-wang35-101","person_id":"b41_78d_047","relation":"source_locality_designation","place":{"source_name":"趙國","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"source_term":"趙國劉固","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-027","source_id":"s-sanguozhi-027-wangchang","chapter_id":"c-sanguozhi-027-wangchang","paragraph_id":"c-sanguozhi-027-wangchang:unit016","quote":"昭先名嘏别傳曰嘏樂安博昌人世為著姓夙智早成故鄉人為之語曰蔣氏翁任氏童父旐字子旟以至行稱漢末黄巾賊起天下饑荒人民相食寇到博昌聞旐姓字乃相謂曰宿聞任子旟天下賢人也今雖作賊那可入其鄉邪遂相帥而去由是聲聞逺近州郡並招舉孝廉歴酸棗祝阿令嘏八嵗喪母號泣不絶聲自然之哀同於成人故㓜以至性見稱年十四始學疑不再問三年中誦五經皆究其義兼包羣言無不綜覧於時學者號之神童遂遇荒亂家貧賣魚㑹官税魚魚貴數倍嘏取直如常又與人共買生口各雇八匹後生口家來贖時價直六十匹共買者欲随時價取贖嘏自取本價八匹共買者慙亦還取本價比居者擅耕嘏地數十畝種之人以語嘏嘏曰我自以借之耳耕者聞之慙謝還地及邑中爭訟皆詣嘏質之然後意厭其子弟有不順者父兄竊數之曰汝所行豈可令任君知邪其禮教所化率皆如此㑹太祖創業召海内至徳嘏應其舉為臨菑侯庶子相國東曹屬尚書郎文帝時為黄門侍郎每納忠言輒手書懐本自在禁省歸書不封帝嘉其淑慎累遷東郡趙郡河東太守所在化行有遺風餘教嘏為人淳粹愷悌虛己若不足恭敬如有畏其脩身履義皆沉黙潛行不顯其美故時人少得稱之著書三十八篇凡四萬餘言嘏卒後故吏東郡程威趙國劉固河東上官崇等錄其事行及所著書奏之詔下祕書以貫羣言","person_mention_id":"c-sanguozhi-027-wangchang:unit016:m0457"}],"interpretation_note":"原籍、來源地域稱法與任所分開；不作出生地、不補現代定位、不從故吏地名補官。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"qualifiers":{"designation_kind":"geographical_person_reference","origin_or_residence":null}}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-027-wangchang:unit016","text":"昭先名嘏别傳曰嘏樂安博昌人世為著姓夙智早成故鄉人為之語曰蔣氏翁任氏童父旐字子旟以至行稱漢末黄巾賊起天下饑荒人民相食寇到博昌聞旐姓字乃相謂曰宿聞任子旟天下賢人也今雖作賊那可入其鄉邪遂相帥而去由是聲聞逺近州郡並招舉孝廉歴酸棗祝阿令嘏八嵗喪母號泣不絶聲自然之哀同於成人故㓜以至性見稱年十四始學疑不再問三年中誦五經皆究其義兼包羣言無不綜覧於時學者號之神童遂遇荒亂家貧賣魚㑹官税魚魚貴數倍嘏取直如常又與人共買生口各雇八匹後生口家來贖時價直六十匹共買者欲随時價取贖嘏自取本價八匹共買者慙亦還取本價比居者擅耕嘏地數十畝種之人以語嘏嘏曰我自以借之耳耕者聞之慙謝還地及邑中爭訟皆詣嘏質之然後意厭其子弟有不順者父兄竊數之曰汝所行豈可令任君知邪其禮教所化率皆如此㑹太祖創業召海内至徳嘏應其舉為臨菑侯庶子相國東曹屬尚書郎文帝時為黄門侍郎每納忠言輒手書懐本自在禁省歸書不封帝嘉其淑慎累遷東郡趙郡河東太守所在化行有遺風餘教嘏為人淳粹愷悌虛己若不足恭敬如有畏其脩身履義皆沉黙潛行不顯其美故時人少得稱之著書三十八篇凡四萬餘言嘏卒後故吏東郡程威趙國劉固河東上官崇等錄其事行及所著書奏之詔下祕書以貫羣言","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"in_progress","source_position":{"first_line":199,"last_line":212,"revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","projection_sha256":"cc5909aa74eb575f3ab43f063aabb1e10bc2f1a44d8d48a540a69e6ffe568b32","source_fragments":[{"line":199,"raw_start":2,"raw_end":42,"text":"昭先名嘏别傳曰嘏樂安博昌人世為著姓夙智早成故鄉人為之語曰蔣氏翁任氏童父旐字子旟以"},{"line":200,"raw_start":1,"raw_end":43,"text":"至行稱漢末黄巾賊起天下饑荒人民相食寇到博昌聞旐姓字乃相謂曰宿聞任子旟天下賢人也今雖作"},{"line":201,"raw_start":1,"raw_end":43,"text":"賊那可入其鄉邪遂相帥而去由是聲聞逺近州郡並招舉孝廉歴酸棗祝阿令嘏八嵗喪母號泣不絶聲自"},{"line":202,"raw_start":1,"raw_end":43,"text":"然之哀同於成人故㓜以至性見稱年十四始學疑不再問三年中誦五經皆究其義兼包羣言無不綜覧於"},{"line":204,"raw_s