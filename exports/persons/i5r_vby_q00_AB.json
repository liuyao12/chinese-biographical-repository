{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"i5r_vby_q00_AB","canonical_person_id":"i5r_vby_q00_AB","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["i5r_vby_q00_AB"],"persons":[{"id":"i5r_vby_q00_A","label":"殷基","status":"active","historicity":"historical_tradition","review":"ai_provisional","aliases":[{"surface":"基","mention_ids":["c-sanguozhi-052-gushao-complete:line048-pei02-01:m0002","c-sanguozhi-052-gushao-complete:line048-pei02-02:m0007"]},{"surface":"殷基","mention_ids":["c-sanguozhi-057-zhuju:line096-pei01-01:m0000","c-sanguozhi-059-he:line032-pei01-01:m0000"]}],"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-complete:line048-pei02-01","mention_id":"c-sanguozhi-052-gushao-complete:line048-pei02-01:m0002","quote":"基"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-complete:line048-pei02-02","mention_id":"c-sanguozhi-052-gushao-complete:line048-pei02-02:m0007","quote":"基"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-057","chapter_id":"c-sanguozhi-057-zhuju","source_id":"s-sanguozhi-057-zhuju","paragraph_id":"c-sanguozhi-057-zhuju:line096-pei01-01","mention_id":"c-sanguozhi-057-zhuju:line096-pei01-01:m0000","quote":"殷基"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-059","chapter_id":"c-sanguozhi-059-he","source_id":"s-sanguozhi-059-he","paragraph_id":"c-sanguozhi-059-he:line032-pei01-01","mention_id":"c-sanguozhi-059-he:line032-pei01-01:m0000","quote":"殷基"}],"identity_note":"殷禮子，無難督，通語作者。","family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-complete:line048-pei02-01","quote":"礼子基作通语曰：礼字德嗣，弱不好弄，潜识过人。少为郡吏，年十九，守吴县丞。孙权为王，召除郎中。后与张温俱使蜀，诸葛亮甚称叹之。稍迁至零陵太守，卒官。","source_term":"礼子基"}],"source_assertion_id":"a-wu052-gs-yinji","interpretation_note":"本來源明記世代。後綴只供識別。","reviewer":"Codex（AI 代理）","parent_person_id":"i5r_vby_q00"}},{"id":"i5r_vby_q00_AB","label":"殷祐","status":"active","historicity":"historical_tradition","review":"ai_provisional","aliases":[{"surface":"祐","mention_ids":["c-sanguozhi-052-gushao-complete:line048-pei02-02:m0067"]},{"surface":"庆元","mention_ids":["c-sanguozhi-052-gushao-complete:line048-pei02-02:m0070"]},{"surface":"殷祐","mention_ids":["c-jinshu-068-gurong:p008:m0028","c-jinshu-072-guopu:p004:m0009"]}],"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-complete:line048-pei02-02","mention_id":"c-sanguozhi-052-gushao-complete:line048-pei02-02:m0067","quote":"祐"},{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-complete:line048-pei02-02","mention_id":"c-sanguozhi-052-gushao-complete:line048-pei02-02:m0070","quote":"庆元"},{"mention_id":"c-jinshu-068-gurong:p008:m0028","paragraph_id":"c-jinshu-068-gurong:p008","chapter_id":"c-jinshu-068-gurong","quote":"殷祐"},{"mention_id":"c-jinshu-072-guopu:p004:m0009","paragraph_id":"c-jinshu-072-guopu:p004","chapter_id":"c-jinshu-072-guopu","quote":"殷祐"}],"identity_note":"殷基少子，字慶元，吳郡太守。","family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-gushao-complete","source_id":"s-sanguozhi-052-gushao-complete","paragraph_id":"c-sanguozhi-052-gushao-comp