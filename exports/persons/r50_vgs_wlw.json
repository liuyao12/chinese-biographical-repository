itorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-040-ziliang:p038:m0224","surface":"潘敞","start":224,"end":226,"person_id":"r50_vgs_wlw","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。","paragraph_id":"c-nanqishu-040-ziliang:p038","chapter_id":"c-nanqishu-040-ziliang"}],"relations":[],"title_holdings":[{"id":"th-nanqi040-ziliang-m38-219","person_id":"r50_vgs_wlw","title":"虎賁中郎將","kind":"office","mode":"attestation","attestations":[{"id":"th-nanqi040-ziliang-m38-219:a","person_mention_id":"c-nanqishu-040-ziliang:p038:m0224","usage":"narrative","date_expression":null,"paragraph_id":"c-nanqishu-040-ziliang:p038","surface":"虎賁中郎將","start":219,"end":224}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-ziliang-ws2272748","chapter_id":"c-nanqishu-040-ziliang","paragraph_id":"c-nanqishu-040-ziliang:p038","quote":"世祖不豫，詔子良甲仗入延昌殿侍醫藥。子良啓進沙門於殿戶前誦經，世祖爲感夢見優曇缽華，子良按佛經宣旨使御府以銅爲華，插御牀四角。日夜在殿內，太孫閒日入參承。世祖暴漸，內外惶懼，百僚皆已變服，物議立子良，俄頃而蘇，問太孫所在，因召東宮器甲皆入。遺詔使子良輔政，高宗知尚書事。子良素仁厚，不樂世務，乃推高宗。詔云：「事無大小，悉與鸞參懷。」子良所志也。太孫少養於子良妃袁氏，甚著慈愛，旣懼前不得立，自此深忌子良。大行出太極殿，子良居中書省，帝使虎賁中郎將潘敞領二百人仗屯太極西階防之。成服後，諸王皆出，子良乞停至山陵，不許。","person_mention_id":"c-nanqishu-040-ziliang:p038:m0224"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-040-ziliang:p038","text":"世祖不豫，詔子良甲仗入延昌殿侍醫藥。子良啓進沙門於殿戶前誦經，世祖爲感夢見優曇缽華，子良按佛經宣旨使御府以銅爲華，插御牀四角。日夜在殿內，太孫閒日入參承。世祖暴漸，內外惶懼，百僚皆已變服，物議立子良，俄頃而蘇，問太孫所在，因召東宮器甲皆入。遺詔使子良輔政，高宗知尚書事。子良素仁厚，不樂世務，乃推高宗。詔云：「事無大小，悉與鸞參懷。」子良所志也。太孫少養於子良妃袁氏，甚著慈愛，旣懼前不得立，自此深忌子良。大行出太極殿，子良居中書省，帝使虎賁中郎將潘敞領二百人仗屯太極西階防之。成服後，諸王皆出，子良乞停至山陵，不許。","mentions":[{"id":"c-nanqishu-040-ziliang:p038:m0006","surface":"子良","start":6,"end":8,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0018","surface":"子良","start":18,"end":20,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0042","surface":"子良","start":42,"end":44,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0097","surface":"子良","start":97,"end":99,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0123","surface":"子良","start":123,"end":125,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0135","surface":"子良","start":135,"end":137,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0162","surface":"鸞","start":162,"end":163,"person_id":"w4m_9tw_147","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0167","surface":"子良","start":167,"end":169,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0178","surface":"子良","start":178,"end":180,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanqishu-040-ziliang:p038:m0181","surface":"袁氏","start":181,"end":183,"person_id":"xxh_xtr_3f9_ABA","kind":"person","status":"contextual_provisional","inte