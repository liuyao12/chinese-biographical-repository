:[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-xufu-literal","person_id":"yzg_p8u_3gv","surname":"徐","ming":"馥","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p036","person_mention_id":"c-jinshu-098-wangdun-comparison:p036:m0139","source_anchor":{"start":139,"end":141,"surface":"徐馥"},"quote":"既而周光斬錢鳳，吳儒斬沈充，並傳首京師。有司議曰：「王敦滔天作逆，有無君之心，宜依崔杼、王浚故事，剖棺戮屍，以彰元惡。」於是發瘞出屍，焚其衣冠，跽而刑之。敦、充首同日懸于南桁，觀者莫不稱慶。敦首既懸，莫敢收葬者。尚書令郗鑒言於帝曰：「昔王莽漆頭以輗車，董卓然腹以照市，王淩儭土，徐馥焚首。前朝誅楊駿等，皆先極官刑，後聽私殯。然《春秋》許齊襄之葬紀侯，魏武義王修之哭袁譚。由斯言之，王誅加於上，私義行於下。臣以為可聽私葬，於義為弘。」昭許之，於是敦家收葬焉。含父子乘單船奔荊州刺史王舒，舒使人沈之于江，餘黨悉平。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p036:m0139","start":139,"end":141,"surface":"徐馥","person_id":"yzg_p8u_3gv","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p036","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p036","text":"既而周光斬錢鳳，吳儒斬沈充，並傳首京師。有司議曰：「王敦滔天作逆，有無君之心，宜依崔杼、王浚故事，剖棺戮屍，以彰元惡。」於是發瘞出屍，焚其衣冠，跽而刑之。敦、充首同日懸于南桁，觀者莫不稱慶。敦首既懸，莫敢收葬者。尚書令郗鑒言於帝曰：「昔王莽漆頭以輗車，董卓然腹以照市，王淩儭土，徐馥焚首。前朝誅楊駿等，皆先極官刑，後聽私殯。然《春秋》許齊襄之葬紀侯，魏武義王修之哭袁譚。由斯言之，王誅加於上，私義行於下。臣以為可聽私葬，於義為弘。」昭許之，於是敦家收葬焉。含父子乘單船奔荊州刺史王舒，舒使人沈之于江，餘黨悉平。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","source_position":{"first_line":81,"last_line":81,"revision_id":2614273,"raw_projection_ref":"source-evidence/jin098-wangdun-comparison/projecti