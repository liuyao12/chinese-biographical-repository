preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-098-huanwen:p021:m0129","start":129,"end":132,"surface":"傅末波","kind":"person","person_id":"wse_ygh_z6q","status":"contextual_provisional","interpretation_note":"依完整單元、引語範圍及平行來源作AI暫定辨識，未圖校。","paragraph_id":"c-jinshu-098-huanwen:p021","chapter_id":"c-jinshu-098-huanwen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-huanwen:p021","text":"太和四年，又上疏悉眾北伐。平北將軍郗愔以疾解職，又以溫領平北將軍、徐兗二州刺史，率弟南中郎沖、西中郎袁真步騎五萬北伐。百官皆于南州祖道，都邑盡傾。軍次湖陸，攻慕容暐將慕容忠，獲之，進次金鄉。時亢旱，水道不通，乃鑿钜野三百餘里以通舟運，自清水入河。暐將慕容垂、傅末波等率眾八萬距溫，戰于林渚。溫擊破之，遂至枋頭。先使袁真伐譙梁，開石門以通運。真討譙梁皆平之，而不能開石門，軍糧竭盡。溫焚舟步退，自東燕出倉垣，經陳留，鑿井而飲，行七百餘里。垂以八千騎追之，戰於襄邑，溫軍敗績，死者三萬人。溫甚恥之，歸罪於真，表廢為庶人。真怨溫誣己，據壽陽以自固，潛通苻堅、慕容暐。","source_position":{"kind":"wikitext_codepoint_positions","raw_path":"sources/jinshu/wikisource-2614273-raw.wikitext","raw_start":12481,"raw_end":12768,"character_positions":[12486,12487,12488,12489,12492,12493,12494,12495,12496,12497,12498,12499,12500,12501,12502,12503,12504,12505,12506,12507,12508,12509,12510,12511,12512,12513,12514,12515,12516,12517,12518,12519,12520,12521,12522,12523,12524,12525,12526,12527,12528,12529,12530,12531,12532,12533,12534,12535,12536,12537,12538,12539,12540,12541,12542,12543,12544,12545,12546,12547,12548,12549,12550,12551,12552,12553,12554,12555,12556,12557,12558,12559,12560,12561,12562,12563,12564,12565,12566,12567,12568,12569,12570,12571,12572,12573,12574,12575,12576,12577,12578,12579,12580,12581,12582,12583,12584,12585,12586,12587,12588,12589,12590,12591,12592,12593,12594,12595,12596,12597,12598,12599,12600,12601,12602,12603,12604,12605,12606,12607,12608,12609,12610,12611,12612,12613,12614,12615,12616,12617,12618,12619,12620,12621,12622,12623,12624,12625,12626,12627,12628,12629,12630,12631