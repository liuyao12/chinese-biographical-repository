a_s3x_wb4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭統。"},{"start":76,"end":78,"surface":"有司","id":"c-nanshi-022-wangyun-family-wyd:p005:u0076","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"受理臨海郡事的主管官員未具名"},{"start":101,"end":103,"surface":"簡文","id":"c-nanshi-022-wangyun-family-wyd:p005:m0101","person_id":"rtd_v0b_nyn","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭綱。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:926ceb18b937c6612202ae0e975b51816ffe9fa93ccf09573b64985563a56669","source_layer":"received_biography","column_projection":[{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":2,"start":15,"end":21,"text":"後為太子家令"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":3,"start":0,"end":21,"text":"復掌管記普通元年以母憂去職筠有孝性毀瘠過禮"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":4,"start":0,"end":21,"text":"大通二年為司徒左長史三年昭明太子薨敕製哀策"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":5,"start":0,"end":21,"text":"文復見嗟賞尋出為臨海太守在郡侵刻還資有芒屩"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":6,"start":0,"end":21,"text":"兩舫他物稱是為有司奏不調累年後歷祕書監太府"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":7,"start":0,"end":20,"text":"卿度支尚書司徒左長史及簡文卽位為太子詹事"}]},"chapter_id":"c-nanshi-022-wangyun-family-wyd","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangyun-family-wyd1739"},{"id":"c-nanshi-022-wangyun-family:p005","text":"後爲太子家令，復掌管記。普通元年，以母憂去職。筠有孝性，毀瘠過禮。中大通二年，爲司徒左長史。三年，昭明太子薨，敕制哀策文，復見嗟賞。尋出爲臨海太守，在郡侵刻，還資有芒屩兩舫，他物稱是。爲有司奏，不調累年。後曆秘書監，太府卿，度支尚書，司徒左長史。及簡文即位，爲太子詹事。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":18,"end":19,"surface":"母","id":"c-nanshi-022-wangyun-family:p005:m0018","person_id":"3cn_bb6_ety","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠母。"},{"start":23,"end":24,"surface":"筠","id":"c-nanshi-022-