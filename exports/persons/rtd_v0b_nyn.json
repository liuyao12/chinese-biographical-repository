022-wanggui:p004:u0019","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"與賦京朝官員未逐名。"},{"start":30,"end":31,"surface":"規","id":"c-nanshi-022-wanggui:p004:m0030","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作規。"},{"start":111,"end":114,"surface":"芮珍宗","id":"c-nanshi-022-wanggui:p004:m0111","person_id":"krm_d5l_lpm","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作芮。"},{"start":118,"end":121,"surface":"前守宰","id":"c-nanshi-022-wanggui:p004:u0118","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"前任守宰，未逐名。"},{"start":129,"end":131,"surface":"珍宗","id":"c-nanshi-022-wanggui:p004:m0129","person_id":"krm_d5l_lpm","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作芮。"},{"start":134,"end":135,"surface":"規","id":"c-nanshi-022-wanggui:p004:m0134","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作規。"},{"start":140,"end":142,"surface":"珍宗","id":"c-nanshi-022-wanggui:p004:m0140","person_id":"krm_d5l_lpm","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作芮。"},{"start":147,"end":148,"surface":"規","id":"c-nanshi-022-wanggui:p004:m0147","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作規。"},{"start":161,"end":166,"surface":"郡境千餘人","id":"c-nanshi-022-wanggui:p004:u0161","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"請留的吳郡民眾，約數。"}],"source_position":{"revision_id":1477957,"source_layer":"received_biography","raw_start":5837,"raw_end":6023,"raw_character_offsets":[5837,5838,5839,5840,5841,5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862,5863,5864,5865,5866,5867,5868,5869,5870,5871,5872,5873,5874,5875,5876,5877,5878,5879,5880,5881,5882,5883,5884,5885,5886,5887,5888,5889,5890,5891,5892,5893,5894,5895,5896,5897,5898,5899,5900,5901,5902,5903,5904,5905,5906,5907,5908,5909,5910,5911,5912,5913,5914,5915,5916,5917,5918,5919,5920,5921,5922,5923,5924,5925,5926,5927,5928,5929,5930,5931,5932,5933,5934,5935,5936,5937,5938,5939,5940,5941,5942,5943,5944,5945,5946,5947,5948,5949,5950,5951,5952,5953,5954,5955,5956,5957,5958,5959,5960,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,5995,5996,5997,5998,5999,6000,6001,6002,6003,6004,6005,6006,6007,6008,6009,6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022],"projection_sha256":"3339602fade95981e10d052077c3cfd8aa4754ce36ac61c020d0bb551603cc48"},"chapter_id":"c-nanshi-022-wanggui","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wanggui-ws1477957"},{"id":"c-nanshi-022-wanggui:p005","text":"規常以門宗貴盛，恒思減退。後為太子中庶子，領步兵校尉，辭疾不拜，遂于鍾山宋熙寺築室居焉。卒，贈光祿大夫，諡曰文。皇太子出臨哭，與湘東王繹令曰：「王威明風韻遒上，神峰標映，千里絕跡，百尺無枝，實俊人也。一爾過隙，永歸長夜，金刀掩芒，長淮絕涸。去歲冬中，已傷劉子，今茲寒孟，復悼王生。俱往之傷，信非虛說。」規集後漢眾家異同，注續漢書二百卷。文集二十卷。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"規","id":"c-nanshi-022-wanggui:p005:m0000","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作規。"},{"start":67,"end":68,"surface":"繹","id":"c-nanshi-022-wanggui:p005:m0067","person_id":"rvc_bqx_v5w","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作繹。"},{"start":72,"end":75,"surface":"王威明","id":"c-nanshi-022-wanggui:p005:m0072","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作規。"},{"start":151,"end":152,"surface":"規","id":"c-nanshi-022-wanggui:p005:m0151","person_id":"7r6_k52_qji_ABAAAAEAAAA","kind":"person","status":"contextual_provisional","interpret