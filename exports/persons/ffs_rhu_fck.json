{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"ffs_rhu_fck","canonical_person_id":"ffs_rhu_fck","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["ffs_rhu_fck"],"persons":[{"id":"ffs_rhu_fck","label":"留寶〔郗隆治中〕","status":"active","historicity":"historical_tradition","aliases":[{"surface":"留寶","mention_ids":["c-jinshu-057-zhao-you:p001:m0192"]}],"evidence":[{"mention_id":"c-jinshu-057-zhao-you:p001:m0192","paragraph_id":"c-jinshu-057-zhao-you:p001","chapter_id":"c-jinshu-057-zhao-you","quote":"留寶"}],"review":"ai_provisional","identity_note":"留寶〔郗隆治中〕，見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-jinshu-057-zhao-you-ws2413329","work_id":"w-jinshu","book_id":"b-jinshu-057","chapter_id":"c-jinshu-057-zhao-you","raw_mention_count":1,"mention_ids":["c-jinshu-057-zhao-you:p001:m0192"],"paragraph_ids":["c-jinshu-057-zhao-you:p001"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-057-zhao-you:p001:m0192","mention_ids":["c-jinshu-057-zhao-you:p001:m0192"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-057-zhao-you-ws2413329"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-057-zhao-you:p001:m0192","surface":"留寶","start":192,"end":194,"person_id":"ffs_rhu_fck","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-057-zhao-you:p001","chapter_id":"c-jinshu-057-zhao-you"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-057-zhao-you:p001","text":"趙誘，字元孫，淮南人也。世以將顯。州辟主簿。值刺史郗隆被齊王冏檄，使起兵討趙王倫，隆欲承檄舉義，而諸子侄並在洛陽；欲坐觀成敗，恐為冏所討，進退有疑，會群吏計議。誘說隆曰：「趙王篡逆，海內所病。今義兵飆起，其敗必矣。今為明使君計，莫若自將精兵，徑赴許昌，上策也。不然，且可留後，遣猛將將兵會盟，亦中策也。若遣小軍隨形助勝。下策耳。」隆曰：「我受二帝恩，無所偏助，正欲保州而已。」誘與治中留寶、主簿張褒等諫隆：「若無所助，變難將生，州亦不可保也。」隆猶豫不決，遂為其下所害。誘還家，杜門不出。左將軍王敦以為參軍，加廣武將軍，與甘卓、周訪共討華軼，破之。又擊杜弢於西湘，太興初，復與卓攻弢，滅之。累功賜爵平阿縣侯，代陶侃為武昌太守。時杜曾迎第五猗於荊州作亂，敦遣誘與襄陽太守朱軌共距之。猗既愍帝所遣，加有時望，為荊楚所歸。誘等苦戰皆沒，敦甚悼惜之，表贈征虜將軍、秦州刺史，諡曰敬。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":93,"last_line":93,"raw_start":7615,"raw_end":8002,"raw_character_offsets":[7615,7616,7617,7618,7619,7620,7621,7622,7623,7624,7625,7626,7627,7628,7629,7630,7631,7632,7633,7634,7635,7636,7637,7638,7639,7640,7641,7642,7643,7644,7645,7646,7647,7648,7649,7650,7651,7652,7653,7654,7655,7656,7657,7658,7659,7660,7661,7662,7663,7664,7665,7666,7667,7668,7669,7670,7671,7672,7673,7674,7675,7676,7677,7678,7679,7680,7681,7682,7683,7684,7685,7686,7687,7688,7689,7690,7691,7692,7693,7694,7695,7696,7697,7698,7699,7700,7701,7702,7703,7704,7705,7706,7707,7708,7709,7710,7711,7712,7713,7714,7715,7716,7717,7718,7719,7720,7721,7722,7723,7724,7725,7726,7727,7728,7729,7730,7731,7732,7733,7734,7735,7736,7737,7738,7739,7740,7741,7742,7743,7744,7745,7746,7747,7748,7749,7750,7751,7752,7753,7754,7755,7756,7757,7758,7759,7760,7761,7762,7763,7764,7765,7766,7767,7768,7769,7770,7771,7772,7773,7774,7775,7776,7777,7778,7779,7780,7781,7782,7783,7784,7785,7786,7787,7788,7789,7790,