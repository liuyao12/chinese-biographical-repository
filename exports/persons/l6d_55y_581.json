,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-076-guzhong:line122:m0175","start":175,"end":177,"surface":"陶陽","kind":"person","person_id":"l6d_55y_581","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-076-guzhong:line122","chapter_id":"c-jinshu-076-guzhong"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-076-guzhong:line122","text":"時賊党方銳，義軍沮退，人咸勸衆過浙江。衆曰：「不然。今保固紫壁，可得全錢唐以南五縣。若越他境，便為寓軍，控引無所，非長計也。」臨平人範明亦謂衆曰：「此地險要，可以制寇，不可委也。」衆乃版明為參軍。明率宗黨五百人，合諸軍，凡四千人，復進討健。健退于曲阿，留錢弘為吳令。軍次路丘，即斬弘首。衆進住吳城，遣督護硃祈等九軍，與蘭陵太守李閎共守庱亭。健遣馬流、陶陽等往攻之。閎與祈等逆擊，大破之，斬首二千餘級。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-076-guzhong:line122:m0014","start":14,"end":15,"surface":"衆","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line122:m0019","start":19,"end":20,"surface":"衆","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line122:m0066","start":66,"end":68,"surface":"範明","kind":"person","person_id":"ucn_xje_aoy","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line122:m0070","start":70,"end":71,"surface":"衆","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line122:m0090","start":90,"end":91,"surface":"衆","kind":"person","person_id":"jfc_0dt_42a_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-076-guzhong:line122:m0093","start":93,"end":94,"surface":"明","kind":"person","person_id":"ucn_xje_aoy","stat