ongnu:m019-0048","start":48,"end":49,"surface":"說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m019-0063","start":63,"end":66,"surface":"中行說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m019-0071","start":71,"end":73,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m019-0074","start":74,"end":76,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p020","text":"初，匈奴好漢繒絮食物，中行說曰：「匈奴人眾不能當漢之一郡，然所以彊者，以衣食異，無仰於漢也。今單于變俗好漢物，漢物不過什二，則匈奴盡歸於漢矣。其得漢繒絮，以馳草棘中，衣袴皆裂敝，以示不如旃裘之完善也。得漢食物皆去之，以示不如湩酪之便美也。」於是說教單于左右疏記，以計課其人眾畜物。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m020-0011","start":11,"end":14,"surface":"中行說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m020-0047","start":47,"end":49,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m020-0122","start":122,"end":123,"surface":"說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m020-0124","start":124,"end":126,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m020-0126","start":126,"end":128,"surface":"左右","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p021","text":"漢遺單于書，牘以尺一寸，辭曰「皇帝敬問匈奴大單于無恙」，所遺物及言語云云。中行說令單于遺漢書以尺二寸牘，及印封皆令廣大長，倨傲其辭曰「天地所生日月所置匈奴大單于敬問漢皇帝無恙」，所以遺物言語亦云云。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m021-0002","start":2,"end":4,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m021-0015","start":15,"end":17,"surface":"皇帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m021-0019","start":19,"end":24,"surface":"匈奴大單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m021-0037","start":37,"end":40,"surface":"中行說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m021-0041","start":41,"end":43,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m021-0067","start":67,"end":80,"surface":"天地所生日月所置匈奴大單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m021-0082","start":82,"end":85,"surface":"漢皇帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p022","text":"漢使或言曰：「匈奴俗賤老。」中行說窮漢使曰：「而漢俗屯戍從軍當發者，其老親豈有不自脫溫厚肥美以齎送飲食行戍乎？」漢使曰：「然。」中行說曰：「匈奴明以戰攻爲事，其老弱不能鬬，故以其肥美飲食壯健者，蓋以自爲守衛，如此父子各得久相保，何以言匈奴輕老也？」漢使曰：「匈奴父子乃同穹廬而臥。父死，妻其後母；兄弟死，盡取其妻妻之。無冠帶之飾，闕庭之禮。」中行說曰：「匈奴之俗，人食畜肉，飲其汁，衣其皮；畜食草飲水，隨時轉移。故其急則人習騎射，寬則人樂無事，其約束輕，易行也。君臣簡易，一國之政猶一身也。父子兄弟死，取其妻妻之，惡種姓之失也。故匈奴雖亂，必立宗種。今中國雖詳不取其父兄之妻，親屬益疏則相殺，至乃易姓，皆從此類。且禮義之敝，上下交怨望，而室屋之極，生力必屈。夫力耕桑以求衣食，築城郭以自備，故其民急則不習戰功，緩則罷於作業。嗟土室之人，顧無多辭，令喋喋而佔佔，冠固何當？」","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m022-0000","start":0,"end":2,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0014","start":14,"end":17,"surface":"中行說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m022-0018","start":18,"end":20,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0056","start":56,"end":58,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0064","start":64,"end":67,"surface":"中行說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m022-0106","start":106,"end":108,"surface":"父子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0124","start":124,"end":126,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0131","start":131,"end":133,"surface":"父子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0145","start":145,"end":147,"surface":"後母","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0148","start":148,"end":150,"surface":"兄弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0171","start":171,"end":174,"surface":"中行說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m022-0231","start":231,"end":233,"surface":"君臣","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0245","start":245,"end":247,"surface":"父子","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0247","start":247,"end":249,"surface":"兄弟","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m022-0283","start":283,"end":285,"surface":"父兄","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p023","text":"自是之後，漢使欲辯論者，中行說輒曰：「漢使無多言，顧漢所輸匈奴繒絮米糱，令其量中，必善美而己矣，何以爲言乎？且所給備善則已；不備，苦惡，則候秋孰，以騎馳蹂而稼穡耳。」日夜教單于候利害處。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m023-0005","start":5,"end":7,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m023-0012","start":12,"end":15,"surface":"中行說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m023-0019","start":19,"end":21,"surface":"漢使","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-110-xiongnu:m023-0086","start":86,"end":88,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"},{"id":"c-shiji-110-xiongnu:p027","text":"後四歳，老上稽粥單于死，子軍臣立爲單于。既立，孝文皇帝復與匈奴和親。而中行說復事之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-110-xiongnu:m027-0004","start":4,"end":10,"surface":"老上稽粥單于","kind":"person","person_id":"wjt_htu_081_AA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m027-0013","start":13,"end":15,"surface":"軍臣","kind":"person","person_id":"wjt_htu_081_AAA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m027-0017","start":17,"end":19,"surface":"單于","kind":"person","person_id":"wjt_htu_081_AAA","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m027-0023","start":23,"end":27,"surface":"孝文皇帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-110-xiongnu:m027-0035","start":35,"end":38,"surface":"中行說","kind":"person","person_id":"e8g_59i_f6c","status":"contextual_provisional"}],"chapter_id":"c-shiji-110-xiongnu","book_id":"b-shiji-110","work_id":"w-shiji","source_id":"s-shiji110-xiongnu"}],"sources":[{"chapter_id":"c-shiji-110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","source_id":"s-shiji110-xiongnu","source":