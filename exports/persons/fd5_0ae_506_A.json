expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-fuhongzhi","source_id":"s-songshu-048-fuhongzhi-ws1791560","paragraph_id":"c-songshu-048-fuhongzhi:p005","quote":"進為桂陽公義真雍州治中從事史，除西戎司馬、寧朔將軍。略陽太守徐師高反叛，弘之討平之。高祖歸後，佛佛偽太子赫連瓌率眾三萬襲長安，弘之又領步騎五千，於池陽大破之，殺傷甚眾。瓌又抄掠渭南，弘之又於寡婦人渡破瓌，獲賊三百，掠七千餘口。及義真東歸，佛佛傾國追躡，於青泥大戰，弘之身貫甲冑，氣冠三軍。軍敗陷沒，佛佛逼令降，弘之不為屈，時天寒，裸弘之，弘之叫罵見殺。時年四十二。","person_mention_id":"c-songshu-048-fuhongzhi:p005:m0052"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-130-fu-helian-gui:p001","text":"立其妻梁氏為王后，子璝為太子，封子延陽平公，昌太原公，倫酒泉公，定平原公，滿河南公，安中山公。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":35,"last_line":35,"raw_start":3112,"raw_end":3159,"raw_character_offsets":[3112,3113,3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158],"revision_id":2097331},"mentions":[{"id":"c-jinshu-130-fu-helian-gui:p001:m0010","start":10,"end":11,"surface":"璝","kind":"person","person_id":"fd5_0ae_506_A","status":"contextual_provisional"},{"id":"c-jinshu-130-fu-helian-gui:p001:m0022","start":22,"end":23,"surface":"昌","kind":"person","person_id":"be2_1b4_a75","status":"contextual_provisional"}],"chapter_id":"c-jinshu-130-fu-helian-gui","book_id":"b-jinshu-130","work_id":"w-jinshu","source_id":"s-jinshu-130-fu-helian-gui-ws2097331"},{"id":"c-jinshu-130-fu-helian-gui:p002","text":"勃勃善之，以子璝都督前鋒諸軍事，領撫軍大將軍，率騎二萬南伐長安，","text_layer":"received_chapter","annotation_status