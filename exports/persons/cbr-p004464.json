us":"contextual_provisional"}],"chapter_id":"c-shiji-078-chunshen","book_id":"b-shiji-078","work_id":"w-shiji","source_id":"s-shiji-078-chunshen"},{"id":"c-shiji-078-chunshen:p018","text":"李園既入其女弟，立為王后，子為太子，恐春申君語泄而益驕，陰養死士，欲殺春申君以滅口，而國人頗有知之者。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-078-chunshen:m018-0000","start":0,"end":2,"surface":"李園","kind":"person","person_id":"cbr-p004464","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m018-0005","start":5,"end":7,"surface":"女弟","kind":"person","person_id":"cbr-p004463","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m018-0010","start":10,"end":12,"surface":"王后","kind":"person","person_id":"cbr-p004463","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m018-0013","start":13,"end":14,"surface":"子","kind":"person","person_id":"cbr-p004466","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m018-0015","start":15,"end":17,"surface":"太子","kind":"person","person_id":"cbr-p004466","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m018-0019","start":19,"end":22,"surface":"春申君","kind":"person","person_id":"cbr-p004439","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m018-0030","start":30,"end":32,"surface":"死士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名角色或假設用稱保留，不補姓名、親屬或方案實施；母子血緣敘事仍待另存來源主張與學術覆核。"},{"id":"c-shiji-078-chunshen:m018-0035","start":35,"end":38,"surface":"春申君","kind":"person","person_id":"cbr-p004439","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m018-0043","start":43,"end":45,"surface":"國人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名角色或假設用稱保留，不補姓名、親屬或方案實施；母子血緣敘事仍待另存來源主張與學術覆核。"}],"chapter_id":"c-shiji-078-chunshen","book_id":"b-shiji-078","work_id":"w-shiji","source_id":"s-shiji-078-chunshen"},{"id":"c-shiji-078-chunshen:p019","text":"春申君相二十五年，楚考烈王病。朱英謂春申君曰：「世有毋望之福，又有毋望之禍。今君處毋望之世，事毋望之主，安可以無毋望之人乎？」春申君曰：「何謂毋望之福？」曰：「君相楚二十餘年矣，雖名相國，實楚王也。今楚王病，旦暮且卒，而君相少主，因而代立當國，如伊尹、周公，王長而反政，不即遂南面稱孤而有楚國？此所謂毋望之福也。」春申君曰：「何謂毋望之禍？」曰：「李園不治國而君之仇也，不為兵而養死士之日久矣，楚王卒，李園必先入據權而殺君以滅口。此所謂毋望之禍也。」春申君曰：「何謂毋望之人？」對曰：「君置臣郎中，楚王卒，李園必先入，臣為君殺李園。此所謂毋望之人也。」春申君曰：「足下置之，李園，弱人也，仆又善之，且又何至此！」朱英知言不用，恐禍及身，乃亡去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-078-chunshen:m019-0000","start":0,"end":3,"surface":"春申君","kind":"person","person_id":"cbr-p004439","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0009","start":9,"end":13,"surface":"楚考烈王","kind":"person","person_id":"cbr-p004451","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0015","start":15,"end":17,"surface":"朱英","kind":"person","person_id":"cbr-p004461","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0018","start":18,"end":21,"surface":"春申君","kind":"person","person_id":"cbr-p004439","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0039","start":39,"end":40,"surface":"君","kind":"person","person_id":"cbr-p004439","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0056","start":56,"end":60,"surface":"毋望之人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名角色或假設用稱保留，不補姓名、親屬或方案實施；母子血緣敘事仍待另存來源主張與學術覆核。"},{"id":"c-shiji-078-chunshen:m019-0063","start":63,"end":66,"surface":"春申君","kind":"person","person_id":"cbr-p004439","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0080","start":80,"end":81,"surface":"君","kind":"person","person_id":"cbr-p004439","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0095","start":95,"end":97,"surface":"楚王","kind":"person","person_id":"cbr-p004439","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0100","start":100,"end":102,"surface":"楚王","kind":"person","person_id":"cbr-p004451","status":"contextual_provisional"},{"id":"c-shiji-078-chunshen:m019-0110","start":110,"end":111,"surface":"君","kind":"person","person