ubject_person_mention_id":"c-nanqishu-045-zhaozhou-baolan:p001:m0026","object_person_mention_id":"c-nanqishu-045-zhaozhou-baolan:p001:m0001","relationship_anchor":{"paragraph_id":"c-nanqishu-045-zhaozhou-baolan:p001","surface":"弟寶覽","start":25,"end":28}}],"status":"source_attested","interpretation_note":"寶覽為寶晊之弟。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"th-nanqi040-zhaozhou-m2-37","person_id":"98q_mll_d6v_BB","title":"江陵公","kind":"noble_rank","mode":"attestation","attestations":[{"id":"th-nanqi040-zhaozhou-m2-37:a","person_mention_id":"c-nanqishu-040-zhaozhou:p002:m0040","usage":"narrative","date_expression":null,"paragraph_id":"c-nanqishu-040-zhaozhou:p002","surface":"江陵公","start":37,"end":40}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanqishu","book_id":"b-nanqishu-040","source_id":"s-nanqishu-040-zhaozhou-ws2272748","chapter_id":"c-nanqishu-040-zhaozhou","paragraph_id":"c-nanqishu-040-zhaozhou:p002","quote":"先是王敬則事起，南康侯子恪在吳郡，高宗慮有同異，召諸王侯入宮。晉安王寶義及江陵公寶覽等住中書省，高、武諸孫住西省，勑人各兩左右自隨，過此依軍法，孩抱者乳母隨入。其夜太醫煮藥，都水辦數十具棺材，須三更當悉殺之。子恪奔歸，二更達建陽門刺啓。時刻已至，而帝眠不起，中書舍人沈徽孚與帝所親左右單景雋共謀少留其事，須臾帝覺，景雋啓子恪已至，驚問曰：「未邪？」景雋具以事荅。明日悉遣王侯還第。建武以來，高、武王侯居常震怖，朝不保夕，至是尤甚。","person_mention_id":"c-nanqishu-040-zhaozhou:p002:m0040"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-040-zhaozhou:p002","text":"先是王敬則事起，南康侯子恪在吳郡，高宗慮有同異，召諸王侯入宮。晉安王寶義及江陵公寶覽等住中書省，高、武諸孫住西省，勑人各兩左右自隨，過此依軍法，孩抱者乳母隨入。其夜太醫煮藥，都水辦數十具棺材，須三更當悉殺之。子恪奔歸，二更達建陽門刺啓。時刻已至，而帝眠不起，中書舍人沈徽孚與帝所親左右單景雋共謀少留其事，須臾帝覺，景雋啓子恪已至，驚問曰：「未邪？」景雋具以事荅。明日悉遣王侯還第。建武以來，高、武王侯居常震怖，朝不保夕，至是尤甚。","mentions":[{"id":"c