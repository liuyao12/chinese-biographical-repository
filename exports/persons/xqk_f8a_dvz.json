847,4848,4849,4850,4851,4852,4853,4854,4855,4856,4857,4858,4859,4860,4861,4867,4868,4869,4870,4873,4874,4875,4876,4877,4878,4879,4880,4881,4882,4883,4884,4885,4886,4887,4888,4889,4890,4891,4892,4893,4894,4895,4896,4897,4898,4899,4900,4901,4902,4903,4904,4905,4906,4907,4908,4909,4910,4911,4912,4913,4914,4915,4916,4917,4918,4919,4920,4921,4922,4923,4924,4925,4926,4927,4928,4929,4930,4931,4932,4933,4934,4935,4936,4937,4938,4939,4940,4941,4942,4943,4944,4945,4946,4947,4948,4949,4950,4951,4952,4953,4954,4955,4956,4957,4958,4959,4960,4961,4962,4963,4964,4965,4966,4967,4968,4969,4970,4971,4972,4973,4974,4975]},"chapter_id":"c-sanguozhi-060-lvdai","book_id":"b-sanguozhi-060","work_id":"w-sanguozhi","source_id":"s-sanguozhi-060-lvdai"},{"id":"c-sanguozhi-060-lvdai:line055","text":"　　權詔岱曰：“厲負險作亂，自致梟首；桓兇狡反覆，已降復叛。前後討伐，歷年不禽，非君規略，誰能梟之？忠武之節，於是益者。元惡既除，大小震懾，其餘細類，掃地族矣。自今巳去，國家永無南顧之虞，三郡晏然，無怵惕之驚。又得惡民以供賦役，重用歎息。賞不逾月，國之常典，制度所宜，君其裁之。”","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-lvdai:line055:m0002","start":2,"end":3,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line055:m0004","start":4,"end":5,"surface":"岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line055:m0008","start":8,"end":9,"surface":"厲","kind":"person","person_id":"psh_zpl_fps","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line055:m0019","start":19,"end":20,"surface":"桓","kind":"person","person_id":"xqk_f8a_dvz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"}],"annotation_status":"reviewed","source_position":{"first_line":55,"last_line":55,"revision_id":2120830,"raw_start":4978,"raw_end":5118,"character_positions":[4978,4979,4980,4981,4982,4983,4984,4985,4986,4987,4988,4989,4990,4991,4992,4993,4994,4995,4996,4997,4998,4999,