ind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p011:m0275","surface":"方之","start":275,"end":277,"person_id":"8k4_jv9_4i3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p011:m0298","surface":"統","start":298,"end":299,"person_id":"4qr_wrk_3vd_CA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p011:m0355","surface":"周撫","start":355,"end":357,"person_id":"smf_swf_i2l","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p011:m0362","surface":"曹據","start":362,"end":364,"person_id":"05e_1c3_fff","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-073-yuyi:p011:m0370","surface":"李桓","start":370,"end":372,"person_id":"xqk_f8a_dvz","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-073-yuyi","book_id":"b-jinshu-073","work_id":"w-jinshu","source_id":"s-jinshu-073-yuyi-ws2296501"},{"id":"c-sanguozhi-047-sun-quan:p085","text":"　　三年春正月，詔曰：「兵久不輟，民困於役，歳或不登。其寬諸逋，勿復督課。」夏五月，權遣陸遜、諸葛瑾等屯江夏、沔口，孫韶、張承等嚮廣陵、淮陽，權率大眾圍合肥新城。是時蜀相諸葛亮出武功，權謂魏明帝不能遠出，而帝遣兵助司馬宣王拒亮。自率水軍東徵。未至壽春，權退還，孫韶亦罷。秋八月，以諸葛恪爲丹楊太守，討山越。九月朔，隕霜傷穀。冬十一月，太常潘濬平武陵蠻夷，事畢，還武昌。詔復曲阿爲雲陽，丹徒爲武進。廬陵賊李桓、羅厲等爲亂。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":93,"last_line":93,"raw_start":18563,"raw_end":18848,"raw_character_offsets":[18563,18564,18565,18566,18567,18568,18569,18570,18571,18572,18573,18574,18575,18576,18577,18578,18579,18580,18581,18582,18583,18584,18585,18586,18587,18588,18589,18590,18591,18592,18593,18594,18595,18596,18597,18598,18599,18600,18601,18602,18603,18604,18605,18606,18614,18615,18618,18627,18628,18629,18632,18633,18634,18635,18636,18637,18638,18639,18647,18648,18651,18659,18660,18663,18664,18665,18666,18667,18668,18669,18670,18671,18672,18673,18674,18675,18676,18677,18678,18679,18680,18681,18682,18683,18684,18685,18686,18687,18688,18689,18690,18691,18692,18693,18694,18695,18696,18697,18698,18699,18700,18701,18702,18703,18704,18705,18706,18715,18716,18717,18718,18721,18722,18723,18724,18725,18726,18727,18728,18729,18730,18731,18732,18733,18734,18735,18736,18737,18738,18739,18747,18748,18751,18752,18753,18754,18755,18756,18757,18758,18767,18768,18769,18772,18773,18774,18775,18776,18777,18778,18779,18780,18781,18782,18783,18784,18785,18786,18787,18788,18789,18790,18791,18792,18793,18794,18795,18796,18797,18798,18799,18800,18801,18802,18803,18804,18805,18806,18807,18808,18809,18810,18811,18812,18813,18814,18815,18816,18817,18818,18819,18820,18828,18829,18832,18833,18834,18835,18836,18837,18838,18839,18840,18841,18842,18843,18844,18845,18846,18847],"revision_id":2602668},"mentions":[{"id":"c-sanguozhi-047-sun-quan:p085:m0044","surface":"陸遜","start":44,"end":46,"kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p085:m0047","surface":"諸葛瑾","start":47,"end":50,"kind":"person","person_id":"lpo_z63_vzb","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p085:m0140","surface":"諸葛恪","start":140,"end":143,"kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p085:m0169","surface":"潘濬","start":169,"end":171,"kind":"person","person_id":"pac_tt7_hs3","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p085:m0201","surface":"李桓","start":201,"end":203,"kind":"person","person_id":"xqk_f8a_dvz","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p085:m0204","surface":"羅厲","start":204,"end":206,"kind":"person","person_id":"psh_zpl_fps","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-047-sun-quan","book_id":"b-sanguozhi-047","work_id":"w-sanguozhi","source_id":"s-sanguozhi-047-sun-quan-ws2602668"},{"id":"c-sanguozhi-047-sun-quan:p087","text":"　　五年春，鑄大錢，一當五百。詔使吏民輸銅，計銅畀直。設盜鑄之科。二月，武昌言甘露降於禮賓殿。輔吳將軍張昭卒。中郎將吾粲獲李桓，將軍唐咨獲羅厲等。自十月不雨，至於夏。冬十月，彗星見於東方。鄱陽賊彭旦等爲亂。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":97,"last_line":97,"raw_start":18945,"raw_end":19076,"raw_character_offsets":[18945,18946,18947,18948,18949,18950,18951,18952,18953,18954,18955,18956,18957,18958,18959,18960,18961,18962,18963,18964,18965,18966,18967,18968,18969,18970,18971,18972,18973,18974,18975,18976,18977,18978,18979,18980,18981,18982,18983,18984,18985,18986,18987,18996,18997,18998,19001,19002,19003,19004,19005,19006,19007,19008,19009,19010,19011,19012,19013,19014,19015,19016,19017,19018,19019,19020,19028,19029,19032,19033,19034,19035,19036,19037,19038,19039,19040,19041,19042,19043,19044,19045,19046,19047,19048,19049,19050,19058,19059,19062,19063,19064,19065,19066,19067,19068,19069,19070,19071,19072,19073,19074,19075],"revision_id":2602668},"mentions":[{"id":"c-sanguozhi-047-sun-quan:p087:m0051","surface":"張昭","start":51,"end":53,"kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p087:m0058","surface":"吾粲","start":58,"end":60,"kind":"person","person_id":"pax_gtm_aew","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p087:m0061","surface":"李桓","start":61,"end":63,"kind":"person","person_id":"xqk_f8a_dvz","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p087:m0066","surface":"唐咨","start":66,"end":68,"kind":"person","person_id":"qc3_bcx_r3n","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p087:m0069","surface":"羅厲","start":69,"end":71,"kind":"person","person_id":"psh_zpl_fps","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p087:m0097","surface":"彭旦","start":97,"end":99,"kind":"person","person_id":"pvw_xt7_57g","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-047-sun-quan","book_id":"b-sanguozhi-047","work_id":"w-sanguozhi","source_id":"s-sanguozhi-047-sun-quan-ws2602668"},{"id":"c-sanguozhi-060-lvdai:line053","text":"　　黃龍三年，以南土清定，召岱還屯長沙漚口。會武陵蠻夷蠢動，岱與太常潘浚共討定之。嘉禾三年，權令岱領潘璋士眾，屯陸口，後徙蒲圻。四年，廬陵賊李桓、路合、會稽東冶賊隨春、南海賊羅厲等一時並起。權復詔岱督劉纂、唐咨等分部討擊，春即時首降，岱拜春偏將軍，使領其眾，遂為列將，桓、厲等皆見斬獲，傳首詣都。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-060-lvdai:line053:m0014","start":14,"end":15,"surface":"岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0030","start":30,"end":31,"surface":"岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0034","start":34,"end":36,"surface":"潘浚","kind":"person","person_id":"pac_tt7_hs3","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0046","start":46,"end":47,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0048","start":48,"end":49,"surface":"岱","kind":"person","person_id":"2oe_qam_pq4","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0050","start":50,"end":52,"surface":"潘璋","kind":"person","person_id":"v4f_db2_eqv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0070","start":70,"end":72,"surface":"李桓","kind":"person","person_id":"xqk_f8a_dvz","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0073","start":73,"end":75,"surface":"路合","kind":"person","person_id":"cvc_zj4_1jp","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0081","start":81,"end":83,"surface":"隨春","kind":"person","person_id":"zep_wit_qg1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line053:m0087","start":87,"end":89,"surface":"羅厲","kind":"person","person_id":"psh_zpl_fps","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-060-lvdai:line0