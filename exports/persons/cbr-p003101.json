{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003101","canonical_person_id":"a7k_sl0_d7u","id_aliases":["cbr-p003101"],"identity_policy":"contextual_provisional","person_ids":["a7k_sl0_d7u"],"persons":[{"id":"a7k_sl0_d7u","label":"金王孫（外戚世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"金王孫","mention_ids":["c-shiji-049-waiqi:m018-0069","c-shiji-049-waiqi:m035-0043"]},{"surface":"金氏","mention_ids":["c-shiji-049-waiqi:m018-0101","c-shiji-049-waiqi:m018-0104"]},{"surface":"王孫","mention_ids":["c-shiji-049-waiqi:m035-0047"]}],"evidence":[{"mention_id":"c-shiji-049-waiqi:m018-0069","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p018","quote":"金王孫"},{"mention_id":"c-shiji-049-waiqi:m035-0043","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p035","quote":"金王孫"},{"mention_id":"c-shiji-049-waiqi:m018-0101","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p018","quote":"金氏"},{"mention_id":"c-shiji-049-waiqi:m018-0104","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p018","quote":"金氏"},{"mention_id":"c-shiji-049-waiqi:m035-0047","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p035","quote":"王孫"}],"id_aliases":["cbr-p003101"]},{"id":"a7k_sl0_d7u_A","label":"修成君（外戚世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"修成君","mention_ids":["c-shiji-049-waiqi:m035-0416"]}],"evidence":[{"mention_id":"c-shiji-049-waiqi:m035-0416","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p035","quote":"修成君"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p035","quote":"褚先生曰：臣為郎時，問習漢家故事者鐘離生。曰：王太后在民閒時所生（子）［一］女者，父為金王孫。王孫已死，景帝崩後，武帝已立，王太后獨在。而韓王孫名嫣素得幸武帝，承閒白言太后有女在長陵也。武帝曰：「何不蚤言！」乃使使往先視之，在其家。武帝乃自往迎取之。蹕道，先驅旄騎出橫城門，乘輿馳至長陵。當小市西入里，里門閉，暴開門，乘輿直入此里，通至金氏門外止，使武騎圍其宅，為其亡走，身自往取不得也。即使左右群臣入呼求之。家人驚恐，女亡匿內中床下。扶持出門，令拜謁。武帝下車泣曰：「嚄！大姊，何藏之深也！」詔副車載之，迴車馳還，而直入長樂宮。行詔門著引籍，通到謁太后。太后曰：「帝倦矣，何從來？」帝曰：「今者至長陵得臣姊，與俱來。」顧曰：「謁太后！」太后曰：「女某邪？」曰：「是也。」太后為下泣，女亦伏地泣。武帝奉酒前為壽，奉錢千萬，奴婢三百人，公田百頃，甲第，以賜姊。太后謝曰：「為帝費焉。」於是召平陽主、南宮主、林慮主三人俱來謁見姊，因號曰修成君。有子男一人，女一人。男號為修成子仲，女為諸侯王王后。此二子非劉氏，以故太后憐之。修成子仲驕恣，陵折吏民，皆患苦之。","source_term":"父為金王孫"}],"source_assertion_id":"a-shiji049-040","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"a7k_sl0_d7u"},"id_aliases":["cbr-p003122"]}],"source_mention_summary":[{"source_id":"s-shiji-049-waiqi","work_id":"w-shiji","book_id":"b-shiji-049","chapter_id":"c-shiji-049-waiqi","mention_count":5,"mention_ids":["c-shiji-049-waiqi:m018-0069","c-shiji-049-waiqi:m018-0101","c-shiji-049-waiqi:m018-0104","c-shiji-049-waiqi:m035-0043","c-shiji-049-waiqi:m035-0047"],"paragraph_ids":["c-shiji-049-waiqi:p018","c-shiji-049-waiqi:p035"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-049-waiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji049-040","subject_person_id":"a7k_sl0_d7u_A","predicate":"father","object_person_id":"a7k_sl0_d7u","status":"source_attested","evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p035","quote":"褚先生曰：臣為郎時，問習漢家故事者鐘離生。曰：王太后在民閒時所生（子）［一］女者，父為金王孫。王孫已死，景帝崩後，武帝已立，王太后獨在。而韓王孫名嫣素得幸武帝，承閒白言太后有女在長陵也。武帝曰：「何不蚤言！」乃使使往先視之，在其家。武帝乃自往迎取之。蹕道，先驅旄騎出橫城門，乘輿馳至長陵。當小市西入里，里門閉，暴開門，乘輿直入此里，通至金氏門外止，使武騎圍其宅，為其亡走，身自往取不得也。即使左右群臣入呼求之。家人驚恐，女亡匿內中床下。扶持出門，令拜謁。武帝下車泣曰：「嚄！大姊，何藏之深也！」詔副車載之，迴車馳還，而直入長樂宮。行詔門著引籍，通到謁太后。太后曰：「帝倦矣，何從來？」帝曰：「今者至長陵得臣姊，與俱來。」顧曰：「謁太后！」太后曰：「女某邪？」曰：「是也。」太后為下泣，女亦伏地泣。武帝奉酒前為壽，奉錢千萬，奴婢三百人，公田百頃，甲第，以賜姊。太后謝曰：「為帝費焉。」於是召平陽主、南宮主、林慮主三人俱來謁見姊，因號曰修成君。有子男一人，女一人。男號為修成子仲，女為諸侯王王后。此二子非劉氏，以故太后憐之。修成子仲驕恣，陵折吏民，皆患苦之。"}],"qualifiers":{"source_term":"父為金王孫","historicity":"historical_tradition"},"interpretation_note":"按明示子女、生、母、兄弟姊及婚姻的局部敘事保存；祖孫不作父子，不補未名者姓名。衛青子數各層原語並存，親屬判讀不代表數量已核定。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-049-waiqi:m018-0069","start":69,"end":72,"surface":"金王孫","kind":"person","person_id":"a7k_sl0_d7u","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p018","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m018-0101","start":101,"end":103,"surface":"金氏","kind":"person","person_id":"a7k_sl0_d7u","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p018","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m018-0104","start":104,"end":106,"surface":"金氏","kind":"person","person_id":"a7k_sl0_d7u","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p018","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m035-0043","start":43,"end":46,"surface":"金王孫","kind":"person","person_id":"a7k_sl0_d7u","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p035","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m035-0047","start":47,"end":49,"surface":"王孫","kind":"person","person_id":"a7k_sl0_d7u","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p035","chapter_id":"c-shiji-049-waiqi"}],"relations":[{"id":"a-shiji049-040","subject_person_id":"a7k_sl0_d7u_A","predicate":"father","object_person_id":"a7k_sl0_d7u","status":"source_attested","evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p035","quote":"褚先生曰：臣為郎時，問習漢家故事者鐘離生。曰：王太后在民閒時所生（子）［一］女者，父為金王孫。王孫已死，景帝崩後，武帝已立，王太后獨在。而韓王孫名嫣素得幸武帝，承閒白言太后有女在長陵也。武帝曰：「何不蚤言！」乃使使往先視之，在其家。武帝乃自往迎取之。蹕道，先驅旄騎出橫城門，乘輿馳至長陵。當小市西入里，里門閉，暴開門，乘輿直入此里，通至金氏門外止，使武騎圍其宅，為其亡走，身自往取不得也。即使左右群臣入呼求之。家人驚恐，女亡匿內中床下。扶持出門，令拜謁。武帝下車泣曰：「嚄！大姊，何藏之深也！」詔副車載之，迴車馳還，而直入長樂宮。行詔門著引籍，通到謁太后。太后曰：「帝倦矣，何從來？」帝曰：「今者至長陵得臣姊，與俱來。」顧曰：「謁太后！」太后曰：「女某邪？」曰：「是也。」太后為下泣，女亦伏地泣。武帝奉酒前為壽，奉錢千萬，奴婢三百人，公田百頃，甲第，以賜姊。太后謝曰：「為帝費焉。」於是召平陽主、南宮主、林慮主三人俱來謁見姊，因號曰修成君。有子男一人，女一人。男號為修成子仲，女為諸侯王王后。此二子非劉氏，以故太后憐之。修成子仲驕恣，陵折吏民，皆患苦之。"}],"qualifiers":{"source_term":"父為金王孫","historicity":"historical_tradition"},"interpretation_note":"按明示子女、生、母、兄弟姊及婚姻的局部敘事保存；祖孫不作父子，不補未名者姓名。衛青子數各層原語並存，親屬判讀不代表數量已核定。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji049-053","person_id":"a7k_sl0_d7u","surfaces":["王孫","金氏","金王孫"],"scope":"same_chapter","chapter_ids":["c-shiji-049-waiqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-049-waiqi:p018","quote":"王太后，槐裏人，母曰臧兒。臧兒者，故燕王臧荼孫也。臧兒嫁為槐裏王仲妻，生男曰信，與兩女。而仲死，臧兒更嫁長陵田氏，生男蚡、勝。臧兒長女嫁為金王孫婦，生一女矣，而臧兒卜筮之，曰兩女皆當貴。因欲奇兩女，乃奪金氏。金氏怒，不肯予決，乃內之太子宮。太子幸愛之，生三女一男。男方在身時，王美人夢日入其懷。以告太子，太子曰：「此貴徵也。」未生而孝文帝崩，孝景帝即位，王夫人生男。"},{"paragraph_id":"c-shiji-049-waiqi:p035","quote":"褚先生曰：臣為郎時，問習漢家故事者鐘離生。曰：王太后在民閒時所生（子）［一］女者，父為金王孫。王孫已死，景帝崩後，武帝已立，王太后獨在。而韓王孫名嫣素得幸武帝，承閒白言太后有女在長陵也。武帝曰：「何不蚤言！」乃使使往先視之，在其家。武帝乃自往迎取之。蹕道，先驅旄騎出橫城門，乘輿馳至長陵。當小市西入里，里門閉，暴開門，乘輿直入此里，通至金氏門外止，使武騎圍其宅，為其亡走，身自往取不得也。即使左右群臣入呼求之。家人驚恐，女亡匿內中床下。扶持出門，令拜謁。武帝下車泣曰：「嚄！大姊，何藏之深也！」詔副車載之，迴車馳還，而直入長樂宮。行詔門著引籍，通到謁太后。太后曰：「帝倦矣，何從來？」帝曰：「今者至長陵得臣姊，與俱來。」顧曰：「謁太后！」太后曰：「女某邪？」曰：「是也。」太后為下泣，女亦伏地泣。武帝奉酒前為壽，奉錢千萬，奴婢三百人，公田百頃，甲第，以賜姊。太后謝曰：「為帝費焉。」於是召平陽主、南宮主、林慮主三人俱來謁見姊，因號曰修成君。有子男一人，女一人。男號為修成子仲，女為諸侯王王后。此二子非劉氏，以故太后憐之。修成子仲驕恣，陵折吏民，皆患苦之。"}],"rationale":"按明示名、字及各帝后局部親屬敘事暫接；王夫人分景帝皇后與武帝趙妃，代王分文帝與後來少子武。未名者不補姓名，褚氏附載另留原語。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-049-waiqi:p018","text":"王太后，槐裏人，母曰臧兒。臧兒者，故燕王臧荼孫也。臧兒嫁為槐裏王仲妻，生男曰信，與兩女。而仲死，臧兒更嫁長陵田氏，生男蚡、勝。臧兒長女嫁為金王孫婦，生一女矣，而臧兒卜筮之，曰兩女皆當貴。因欲奇兩女，乃奪金氏。金氏怒，不肯予決，乃內之太子宮。太子幸愛之，生三女一男。男方在身時，王美人夢日入其懷。以告太子，太子曰：「此貴徵也。」未生而孝文帝崩，孝景帝即位，王夫人生男。","annotation_status":"