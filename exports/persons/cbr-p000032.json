001-wudi:m021-0353","start":353,"end":354,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m021-0356","start":356,"end":357,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"}],"chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-001-wudi:p026","text":"舜年二十以孝聞，年三十堯舉之，年五十攝行天子事，年五十八堯崩，年六十一代堯踐帝位。踐帝位三十九年，南巡狩，崩於蒼梧之野。葬於江南九疑，是爲零陵。舜之踐帝位，載天子旗，往朝父瞽叟，夔夔唯謹，如子道。封弟象爲諸侯。舜子商均亦不肖，舜乃豫薦禹於天。十七年而崩。三年喪畢，禹亦乃讓舜子，如舜讓堯子。諸侯歸之，然後禹踐天子位。堯子丹朱，舜子商均，皆有疆土，以奉先祀。服其服，禮樂如之。以客見天子，天子弗臣，示不敢專也。","mentions":[{"id":"c-shiji-001-wudi:m026-0000","start":0,"end":1,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0011","start":11,"end":12,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0028","start":28,"end":29,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0036","start":36,"end":37,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0072","start":72,"end":73,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0086","start":86,"end":88,"surface":"瞽叟","kind":"person","person_id":"8gq_slb_ulu","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0100","start":100,"end":101,"surface":"象","kind":"person","person_id":"a00_ney_bf4","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0105","start":105,"end":106,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0107","start":107,"end":109,"surface":"商均","kind":"person","person_id":"mvm_6am_j2n","status":"source_identified"},{"id":"c-shiji-001-wudi:m026-0113","start":113,"end":114,"surface":"舜","kind":"person","p