ay_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-lun:p013:m0254","surface":"趙泉","start":254,"end":256,"person_id":"adq_p6n_vw1","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-lun:p013","chapter_id":"c-jinshu-059-prince-lun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-prince-lun:p013","text":"自義兵之起，百官將士咸欲誅倫、秀以謝天下。秀知眾怒難犯，不敢出省。及聞河北軍悉敗，憂懣不知所為。義陽王威勸秀至尚書省與八坐議征戰之備，秀從之。使京城四品以下子弟年十五以上，皆詣司隸，從倫出戰。內外諸軍悉欲劫殺秀，威懼，自崇禮闥走還下舍。許超、士猗、孫會等軍既並還，乃與秀謀，或欲收余卒出戰，或欲焚燒宮室，誅殺不附己者，挾倫南就孫旂、孟觀等，或欲乘船東走入海，許未決。王輿反之，率營兵七百餘人自南掖門入，敕宮中兵各守衛諸門，三部司馬為應於內。輿自往攻秀，秀閉中書南門。輿放兵登牆燒屋，秀及超、猗遽走出，左衛將軍趙泉斬秀等以徇。收孫奇于右衛營，付廷尉誅之。執前將軍謝惔、黃門令駱休、司馬督王潛，皆於殿中斬之。三部司馬兵於宣化闥中斬孫弼以徇，時司馬馥在秀坐，輿使將士囚之於散騎省，以大戟守省閣。八坐皆入殿中，坐東除樹下。王輿屯雲龍門，使倫為詔曰：「吾為孫秀等所誤，以怒三王。今已誅秀，其迎太上復位，吾歸老于農畝。」傳詔以騶虞幡敕將士解兵。文武官皆奔走，莫敢有居者。黃門將倫自華林東門出，及荂皆還汶陽里第。於是以甲士數千迎天子于金墉，百姓咸稱萬歲。帝自端門入，升殿，御廣室，送倫及荂等付金墉城。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":83,"last_line":83,"raw_start":8375,"raw_end":8903,"raw_character_offsets":[8377,8378,8379,8380,8381,8382,8383,8384,8385,8386,8387,8388,8389,8390,8391,8392,8393,8394,8395,8396,8397,8398,8399,8400,8401,8402,8403,8404,8405,8406,8407,8408,8409,8410,8411,8412,8413,8414,8415,8416,8417,8418,8419,8420,8421,8422,8423,8424,8425,8426,8427,8428,8429,8430,8431,8432,8433,8434,8435,8436,8437,8438,8439,8440,8441,8442,8443,8444,8445,8446,8447,8448,8449,8450,8451,8452,8453,8454,8455,8456,8457,8458,8459,8460,8461,8462,8463,8464,8465,8466,8467,8468,8469,8470,8471,8472,8473,8474,8475,8476,8477,8478,8479,8480,8481,8482,8483,8484,8485,8486,8487,8488,8489,8490,8491,8492,8493,8494,8495,8496,8497,8498,8499,8500,8501,8502,8503,8504,8505,8506,8507,8508,8509,8510,8511,8512,8513,8514,8515,8516,8517,8518,8519,8520,8521,8522,8523