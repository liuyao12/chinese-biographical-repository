n","person_id":"d35_ba2_b9a","status":"contextual_provisional"},{"id":"c-songshu-056-xiezhan:p003:m0042","start":42,"end":44,"surface":"僕役","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"家人僕役群體，未補名或生父。"},{"id":"c-songshu-056-xiezhan:p003:m0049","start":49,"end":50,"surface":"自","kind":"person","person_id":"aa6_83c_juy_AAAE","status":"contextual_provisional","interpretation_note":"㬭親自執勞，自為㬭回指，不指郭氏。"},{"id":"c-songshu-056-xiezhan:p003:m0052","start":52,"end":53,"surface":"母","kind":"person","person_id":"d35_ba2_b9a","status":"contextual_provisional","interpretation_note":"承所生母郭氏；只指㬭生母，不轉給其兄弟。"},{"id":"c-songshu-056-xiezhan:p003:m0061","start":61,"end":65,"surface":"一家尊卑","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"家人僕役群體，未補名或生父。"},{"id":"c-songshu-056-xiezhan:p003:m0066","start":66,"end":67,"surface":"㬭","kind":"person","person_id":"aa6_83c_juy_AAAE","status":"contextual_provisional"},{"id":"c-songshu-056-xiezhan:p003:m0103","start":103,"end":104,"surface":"自","kind":"person","person_id":"aa6_83c_juy_AAAE","status":"contextual_provisional","interpretation_note":"固辭未就的主語㬭自稱，不是兄或徐羡之。"},{"id":"c-songshu-056-xiezhan:p003:m0105","start":105,"end":106,"surface":"兄","kind":"person","person_id":"aa6_83c_juy_AAAA","status":"contextual_provisional","interpretation_note":"兄居權貴承前晦勢重、瞻自退；編輯依全單元辨晦，不是瞻在豫章任官之稱。"},{"id":"c-songshu-056-xiezhan:p003:m0117","start":117,"end":120,"surface":"徐羡之","kind":"person","person_id":"4y6_myv_ojh","status":"contextual_provisional"},{"id":"c-songshu-056-xiezhan:p003:m0145","start":145,"end":146,"surface":"其","kind":"person","person_id":"aa6_83c_juy_AAAE","status":"contextual_provisional","interpretation_note":"其子世平屬被誅㬭，非徐羡之之子。"},{"id":"c-songshu-056-xiezhan:p003:m0147","start":147,"end":149,"surface":"世平","kind":"person","person_id":"aa6_83c_juy_AAAEA","status":"contextual_provisional"}],"annotation_status":"in_progress","source_position":{"first_line":44,"last_line":53,"editori