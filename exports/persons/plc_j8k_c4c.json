,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817],"projection_sha256":"5e29fdbf1f116bc9219a6f0ce00a7cf0a58e71685e4eeb5752bf523365323cd5"},"chapter_id":"c-nanqishu-047-xietiao","book_id":"b-nanqishu-047","work_id":"w-nanqishu","source_id":"s-nanqishu-047-xietiao-ws1492435"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016","text":"　　慧景過廣陵數十里，召會諸軍主曰：「吾荷三帝厚恩，當顧託之重。幼主昏狂，朝廷壞亂，危而不扶，責在今日。欲與諸君共建大功，以安宗社，何如？」衆皆響應。於是回軍還廣陵，司馬崔恭祖守廣陵城，開門納之。帝聞變，以征虜將軍右衞將軍左興盛假節，督京邑水陸衆軍。慧景停二日，便收衆濟江集京口。江夏王寶玄又爲內應，合二鎮兵力，奉寶玄向京師。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":42,"last_line":42,"raw_start":3206,"raw_end":3369,"raw_character_offsets":[3206,3207,3208,3209,3210,3211,3212,3213,3214,3215,3216,3217,3218,3219,3220,3221,3222,3223,3224,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368],"revision_id":1504716},"mentions":[{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0002","start":2,"end":4,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0022","start":22,"end":23,"surface":"帝","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0032","start":32,"end":34,"surface":"幼主","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0085","start":85,"end":88,"surface":"崔恭祖","kind":"person","person_id":"jdk_9jk_otv","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0098","start":98,"end":99,"surface":"帝","kind":"person","person_id":"w4m_9tw_147_A","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0111","start":111,"end":114,"surface":"左興盛","kind":"person","person_id":"plc_j8k_c4c","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0125","start":125,"end":127,"surface":"慧景","kind":"person","person_id":"tvq_7my_nqh","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0140","start":140,"end":145,"surface":"江夏王寶玄","kind":"person","person_id":"w4m_9tw_147_B","status":"contextual_provisional"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p016:m0157","start":157,"end":159,"surface":"寶玄","kind":"person","person_id":"w4m_9tw_147_B","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","book_id":"b-nanqishu-051","work_id":"w-nanqishu","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:p018","text":"　　臺遣中領軍王瑩都督衆軍，據湖頭築壘，上帶蔣山西巖，實甲數萬。慧景至查硎，竹塘人萬副兒善射獵，能捕虎，投慧景曰：「今平路皆爲臺軍所斷，不可議進。唯宜從蔣山龍尾上，出其不意耳。」慧景從之，分遣千餘人魚貫緣山，自西巖夜下，鼓呌臨城中。臺軍驚恐，卽時奔散。帝又遣右衞將軍左興盛率臺內三萬人，拒慧景於北籬門，望風退走。慧景引軍入樂遊苑，恭祖率輕騎十餘匹突進北掖門，乃復出，宮門皆閉。慧景引衆圍之。於是東府、石頭、白下、新亭諸城皆潰。左興盛走，不得入宮，逃淮渚荻舫中，慧景擒殺之。宮中遣兵出盪，不剋。慧景燒蘭臺府署爲戰場，守衞尉蕭暢屯南掖門處分城內，隨方應擊，衆心以此稍安。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":46,"last_line":46,"raw_start":3636,"raw_end":3919,"raw_character_offsets":[3636,3637,3638,3639,3640,3641,3642,3643,3644,3645,3646,3647,3648,3649,3650,3651,3652,3653,3654,3655,3656,3657,3658,3659,3660,3661,3662,3663,3664,3665,3666,3667,3668,3669,3670,3671,3672,3673,3674,3675,3676,3677,3678,3679,3680,3681,3682,3683,3684,3685,3686,368