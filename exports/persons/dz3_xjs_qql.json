h_id":"c-jinshu-098-wangdun-comparison:p036","person_mention_id":"c-jinshu-098-wangdun-comparison:p036:m0008","source_anchor":{"start":8,"end":10,"surface":"吳儒"},"quote":"既而周光斬錢鳳，吳儒斬沈充，並傳首京師。有司議曰：「王敦滔天作逆，有無君之心，宜依崔杼、王浚故事，剖棺戮屍，以彰元惡。」於是發瘞出屍，焚其衣冠，跽而刑之。敦、充首同日懸于南桁，觀者莫不稱慶。敦首既懸，莫敢收葬者。尚書令郗鑒言於帝曰：「昔王莽漆頭以輗車，董卓然腹以照市，王淩儭土，徐馥焚首。前朝誅楊駿等，皆先極官刑，後聽私殯。然《春秋》許齊襄之葬紀侯，魏武義王修之哭袁譚。由斯言之，王誅加於上，私義行於下。臣以為可聽私葬，於義為弘。」昭許之，於是敦家收葬焉。含父子乘單船奔荊州刺史王舒，舒使人沈之于江，餘黨悉平。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p036:m0008","start":8,"end":10,"surface":"吳儒","person_id":"dz3_xjs_qql","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p036","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p040:m0261","start":261,"end":263,"surface":"吳儒","person_id":"dz3_xjs_qql","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p040","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p040:m0265","start":265,"end":266,"surface":"儒","person_id":"dz3_xjs_qql","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p040","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p040:m0324","start":324,"end":325,"surface":"儒","person_id":"dz3_xjs_qql","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p040","chapter_id":"c-jinshu-098-wangdun-comparison"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-098-wangdun-comparison:p036","text":"既而周光斬錢鳳，吳儒斬沈充，並傳首京師。有司議曰：「王敦滔天作逆，有無君之心，宜依崔杼、王浚故事，剖棺戮屍，以彰元惡。」於是發瘞出屍，焚其衣冠，跽而刑之。敦、充首同日懸于南桁，觀者莫不稱慶。敦首既懸，莫敢收葬者。尚書令郗鑒言於帝曰：「昔王莽漆頭以輗車，董卓然腹以照市，王淩儭土，徐馥焚首。前朝誅楊駿等，皆先極官刑，後聽私殯。然《春秋》許齊襄之葬紀侯，魏武義王