jizhan:p009:m0522","surface":"裴盾","start":522,"end":524,"person_id":"u2l_hn8_au3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-jizhan:p009:m0525","surface":"東海王越","start":525,"end":529,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-068-jizhan:p009:m0547","surface":"陸玩","start":547,"end":549,"person_id":"u3v_t2p_tcu","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-068-jizhan","book_id":"b-jinshu-068","work_id":"w-jinshu","source_id":"s-jinshu-068-jizhan-ws2581578"},{"id":"c-jinshu-070-bianhu:p002","text":"壼弱冠有名譽司、兗二州。齊王冏辟皆不就。遇家禍，還鄉里。永嘉中，除著作郎，襲父爵。征東將軍周馥請爲從事中郎，不就。遭本州傾覆，東依妻兄徐州刺史裴盾。盾以壼行廣陵相。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":62,"last_line":62,"raw_start":5774,"raw_end":5863,"raw_character_offsets":[5781,5782,5783,5784,5785,5786,5787,5788,5789,5790,5791,5792,5793,5794,5795,5796,5797,5798,5799,5800,5801,5802,5803,5804,5805,5806,5807,5808,5809,5810,5811,5812,5813,5814,5815,5816,5817,5818,5819,5820,5821,5822,5823,5824,5825,5826,5827,5828,5829,5830,5831,5832,5833,5834,5835,5836,5837,5838,5839,5840,5841,5842,5843,5844,5845,5846,5847,5848,5849,5850,5851,5852,5853,5854,5855,5856,5857,5858,5859,5860,5861,5862],"revision_id":2595540},"mentions":[{"id":"c-jinshu-070-bianhu:p002:m0014","surface":"冏","start":14,"end":15,"person_id":"ee0_b2a_68e","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-bianhu:p002:m0045","surface":"周馥","start":45,"end":47,"person_id":"3xx_gdy_or6_BA","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-bianhu:p002:m0071","surface":"裴盾","start":71,"end":73,"person_id":"u2l_hn8_au3","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-070-bianhu","book_id":"b-jinshu-070","work_id":"w-jinshu","source_id":"s-jinshu-070-bianhu-ws2595540"},{"id":"c-jinshu-070-bianhu:p004","text":"壼天性狷狹，不能和俗，退以情事，欲畢志家門。亡父往爲中書令，時壼蒙大例，望門見辟，信其所執，得不祗就。門戶遇禍，迸竄易名，得存視息，私志有素。加嬰極難，流寄蘭陵，爲苟晞所召，恐見逼迫，依下邳裴盾，又見假授，思暫之郡，規得託身。尋蒙見召，爲從事中郎，豈曰貪榮，直欲自致，規暫恭命，行當乞退。屬華軼之難，不敢自陳。軼既梟懸，壼亦嬰病，具自歸聞，未蒙恕遣。世子北征，選寵顯望，復以無施，忝充元佐。榮則榮矣，實非素懷。顧以命重人輕，不敢辭憚。聞西臺召壼爲尚書郎，實欲因此以避賢路，未及陳誠，奄丁窮罰。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":66,"last_line":66,"raw_start":5939,"raw_end":6200,"raw_character_offsets":[5954,5955,5956,5957,5958,5959,5960,5961,5962,5963,5964,5965,5966,5967,5968,5969,5970,5971,5972,5973,5974,5975,5976,5977,5978,5979,5980,5981,5982,5983,5984,5985,5986,5987,5988,5989,5990,5991,5992,5993,5994,5995,5996,5997,5998,5999,6000,6001,6002,6003,6004,6005,6006,6007,6008,6009,6010,6011,6012,6013,6014,6015,6016,6017,6018,6019,6020,6021,6022,6023,6024,6025,6026,6027,6028,6029,6030,6031,6032,6033,6034,6035,6036,6037,6038,6039,6040,6041,6042,6043,6044,6045,6046,6047,6048,6049,6050,6051,6052,6053,6054,6055,6056,6057,6058,6059,6060,6061,6062,6063,6064,6065,6066,6067,6068,6069,6070,6071,6072,6073,6074,6075,6076,6077,6078,6079,6080,6081,6082,6083,6084,6085,6086,6087,6088,6089,6090,6091,6092,6093,6094,6095,6096,6097,6098,6099,6100,6101,6102,6103,6104,6105,6106,6107,6108,6109,6110,6111,6112,6113,6114,6115,6116,6117,6118,6119,6120,6121,6122,6123,6124,6125,6126,6127,6128,6129,6130,6131,6132,6133,6134,6135,6136,6137,6138,6139,6140,6141,6142,6143,6144,6145,6146,6147,6148,6149,6150,6151,6152,6153,6154,6155,6156,6157,6158,6159,6160,6161,6162,6163,6164,6165,6166,6167,6168,6169,6170,6171,6172,6173,6174,6175,6176,6177,6178,6179,6180,6181,6182,6183,6184,6185,6186,6187,6188,6189,6190,6191,6192,6193,6194,6195,6196,6197,6198,6199],"revision_id":2595540},"mentions":[{"id":"c-jinshu-070-bianhu:p004:m0082","surface":"苟晞","start":82,"end":84,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-bianhu:p004:m0095","surface":"裴盾","start":95,"end":97,"person_id":"u2l_hn8_au3","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-070-bianhu:p004:m0145","surface":"華軼","start":145,"end":147,"perso