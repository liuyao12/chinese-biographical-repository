ertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-061-gouxi:p013","text":"初，越疑晞與帝有謀，使游騎于成阜間，獲晞使，果得詔令及朝廷書，遂大構疑隙。越出牧豫州以討晞，復下檄說晞罪惡，遣從事中郎楊瑁為兗州，與徐州刺史裴盾共討晞。晞使騎收河南尹潘滔，滔夜遁，及執尚書劉會、侍中程延，斬之。會越薨，盾敗，詔晞為大將軍大都督、督青徐兗豫荊揚六州諸軍事，增邑二萬戶，加黃鉞，先官如故。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":90,"last_line":90,"raw_start":7065,"raw_end":7217,"raw_character_offsets":[7067,7068,7069,7070,7071,7072,7073,7074,7075,7076,7077,7078,7079,7080,7081,7082,7083,7084,7085,7086,7087,7088,7089,7090,7091,7092,7093,7094,7095,7096,7097,7098,7099,7100,7101,7102,7103,7104,7105,7106,7107,7108,7109,7110,7111,7112,7113,7114,7115,7116,7117,7118,7119,7120,7121,7122,7123,7124,7125,7126,7127,7128,7129,7130,7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212,7213,7214,7215,7216],"revision_id":7903772},"mentions":[{"id":"c-jinshu-061-gouxi:p013:m0002","surface":"越","start":2,"end":3,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p013:m0004","surface":"晞","start":4,"end":5,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p013:m0019","surface":"晞","start":19,"end":20,"person_id":"v5s_1ew_vh0","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p013:m0037","surface":"越","start":37,"end":38,"person_id":"9o2_vhv_r7y","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-061-gouxi:p013:m0044","surface":"晞","start":44,"end":