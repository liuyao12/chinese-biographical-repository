04","quote":"崧累遷侍中。是時謝萬為豫州都督，疲于親賓相送，方臥在室。崧徑造之，謂曰：「卿令疆理西籓，何以為政？」萬粗陳其意。崧便為敘刑政之要數百言。萬遂起坐，呼崧小字曰：「阿酃！故有才具邪！」哀帝雅好服食，崧諫以為「非萬乘所宜。陛下此事，實日月之一食也」。後以公事免，卒於家。子耆，官至散騎常侍。","subject_person_mention_id":"c-jinshu-071-gaosong:p004:m0133","object_person_mention_id":"c-jinshu-071-gaosong:p004:m0000"}],"status":"source_attested","interpretation_note":"上承高崧卒於家。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-071-gaosong:p004:m0133","surface":"耆","start":133,"end":134,"person_id":"5ix_gtx_ytf","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-071-gaosong:p004","chapter_id":"c-jinshu-071-gaosong"}],"relations":[{"id":"a-jin071-gaoqi-father","subject_person_id":"5ix_gtx_ytf","object_person_id":"745_5cb_b3e","predicate":"father","qualifiers":{"source_term":"子耆，官至散騎常侍"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-071","chapter_id":"c-jinshu-071-gaosong","source_id":"s-jinshu-071-gaosong-ws2595541","paragraph_id":"c-jinshu-071-gaosong:p004","quote":"崧累遷侍中。是時謝萬為豫州都督，疲于親賓相送，方臥在室。崧徑造之，謂曰：「卿令疆理西籓，何以為政？」萬粗陳其意。崧便為敘刑政之要數百言。萬遂起坐，呼崧小字曰：「阿酃！故有才具邪！」哀帝雅好服食，崧諫以為「非萬乘所宜。陛下此事，實日月之一食也」。後以公事免，卒於家。子耆，官至散騎常侍。","subject_person_mention_id":"c-jinshu-071-gaosong:p004:m0133","object_person_mention_id":"c-jinshu-071-gaosong:p004:m0000"}],"status":"source_attested","interpretation_note":"上承高崧卒於家。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-071-gaosong:p004","text":"崧累遷侍中。是時謝萬為豫州都督，疲于親賓相送，方臥在室。崧徑造之，謂曰：「卿令疆理西籓，何以為政？」萬粗陳其意。崧便為敘刑政之要數百言。萬遂起坐，呼崧小字曰：「阿酃！故有才具邪！」哀帝雅好服食，崧諫以為「非萬乘所宜。陛下此事，實日月之一食也」。後以公事免，卒於家。子耆，官至散騎常侍。","text_la