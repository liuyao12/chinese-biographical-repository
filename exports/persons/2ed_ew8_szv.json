kind":"person","person_id":"gfr_55l_72s","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0055","start":55,"end":57,"surface":"任敖","kind":"person","person_id":"yka_hay_sdj","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0062","start":62,"end":65,"surface":"申屠嘉","kind":"person","person_id":"yph_dkb_w4w","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0080","start":80,"end":81,"surface":"蕭","kind":"person","person_id":"xd8_uww_5ok","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0082","start":82,"end":83,"surface":"曹","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m020-0084","start":84,"end":86,"surface":"陳平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"},{"id":"c-shiji-096-zhang:p029","text":"太史公曰：深惟士之游宦所以至封侯者，微甚。然多至御史大夫即去者。諸為大夫而丞相次也，其心冀幸丞相物故也。或乃陰私相毀害，欲代之。然守之日久不得，或為之日少而得之，至於封侯，真命也夫！御史大夫鄭君守之數年不得，匡君居之未滿歲，而韋丞相死，即代之矣，豈可以智巧得哉！多有賢聖之才，困妯囡者眾甚也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhang:m029-0000","start":0,"end":3,"surface":"太史公","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"索隱指出本論敘匡衡以來事而為後人所述；保留太史公署稱，不與第20段敘者直接同指，亦不補為褚少孫本人。"},{"id":"c-shiji-096-zhang:m029-0095","start":95,"end":97,"surface":"鄭君","kind":"person","person_id":"33z_av8_anq","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m029-0104","start":104,"end":106,"surface":"匡君","kind":"person","person_id":"484_day_gmv","status":"contextual_provisional"},{"id":"c-shiji-096-zhang:m029-0113","start":113,"end":116,"surface":"韋丞相","kind":"person","person_id":"vna_am7_jn5_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-096-zhang","book_id":"b-shiji-096","work_id":"w-shiji","source_id":"s-shiji-096-zhang"}],"sources":[{"chapter_id":"c