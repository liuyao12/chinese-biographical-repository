ault":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-049-liuyou-complete:p002:m0008","surface":"本","start":8,"end":9,"kind":"person","person_id":"wsk_64k_juo","status":"contextual_provisional","paragraph_id":"c-sanguozhi-049-liuyou-complete:p002","chapter_id":"c-sanguozhi-049-liuyou-complete"}],"relations":[],"title_holdings":[{"id":"th-sanguozhi-049-liuyou-complete-2-32","title":"般长","kind":"office","mode":"attestation","person_id":"wsk_64k_juo","attestations":[{"id":"th-sanguozhi-049-liuyou-complete-2-32:a","paragraph_id":"c-sanguozhi-049-liuyou-complete:p002","start":32,"end":34,"surface":"般长","person_mention_id":"c-sanguozhi-049-liuyou-complete:p002:m0008","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-049","chapter_id":"c-sanguozhi-049-liuyou-complete","source_id":"s-sanguozhi-049-liuyou-complete-ws2075209","paragraph_id":"c-sanguozhi-049-liuyou-complete:p002","quote":"续汉书曰：繇祖父本，师受经传，博学群书，号为通儒。举贤良方正，为般长，卒官。宠字祖荣，受父业，以经明行修，举孝廉，光禄（大夫）察四行，除东平陵令。视事数年，以母病弃官，百姓士民攀舆拒轮，充塞道路，车不得前，乃止亭，轻服潜遁，归脩供养。后辟大将军府，稍迁会稽太守，正身率下，郡中大治。徵入为将作大匠。山阴县民去治数十里有若邪中在山谷间，五六老翁年皆七八十，闻宠迁，相率共送宠，人赍百钱。宠见，劳来曰：“父老何乃自苦远来！”皆对曰：“山谷鄙老，生未尝至郡县。他时吏发求不去，民间或夜不绝狗吠，竟夕民不得安。自明府下车以来，狗不夜吠，吏稀至民间，年老遭值圣化，今闻当见弃去，故戮力来送。”宠谢之，为选受一大钱，故会稽号宠为取一钱太守。其清如是。宠前后历二郡，八居九列，四登三事。家不藏贿，无重宝器，恆菲饮食，薄衣服，弊车羸马，号为窭陋。三去相位，辄归本土。往来京师，常下道脱骖过，人莫知焉。宠尝欲止亭，亭吏止之曰：“整顿传舍，以待刘公，不可得止。”宠因过去。其廉俭皆此类也。以老病卒于家。","person_mention_id":"c-sanguozhi-049-liuyou-complete:p002:m0008"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[