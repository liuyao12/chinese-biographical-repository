preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-061-luyin:line066:m0136","start":136,"end":138,"surface":"黃吳","kind":"person","person_id":"468_pnc_sbs","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-061-luyin:line066","chapter_id":"c-sanguozhi-061-luyin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-061-luyin:line066","text":"　　胤字敬宗，凱弟也。始為御史、尚書選曹郎，太子和聞其名，待以殊禮。會全寄、楊竺等阿附魯王霸，與和分爭，陰相譖構，胤坐收下獄，楚毒備至，終無他辭。後為衡陽督軍都尉。赤烏十一年，交阯九真夷賊攻沒城邑，交部騷動。以胤為交州刺史、安南校尉。胤入南界，喻以恩信，務祟招納，高涼渠帥黃吳等支黨三千餘家皆出降。引軍而南，重宣至誠，遺以財幣。賊帥百餘人，民五萬餘家，深幽不羈，莫不稽顙，交域清泰。就加安南將軍。復討蒼梧建陵賊，破之，前後出兵八千餘人，以充軍用。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-061-luyin:line066:m0002","start":2,"end":3,"surface":"胤","kind":"person","person_id":"a7e_y62_4rv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-luyin:line066:m0004","start":4,"end":6,"surface":"敬宗","kind":"person","person_id":"a7e_y62_4rv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-luyin:line066:m0007","start":7,"end":8,"surface":"凱","kind":"person","person_id":"61q_ogq_ueq","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-luyin:line066:m0024","start":24,"end":25,"surface":"和","kind":"person","person_id":"572_278_cba_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-luyin:line066:m0035","start":35,"end":37,"surface":"全寄","kind":"person","person_id":"984_9e1_5e9_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-061-luyin:line066:m0038","start":38,"end":