ntextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0127","start":127,"end":129,"surface":"曹納","kind":"person","person_id":"lxi_6qm_eb1","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0150","start":150,"end":151,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0160","start":160,"end":161,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0168","start":168,"end":169,"surface":"納","kind":"person","person_id":"lxi_6qm_eb1","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0244","start":244,"end":245,"surface":"峻","kind":"person","person_id":"lrg_cze_g1l","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0253","start":253,"end":255,"surface":"蘇逸","kind":"person","person_id":"63b_09a_c6f","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0260","start":260,"end":261,"surface":"鑒","kind":"person","person_id":"6lr_zci_i0j","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0264","start":264,"end":266,"surface":"李閎","kind":"person","person_id":"17a_fd0_7e1","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-067-xijian:line082:m0304","start":304,"end":305,"surface":"曇","kind":"person","person_id":"e5k_f2i_cog","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":82,"last_line":82,"revision_id":2592755},"source_quote":{"witness":"j67","quote":"及陶侃為盟主，進鑒都督揚州八郡軍事。時撫軍將軍王舒、輔軍將軍虞潭皆受鑒節度，率眾渡江，與侃會于茄子浦。鑒築白石壘而據之。會舒、潭戰不利，鑒與後將軍郭默還丹徒，立大業、曲阿、庱亭三壘以距賊。而賊將張健來攻大業，城中乏水，郭默窘迫，遂突圍而出，三軍失色。參軍曹納以為大業京口之扞，一旦不守，賊方軌而前，勸鑒退還廣陵以俟後舉。鑒乃大會僚佐，責納曰：「吾蒙先帝厚顧，荷託付之重，正復捐軀九泉不足以報。今彊寇在郊，眾心危迫，君腹心之佐，而生長異端，當何以率先義眾，鎮一三軍邪！」將斬之，久而乃釋。會峻死，大業圍解。及蘇逸等走吳興，鑒遣參軍李閎追斬之，降男女萬餘口。拜司空，加侍中，解八郡都督，更封南昌縣公，以先爵封其子曇。","raw_start":8337,"raw_end":8643,"raw_line":82},"chapter_id":"c-jinshu-067-xijian","book_id":"b-jinshu-067","work_id":"w-jinshu","source_id":"s-jinshu-067-xijian"}],"sources":[{"chapter_id":"c-jinshu-067-xijian","work_id":"w-jinshu","book_id":"b-jinshu-067","source_id":"s-jinshu-067-xijian","source":{"title":"晉書卷六十七","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=2592755","permalink":"https://zh.wikisource.org/w/index.php?oldid=2592755","revision_id":2592755,"accessed_on":"2026-11-21","extent":"固定數位原題「郗鑒」題下全文。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫固定修訂2592755","raw_path":"sources/jinshu/wikisource-2592755-raw.wikitext","wikitext_sha256":"bfbb80734b71669aaed368f54f088c89285f1acdbe70ca678745ea9684029495","raw_file_sha256":"bfbb80734b71669aaed368f54f088c89285f1acdbe70ca678745ea9684029495","collation_witnesses":["source-evidence/jin067-xijian-relatives/reading.json"]}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
