d":"fixed_witness_person_fact_slots","key":"jin034-yanghu-family","slot":"detail_002"}},{"id":"sd-jin034-yanghu-yi-removed-after-refusal","person_id":"dqd_5q9_pkz_BAC","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","chapter_id":"c-jinshu-034-yanghu","source_id":"s-jinshu-034-ws2567662-yanghu","paragraph_id":"c-jinshu-034-yanghu:p038","quote":"帝以祜兄子暨為嗣，暨以父沒不得為人後。帝又令暨弟伊為祜後，又不奉詔。帝怒，並收免之。太康二年，以伊弟篇為钜平侯，奉祜嗣。篇曆官清慎，有私牛於官舍產犢，及遷而留之，位至散騎常侍，早卒。","person_mention_id":"c-jinshu-034-yanghu:p038:m0024"}],"reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"interpretation_note":"並收免之的兩受者，未明當時何官，不給其各職補終年。","fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin034-yanghu-family","slot":"career_yi-removed-after-refusal"},"kind":"removal_report","source_term":"並收免之","source_anchor":{"paragraph_id":"c-jinshu-034-yanghu:p038","start":37,"end":41,"surface":"並收免之"},"source_revision":2567662,"paragraph_sha256":"249408f2a680f64e6fefeadf5c642178e51d51fb99c1b9c33e57cefc0e938ca5","values":{"office_title":null,"reason":"refusal_of_ritual_succession","all_prior_holdings_not_ended":true},"date_expression":null}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin034-yanghu-yi-younger-than-ji","subject_person_id":"dqd_5q9_pkz_BAC","predicate":"brother","object_person_id":"dqd_5q9_pkz_BAB","qualifiers":{"source_term":"弟","relative_birth_order":{"older_person_id":"dqd_5q9_pkz_BAB","younger_person_id":"dqd_5q9_pkz_BAC","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings"},"relative_age":"younger"},"status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-ws2567662-yanghu","chapter_id":"c-jinshu-034-yanghu","paragraph_id":"c-jinshu-034-yanghu:p041","quote":"發長子倫，高陽相。倫弟暨，陽平太守。暨弟伊，初為車騎賈充掾，後曆平南將軍、都督江北諸軍事，鎮宛，為張昌所殺，追贈鎮南將軍。祜伯父秘，官至京兆太守。子祉，魏郡太守。秘孫亮，字長玄，有才能，多計數。與之交者，必偽盡款誠，人皆謂得其心，而殊非其實也。初為太傅楊駿參軍，時京兆多盜竊。駿欲更重其法，盜百錢加大辟，請官屬會議，亮曰：「昔楚江乙母失布，以為盜由令尹。公若無欲，盜宜自止，何重法為？」駿慚而止。累轉大鴻臚。時惠帝在長安，亮與關東連謀，內不自安，奔於并州，為劉元海所害。亮弟陶，為徐州刺史。","subject_person_mention_id":"c-jinshu-034-yanghu:p041:m0020","object_person_mention_id":"c-jinshu-034-yanghu:p041:m0018"}],"interpretation_note":"只給相對長幼，不因相接弟字把暨/伊/篇定成2/3/4，亦不把兄弟關係冒成發的明父斷言。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin034-yanghu-family","slot":"kin_019"}},{"id":"a-jin034-yanghu-pian-younger-than-yi","subject_person_id":"dqd_5q9_pkz_BAD","predicate":"brother","object_person_id":"dqd_5q9_pkz_BAC","qualifiers":{"source_term":"弟","relative_birth_order":{"older_person_id":"dqd_5q9_pkz_BAC","younger_person_id":"dqd_5q9_pkz_BAD","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings"},"relative_age":"younger"},"status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-ws2567662-yanghu","chapter_id":"c-jinshu-034-yanghu","paragraph_id":"c-jinshu-034-yanghu:p038","quote":"帝以祜兄子暨為嗣，暨以父沒不得為人後。帝又令暨弟伊為祜後，又不奉詔。帝怒，並收免之。太康二年，以伊弟篇為钜平侯，奉祜嗣。篇曆官清慎，有私牛於官舍產犢，及遷而留之，位至散騎常侍，早卒。","subject_person_mention_id":"c-jinshu-034-yanghu:p038:m0050","object_person_mention_id":"c-jinshu-034-yanghu:p038:m0048"}],"interpretation_note":"只給相對長幼，不因相接弟字把暨/伊/篇定成2/3/4，亦不把兄弟關係冒成發的明父斷言。","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null,"fixed_source_fact_binding":{"kind":"fixed_witness_person_fact_slots","key":"jin034-yanghu-family","slot":"kin_020"}}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"nc-jin034-yanghu-yi","person_id":"dqd_5q9_pkz_BAC","surname":"羊","ming":"伊","additional_names":[],"chapter_id":"c-jinshu-034-yanghu","paragraph_id":"c-jinshu-034-yanghu:p041","person_mention_id":"c-jinshu-034-yanghu:p041:m0020","quote":"發長子倫，高陽相。倫弟暨，陽平太守。暨弟伊，初為車騎賈充掾，後曆平南將軍、都督江北諸軍事，鎮宛，為張昌所殺，追贈鎮南將軍。祜伯父秘，官至京兆太守。子祉，魏郡太守。秘孫亮，字長玄，有才能，多計數。與之交者，必偽盡款誠，人皆謂得其心，而殊非其實也。初為太傅楊駿參軍，時京兆多盜竊。駿欲更重其法，盜百錢加大辟，請官屬會議，亮曰：「昔楚江乙母失布，以為盜由令尹。公若無欲，盜宜自止，何重法為？」駿慚而止。累轉大鴻臚。時惠帝在長安，亮與關東連謀，內不自安，奔於并州，為劉元海所害。亮弟陶，為徐州刺史。","status":"contextual_provisional","human_reviewed":false,"model":null,"fixed_biography_name_binding":{"kind":"fixed_punctuated_biography_name","source_revision":2567662,"paragraph_sha256":"abb52dd8f5575d4f36ef61106aa6df496350cd2a7717751e24b61328d598b38e","mode":"ming_only","name_mention_id":"c-jinshu-034-yanghu:p041:m0020","zi_mention_id":null,"alias_bindings":[],"title_prefix":null,"title_suffix":null},"surname_basis":{"kind":"contextual_surname_from_fixed_biography_family","status":"contextual_provisional","human_reviewed":false,"rationale":"同一完整傳內明稱羊祜，以逐項來源已證父系關係承接羊姓；編輯判讀，不稱各省姓名錨直接寫姓，亦不從家族ID或母系、奉嗣推姓。","seed_name_record_id":"nc-jin034-yanghu-hu","steps":[{"assertion_id":"a-jin034-yanghu-older-brother-fa","from_person_id":"dqd_5q9_pkz_BD","to_person_id":"dqd_5q9_pkz_BA","generation_before":0,"generation_after":0,"traversal":"subject_to_object"},{"assertion_id":"a-jin034-yanghu-lun-father","from_person_id":"dqd_5q9_pkz_BA","to_person_id":"dqd_5q9_pkz_BAA","generation_before":0,"generation_after":1,"traversal":"object_to_subject"},{"assertion_id":"a-jin034-yanghu-ji-younger-than-lun","from_person_id":"dqd_5q9_pkz_BAA","to_person_id":"dqd_5q9_pkz_BAB","generation_before":1,"generation_after":1,"traversal":"object_to_subject"},{"assertion_id":"a-jin034-yanghu-yi-younger-than-ji","from_person_id":"dqd_5q9_pkz_BAB","to_person_id":"dqd_5q9_pkz_BAC","generation_before":1,"generation_after":1,"traversal":"object_to_subject"}]},"work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-ws2567662-yanghu"}],"life_events":[{"id":"le-jin034-yanghu-yi-killed","person_id":"dqd_5q9_pkz_BAC","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","chapter_id":"c-jinshu-034-yanghu","source_id":"s-jinshu-034-ws2567662-yanghu","paragraph_id":"c-jinsh