ntions":[{"id":"c-jinshu-066-taokan:p015:m0175","surface":"張誕","start":175,"end":177,"person_id":"j1z_p40_z32","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-066-taokan:p015","chapter_id":"c-jinshu-066-taokan"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-066-taokan:p015","text":"初，庾亮少有高名，以明穆皇后之兄受顧命之重，蘇峻之禍，職亮是由。及石頭平，懼侃致討，亮用溫嶠謀，詣侃拜謝。侃遽止之，曰：「庾元規乃拜陶士行邪！」王導入石頭城，令取故節，侃笑曰：「蘇武節似不如是！」導有慚色，使人屏之。侃旋江陵，尋以為侍中、太尉，加羽葆鼓吹，改封長沙郡公，邑三千戶，賜絹八千匹，加都督交、廣、寧七州軍事。以江陵偏遠，移鎮巴陵。遣諮議參軍張誕討五溪夷，降之。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":57,"last_line":57,"raw_start":6894,"raw_end":7081,"raw_character_offsets":[6896,6897,6898,6899,6900,6901,6902,6903,6904,6905,6906,6907,6908,6909,6910,6911,6912,6913,6914,6915,6916,6917,6918,6919,6920,6921,6922,6923,6924,6925,6926,6927,6928,6929,6930,6931,6932,6933,6934,6935,6936,6937,6938,6939,6940,6941,6942,6943,6944,6945,6946,6947,6948,6949,6950,6951,6952,6953,6954,6955,6956,6957,6958,6959,6960,6961,6962,6963,6964,6965,6966,6967,6968,6969,6970,6971,6972,6973,6974,6975,6976,6977,6978,6979,6980,6981,6982,6983,6984,6985,6986,6987,6988,6989,6990,6991,6992,6993,6994,6995,6996,6997,6998,6999,7000,7001,7002,7003,7004,7005,7006,7007,7008,7009,7010,7011,7012,7013,7014,7015,7016,7017,7018,7019,7020,7021,7022,7023,7024,7025,7026,7027,7028,7029,7030,7031,7032,7033,7034,7035,7036,7037,7038,7039,7040,7041,7042,7043,7044,7045,7046,7047,7048,7049,7050,7051,7052,7053,7054,7055,7056,7057,7058,7059,7060,7061,7062,7063,7064,7065,7066,7067,7068,7069,7070,7071,7072,7073,7074,7075,7076,7077,7078,7079,7080],"revision_id":1527632},"mentions":[{"id":"c-jinshu-066-taokan:p015:m0002","surface":"庾亮","start":2,"end":4,"person_id":"4qr_wrk_3vd_B","kind":"person","status":"contextual_provisional"},{"id":"c-jin