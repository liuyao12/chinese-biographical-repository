provisional"},{"id":"c-shiji-005-qin:m046-0093","start":93,"end":94,"surface":"常","kind":"person","person_id":"cbr-p000270","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m046-0106","start":106,"end":108,"surface":"悼公","kind":"person","person_id":"cbr-p000430","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m046-0115","start":115,"end":118,"surface":"厲共公","kind":"person","person_id":"cbr-p000436","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m046-0120","start":120,"end":122,"surface":"孔子","kind":"person","person_id":"cbr-p000056","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m046-0123","start":123,"end":125,"surface":"悼公","kind":"person","person_id":"cbr-p000430","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p047","text":"厲共公二年，蜀人來賂。十六年，塹河旁。以兵二萬伐大荔，取其王城。二十一年，初縣頻陽。晉取武成。二十四年，晉亂，殺智伯，分其國與趙、韓、魏。二十五年，智開與邑人來奔。三十三年，伐義渠，虜其王。三十四年，日食。厲共公卒，子躁公立。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m047-0000","start":0,"end":3,"surface":"厲共公","kind":"person","person_id":"cbr-p000436","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m047-0028","start":28,"end":30,"surface":"其王","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m047-0056","start":56,"end":58,"surface":"智伯","kind":"person","person_id":"cbr-p000274","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m047-0074","start":74,"end":76,"surface":"智開","kind":"person","person_id":"cbr-p000437","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m047-0092","start":92,"end":94,"surface":"其王","kind":"unresolved","person_id":null,"status":"unresolved","note":"未定指代、群體或官稱；商君語為篇章指引，不當作獨立個人。"},{"id":"c-shiji-005-qin:m047-0103","start":103,"end":106,"surface":"厲共公","kind":"person","person_id":"cbr-p000436","status":"contextual_provisional"},{"id":"c-