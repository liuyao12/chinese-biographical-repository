-luchui-complete:p006:m0105","start":105,"end":107,"surface":"邯鄲","kind":"person","person_id":"37q_jvp_12z","status":"contextual_provisional","paragraph_id":"c-liangshu-027-luchui-complete:p006","chapter_id":"c-liangshu-027-luchui-complete"},{"id":"c-sanguozhi-021-luchui-touhu:p001:m0003","start":3,"end":6,"surface":"邯鄲淳","kind":"person","person_id":"37q_jvp_12z","status":"contextual_provisional","paragraph_id":"c-sanguozhi-021-luchui-touhu:p001","chapter_id":"c-sanguozhi-021-luchui-touhu"},{"id":"c-sanguozhi-021-luchui-touhu:p002:m0006","start":6,"end":7,"surface":"淳","kind":"person","person_id":"37q_jvp_12z","status":"contextual_provisional","paragraph_id":"c-sanguozhi-021-luchui-touhu:p002","chapter_id":"c-sanguozhi-021-luchui-touhu"},{"id":"c-sanguozhi-021-luchui-touhu:p002:m0014","start":14,"end":15,"surface":"淳","kind":"person","person_id":"37q_jvp_12z","status":"contextual_provisional","paragraph_id":"c-sanguozhi-021-luchui-touhu:p002","chapter_id":"c-sanguozhi-021-luchui-touhu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-027-luchui-complete:p006","text":"遷驃騎臨川王東曹掾。是時禮樂制度，多所創革，高祖雅愛倕才，乃敕撰《新漏刻銘》，其文甚美。遷太子中舍人，管東宮書記。又詔爲《石闕銘記》。奏之。敕曰：「太子中舍人陸倕所制《石闕銘》，辭義典雅，足爲佳作。昔虞丘辨物，邯鄲獻賦，賞以金帛，前史美談，可賜絹三十匹。」遷太子庶子、國子博士，母憂去職。服闋，爲中書侍郎，給事黃門侍郎，揚州別駕從事史，以疾陳解。遷鴻臚卿，入爲吏部郎，參選事。出爲雲麾晉安王長史、尋陽太守、行江州府州事。以公事免，左遷中書侍郎、司徒司馬、太子中庶子、廷尉卿。又爲中庶子，加給事中、揚州大中正。復除國子博士、中庶子、中正並如故。守太常卿，中正如故。普通七年，卒，年五十七。文集二十卷，行於世。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":21,"last_line":21,"raw_start":925,"raw_end":1235,"raw_character_offsets":[925,926,927,928,929,930,931,932,933,934,935,936,937,938,939,940,941,942,943,944,945,946,947,948,949,950,951,952,953,954,955,956,957,958,959,960,961,962,963,964,965,966,967,968,969,970,971,972,973,974,975,976,977,978,979,980,981,982,9