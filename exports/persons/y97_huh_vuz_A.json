0,"end":2,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0008","start":8,"end":10,"surface":"繆嬴","kind":"person","person_id":"p7v_f2l_8l5","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0011","start":11,"end":13,"surface":"豐王","kind":"person","person_id":"73a_qx5_k2c","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0015","start":15,"end":17,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0025","start":25,"end":27,"surface":"世父","kind":"person","person_id":"r9u_j0z_xtb_AAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0041","start":41,"end":43,"surface":"世父","kind":"person","person_id":"r9u_j0z_xtb_AAAA","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0048","start":48,"end":51,"surface":"周幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0052","start":52,"end":54,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0055","start":55,"end":57,"surface":"太子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或未核定指代；未由熟知世系補造人物。"},{"id":"c-shiji-005-qin:m009-0059","start":59,"end":61,"surface":"褒姒","kind":"person","person_id":"rkn_3l3_3j3","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0080","start":80,"end":82,"surface":"申侯","kind":"person","person_id":"1ag_0z1_mlq","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0086","start":86,"end":88,"surface":"幽王","kind":"person","person_id":"fd5_uxa_0c9","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0093","start":93,"end":96,"surface":"秦襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0119","start":119,"end":121,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0124","start":124,"end":127,"surface":"周平王","kind":"person","person_id":"f3g_x6y_1iy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0128","start":128,"end":130,"surface":"平王","kind":"person","person_id":"f3g_x6y_1iy","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0131","start":131,"end":133,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0180","start":180,"end":182,"surface":"襄公","kind":"person","person_id":"y97_huh_vuz","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m009-0229","start":229,"end":231,"surface":"文公","kind":"person","person_id":"y97_huh_vuz_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p010","text":"文公元年，居西垂宮。三年，文公以兵七百人東獵。四年，至汧渭之會。曰：「昔周邑我先秦嬴於此，後卒獲為諸侯。」乃卜居之，占曰吉，即營邑之。十年，初為鄜畤，用三牢。十三年，初有史以紀事，民多化者。十六年，文公以兵伐戎，戎敗走。於是文公遂收周餘民有之，地至岐，岐以東獻之周。十九年，得陳寶。二十年，法初有三族之罪。二十七年，伐南山大梓，豐大特。四十八年，文公太子卒，賜謚為竫公。竫公之長子為太子，是文公孫也。五十年，文公卒，葬西山。竫公子立，是為寧公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m010-0000","start":0,"end":2,"surface":"文公","kind":"person","person_id":"y97_huh_vuz_A","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0013","start":13,"end":15,"surface":"文公","kind":"person","person_id":"y97_huh_vuz_A","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0040","start":40,"end":42,"surface":"秦嬴","kind":"person","person_id":"1zm_8zk_4hh","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0099","start":99,"end":101,"surface":"文公","kind":"person","person_id":"y97_huh_vuz_A","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0112","start":112,"end":114,"surface":"文公","kind":"person","person_id":"y97_huh_vuz_A","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m010-0173","start":173,"end":175,"sur