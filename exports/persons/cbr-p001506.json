{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001506","identity_policy":"contextual_provisional","person_ids":["cbr-p001506"],"persons":[{"id":"cbr-p001506","label":"子西（楚令尹）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"子西","mention_ids":["c-shiji-036-chenqi:m025-0138"]}],"evidence":[{"mention_id":"c-shiji-036-chenqi:m025-0138","chapter_id":"c-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p025","quote":"子西"}]}],"mentions":[{"id":"c-shiji-036-chenqi:m025-0138","start":138,"end":140,"surface":"子西","kind":"person","person_id":"cbr-p001506","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p025","chapter_id":"c-shiji-036-chenqi"}],"relations":[],"title_holdings":[{"id":"th-shiji036-066","person_id":"cbr-p001506","title":"令尹","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-036-chenqi","source_id":"s-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p025","quote":"二十三年，楚之白公勝殺令尹子西、子綦，襲惠王。"}],"attestations":[{"id":"th-shiji036-066:a001","paragraph_id":"c-shiji-036-chenqi:p025","start":136,"end":138,"surface":"令尹","person_mention_id":"c-shiji-036-chenqi:m025-0138","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"令尹子西明示，不把並列子綦也授予令尹職號。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji036-105","person_id":"cbr-p001506","surfaces":["子西"],"scope":"same_chapter","chapter_ids":["c-shiji-036-chenqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-036-chenqi:p025","quote":"湣公六年，孔子適陳。吳王夫差伐陳，取三邑而去。十三年，吳復來伐陳，陳告急楚，楚昭王來救，軍於城父，吳師去。是年，楚昭王卒於城父。時孔子在陳。十五年，宋滅曹。十六年，吳王夫差伐齊，敗之艾陵，使人召陳侯。陳侯恐，如吳。楚伐陳。二十一年，齊田常弒其君簡公。二十三年，楚之白公勝殺令尹子西、子綦，襲惠王。葉公攻敗白公，白公自殺。"}],"rationale":"本篇第25段按明示名與稱號、陳／杞世系及具體敘事暫定「子西」同指；引句均保留，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-036-chenqi:p025","text":"湣公六年，孔子適陳。吳王夫差伐陳，取三邑而去。十三年，吳復來伐陳，陳告急楚，楚昭王來救，軍於城父，吳師去。是年，楚昭王卒於城父。時孔子在陳。十五年，宋滅曹。十六年，吳王夫差伐齊，敗之艾陵，使人召陳侯。陳侯恐，如吳。楚伐陳。二十一年，齊田常弒其君簡公。二十三年，楚之白公勝殺令尹子西、子綦，襲惠王。葉公攻敗白公，白公自殺。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m025-0000","start":0,"end":2,"surface":"湣公","kind":"person","person_id":"cbr-p001504","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0005","start":5,"end":7,"surface":"孔子","kind":"person","person_id":"cbr-p000056","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0010","start":10,"end":14,"surface":"吳王夫差","kind":"person","person_id":"cbr-p000434","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0038","start":38,"end":41,"surface":"楚昭王","kind":"person","person_id":"cbr-p000426","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0049","start":49,"end":51,"surface":"吳師","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m025-0056","start":56,"end":59,"surface":"楚昭王","kind":"person","person_id":"cbr-p000426","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0065","start":65,"end":67,"surface":"孔子","kind":"person","person_id":"cbr-p000056","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0082","start":82,"end":86,"surface":"吳王夫差","kind":"person","person_id":"cbr-p000434","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0095","start":95,"end":96,"surface":"人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m025-0097","start":97,"end":99,"surface":"陳侯","kind":"person","person_id":"cbr-p001504","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m025-0100","start":100,"end":102,"surface":"陳侯","kind":"person","pers