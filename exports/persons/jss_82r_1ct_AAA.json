an-complete-1-30:a","paragraph_id":"c-chenshu-023-lushan-complete:p001","start":30,"end":34,"surface":"御史中丞","person_mention_id":"c-chenshu-023-lushan-complete:p001:m0026","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-023","chapter_id":"c-chenshu-023-lushan-complete","source_id":"s-chenshu-023-lushan-complete-ws1514496","paragraph_id":"c-chenshu-023-lushan-complete:p001","quote":"陸繕字士繻，吳郡吳人也。祖惠曉，齊太常卿。父（倕）〔任〕，梁御史中丞。","person_mention_id":"c-chenshu-023-lushan-complete:p001:m0026"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"person_references":[{"id":"c-chenshu-023-lushan-complete:p002:r0071","paragraph_id":"c-chenshu-023-lushan-complete:p002","start":71,"end":72,"surface":"父","person_id":"jss_82r_1ct_AAA","referent_role":"third_person","quote":"繕幼有志尚，以雅正知名。起家梁宣惠武陵王法曹參軍。承聖中，授中書侍郎，掌東宮管記。江陵陷，繕微服遁還京師。紹泰元年，除司徒右長史，御史中丞，以父任所終，固辭不就。高祖引繕為司徒司馬，遷給事黃門侍郎、領步兵校尉、通直散騎常侍，兼侍中。永定元年，遷侍中。時留異擁割東陽，新安人向文政與異連結，因據本郡，朝廷以繕為貞威將軍、新安太守。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-chenshu-023-lushan-complete","book_id":"b-chenshu-023","work_id":"w-chenshu","source_id":"s-chenshu-023-lushan-complete-ws1514496"},{"id":"c-chenshu-023-lushan-complete:p003:r0113","paragraph_id":"c-chenshu-023-lushan-complete:p003","start":113,"end":114,"surface":"父","person_id":"jss_82r_1ct_AAA","referent_role":"third_person","quote":"世祖嗣位，徵為太子中庶子，領步兵校尉，掌東宮管記。繕儀表端麗，進退閑雅，世祖使太子諸王咸取則焉。其趨步躡履，皆令習繕規矩。除尚書吏部郎中，步兵如故，仍侍東宮。陳寶應平後，出為貞毅將軍、建安太守。秩滿，為散騎常侍、御史中丞，猶以父之所終，固辭，不許，乃權換廨宇徙居之。","note":"依本段敘事、稱謂及語者受者定。","chapter_id":"c-chenshu-023-lushan-complete","book_id":"b-chenshu-023","work_id":"w-chenshu","source_id":"s-chenshu-023-lushan-complete-ws1514496"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],