守，卒官，穎往赴喪，權知其詐病，急驛收錄。畯亦馳語穎，使還謝權。權怒廢畯，而穎得免罪。久之，以畯為尚書令，後卒。畯著《孝經傳》《潮水論》，又與裴玄、張承論管仲、季路。皆傳於世。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-053-yanjun:line021:m0002","start":2,"end":4,"surface":"嚴畯","kind":"person","person_id":"szg_rhg_18d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0005","start":5,"end":7,"surface":"曼才","kind":"person","person_id":"szg_rhg_18d","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0043","start":43,"end":46,"surface":"諸葛瑾","kind":"person","person_id":"lpo_z63_vzb","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0047","start":47,"end":49,"surface":"步騭","kind":"person","person_id":"snv_2iq_jes","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0075","start":75,"end":77,"surface":"張昭","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0080","start":80,"end":82,"surface":"孫權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0083","start":83,"end":84,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0100","start":100,"end":102,"surface":"魯肅","kind":"person","person_id":"ooa_1fr_hy9","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0104","start":104,"end":105,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-053-yanjun:line021:m0106","start":106,"end":107,"surface":"畯","kind":"person","person_id":"szg_rhg_18d