tion_count":1,"mention_ids":["c-sanguozhi-052-zhouzhao-complete:line118:m0076"],"paragraph_ids":["c-sanguozhi-052-zhouzhao-complete:line118"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-052-zhouzhao-complete:line118:m0076","mention_ids":["c-sanguozhi-052-zhouzhao-complete:line118:m0076"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-sanguozhi-052-zhugejin-complete","work_id":"w-sanguozhi","book_id":"b-sanguozhi-052","chapter_id":"c-sanguozhi-052-zhugejin-complete","raw_mention_count":1,"mention_ids":["c-sanguozhi-052-zhugejin-complete:line066:m0045"],"paragraph_ids":["c-sanguozhi-052-zhugejin-complete:line066"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-sanguozhi-052-zhugejin-complete:line066:m0045","mention_ids":["c-sanguozhi-052-zhugejin-complete:line066:m0045"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-sanguozhi-053-yanjun"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-wu053-yanjun0","person_id":"ooa_1fr_hy9","event_type":"death","source_term":"橫江將軍魯肅卒","date_expression":null,"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-053","chapter_id":"c-sanguozhi-053-yanjun","source_id":"s-sanguozhi-053-yanjun","paragraph_id":"c-sanguozhi-053-yanjun:line021","quote":"　　嚴畯字曼才，彭城人也。少耽學，善《詩》《書》、三《禮》，又好《說文》。避亂江東，與諸葛瑾、步騭齊名友善。性質直純厚，其於人物，忠告善道，志存補益。張昭進之於孫權，權以為騎都尉、從事中郎。及橫江將軍魯肅卒，權以畯代肅，督兵萬人，鎮據陸口。眾人咸為畯喜。畯前後固辭：「樸素書生，不閒軍事，非才而據，咎悔必至。」發言慷慨，至於流涕，權乃聽焉，世嘉其能以實讓。權為吳王，及稱尊號，畯嘗為衛尉，使至蜀，蜀相諸葛亮深善之。不畜祿賜，皆散之親戚知故，家常不充。廣陵劉穎與畯有舊，穎精學家巷，權聞徵之，以疾不就。其弟略為零陵太守，卒官，穎往赴喪，權知其詐病，急驛收錄。畯亦馳語穎，使還謝權。權怒廢畯，而穎得免罪。久之，以畯為尚書令，後卒。畯著《孝經傳》《潮水論》，又與裴玄、張承論管仲、季路。皆傳於世。","person_mention_id":"c-sanguozhi-053-yanjun:line021:m0100"}],"interpretation_note":"本來源所記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01:m0091","start":91,"end":93,"surface":"鲁肃","kind":"person","person_id":"ooa_1fr_hy9","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01","chapter_id":"c-sanguozhi-052-zhangzhao-complete"},{"id":"c-sanguozhi-052-zhouzhao-complete:line118:m0076","start":76,"end":79,"surface":"魯橫江","kind":"person","person_id":"ooa_1fr_hy9","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhouzhao-complete:line118","chapter_id":"c-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0045","start":45,"end":47,"surface":"魯肅","kind":"person","person_id":"ooa_1fr_hy9","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhugejin-complete:line066","chapter_id":"c-sanguozhi-052-zhugejin-complete"},{"id":"c-sanguozhi-053-yanjun:line021:m0100","start":100,"end":102,"surface":"魯肅","kind":"person","person_id":"ooa_1fr_hy9","st