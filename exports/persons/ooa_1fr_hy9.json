i-052-zhouzhao-complete","book_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhouzhao-complete"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01","text":"江表传曰：权既即尊位，请会百官，归功周瑜。昭举笏欲褒赞功德，未及言，权曰：「如张公之计，今已乞食矣。」昭大惭，伏地流汗。昭忠謇亮直，有大臣节，权敬重之，然所以不相昭者，盖以昔駮周瑜、鲁肃等议为非也。","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01:m0005","start":5,"end":6,"surface":"权","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01:m0018","start":18,"end":20,"surface":"周瑜","kind":"person","person_id":"f56_938_997","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01:m0021","start":21,"end":22,"surface":"昭","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01:m0034","start":34,"end":35,"surface":"权","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01:m0039","start":39,"end":41,"surface":"张公","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01:m0051","start":51,"end":52,"surface":"昭","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhangzhao-complete:line018-pei01-01:m0060","start":60,"end":61,"surface":"昭","kind":"person","person_id":"roi_rz4_ute","status":"contextual_provisiona