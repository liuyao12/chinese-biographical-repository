ook_id":"b-sanguozhi-052","work_id":"w-sanguozhi","source_id":"s-sanguozhi-052-zhouzhao-complete"},{"id":"c-sanguozhi-052-zhugejin-complete:line066","text":"諸葛瑾字子瑜，琅邪陽都人也。漢末避亂江東。值孫策卒，孫權姊婿曲阿弘咨見而異之，薦之於權，與魯肅等並見賓待。後爲權長史，轉中司馬。建安二十年，權遣瑾使蜀通好劉備，與其弟亮俱公會相見，退無私面。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0000","start":0,"end":3,"surface":"諸葛瑾","kind":"person","person_id":"lpo_z63_vzb","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0004","start":4,"end":6,"surface":"子瑜","kind":"person","person_id":"lpo_z63_vzb","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0022","start":22,"end":24,"surface":"孫策","kind":"person","person_id":"e9c_070_567","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0026","start":26,"end":28,"surface":"孫權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0028","start":28,"end":29,"surface":"姊","kind":"person","person_id":"ahg_8sn_5ac","status":"contextual_provisional","interpretation_note":"讀本段前後及對話，所指按此處記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0032","start":32,"end":34,"surface":"弘咨","kind":"person","person_id":"ocq_ok7_fnx","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0042","start":42,"end":43,"surface":"權","kind":"person","person_id":"572_278_cba","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0045","start":45,"end":47,"surface":"魯肅","kind":"person","person_id":"ooa_1fr_hy9","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugejin-complete:line066:m0055","sta