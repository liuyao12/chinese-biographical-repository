{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004072","identity_policy":"contextual_provisional","person_ids":["cbr-p004072"],"persons":[{"id":"cbr-p004072","label":"涇陽君（蘇秦列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"涇陽君","mention_ids":["c-shiji-069-su:m047-0026","c-shiji-069-su:m047-0080","c-shiji-069-su:m051-0169"]}],"evidence":[{"mention_id":"c-shiji-069-su:m047-0026","chapter_id":"c-shiji-069-su","paragraph_id":"c-shiji-069-su:p047","quote":"涇陽君"},{"mention_id":"c-shiji-069-su:m047-0080","chapter_id":"c-shiji-069-su","paragraph_id":"c-shiji-069-su:p047","quote":"涇陽君"},{"mention_id":"c-shiji-069-su:m051-0169","chapter_id":"c-shiji-069-su","paragraph_id":"c-shiji-069-su:p051","quote":"涇陽君"}]}],"mentions":[{"id":"c-shiji-069-su:m047-0026","start":26,"end":29,"surface":"涇陽君","kind":"person","person_id":"cbr-p004072","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p047","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m047-0080","start":80,"end":83,"surface":"涇陽君","kind":"person","person_id":"cbr-p004072","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p047","chapter_id":"c-shiji-069-su"},{"id":"c-shiji-069-su:m051-0169","start":169,"end":172,"surface":"涇陽君","kind":"person","person_id":"cbr-p004072","status":"contextual_provisional","paragraph_id":"c-shiji-069-su:p051","chapter_id":"c-shiji-069-su"}],"relations":[],"title_holdings":[{"id":"th-shiji069-013","person_id":"cbr-p004072","title":"涇陽君","kind":"noble_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-069-su","source_id":"s-shiji-069-su","paragraph_id":"c-shiji-069-su:p051","quote":"今王若欲因禍為福，轉敗為功，則莫若挑霸齊而尊之，使使盟於周室，焚秦符，曰「其大上計，破秦；其次，必長賓之」。秦挾賓以待破，秦王必患之。秦五世伐諸侯，今為齊下，秦王之志苟得窮齊，不憚以國為功。然則王何不使辯士以此言說秦王曰：「燕、趙破宋肥齊，尊之為之下者，燕、趙非利之也。燕、趙不利而勢為之者，以不信秦王也。然則王何不使可信者接收燕、趙，令涇陽君、高陵君先於燕、趙？秦有變，因以為質，則燕、趙信秦。秦為西帝，燕為北帝，趙為中帝，立三帝以令於天下。韓、魏不聽則秦伐之，齊不聽則燕、趙伐之，天下孰敢不聽？天下服聽，因驅韓、魏以伐齊，曰『必反宋地，歸楚淮北』。反宋地，歸楚淮北，燕、趙之所利也；並立三帝，燕、趙之所願也。夫實得所利，尊得所願，燕、趙棄齊如脫躧矣。今不收燕、趙，齊霸必成。諸侯贊齊而王不從，是國伐也；諸侯贊齊而王從之，是名卑也。今收燕、趙，國安而名尊；不收燕、趙，國危而名卑。夫去尊安而取危卑，智者不為也。」秦王聞若說，必若刺心然。則王何不使辯士以此若言說秦？秦必取，齊必伐矣。"}],"attestations":[{"id":"th-shiji069-013:a001","paragraph_id":"c-shiji-069-su:p051","start":169,"end":172,"surface":"涇陽君","person_mention_id":"c-shiji-069-su:m051-0169","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"只按本篇明示授封、任事與文獻用稱保存；未知起訖不補曆日，死後王號與傳世敘事年代仍待版本及研究覆核。擬議三帝與未受宋地不當已持有；不因去國、被刺或卒而終止全部官爵。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji069-051","person_id":"cbr-p004072","scope":"same_chapter","chapter_ids":["c-shiji-069-su"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["涇陽君"],"evidence":[{"paragraph_id":"c-shiji-069-su:p047","quote":"蘇代過魏，魏為燕執代。齊使人謂魏王曰：「齊請以宋地封涇陽君，秦必不受。秦非不利有齊而得宋地也，不信齊王與蘇子也。今齊魏不和如此其甚，則齊不欺秦。秦信齊，齊秦合，涇陽君有宋地，非魏之利也。故王不如東蘇子，秦必疑齊而不信蘇子矣。齊秦不合，天下無變，伐齊之形成矣。」於是出蘇代。代之宋，宋善待之。"},{"paragraph_id":"c-shiji-069-su:p051","quote":"今王若欲因禍為福，轉敗為功，則莫若挑霸齊而尊之，使使盟於周室，焚秦符，曰「其大上計，破秦；其次，必長賓之」。秦挾賓以待破，秦王必患之。秦五世伐諸侯，今為齊下，秦王之志苟得窮齊，不憚以國為功。然則王何不使辯士以此言說秦王曰：「燕、趙破宋肥齊，尊之為之下者，燕、趙非利之也。燕、趙不利而勢為之者，以不信秦王也。然則王何不使可信者接收燕、趙，令涇陽君、高陵君先於燕、趙？秦有變，因以為質，則燕、趙信秦。秦為西帝，燕為北帝，趙為中帝，立三帝以令於天下。韓、魏不聽則秦伐之，齊不聽則燕、趙伐之，天下孰敢不聽？天下服聽，因驅韓、魏以伐齊，曰『必反宋地，歸楚淮北』。反宋地，歸楚淮北，燕、趙之所利也；並立三帝，燕、趙之所願也。夫實得所利，尊得所願，燕、趙棄齊如脫躧矣。今不收燕、趙，齊霸必成。諸侯贊齊而王不從，是國伐也；諸侯贊齊而王從之，是名卑也。今收燕、趙，國安而名尊；不收燕、趙，國危而名卑。夫去尊安而取危卑，智者不為也。」秦王聞若說，必若刺心然。則王何不使辯士以此若言說秦？秦必取，齊必伐矣。"}],"rationale":"按姓名、字稱、遊說對象及嵌入書信局部暫接。蘇代初見燕王、過魏魏王齊王及書信秦王楚王等另存候選，未按歷史年代補熟名；不斷言這些候選必為異人。燕噲讓位段與燕昭王書信分辨，書信內外王稱按引語範圍。穰侯舅與太后母局部暫接，未補姓名或秦王親屬世系。故事家屬與蘇秦家屬分存；全67段明示姓名首輪已存，版本年代、匿名者代詞及其他身份尚待覆核。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-069-su:p047","text":"蘇代過魏，魏為燕執代。齊使人謂魏王曰：「齊請以宋地封涇陽君，秦必不受。秦非不利有齊而得宋地也，不信齊王與蘇子也。今齊魏不和如此其甚，則齊不欺秦。秦信齊，齊秦合，涇陽君有宋地，非魏之利也。故王不如東蘇子，秦必疑齊而不信蘇子矣。齊秦不合，天下無變，伐齊之形成矣。」於是出蘇代。代之宋，宋善待之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m047-0000","start":0,"end":2,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0009","start":9,"end":10,"surface":"代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0012","start":12,"end":14,"surface":"使人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m047-0015","start":15,"end":17,"surface":"魏王","kind":"person","person_id":"cbr-p004071","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0026","start":26,"end":29,"surface":"涇陽君","kind":"person","person_id":"cbr-p004072","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0049","start":49,"end":51,"surface":"齊王","kind":"person","person_id":"cbr-p004073","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0052","start":52,"end":54,"surface":"蘇子","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0080","start":80,"end":83,"surface":"涇陽君","kind":"person","person_id":"cbr-p004072","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0098","start":98,"end":100,"surface":"蘇子","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0108","start":108,"end":110,"surface":"蘇子","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0133","start":133,"end":135,"surface":"蘇代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"},{"id":"c-shiji-069-su:m047-0136","start":136,"end":137,"surface":"代","kind":"person","person_id":"cbr-p004065","status":"contextual_provisional"}],"chapter_id":"c-shiji-069-su","book_id":"b-shiji-069","work_id":"w-shiji","source_id":"s-shiji-069-su"},{"id":"c-shiji-069-su:p051","text":"今王若欲因禍為福，轉敗為功，則莫若挑霸齊而尊之，使使盟於周室，焚秦符，曰「其大上計，破秦；其次，必長賓之」。秦挾賓以待破，秦王必患之。秦五世伐諸侯，今為齊下，秦王之志苟得窮齊，不憚以國為功。然則王何不使辯士以此言說秦王曰：「燕、趙破宋肥齊，尊之為之下者，燕、趙非利之也。燕、趙不利而勢為之者，以不信秦王也。然則王何不使可信者接收燕、趙，令涇陽君、高陵君先於燕、趙？秦有變，因以為質，則燕、趙信秦。秦為西帝，燕為北帝，趙為中帝，立三帝以令於天下。韓、魏不聽則秦伐之，齊不聽則燕、趙伐之，天下孰敢不聽？天下服聽，因驅韓、魏以伐齊，曰『必反宋地，歸楚淮北』。反宋地，歸楚淮北，燕、趙之所利也；並立三帝，燕、趙之所願也。夫實得所利，尊得所願，燕、趙棄齊如脫躧矣。今不收燕、趙，齊霸必成。諸侯贊齊而王不從，是國伐也；諸侯贊齊而王從之，是名卑也。今收燕、趙，國安而名尊；不收燕、趙，國危而名卑。夫去尊安而取危卑，智者不為也。」秦王聞若說，必若刺心然。則王何不使辯士以此若言說秦？秦必取，齊必伐矣。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-069-su:m051-0001","start":1,"end":2,"surface":"王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0024","start":24,"end":26,"surface":"使使","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m051-0061","start":61,"end":63,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0071","start":71,"end":73,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m051-0079","start":79,"end":81,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0097","start":97,"end":98,"surface":"王","kind":"person","person_id":"cbr-p004070","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0101","start":101,"end":103,"surface":"辯士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱、氏族、未名者或未定指代，不補姓名與成員；趙莊戰名性質未定。"},{"id":"c-shiji-069-su:m051-0107","start":107,"end":109,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0149","start":149,"end":151,"surface":"秦王","kind":"person","person_id":"cbr-p004074","status":"contextual_provisional"},{"id":"c-shiji-069-su:m051-0155","st