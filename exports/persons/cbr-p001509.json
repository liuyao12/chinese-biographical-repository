_id":"ghg_5p7_q21_AAA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m028-0254","start":254,"end":257,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"}],"chapter_id":"c-shiji-036-chenqi","book_id":"b-shiji-036","work_id":"w-shiji","source_id":"s-shiji-036-chenqi"},{"id":"c-shiji-036-chenqi:p033","text":"【索隱述贊】盛德之祀，必及百世。舜、禹餘烈，陳、杞是繼。媯滿受封，東樓纂系。閼路篡逆，夏姬淫嬖。二國衰微，或興或替。前並後虜，皆亡楚惠。句踐勃興，田和吞噬。蟬聯血食，豈其苗裔？","annotation_status":"named_mentions_first_pass","text_layer":"witness_appended_suoyin_zan","mentions":[{"id":"c-shiji-036-chenqi:m033-0016","start":16,"end":17,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m033-0018","start":18,"end":19,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m033-0022","start":22,"end":25,"surface":"陳、杞","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m033-0028","start":28,"end":30,"surface":"媯滿","kind":"person","person_id":"6wx_fr3_b2e","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m033-0033","start":33,"end":35,"surface":"東樓","kind":"person","person_id":"rdo_wsn_30x","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m033-0038","start":38,"end":40,"surface":"閼路","kind":"person","person_id":"ohe_hlc_y40","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m033-0043","start":43,"end":45,"surface":"夏姬","kind":"person","person_id":"3id_eoz_71f","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m033-0048","start":48,"end":50,"surface":"二國","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、引語角色、國別、校勘或未定指代；不補未見人名、闕代或成員。"},{"id":"c-shiji-036-chenqi:m033-0065","start":65,"end":67,"surface":"楚惠","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m033-0068","start":68,"end":