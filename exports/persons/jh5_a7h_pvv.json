,"start":121,"end":123,"surface":"王臧","kind":"person","person_id":"jh5_a7h_pvv","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0137","start":137,"end":140,"surface":"竇太后","kind":"person","person_id":"ixk_6fg_v6f_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0143","start":143,"end":145,"surface":"魏其","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0157","start":157,"end":159,"surface":"趙綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0166","start":166,"end":169,"surface":"竇太后","kind":"person","person_id":"ixk_6fg_v6f_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0175","start":175,"end":177,"surface":"趙綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0178","start":178,"end":180,"surface":"王臧","kind":"person","person_id":"jh5_a7h_pvv","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0191","start":191,"end":194,"surface":"柏至侯","kind":"person","person_id":"jex_mvs_w6d","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0194","start":194,"end":196,"surface":"許昌","kind":"person","person_id":"jex_mvs_w6d","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0200","start":200,"end":203,"surface":"武彊侯","kind":"person","person_id":"40p_hkv_oqy","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0203","start":203,"end":206,"surface":"莊青翟","kind":"person","person_id":"40p_hkv_oqy","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0212","start":212,"end":214,"surface":"魏其","kind":"person","person_id":"nuf_tb9_fjs_A","status":"contextual_provisional"},{"id":"c-shiji-107-weiqi:m008-0215","start":215,"end":217,"surface":"武安","kind":"person","person_id":"7mz_d13_9ka_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-107-weiqi","book_id":"b-shiji-107","work_id":"w-shiji","source_id":"s-shiji-107-weiqi"},{"id":"c-shiji-121-rulin:p005","text":"及今上即位，趙綰、王臧之屬明儒學，而上亦鄉之，於是招方正賢良文學之士。自是之后，言詩於魯則申培公，於齊則轅固生，於燕則韓太傅。言尚書自濟南伏生。言禮自魯高堂生。言易自菑川田生。言春秋於齊魯自胡毋生，於趙自董仲舒。及竇太后崩，武安侯田蚡為丞相，絀黃老、刑名百家之言，延文學儒者數百人，而公孫弘以春秋白衣為天子三公，封以平津侯。天下之學士靡然鄉風矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m005-0001","start":1,"end":3,"surface":"今上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0006","start":6,"end":8,"surface":"趙綰","kind":"person","person_id":"8dt_22t_v15","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0009","start":9,"end":11,"surface":"王臧","kind":"person","person_id":"jh5_a7h_pvv","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0018","start":18,"end":19,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0026","start":26,"end":34,"surface":"方正賢良文學之士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0045","start":45,"end":48,"surface":"申培公","kind":"person","person_id":"wxo_k8i_1it","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0052","start":52,"end":55,"surface":"轅固生","kind":"person","person_id":"b1w_3li_mim","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0059","start":59,"end":62,"surface":"韓太傅","kind":"person","person_id":"r6c_fhk_jo9","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0069","start":69,"end":71,"surface":"伏生","kind":"person","person_id":"t6q_oe6_hom","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0076","start":76,"end":79,"surface":"高堂生","kind":"person","person_id":"5sy_nhd_r99","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0085","start":85,"end":87,"surface":"田生","kind":"person","person_id":"m9h_k61_29i","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0095","start":95,"end":98,"surface":"胡毋生","kind":"person","person_id":"08q_8bd_lr8","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0102","start":102,"end":105,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0107","start":107,"end":110,"surface":"竇太后","kind":"person","person_id":"ixk_6fg_v6f_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0115","start":115,"end":117,"surface":"田蚡","kind":"person","person_id":"7mz_d13_9ka_A","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0133","start":133,"end":137,"surface":"文學儒者","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-121-rulin:m005-0142","start":142,"end":145,"surface":"公孫弘","kind":"person","person_id":"q69_35n_f3h","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0151","start":151,"end":153,"surface":"天子","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m005-0162","start":162,"end":167,"surface":"天下之學士","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-121-rulin","book_id":"b-shiji-121","work_id":"w-shiji","source_id":"s-shiji121-rulin"},{"id":"c-shiji-121-rulin:p008","text":"蘭陵王臧既受詩，以事孝景帝為太子少傅，免去。今上初即位，臧乃上書宿衛上，累遷，一歲中為郎中令。及代趙綰亦嘗受詩申公，綰為御史大夫。綰、臧請天子，欲立明堂以朝諸侯，不能就其事，乃言師申公。於是天子使使束帛加璧安車駟馬迎申公，弟子二人乘軺傳從。至，見天子。天子問治亂之事，申公時已八十餘，老，對曰：「為治者不在多言，顧力行何如耳。」是時天子方好文詞，見申公對，默然。然已招致，則以為太中大夫，舍魯邸，議明堂事。太皇竇太后好老子言，不說儒術，得趙綰、王臧之過以讓上，上因廢明堂事，盡下趙綰、王臧吏，後皆自殺。申公亦疾免以歸，數年卒。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-121-rulin:m008-0002","start":2,"end":4,"surface":"王臧","kind":"person","person_id":"jh5_a7h_pvv","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0010","start":10,"end":13,"surface":"孝景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-121-rulin:m008-0022","start":22,"end":24,"surface":"今上