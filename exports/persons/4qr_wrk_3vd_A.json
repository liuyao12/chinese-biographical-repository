6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0428","start":428,"end":430,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0462","start":462,"end":463,"surface":"翼","kind":"person","person_id":"kwv_z32_1b4","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0467","start":467,"end":468,"surface":"尚","kind":"person","person_id":"e3f_d0s_c13","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0485","start":485,"end":487,"surface":"鄭玄","kind":"person","person_id":"95f_p0e_7s8","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0495","start":495,"end":497,"surface":"太后","kind":"person","person_id":"xke_dj3_6ba_AAB","status":"contextual_provisional"},{"id":"c-jinshu-032-chu-suanzi:line042:m0506","start":506,"end":507,"surface":"裒","kind":"person","person_id":"xke_dj3_6ba_AA","status":"contextual_provisional"}],"source_position":{"first_line":42,"last_line":42,"revision_id":1543614,"editorial_excerpt_boundary":false},"chapter_id":"c-jinshu-032-chu-suanzi","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-chu-suanzi"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001","text":"明穆庾皇后諱文君，潁川鄢陵人也。父琛，見《外戚傳》。后性仁慈，美姿儀。元帝聞之，聘為太子妃，以德行見重。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001:m0000","start":0,"end":5,"surface":"明穆庾皇后","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001:m0006","start":6,"end":8,"surface":"文君","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001:m0017","start":17,"end":18,"surface":"琛","kind":"person","person_id":"4qr_wrk_3vd","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001:m0026","start":26,"end":27,"surface":"后","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001:m0035","start":35,"end":37,"surface":"元帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001:m0042","start":42,"end":45,"surface":"太子妃","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"}],"source_position":{"first_line":21,"last_line":21,"revision_id":1543614,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-032-zheng-achun-family","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-zheng-achun-family"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-marriage:p001","text":"明帝即位，立為皇后。冊曰：「妃庾氏昔承明命，作嬪東宮，虔恭中饋，思媚軌則。履信思順，以成肅雝之道；正位閨房，以著協德之美。朕夙罹不造，煢煢在疚。群公卿士，稽之往代，僉以崇嫡明統，載在典謨，宜建長秋，以奉宗廟。是以追述先志，不替舊命，使使持節兼太尉授皇后璽綬。夫坤德尚柔，婦道承姑，崇粢盛之禮，敦螽斯之義。是以利在永貞，克隆堂基，母儀天下，潛暢陰教。鑒于六列，考之篇籍，禍福無門，盛衰由人，雖休勿休。其敬之哉，可不慎歟！」","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-marriage:p001:m0000","start":0,"end":2,"surface":"明帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-marriage:p001:m0015","start":15,"end":17,"surface":"庾氏","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:yuwenjun-marriage:p001:m0061","start":61,"end":62,"surface":"朕","kind":"person","person_id":"dkn_ge4_286_AAAAAAAA","status":"contextual_provisional"}],"source_position":{"first_line":23,"last_line":23,"revision_id":1543614,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-032-zheng-achun-family","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-zheng-achun-family"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001","text":"咸和元年薨，簡文帝時為琅邪王，制服重。有司以王出繼，宜降所生，國臣不能匡正，奏免國相諸葛頤。王上疏曰：「亡母生臨臣國，沒留國第，臣雖出後，亦無所厭，則私情得敘。昔敬后崩，孝王已出繼，亦還服重。此則明比，臣所憲章也。」明穆皇后不奪其志，乃徙琅邪王為會稽王，追號后曰會稽太妃。及簡文帝即位，未及追尊。臨崩，封皇子道子為琅邪王，領會稽國，奉太妃祀。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0006","start":6,"end":9,"surface":"簡文帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0011","start":11,"end":14,"surface":"琅邪王","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0022","start":22,"end":23,"surface":"王","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0042","start":42,"end":45,"surface":"諸葛頤","kind":"person","person_id":"0e2_wa7_dvc","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0046","start":46,"end":47,"surface":"王","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0052","start":52,"end":54,"surface":"亡母","kind":"person","person_id":"ll1_7jh_vr0_AA","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0056","start":56,"end":57,"surface":"臣","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0064","start":64,"end":65,"surface":"臣","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0081","start":81,"end":83,"surface":"敬后","kind":"person","person_id":"jqx_jns_jae_A","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0085","start":85,"end":87,"surface":"孝王","kind":"person","person_id":"dkn_ge4_286_AAAAAAAB","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0101","start":101,"end":102,"surface":"臣","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0108","start":108,"end":112,"surface":"明穆皇后","kind":"person","person_id":"4qr_wrk_3vd_A","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0119","start":119,"end":122,"surface":"琅邪王","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0123","start":123,"end":126,"surface":"會稽王","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0129","start":129,"end":130,"surface":"后","kind":"person","person_id":"ll1_7jh_vr0_AA","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0133","start":133,"end":135,"surface":"太妃","kind":"person","person_id":"ll1_7jh_vr0_AA","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0137","start":137,"end":140,"surface":"簡文帝","kind":"person","person_id":"dkn_ge4_286_AAAAAAAF","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0154","start":154,"end":156,"surface":"道子","kind":"person","person_id":"dkn_ge4_286_AAAAAAAFA","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0157","start":157,"end":160,"surface":"琅邪王","kind":"person","person_id":"dkn_ge4_286_AAAAAAAFA","status":"contextual_provisional"},{"id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001:m0167","start":167,"end":169,"surface":"太妃","kind":"person","person_id":"ll1_7jh_vr0_AA","status":"contextual_provisional"}],"source_position":{"first_line":68,"last_line":68,"revision_id":1543614,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-032-zheng-achun-family","book_id":"b-jinshu-032","work_id":"w-jinshu","source_id":"s-jinshu-032-zheng-achun-family"}],"sources":[{"chapter_id":"c-jinshu-032-chu-suanzi","work_id":"w-jinshu","book_id":"b-jinshu-032","source_id":"s-jinshu-032-chu-suanzi","source":{"title":"《晉書》卷32（康獻褚皇后傳）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?oldid=1543614","permalink":"https://zh.wikisource.org/w/index.php?oldid=1543614","revision_id":1543614,"accessed_on":"2026-10-19","extent":"康獻褚皇后完整六原段及數位注語；非全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"662028853af3848a3f71cc750fcc290b8e5af62354baecdb3158bcb95f511f0a","wikitext_sha256":"82cd88cad08dac2b1bbb57371dc460a43806730b4da42c143f041374bd6866c5","normalization":{"character_conversion":{},"extraction_note":"展開年號模板，移除段首縮排，數位校勘注另存；未改原字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line040","source_lines":[40,40],"raw_quote":"　　康獻褚皇后諱蒜子，河南陽翟人也。父裒，見《外戚傳》。后聰明有器識，少以名家入為琅邪王妃。及康帝即位，立為皇后，封母謝氏為尋陽鄉君。","raw_quote_sha256":"1643944692230e47c515871e414fc4c5b4df92c171958f59c6263a0c0b3edc68","selected_text_sha256":"f9361bbecb2e2632233b10c7cf70f71674ef6882d699cf8ad7b649ad7cc4b82a","begin_anchor":"康獻褚皇后諱蒜子，河南陽翟人也。父裒","end_anchor":"即位，立為皇后，封母謝氏為尋陽鄉君。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line042","source_lines":[42,42],"raw_quote":"　　及穆帝即位，尊后曰皇太后。時帝幼沖，未親國政。領司徒蔡謨等上奏曰：「嗣皇誕哲岐嶷，繼承天統，率土宅心，兆庶蒙賴。陛下體茲坤道，訓隆文母。昔塗山光夏，簡狄熙殷，實由宣哲，以隆休祚。伏惟陛下德侔二媯，淑美關雎，臨朝攝政，以寧天下。今社稷危急，兆庶懸命，臣等章惶，一日萬機，事運之期，天祿所鍾，非復沖虛高讓之日。漢和熹、順烈，並亦臨朝，近明穆故事，以為先制。臣等不勝悲怖，謹伏地上請。乞陛下上順祖宗，下念臣吏，推公弘道，以協天人，則萬邦承慶，群黎更生。」太后詔曰：「帝幼沖，當賴群公卿士將順匡救，以酬先帝禮賢之意，且是舊德世濟之美，則莫重之命不墜，祖宗之基有奉，是其所以欲正位于內而已。所奏懇到，形于翰墨，執省未究，以悲以懼。先后允恭謙抑，思順坤道，所以不距群情，固為國計。豈敢執守沖闇，以違先旨。輒敬從所奏。」於是臨朝稱制。有司奏，謝夫人既封，荀、卞二夫人亦應追贈，皆后之前母也。太后不許。太常殷融議依鄭玄義，衛將軍裒在宮庭則盡臣敬，太后歸寧之日自如家人之禮。太后詔曰：「典禮誠所未詳，如所奏，是情所不能安也，更詳之。」征西將軍翼、南中郎尚議謂「父尊盡於一家，君敬重於天下，鄭玄義合情禮之中」。太后從之。自後朝臣皆敬裒焉。","raw_quote_sha256":"9e4d1aac1a45f30e3910ced3b14742002cfe59b142cf8c6933ca5fe968ea813a","selected_text_sha256":"485657cefa9fb705992094a25a7bb6329583541b27fe461b57466349bd622c9b","begin_anchor":"及穆帝即位，尊后曰皇太后。時帝幼沖，","end_anchor":"之中」。太后從之。自後朝臣皆敬裒焉。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line044","source_lines":[44,44],"raw_quote":"　　帝既冠，太后詔曰：「昔遭不造，帝在幼沖，皇緒之微，眇若贅旒。百辟卿士率遵前朝，勸喻攝政。以社稷之重，先代成義，僶俛敬從，弗遑固守。仰憑七廟之靈，俯仗群后之力，帝加元服，禮成德備，當陽親覽，臨御萬國。今歸事反政，一依舊典。」于是居崇德宮，手詔群公曰：「昔以皇帝幼沖，從群后之議，既以闇弱，又頻丁極艱，銜恤歷祀，沈憂在疚。司徒親尊德重，訓救其弊，王室之不壞，實公是憑。帝既備茲冠禮，而四海未一，五胡叛逆，豺狼當路，費役日興，百姓困苦。願諸君子思量遠算，戮力一心，輔翼幼主，匡救不逮。未亡人永歸別宮，以終餘齒。仰惟家國，故以一言託懷。」","raw_quote_sha256":"912e1f0ab6ae7c9c049a5890a2552edb86d4e7ff732f36386678ae9619789eeb","selected_text_sha256":"56647afd488c02ef801c9ee3033f2d55443488b8824f256eee789d283b7c9e0b","begin_anchor":"帝既冠，太后詔曰：「昔遭不造，帝在幼","end_anchor":"以終餘齒。仰惟家國，故以一言託懷。」"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line046","source_lines":[46,46],"raw_quote":"　　及哀帝、海西公之世，太后復臨朝稱制<ref>「及哀帝、海西公之世，太后復臨朝稱制」李校：《哀帝紀》惟興寧二年帝以服藥致疾，崇德太后復臨朝攝政，至《海西公紀》不言有臨朝事，「世」字當是「際」字之誤。</ref>。桓溫之廢海西公也，太后方在佛屋燒香，內侍啟云「外有急奏」，太后乃出。尚倚戶前視奏數行，乃曰「我本自疑此」，至半便止，索筆答奏云：「未亡人罹此百憂，感念存沒，心焉如割。」溫始呈詔草，慮太后意異，悚動流汗，見于顏色。及詔出，溫大喜。","raw_quote_sha256":"74b73571300986be993a6f8e81b6447966e687b38a0c27e64cb2b544d77abbb5","selected_text_sha256":"f18963deb7b2fd3dadd18576a0665105a8cbee577b3c3691d6ca0616eff37e02","begin_anchor":"及哀帝、海西公之世，太后復臨朝稱制。","end_anchor":"悚動流汗，見于顏色。及詔出，溫大喜。","removed_digital_editorial_notes":[{"text":"「及哀帝、海西公之世，太后復臨朝稱制」李校：《哀帝紀》惟興寧二年帝以服藥致疾，崇德太后復臨朝攝政，至《海西公紀》不言有臨朝事，「世」字當是「際」字之誤。","text_layer":"modern_digital_apparatus","independently_verified":false}]},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line048","source_lines":[48,48],"raw_quote":"　　簡文帝即位，尊后為崇德太后。及帝崩，孝武帝幼沖，桓溫又薨。群臣啟曰：「王室多故，禍艱仍臻，國憂始周，復喪元輔，天下惘然，若無攸濟。主上雖聖資奇茂，固天誕縱。而春秋尚富，如在諒闇，蒸蒸之思，未遑庶事。伏惟陛下德應坤厚，宣慈聖善，遭家多艱，臨朝親覽。光大之美，化洽在昔，謳歌流詠，播溢無外。雖有莘熙殷，妊姒隆周，未足以喻。是以五謀克從，人鬼同心，仰望來蘇，懸心日月。夫隨時之義，周易所尚，寧固社稷，大人之任。伏願陛下撫綜萬機，釐和政道，以慰祖宗，以安兆庶。不勝憂國喁喁至誠。」太后詔曰：「王室不幸，仍有艱屯。覽省啟事，感增悲歎。內外諸君，並以主上春秋沖富，加蒸蒸之慕，未能親覽，號令宜有所由。苟可安社稷，利天下，亦豈有所執，輒敬從所啟。但闇昧之闕，望盡弼諧之道。」於是太后復臨朝。帝既冠，乃詔曰：「皇帝婚冠禮備，遐邇宅心，宜當陽親覽，緝熙惟始。今歸政事，率由舊典。」於是復稱崇德太后。","raw_quote_sha256":"5402b89f67bc88082f293691f05f62eb74261f1e59903d5ce1d86200cecf0159","selected_text_sha256":"b4d1d85d4376c564609b7062e2c943ae3c297df0d7c61a628382c89e2d2a59bf","begin_anchor":"簡文帝即位，尊后為崇德太后。及帝崩，","end_anchor":"政事，率由舊典。」於是復稱崇德太后。"},{"proposed_paragraph_id":"c-jinshu-032-chu-suanzi:line050","source_lines":[50,50],"raw_quote":"　　{{YL|太元九年}}，崩于顯陽殿，年六十一，在位凡四十年。太后於帝為從嫂，朝議疑其服。太學博士徐藻議曰：「資父事君而敬同。又禮云『其夫屬父道者，妻皆母道也』，則夫屬君道，妻亦后道矣。服后以齊，母之義也。魯譏逆祀，以明尊卑<ref>「以明尊卑」：《禮志·中》、《宋志·二》、《[[通典]]·八〇》、《[[文獻通考|通考]]·一二一》「尊卑」皆作「尊尊」，乃用穀梁傳文公二年「君子不以親親害尊尊」之義。徐藻、徐邈父子治穀梁，此作「尊尊」為是。</ref>。今上躬奉康、穆、哀皇及靖后之祀，致敬同于所天，豈可敬之以君道，而服廢於本親。謂應齊衰期。」從之。","raw_quote_sha256":"3e0b257e63ac1ac257bc338324fe266b5ad784b54150b2d0c348a2bac4b20c48","selected_text_sha256":"026ff8771f56b4edfe187d2fe1e96b105fcc69e92ef2fd1f92120a6ed7210ed9","begin_anchor":"太元九年，崩于顯陽殿，年六十一，在位","end_anchor":"，而服廢於本親。謂應齊衰期。」從之。","removed_digital_editorial_notes":[{"text":"「以明尊卑」：《禮志·中》、《宋志·二》、《[[通典]]·八〇》、《[[文獻通考|通考]]·一二一》「尊卑」皆作「尊尊」，乃用穀梁傳文公二年「君子不以親親害尊尊」之義。徐藻、徐邈父子治穀梁，此作「尊尊」為是。","text_layer":"modern_digital_apparatus","independently_verified":false}]}]}}},{"chapter_id":"c-jinshu-032-zheng-achun-family","work_id":"w-jinshu","book_id":"b-jinshu-032","source_id":"s-jinshu-032-zheng-achun-family","source":{"title":"《晉書》卷032（家世數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7032&oldid=1543614","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7032&oldid=1543614","revision_id":1543614,"accessed_on":"2026-10-18","extent":"元帝后妃家世、荀豫章君及庾后冊立、鄭阿春敘事選段，非全卷或全部后妃傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"662028853af3848a3f71cc750fcc290b8e5af62354baecdb3158bcb95f511f0a","wikitext_sha256":"82cd88cad08dac2b1bbb57371dc460a43806730b4da42c143f041374bd6866c5","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，維基連結僅取顯示原字；不換字、不補原文沒有的父母。","excerpts":[{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:p001","source_lines":[64,64],"raw_quote":"　　簡文宣鄭太后諱阿春，河南滎陽人也。世為冠族。祖合，臨濟令。父愷，字祖元，安豐太守。","raw_quote_sha256":"97781c4ce6af4c998fc4992fd496973072f99f98f87c402902dfa224abf033fe","selected_text_sha256":"7bdb5e352617386f95b5850bfc52a8c420869eeaa65919506d5d08b2e1be22bd","begin_anchor":"簡文宣鄭太后諱阿春，河南滎陽人","end_anchor":"濟令。父愷，字祖元，安豐太守。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:zheng-marriages:p001","source_lines":[66,66],"raw_quote":"　　后少孤，無兄弟，唯姊妹四人，后最長。先適渤海田氏，生一男而寡，依于舅濮陽吳氏。元帝為丞相，敬后先崩，將納吳氏女為夫人。后及吳氏女並游後園，或見之，言於帝曰：「鄭氏女雖嫠，賢於吳氏遠矣。」{{YL|建武元年}}，納為琅邪王夫人，甚有寵。后雖貴幸，而恒有憂色。帝問其故，對曰：「妾有妹，中者已適長沙王褒，餘二妹未有所適，恐姊為人妾，無復求者。」帝因從容謂劉隗曰：「鄭氏二妹，卿可為求佳對，使不失舊。」隗舉其從子傭娶第三者，以小者適漢中李氏，皆得舊門。帝召王褒為尚書郎，以悅后意。后生琅邪悼王、簡文帝、尋陽公主。帝稱尊號，后雖為夫人，詔太子及東海、武陵王皆母事之。帝崩，后稱建平國夫人。","raw_quote_sha256":"f21b6aa3b9166d15152b348260dbc4ddee9d76add660cfda795a5d00919ff399","selected_text_sha256":"de0aca98ef8bc4a2a0d9cca79b710b920db29fe50ba7d55af947432a9129f048","begin_anchor":"后少孤，無兄弟，唯姊妹四人，后","end_anchor":"母事之。帝崩，后稱建平國夫人。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:zheng-death-and-son:p001","source_lines":[68,68],"raw_quote":"　　{{YL|咸和元年}}薨，簡文帝時為琅邪王，制服重。有司以王出繼，宜降所生，國臣不能匡正，奏免國相諸葛頤。王上疏曰：「亡母生臨臣國，沒留國第，臣雖出後，亦無所厭，則私情得敘。昔敬后崩，孝王已出繼，亦還服重。此則明比，臣所憲章也。」明穆皇后不奪其志，乃徙琅邪王為會稽王，追號后曰會稽太妃。及簡文帝即位，未及追尊。臨崩，封皇子道子為琅邪王，領會稽國，奉太妃祀。","raw_quote_sha256":"708d12035e0622c62e40e4371b51af0a5d7ce03d5727cd59190edea23ba2f189","selected_text_sha256":"de7b1ed4a6cef57fef25b2b9e7988638f7ee399b5251ea0e22a337ef23736169","begin_anchor":"咸和元年薨，簡文帝時為琅邪王，","end_anchor":"為琅邪王，領會稽國，奉太妃祀。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:yumengmu-intro:p001","source_lines":[11,11],"raw_quote":"　　元敬虞皇后諱孟母，濟陽外黃人也。父豫，見《外戚傳》。帝為琅邪王，納后為妃，無子。{{YL|永嘉六年}}薨，時年三十五。","raw_quote_sha256":"eef8e8718f12a35618941d0c7cee77b2f22fc5df5f89e3b3e773c2fce309eff7","selected_text_sha256":"8f3c5d0c24a617589d9c19035dde5c1bc0bc3b424c016724d863a8a52d1dce90","begin_anchor":"元敬虞皇后諱孟母，濟陽外黃人也","end_anchor":"無子。永嘉六年薨，時年三十五。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:yuwenjun-intro:p001","source_lines":[21,21],"raw_quote":"　　明穆庾皇后諱文君，潁川鄢陵人也。父琛，見《[[晉書/卷093#庾琛|外戚傳]]》。后性仁慈，美姿儀。元帝聞之，聘為太子妃，以德行見重。","raw_quote_sha256":"fde7b2e84078b42976ee984dd854acd1a8a51a224a20c6ab43a8c12875ee9ab6","selected_text_sha256":"27943de73f3c88e804b9bbcfa6c6df884fabcc11358070e7064547cfd11dd04a","begin_anchor":"明穆庾皇后諱文君，潁川鄢陵人也","end_anchor":"聞之，聘為太子妃，以德行見重。"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:xun-lady-care:p001","source_lines":[18,18],"raw_quote":"　　豫章君荀氏，元帝宮人也。初有寵，生明帝及琅邪王裒，由是為虞后所忌。自以位卑，每懷怨望，為帝所譴，漸見疏薄。及明帝即位，封建安君，別立第宅。{{YL|太寧元年}}，帝迎還臺內，供奉隆厚。及成帝立，尊重同于太后。咸康元年薨。詔曰：「朕少遭憫凶，慈訓無稟，撫育之勤，建安君之仁也。一旦薨殂，實思報復，永惟平昔，感痛哀摧。其贈豫章郡君，別立廟于京都。」","raw_quote_sha256":"4a66e0a7e54d6a814ec87e4cc2068dfae51184978e65c393a0ef8d54728ebd2b","selected_text_sha256":"32b31b6d7d95ee638ffa037c0be1b08765018e6de121d41c648abfb81ca1b745","begin_anchor":"豫章君荀氏，元帝宮人也。初有寵","end_anchor":"其贈豫章郡君，別立廟于京都。」"},{"proposed_paragraph_id":"c-jinshu-032-zheng-achun-family:yuwenjun-marriage:p001","source_lines":[23,23],"raw_quote":"　　明帝即位，立為皇后。冊曰：「妃庾氏昔承明命，作嬪東宮，虔恭中饋，思媚軌則。履信思順，以成肅雝之道；正位閨房，以著協德之美。朕夙罹不造，煢煢在疚。群公卿士，稽之往代，僉以崇嫡明統，載在典謨，宜建長秋，以奉宗廟。是以追述先志，不替舊命，使使持節兼太尉授皇后璽綬。夫坤德尚柔，婦道承姑，崇粢盛之禮，敦螽斯之義。是以利在永貞，克隆堂基，母儀天下，潛暢陰教。鑒于六列，考之篇籍，禍福無門，盛衰由人，雖休勿休。其敬之哉，可不慎歟！」","raw_quote_sha256":"be1bc9c9a07a64485617ab2c0df9557bf8e95149d10ac6ca118e1a14861f18e7","selected_text_sha256":"298bc64073c2d8e02c65c22fcce63e87f0e795db731c313311721191042bcf96","begin_anchor":"明帝即位，立為皇后。冊曰：「妃","end_anchor":"休勿休。其敬之哉，可不慎歟！」"}]}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"4qr_wrk_3vd_A","representative_source_person_id":"4qr_wrk_3vd_A","source_person_ids":["4qr_wrk_3vd_A"],"identity_equivalence_decision_ids":[],"parent_person_id":"4qr_wrk_3vd","source_assertion_id":"a-jinshu-032-marriage-kin-002","connection":"father","assembly_id":"family-yu-chen-wenjun","root_person_id":"4qr_wrk_3vd","status":"contextual_provisional","human_reviewed":false}}
