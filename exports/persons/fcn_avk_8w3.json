-043-wangrong"},{"id":"c-jinshu-043-wangrong:p007:m0137","start":137,"end":138,"surface":"毅","kind":"person","person_id":"fcn_avk_8w3","status":"contextual_provisional","resolution_note":"孝喪插敘武帝問劉毅，不與劉裕時護軍劉毅同人；母稱不升生母。","paragraph_id":"c-jinshu-043-wangrong:p007","chapter_id":"c-jinshu-043-wangrong"},{"id":"c-jinshu-044-zhengmao:line015:m0201","start":201,"end":203,"surface":"劉毅","kind":"person","person_id":"fcn_avk_8w3","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-zhengmao:line015","chapter_id":"c-jinshu-044-zhengmao"},{"id":"c-jinshu-059-prince-lun:p001:m0107","surface":"劉毅","start":107,"end":109,"person_id":"fcn_avk_8w3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-lun:p001","chapter_id":"c-jinshu-059-prince-lun"},{"id":"c-jinshu-059-prince-lun:p001:m0182","surface":"毅","start":182,"end":183,"person_id":"fcn_avk_8w3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-lun:p001","chapter_id":"c-jinshu-059-prince-lun"},{"id":"c-jinshu-060-qianxiu:p002:m0106","surface":"劉毅","start":106,"end":108,"person_id":"fcn_avk_8w3","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-qianxiu:p002","chapter_id":"c-jinshu-060-qianxiu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-wangrong:p007","text":"戎在職雖無殊能，而庶績修理。後遷光祿勳、吏部尚書，以母憂去職。性至孝，不拘禮制，飲酒食肉，或觀弈棋，而容貌毀悴，杖然後起。裴頠往吊之，謂人曰：「若使一慟能傷人，濬沖不免滅性之譏也。」時和嶠亦居父喪，以禮法自持，量米而食，哀毀不逾於戎。帝謂劉毅曰：「和嶠毀頓過禮，使人憂之。」毅曰：「嶠雖寢苫食粥，乃生孝耳。至於王戎，所謂死孝，陛下當先憂之。」戎先有吐疾，居喪增甚。帝遣醫療之，並賜藥物，又斷賓客。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangrong:p007:m0000","start":0,"end":1,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","r