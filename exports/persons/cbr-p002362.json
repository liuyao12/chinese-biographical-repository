{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p002362","identity_policy":"contextual_provisional","person_ids":["cbr-p002362"],"persons":[{"id":"cbr-p002362","label":"太戊午（趙世家大戊午候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"太戊午","mention_ids":["c-shiji-043-zhao:m052-0028"]},{"surface":"大戊午","mention_ids":["c-shiji-043-zhao:m056-0015"]}],"evidence":[{"mention_id":"c-shiji-043-zhao:m052-0028","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p052","quote":"太戊午"},{"mention_id":"c-shiji-043-zhao:m056-0015","chapter_id":"c-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p056","quote":"大戊午"}]}],"mentions":[{"id":"c-shiji-043-zhao:m052-0028","start":28,"end":31,"surface":"太戊午","kind":"person","person_id":"cbr-p002362","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p052","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m056-0015","start":15,"end":18,"surface":"大戊午","kind":"person","person_id":"cbr-p002362","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p056","chapter_id":"c-shiji-043-zhao"}],"relations":[],"title_holdings":[{"id":"th-shiji043-030","person_id":"cbr-p002362","title":"相","kind":"office","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p052","quote":"成侯元年，公子勝與成侯爭立，爲亂。二年六月，雨雪。三年，太戊午爲相。伐衞，取鄕邑七十三。魏敗我藺。四年，與秦戰髙安，敗之。五年，伐齊于鄄。魏敗我懷。攻鄭，敗之，以與韓，韓與我長子。六年，中山筑長城。伐魏，敗湪澤，圍魏惠王。七年，侵齊，至長城。與韓攻周。八年，與韓分周以爲兩。九年，與齊戰阿下。十年，攻衞，取甄。十一年，秦攻魏，趙救之石阿。十二年，秦攻魏少梁，趙救之。十三年，秦獻公使庶長國伐魏少梁，虜其太子、痤。魏敗我澮，取皮牢。成侯與韓昭侯遇上黨。十四年，與韓攻秦。十五年，助魏攻齊。"}],"attestations":[{"id":"th-shiji043-030:a001","paragraph_id":"c-shiji-043-zhao:p052","start":32,"end":33,"surface":"相","person_mention_id":"c-shiji-043-zhao:m052-0028","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":"三年","evidence":[{"chapter_id":"c-shiji-043-zhao","sou