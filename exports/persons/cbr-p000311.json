{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000311","identity_policy":"contextual_provisional","person_ids":["cbr-p000311"],"persons":[{"id":"cbr-p000311","label":"嘉（周子南君）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"周子南君","mention_ids":["c-shiji-004-zhou:m086-0124"]},{"surface":"嘉","mention_ids":["c-shiji-004-zhou:m086-0116"]}],"evidence":[{"mention_id":"c-shiji-004-zhou:m086-0124","chapter_id":"c-shiji-004-zhou","paragraph_id":"c-shiji-004-zhou:p086","quote":"周子南君"},{"mention_id":"c-shiji-004-zhou:m086-0116","chapter_id":"c-shiji-004-zhou","paragraph_id":"c-shiji-004-zhou:p086","quote":"嘉"}],"identity_note":"依本卷特定時代與敘事建立；同名與世襲官號不得全庫合併，本名未見不補造。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-004-zhou:m086-0116","start":116,"end":117,"surface":"嘉","kind":"person","person_id":"cbr-p000311","status":"contextual_provisional","interpretation_note":"依同段明示人物與敘事暫定短稱，不作其他段落或其他時代的自動識別。","paragraph_id":"c-shiji-004-zhou:p086","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m086-0124","start":124,"end":128,"surface":"周子南君","kind":"person","person_id":"cbr-p000311","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p086","chapter_id":"c-shiji-004-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p086","text":"太史公曰：學者皆稱周伐紂，居洛邑，綜其實不然。武王營之，成王使召公卜居，居九鼎焉，而周復都豐、鎬。至犬戎敗幽王，周乃東徙于洛邑。所謂「周公葬我畢」，畢在鎬東南杜中。秦滅周。漢興九十有餘載，天子將封泰山，東巡狩至河南，求周苗裔，封其後嘉三十里地，號曰周子南君，比列侯，以奉其先祭祀。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m086-0000","start":0,"end":3,"surface":"太史公","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m086-0011","start":11,"end":12,"surface":"紂","kind":"person","person_id":"cbr-p000136","status":"source_identified"},{"id":"c-shiji-004-zhou:m086-0023","start":23,"end":25,"surface":"武王","kind":"person","person_id":"cbr-p000150","status":"source_identified"},{"id":"c-shiji-004-zhou:m086-0028","start":28,"end":30,"surface":"成王","kind":"person","person_id":"cbr-p000155","status":"source_identified"},{"id":"c-shiji-004-zhou:m086-0031","start":31,"end":33,"surface":"召公","kind":"person","person_id":"cbr-p000184","status":"source_identified"},{"id":"c-shiji-004-zhou:m086-0053","start":53,"end":55,"surface":"幽王","kind":"person","person_id":"cbr-p000217","status":"source_identified"},{"id":"c-shiji-004-zhou:m086-0067","start":67,"end":69,"surface":"周公","kind":"person","person_id":"cbr-p000156","status":"source_identified"},{"id":"c-shiji-004-zhou:m086-0094","start":94,"end":96,"surface":"天子","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m086-0109","start":109,"end":112,"surface":"周苗裔","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m086-0116","start":116,"end":117,"surface":"嘉","kind":"person","person_id":"cbr-p000311","status":"contextual_provisional","interpretation_note":"依同段明示人物與敘事暫定短稱，不作其他段落或其他時代的自動識別。"},{"id":"c-shiji-004-zhou:m086-0124","start":124,"end":128,"surface":"周子南君","kind":"person","person_id":"cbr-p000311","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"}],"sources":[{"chapter_id":"c-shiji-004-zhou","work_id":"w-shiji","book_id":"b-shiji-004","source_id":"s-shiji-004-zhou","source":{"title":"史記／卷004","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷004","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷004&oldid=7909147","revision_id":7909147,"accessed_on":"2026-10-09","extent":"正文全文；排除註釋版導覽、現代節標題與註號；行內校勘標記另存。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by