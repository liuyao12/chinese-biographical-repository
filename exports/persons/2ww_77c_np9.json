ths":[],"mentions":[{"id":"c-jinshu-060-suochen:p005:m0052","surface":"裴詵","start":52,"end":54,"person_id":"2ww_77c_np9","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-060-suochen:p005","chapter_id":"c-jinshu-060-suochen"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-060-suochen:p005","text":"劉曜復率眾人馮翊，帝累徵兵于南陽王保，保左右議曰；「蝮蛇在手，壯士解其腕。且斷隴道，以觀其變。」從事中郎裴詵曰：「蛇已螫頭，頭可截不？」保以胡崧行前鋒都督，須諸軍集，乃當發。麹允欲挾天子趣保，綝以保必逞私欲，乃止。自長安以西，不復奉朝廷。百官饑乏，采穭自存。時三秦人尹桓、解武等數千家，盜發漢霸、杜二陵，多獲珍寶。帝問綝曰：「漢陵中物何乃多邪？」綝對曰：「漢天子即位一年而為陵，天下貢賦三分之，一供宗廟，一供賓客，一充山陵。漢武帝饗年久長，比崩而茂陵不復容物，其樹皆已可拱。赤眉取陵中物不能減半，於今猶有朽帛委積，珠玉未盡。此二陵是儉者耳，亦百世之誡也。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":124,"last_line":124,"raw_start":10138,"raw_end":10418,"raw_character_offsets":[10140,10141,10142,10143,10144,10145,10146,10147,10148,10149,10150,10151,10152,10153,10154,10155,10156,10157,10158,10159,10160,10161,10162,10163,10164,10165,10166,10167,10168,10169,10170,10171,10172,10173,10174,10175,10176,10177,10178,10179,10180,10181,10182,10183,10184,10185,10186,10187,10188,10189,10190,10191,10192,10193,10194,10195,10196,10197,10198,10199,10200,10201,10202,10203,10204,10205,10206,10207,10208,10209,10210,10211,10212,10213,10214,10215,10216,10217,10218,10219,10220,10221,10222,10223,10224,10225,10226,10227,10228,10229,10230,10231,10232,10233,10234,10235,10236,10237,10238,10239,10240,10241,10242,10243,10244,10245,10246,10247,10248,10249,10250,10251,10252,10253,10254,10255,10256,10257,10258,10259,10260,10261,10262,10263,10264,10265,10266,10267,10268,10269,10270,10271,10272,10273,10274,10275,10276,10277,10278,10279,10280,10281,10282,10283,10284,10285,10286,10287,10288,10289,10290,10291,10292,10293,10294,10295,10296,10297,10298,10299,10300,10301,10302,10303,10304,10305,10306,10307,10308,