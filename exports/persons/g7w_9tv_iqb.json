}],"source_position":{"revision_id":1752646,"source_layer":"received_biography","raw_start":6964,"raw_end":7061,"raw_character_offsets":[6964,6965,6966,6967,6968,6969,6970,6971,6972,6973,6976,6979,6980,6981,6982,6983,6984,6985,6986,6987,6988,6989,6990,6991,6992,6993,6994,6995,6996,6997,6998,6999,7000,7001,7002,7003,7004,7005,7006,7007,7008,7009,7010,7011,7012,7013,7014,7015,7016,7017,7018,7019,7020,7021,7022,7025,7028,7029,7030,7031,7032,7033,7034,7035,7036,7037,7038,7039,7040,7041,7042,7043,7044,7045,7046,7047,7048,7049,7050,7051,7052,7053,7054,7055,7056,7057,7058,7059,7060],"projection_sha256":"6f9247e393a3906dd1365b55a05b6b743beb5ccb76ed56ea1f09374a76ffb65c"},"chapter_id":"c-nanshi-021-wangchong","book_id":"b-nanshi-021","work_id":"w-nanshi","source_id":"s-nanshi-021-wangchong-ws1752646"},{"id":"c-nanshi-023-wanghui-yue-jun-ke:p006","text":"雋子克。克美容貌，善容止，仕梁曆司徒右長史、尚書僕射。台城陷，仕侯景，位太宰、侍中、錄尚書事。景敗，克迎候王僧辯，問克曰：「勞事夷狄之君」，克不能對。次問璽紱何在？克默然良久曰：「趙平原將去。」平原名思賢，景腹心也，景授平原太守，故克呼焉。僧辯乃誚克曰：「王氏百世卿族，便是一朝而墜。」仕陳，位尚書右僕射。","mentions":[{"id":"c-nanshi-023-wanghui-yue-jun-ke:p006:m0000","surface":"雋","start":0,"end":1,"person_id":"1tc_q18_x7v_BA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wanghui-yue-jun-ke:p006:m0002","surface":"克","start":2,"end":3,"person_id":"1tc_q18_x7v_BAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wanghui-yue-jun-ke:p006:m0004","surface":"克","start":4,"end":5,"person_id":"1tc_q18_x7v_BAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wanghui-yue-jun-ke:p006:m0032","surface":"侯景","start":32,"end":34,"person_id":"5d1_8jg_amy","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wanghui-yue-jun-ke:p006:m0047","surface":"景","start":47,"end":48,"person_id":"5d1_8jg_amy","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳