ed_birth_order_constraints":[],"identity_decisions":[{"id":"d-jin034-liu-yuan","person_id":"96o_w8x_lgv","surfaces":["劉元海"],"scope":"cross_chapter","chapter_ids":["c-jinshu-034-yanghu-comparison","c-jinshu-035-peikai-family"],"status":"contextual_provisional","confidence_level":"high","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-034","source_id":"s-jinshu-034-yanghu-ws2567662-rendered-comparison","chapter_id":"c-jinshu-034-yanghu-comparison","paragraph_id":"c-jinshu-034-yanghu-comparison:p041","quote":"發長子倫，高陽相。倫弟暨，陽平太守。暨弟伊，初為車騎賈充掾，後曆平南將軍、都督江北諸軍事，鎮宛，為張昌所殺，追贈鎮南將軍。祜伯父秘，官至京兆太守。子祉，魏郡太守。秘孫亮，字長玄，有才能，多計數。與之交者，必偽盡款誠，人皆謂得其心，而殊非其實也。初為太傅楊駿參軍，時京兆多盜竊。駿欲更重其法，盜百錢加大辟，請官屬會議，亮曰：「昔楚江乙母失布，以為盜由令尹。公若無欲，盜宜自止，何重法為？」駿慚而止。累轉大鴻臚。時惠帝在長安，亮與關東連謀，內不自安，奔於并州，為劉元海所害。亮弟陶，為徐州刺史。","mention_ids":["c-jinshu-034-yanghu-comparison:p041:m0229"]},{"work_id":"w-jinshu","book_id":"b-jinshu-035","source_id":"s-jinshu-035-peikai-ws2506399","chapter_id":"c-jinshu-035-peikai-family","paragraph_id":"c-jinshu-035-peikai-family:p016","quote":"楷長兄黎，次兄康，並知名。康子盾，少曆顯位。永嘉中，為徐州刺史，委任長史司馬奧。奧勸盾刑殺立威，大發良人為兵，有不奉法者罪便至死。在任三年，百姓嗟怨。東海王越，盾妹夫也。越既薨，騎督滿衡便引所發良人東還。尋而劉元海遣將王桑、趙固向彭城，前鋒數騎至下邳，文武不堪苛政，悉皆散走，盾、奧奔淮陰，妻子為賊人所得。奧又誘盾降趙固。固妻盾女，有寵，盾向女涕泣，固遂殺之。","mention_ids":["c-jinshu-035-peikai-family:p016:m0104"]}],"rationale":"按完整本傳敘事/發言人與時層分流；本源角色與現役完整來源錨作有資格首選，不以相同單字或同稱號跨朝代自動合併。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-034-yanghu-comparison:p041","text":"發長子倫，高陽相。倫弟暨，陽平太守。暨弟伊，初為車騎賈充掾，後曆平南將軍、都督江北諸軍事，鎮宛，為張昌所殺，追贈鎮南將軍。祜伯父秘，官至京兆太守。子祉，魏郡太守。秘孫亮，字長玄，有才能，多計數。與之交者，必偽盡款誠，人皆謂得其心，而殊非其實也。初為太傅楊駿參軍，時京兆多盜竊。駿欲更重其法，盜百錢加大辟，請官屬會議，亮曰：「昔楚江乙母失布，以為盜由令尹。公若無欲，盜宜自止，何重法為？」駿慚而止。累轉大鴻臚。時惠帝在長安，亮與關東連謀，內不自安，奔於并州，為劉元海所害。亮弟陶，為徐州刺史。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-034-yanghu-comparison:p041:m0000","start":0,"end":1,"surface":"發","kind":"person","person_id":"py0_xjt_sai","status":"contextual_provisional"},{"id":"c-jinshu-034-yanghu-comparison:p041:m0003