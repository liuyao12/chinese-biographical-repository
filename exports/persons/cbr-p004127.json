{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004127","canonical_person_id":"raa_ahy_pza","id_aliases":["cbr-p004127"],"identity_policy":"contextual_provisional","person_ids":["raa_ahy_pza"],"persons":[{"id":"raa_ahy_pza","label":"子胥（張儀列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"子胥","mention_ids":["c-shiji-070-zhang:m052-0151"]}],"evidence":[{"mention_id":"c-shiji-070-zhang:m052-0151","chapter_id":"c-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p052","quote":"子胥"}],"id_aliases":["cbr-p004127"]}],"source_mention_summary":[{"source_id":"s-shiji-070-zhang","work_id":"w-shiji","book_id":"b-shiji-070","chapter_id":"c-shiji-070-zhang","mention_count":1,"mention_ids":["c-shiji-070-zhang:m052-0151"],"paragraph_ids":["c-shiji-070-zhang:p052"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-070-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-070-zhang:m052-0151","start":151,"end":153,"surface":"子胥","kind":"person","person_id":"raa_ahy_pza","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p052","chapter_id":"c-shiji-070-zhang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-044","person_id":"raa_ahy_pza","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依末8段附傳及引古故事局部暫接；犀首者名衍姓公孫氏與後文公孫衍明示相配。莊舄楚王與外層秦惠王分辨，卞莊子短稱莊子只取刺虎故事。未名楚魏秦王不依記憶補名，也未確證與本篇其他王同或異。子胥、曾參屬引古，比擬的僕妾與婦不補具體身分；李伯之下為地點，不當人名。","surfaces":["子胥"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p052","quote":"陳軫者，游說之士。與張儀俱事秦惠王，皆貴重，爭寵。張儀惡陳軫於秦王曰：「軫重幣輕使秦楚之閒，將為國交也。今楚不加善於秦而善軫者，軫自為厚而為王薄也。且軫欲去秦而之楚，王胡不聽乎？」王謂陳軫曰：「吾聞子欲去秦之楚，有之乎？」軫曰：「然。」王曰：「儀之言果信矣。」軫曰：「非獨儀知之也，行道之士盡知之矣。昔子胥忠於其君而天下爭以為臣，曾參孝於其親而天下願以為子。故賣僕妾不出閭巷而售者，良僕妾也；出婦嫁於鄉曲者，良婦也。今軫不忠其君，楚亦何以軫為忠乎？忠且見棄，軫不之楚何歸乎？」王以其言為然，遂善待之。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-070-zhang:p052","text":"陳軫者，游說之士。與張儀俱事秦惠王，皆貴重，爭寵。張儀惡陳軫於秦王曰：「軫重幣輕使秦楚之閒，將為國交也。今楚不加善於秦而善軫者，軫自為厚而為王薄也。且軫欲去秦而之楚，王胡不聽乎？」王謂陳軫曰：「吾聞子欲去秦之楚，有之乎？」軫曰：「然。」王曰：「儀之言果信矣。」軫曰：「非獨儀知之也，行道之士盡知之矣。昔子胥忠於其君而天下爭以為臣，曾參孝於其親而天下願以為子。故賣僕妾不出閭巷而售者，良僕妾也；出婦嫁於鄉曲者，良婦也。今軫不忠其君，楚亦何以軫為忠乎？忠且見棄，軫不之楚何歸乎？」王以其言為然，遂善待之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-070-zhang:m052-0000","start":0,"end":2,"surface":"陳軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0010","start":10,"end":12,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0014","start":14,"end":17,"surface":"秦惠王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0025","start":25,"end":27,"surface":"張儀","kind":"person","person_id":"5an_r55_hee","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0028","start":28,"end":30,"surface":"陳軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0031","start":31,"end":33,"surface":"秦王","kind":"person","person_id":"x9j_eu1_vck","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0036","start":36,"end":37,"surface":"軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provisional"},{"id":"c-shiji-070-zhang:m052-0061","start":61,"end":62,"surface":"軫","kind":"person","person_id":"bvi_h86_vk1","status":"contextual_provi