raph_id":"c-shiji-039-jin:p088","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[{"id":"th-shiji039-022","person_id":"cbr-p001779","title":"太史","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p088","quote":"盾遂奔，未出晉境。乙丑，盾昆弟將軍趙穿襲殺靈公於桃園而迎趙盾。趙盾素貴，得民和；靈公少，侈，民不附，故爲弒易。盾復位。晉太史董狐書曰「趙盾弒其君」，以視於朝。盾曰：「弒者趙穿，我無罪。」太史曰：「子爲正卿，而亡不出境，反不誅國亂，非子而誰？」孔子聞之，曰：「董狐，古之良史也，書法不隱。宣子，良大夫也，爲法受惡。惜也，出疆乃免。」"}],"attestations":[{"id":"th-shiji039-022:a001","paragraph_id":"c-shiji-039-jin:p088","start":60,"end":62,"surface":"太史","person_mention_id":"c-shiji-039-jin:m088-0059","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本段明示命、使、立、遷或敘事用稱；將某軍保留原詞作任事描述。原紀年不換算公曆，未知起訖不由卒、出奔、被俘或首次提及補造；追諡另待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji039-217","person_id":"cbr-p001779","surfaces":["太史","晉太史董狐","董狐"],"scope":"same_chapter","chapter_ids":["c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-039-jin:p088","quote":"盾遂奔，未出晉境。乙丑，盾昆弟將軍趙穿襲殺靈公於桃園而迎趙盾。趙盾素貴，得民和；靈公少，侈，民不附，故爲弒易。盾復位。晉太史董狐書曰「趙盾弒其君」，以視於朝。盾曰：「弒者趙穿，我無罪。」太史曰：「子爲正卿，而亡不出境，反不誅國亂，非子而誰？」孔子聞之，曰：「董狐，古之良史也，書法不隱。宣子，良大夫也，爲法受惡。惜也，出疆乃免。」"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-039-jin:p088","text":"盾遂奔，未出晉境。乙丑，盾昆弟將軍趙穿襲殺靈公於桃園而迎趙盾。趙盾素貴，得民和；靈公少，侈，民不附，故爲弒易。盾復位。晉太史董狐書曰「趙盾弒其君」，以視於朝。盾曰：「弒者趙穿，我無罪。」太史曰：「子爲正卿，而亡不出境，反不誅國亂，非子而誰？」孔子聞之，曰：「董狐，古之良史也，書法不隱。宣子，良大夫也，爲法受惡。惜也，出疆乃免。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m088-0000","start":0,"end":1,"surface":"盾","kind":"person","person_id