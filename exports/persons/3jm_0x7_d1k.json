me_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-092-duhuidu:p002:m0326","start":326,"end":329,"surface":"羅農夫","kind":"person","person_id":"3jm_0x7_d1k","status":"contextual_provisional","paragraph_id":"c-songshu-092-duhuidu:p002","chapter_id":"c-songshu-092-duhuidu"}],"relations":[],"title_holdings":[{"id":"th-songshu-092-duhuidu-2-322","title":"中兵參軍","kind":"office","mode":"attestation","person_id":"3jm_0x7_d1k","attestations":[{"id":"th-songshu-092-duhuidu-2-322:a","paragraph_id":"c-songshu-092-duhuidu:p002","start":322,"end":326,"surface":"中兵參軍","person_mention_id":"c-songshu-092-duhuidu:p002:m0326","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-092","chapter_id":"c-songshu-092-duhuidu","source_id":"s-songshu-092-duhuidu-ws2195614","paragraph_id":"c-songshu-092-duhuidu:p002","quote":"慧度，瑗第五子也。初為州主簿，流民督護，遷九真太守。瑗卒，府州綱佐以交土接寇，不宜曠職，共推慧度行州府事，辭不就。七年，除使持節、督交州諸軍事、廣武將軍、交州刺史。詔書未至，其年春，盧循襲破合浦，徑向交州。慧度乃率文武六千人距循於石碕，交戰，禽循長史孫建之。循雖敗，餘黨猶有三千人，皆習練兵事，李遜子李弈、李脫等奔竄石碕，」盤結俚、獠，各有部曲。循知弈等與杜氏有怨，遣使招之，弈等引諸俚帥眾五六千人，受循節度。六月庚子，循晨造南津，命三軍入城乃食。慧度悉出宗族私財，以充勸賞。弟交阯太守慧期、九真太守章民並督率水步軍，慧度自登高艦，合戰，放火箭雉尾炬，步軍夾兩岸射之，循眾艦俱然，一時散潰，循中箭赴水死。斬循及父嘏，并循二子，親屬錄事參軍阮靜、中兵參軍羅農夫、李脫等，傳首京邑。封慧度龍編縣侯，食邑千戶。","person_mention_id":"c-songshu-092-duhuidu:p002:m0326"}],"status":"source_attested","interpretation_note":"所見原官稱，未載全任期。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-092-duhuidu:p002","text":"慧度，瑗第五子也。初為州主簿，流民督護，遷九真太守。瑗卒，府州綱佐以交土接寇，不宜曠職，共推慧度行州府事，辭不就。七年，除使持節、督交州諸軍事、廣武將軍、交州刺史。詔書未至，其年春，盧循襲破合浦，徑向交州。慧度乃率文武六千人距循於石碕，交戰，禽循長史孫建之。循雖敗，餘黨猶有三千人，皆習練兵事，李遜子李弈、李脫等奔竄石碕，」盤結俚、獠，各有部曲。循知弈等與杜氏有怨，遣使招之，弈等引