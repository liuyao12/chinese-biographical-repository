005","kind":"person","start":26,"end":27,"surface":"繪","person_id":"va5_2sy_7kk_A","status":"contextual_provisional","source_role":"liu_hui"}],"chapter_id":"c-liangshu-033-liuxiaochuo-opening-rendered","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-liuxiaochuo-opening-current-rendered"},{"id":"c-liangshu-033-wangyun-rendered:p004","text":"累遷太子洗馬，中舍人，並掌東宮管記。昭明太子愛文學士，常與筠及劉孝綽、陸倕、到洽、殷芸等游宴玄圃，太子獨執筠袖撫孝綽肩而言曰：「所謂左把浮丘袖，右拍洪崖肩。」其見重如此。筠又與殷芸以方雅見禮焉。出爲丹陽尹丞、北中郎諮議參軍，遷中書郎。奉敕制《開善寺寶誌大師碑文》，詞甚麗逸。又敕撰《中書表奏》三十卷，及所上賦頌，都爲一集。俄兼寧遠湘東王長史，行府、國、郡事。除太子家令，復掌管記。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-liangshu-033-wangyun-rendered:p004:m0001","kind":"person","start":18,"end":22,"surface":"昭明太子","person_id":"cav_2xc_9bq_AAE","status":"contextual_provisional","source_role":"zhaoming"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0002","kind":"person","start":29,"end":30,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0003","kind":"person","start":31,"end":34,"surface":"劉孝綽","person_id":"va5_2sy_7kk_AA","status":"contextual_provisional","source_role":"liu_xiaochuo"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0004","kind":"person","start":35,"end":37,"surface":"陸倕","person_id":"9jp_jmf_6jv_**BAA","status":"contextual_provisional","source_role":"lu_chui"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0005","kind":"person","start":38,"end":40,"surface":"到洽","person_id":"6bo_qfq_pl9_AAA","status":"contextual_provisional","source_role":"dao_qia"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0006","kind":"person","start":41,"end":43,"surface":"殷芸","person_id":"8d4_fth_d4l","status":"contextual_provisional","source_role":"yin_yun"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0007","kind":"person","start":49,"end":51,"surface":"太子","person_id":"cav_2xc_9bq_AAE","status":"contextual_provisional","source_role":"zhaoming"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0008","kind":"person","start":53,"end":54,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0009","kind":"person","start":56,"end":58,"surface":"孝綽","person_id":"va5_2sy_7kk_AA","status":"contextual_provisional","source_role":"liu_xiaochuo"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0010","kind":"person","start":68,"end":70,"surface":"浮丘","person_id":"19v_ah4_bnd","status":"contextual_provisional","source_role":"fuqiu"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0011","kind":"person","start":74,"end":76,"surface":"洪崖","person_id":"fqq_5bz_5n0","status":"contextual_provisional","source_role":"hongya"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0012","kind":"person","start":85,"end":86,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0013","kind":"person","start":88,"end":90,"surface":"殷芸","person_id":"8d4_fth_d4l","status":"contextual_provisional","source_role":"yin_yun"},{"id":"c-liangshu-033-wangyun-rendered:p004:m0014","kind":"person","start":165,"end":168,"surface":"湘東王","person_id":"cav_2xc_9bq_AAB","status":"contextual_provisional","source_role":"xiangdong_wang"}],"chapter_id":"c-liangshu-033-wangyun-rendered","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-current-rendered-wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p006","text":"筠狀貌寢小，長不滿六尺。性弘厚，不以藝能高人，而少擅才名，與劉孝綽見重當世。其自序曰：「餘少好書，老而彌篤。雖偶見瞥觀，皆卽疏記，後重省覽，歡興彌深，習與性成，不覺筆倦。自年十三四，齊建武二年乙亥至梁大同六年，四十載矣。幼年讀《五經》，皆七八十遍。愛《左氏春秋》，吟諷常爲口實，廣略去取，凡三過五抄。餘經及《周官》、《儀禮》、《國語》、《爾雅》、《山海經》、《本草》並再抄。子史諸集皆一遍。未嘗倩人假手，並躬自抄錄，大小百餘卷。不足傳之好事，蓋以備遺忘而已。」又與諸兒書論家世集云：「史傳稱安平崔氏及汝南應氏，並累世有文才，所以范蔚宗云崔氏『世擅雕龍』。然不過父子兩三世耳；非有七葉之中，名德重光，爵位相繼，人人有集，如吾門世者也。沈少傅約語人云：『吾少好百家之言，身爲四代之史，自開闢已來，未有爵位蟬聯，文才相繼，如王氏之盛者也。』汝等仰觀堂構，思各努力。」筠自撰其文章，以一官爲一集，自洗馬、中書、中庶子、吏部、左佐、臨海、太府各十卷，《尚書》三十卷，凡一百卷，行於世。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-liangshu-033-wangyun-rendered:p006:m0001","kind":"person","start":0,"end":1,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p006:m0002","kind":"person","start":30,"end":33,"surface":"劉孝綽","person_id":"va5_2sy_7kk_AA","status":"contextual_provisional","source_role":"liu_xiaochuo"},{"id":"c-liangshu-033-wangyun-rendered:p006:m0003","kind":"person","start":264,"end":267,"surface":"范蔚宗","person_id":"bxh_oop_5ic","status":"contextual_provisional","source_role":"fan_weizong"},{"id":"c-liangshu-033-wangyun-rendered:p006:m0004","kind":"person","start":316,"end":320,"surface":"沈少傅約","person_id":"p8b_7w1_y3q","status":"contextual_provisional","source_role":"shenyue"},{"id":"c-liangshu-033-wangyun-rendered:p006:m0005","kind":"person","start":380,"end":381,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"}],"chapter_id":"c-liangshu-033-wangyun-rendered","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-current-rendered-wangyun"}],"sources":[{"chapter_id":"c-liangshu-033-liuxiaochuo-opening-rendered","work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-liuxiaochuo-opening-current-rendered","source":{"title":"《梁書》卷三十三·劉孝綽","provider":"Wikisource","url":"https://zh.wikisource.org/zh-hant/梁書/卷33","permalink":"https://zh.wikisource.org/w/index.php?oldid=1514481","revision_id":1514481,"revision_timestamp":null,"accessed_on":"2026-10-31","text_scope":"partial_chapter","extent":"只本批明列完整敘事段落；非全傳/全卷。原段序按來源行號，不將未採段落假作相鄰。","review_status":"text_checked","human_reviewed":false,"image_verified":false,"actual_print_edition":null,"printed_base_edition":null,"edition":"comparison_transcription；current rendered頁尾報修訂，未取得fixed正文/raw，實際印本與書影未知，不稱武英殿或四庫底本。","rights":"古代公有領域作品；數位轉錄保留Wikisource