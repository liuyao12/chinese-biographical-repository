511902"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-028-xiahoukui-complete:p002:m0070","start":70,"end":73,"surface":"元顯伯","kind":"person","person_id":"8jh_lgn_1gl","status":"contextual_provisional","paragraph_id":"c-liangshu-028-xiahoukui-complete:p002","chapter_id":"c-liangshu-028-xiahoukui-complete"},{"id":"c-liangshu-028-xiahoukui-complete:p002:m0242","start":242,"end":244,"surface":"顯伯","kind":"person","person_id":"8jh_lgn_1gl","status":"contextual_provisional","paragraph_id":"c-liangshu-028-xiahoukui-complete:p002","chapter_id":"c-liangshu-028-xiahoukui-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-xiahoukui-complete:p002","text":"八年，敕夔帥壯武將軍裴之禮、直閤將軍任思祖出義陽道，攻平靜、穆陵、陰山三關，克之。是時譙州刺史湛僧智圍魏東豫州刺史元慶和於廣陵，入其郛。魏將元顯伯率軍赴援，僧智逆擊破之，夔自武陽會僧智，斷魏軍歸路。慶和於內築柵以自固，及夔至，遂請降。夔讓僧智，僧智曰：「慶和志欲降公，不願降僧智，今往必乖其意；且僧智所將爲烏合募人，不可御之以法。公持軍素嚴，必無犯令，受降納附，深得其宜。」於是夔乃登城拔魏幟，建官軍旗鼓，衆莫敢妄動，慶和束兵以出，軍無私焉。凡降男女口四萬餘人，粟六十萬斛，餘物稱是。顯伯聞之夜遁，衆軍追之，生擒二萬餘人，斬獲不可勝數。詔以僧智領東豫州，鎮廣陵。夔引軍屯安陽。夔又遣偏將屠楚城，盡俘其衆，由是義陽北道遂與魏絕。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":64,"last_line":64,"raw_start":4390,"raw_end":4703,"raw_character_offsets":[4390,4391,4392,4393,4394,4395,