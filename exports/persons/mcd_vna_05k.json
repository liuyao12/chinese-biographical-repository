der_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-liuxian","person_id":"mcd_vna_05k","surfaces":["劉顯","顯"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p005:m0005","c-liangshu-030-peiziye:p005:m0046"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p005","quote":"子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。普通七年，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」"}],"rationale":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null},{"id":"d-nanshi033-劉顯","person_id":"mcd_vna_05k","surfaces":["劉顯","顯"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-033-pei-family:p019:m0124","c-nanshi-033-pei-family:p019:m0162","c-nanshi-033-pei-family:p022:m0091"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p019","quote":"時西北遠邊有白題及滑國遣使由岷山道入貢，此二國歷代弗賓，莫知所出。子野曰：「漢潁陰侯斬胡白題將一人。服虔注云：'白題，胡名也。'又漢定遠侯擊虜，八滑從之，此其後乎。」時人服其博識。敕仍使撰方國使圖，廣述懷來之盛，自要服至於海表，凡二十國。子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱皆博學，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘每討論墳籍，咸折衷於子野。"},{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p022","quote":"遷中書侍郎、鴻臚卿，領步兵校尉。子野在禁省十餘年，默靜自守，未嘗有所請謁。外家及中表貧乏，所得奉悉給之。無宅，借官地二畝，起茅屋數間，妻子恒苦饑寒，唯以教誨為本，子侄祗畏，若奉嚴君。劉顯常以師道推高之。末年深信釋教，終身飯麥食蔬。中大通二年卒。先是，子野自占死期不過庚戌歲，是年自省移疾，謂同官劉之亨曰：「吾其逝矣。」遺命務存儉約。武帝悼惜，為之流涕。贈散騎常侍，即日舉哀。先是，五等君及侍中以上乃有諡，及子野特以令望見嘉，賜諡貞子。"}],"rationale":"沛國劉顯與子野交好且推師道，梁030同地望、同交遊名列及顯推重短稱。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-030-peiziye:p005","text":"子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。普通七年，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」","source_position":{"start":1324,"end":1666,"raw":"　　子野與沛國劉顯、南陽劉之遴、陳郡殷芸、陳留阮孝緒、吳郡顧協、京兆韋棱，皆博極羣書，深相賞好，顯尤推重之。時吳平侯蕭勱、范陽張纘，每討論墳籍，咸折中於子野焉。{{YL|普通七年}}，王師北伐，敕子野爲喻魏文，受詔立成，高祖以其事體大，召尚書僕射徐勉、太子詹事周捨、鴻臚卿劉之遴、中書侍郎朱异，集壽光殿以觀之，時並嘆服。高祖目子野而言曰：「其形雖弱，其文甚壯。」俄又敕爲書喻魏相元乂，其夜受旨，子野謂可待旦方奏，未之爲也。及五鼓，敕催令開齋速上，子野徐起操筆，昧爽便就。旣奏，高祖深嘉焉。自是凡諸符檄，皆令草創。子野爲文典而速，不尚麗靡之詞。其制作多法古，與今文體異，當時或有詆訶者，及其末皆翕然重之。或問其爲文速者，子野答云：「人皆成於手，我獨成於心，雖有見否之異，其於刊改一也。」","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p005:m0000","start":0,"end":2,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0005","start":5,"end":7,"surface":"劉顯","kind":"person","person_id":"mcd_vna_05k","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0010","start":10,"end":13,"surface":"劉之遴","kind":"person","person_id":"q7n_s7f_1cs","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p005:m0016","start":16,"end":18,"surface":"殷芸","kind":"person","person_id":"8d4_fth_d4l","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部I