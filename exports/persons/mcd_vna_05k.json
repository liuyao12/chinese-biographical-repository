umn_from_right":7,"start":0,"end":21,"text":"限三刻成徵二刻便就其辭甚美高祖再覽焉又為臨"},{"pdf_page":67,"half":"左","leaf":"十八上","column_from_right":8,"start":0,"end":13,"text":"汝侯淵猷製放生文亦見賞於世"}]},"chapter_id":"c-liangshu-050-xiezheng-wyd","book_id":"b-liangshu-050","work_id":"w-liangshu","source_id":"s-liangshu-050-xiezheng-wyd1739"},{"id":"c-liangshu-050-xiezheng:p003","text":"徵與河東裴子野、沛國劉顯同官友善，子野嘗爲《寒夜直宿賦》以贈徵，徵爲《感友賦》以酬之。時魏中山王元略還北，高祖餞於武德殿，賦詩三十韻，限三刻成。徵二刻便就，其辭甚美，高祖再覽焉。又爲臨汝侯淵猷制《放生文》，亦見賞於世。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-liangshu-050-xiezheng:p003:m0000","start":0,"end":1,"surface":"徵","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p003:m0004","start":4,"end":7,"surface":"裴子野","person_id":"vpy_180_2oi_AAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p003:m0010","start":10,"end":12,"surface":"劉顯","person_id":"mcd_vna_05k","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p003:m0017","start":17,"end":19,"surface":"子野","person_id":"vpy_180_2oi_AAAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p003:m0030","start":30,"end":31,"surface":"徵","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p003:m0032","start":32,"end":33,"surface":"徵","person_id":"684_eaa_511_AAAA","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p003:m0048","start":48,"end":50,"surface":"元略","person_id":"ajj_c35_na9","kind":"person","status":"contextual_provisional","interpretation_note":"按同段姓名及其所任、所述之事。"},{"id":"c-liangshu-050-xiezheng:p003:m0072","start":72,"end":73,"surf