:false},"family_paths":[],"mentions":[{"start":18,"end":20,"surface":"慧休","id":"c-nanshi-019-chaozong:p001:m0018","person_id":"u2m_hxt_bpt","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作慧休。","paragraph_id":"c-nanshi-019-chaozong:p001","chapter_id":"c-nanshi-019-chaozong"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"start":20,"end":22,"surface":"道人","id":"c-nanshi-019-chaozong:p001:r0020","paragraph_id":"c-nanshi-019-chaozong:p001","person_id":"u2m_hxt_bpt","referent_role":"third_person","quote":"鳳子超宗。隨父鳳嶺南，元嘉末得還。與慧休道人來往。好學有文辭，盛得名譽。選補新安王子鸞國常侍。王母殷淑儀卒，超宗作誄奏之，帝大嗟賞，謂謝莊曰：「超宗殊有鳳毛，靈運復出。」時右衛將軍劉道隆在御坐，出候超宗曰：「聞君有異物，可見乎？」超宗曰：「懸磬之室，復有異物邪。」道隆武人無識，正觸其父名，曰：「旦侍宴，至尊說君有鳳毛。」超宗徒跣還內。道隆謂檢覓鳳毛，至闇待不得，乃去。","note":"本句按敘述視點回指慧休。","chapter_id":"c-nanshi-019-chaozong","book_id":"b-nanshi-019","work_id":"w-nanshi","source_id":"s-nanshi-019-chaozong-ws1531762"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanshi-019-chaozong:p001","text":"鳳子超宗。隨父鳳嶺南，元嘉末得還。與慧休道人來往。好學有文辭，盛得名譽。選補新安王子鸞國常侍。王母殷淑儀卒，超宗作誄奏之，帝大嗟賞，謂謝莊曰：「超宗殊有鳳毛，靈運復出。」時右衛將軍劉道隆在御坐，出候超宗曰：「聞君有異物，可見乎？」超宗曰：「懸磬之室，復有異物邪。」道隆武人無識，正觸其父名，曰：「旦侍宴，至尊說君有鳳毛。」超宗徒跣還內。道隆謂檢覓鳳毛，至闇待不得，乃去。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":0,"end":1,"surface":"鳳","id":"c-nanshi-019-chaozong:p001:m0000","person_id":"aa6_83c_juy_CDAAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作鳳。"},{"start":2,"end":4,"surface":"超宗","id":"c-nanshi-019-chaozong:p001:m0002","person_id":"aa6_83c_juy_CDAABA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作超宗。"},{"start":7,"end":8,"surface":"鳳","id":"c-nanshi-019-chaozong:p001:m0007","person_id":"aa6_83c_juy_CDAAB","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作鳳。"},{"start":