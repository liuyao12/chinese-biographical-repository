inship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-043-leguang:line150:m0005","start":5,"end":9,"surface":"胡毋輔之","kind":"person","person_id":"dfv_puq_icn","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-leguang:line150","chapter_id":"c-jinshu-043-leguang"},{"id":"c-jinshu-043-wangcheng:line118:m0132","start":132,"end":136,"surface":"胡毋輔之","kind":"person","person_id":"dfv_puq_icn","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-wangcheng:line118","chapter_id":"c-jinshu-043-wangcheng"},{"id":"c-shishuoxinyu-001-jin043-leguang:friends:m0004","start":4,"end":8,"surface":"胡毋彦國","kind":"person","person_id":"dfv_puq_icn","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-shishuoxinyu-001-jin043-leguang:friends","chapter_id":"c-shishuoxinyu-001-jin043-leguang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-043-leguang:line150","text":"是時王澄、胡毋輔之等，皆亦任放為達，或至裸體者。廣聞而笑曰：「名教內自有樂地，何必乃爾！」其居才愛物，動有理中，皆此類也。值世道多虞，朝章紊亂，清己中立，任誠保素而已。時人莫有見其際焉。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-leguang:line150:m0002","start":2,"end":4,"surface":"王澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-leguang:line150:m0005","start":5,"end":9,"surface":"胡毋輔之","kind":"person","person_id":"dfv_puq_icn","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-leguang:line150:m0024","start":24,"end":25,"surface":"廣","kind":"person","person_id":"591_360_8ca","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":150,"last_line":150,"raw_start":11967,"raw_end":12062,"revision_id":2618531},"chapter_id":"c-jinshu-043-leguang","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-leguang"},{"id":"c-jinshu-043-wangcheng:line118","text":"少曆顯位，累遷成都王穎從事中郎。穎嬖豎孟玖譖殺陸機兄弟，天下切齒。澄發玖私奸，勸穎殺玖，穎乃誅之，士庶莫不稱善。及穎敗，東海王越請為司空長史。以迎大駕勳，封南鄉侯。遷建威將軍、雍州刺史，不之職。時王敦、謝鯤、庾敳、阮修皆為衍所親善，號為四友，而亦與澄狎，又有光逸、胡毋輔之等亦豫焉。酣宴縱誕，窮歡極娛。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-043-wangcheng:line118:m0007","start":7,"end":11,"surface":"成都王穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0016","start":16,"end":17,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0019","start":19,"end":21,"surface":"孟玖","kind":"person","person_id":"bmo_6e2_cfl","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0023","start":23,"end":25,"surface":"陸機","kind":"person","person_id":"69h_uhy_hta","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:u0025","start":25,"end":27,"surface":"兄弟","kind":"unresolved","person_id":null,"status":"unresolved","unresolved_kind":"unresolved_source_person","interpretation_note":"此處以兄弟統稱同遭誅者，字面未列個別弟名。"},{"id":"c-jinshu-043-wangcheng:line118:m0033","start":33,"end":34,"surface":"澄","kind":"person","person_id":"rlk_lzd_86c","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-043-wangcheng:line118:m0035","start":35,"end":36,"surface":"玖","kind":"person","person_id":"bmo_6e2_cfl","status":"contextual_provi