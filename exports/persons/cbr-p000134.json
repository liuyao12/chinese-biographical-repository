34","status":"contextual_provisional","paragraph_id":"c-shiji-038-song:p001","chapter_id":"c-shiji-038-song"}],"relations":[{"id":"a-shiji003-033","subject_person_id":"cbr-p000134","predicate":"father","object_person_id":"cbr-p000133","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p026","quote":"帝太丁崩，子帝乙立","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji003-034","subject_person_id":"cbr-p000135","predicate":"father","object_person_id":"cbr-p000134","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p027","quote":"帝乙長子曰微子啓","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji003-035","subject_person_id":"cbr-p000136","predicate":"father","object_person_id":"cbr-p000134","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-003-yin:p027","quote":"帝乙崩，子辛立","chapter_id":"c-shiji-003-yin","source_id":"s-shiji-003-yin"}],"qualifiers":{"source_term":"子","historicity":"historical_tradition"},"interpretation_note":"保存原文明示關係；不把繼位本身當作父子證據，未與出土材料對讀。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji038-001","subject_person_id":"cbr-p000135","predicate":"father","object_person_id":"cbr-p000134","status":"source_attested","evidence":[{"chapter_id":"c-shiji-038-song","source_id":"s-shiji-038-song","paragraph_id":"c-shiji-038-song:p001","quote":"微子開者，殷帝乙之首子而帝紂之庶兄也。紂既立，不明，淫亂於政，微子數諫，紂不聽。及祖伊以周西伯昌之修德，滅黎國，懼禍至，以告紂。紂曰：「我生不有命在天乎？是何能爲！」於是微子度紂終不可諫，欲死之，及去，未能自決，乃問於太師、少師曰：「殷不有治政，不治四方。我祖遂陳於上，紂沈湎於酒，婦人是用，亂敗湯德於下。殷既小大好草竊姦宄，卿士師師非度，皆有罪辜，乃无維獲，小民乃并興，相爲敵讎。今殷其典喪！若涉水无津涯。殷遂喪，越至于今。」曰：「太師，少師，我其發出往？吾家保于喪？今女无故告予，顛躋，如之何其？」太師若曰：「王子，天篤下菑亡殷國，乃毋畏畏，不用老長。今殷民乃陋淫神祇之祀。今誠得治國，國治身死不恨。爲死，終不得治，不如去。」遂亡。"}],"qualifiers":{"source_term":"殷帝乙之首子","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示父、子、兄弟、夫人及曾庶孫說；不由繼位補父子，不補母名、共父母或闕代。來源主張與確證史實分開。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-005","person_id":"cbr-p000134","surfaces":["帝乙"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p026","quote":"帝武乙無道，為偶人，謂之天神。與之博，令人為行。天神不勝，乃僇辱之。為革囊，盛血，卬而射之，命曰「射天」。武乙獵於河渭之閒，暴雷，武乙震死。子帝太丁立。帝太丁崩，子帝乙立。帝乙立，殷益衰。"},{"paragraph_id":"c-shiji-033-lu:p009","quote":"周公歸，恐成王壯，治有所淫佚，乃作多士，作毋逸。毋逸稱：『爲人父母，爲業至長久，子孫驕奢忘之，以亡其家，爲人子可不慎乎！筆昔在殷王中宗，嚴恭敬畏天命，自度治民，震懼不敢荒寧，故中宗饗國七十五年。其在髙宗，久勞于外，爲與小人，作其即位，乃有亮闇，三年不言，言乃讙，不敢荒寧，密靖殷國，至于小大無怨，故髙宗饗國五十五年。其在祖甲，不義惟王，久爲小人于外，知小人之依，能保施小民，不侮寡，故祖甲饗國三十三年。』多士稱曰：『自湯至于帝乙，無不率祀明德，帝無不配天者。在今後嗣王紂，誕淫厥佚，不顧天及民之從也。其民皆可誅。』『文王日中昃不暇食，饗國五十年。』作此以誡成王。"}],"rationale":"按周初封建、武庚管蔡之亂、殷王廟號與魯君世系的具體語境暫定異稱。周公魯公與伯禽魯公依段落角色分開，王發不把普通動詞發當人名，世系與祈禱敘事仍待版本覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji038-007","person_id":"cbr-p000134","surfaces":["殷帝乙"],"scope":"cross_chapter","chapter_ids":["c-shiji-003-yin","c-shiji-038-song"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-003-yin:p026","quote":"帝武乙無道，為偶人，謂之天神。與之博，令人為行。天神不勝，乃僇辱之。為革囊，盛血，卬而射之，命曰「射天」。武乙獵於河渭之閒，暴雷，武乙震死。子帝太丁立。帝太丁崩，子帝乙立。帝乙立，殷益衰。"},{"paragraph_id":"c-shiji-038-song:p001","quote":"微子開者，殷帝乙之首子而帝紂之庶兄也。紂既立，不明，淫亂於政，微子數諫，紂不聽。及祖伊以周西伯昌之修德，滅黎國，懼禍至，以告紂。紂曰：「我生不有命在天乎？是何能爲！」於是微子度紂終不可諫，欲死之，及去，未能自決，乃問於太師、少師曰：「殷不有治政，不治四方。我祖遂陳於上，紂沈湎於酒，婦人是用，亂敗湯德於下。殷既小大好草竊姦宄，卿士師師非度，皆有罪辜，乃无維獲，小民乃并興，相爲敵讎。今殷其典喪！若涉水无津涯。殷遂喪，越至于今。」曰：「太師，少師，我其發出往？吾家保于喪？今女无故告予，顛躋，如之何其？」太師若曰：「王子，天篤下菑亡殷國，乃毋畏畏，不用老長。今殷民乃陋淫神祇之祀。今誠得治國，國治身死不恨。爲死，終不得治，不如去。」遂亡。"}],"rationale":"按本篇明示名與稱號、宋國世系及具體事件暫同指；未把同字短名全域合併，所有引句與未定處保留。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-003-yin:p026","text":"帝武乙無道，為偶人，謂之天神。與之博，令人為行。天神不勝，乃僇辱之。為革囊，盛血，卬而射之，命曰「射天」。武乙獵於河渭之閒，暴雷，武乙震死。子帝太丁立。帝太丁崩，子帝乙立。帝乙立，殷益衰。","mentions":[{"id":"c-shiji-003-yin:m026-0000","start":0,"end":3,"surface":"帝武乙","kind":"person","person_id":"cbr-p000132","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0053","start":53,"end":55,"surface":"武乙","kind":"person","person_id":"cbr-p000132","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0065","start":65,"end":67,"surface":"武乙","kind":"person","person_id":"cbr-p000132","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0071","start":71,"end":74,"surface":"帝太丁","kind":"person","person_id":"cbr-p000133","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0076","start":76,"end":79,"surface":"帝太丁","kind":"person","person_id":"cbr-p000133","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0082","start":82,"end":84,"surface":"帝乙","kind":"person","person_id":"cbr-p000134","status":"source_identified"},{"id":"c-shiji-003-yin:m026-0086","start":86,"end":88,"surface":"帝乙","kind":"person","person_id":"cbr-p000134","status":"source_identified"}],"chapter_id":"c-shiji-003-yin","book_id":"b-shiji-003","work_id":"w-shiji","source_id":"s-shiji-003-yin"},{"id":"c-shiji-003-yin:p027","text":"帝乙長子曰微子啓，啓母賤，不得嗣。少子辛，辛母正后，辛為嗣。帝乙崩，子辛立，是為帝辛，天下謂之紂。","mentions":[{"id":"c-shiji-003-yin:m027-0000","start":0,"end":2,"surface":"帝乙","kind":"person","person_id":"cbr-p000134","status":"source_identified"},{"id":"c-shiji-003-yin:m027-0005","start":5,"end":8,"surface":"微子啓","kind":"person","person_id":"cbr-p000135","status":"source_identified"},{"id":"c-shiji-003-yin:m027-0009","start":9,"end":10,"surface":"啓","kind":"person","person_id":"cbr-p000135","status":"source_identified"},{"id":"c-shiji-003-yin:m027-0010","start":10,"end":11,"surface":"母","kind":"person","person_id":"cbr-p000157","status":"contextual_provisional","interpretation_note":"依「啓母」或「辛母」的上下文辨認匿名母親，不補姓名。"},{"id":"c-shiji-003-yin:m027-0019","start":19,"end":20,"surface":"辛","kind":"person","person_id":"cbr-p000136","status":"source_identified"},{"id":"c-shiji-003-yin:m027-0021"