er_id":"c-shiji-001-wudi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-001-wudi:p014","text":"堯曰：「嗟！四嶽：朕在位七十載，汝能庸命，踐朕位？」嶽應曰：「鄙惪忝帝位。」堯曰：「悉舉貴戚及疏遠隱匿者。」衆皆言於堯曰：「有矜在民閒，曰虞舜。」堯曰：「然，朕聞之。其何如？」嶽曰：「盲者子。父頑，母嚚，弟傲，能和以孝，烝烝治，不至姦。」堯曰：「吾其試哉。」於是堯妻之二女，觀其德於二女。舜飭下二女於嬀汭，如婦禮。堯善之，乃使舜慎和五典，五典能從。乃徧入百官，百官時序。賓於四門，四門穆穆，諸侯遠方賓客皆敬。堯使舜入山林川澤，暴風雷雨，舜行不迷。堯以爲聖，召舜曰：「女謀事至而言可績，三年矣。女登帝位。」舜讓於德，不懌。正月上日，舜受終於文祖。文祖者，堯大祖也。","mentions":[{"id":"c-shiji-001-wudi:m014-0000","start":0,"end":1,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m014-0006","start":6,"end":8,"surface":"四嶽","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m014-0026","start":26,"end":27,"surface":"嶽","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m014-0038","start":38,"end":39,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m014-0058","start":58,"end":59,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m014-0069","start":69,"end":71,"surface":"虞舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m014-0073","start":73,"end":74,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m014-0088","start":88,"end":89,"surface":"嶽","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m014-0119","start":119,"end":120,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m014-0131","start":131,"end":132