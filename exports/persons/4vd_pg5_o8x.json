,{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0207","start":207,"end":208,"surface":"撫","kind":"person","person_id":"smf_swf_i2l","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0214","start":214,"end":216,"surface":"石覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0219","start":219,"end":220,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0229","start":229,"end":230,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0241","start":241,"end":243,"surface":"王國","kind":"person","person_id":"m9p_g06_c6t","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0244","start":244,"end":246,"surface":"劉願","kind":"person","person_id":"v0x_yhz_e7d","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0254","start":254,"end":255,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0262","start":262,"end":263,"surface":"保","kind":"person","person_id":"erh_25n_8sv","status":"contextual_provisional"}],"source_position":{"first_line":128,"last_line":128,"revision_id":2645530,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-075-xunsong-families","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-xunsong-families"},{"id":"c-jinshu-076-wangyi-family:p002","text":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","text_layer":"received_chapter