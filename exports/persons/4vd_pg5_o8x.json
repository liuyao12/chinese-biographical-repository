{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"4vd_pg5_o8x","canonical_person_id":"4vd_pg5_o8x","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["4vd_pg5_o8x"],"persons":[{"id":"4vd_pg5_o8x","label":"杜曾","status":"active","historicity":"historical_tradition","aliases":[{"surface":"杜曾","mention_ids":["c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0166","c-jinshu-096-lienv:xunguan:p001:m0019"]},{"surface":"曾","mention_ids":["c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0254"]}],"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","mention_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0166","quote":"杜曾"},{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","mention_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0254","quote":"曾"},{"work_id":"w-jinshu","book_id":"b-jinshu-096","chapter_id":"c-jinshu-096-lienv","source_id":"s-jinshu-096-lienv","paragraph_id":"c-jinshu-096-lienv:xunguan:p001","mention_id":"c-jinshu-096-lienv:xunguan:p001:m0019","quote":"杜曾"}],"identity_note":"依固定晉書選段與敘事上下文辨識；不補未載本名、日期、父母或婚姻。","review":"ai_provisional"}],"source_mention_summary":[{"source_id":"s-jinshu-075-xunsong-families","work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","mention_count":2,"mention_ids":["c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0166","c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0254"],"paragraph_ids":["c-jinshu-075-xunsong-families:xunsong-rescue:p001"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-jinshu-096-lienv","work_id":"w-jinshu","book_id":"b-jinshu-096","chapter_id":"c-jinshu-096-lienv","mention_count":1,"mention_ids":["c-jinshu-096-lienv:xunguan:p001:m0019"],"paragraph_ids":["c-jinshu-096-lienv:xunguan:p001"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-jinshu-075-xunsong-families"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0166","start":166,"end":168,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","chapter_id":"c-jinshu-075-xunsong-families"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0254","start":254,"end":255,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","chapter_id":"c-jinshu-075-xunsong-families"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0019","start":19,"end":21,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional","paragraph_id":"c-jinshu-096-lienv:xunguan:p001","chapter_id":"c-jinshu-096-lienv"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","text":"王彌入洛，崧與百官奔於密，未至而母亡。賊追將及，同旅散走，崧被髮從車，守喪號泣。賊至，棄其母屍於地，奪車而去。崧被四創，氣絕，至夜方蘇。葬母於密山。服闋，族父籓承制，以崧監江北軍事、南中郎將、後將軍、假節、襄城太守。時山陵發掘，崧遣主簿石覽將兵入洛，修復山陵。以勳進爵舞陽縣公，遷都督荊州江北諸軍事、平南將軍，鎮宛，改封曲陵公。為賊杜曾所圍。石覽時為襄城太守，崧力弱食盡，使其小女灌求救于覽及南中郎將周訪。訪即遣子撫率兵三千人會石覽，俱救崧。賊聞兵至，散走。崧既得免，乃遣南陽中部尉王國、劉願等潛軍襲穰縣，獲曾從兄偽新野太守保，斬之。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0000","start":0,"end":2,"surface":"王彌","kind":"person","person_id":"tyf_qc0_xq2","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0005","start":5,"end":6,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0029","start":29,"end":30,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0055","start":55,"end":56,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0079","start":79,"end":80,"surface":"籓","kind":"person","person_id":"yoo_ox0_545_FAAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0084","start":84,"end":85,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0114","start":114,"end":115,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0118","start":118,"end":120,"surface":"石覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0166","start":166,"end":168,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0171","start":171,"end":173,"surface":"石覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0180","start":180,"end":181,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0190","start":190,"end":191,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0194","start":194,"end":195,"surface":"覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0200","start":200,"end":202,"surface":"周訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0203","start":203,"end":204,"surface":"訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0207","start":207,"end":208,"surface":"撫","kind":"person","person_id":"smf_swf_i2l","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0214","start":214,"end":216,"surface":"石覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0219","start":219,"end":220,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0229","start":229,"end":230,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0241","start":241,"end":243,"surface":"王國","kind":"person","person_id":"m9p_g06_c6t","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0244","start":244,"end":246,"surface":"劉願","kind":"person","person_id":"v0x_yhz_e7d","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0254","start":254,"end":255,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0262","start":262,"end":263,"surface":"保","kind":"person","person_id":"erh_25n_8sv","status":"contextual_provisional"}],"source_position":{"first_line":128,"last_line":128,"revision_id":2645530,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-075-xunsong-families","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-xunsong-families"},{"id":"c-jinshu-096-lienv:xunguan:p001","text":"荀崧小女灌，幼有奇節。崧為襄城太守，為杜曾所圍，力弱食盡，欲求救于故吏平南將軍石覽，計無從出。灌時年十三，乃率勇士數千人，逾城突圍夜出。賊追甚急，灌督厲將士，且戰且前，得入魯陽山獲免。自詣覽乞師，又為崧書與南中郎將周訪請援，仍結為兄弟，訪即遣子撫率三千人會石覽俱救崧。賊聞兵至，散走，灌之力也。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-096-lienv:xunguan:p001:m0000","start":0,"end":2,"surface":"荀崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0004","start":4,"end":5,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0011","start":11,"end":12,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0019","start":19,"end":21,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0039","start":39,"end":41,"surface":"石覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0047","start":47,"end":48,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0073","start":73,"end":74,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0094","start":94,"end":95,"surface":"覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0100","start":100,"end":101,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0107","start":107,"end":109,"surface":"周訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0118","start":118,"end":119,"surface":"訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0122","start":122,"end":123,"surface":"撫","kind":"person","person_id":"smf_swf_i2l","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0128","start":128,"end":130,"surface":"石覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0132","start":132,"end":133,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0142","start":142,"end":143,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"}],"source_position":{"first_line":68,"last_line":68,"revision_id":2625341,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-096-lienv","book_id":"b-jinshu-096","work_id":"w-jinshu","source_id":"s-jinshu-096-lienv"}],"sources":[{"chapter_id":"c-jinshu-075-xunsong-families","work_id":"w-jinshu","book_id":"b-jinshu-075","source_id":"s-jinshu-075-xunsong-families","source":{"title":"卷七十五·列傳第四十五（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷075&oldid=2645530","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷075&oldid=2645530","revision_id":2645530,"accessed_on":"2026-10-18","extent":"荀崧及相關家族傳文局部選錄；不是全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"66cb6c8fe0c4f0a49ce57a29b251c2b59962e86a559d30cb4f3fa203df72539a","wikitext_sha256":"11d2db1eed03a9a461ce48abad661b90ba39911b13da75b3fe593dac197bc957","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，展開維基連結顯示文字；YL年號模板僅展開所載字串，未因此換算公元年。原字不改。末段原完整書信及二子句一併保存，未冒作跨省略段落的相鄰承接。","excerpts":[{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-intro:p001","source_lines":[126,126],"raw_quote":"　　荀崧，字景猷，潁川臨潁人，魏太尉彧之玄孫也。父頵，羽林右監、安陵鄉侯，與王濟、何劭為拜親之友。崧志操清純，雅好文學。齠齔時，族曾祖顗見而奇之，以為必興頵門。弱冠，太原王濟甚相器重，以方其外祖陳郡袁侃，謂侃弟奧曰：「近見荀監子，清虛名理，當不及父，德性純粹，是賢兄輩人也。」其為名流所賞如此。泰始中，詔以崧代兄襲父爵，補濮陽王允文學。與王敦、顧榮、陸機等友善，趙王倫引為相國參軍。倫篡，轉護軍司馬、給事中，稍遷尚書吏部郎、太弟中庶子，累遷侍中、中護軍。","raw_quote_sha256":"fe438333d90d870f18507beeaa243dba468013b9cde8ced3f8299e5e7b3c3e7d","selected_text_sha256":"8af4d66de19334a53f00475c7c3c412950beff0bb74f32d6101469a02a22cfe0","begin_anchor":"荀崧，字景猷，潁川臨潁人，魏太","end_anchor":"太弟中庶子，累遷侍中、中護軍。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","source_lines":[128,128],"raw_quote":"　　王彌入洛，崧與百官奔於密，未至而母亡。賊追將及，同旅散走，崧被髮從車，守喪號泣。賊至，棄其母屍於地，奪車而去。崧被四創，氣絕，至夜方蘇。葬母於密山。服闋，族父籓承制，以崧監江北軍事、南中郎將、後將軍、假節、襄城太守。時山陵發掘，崧遣主簿石覽將兵入洛，修復山陵。以勳進爵舞陽縣公，遷都督荊州江北諸軍事、平南將軍，鎮宛，改封曲陵公。為賊杜曾所圍。石覽時為襄城太守，崧力弱食盡，使其小女灌求救于覽及南中郎將周訪。訪即遣子撫率兵三千人會石覽，俱救崧。賊聞兵至，散走。崧既得免，乃遣南陽中部尉王國、劉願等潛軍襲穰縣，獲曾從兄偽新野太守保，斬之。","raw_quote_sha256":"2b305f0b95461c974328c3a55471cec3d89f086e29ba51e6e8fe7aa71cf0956b","selected_text_sha256":"71ed767e8d4c3172f287c501708b473ae8766a09a9eb2f733c04e8a236f9e73c","begin_anchor":"王彌入洛，崧與百官奔於密，未至","end_anchor":"，獲曾從兄偽新野太守保，斬之。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","source_lines":[130,130],"raw_quote":"　　元帝踐阼，徵拜尚書僕射，使崧與協共定中興禮儀。從弟馗早亡，二息序、廞，年各數歲，崧迎與共居，恩同其子。太尉、臨淮公荀顗國胤廢絕，朝庭以崧屬近，欲以崧子襲封。崧哀序孤微，乃讓封與序，論者稱焉。轉太常。時方修學校，簡省博士，置《[[周易]]》王氏、《[[尚書]]》鄭氏、《[[古文尚書]]》孔氏、《[[毛詩]]》鄭氏、《[[周官]][[禮記]]》鄭氏、《[[春秋左傳]]》杜氏服氏、《[[論語]]》《[[孝經]]》鄭氏博士各一人，凡九人，其《[[儀禮]]》、《[[公羊傳|公羊]]》、《[[穀梁傳|穀梁]]》及鄭《易》皆省不置。崧以為不可，乃上疏曰：","raw_quote_sha256":"564d35b0f95e1ca5cd0b7cd3b9ed4d2891fba8091b1351165f32ff8bb39b2ff8","selected_text_sha256":"9d89157274897b2f5c7e7b972e538334cfdba2b0a8ec284addb56c57ca953cb6","begin_anchor":"元帝踐阼，徵拜尚書僕射，使崧與","end_anchor":"序孤微，乃讓封與序，論者稱焉。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-sons:p001","source_lines":[148,148],"raw_quote":"　　其後著作郎虞預與丞相王導箋曰：「伏見前秘書、光祿大夫荀公，生於積德之族，少有儒雅之稱，歷位內外，在貴能降。蘇峻肆虐，乘輿失幸，公處嫌忌之地，有累卵之危，朝士為之寒心，論者謂之不免。而公將之以智，險而不懾，扶侍至尊，繾綣不離。雖無扶迎之勳，宜蒙守節之報。且其宣慈之美，早彰遠近，朝野之望，許以台司，雖未正位，已加儀同。至守終純固，名定闔棺，而薨卒之日，直加侍中。生有三槐之望，沒無鼎足之名，寵不增於前秩，榮不副於本望，此一時愚智所慷慨也。今承大弊之後，淳風頹散，苟有一介之善，宜在旌表之例，而況國之元老，志節若斯者乎！」不從。{{YL|升平四年}}，崧改葬，詔賜錢百萬，布五千匹。有二子：蕤、羨。蕤嗣。","raw_quote_sha256":"f1a65e82e51109992e7f9c866bd9d9e2dad65e1b99ed71937a68218b5ca8d74d","selected_text_sha256":"6115dc64ecf0cfafe174c4adc36cf60364b086d21c0ac358cd30a4a00deb7daf","begin_anchor":"其後著作郎虞預與丞相王導箋曰：","end_anchor":"五千匹。有二子：蕤、羨。蕤嗣。"}]}}},{"chapter_id":"c-jinshu-096-lienv","work_id":"w-jinshu","book_id":"b-jinshu-096","source_id":"s-jinshu-096-lienv","source":{"title":"列女傳·列傳第六十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷096&oldid=2625341","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷096&oldid=2625341","revision_id":2625341,"accessed_on":"2026-10-18","extent":"荀崧及相關家族傳文局部選錄；不是全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"678d31393caea3868cfcee297612f9fb761421eb84fa4fc0355bdd7072a81820","wikitext_sha256":"2a30a87df259042f1f5d783dd7b9674ff174208aae03383fad28ab3c88dbabb5","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，展開維基連結的顯示文字；選段無實際年號模板。原始字元與差異另外保存。","excerpts":[{"proposed_paragraph_id":"c-jinshu-096-lienv:xunguan:p001","source_lines":[68,68],"raw_quote":"[[晉書/卷075#荀崧|荀崧]]小女灌，幼有奇節。崧為襄城太守，為杜曾所圍，力弱食盡，欲求救于故吏平南將軍石覽，計無從出。灌時年十三，乃率勇士數千人，逾城突圍夜出。賊追甚急，灌督厲將士，且戰且前，得入魯陽山獲免。自詣覽乞師，又為崧書與南中郎將周訪請援，仍結為兄弟，訪即遣子撫率三千人會石覽俱救崧。賊聞兵至，散走，灌之力也。","raw_quote_sha256":"a620349a50a8214e281db353a26f63dba8c8484e4159fca02ce2b7121075b25d","selected_text_sha256":"a0b9f1298ca75d31737a8a2b24358d8fd8a72b09f2cfd1d700d7b3c3daa91d2b","begin_anchor":"荀崧小女灌，幼有奇節。崧為襄城","end_anchor":"崧。賊聞兵至，散走，灌之力也。"},{"proposed_paragraph_id":"c-jinshu-096-lienv:zhongyan-mother:p001","source_lines":[26,26],"raw_quote":"[[晉書/卷042#王渾|王渾]]妻鍾氏，字琰，潁川人，魏太傅繇曾孫也。父徽，黃門郎。琰數歲能屬文，及長，聰慧弘雅，博覽記籍。美容止，善嘯詠，禮儀法度為中表所則。既適渾，生濟。渾嘗共琰坐，濟趨庭而過，渾欣然曰：「生子如此，足慰人心。」琰笑曰：「若使新婦得配參軍，生子故不翅如此。」參軍，謂渾中弟淪也。琰女亦有才淑，為求賢夫。時有兵家子甚俊，濟欲妻之，白琰，琰曰：「要令我見之。」濟令此兵與群小雜處，琰自幃中察之，既而謂濟曰：「緋衣者非汝所拔乎？」濟曰：「是。」琰曰：「此人才足拔萃，然地寒壽促，不足展其器用，不可與婚。」遂止。其人數年果亡。琰明鑒遠識，皆此類也。","raw_quote_sha256":"7bbe46c409f8f69d34d54fcc0368693be235441d332975b6bbf2ba9a05f871ed","selected_text_sha256":"1288790567eb088a3b3315d03f63c733efa467465a84840c77db8409c83ebb97","begin_anchor":"王渾妻鍾氏，字琰，潁川人，魏太","end_anchor":"法度為中表所則。既適渾，生濟。"}]},"quality_note":"荀灌兵數本見證作數千，現代論文引作數十；只記見證差異，保留原字，未親核論文所報印本。詳見docs/source-reviews/jinshu096-xunguan-force-count.json。"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
