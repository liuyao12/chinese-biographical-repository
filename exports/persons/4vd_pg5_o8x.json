ind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangyi-family:p002","chapter_id":"c-jinshu-076-wangyi-family"},{"id":"c-jinshu-076-wangyi-family:p002:m0096","start":96,"end":97,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional","paragraph_id":"c-jinshu-076-wangyi-family:p002","chapter_id":"c-jinshu-076-wangyi-family"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0019","start":19,"end":21,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional","paragraph_id":"c-jinshu-096-lienv:xunguan:p001","chapter_id":"c-jinshu-096-lienv"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu-076-cross-009","person_id":"4vd_pg5_o8x","surfaces":["杜曾","曾"],"scope":"cross_chapter","chapter_ids":["c-jinshu-076-wangyi-family","c-jinshu-096-lienv","c-jinshu-075-xunsong-families"],"status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-jinshu-076-wangyi-family:p002:m0047","c-jinshu-076-wangyi-family:p002:m0067","c-jinshu-076-wangyi-family:p002:m0071","c-jinshu-076-wangyi-family:p002:m0094","c-jinshu-076-wangyi-family:p002:m0096","c-jinshu-096-lienv:xunguan:p001:m0019","c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0166"]},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-076","chapter_id":"c-jinshu-076-wangyi-family","source_id":"s-jinshu-076-wangyi-family","paragraph_id":"c-jinshu-076-wangyi-family:p002","quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。"},{"work_id":"w-jinshu","book_id":"b-jinshu-096","chapter_id":"c-jinshu-096-lienv","source_id":"s-jinshu-096-lienv","paragraph_id":"c-jinshu-096-lienv:xunguan:p001","quote":"荀崧小女灌，幼有奇節。崧為襄城太守，為杜曾所圍，力弱食盡，欲求救于故吏平南將軍石覽，計無從出。灌時年十三，乃率勇士數千人，逾城突圍夜出。賊追甚急，灌督厲將士，且戰且前，得入魯陽山獲免。自詣覽乞師，又為崧書與南中郎將周訪請援，仍結為兄弟，訪即遣子撫率三千人會石覽俱救崧。賊聞兵至，散走，灌之力也。"},{"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","quote":"王彌入洛，崧與百官奔於密，未至而母亡。賊追將及，同旅散走，崧被髮從車，守喪號泣。賊至，棄其母屍於地，奪車而去。崧被四創，氣絕，至夜方蘇。葬母於密山。服闋，族父籓承制，以崧監江北軍事、南中郎將、後將軍、假節、襄城太守。時山陵發掘，崧遣主簿石覽將兵入洛，修復山陵。以勳進爵舞陽縣公，遷都督荊州江北諸軍事、平南將軍，鎮宛，改封曲陵公。為賊杜曾所圍。石覽時為襄城太守，崧力弱食盡，使其小女灌求救于覽及南中郎將周訪。訪即遣子撫率兵三千人會石覽，俱救崧。賊聞兵至，散走。崧既得免，乃遣南陽中部尉王國、劉願等潛軍襲穰縣，獲曾從兄偽新野太守保，斬之。"}],"rationale":"卷76荊州杜曾與卷75圍荀崧于宛的杜曾，具名及同時代荊州亂事語境相合，暫接；不僅按曾字合人，也不添加未由本批引句支持的戰果。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","text":"王彌入洛，崧與百官奔於密，未至而母亡。賊追將及，同旅散走，崧被髮從車，守喪號泣。賊至，棄其母屍於地，奪車而去。崧被四創，氣絕，至夜方蘇。葬母於密山。服闋，族父籓承制，以崧監江北軍事、南中郎將、後將軍、假節、襄城太守。時山陵發掘，崧遣主簿石覽將兵入洛，修復山陵。以勳進爵舞陽縣公，遷都督荊州江北諸軍事、平南將軍，鎮宛，改封曲陵公。為賊杜曾所圍。石覽時為襄城太守，崧力弱食盡，使其小女灌求救于覽及南中郎將周訪。訪即遣子撫率兵三千人會石覽，俱救崧。賊聞兵至，散走。崧既得免，乃遣南陽中部尉王國、劉願等潛軍襲穰縣，獲曾從兄偽新野太守保，斬之。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0000","start":0,"end":2,"surface":"王彌","kind":"person","person_id":"tyf_qc0_xq2","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0005","start":5,"end":6,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0029","start":29,"end":30,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001:m0055","start":55,"end":56,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contex