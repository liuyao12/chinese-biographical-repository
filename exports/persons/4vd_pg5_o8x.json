"end":58,"surface":"第五猗","kind":"person","person_id":"kiy_6gd_i7y","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0060","start":60,"end":61,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0062","start":62,"end":63,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0067","start":67,"end":68,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0071","start":71,"end":72,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0075","start":75,"end":76,"surface":"敦","kind":"person","person_id":"39o_b6y_n74","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0081","start":81,"end":83,"surface":"甘卓","kind":"person","person_id":"csn_tgm_oe7","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0088","start":88,"end":90,"surface":"周廣","kind":"person","person_id":"1tq_584_98b","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0092","start":92,"end":93,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0094","start":94,"end":95,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0096","start":96,"end":97,"surface":"曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0100","start":100,"end":101,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0105","start":105,"end":106,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0140","start":140,"end":142,"surface":"王導","kind":"person","person_id":"7r6_k52_qji_ABAA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0143","start":143,"end":145,"surface":"庾亮","kind":"person","person_id":"kk2_p9l_dro","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0148","start":148,"end":150,"surface":"世將","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0157","start":157,"end":158,"surface":"亮","kind":"person","person_id":"kk2_p9l_dro","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0170","start":170,"end":171,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0176","start":176,"end":177,"surface":"侃","kind":"person","person_id":"twd_erg_kmz","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0184","start":184,"end":188,"surface":"皇甫方回","kind":"person","person_id":"xe3_d7n_iej","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0203","start":203,"end":204,"surface":"帝","kind":"person","person_id":"yoc_50k_tps","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0206","start":206,"end":207,"surface":"廙","kind":"person","person_id":"7r6_k52_qji_ABDA","status":"contextual_provisional"},{"id":"c-jinshu-076-wangyi-family:p002:m0220","start":220,"end":221,"surface":"母","kind":"person","person_id":"7ie_92j_3xk","status":"contextual_provisional"}],"source_position":{"first_line":39,"last_line":40,"revision_id":2180533,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-076-wangyi-family","book_id":"b-jinshu-076","work_id":"w-jinshu","source_id":"s-jinshu-076-wangyi-family"},{"id":"c-jinshu-096-lienv:xunguan:p001","text":"荀崧小女灌，幼有奇節。崧為襄城太守，為杜曾所圍，力弱食盡，欲求救于故吏平南將軍石覽，計無從出。灌時年十三，乃率勇士數千人，逾城突圍夜出。賊追甚急，灌督厲將士，且戰且前，得入魯陽山獲免。自詣覽乞師，又為崧書與南中郎將周訪請援，仍結為兄弟，訪即遣子撫率三千人會石覽俱救崧。賊聞兵至，散走，灌之力也。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-096-lienv:xunguan:p001:m0000","start":0,"end":2,"surface":"荀崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0004","start":4,"end":5,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0011","start":11,"end":12,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0019","start":19,"end":21,"surface":"杜曾","kind":"person","person_id":"4vd_pg5_o8x","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0039","start":39,"end":41,"surface":"石覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0047","start":47,"end":48,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0073","start":73,"end":74,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0094","start":94,"end":95,"surface":"覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0100","start":100,"end":101,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0107","start":107,"end":109,"surface":"周訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0118","start":118,"end":119,"surface":"訪","kind":"person","person_id":"c6b_s71_vt7","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0122","start":122,"end":123,"surface":"撫","kind":"person","person_id":"smf_swf_i2l","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0128","start":128,"end":130,"surface":"石覽","kind":"person","person_id":"72y_aw4_2e4","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0132","start":132,"end":133,"surface":"崧","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"},{"id":"c-jinshu-096-lienv:xunguan:p001:m0142","start":142,"end":143,"surface":"灌","kind":"person","person_id":"yoo_ox0_545_BABAAAC","status":"contextual_provisional"}],"source_position":{"first_line":68,"last_line":68,"revision_id":2625341,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-096-lienv","book_id":"b-jinshu-096","work_id":"w-jinshu","source_id":"s-jinshu-096-lienv"}],"sources":[{"chapter_id":"c-jinshu-075-xunsong-families","work_id":"w-jinshu","book_id":"b-jinshu-075","source_id":"s-jinshu-075-xunsong-families","source":{"title":"卷七十五·列傳第四十五（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷075&oldid=2645530","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷075&oldid=2645530","revision_id":2645530,"accessed_on":"2026-10-18","extent":"荀崧及相關家族傳文局部選錄；不是全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"66cb6c8fe0c4f0a49ce57a29b251c2b59962e86a559d30cb4f3fa203df72539a","wikitext_sha256":"11d2db1eed03a9a461ce48abad661b90ba39911b13da75b3fe593dac197bc957","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，展開維基連結顯示文字；YL年號模板僅展開所載字串，未因此換算公元年。原字不改。末段原完整書信及二子句一併保存，未冒作跨省略段落的相鄰承接。","excerpts":[{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-intro:p001","source_lines":[126,126],"raw_quote":"　　荀崧，字景猷，潁川臨潁人，魏太尉彧之玄孫也。父頵，羽林右監、安陵鄉侯，與王濟、何劭為拜親之友。崧志操清純，雅好文學。齠齔時，族曾祖顗見而奇之，以為必興頵門。弱冠，太原王濟甚相器重，以方其外祖陳郡袁侃，謂侃弟奧曰：「近見荀監子，清虛名理，當不及父，德性純粹，是賢兄輩人也。」其為名流所賞如此。泰始中，詔以崧代兄襲父爵，補濮陽王允文學。與王敦、顧榮、陸機等友善，趙王倫引為相國參軍。倫篡，轉護軍司馬、給事中，稍遷尚書吏部郎、太弟中庶子，累遷侍中、中護軍。","raw_quote_sha256":"fe438333d90d870f18507beeaa243dba468013b9cde8ced3f8299e5e7b3c3e7d","selected_text_sha256":"8af4d66de19334a53f00475c7c3c412950beff0bb74f32d6101469a02a22cfe0","begin_anchor":"荀崧，字景猷，潁川臨潁人，魏太","end_anchor":"太弟中庶子，累遷侍中、中護軍。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-rescue:p001","source_lines":[128,128],"raw_quote":"　　王彌入洛，崧與百官奔於密，未至而母亡。賊追將及，同旅散走，崧被髮從車，守喪號泣。賊至，棄其母屍於地，奪車而去。崧被四創，氣絕，至夜方蘇。葬母於密山。服闋，族父籓承制，以崧監江北軍事、南中郎將、後將軍、假節、襄城太守。時山陵發掘，崧遣主簿石覽將兵入洛，修復山陵。以勳進爵舞陽縣公，遷都督荊州江北諸軍事、平南將軍，鎮宛，改封曲陵公。為賊杜曾所圍。石覽時為襄城太守，崧力弱食盡，使其小女灌求救于覽及南中郎將周訪。訪即遣子撫率兵三千人會石覽，俱救崧。賊聞兵至，散走。崧既得免，乃遣南陽中部尉王國、劉願等潛軍襲穰縣，獲曾從兄偽新野太守保，斬之。","raw_quote_sha256":"2b305f0b95461c974328c3a55471cec3d89f086e29ba51e6e8fe7aa71cf0956b","selected_text_sha256":"71ed767e8d4c3172f287c501708b473ae8766a09a9eb2f733c04e8a236f9e73c","begin_anchor":"王彌入洛，崧與百官奔於密，未至","end_anchor":"，獲曾從兄偽新野太守保，斬之。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-cousins:p001","source_lines":[130,130],"raw_quote":"　　元帝踐阼，徵拜尚書僕射，使崧與協共定中興禮儀。從弟馗早亡，二息序、廞，年各數歲，崧迎與共居，恩同其子。太尉、臨淮公荀顗國胤廢絕，朝庭以崧屬近，欲以崧子襲封。崧哀序孤微，乃讓封與序，論者稱焉。轉太常。時方修學校，簡省博士，置《[[周易]]》王氏、《[[尚書]]》鄭氏、《[[古文尚書]]》孔氏、《[[毛詩]]》鄭氏、《[[周官]][[禮記]]》鄭氏、《[[春秋左傳]]》杜氏服氏、《[[論語]]》《[[孝經]]》鄭氏博士各一人，凡九人，其《[[儀禮]]》、《[[公羊傳|公羊]]》、《[[穀梁傳|穀梁]]》及鄭《易》皆省不置。崧以為不可，乃上疏曰：","raw_quote_sha256":"564d35b0f95e1ca5cd0b7cd3b9ed4d2891fba8091b1351165f32ff8bb39b2ff8","selected_text_sha256":"9d89157274897b2f5c7e7b972e538334cfdba2b0a8ec284addb56c57ca953cb6","begin_anchor":"元帝踐阼，徵拜尚書僕射，使崧與","end_anchor":"序孤微，乃讓封與序，論者稱焉。"},{"proposed_paragraph_id":"c-jinshu-075-xunsong-families:xunsong-sons:p001","source_lines":[148,148],"raw_quote":"　　其後著作郎虞預與丞相王導箋曰：「伏見前秘書、光祿大夫荀公，生於積德之族，少有儒雅之稱，歷位內外，在貴能降。蘇峻肆虐，乘輿失幸，公處嫌忌之地，有累卵之危，朝士為之寒心，論者謂之不免。而公將之以智，險而不懾，扶侍至尊，繾綣不離。雖無扶迎之勳，宜蒙守節之報。且其宣慈之美，早彰遠近，朝野之望，許以台司，雖未正位，已加儀同。至守終純固，名定闔棺，而薨卒之日，直加侍中。生有三槐之望，沒無鼎足之名，寵不增於前秩，榮不副於本望，此一時愚智所慷慨也。今承大弊之後，淳風頹散，苟有一介之善，宜在旌表之例，而況國之元老，志節若斯者乎！」不從。{{YL|升平四年}}，崧改葬，詔賜錢百萬，布五千匹。有二子：蕤、羨。蕤嗣。","raw_quote_sha256":"f1a65e82e51109992e7f9c866bd9d9e2dad65e1b99ed71937a68218b5ca8d74d","selected_text_sha256":"6115dc64ecf0cfafe174c4adc36cf60364b086d21c0ac358cd30a4a00deb7daf","begin_anchor":"其後著作郎虞預與丞相王導箋曰：","end_anchor":"五千匹。有二子：蕤、羨。蕤嗣。"}]}}},{"chapter_id":"c-jinshu-076-wangyi-family","work_id":"w-jinshu","book_id":"b-jinshu-076","source_id":"s-jinshu-076-wangyi-family","source":{"title":"《晉書》卷七十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%99%89%E6%9B%B8%2F%E5%8D%B7076&oldid=2180533","revision_id":2180533,"accessed_on":"2026-10-18","extent":"王廙傳首、末段及子嗣共四段，中興賦等中段未錄，非完整列傳。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，未親核底本影像","response_sha256":"c6c7c41bf93c491f6f69b058ecc493e979d65f3e65397d20055284f2e829cd30","wikitext_sha256":"872701db949f6f58ea6f183425617dfa82353177d2cc026037bfad953a60cd71","normalization":{"character_conversion":{},"extraction_note":"去首部空白，宋書ref校勘記另存，正文原字不改；不補平南將領的疑缺字。","excerpts":[{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p001","source_lines":[27,28],"raw_quote":"王廙，字世將，丞相導從弟，而元帝姨弟也。父正，尚書郎。廙少能屬文，多所通涉，工書畫，善音樂、射御、博弈、雜伎。辟太傅掾，轉參軍。豫迎大駕，封武陵縣侯，拜尚書郎，出為濮陽太守。元帝作鎮江左，廙棄郡過江。帝見之大悅，以為司馬。頻守廬江、鄱陽二郡。豫討周馥、杜韜，以功累增封邑，除冠軍將軍，鎮石頭，領丞相軍諮祭酒。王敦啟為甯遠將軍、荊州刺史。","raw_quote_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","selected_text_sha256":"8147d33d3202efaa1adf4a1c6aa137d71d239827b11033011846a53f38708001","begin_anchor":"王廙，字世將，丞相導從弟，而元","end_anchor":"。王敦啟為甯遠將軍、荊州刺史。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p002","source_lines":[39,40],"raw_quote":"初，王敦左遷陶侃，使廙代為荊州。將吏馬俊、鄭攀等上書請留侃，敦不許。廙為俊等所襲，奔于江安。賊杜曾與俊、攀北迎第五猗以距廙。廙督諸軍討曾，又為曾所敗。敦命湘州刺史甘卓、豫章太守周廣等助廙擊曾，曾衆潰，廙得到州。廙性俊率，嘗從南下，旦自尋陽，迅風飛帆，暮至都，倚舫樓長嘯，神氣甚逸。王導謂庾亮曰：「世將為傷時識事。」亮曰：「正足舒其逸氣耳。」廙在州大誅戮侃時將佐，及征士皇甫方回，於是大失荊土之望，人情乖阻。帝乃征廙為輔國將軍，加散騎常侍。以母喪去職。服闋，拜征虜將軍，進左衛將軍。","raw_quote_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","selected_text_sha256":"713e46789dcf7fe1c521542418159b142d29f81e58c3e6357597be46caf9c662","begin_anchor":"初，王敦左遷陶侃，使廙代為荊州","end_anchor":"服闋，拜征虜將軍，進左衛將軍。"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p003","source_lines":[41,42],"raw_quote":"及王敦構禍，帝遣廙喻敦，既不能諫其悖逆，乃為敦所留，受任助亂。敦得志，以廙為平南將領護南蠻校尉、荊州刺史。尋病卒。帝猶以親故，深痛湣之。喪還京都，皇太子親臨拜柩，如家人之禮。贈侍中、驃騎將軍，諡曰康。明帝與大將軍溫嶠書曰：「痛謝鯤未絕於口，世將復至於此。並盛年雋才，不遂其志，痛切於心。廙明古多通，鯤遠有識致。其言雖未足令人改聽，然味之不倦，近未易有也。坐相視盡，如何！」","raw_quote_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","selected_text_sha256":"b2c8c3b975ba6ac7732d8b4a11f0ec1be353f9f1fb577963a649d9140d52c2bb","begin_anchor":"及王敦構禍，帝遣廙喻敦，既不能","end_anchor":"近未易有也。坐相視盡，如何！」"},{"proposed_paragraph_id":"c-jinshu-076-wangyi-family:p004","source_lines":[43,44],"raw_quote":"子頤之嗣，仕至東海內史。頤之弟胡之，字修齡，弱冠有聲譽，歷郡守、侍中、丹陽尹。素有風眩疾，發動甚數，而神明不損。石季龍死，朝廷欲綏輯河洛，以胡之為西中郎將、司州刺史、假節，以疾固辭，未行而卒。子茂之亦有美譽，官至晉陵太守。子敬弘，義熙末為尚書。","raw_quote_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","selected_text_sha256":"07b3bbc4071f24625a64510a17080b7ab063923ca9f6d5febeb0893dfefef0c6","begin_anchor":"子頤之嗣，仕至東海內史。頤之弟","end_anchor":"陵太守。子敬弘，義熙末為尚書。"}]}}},{"chapter_id":"c-jinshu-096-lienv","work_id":"w-jinshu","book_id":"b-jinshu-096","source_id":"s-jinshu-096-lienv","source":{"title":"列女傳·列傳第六十六（數位選錄）","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=晉書/卷096&oldid=2625341","permalink":"https://zh.wikisource.org/w/index.php?title=晉書/卷096&oldid=2625341","revision_id":2625341,"accessed_on":"2026-10-18","extent":"荀崧及相關家族傳文局部選錄；不是全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"rights":"古代原文及維基文庫數位轉錄；保留見證歸屬。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","edition":"維基文庫數位轉錄，底本影像未核","response_sha256":"678d31393caea3868cfcee297612f9fb761421eb84fa4fc0355bdd7072a81820","wikitext_sha256":"2a30a87df259042f1f5d783dd7b9674ff174208aae03383fad28ab3c88dbabb5","normalization":{"character_conversion":{},"extraction_note":"移除段首排版空白，展開維基連結的顯示文字；選段無實際年號模板。原始字元與差異另外保存。","excerpts":[{"proposed_paragraph_id":"c-jinshu-096-lienv:xunguan:p001","source_lines":[68,68],"raw_quote":"[[晉書/卷075#荀崧|荀崧]]小女灌，幼有奇節。崧為襄城太守，為杜曾所圍，力弱食盡，欲求救于故吏平南將軍石覽，計無從出。灌時年十三，乃率勇士數千人，逾城突圍夜出。賊追甚急，灌督厲將士，且戰且前，得入魯陽山獲免。自詣覽乞師，又為崧書與南中郎將周訪請援，仍結為兄弟，訪即遣子撫率三千人會石覽俱救崧。賊聞兵至，散走，灌之力也。","raw_quote_sha256":"a620349a50a8214e281db353a26f63dba8c8484e4159fca02ce2b7121075b25d","selected_text_sha256":"a0b9f1298ca75d31737a8a2b24358d8fd8a72b09f2cfd1d700d7b3c3daa91d2b","begin_anchor":"荀崧小女灌，幼有奇節。崧為襄城","end_anchor":"崧。賊聞兵至，散走，灌之力也。"},{"proposed_paragraph_id":"c-jinshu-096-lienv:zhongyan-mother:p001","source_lines":[26,26],"raw_quote":"[[晉書/卷042#王渾|王渾]]妻鍾氏，字琰，潁川人，魏太傅繇曾孫也。父徽，黃門郎。琰數歲能屬文，及長，聰慧弘雅，博覽記籍。美容止，善嘯詠，禮儀法度為中表所則。既適渾，生濟。渾嘗共琰坐，濟趨庭而過，渾欣然曰：「生子如此，足慰人心。」琰笑曰：「若使新婦得配參軍，生子故不翅如此。」參軍，謂渾中弟淪也。琰女亦有才淑，為求賢夫。時有兵家子甚俊，濟欲妻之，白琰，琰曰：「要令我見之。」濟令此兵與群小雜處，琰自幃中察之，既而謂濟曰：「緋衣者非汝所拔乎？」濟曰：「是。」琰曰：「此人才足拔萃，然地寒壽促，不足展其器用，不可與婚。」遂止。其人數年果亡。琰明鑒遠識，皆此類也。","raw_quote_sha256":"7bbe46c409f8f69d34d54fcc0368693be235441d332975b6bbf2ba9a05f871ed","selected_text_sha256":"1288790567eb088a3b3315d03f63c733efa467465a84840c77db8409c83ebb97","begin_anchor":"王渾妻鍾氏，字琰，潁川人，魏太","end_anchor":"法度為中表所則。既適渾，生濟。"}]},"quality_note":"荀灌兵數本見證作數千，現代論文引作數十；只記見證差異，保留原字，未親核論文所報印本。詳見docs/source-reviews/jinshu096-xunguan-force-count.json。"}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true}}
