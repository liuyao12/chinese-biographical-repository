y_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-jin043-shantao-life_002","person_id":"9v3_uwk_rqy","event_type":"death","source_term":"崩","source_anchor":{"paragraph_id":"c-jinshu-043-shantao:p007","start":133,"end":134,"surface":"崩"},"date_expression":null,"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","source_id":"s-jinshu-043-ws2618531-shantao","chapter_id":"c-jinshu-043-shantao","paragraph_id":"c-jinshu-043-shantao:p007","quote":"後除太常卿，以疾不就。會遭母喪，歸鄉里。濤年逾耳順，居喪過禮，負土成墳，手植松柏。詔曰：「吾所共致化者，官人之職是也。方今風欲陵遲，人心進動，宜崇明好惡，鎮以退讓。山太常雖尚居諒闇，情在難奪，方今務殷，何得遂其志邪！其以濤為吏部尚書。」濤辭以喪病，章表懇切。會元皇后崩，遂扶興還洛。逼迫詔命，自力就職。前後選舉，周遍內外，而並得其才。","person_mention_id":"c-jinshu-043-shantao:p007:m0130"}],"source_death_context":{"kind":"attached_received_biography_frame","frame":"paragraph_frame_007","paragraph_id":"c-jinshu-043-shantao:p007","source_revision":2618531,"paragraph_sha256":"a44b8847593a058e975f77c3b48bbe5e2d631b6e8d9634a64db159df586db8b5","roles":{"r0":"c-jinshu-043-shantao:p007:m0013","r1":"c-jinshu-043-shantao:p007:m0020","r2":"c-jinshu-043-shantao:p007:m0082","r3":"c-jinshu-043-shantao:p007:m0110","r4":"c-jinshu-043-shantao:p007:m0118","r5":"c-jinshu-043-shantao:p007:m0130"},"fields":{"career_027":{"paragraph_id":"c-jinshu-043-shantao:p007","start":2,"end":5,"surface":"太常卿"},"career_028":{"paragraph_id":"c-jinshu-043-shantao:p007","start":112,"end":116,"surface":"吏部尚書"}},"inside_role_fields":{},"human_reviewed":false,"slot":"life_002"},"interpretation_note":"按完整本段明示喪/崩/薨/卒與實際主體；濤太康四年283，其他日期未知。臥疾歸家、夏口遷徙及卒於官不作死亡地，不由報齡推生年或任終。","status":"source_attested","reviewer":"Codex（AI代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-jinshu-043-shantao:p007:m0130","start":130,"end":133,"surface":"元皇后","kind":"person","person_id":"9v3_uwk_rqy","status":"contextual_provisional","resolution_note":"按本段主體、引語發受話人及完整附傳範圍辨識；非全域同字匹配。","paragraph_id":"c