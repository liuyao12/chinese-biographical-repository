"}],"source_assertion_id":"a-shiji093-010","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"moi_ml7_uxh"},"id_aliases":["cbr-p005157"]},{"id":"moi_ml7_uxh_AA","label":"恒（高祖子）（韓信盧綰列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"子恒","mention_ids":["c-shiji-093-hanlu:m018-0029"]}],"evidence":[{"mention_id":"c-shiji-093-hanlu:m018-0029","chapter_id":"c-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p018","quote":"子恒"}],"family_path":{"connection":"father","generation_distance":1,"status":"contextual_provisional","human_reviewed":false,"evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p018","quote":"上還至洛陽。上曰：「代居常山北，趙乃從山南有之，遠。」乃立子恒為代王，都中都，代、鴈門皆屬代。","source_term":"乃立子恒"}],"source_assertion_id":"a-shiji093-014","interpretation_note":"以此受傳正文的明示近親主張配置局部家族；不合併跨篇候選身份、不補闕名世代，不表示遠祖世系已核實。分支字元不是長幼排行。","reviewer":"Codex（AI 代理）","parent_person_id":"moi_ml7_uxh_A"},"id_aliases":["cbr-p005202"]}],"source_mention_summary":[{"source_id":"s-shiji-093-hanlu","work_id":"w-shiji","book_id":"b-shiji-093","chapter_id":"c-shiji-093-hanlu","mention_count":1,"mention_ids":["c-shiji-093-hanlu:m018-0029"],"paragraph_ids":["c-shiji-093-hanlu:p018"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-093-hanlu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji093-014","subject_person_id":"moi_ml7_uxh_AA","predicate":"father","object_person_id":"moi_ml7_uxh_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-093-hanlu","source_id":"s-shiji-093-hanlu","paragraph_id":"c-shiji-093-hanlu:p018","quote":"上還至洛陽。上曰：「代居常山北，趙乃從山南有之，遠。」乃立子恒為代王，都中都，代、鴈門皆屬代。"}],"qualifiers":{"source_te