9,1620,1621,1622,1623,1624,1625,1626,1627,1628,1629,1630,1631,1632,1633,1634,1635,1636,1637,1638,1639,1640,1641,1642,1643,1644,1645,1646,1647,1648,1649,1650,1651,1652,1653,1654,1655,1656,1657,1658,1659,1660],"revision_id":1762878},"mentions":[{"id":"c-nanqishu-054-recluses-complete:p010:m0002","start":2,"end":4,"surface":"僧胤","kind":"person","person_id":"myp_54w_ksk","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p010:m0005","start":5,"end":7,"surface":"惠照","kind":"person","person_id":"mex_5i1_v70","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p010:m0013","start":13,"end":15,"surface":"太祖","kind":"person","person_id":"47p_kjh_ez7","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p010:m0022","start":22,"end":24,"surface":"桂陽","kind":"person","person_id":"fjv_3dz_w0m","status":"contextual_provisional"},{"id":"c-nanqishu-054-recluses-complete:p010:m0033","start":33,"end":36,"surface":"荀伯玉","kind":"person","person_id":"5we_446_pbb_AA","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-054-recluses-complete","book_id":"b-nanqishu-054","work_id":"w-nanqishu","source_id":"s-nanqishu-054-recluses-complete-ws1762878"},{"id":"c-nanqishu-059-western-polities-complete:p020","text":"夫廢興無謬，逆順有恒，古今共貫；賢愚同察。梁州刺史范柏年懷挾詭態，首鼠兩端，既已被伐，盤桓稽命。遂潛遣李烏奴叛。楊文弘扇誘邊疆荒雜。柏年今已梟禽，烏奴頻被摧破，計其餘燼，行自消夷。今遣參軍行晉壽太守王道寶、參軍事行北巴西新巴二郡太守任湜之、行宕渠太守王安會領銳卒三千，遄塗風邁，浮川電掩。又命輔國將軍三巴校尉明惠照、巴郡太守魯休烈、南巴西太守柳弘稱、益州刺史傅琰，竝簡徒競騖，選甲爭馳。雍州水步，行次魏興，并山東僑舊，會于南鄭。或汎舟墊江，或飛旍劍道，腹背飊騰，表裏震擊。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":3333,"raw_end":3609,"raw_character_offsets":[3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,