{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003677","identity_policy":"contextual_provisional","person_ids":["cbr-p003677"],"persons":[{"id":"cbr-p003677","label":"大將軍光（三王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"大將軍光","mention_ids":["c-shiji-060-sanwang:m031-0042"]}],"evidence":[{"mention_id":"c-shiji-060-sanwang:m031-0042","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p031","quote":"大將軍光"}]}],"mentions":[{"id":"c-shiji-060-sanwang:m031-0042","start":42,"end":46,"surface":"大將軍光","kind":"person","person_id":"cbr-p003677","status":"contextual_provisional","paragraph_id":"c-shiji-060-sanwang:p031","chapter_id":"c-shiji-060-sanwang"}],"relations":[],"title_holdings":[{"id":"th-shiji060-029","person_id":"cbr-p003677","title":"大將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p031","quote":"其後旦復與左將軍上官桀等謀反，宣言曰「我次太子，太子不在，我當立，大臣共抑我」云云。大將軍光輔政，與公卿大臣議曰：「燕王旦不改過悔正，行惡不變。」於是修法直斷，行罰誅。旦自殺，國除，如其策指。有司請誅旦妻子。孝昭以骨肉之親，不忍致法，寬赦旦妻子，免為庶人。傳曰「蘭根與白芷，漸之滫中，君子不近，庶人不服」者，所以漸然也。"}],"attestations":[{"id":"th-shiji060-029:a001","paragraph_id":"c-shiji-060-sanwang:p031","start":42,"end":45,"surface":"大將軍","person_mention_id":"c-shiji-060-sanwang:m031-0042","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"依來源用稱保存，首次提及不補授職日；守、行事及兼攝不冒稱正式新授，單名及制度未定者不補姓或官制細節。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji060-045","person_id":"cbr-p003677","surfaces":["大將軍光"],"scope":"same_chapter","chapter_ids":["c-shiji-060-sanwang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-060-sanwang:p031","quote":"其後旦復與左將軍上官