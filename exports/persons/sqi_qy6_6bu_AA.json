ationship_anchor":{"paragraph_id":"c-liangshu-046-dukans-family-context:p002","surface":"崱第二兄岑","start":2,"end":7}}]}],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-028-peizhiheng-complete:p002","text":"時尋陽王大心在江州，範副梅思立密要大心襲湓城，之橫斬思立而拒大心。大心以州降景。之橫率衆與兄之高同歸元帝，承制除散騎常侍、廷尉卿，出爲河東內史。又隨王僧辯拒侯景於巴陵，景退，遷持節、平北將軍、東徐州刺史，中護軍，封豫寧侯，邑三千戶。又隨僧辯追景，平郢、魯、江、晉等州，恒爲前鋒陷陣。仍至石頭，破景，景東奔，僧辯令之橫與杜崱入守臺城。及陸納據湘州叛，又隸王僧辯南討焉。于陣斬納將李賢明，遂平之。又破武陵王於硤口。還除吳興太守，乃作百幅被，以成其初志。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":46,"last_line":46,"raw_start":2662,"raw_end":2886,"raw_character_offsets":[2662,2663,2664,2665,2666,2667,2668,2669,2670,2671,2672,2673,2674,2675,2676,2677,2678,2679,2680,2681,2682,2683,2684,2685,2686,2687,2688,2689,2690,2691,2692,2693,2694,2695,2696,2697,2698,2699,2700,2701,2702,2703,2704,2705,2706,2707,2708,2709,2710,2711,2712,2713,2714,2715,2716,2717,2718,2719,2720,2721,2722,2723,2724,2725,2726,2727,2728,2729,2730,2731,2732,2733,2734,2735,2736,2737,2738,2739,2740,2741,2742,2743,2744,2745,2746,2747,2748,2749,2750,2751,2752,2753,2754,2755,2756,2757,2758,2759,2760,2761,2762,2763,2764,2765,2766,2767,2768,2769,2770,2771,2772,2773,2774,2775,2776,2777,2778,2779,2780,2781,2782,2783,2784,2785,2786,2787,2788,2789,2790,2791,2792,2793,2794,2795,2796,2797,2798,2799,2800,2801,2802,2803,2804,2805,2806,2807,2808,2809,2810,2811,2812,2813,2814,2815,2816,2817,2818,2819,2820,2821,2822,2823,2824,2825,2826,2827,2828,2829,2830,2831,2832,2833,2834,2835,2836,2837,2838,2839,2840,2841,2842,2843,2844,2845,2846,2847,2848,2849,2850,2851,2852,2853,2854,2855,2856,2857,2858,2859,2860,2861,2862,2863,2864,2865,2866,2867,2868,2869,2870,2871,2872,2873,2874,2875,2876,2877,2878,2879,2880,2881,2882,2883,2884,2885],"revision_id":1511902},"mentions":[{"id":"c-liangshu-028-peizhiheng-complete:p002:m0001","start":1,"end":6,"surface":"尋陽王大心","kind":"person","person_id":"rtd_v0b_nyn_E","status":"contextual_provisional"},{"id":"c-liangshu-028-peizhiheng-complete