":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-060","chapter_id":"c-sanguozhi-060-quancong","source_id":"s-sanguozhi-060-quancong","paragraph_id":"c-sanguozhi-060-quancong:line042","quote":"　　琮既親重，宗族子弟並蒙寵貴，賜累千金，然猶謙虛接士，貌無驕色。十二年卒，子懌嗣。後襲業領兵，救諸葛誕於壽春，出城先降，魏以為平東將軍，封臨湘侯。懌兄子禕、儀、靜等亦降魏，皆歷郡守列侯。","person_mention_id":"c-sanguozhi-060-quancong:line042:m0039"}],"attestations":[{"id":"t-wu060-t-wu060-quancong20:a","paragraph_id":"c-sanguozhi-060-quancong:line042","person_mention_id":"c-sanguozhi-060-quancong:line042:m0039","start":70,"end":73,"surface":"臨湘侯","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-050-quan:line050","text":"孫亮全夫人，全尚女也。（尚）從祖母公主愛之，每進見輒與俱。及潘夫人母子有寵，全主自以與孫和母有隙，乃勸權為潘氏男亮納夫人，亮遂為嗣。夫人立為皇后，以尚為城門校尉，封都亭侯，代滕胤為太常、衛將軍，進封永平侯，錄尚書事。時全氏侯有五人，並典兵馬。其餘為侍郎、騎都尉，宿衛左右，自吳興，外戚貴盛莫及。及魏大將諸葛誕以壽春來附，而全懌、全端、全禕、全儀等並因此際降魏。全熙謀洩見殺，由是諸全衰弱。會孫綝廢亮為會稽王，後又黜為候官侯。夫人隨之國，居候官，尚將家屬徙零陵，追見殺。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-050-quan:line050:m0001","start":1,"end":2,"surface":"亮","kind":"person","person_id":"hqp_o1w_ihy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0002","start":2,"end":5,"surface":"全夫人","kind":"person","person_id":"vl3_bta_0h1_A","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0007","start":7,"end":8,"surface":"尚","kind":"person","person_id":"vl3_bta_0h1","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-050-quan:line050:m0012","start":12,"end":13,"surface":"尚","kind":"person","person_id":"vl3_bta_0h1","