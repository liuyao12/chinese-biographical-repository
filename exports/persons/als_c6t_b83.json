p007:m0083","surface":"張昌","start":83,"end":85,"person_id":"3sv_fgo_jtc","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p007:m0088","surface":"陳敏","start":88,"end":90,"person_id":"kok_m7n_tux","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p007:m0113","surface":"王如","start":113,"end":115,"person_id":"als_c6t_b83","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p007:m0118","surface":"杜弢","start":118,"end":120,"person_id":"7dv_udy_955","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-066-taokan:p007:m0217","surface":"杜弢","start":217,"end":219,"person_id":"7dv_udy_955","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-066-taokan","book_id":"b-jinshu-066","work_id":"w-jinshu","source_id":"s-jinshu-066-taokan-ws1527632"},{"id":"c-jinshu-070-biandun:p002","text":"敦弱冠仕州郡，辟司空府，稍遷太子舍人、尚書郎，朝士多稱之。東海王越聞，召以爲主簿。王彌逼洛，敦及胡毋輔之勸越擊王彌，而王衍、潘滔共執不聽，敦庭爭苦至，眾咸壯之。出補汝南內史。元帝之爲鎮東，請爲軍諮祭酒，不就。征南將軍山簡以爲司馬。尋而王如、杜曾相繼爲亂，簡乃使敦監沔北七郡軍事、振威將軍、領江夏相，戍夏口。敦攻討沔中皆平。既而杜弢寇湘中，加敦征討大都督。伐弢有功，賜爵安陵亭侯。鎮東大將軍王敦請爲軍司。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":93,"last_line":93,"raw_start":9587,"raw_end":9795,"raw_character_offsets":[9594,9595,9596,9597,9598,9599,9600,9601,9602,9603,9604,9605,9606,9607,9608,9609,9610,9611,9612,9613,9614,9615,9616,9617,9618,9619,9620,9621,9622,9623,9624,9625,9626,9627,9628,9629,9630,9631,9632,9633,9634,9635,9636,9637,9638,9639,9640,9641,9642,9643,9644,9645,9646,9647,9648,9649,9650,9651,9652,9653,9654,9655,9656,9657,9658,9659,9660,9661,9662,9663,9664,9665,9666,9667,9668,9669,9670,9671,9672,9673,9674,9675,9676,9677,9678,9679,9680,9681,9682,9683,9684,9685,9686,9687,9688,9689,9690,9691,9692,9693,9694,9695,9696,9697,9698,9699,9700,9701,9702,9703,9704,9705,9706,9707,9708,9709,9710,9711,9712,9713,9714,9715,9716,9717,9718,9719,9720,9721,9722,9723,9724,9725,9726,9727,9728,9729,9730,9731,9732,9733,9734,9735,9736,9737,9738