":["離婁"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p014","quote":"刓方以為圜兮，常度未替；易初本由兮，君子所鄙。章畫職墨兮，前度未改；內直質重兮，大人所盛。巧匠不斲兮，孰察其揆正？玄文幽處兮，矇謂之不章；離婁微睇兮，瞽以為無明。變白而為黑兮，倒上以為下。鳳皇在笯兮，雞雉翔舞。同糅玉石兮，一而相量。夫黨人之鄙妒兮，羌不知吾所臧。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p014","text":"刓方以為圜兮，常度未替；易初本由兮，君子所鄙。章畫職墨兮，前度未改；內直質重兮，大人所盛。巧匠不斲兮，孰察其揆正？玄文幽處兮，矇謂之不章；離婁微睇兮，瞽以為無明。變白而為黑兮，倒上以為下。鳳皇在笯兮，雞雉翔舞。同糅玉石兮，一而相量。夫黨人之鄙妒兮，羌不知吾所臧。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m014-0018","start":18,"end":20,"surface":"君子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m014-0040","start":40,"end":42,"surface":"大人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m014-0045","start":45,"end":47,"surface":"巧匠","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"},{"id":"c-shiji-084-qujia:m014-0069","start":69,"end":71,"surface":"離婁","kind":"person","person_id":"wfj_i4s_mq5","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m014-0117","start":117,"end":119,"surface":"黨人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛稱或未定指代保持未解。"}],"chapter_id":"c-shiji-084-qujia","book_id":"b-shiji-084","work_id":"w-shiji","source_id":"s-shiji-084-qujia"}],"sources":[{"chapter_id":"c-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","source_id":"s-shiji-084-qujia","source":{"title":"史記／卷084","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷084","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷084&oldid=1568305","revision_id":1568305,"accessed_on":"2026-10-09","extent":"33段正文，屈原、懷沙、賈生及篇末評論；索隱述贊另層待收。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铦":"銛","鸮":"鴞"},"editorial_readings":[{"p