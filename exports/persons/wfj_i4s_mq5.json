e_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-027-luchui-complete-ws1511478","s-shiji-084-qujia"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-liangshu-027-luchui-complete:p004:m0465","start":465,"end":467,"surface":"離婁","kind":"person","person_id":"wfj_i4s_mq5","status":"contextual_provisional","paragraph_id":"c-liangshu-027-luchui-complete:p004","chapter_id":"c-liangshu-027-luchui-complete"},{"id":"c-shiji-084-qujia:m014-0069","start":69,"end":71,"surface":"離婁","kind":"person","person_id":"wfj_i4s_mq5","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p014","chapter_id":"c-shiji-084-qujia"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-018","person_id":"wfj_i4s_mq5","scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","rationale":"依引古原稱與賈生名誼、吳廷尉吳公的同段承接暫定；絳灌短稱未補姓名，泛稱與賦中代詞尚待核定。","reviewer":"Codex（AI 代理）","surfaces":["離婁"],"evidence":[{"paragraph_id":"c-shiji-084-qujia:p014","quote":"刓方以為圜兮，常度未替；易初本由兮，君子所鄙。章畫職墨兮，前度未改；內直質重兮，大人所盛。巧匠不斲兮，孰察其揆正？玄文幽處兮，矇謂之不章；離婁微睇兮，瞽以為無明。變白而為黑兮，倒上以為下。鳳皇在笯兮，雞雉翔舞。同糅玉石兮，一而相量。夫黨人之鄙妒兮，羌不知吾所臧。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-027-luchui-complete:p004","text":"「信偉人之世篤，本侯服於陸鄉。緬風流與道素，襲袞衣與繡裳。還伊人而世載，並三駿而龍光。過龍津而一息，望鳳條而曾翔。彼白玉之雖潔，此幽蘭之信芳。思在物而取譬，非鬥斗之能量。匹聳峙於東岳，比凝厲於秋霜。不一飯以妄過，每三錢以投渭。匪蒙袂之敢嗟，豈溝壑之能衣。旣蘊藉其有餘，又淡然而無味。得意同乎卷懷，違方似乎仗氣。類平叔而靡雕，似子雲之不樸。冠衆善而貽操，綜羣言而名學。折高、戴於后臺，異鄒、顏乎董幄。采三《詩》於河間，訪九師於淮曲。術兼口傳之書，藝廣鏗鏘之樂。時坐睡而梁懸，裁枝梧而錐握。旣文過而意深，又理勝而辭縟。咨余生之荏苒，迫歲暮而傷情。測徂陰於堂下，聽鳴鐘於洛城。唯忘年之陸子，定一遇於班荊。余獲田蘇之價，爾得海上之名。信落魄而無產，終長對於短生。饑虛表于徐步，逃責顯於疾行。子比我於叔則，又方余於耀卿。心照情交，流言靡惑。萬類暗求，千里懸得。言象可廢，蹄筌自默。居非連棟，行則同車。冬日不足，夏日靡餘。肴核非餌，絲竹豈娛。我未舍駕，子已回輿。中飯相顧，悵然動色。邦壤旣殊，離會莫測。存異山陽之居，沒非要離之側。似膠投漆中，離婁豈能識。」","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":17,"last_line":17,"raw_start":438,"raw_end":910,"raw_character_offsets":[438,439,440,441,442,443,444,445,446,447,448,449,450,451,452,453,454,455,456,457,458,459,460,461,462,463,464,465,466,467,468,469,470,471,472,473,474,475,476,477,478,479,480,481,482,483,484,485,486,487,488,489,490,491,492,493,494,495,496,497,498,499,500,501,502,503,504,505,506,507,508,509,510,511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533,534,535,536,537,538,539,540,541,542,543,544,545,546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567,568,569,570,571,572,573,574,575,576,577,578,579,580,581,582,583,584,585,586,587,588,589,590,591,592,593,594,595,596,597,598,599,600,601,602,603,604,605,606,607,608,609,610,611,612,613,614,615,616,617,618,619,620,621,622,623,624,625,626,627,628,629,630,631,632,633,634,635,636,637,638,639,640,641,642,643,644,645,646,647,648,649,650,651,652,653,654,655,656,657,658,659,660,661,662,663,664,665,666,667,668,669,670,671,672,673,674,675,676,677,678,679,680,681,682,683,684,685,686,687,688,689,690,691,692,693,694,695,696,697,698,699,700,701,702,703,704,705,706,707,708,709,710,711,712,713,714,715,716,717,718,719,720,721,722,723,724,725,726,727,728,729,730,731,732,733,734,735,736,737,738,739,740,741,742,743,744,