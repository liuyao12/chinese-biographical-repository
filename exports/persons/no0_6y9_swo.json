5,"end":17,"surface":"齊使","kind":"person","person_id":"no0_6y9_swo","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p003","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m003-0018","start":18,"end":20,"surface":"齊使","kind":"person","person_id":"no0_6y9_swo","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p003","chapter_id":"c-shiji-065-sun"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji065-006","person_id":"no0_6y9_swo","surfaces":["齊使","齊使者"],"scope":"same_chapter","chapter_ids":["c-shiji-065-sun"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-065-sun:p003","quote":"齊使者如梁，孫臏以刑徒陰見，說齊使。齊使以為奇，竊載與之齊。齊將田忌善而客待之。忌數與齊諸公子馳逐重射。孫子見其馬足不甚相遠，馬有上、中、下、輩。於是孫子謂田忌曰：「君弟重射，臣能令君勝。」田忌信然之，與王及諸公子逐射千金。及臨質，孫子曰：「今以君之下駟與彼上駟，取君上駟與彼中駟，取君中駟與彼下駟。」既馳三輩畢，而田忌一不勝而再勝，卒得王千金。於是忌進孫子於威王。威王問兵法，遂以為師。"}],"rationale":"依明示姓名、局部短稱及敘事範圍暫接；孫子在闔廬試兵指孫武，在孫臏龐涓敘事指臏。魏相田文不接孟嘗君，未名與公主指代保留待核，故事及史實確證分開，不補姓名或闕代。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-065-sun:p003","text":"齊使者如梁，孫臏以刑徒陰見，說齊使。齊使以為奇，竊載與之齊。齊將田忌善而客待之。忌數與齊諸公子馳逐重射。孫子見其馬足不甚相遠，馬有上、中、下、輩。於是孫子謂田忌曰：「君弟重射，臣能令君勝。」田忌信然之，與王及諸公子逐射千金。及臨質，孫子曰：「今以君之下駟與彼上駟，取君上駟與彼中駟，取君中駟與彼下駟。」既馳三輩畢，而田忌一不勝而再勝，卒得王千金。於是忌進孫子於威王。威王問兵法，遂以為師。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-065-sun:m003-0000","start":0,"end":3,"surface":"齊使者","kind":"person","person_id":"no0_6y9_swo","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0006","start":6,"end":8,"surface":"孫臏","kind":"person","person_id":"3jf_ru8_mz9","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0015","start":15,"end":17,"surface":"齊使","kind":"person","person_id":"no0_6y9_swo","status":"contextual_provisional"},{"id":"c-shiji-065-sun:m003-0018","start":18,"end":20,"surface":"齊使","kind":"person","person_id