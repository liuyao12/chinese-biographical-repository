provisional","source_role":"xiao_ziyun","paragraph_id":"c-liangshu-033-wangyun-rendered:p005","chapter_id":"c-liangshu-033-wangyun-rendered"},{"id":"c-zhoushu-041-wangbao-ws2432538:p002:m0034","start":34,"end":37,"surface":"蕭子雲","kind":"person","person_id":"okz_h8f_ji3","status":"contextual_provisional","source_role":"xiaoz y","interpretation_note":"依完整本傳及書信換聲/政權時間的來源角色辨識；不由全域單字、近名或同廟號自動選人。","identity_decision_id":"d-zhou041-xiaoz y","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p002","chapter_id":"c-zhoushu-041-wangbao-ws2432538"},{"id":"c-zhoushu-041-wangbao-ws2432538:p002:m0069","start":69,"end":71,"surface":"子雲","kind":"person","person_id":"okz_h8f_ji3","status":"contextual_provisional","source_role":"xiaoz y","interpretation_note":"依完整本傳及書信換聲/政權時間的來源角色辨識；不由全域單字、近名或同廟號自動選人。","identity_decision_id":"d-zhou041-xiaoz y","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p002","chapter_id":"c-zhoushu-041-wangbao-ws2432538"}],"relations":[],"title_holdings":[{"id":"th-liang033-wangyun-main-031","person_id":"okz_h8f_ji3","title":"國子祭酒","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-033","source_id":"s-liangshu-033-current-rendered-wangyun","chapter_id":"c-liangshu-033-wangyun-rendered","paragraph_id":"c-liangshu-033-wangyun-rendered:p005","quote":"普通元年，以母憂去職。筠有孝性，毀瘠過禮，服闋後，疾廢久之。六年，除尚書吏部郎，遷太子中庶子，領羽林監，又改領步兵。中大通二年，遷司徒左長史。三年，昭明太子薨，敕爲哀策文，復見嗟賞。尋出爲貞威將軍、臨海太守，在郡被訟，不調累年。大同初，起爲雲麾豫章王長史，遷秘書監。五年，除太府卿。明年，遷度支尚書。中大同元年，出爲明威將軍、永嘉太守，以疾固辭，徙爲光祿大夫，俄遷雲騎將軍、司徒左長史。太清二年，侯景寇逼，筠時不入城。明年，太宗卽位，爲太子詹事。筠舊宅先爲賊所焚，乃寓居國子祭酒蕭子雲宅，夜忽有盜攻之，驚懼墜井卒，時年六十九。家人十餘人同遇害。","person_mention_id":"c-liangshu-033-wangyun-rendered:p005:m0008"}],"attestations":[{"id":"th-liang033-wangyun-main-031-1:a001","paragraph_id":"c-liangshu-033-wangyun-rendered:p005","start":235,"end":239,"surface":"國子祭酒","person_mention_id":"c-liangshu-033-wangyun-rendered:p005:m0008","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"來源本句官稱；不由同段紀年擴寫任期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-zhou041-xiaoz y","person_id":"okz_h8f_ji3","surfaces":["蕭子雲","子雲"],"scope":"same_chapter","chapter_ids":["c-zhoushu-041-wangbao-ws2432538"],"status":"contextual_provisional","evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538","chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p002","quote":"襃識量淵通，志懷沉靜。美風儀，善談笑，博覽史傳，尤工屬文。梁國子祭酒蕭子雲，襃之姑夫也，特善草隸。襃少以姻戚，去來其家，遂相模範。俄而名亞子雲，竝見重於世。梁武帝喜其才藝，遂以弟鄱陽王恢之女妻之。起家祕書郎，轉太子舍人，襲爵南昌縣侯。稍遷祕書丞。宣成王大器，簡文帝之冢嫡，即襃之姑子也。于時盛選僚佐，乃以襃為文學。尋遷安成郡守。及侯景渡江，建業擾亂，襃輯寧所部，見稱於時。","mention_ids":["c-zhoushu-041-wangbao-ws2432538:p002:m0034"]}],"rationale":"完整王襃本傳/書信局部角色及同朝時序辨識；來源局部登記不宣稱與外篇同名必異，拒近名/同廟號全域匹配；不補未知親屬或年。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-033-wangyun-rendered:p005","text":"普通元年，以母憂去職。筠有孝性，毀瘠過禮，服闋後，疾廢久之。六年，除尚書吏部郎，遷太子中庶子，領羽林監，又改領步兵。中大通二年，遷司徒左長史。三年，昭明太子薨，敕爲哀策文，復見嗟賞。尋出爲貞威將軍、臨海太守，在郡被訟，不調累年。大同初，起爲雲麾豫章王長史，遷秘書監。五年，除太府卿。明年，遷度支尚書。中大同元年，出爲明威將軍、永嘉太守，以疾固辭，徙爲光祿大夫，俄遷雲騎將軍、司徒左長史。太清二年，侯景寇逼，筠時不入城。明年，太宗卽位，爲太子詹事。筠舊宅先爲賊所焚，乃寓居國子祭酒蕭子雲宅，夜忽有盜攻之，驚懼墜井卒，時年六十九。家人十餘人同遇害。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-liangshu-033-wangyun-rendered:p005:m0001","kind":"person","start":11,"end":12,"surface":"筠","person_id":"7r6_k52_qji_ABAAAAEBDA","status":"contextual_provisional","source_role":"wangyun"},{"id":"c-liangshu-033-wangyun-rendered:p005:m0002","kind":"person","start":74,"end":78,"surface":"昭明太子","person_id":"cav_2xc_9bq_AAE","status":"contextual_provisional","source_role":"zhaoming"},{"id":"c-liangshu-033-wangyun-ren