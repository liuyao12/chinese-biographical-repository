model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-070-ganzhuo:p001:m0027","surface":"述","start":27,"end":28,"person_id":"4e4_hgp_7e8","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-070-ganzhuo:p001","chapter_id":"c-jinshu-070-ganzhuo"}],"relations":[{"id":"a-jin070-ganshu-grandfather","subject_person_id":"csn_tgm_oe7","object_person_id":"4e4_hgp_7e8","predicate":"grandfather","qualifiers":{"source_term":"祖述，仕吳爲尚書"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-070","chapter_id":"c-jinshu-070-ganzhuo","source_id":"s-jinshu-070-ganzhuo-ws2595540","paragraph_id":"c-jinshu-070-ganzhuo:p001","quote":"甘卓字季思，丹楊人，秦丞相茂之後也。曾祖寧，爲吳將。祖述，仕吳爲尚書。父昌，太子太傅。吳平，卓退居自守。郡命主簿、功曹，察孝廉，州舉秀才，爲吳王常侍。討石冰，以功賜爵都亭侯。東海王越引爲參軍，出補離狐令。卓見天下大亂，棄官東歸，前至歷陽，與陳敏相遇。敏甚悅，共圖縱橫之計，遂爲其子景娶卓女，共相結託。會周玘唱義，密使錢廣攻敏弟昶，敏遣卓討廣，頓朱雀橋南。會廣殺昶，玘告丹楊太守顧榮共邀說卓。卓素敬服榮，且以昶死懷懼，良久乃從之。遂詐疾迎女，斷橋，收船南岸，共滅敏，傳首于京都。","subject_person_mention_id":"c-jinshu-070-ganzhuo:p001:m0000","object_person_mention_id":"c-jinshu-070-ganzhuo:p001:m0027"}],"status":"source_attested","interpretation_note":"祖述，吳尚書。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-070-ganzhuo:p001","text":"甘卓字季思，丹楊人，秦丞相茂之後也。曾祖寧，爲吳將。祖述，仕吳爲尚書。父昌，太子太傅。吳平，卓退居自守。郡命主簿、功曹，察孝廉，州舉秀才，爲吳王常侍。討石冰，以功賜爵都亭侯。東海王越引爲參軍，出補離狐令。卓見天下大亂，棄官東歸，前至歷陽，與陳敏相遇。敏甚悅，共圖縱橫之計，遂爲其子景娶卓女，共相結託。會周玘唱義，密使錢廣攻敏弟昶，敏遣卓討廣，頓朱雀橋南。會廣殺昶，玘告丹楊太守顧榮共邀說卓。卓素敬服榮，且以昶死懷懼，良久乃從之。遂詐疾迎女，斷橋，收船南岸，共滅敏，傳首于京都。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":36,"last_line":36,"raw_start":2892,"raw_end":3137,"raw_character_offsets":[2899,29