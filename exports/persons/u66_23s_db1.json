":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin037-near-shijian","person_id":"u66_23s_db1","surname":"石","ming":"鑒","additional_names":[],"chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018","paragraph_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p001","person_mention_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p001:m0208","source_anchor":{"start":208,"end":210,"surface":"石鑒"},"quote":"高密文獻王泰，字子舒，彭城穆王權之弟，魏陽亭侯，補陽翟令，遷扶風太守。武帝受禪，封隴西王，邑三千二百戶，拜遊擊將軍。出為兗州刺史，加鷹揚將軍。遷使持節、都督甯益二州諸軍事、安西將軍，領益州刺史，稱疾不行。轉安北將軍，代兄權督鄴城守事。安西將軍、都督關中事。太康初，入為散騎常侍、前將軍，領鄴城門校尉，以疾去官。後代下邳王晃為尚書左僕射。出為鎮西將軍，領護西戎校尉、假節，代扶風王駿都督關中軍事，以疾還京師。永熙初，代石鑒為司空，尋領太子太保。及楊駿誅，泰領駿營，加侍中，給步兵二千五百人，騎五百匹。泰固辭，乃給千兵百騎。","note":"來源具名原字；氏稱不補本名，所報異文分見數位校記，不加成無資格全域異名。","status":"editorial_provisional","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-037","source_id":"s-jinshu037-gaomi-nanyang-ws2630018"}],"mentions":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p001:m0208","start":208,"end":210,"surface":"石鑒","kind":"person","person_id":"u66_23s_db1","status":"contextual_provisional","source_identity_role":"shijian","identity_reading_ref":"source-evidence/jin037-gaomi-nanyang/identity-readings.json#shijian","paragraph_id":"c-jinshu-037-gaomi-nanyang-ws2630018:p001","chapter_id":"c-jinshu-037-gaomi-nanyang-ws2630018"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-037-gaomi-nanyang-ws2630018:p001","text":"高密文獻王泰，字子舒，彭城穆王權之弟，魏陽亭侯，補陽翟令，遷扶風太守。武帝受禪，封隴西王，邑三千二百戶，拜遊擊將軍。出為兗州刺史，加鷹揚將軍。遷使持節、都督甯益二州諸軍事、安西將軍，領益州刺史，稱疾不行。轉安北將軍，代兄權督鄴城守事。安西將軍、都督關中事。太康初，入為散騎常侍、前將軍，領鄴