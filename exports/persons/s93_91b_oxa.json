inshu-044-zhengmao"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"title_proposals":[{"id":"tp-w044-xumiao-declined","person_id":"s93_91b_oxa","title":"司空","outcome":"not_assumed","proposal_kind":"unassumed_appointment","appointment_stage":"appointment","non_assumption_kind":"did_not_take_up","role_anchor":{"paragraph_id":"c-jinshu-044-zhengmao:line017","start":133,"end":135,"surface":"司空"},"person_mention_id":"c-jinshu-044-zhengmao:line017:m0129","status":"contextual_provisional","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-zhengmao","source_id":"s-jinshu-044-zhengmao","paragraph_id":"c-jinshu-044-zhengmao:line017","quote":"武帝踐阼，進爵為侯。雖寢疾十餘年，而時賢並相推薦。泰始中，詔曰：「光祿密陵侯袤，履行純正，守道沖粹，退有清和之風，進有素絲之節，宜登三階之曜，補袞職之闕。今以袤為司空。」天子臨軒，遣五官中郎將國坦就第拜授。袤前後辭讓，遣息稱上送印綬，至於十數。謂坦曰：「魏以徐景山為司空，吾時為侍中，受詔譬旨。徐公語吾曰：'三公當上應天心，苟非其人，實傷和氣，不敢以垂死之年，累辱朝廷也。'終於不就。遵大雅君子之跡，可不務乎！」固辭，久之見許，以侯就第，拜儀同三司，置舍人官騎，賜床帳簟褥、錢五十萬。","person_mention_id":"c-jinshu-044-zhengmao:line017:m0129"}],"appointment_anchor":{"paragraph_id":"c-jinshu-044-zhengmao:line017","start":128,"end":133,"surface":"以徐景山為"},"non_assumption_anchor":{"paragraph_id":"c-jinshu-044-zhengmao:line017","start":189,"end":191,"surface":"不就"},"interpretation_note":"任命及未就任原詞各有字位，據本段記載。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-liyin:line036:m0115","start":115,"end":117,"surface":"徐邈","kind":"person","person_id":"s93_91b_oxa","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-liyin:line036","chapter_id":"c-jinshu-044-liyin"},{"id":"c-jinshu-044-zhengmao:line017:m0129","start":129,"end":132,"surface":"徐景山","kind":"person","person_id":"s93_91b_oxa","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-zhengmao:line017","chapter_id":"c-jinshu-044-zhengmao"},{"id":"c-jinshu-044-zhengmao:line017:m0147","start":147,"end":149,"surface":"徐公","kind":"person","person_id":"s93_91b_oxa","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-zhengmao:line017","chapter_id":"c-jinshu-044-zhengmao"},{"id":"c-sanguozhi-027-wangchang:appraisal:m0002","start":2,"end":4,"surface":"徐邈","kind":"person","person_id":"s93_91b_oxa","status":"contextual_provisional","interpretation_note":"本卷四傳合評徐邈對應同固定raw19–72完整前傳徐邈字景山、事太祖文帝明帝、嘉平元卒。全native檢索無另一已錄魏徐邈，晉065王珣孝武朝同僚徐邈的時代/人物圈相反，非本卷魏人；不跨同名硬合。","paragraph_id":"c-sanguozhi-027-wangchang:appraisal","chapter_id":"c-sanguozhi-027-wangchang"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-liyin:line036","text":"李胤，字宣伯，遼東襄平人也。祖敏，漢河內太守，去官還鄉里，遼東太守公孫度欲強用之，敏乘輕舟浮滄海，莫知所終。胤父信追求積年，浮海出塞，竟無所見，欲行喪制服，則疑父尚存，情若居喪而不聘娶。後有鄰居故人與其父同年者亡，因行喪制服。燕國徐邈與之同州裏，以不孝莫大於無後，勸使娶妻。既生胤，遂絕房室，恆如居喪禮，不堪其憂，數年而卒。胤既幼孤，母又改行，有識之後，降食哀戚，亦以喪禮自居。又以祖不知存亡，設木主以事之。由是以孝聞。容貌質素，頹然若不足者，而知度沈邃，言必有則。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-liyin:line036:m0000","start":0,"end":2,"surface":"李胤","kind":"person","person_id":"882_bd1_ca9","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-liyin:line036:m0004","start":4,"end":6,"surface":"宣伯","kind":"person","person_id":"882_bd1_ca9","status":"cont