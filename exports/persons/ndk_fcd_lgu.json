:"c-chenshu-013-xunlang-rendered:p002","chapter_id":"c-chenshu-013-xunlang-rendered"},{"id":"c-chenshu-013-xunlang-rendered:p002:m0057","kind":"pronoun","person_id":"ndk_fcd_lgu","start":179,"end":180,"surface":"之","status":"contextual_provisional","interpretation_note":"朗遣范寶勝及弟曉領兵助前句東討的王僧辯。","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","chapter_id":"c-chenshu-013-xunlang-rendered"},{"id":"c-zhoushu-041-wangbao-ws2432538:p003:m0040","start":40,"end":43,"surface":"王僧辯","kind":"person","person_id":"ndk_fcd_lgu","status":"contextual_provisional","source_role":"wangsengbian","interpretation_note":"依完整本傳及書信換聲/政權時間的來源角色辨識；不由全域單字、近名或同廟號自動選人。","identity_decision_id":"d-zhou041-wangsengbian","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p003","chapter_id":"c-zhoushu-041-wangbao-ws2432538"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-chenshu013-wangsengbian","person_id":"ndk_fcd_lgu","scope":"cross_chapter","chapter_ids":["c-chenshu-013-xunlang-rendered","c-zhoushu-041-wangbao-ws2432538"],"surfaces":["王僧辯"],"status":"contextual_provisional","rationale":"本單元政權、稱謂、姓名與現役完整原段相容；簡文帝限定梁而非晉。","evidence":[{"work_id":"w-chenshu","book_id":"b-chenshu-013","chapter_id":"c-chenshu-013-xunlang-rendered","source_id":"s-chenshu-013-ws1511906-rendered-xunlang","paragraph_id":"c-chenshu-013-xunlang-rendered:p002","quote":"朗少慷慨，有將帥大略，起家梁廬陵王行參軍。侯景之亂，朗招率徒旅，據巢湖閒，無所屬。臺城陷後，簡文帝密詔授朗雲麾將軍、豫州刺史，令與外藩討景。景使儀同宋子仙、任約等頻往征之，朗據山立砦自守，子仙不能克。時京師大饑，百姓皆於江外就食，朗更招致部曲，解衣推食，以相賑贍，眾至數萬人。侯景敗於巴陵，朗出自濡須截景，破其後軍。王僧辯東討，朗遣其將范寶勝及弟曉領兵二千助之。侯景平後，又別破齊將郭元建於踟躕山。梁承聖二年，率部曲萬餘家濟江，入宣城郡界立頓。梁元帝授朗持節、通直散騎常侍、安南將軍、都督南兗州諸軍事、南兗州刺史。未行而荊州陷。","person_mention_id":"c-chenshu-013-xunlang-rendered:p002:m0020"},{"work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538","chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p003","quote":"梁元帝承制，轉智武將軍、南平內史。及嗣位於江陵，欲待襃以不次之位。襃時猶在郡，敕王僧辯以禮發遣。襃乃將家西上。元帝與襃有舊，相得甚歡。拜侍中，累遷吏部尚書、左僕射。襃既世冑名家，文學優贍，當時咸相推挹，故旬月之間，位升端右。寵遇日隆，而襃愈自謙虛，不以位地矜人，時論稱之。","person_mention_id":"c-zhoushu-041-wangbao-ws2432538:p003:m0040"}],"reviewer":"Codex（AI代理）","human_reviewed":false},{"id":"d-zhou041-wangsengbian","person_id":"ndk_fcd_lgu","surfaces":["王僧辯"],"scope":"same_chapter","chapter_ids":["c-zhoushu-041-wangbao-ws2432538"],"status":"contextual_provisional","evidence":[{"work_id":"w-zhoushu","book_id":"b-zhoushu-041","source_id":"s-zhoushu041-ws2432538","chapter_id":"c-zhoushu-041-wangbao-ws2432538","paragraph_id":"c-zhoushu-041-wangbao-ws2432538:p003","quote":"梁元帝承制，轉智武將軍、南平內史。及嗣位於江陵，欲待襃以不次之位。襃時猶在郡，敕王僧辯以禮發遣。襃乃將家西上。元帝與襃有舊，相得甚歡。拜侍中，累遷吏部尚書、左僕射。襃既世冑名家，文學優贍，當時咸相推挹，故旬月之間，位升端右。寵遇日隆，而襃愈自謙虛，不以位地矜人，時論稱之。","mention_ids":["c-zhoushu-041-wangbao-ws2432538:p003:m0040"]}],"rationale":"完整王襃本傳/書信局部角色及同朝時序辨識；來源局部登記不宣稱與外篇同名必異，拒近名/同廟號全域匹配；不補未知親屬或年。","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-chenshu-013-xunlang-rendered:p002","text":"朗少慷慨，有將帥大略，起家梁廬陵王行參軍。侯景之亂，朗招率徒旅，據巢湖閒，無所屬。臺城陷後，簡文帝密詔授朗雲麾將軍、豫州刺史，令與外藩討景。景使儀同宋子仙、任約等頻往征之，朗據山立砦自守，子仙不能克。時京師大饑，百姓皆於江外就食，朗更招致部曲，解衣推食，以相賑贍，眾至數萬人。侯景敗於巴陵，朗出自濡須截景，破其後軍。王僧辯東討，朗遣其將范寶勝及弟曉領兵二千助之。侯景平後，又別破齊將郭元建於踟躕山。梁承聖二年，率部曲萬餘家濟江，入宣城郡界立頓。梁元帝授朗持節、通直散騎常侍、安南將軍、都督南兗州諸軍事、南兗州刺史。未行而荊州陷。","annotation_status":"in_progress","mentions":[{"id":"c-chenshu-013-xunlang-rendered:p002:m0004","kind":"person","person_id":"vh4_rsb_xo3_AA","start":0,"end":1,"surface":"朗","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p002:m0005","kind":"person","person_id":"cav_2xc_9bq_AAD","start":14,"end":17,"surface":"廬陵王","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p002:m0006","kind":"person","person_id":"bzc_sjc_rgu","start":21,"end":23,"surface":"侯景","status":"contextual_provisional"},{"id":"c-chenshu-013-xunlang-rendered:p002:m0007","kind":"person","person_id":"vh4_rsb_xo3_AA","start":26,"end":27,"surface":"朗","s