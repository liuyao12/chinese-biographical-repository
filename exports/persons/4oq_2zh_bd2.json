":"c-shiji-057-zhou:m002-0292","start":292,"end":296,"surface":"南陽守齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional","paragraph_id":"c-shiji-057-zhou:p002","chapter_id":"c-shiji-057-zhou"},{"id":"c-shiji-095-fankuang:m002-0298","start":298,"end":299,"surface":"齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p002","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m022-0126","start":126,"end":127,"surface":"齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p022","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[{"id":"th-shiji008-006","person_id":"4oq_2zh_bd2","title":"殷侯","kind":"noble_rank","mode":"grant","status":"source_attested","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p020","quote":"乃以宛守為殷侯"}],"attestations":[{"id":"th-shiji008-006:a001","paragraph_id":"c-shiji-008-gaozu:p020","start":353,"end":355,"surface":"殷侯","person_mention_id":"c-shiji-008-gaozu:m020-0350","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p020","quote":"乃以宛守為殷侯"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"有據事件與用稱分開；日期未換算，未知端點不等於無限延伸，不以死亡或首次用稱推造起訖。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji008-057","person_id":"4oq_2zh_bd2","title":"南陽守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p020","quote":"當是時，趙別將司馬卬方欲渡河入關，沛公乃北攻平陰，絕河津。南，戰雒陽東，軍不利，還至陽城，收軍中馬騎，與南陽守齮戰犨東，破之。略南陽郡，南陽守齮走，保城守宛。沛公引兵過而西。張良諫曰：「沛公雖欲急入關，秦兵尚眾，距險。今不下宛，宛從後擊，彊秦在前，此危道也。」於是沛公乃夜引兵從他道還，更旗幟，黎明，圍宛城三匝。南陽守欲自剄。其舍人陳恢曰：「死未晚也。」乃踰城見沛公，曰：「臣聞足下約，先入咸陽者王之。今足下留守宛。宛，大郡之都也，連城數十，人民眾，積蓄多，吏人自以為降必死，故皆堅守乘城。今足下盡日止攻，士死傷者必多；引兵去宛，宛必隨足下後：足下前則失咸陽之約，後又有彊宛之患。為足下計，莫若約降，封其守，因使止守，引其甲卒與之西。諸城未下者，聞聲爭開門而待，足下通行無所累。」沛公曰：「善。」乃以宛守為殷侯，封陳恢千戶。引兵西，無不下者。至丹水，高武侯鰓、襄侯王陵降西陵。還攻胡陽，遇番君別將梅鋗，與皆，降析、酈。遣魏人甯昌使秦，使者未來。是時章邯已以軍降項羽於趙矣。"}],"attestations":[{"id":"th-shiji008-057:a001","paragraph_id":"c-shiji-008-gaozu:p020","start":52,"end":55,"surface":"南陽守","person_mention_id":"c-shiji-008-gaozu:m020-0052","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文明示官爵用稱；起點未知，死亡不自動當官爵終點。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"th-shiji054-015","person_id":"4oq_2zh_bd2","title":"南陽守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p003","quote":"其後從攻東郡尉軍，破之成武南。擊王離軍成陽南，復攻之杠裏，大破之。追北，西至開封，擊趙賁軍，破之，圍趙賁開封城中。西擊將楊熊軍於曲遇，破之，虜秦司馬及御史各一人。遷為執珪。從攻陽武，下軒轅、緱氏，絕河津，還擊趙賁軍尸北，破之。從南攻犨，與南陽守齮戰陽城郭東，陷陳，取宛，虜齮，盡定南陽郡。從西攻武關、峣關，取之。前攻秦軍藍田南，又夜擊其北，秦軍大破，遂至咸陽，滅秦。"}],"attestations":[{"id":"th-shiji054-015:a001","paragraph_id":"c-shiji-054-cao:p003","start":119,"end":122,"surface":"南陽守","person_mention_id":"c-shiji-054-cao:m003-0119","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"明示授予、改官、爵秩、任事與追稱分開，原校勘字不改作定論；任期不由首見、死亡或後嗣承爵自動推端點。執帛、執珪、戚公等性質待制度與版本覆核；食邑調整不自造另一爵名。","reviewer":"Codex（AI 代理）"},{"id":"th-shiji057-009","person_id":"4oq_2zh_bd2","title":"南陽守","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。"}],"attestations":[{"id":"th-shiji057-009:a001","paragraph_id":"c-shiji-057-zhou:p002","start":292,"end":295,"surface":"南陽守","person_mention_id":"c-shiji-057-zhou:m002-0292","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官、爵秩、追稱、承爵與一般用稱分存；相對年數按原段，不換算公曆或推定所有官爵同時終止。未知官員姓名與制度性質不補。","reviewer":"Codex（AI 代理）"}],"address_assertions":[{"id":"pa-shiji008-058","person_id":"4oq_2zh_bd2","relation":"residence","place":{"source_name":"宛","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p020","quote":"當是時，趙別將司馬卬方欲渡河入關，沛公乃北攻平陰，絕河津。南，戰雒陽東，軍不利，還至陽城，收軍中馬騎，與南陽守齮戰犨東，破之。略南陽郡，南陽守齮走，保城守宛。沛公引兵過而西。張良諫曰：「沛公雖欲急入關，秦兵尚眾，距險。今不下宛，宛從後擊，彊秦在前，此危道也。」於是沛公乃夜引兵從他道還，更旗幟，黎明，圍宛城三匝。南陽守欲自剄。其舍人陳恢曰：「死未晚也。」乃踰城見沛公，曰：「臣聞足下約，先入咸陽者王之。今足下留守宛。宛，大郡之都也，連城數十，人民眾，積蓄多，吏人自以為降必死，故皆堅守乘城。今足下盡日止攻，士死傷者必多；引兵去宛，宛必隨足下後：足下前則失咸陽之約，後又有彊宛之患。為足下計，莫若約降，封其守，因使止守，引其甲卒與之西。諸城未下者，聞聲爭開門而待，足下通行無所累。」沛公曰：「善。」乃以宛守為殷侯，封陳恢千戶。引兵西，無不下者。至丹水，高武侯鰓、襄侯王陵降西陵。還攻胡陽，遇番君別將梅鋗，與皆，降析、酈。遣魏人甯昌使秦，使者未來。是時章邯已以軍降項羽於趙矣。","person_mention_id":"c-shiji-008-gaozu:m020-0052"}],"source_term":"保城守宛","interpretation_note":"南陽守守城處；欲自剄未執行，不記死亡。","reviewer":"Codex（AI 代理）","human_reviewed":false},{"id":"pa-shiji054-087","person_id":"4oq_2zh_bd2","relation":"residence","place":{"source_name":"陽城郭東","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p003","quote":"其後從攻東郡尉軍，破之成武南。擊王離軍成陽南，復攻之杠裏，大破之。追北，西至開封，擊趙賁軍，破之，圍趙賁開封城中。西擊將楊熊軍於曲遇，破之，虜秦司馬及御史各一人。遷為執珪。從攻陽武，下軒轅、緱氏，絕河津，還擊趙賁軍尸北，破之。從南攻犨，與南陽守齮戰陽城郭東，陷陳，取宛，虜齮，盡定南陽郡。從西攻武關、峣關，取之。前攻秦軍藍田南，又夜擊其北，秦軍大破，遂至咸陽，滅秦。","person_mention_id":"c-shiji-054-cao:m003-0119"}],"source_term":"與南陽守齮戰陽城郭東","interpretation_note":"齮與曹參交戰地原語，未補永久住所。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[{"id":"shiji-016-t1-r025-c06-m000","start":5,"end":9,"surface":"南陽守齮","person_id":"4oq_2zh_bd2","status":"contextual_provisional","interpretation_note":"依本格國別、事件與本篇時間範圍核讀的完整名字暫定同指；非全域字串配對，省稱與世襲稱號另行核讀。","table_id":"shiji-016","table_fragment_id":"shiji-016-digital-table-1","table_row_id":"shiji-016-t1-r025","table_cell_id":"shiji-016-t1-r025-c06","work_id":"w-shiji","book_id":"b-shiji-016","chapter_id":"table-chapter-shiji-016","source_id":"table-witness-shiji-016","source_revision":"2607007","kind":"table_person_mention","quote":"二十三。攻南陽守齮，破之陽城郭東。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-064","person_id":"4oq_2zh_bd2","surfaces":["南陽守","南陽守齮","宛守"],"scope":"same_chapter","chapter_ids":["c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-008-gaozu:p020","quote":"當是時，趙別將司馬卬方欲渡河入關，沛公乃北攻平陰，絕河津。南，戰雒陽東，軍不利，還至陽城，收軍中馬騎，與南陽守齮戰犨東，破之。略南陽郡，南陽守齮走，保城守宛。沛公引兵過而西。張良諫曰：「沛公雖欲急入關，秦兵尚眾，距險。今不下宛，宛從後擊，彊秦在前，此危道也。」於是沛公乃夜引兵從他道還，更旗幟，黎明，圍宛城三匝。南陽守欲自剄。其舍人陳恢曰：「死未晚也。」乃踰城見沛公，曰：「臣聞足下約，先入咸陽者王之。今足下留守宛。宛，大郡之都也，連城數十，人民眾，積蓄多，吏人自以為降必死，故皆堅守乘城。今足下盡日止攻，士死傷者必多；引兵去宛，宛必隨足下後：足下前則失咸陽之約，後又有彊宛之患。為足下計，莫若約降，封其守，因使止守，引其甲卒與之西。諸城未下者，聞聲爭開門而待，足下通行無所累。」沛公曰：「善。」乃以宛守為殷侯，封陳恢千戶。引兵西，無不下者。至丹水，高武侯鰓、襄侯王陵降西陵。還攻胡陽，遇番君別將梅鋗，與皆，降析、酈。遣魏人甯昌使秦，使者未來。是時章邯已以軍降項羽於趙矣。"}],"rationale":"第20段南陽守齮保宛，後省稱南陽守、宛守並封殷侯，同段行動相接，未補姓氏。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji054-014","person_id":"4oq_2zh_bd2","surfaces":["南陽守齮","齮"],"scope":"same_chapter","chapter_ids":["c-shiji-054-cao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-054-cao:p003","quote":"其後從攻東郡尉軍，破之成武南。擊王離軍成陽南，復攻之杠裏，大破之。追北，西至開封，擊趙賁軍，破之，圍趙賁開封城中。西擊將楊熊軍於曲遇，破之，虜秦司馬及御史各一人。遷為執珪。從攻陽武，下軒轅、緱氏，絕河津，還擊趙賁軍尸北，破之。從南攻犨，與南陽守齮戰陽城郭東，陷陳，取宛，虜齮，盡定南陽郡。從西攻武關、峣關，取之。前攻秦軍藍田南，又夜擊其北，秦軍大破，遂至咸陽，滅秦。"}],"rationale":"依本篇明示姓名與局部軍事、任官及子嗣敘事暫接；曹氏時、襄不按單字全域配對。未名者不補姓名，秦司馬夷字待底本核定，田既與田溉不擅同指。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji057-012","person_id":"4oq_2zh_bd2","surfaces":["南陽守齮"],"scope":"same_chapter","chapter_ids":["c-shiji-057-zhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。"}],"rationale":"按明示姓名、軍事近接、父子承爵與局部皇帝敘事暫接。周勃和勝之的絳侯分開，亞夫條侯與平曲支不混；代地韓信依韓王信近接而不接淮陰侯。未名人物、單名官員不補姓，校勘字不作定本，相術預言不作史實已驗。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji095-013","person_id":"4oq_2zh_bd2","surfaces":["齮"],"scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-095-fankuang:p002","quote":"初從高祖起豐，攻下沛。高祖為沛公，以噲為舍人。從攻胡陵、方與，還守豐，擊泗水監豐下，破之。復東定沛，破泗水守薛西。與司馬夷戰碭東，卻敵，斬首十五級，賜爵國大夫。常從，沛公擊章邯軍濮陽，攻城先登，斬首二十三級，賜爵列大夫。復常從，從攻城陽，先登。下戶牖，破李由軍，斬首十六級，賜上閒爵。從攻圍東郡守尉於成武，卻敵，斬首十四級，捕虜十一人，賜爵五大夫。從擊秦軍，出亳南。河閒守軍於杠里，破之。擊破趙賁軍開封北，以卻敵先登，斬候一人，首六十八級，捕虜二十七人，賜爵卿。從攻破楊熊軍於曲遇。攻宛陵，先登，斬首八級，捕虜四十四人，賜爵封號賢成君。從攻長社、轘轅，絕河津，東攻秦軍於尸，南攻秦軍於犨。破南陽守齮於陽城。東攻宛城，先登。西至酈，以卻敵，斬首二十四級，捕虜四十人，賜重封。攻武關，至霸上，斬都尉一人，首十級，捕虜百四十六人，降卒二千九百人。"},{"paragraph_id":"c-shiji-095-fankuang:p022","quote":"潁陰侯灌嬰者，睢陽販繒者也。高祖之為沛公，略地至雍丘下，章邯敗殺項梁，而沛公還軍於碭，嬰初以中涓從擊破東郡尉於成武及秦軍於扛裏，疾鬬，賜爵七大夫。從攻秦軍亳南、開封、曲遇，戰疾力，賜爵執帛，號宣陵君。從攻陽武以西至雒陽，破秦軍尸北，北絕河津，南破南陽守齮陽城東，遂定南陽郡。西入武關，戰於藍田，疾力，至霸上，賜爵執珪，號昌文君。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji095-military-nanyang-yi","person_ids":["4oq_2zh_bd2"],"canonical_person_id":"4oq_2zh_bd2","scope":"cross_chapter","chapter_ids":["c-shiji-095-fankuang","c-shiji-054-cao","c-shiji-057-zhou","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p002","quote":"初從高祖起豐，攻下沛。高祖為沛公，以噲為舍人。從攻胡陵、方與，還守豐，擊泗水監豐下，破之。復東定沛，破泗水守薛西。與司馬夷戰碭東，卻敵，斬首十五級，賜爵國大夫。常從，沛公擊章邯軍濮陽，攻城先登，斬首二十三級，賜爵列大夫。復常從，從攻城陽，先登。下戶牖，破李由軍，斬首十六級，賜上閒爵。從攻圍東郡守尉於成武，卻敵，斬首十四級，捕虜十一人，賜爵五大夫。從擊秦軍，出亳南。河閒守軍於杠里，破之。擊破趙賁軍開封北，以卻敵先登，斬候一人，首六十八級，捕虜二十七人，賜爵卿。從攻破楊熊軍於曲遇。攻宛陵，先登，斬首八級，捕虜四十四人，賜爵封號賢成君。從攻長社、轘轅，絕河津，東攻秦軍於尸，南攻秦軍於犨。破南陽守齮於陽城。東攻宛城，先登。西至酈，以卻敵，斬首二十四級，捕虜四十人，賜重封。攻武關，至霸上，斬都尉一人，首十級，捕虜百四十六人，降卒二千九百人。","mention_ids":["c-shiji-095-fankuang:m002-0298"]},{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p022","quote":"潁陰侯灌嬰者，睢陽販繒者也。高祖之為沛公，略地至雍丘下，章邯敗殺項梁，而沛公還軍於碭，嬰初以中涓從擊破東郡尉於成武及秦軍於扛裏，疾鬬，賜爵七大夫。從攻秦軍亳南、開封、曲遇，戰疾力，賜爵執帛，號宣陵君。從攻陽武以西至雒陽，破秦軍尸北，北絕河津，南破南陽守齮陽城東，遂定南陽郡。西入武關，戰於藍田，疾力，至霸上，賜爵執珪，號昌文君。","mention_ids":["c-shiji-095-fankuang:m022-0126"]},{"chapter_id":"c-shiji-054-cao","source_id":"s-shiji-054-cao","paragraph_id":"c-shiji-054-cao:p003","quote":"其後從攻東郡尉軍，破之成武南。擊王離軍成陽南，復攻之杠裏，大破之。追北，西至開封，擊趙賁軍，破之，圍趙賁開封城中。西擊將楊熊軍於曲遇，破之，虜秦司馬及御史各一人。遷為執珪。從攻陽武，下軒轅、緱氏，絕河津，還擊趙賁軍尸北，破之。從南攻犨，與南陽守齮戰陽城郭東，陷陳，取宛，虜齮，盡定南陽郡。從西攻武關、峣關，取之。前攻秦軍藍田南，又夜擊其北，秦軍大破，遂至咸陽，滅秦。","mention_ids":["c-shiji-054-cao:m003-0119","c-shiji-054-cao:m003-0136"]},{"chapter_id":"c-shiji-057-zhou","source_id":"s-shiji-057-zhou","paragraph_id":"c-shiji-057-zhou:p002","quote":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。","mention_ids":["c-shiji-057-zhou:m002-0292"]},{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p020","quote":"當是時，趙別將司馬卬方欲渡河入關，沛公乃北攻平陰，絕河津。南，戰雒陽東，軍不利，還至陽城，收軍中馬騎，與南陽守齮戰犨東，破之。略南陽郡，南陽守齮走，保城守宛。沛公引兵過而西。張良諫曰：「沛公雖欲急入關，秦兵尚眾，距險。今不下宛，宛從後擊，彊秦在前，此危道也。」於是沛公乃夜引兵從他道還，更旗幟，黎明，圍宛城三匝。南陽守欲自剄。其舍人陳恢曰：「死未晚也。」乃踰城見沛公，曰：「臣聞足下約，先入咸陽者王之。今足下留守宛。宛，大郡之都也，連城數十，人民眾，積蓄多，吏人自以為降必死，故皆堅守乘城。今足下盡日止攻，士死傷者必多；引兵去宛，宛必隨足下後：足下前則失咸陽之約，後又有彊宛之患。為足下計，莫若約降，封其守，因使止守，引其甲卒與之西。諸城未下者，聞聲爭開門而待，足下通行無所累。」沛公曰：「善。」乃以宛守為殷侯，封陳恢千戶。引兵西，無不下者。至丹水，高武侯鰓、襄侯王陵降西陵。還攻胡陽，遇番君別將梅鋗，與皆，降析、酈。遣魏人甯昌使秦，使者未來。是時章邯已以軍降項羽於趙矣。","mention_ids":["c-shiji-008-gaozu:m020-0052","c-shiji-008-gaozu:m020-0068","c-shiji-008-gaozu:m020-0156","c-shiji-008-gaozu:m020-0350"]}],"rationale":"陽城、宛的南陽守齮與沛公西征同一事件。保留正文「南陽守」與名齮，不能因字相同接成王齮或桓齮；原文欲自剄不是已自殺。 原文與錨點不改，同書跨篇不當獨立見證；未核書影。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-008-gaozu:p020","text":"當是時，趙別將司馬卬方欲渡河入關，沛公乃北攻平陰，絕河津。南，戰雒陽東，軍不利，還至陽城，收軍中馬騎，與南陽守齮戰犨東，破之。略南陽郡，南陽守齮走，保城守宛。沛公引兵過而西。張良諫曰：「沛公雖欲急入關，秦兵尚眾，距險。今不下宛，宛從後擊，彊秦在前，此危道也。」於是沛公乃夜引兵從他道還，更旗幟，黎明，圍宛城三匝。南陽守欲自剄。其舍人陳恢曰：「死未晚也。」乃踰城見沛公，曰：「臣聞足下約，先入咸陽者王之。今足下留守宛。宛，大郡之都也，連城數十，人民眾，積蓄多，吏人自以為降必死，故皆堅守乘城。今足下盡日止攻，士死傷者必多；引兵去宛，宛必隨足下後：足下前則失咸陽之約，後又有彊宛之患。為足下計，莫若約降，封其守，因使止守，引其甲卒與之西。諸城未下者，聞聲爭開門而待，足下通行無所累。」沛公曰：「善。」乃以宛守為殷侯，封陳恢千戶。引兵西，無不下者。至丹水，高武侯鰓、襄侯王陵降西陵。還攻胡陽，遇番君別將梅鋗，與皆，降析、酈。遣魏人甯昌使秦，使者未來。是時章邯已以軍降項羽於趙矣。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m020-0007","start":7,"end":10,"surface":"司馬卬","kind":"person","person_id":"ifc_pry_e72","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0017","start":17,"end":19,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0052","start":52,"end":56,"surface":"南陽守齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0068","start":68,"end":72,"surface":"南陽守齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0079","start":79,"end":81,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0087","start":87,"end":89,"surface":"張良","kind":"person","person_id":"ea5_zvr_hlp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0093","start":93,"end":95,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0132","start":132,"end":134,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0156","start":156,"end":159,"surface":"南陽守","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0166","start":166,"end":168,"surface":"陳恢","kind":"person","person_id":"a9f_5ms_y31","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0181","start":181,"end":183,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0340","start":340,"end":342,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0350","start":350,"end":352,"surface":"宛守","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0357","start":357,"end":359,"surface":"陳恢","kind":"person","person_id":"a9f_5ms_y31","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0375","start":375,"end":379,"surface":"高武侯鰓","kind":"person","person_id":"3w5_zp1_0g6","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0382","start":382,"end":384,"surface":"王陵","kind":"person","person_id":"5do_703_rfz","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0394","start":394,"end":396,"surface":"番君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、假稱或同名指代待覆核；不據字串補姓名或實際爵位。"},{"id":"c-shiji-008-gaozu:m020-0398","start":398,"end":400,"surface":"梅鋗","kind":"person","person_id":"un4_kak_hvp","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0412","start":412,"end":414,"surface":"甯昌","kind":"person","person_id":"c8v_5v6_309","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m020-0430","start":430,"end":432,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-054-cao:p003","text":"其後從攻東郡尉軍，破之成武南。擊王離軍成陽南，復攻之杠裏，大破之。追北，西至開封，擊趙賁軍，破之，圍趙賁開封城中。西擊將楊熊軍於曲遇，破之，虜秦司馬及御史各一人。遷為執珪。從攻陽武，下軒轅、緱氏，絕河津，還擊趙賁軍尸北，破之。從南攻犨，與南陽守齮戰陽城郭東，陷陳，取宛，虜齮，盡定南陽郡。從西攻武關、峣關，取之。前攻秦軍藍田南，又夜擊其北，秦軍大破，遂至咸陽，滅秦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-054-cao:m003-0000","start":0,"end":1,"surface":"其","kind":"person","person_id":"37j_16p_7n8","status":"contextual_provisional","note":"其後從攻承接前段曹參軍事行程與爵秩敘事；同段遷為執珪的隱含受授者據此暫接曹參，非最近人名楊熊或南陽守齮。"},{"id":"c-shiji-054-cao:m003-0004","start":4,"end":7,"surface":"東郡尉","kind":"person","person_id":"tup_86k_24c","status":"contextual_provisional","note":"依本段單指官員、各一人或後相對話辨認；未名不補姓名，不與同官稱者全域合併。"},{"id":"c-shiji-054-cao:m003-0016","start":16,"end":18,"surface":"王離","kind":"person","person_id":"d0z_er0_gco","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0042","start":42,"end":44,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0050","start":50,"end":52,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0060","start":60,"end":62,"surface":"楊熊","kind":"person","person_id":"v4m_7yp_xr3","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0071","start":71,"end":74,"surface":"秦司馬","kind":"person","person_id":"12q_720_9mw","status":"contextual_provisional","note":"依本段單指官員、各一人或後相對話辨認；未名不補姓名，不與同官稱者全域合併。"},{"id":"c-shiji-054-cao:m003-0075","start":75,"end":80,"surface":"御史各一人","kind":"person","person_id":"id2_2nb_u2p","status":"contextual_provisional","note":"依本段單指官員、各一人或後相對話辨認；未名不補姓名，不與同官稱者全域合併。"},{"id":"c-shiji-054-cao:m003-0104","start":104,"end":106,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0119","start":119,"end":123,"surface":"南陽守齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"},{"id":"c-shiji-054-cao:m003-0136","start":136,"end":137,"surface":"齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"}],"chapter_id":"c-shiji-054-cao","book_id":"b-shiji-054","work_id":"w-shiji","source_id":"s-shiji-054-cao"},{"id":"c-shiji-057-zhou:p002","text":"高祖之為沛公初起，勃以中涓從攻胡陵，下方與。方與反，與戰，卻適。攻豐。擊秦軍碭東。還軍留及蕭。復攻碭，破之。下下邑，先登。賜爵五大夫。攻蒙、虞，取之。擊章邯車騎，殿。定魏地。攻爰戚、東緡，以往至栗，取之。攻齧桑，先登。擊秦軍阿下，破之。追至濮陽，下甄城。攻都關、定陶，襲取宛朐，得單父令。夜襲取臨濟，攻張，以前至卷，破之。擊李由軍雍丘下。攻開封，先至城下為多。後章邯破殺項梁，沛公與項羽引兵東如碭。自初起沛還至碭，一歲二月。楚懷王封沛公號安武侯，為碭郡長。沛公拜勃為虎賁令，以令從沛公定魏地。攻東郡尉於城武，破之。擊王離軍，破之。攻長社，先登。攻潁陽、緱氏，絕河津。擊趙賁軍尸北。南攻南陽守齮，破武關、峣關。破秦軍於藍田，至咸陽，滅秦。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-057-zhou:m002-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0004","start":4,"end":6,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0009","start":9,"end":10,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0076","start":76,"end":78,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0140","start":140,"end":143,"surface":"單父令","kind":"person","person_id":"8ao_2is_pmk","status":"contextual_provisional","note":"依本段可分辨受得官員、軍事主體或說話者記未名候選，不補姓名；獄吏教策前後同一敘事，末句安知獄吏之貴泛論未強併。"},{"id":"c-shiji-057-zhou:m002-0162","start":162,"end":164,"surface":"李由","kind":"person","person_id":"49g_7az_e4i_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0181","start":181,"end":183,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0185","start":185,"end":187,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0188","start":188,"end":190,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0191","start":191,"end":193,"surface":"項羽","kind":"person","person_id":"qi8_m09_rfs","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0212","start":212,"end":215,"surface":"楚懷王","kind":"person","person_id":"p92_3b3_lai","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0216","start":216,"end":218,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0228","start":228,"end":230,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0231","start":231,"end":232,"surface":"勃","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0240","start":240,"end":242,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0247","start":247,"end":250,"surface":"東郡尉","kind":"person","person_id":"s4f_hyi_z66","status":"contextual_provisional","note":"依本段可分辨受得官員、軍事主體或說話者記未名候選，不補姓名；獄吏教策前後同一敘事，末句安知獄吏之貴泛論未強併。"},{"id":"c-shiji-057-zhou:m002-0258","start":258,"end":260,"surface":"王離","kind":"person","person_id":"pgw_7wx_2g6","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0284","start":284,"end":286,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-057-zhou:m002-0292","start":292,"end":296,"surface":"南陽守齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"}],"chapter_id":"c-shiji-057-zhou","book_id":"b-shiji-057","work_id":"w-shiji","source_id":"s-shiji-057-zhou"},{"id":"c-shiji-095-fankuang:p002","text":"初從高祖起豐，攻下沛。高祖為沛公，以噲為舍人。從攻胡陵、方與，還守豐，擊泗水監豐下，破之。復東定沛，破泗水守薛西。與司馬夷戰碭東，卻敵，斬首十五級，賜爵國大夫。常從，沛公擊章邯軍濮陽，攻城先登，斬首二十三級，賜爵列大夫。復常從，從攻城陽，先登。下戶牖，破李由軍，斬首十六級，賜上閒爵。從攻圍東郡守尉於成武，卻敵，斬首十四級，捕虜十一人，賜爵五大夫。從擊秦軍，出亳南。河閒守軍於杠里，破之。擊破趙賁軍開封北，以卻敵先登，斬候一人，首六十八級，捕虜二十七人，賜爵卿。從攻破楊熊軍於曲遇。攻宛陵，先登，斬首八級，捕虜四十四人，賜爵封號賢成君。從攻長社、轘轅，絕河津，東攻秦軍於尸，南攻秦軍於犨。破南陽守齮於陽城。東攻宛城，先登。西至酈，以卻敵，斬首二十四級，捕虜四十人，賜重封。攻武關，至霸上，斬都尉一人，首十級，捕虜百四十六人，降卒二千九百人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m002-0002","start":2,"end":4,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0011","start":11,"end":13,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0014","start":14,"end":16,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0018","start":18,"end":19,"surface":"噲","kind":"person","person_id":"b1r_inb_fts","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0058","start":58,"end":61,"surface":"司馬夷","kind":"person","person_id":"m8o_g61_go9","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0083","start":83,"end":85,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0086","start":86,"end":88,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0127","start":127,"end":129,"surface":"李由","kind":"person","person_id":"49g_7az_e4i_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0196","start":196,"end":198,"surface":"趙賁","kind":"person","person_id":"bwv_p3h_q1j","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0234","start":234,"end":236,"surface":"楊熊","kind":"person","person_id":"v4m_7yp_xr3","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0298","start":298,"end":299,"surface":"齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p022","text":"潁陰侯灌嬰者，睢陽販繒者也。高祖之為沛公，略地至雍丘下，章邯敗殺項梁，而沛公還軍於碭，嬰初以中涓從擊破東郡尉於成武及秦軍於扛裏，疾鬬，賜爵七大夫。從攻秦軍亳南、開封、曲遇，戰疾力，賜爵執帛，號宣陵君。從攻陽武以西至雒陽，破秦軍尸北，北絕河津，南破南陽守齮陽城東，遂定南陽郡。西入武關，戰於藍田，疾力，至霸上，賜爵執珪，號昌文君。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m022-0003","start":3,"end":5,"surface":"灌嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m022-0014","start":14,"end":16,"surface":"高祖","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m022-0018","start":18,"end":20,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m022-0028","start":28,"end":30,"surface":"章邯","kind":"person","person_id":"4jv_qte_5p4","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m022-0032","start":32,"end":34,"surface":"項梁","kind":"person","person_id":"5xt_rg8_7zs_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m022-0036","start":36,"end":38,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m022-0043","start":43,"end":44,"surface":"嬰","kind":"person","person_id":"sj9_pfu_fwh","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m022-0126","start":126,"end":127,"surface":"齮","kind":"person","person_id":"4oq_2zh_bd2","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"}],"table_passages":[{"id":"shiji-016-t1-r025-c06","column":6,"rowspan":1,"colspan":1,"text":"二十三。攻南陽守齮，破之陽城郭東。","source_row":26,"source_column":7,"printed_page":null,"person_mentions":[{"id":"shiji-016-t1-r025-c06-m000","start":5,"end":9,"surface":"南陽守齮","person_id":"4oq_2zh_bd2","status":"contextual_provisional","interpretation_note":"依本格國別、事件與本篇時間範圍核讀的完整名字暫定同指；非全域字串配對，省稱與世襲稱號另行核讀。"}],"table_id":"shiji-016","table_fragment_id":"shiji-016-digital-table-1","table_row_id":"shiji-016-t1-r025","table_cell_id":"shiji-016-t1-r025-c06","work_id":"w-shiji","book_id":"b-shiji-016","chapter_id":"table-chapter-shiji-016","source_id":"table-witness-shiji-016","source_revision":"2607007","source_header":["公元前","秦","楚","項","趙","齊","漢","燕","魏","韓"],"row_year":null}],"sources":[{"chapter_id":"c-shiji-008-gaozu","work_id":"w-shiji","book_id":"b-shiji-008","source_id":"s-shiji-008-gaozu","source":{"title":"史記／卷008","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷008","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷008&oldid=2440965","revision_id":2440965,"accessed_on":"2026-10-09","extent":"本篇傳世正文91個p區塊，自「高祖，沛豐邑中陽里人」至太史公論贊；不含導覽標題、跨站連結及另署【索隱述贊】的後出文字。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"馕":"饢"},"editorial_readings":[],"extraction_note":"正文91段均為p；前置兩個dd為跨站導覽，不收錄。排除sup註號，保留原有行內校勘符號。","note":"第48、57段馕僅作明示簡繁轉換為饢，詞義與疑讀待核，不逕改為餉或饟。數位轉錄尚未核紙本或影像。"}}},{"chapter_id":"c-shiji-054-cao","work_id":"w-shiji","book_id":"b-shiji-054","source_id":"s-shiji-054-cao","source":{"title":"史記／卷054","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷054","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷054&oldid=14