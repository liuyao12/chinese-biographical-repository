d_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-huayi:line084:m0222","start":222,"end":224,"surface":"韓壽","kind":"person","person_id":"wwi_1cy_1ui","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-huayi:line084","chapter_id":"c-jinshu-044-huayi"}],"relations":[],"title_holdings":[{"id":"th-w044-huayi-21","person_id":"wwi_1cy_1ui","title":"河南尹","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-huayi","source_id":"s-jinshu-044-huayi","paragraph_id":"c-jinshu-044-huayi:line084","quote":"廙棲遲家巷垂十載，教誨子孫，講誦經典。集經書要事，名曰《善文》，行於世。與陳勰共造豬闌於宅側，帝嘗出視之，問其故，左右以實對，帝心憐之。帝后又登陵雲台，望見廙苜蓿園，阡陌甚整，依然感舊。太康初大赦，乃得襲封。久之，拜城門校尉，遷左衛將軍。數年，以為中書監。惠帝即位，加侍中、光祿大夫、尚書令，進爵為公。廙應楊駿召，不時還，有司奏免官。尋遷太子少傅，加散騎常侍，動遵禮典，得傅導之義。後年衰病篤，詔遣太醫療病，進位光祿大夫、開府儀同三司。時河南尹韓壽因托賈后求以女配廙孫陶，廙距而不許，後深以為恨，故遂不登臺司。年七十五卒，諡曰元。三子：混、薈、恆。","person_mention_id":"c-jinshu-044-huayi:line084:m0222"}],"attestations":[{"id":"th-w043-huayi-21:a","paragraph_id":"c-jinshu-044-huayi:line084","start":219,"end":222,"surface":"河南尹","person_mention_id":"c-jinshu-044-huayi:line084:m0222","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-044-huayi:line084","text":"廙棲遲家巷垂十載，教誨子孫，講誦經典。集經書要事，名曰《善文》，行於世。與陳勰共造豬闌於宅側，帝嘗出視之，問其故，左右以實對，帝心憐之。帝后又登陵雲台，望見廙苜蓿園，阡陌甚整，依然感舊。太康初大赦，乃得襲封。久之，拜城門校尉，遷左衛將軍。數年，以為中書監。惠帝即位，加侍中、光祿大夫、尚書令，進爵為公。廙應楊駿召，不時還，有司奏免官。尋遷太子少傅，加散騎常侍，動遵禮典，得傅導之義。後年衰病篤，詔遣太醫療病，進位光祿大夫、開府儀同三司。時河南尹韓壽因托賈后求以女配廙孫陶，廙距而不許，後深以為恨，故遂不登臺司。年七十五卒，諡曰元。三子：混、薈、恆。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-huayi:line084:m0000","start":0,"end":1,"surface":"廙","kind":"person","person_id":"418_c91_b6b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0037","start":37,"end":39,"surface":"陳勰","kind":"person","person_id":"0jn_zly_6n7","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0078","start":78,"end":79,"surface":"廙","kind":"person","person_id":"418_c91_b6b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0128","start":128,"end":130,"surface":"惠帝","kind":"person","person_id":"7e0_f69_1ac","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0151","start":151,"end":152,"surface":"廙","kind":"person","person_id":"418_c91_b6b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0153","start":153,"end":155,"surface":"楊駿","kind":"person","person_id":"603_131_11e","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0222","start":222,"end":224,"surface":"韓壽","kind":"person","person_id":"wwi_1cy_1ui","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0226","start":226,"end":228,"surface":"賈后","kind":"person","person_id":"c27_590_7e3_A","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0232","start":232,"end":233,"surface":"廙","kind":"person","person_id":"418_c91_b6b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-huayi:line084:m0234","start":234,"end":235,"surface":"陶","kind":"person","person_id":"418_c91_b6b_AA","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-hua