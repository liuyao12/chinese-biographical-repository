_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-044-huayi:line084:m0222","mention_ids":["c-jinshu-044-huayi:line084:m0222"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"},{"source_id":"s-jinshu-053-minhuai-yu-ws2595666","work_id":"w-jinshu","book_id":"b-jinshu-053","chapter_id":"c-jinshu-053-minhuai-yu","raw_mention_count":1,"mention_ids":["c-jinshu-053-minhuai-yu:p004:m0126"],"paragraph_ids":["c-jinshu-053-minhuai-yu:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-053-minhuai-yu:p004:m0126","mention_ids":["c-jinshu-053-minhuai-yu:p004:m0126"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-044-huayi","s-jinshu-053-minhuai-yu-ws2595666"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin053-volume-han-spouse","subject_person_id":"wwi_1cy_1ui","object_person_id":"6rq_mk4_du1","predicate":"spouse","qualifiers":{"source_term":"壽妻賈午"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-053","chapter_id":"c-jinshu-053-minhuai-yu","source_id":"s-jinshu-053-minhuai-yu-ws2595666","paragraph_id":"c-jinshu-053-minhuai-yu:p004","quote":"太子性剛，知賈謐恃后之貴，不能假借之。謐至東宮，或舍之而於後庭遊戲。詹事裴權諫曰：「賈謐甚有寵于中宮，而有不順之色，若一旦交構，大事去矣。宜深自謙屈，以防其變，廣延賢士，用自輔翼。」太子不能從。初，賈后母郭槐欲以韓壽女為太子妃，太子亦欲婚韓氏以自固。而壽妻賈午及后皆不聽，而為太子聘王衍小女惠風。太子聞衍長女美，而賈后為謐聘之，心不能平，頗以為言。謐嘗與太子圍棋，爭道，成都王穎見而訶謐，謐意愈不平，因此譖太子于后曰：「太子廣買田業，多畜私財以結小人者，為賈氏故也。密聞其言云：『皇后萬歲後，吾當魚肉之。』非但如是也，若宮車晏駕，彼居大位，依楊氏故事，誅臣等而廢后於金墉，如反手耳。不如早為之所，更立慈順者以自防衛。」后納其言，又宣揚太子之短，布諸遠近。于時朝野咸知賈后有害太子意。中護軍趙俊請太子廢后，太子不聽。","subject_person_mention_id":"c-jinshu-053-minhuai-yu:p004:m0126","object_person_mention_id":"c-jinshu-053-minhuai-yu:p004:m0128"}],"status":"source_attested","interpretation_note":"妻稱明見於議婚原文。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin053-volume-han-daughter","subject_person_id":"ux4_8e0_4th","object_person_id":"wwi_1cy_1ui","predicate":"father","qualifiers":{"source_term":"韓壽女"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-053","chapter_id":"c-jinshu-053-minhuai-yu","source_id":"s-jinshu-053-minhuai-yu-ws2595666","paragraph_id":"c-jinshu-053-minhuai-yu:p004","quote":"太子性剛，知賈謐恃后之貴，不能假借之。謐至東宮，或舍之而於後庭遊戲。詹事裴權諫曰：「賈謐甚有寵于中宮，而有不順之色，若一旦交構，大事去矣。宜深自謙屈，以防其變，廣延賢士，用自輔翼。」太子不能從。初，賈后母郭槐欲以韓壽女為太子妃，太子亦欲婚韓氏以自固。而壽妻賈午及后皆不聽，而為太子聘王衍小女惠風。太子聞衍長女美，而賈后為謐聘之，心不能平，頗以為言。謐嘗與太子圍棋，爭道，成都王穎見而訶謐，謐意愈不平，因此譖太子于后曰：「太子廣買田業，多畜私財以結小人者，為賈氏故也。密聞其言云：『皇后萬歲後，吾當魚肉之。』非但如是也，若宮車晏駕，彼居大位，依楊氏故事，誅臣等而廢后於金墉，如反手耳。不如早為之所，更立慈順者以自防衛。」后納其言，又宣揚太子之短，布諸遠近。于時朝野咸知賈后有害太子意。中護軍趙俊請太子廢后，太子不聽。","subject_person_mention_id":"c-jinshu-053-minhuai-yu:p004:m0106","object_person_mention_id":"c-jinshu-053-minhuai-yu:p004:m0126"}],"status":"source_attested","interpretation_note":"韓壽之女為議婚對象，傳無其名。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-044-huayi:line084:m0222","start":222,"end":224,"surface":"韓壽","kind":"person","person_id":"wwi_1cy_1ui","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_