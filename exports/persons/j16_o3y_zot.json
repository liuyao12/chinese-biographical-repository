宮僚，乃召入直崇明殿。會薨，出為晉安郡丞，仍除候官令。建武初舉士，為始安王遙光所薦，除儀曹郎，遷書侍御史，出為錢唐令。初僧孺與樂安任昉遇于竟陵王西邸，以文學會友，及將之縣，昉贈詩曰：「唯子見知，唯餘知子，觀行視言，要終猶始。敬之重之，如蘭如芷，形應影隨，曩行今止。百行之首，立人斯著，子之有之，誰毀誰譽。修名既立，老至何遽，誰其執鞭，吾為子禦。劉略班藝，虞志荀錄，伊昔有懷，交相欣勖。下帷無倦，升高有屬，嘉爾晨登，惜餘夜燭。」其為士友推重如此。","mentions":[{"id":"c-nanshi-059-wangsengru:p003:m0012","surface":"王晏","start":12,"end":14,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0019","surface":"晏","start":19,"end":20,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0042","surface":"子良","start":42,"end":44,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0052","surface":"僧孺","start":52,"end":54,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0058","surface":"虞羲","start":58,"end":60,"person_id":"ziv_5l7_sp6","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0061","surface":"丘國賓","start":61,"end":64,"person_id":"gdr_uqp_pps","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0065","surface":"蕭文琰","start":65,"end":68,"person_id":"dvz_fqs_wbq","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0069","surface":"丘令楷","start":69,"end":72,"person_id":"re3_grx_ei8","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0073","surface":"江洪","start":73,"end":75,"person_id":"u3l_j15_ybs","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0076","surface":"劉孝孫","start":76,"end":79,"person_id":"x9x_svk_kwg","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0088","surface":"僧孺","start":88,"end":90,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0093","surface":"徐夤","start":93,"end":95,"person_id":"1up_vyo_s9g_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0144","surface":"遙光","start":144,"end":146,"person_id":"98q_mll_d6v_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0167","surface":"僧孺","start":167,"end":169,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0172","surface":"任昉","start":172,"end":174,"person_id":"tvc_q3c_t7w","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0193","surface":"昉","start":193,"end":194,"person_id":"tvc_q3c_t7w","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-059-wangsengru:p003:m0284","surface":"虞","start":284,"end":285,"person_id":null,"kind":"unresolved","status":"unresolved","interpretation_note":"《志》與摯虞《文章志》可參，比對仍未足定。","candidate_person_ids":["3c3_1e8_873"]}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":1553912,"source_layer":"received_biography","first_line":86,"last_line":86,"line_start":0,"line_end":329,"raw_start":6739,"raw_end":7068,"raw_character_offsets":[6739,6740,6741,6742,6743,6744,6745,6746,6747,6748,6749,6750,6751,6752,6753,6754,6755,6756,6757,6758,6759,6760,6761,6762,6763,6764,6765,6766,6767,6768,6769,6770,6771,6772,6773,6774,6775,6776,6777,6778,6779,6780,6781,6782,6783,6784,