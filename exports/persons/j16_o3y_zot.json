ncy_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0207","start":207,"end":208,"surface":"歆","kind":"person","person_id":"j16_o3y_zot","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001","chapter_id":"c-jinshu-075-xunsong-families"}],"relations":[],"title_holdings":[],"address_assertions":[],"person_references":[{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:r0216","paragraph_id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001","start":216,"end":217,"surface":"子","person_id":"j16_o3y_zot","referent_role":"third_person","quote":"父子各執一家","note":"劉歆。","chapter_id":"c-jinshu-075-xunsong-families","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-xunsong-families"},{"id":"c-liangshu-033-wangsengru:p003:r0419","surface":"劉","start":419,"end":420,"person_id":"j16_o3y_zot","referent_role":"third_person","paragraph_id":"c-liangshu-033-wangsengru:p003","quote":"仕齊，起家王國左常侍、太學博士。尚書僕射王晏深相賞好。晏爲丹陽尹，召補郡功曹，使僧孺撰《東宮新記》。遷大司馬豫章王行參軍，又兼太學博士。司徒竟陵王子良開西邸招文學，僧孺亦遊焉。文惠太子聞其名，召入東宮，直崇明殿。欲擬爲宮僚，文惠薨，不果。時王晏子德元出爲晉安郡，以僧孺補郡丞，除候官令。建武初，有詔舉士，揚州刺史始安王遙光表薦秘書丞王暕及僧孺曰：「前候官令東海王僧孺，年三十五，理尚棲約，思致悟敏，旣筆耕爲養，亦傭書成學。至乃照螢映雪，編蒲緝柳，先言往行，人物雅俗，甘泉遺儀，南宮故事，畫地成圖，抵掌可述；豈直鼮鼠有必對之辯，竹書無落簡之謬，訪對不休，質疑斯在。」除尚書儀曹郎，遷治書侍御史，出爲錢唐令。初，僧孺與樂安任昉遇竟陵王西邸，以文學友會，及是將之縣，昉贈詩，其略曰：「惟子見知，惟余知子。觀行視言，要終猶始。敬之重之，如蘭如芷。形應影隨，曩行今止。百行之首，立人斯著。子之有之，誰毀誰譽。修名旣立，老至何遽。誰其執鞭，吾爲子御。劉《略》班《藝》，虞《志》荀《錄》，伊昔有懷，交相欣勗。下帷無倦，升高有屬。嘉爾晨燈，惜余夜燭。」其爲士友推重如此。","note":"依原有文體、發言者、受話人、王府或本傳前後文。","chapter_id":"c-liangshu-033-wangsengru","book_id":"b-liangshu-033","work_id":"w-liangshu","source_id":"s-liangshu-033-wangsengru-ws1514481"},{"id":"c-nanshi-059-wangsengru:p003:r0279","surface":"劉","start":279,"end":280,"person_id":"j16_o3y_zot","referent_role":"third_person","paragraph_id":"c-nanshi-059-wangsengru:p003","quote":"仕齊為太學博士，尚書僕射王晏深相賞好。晏為丹陽尹，召補功曹，使撰東宮新記。司徒竟陵王子良開西邸，招文學，僧孺與太學生虞羲、丘國賓、蕭文琰、丘令楷、江洪、劉孝孫並以善辭藻遊焉。而僧孺與高平徐夤俱為學林。文惠太子欲以為宮僚，乃召入直崇明殿。會薨，出為晉安郡丞，仍除候官令。建武初舉士，為始安王遙光所薦，除儀曹郎，遷書侍御史，出為錢唐令。初僧孺與樂安任昉遇于竟陵王西邸，以文學會友，及將之縣，昉贈詩曰：「唯子見知，唯餘知子，觀行視言，要終猶始。敬之重之，如蘭如芷，形應影隨，曩行今止。百行之首，立人斯著，子之有之，誰毀誰譽。修名既立，老至何遽，誰其執鞭，吾為子禦。劉略班藝，虞志荀錄，伊昔有懷，交相欣勖。下帷無倦，升高有屬，嘉爾晨登，惜餘夜燭。」其為士友推重如此。","note":"從本段發言者、受話人或所記府主覆核。","chapter_id":"c-nanshi-059-wangsengru","book_id":"b-nanshi-059","work_id":"w-nanshi","source_id":"s-nanshi-059-wangsengru-ws1553912"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001","text":"昔周之衰，下陵上替，上無天子，下無方伯，善者誰賞，惡者誰罰，孔子懼而作《春秋》。諸侯諱妒，懼犯時禁，是以微辭妙旨，義不顯明，故曰「知我者其惟《春秋》，罪我者其惟《春秋》」。時左丘明、子夏造膝親受，無不精究。孔子既沒，微言將絕，於是丘明退撰所聞，而為之傳。其書善禮，多膏腴美辭，張本繼末，以發明經意，信多奇偉，學者好之。稱公羊高親受子夏，立于漢朝，辭義清雋，斷決明審，董仲舒之所善也。穀梁赤師徒相傳，暫立於漢世。向、歆，漢之碩儒，猶父子各執一家，莫肯相從。其書文清義約，諸所發明，或是《左氏》、《公羊》所不載，亦足有所訂正。是以三傳並行於先代，通才未能孤廢。今去聖久遠，其文將墮，與其過廢，寧與過立。臣以為三傳雖同曰《春秋》，而發端異趣，案如三家異同之說，此乃義則戰爭之場，辭亦劍戟之鋒，於理不可得共。博士宜各置一人，以博其學。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0030","start":30,"end":32,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0087","start":87,"end":90,"surface":"左丘明","kind":"person","person_id":"99j_eyj_m1z","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0091","start":91,"end":93,"surface":"子夏","kind":"person","person_id":"z8l_wje_08d","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0103","start":103,"end":105,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0115","start":115,"end":117,"surface":"丘明","kind":"person","person_id":"99j_eyj_m1z","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0160","start":160,"end":163,"surface":"公羊高","kind":"person","person_id":"8k9_qop_y1z","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0165","start":165,"end":167,"surface":"子夏","kind":"person","person_id":"z8l_wje_08d","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0183","start":183,"end":186,"surface":"董仲舒","kind":"person","person_id":"6m0_g4r_x9t","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0191","start":191,"end":194,"surface":"穀梁赤","kind":"person","person_id":"xw8_v2g_5az","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0205","start":205,"end":206,"surface":"向","kind":"person","person_id":"3c2_3za_ei5","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0207","start":207,"end":208,"surface":"歆","kind":"person","person_id":"j16_o3y_zot","status":"contextual_provisional"},{"id":"c-jinshu-075-xunsong-families:xunsong-body-138:p001:m0299","start":299,"end":300,"surface":"臣","kind":"person","person_id":"yoo_ox0_545_BABAAA","status":"contextual_provisional"}],"source_position":{"first_line":138,"last_line":138,"revision_id":2645530,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-075-xunsong-families","book_id":"b-jinshu-075","work_id":"w-jinshu","source_id":"s-jinshu-075-xunsong-families"},{"id":"c-liangshu-033-wangsengru:p003","text":"仕齊，起家王國左常侍、太學博士。尚書僕射王晏深相賞好。晏爲丹陽尹，召補郡功曹，使僧孺撰《東宮新記》。遷大司馬豫章王行參軍，又兼太學博士。司徒竟陵王子良開西邸招文學，僧孺亦遊焉。文惠太子聞其名，召入東宮，直崇明殿。欲擬爲宮僚，文惠薨，不果。時王晏子德元出爲晉安郡，以僧孺補郡丞，除候官令。建武初，有詔舉士，揚州刺史始安王遙光表薦秘書丞王暕及僧孺曰：「前候官令東海王僧孺，年三十五，理尚棲約，思致悟敏，旣筆耕爲養，亦傭書成學。至乃照螢映雪，編蒲緝柳，先言往行，人物雅俗，甘泉遺儀，南宮故事，畫地成圖，抵掌可述；豈直鼮鼠有必對之辯，竹書無落簡之謬，訪對不休，質疑斯在。」除尚書儀曹郎，遷治書侍御史，出爲錢唐令。初，僧孺與樂安任昉遇竟陵王西邸，以文學友會，及是將之縣，昉贈詩，其略曰：「惟子見知，惟余知子。觀行視言，要終猶始。敬之重之，如蘭如芷。形應影隨，曩行今止。百行之首，立人斯著。子之有之，誰毀誰譽。修名旣立，老至何遽。誰其執鞭，吾爲子御。劉《略》班《藝》，虞《志》荀《錄》，伊昔有懷，交相欣勗。下帷無倦，升高有屬。嘉爾晨燈，惜余夜燭。」其爲士友推重如此。","mentions":[{"id":"c-liangshu-033-wangsengru:p003:m0020","surface":"王晏","start":20,"end":22,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p003:m0027","surface":"晏","start":27,"end":28,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p003:m0040","surface":"僧孺","start":40,"end":42,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p003:m0073","surface":"子良","start":73,"end":75,"person_id":"x3q_cqm_dup","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p003:m0082","surface":"僧孺","start":82,"end":84,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p003:m0120","surface":"王晏","start":120,"end":122,"person_id":"i08_s4b_5bb","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p003:m0123","surface":"德元","start":123,"end":125,"person_id":"i08_s4b_5bb_A","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p003:m0132","surface":"僧孺","start":132,"end":134,"person_id":"59d_72d_924_AAA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-liangshu-033-wangsengru:p003:m0159","surface":"遙光","start":159,"end":161,"person_id":"98q_mll_d6v_AA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句