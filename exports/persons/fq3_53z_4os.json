al_provisional"},{"id":"c-jinshu-068-yangfang:p001:m0332","surface":"王導","start":332,"end":334,"person_id":"7r6_k52_qji_ABAA","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-068-yangfang","book_id":"b-jinshu-068","work_id":"w-jinshu","source_id":"s-jinshu-068-yangfang-ws2581578"},{"id":"c-jinshu-091-jin043-shanxia:birth","text":"虞喜，字仲寧，會稽余姚人","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-091-jin043-shanxia:birth:m0000","start":0,"end":2,"surface":"虞喜","kind":"person","person_id":"fq3_53z_4os","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-091-jin043-shanxia:birth:m0004","start":4,"end":6,"surface":"仲寧","kind":"person","person_id":"fq3_53z_4os","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"text_layer":"received_chapter","source_quote":{"witness":"j91","quote":"虞喜，字仲寧，會稽余姚人","raw_start":1633,"raw_end":1645,"raw_line":24},"chapter_id":"c-jinshu-091-jin043-shanxia","book_id":"b-jinshu-091","work_id":"w-jinshu","source_id":"s-jinshu-091-jin043-shanxia"},{"id":"c-jinshu-091-jin043-shanxia:petition","text":"伏見前賢良虞喜天挺貞素，高尚邈世","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-091-jin043-shanxia:petition:m0005","start":5,"end":7,"surface":"虞喜","kind":"person","person_id":"fq3_53z_4os","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"text_layer":"received_chapter","source_quote":{"witness":"j91","quote":"伏見前賢良虞喜天挺貞素，高尚邈世","raw_start":1992,"raw_end":2008,"raw_line":26},"chapter_id":"c-jinshu-091-jin043-shanxia","book_id":"b-jinshu-091","work_id":"w-jinshu","source_id":"s-jinshu-091-jin043-shanxia"},{"id":"c-nanqishu-052-zuchongzhi:p003","text":"上表曰臣博訪前墳遠稽昔典五帝躔次三王交分春秋朔氣紀年薄蝕談遷載述彪固列志魏世注厯晉代起居探異今古觀要華戎書契以降二千餘稔日月離會之徴星度疎宻之騐專功躭思咸可得而言也加以親量圭尺躬察儀漏目盡毫釐心窮籌筴考課推移又曲備其詳矣然而古厯疎舛類不精宻羣氏糾紛莫審其㑹尋何承天所上意存改革而置法簡畧今已乖逺以臣校之三覩厥謬日月所在差覺三度二至晷景幾失一日五星見伏至差四旬留逆進退或移兩宿分至失實則節閏非正宿度違天則伺察無准臣生屬聖辰詢逮在運敢率愚瞽更創新厯謹立改易之意有二設法之情有三改易者一以舊法一章十九嵗有七閏閏數為多經二百年輒差一日節閏旣移則應改法厯紀屢遷寔由此條今改章法三百九十一年有一百四十四閏令却合周漢則將來永用無復差動其二以堯典云日短星昴以正仲冬以此推之唐世冬至日在合宿之左五十許度伐之初即秦厯冬至日在牽牛六度漢武改立太初厯冬至日在牛初後漢四分法冬至日在斗二十二晉世姜岌以月蝕檢日知冬至在斗十七今參以中星課以蝕望冬至之日在斗十一通而計之未盈百載所差二度舊法竝令冬至日有定處天數旣差則七曜宿度漸與舛訛乖謬旣著輒應改易僅合一時莫能通遠遷革不已又由此條今令冬至所在嵗嵗微差却檢漢注竝皆審宻將來久用無煩屢改又設法者其一以子為辰首位在正北爻應初九升氣之端虚為北方列宿之中元氣肇初宜在此次前儒虞喜備論其義今厯上元日度發自虚一其二以日辰之號甲子為先厯法設元應在此嵗而黄帝以來世代所用凡十一厯上元之嵗莫值此名今歴上元嵗在甲子其三以上元之嵗厯中衆條竝應以此為始而景初厯交㑹遲疾元首有差又承天法日月五星各自有元交㑹遲疾亦竝置差裁得朔氣合而今條序紛錯不及古意今設法日月五緯交㑹遲疾悉以上元嵗首為始羣流共源庶無乖誤若夫測以定形據以實効懸象著明尺表之驗可推動氣幽微寸管之候不忒今臣所立易以取信但綜覈始終大存緩宻革新變舊有約有繁用約之條理不自懼用繁之意顧非謬然何者夫紀閏參差數各有分分之為體非不細密臣是用深惜毫釐以全求妙之准不辭積累以成永定之製非為思而莫知悟而弗改也若所上萬一可採伏願頒宣羣司賜垂詳究","text_layer":"received_chapter","source_position":{"source_layer":"received_biography","first_line":298,"last_line":342,"raw_projection_ref":"source-evidence/nanqi052-zuchongzhi/projection.json","editorial_paragraph_boundary":true,"revision_id":"787dd9a7da495542e8f17c26c96900ce37b2c211"},"mentions":[{"id":"c-nanqishu-052-zuchongzhi:p003:m0003","start":3,"end":4,"surface":"臣","kind":"person","person_id":"vcm_d77_tsz_AA","status":"contextual_provisional","interpretation_note":"本傳具名字文逺及宋齊兩朝機械曆學官序，不與祖逖等同姓人接"},{"id":"c-nanqishu-052-zuchongzhi:p003:u0012","start":12,"end":14,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","candidate_person_ids":[],"note":"上古君主群稱，不由群數指定人物或排行"},{"id":"c-nanqishu-052-zuchongzhi:p003:u0016","start":16,"end":18,"surface":"三王","kind":"unresolved","person_id":null,"status":"unresolved","candidate_person_ids":[],"note":"上古君主群稱，不由群數指定人物或排行"},{"id":"c-nanqishu-052-zuchongzhi:p003:w0020","start":20,"end":22,"surface":"春秋","kind":"work","person_id":null,"status":"contextual_provisional","work_id":"w-chunqiu-nanqi052-reference","interpretation_note":"春秋朔氣紀年薄蝕之經籍稱；不因同字合左傳或今本版系。"},{"id":"c-nanqishu-052-zuchongzhi:p003:m0028","start":28,"end":29,"surface":"談","kind":"person","person_id":"pme_eis_xqi_*A*AAAA","status":"contextual_provisional","interpretation_note":"談遷載述並稱史家父子，談為司馬談首選，非普通談論"},{"id":"c-nanqishu-052-zuchongzhi:p003:m0029","start":29,"end":30,"surface":"遷","kind":"person","person_id":"pme_eis_xqi_*