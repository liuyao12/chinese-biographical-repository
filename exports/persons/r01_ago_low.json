168"],"paragraph_ids":["c-shiji-076-pingyu:p012","c-shiji-076-pingyu:p013"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-076-pingyu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-076-pingyu:m012-0014","start":14,"end":16,"surface":"趙郝","kind":"person","person_id":"r01_ago_low","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p012","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m012-0146","start":146,"end":148,"surface":"趙郝","kind":"person","person_id":"r01_ago_low","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p012","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m012-0149","start":149,"end":151,"surface":"趙郝","kind":"person","person_id":"r01_ago_low","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p012","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m012-0227","start":227,"end":229,"surface":"趙郝","kind":"person","person_id":"r01_ago_low","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p012","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m013-0012","start":12,"end":13,"surface":"郝","kind":"person","person_id":"r01_ago_low","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p013","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m013-0039","start":39,"end":40,"surface":"郝","kind":"person","person_id":"r01_ago_low","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p013","chapter_id":"c-shiji-076-pingyu"},{"id":"c-shiji-076-pingyu:m013-0168","start":168,"end":169,"surface":"郝","kind":"person","person_id":"r01_ago_low","status":"contextual_provisional","paragraph_id":"c-shiji-076-pingyu:p013","chapter_id":"c-shiji-076-pingyu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji076-029","person_id":"r01_ago_low","scope":"same_chapter","chapter_ids":["c-shiji-076-pingyu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","rationale":"依虞卿長平、割地與魏從敘事明示姓名及局部回指暫接，趙王以先後明示趙孝成王為限，秦齊兩王各留未名。樓昌昌、趙郝郝與樓緩緩樓子限本篇段落，公甫文伯及母相室保存引古角色，孔子逐魯不當已確證年表，母妻評語不補配偶。魏齊姓名與魏齊兩國詞分辨，馮亭保存太史公議論角色不確證邪説評價。","surfaces":["趙郝","郝"],"evidence":[{"paragraph_id":"c-shiji-076-pingyu:p012","quote":"秦既解邯鄲圍，而趙王入朝，使趙郝約事於秦，割六縣而媾。虞卿謂趙王曰：「秦之攻王也，倦而歸乎？王以其力尚能進，愛王而弗攻乎？」王曰：「秦之攻我也，不遺餘力矣，必以倦而歸也。」虞卿曰：「秦以其力攻其所不能取，倦而歸，王又以其力之所不能取以送之，是助秦自攻也。來年秦復攻王，王無救矣。」王以虞卿之言趙郝。趙郝曰：「虞卿誠能盡秦力之所至乎？誠知秦力之所不能進，此彈丸之地弗予，令秦來年復攻王，王得無割其內而媾乎？」王曰：「請聽子割，子能必使來年秦之不復攻我乎？」趙郝對曰：「此非臣之所敢任也。他日三晉之交於秦，相善也。今秦善韓、魏而攻王，王之所以事秦必不如韓、魏也。今臣爲足下解負親之攻，開關通幣，齊交韓、魏，至來年而王獨取飽於秦，此王之所以事秦必在韓、魏之後也。此非臣之所敢任也。」"},{"paragraph_id":"c-shiji-076-pingyu:p013","quote":"王以告虞卿。虞卿對曰：「郝言『不媾，來年秦復攻王，王得無割其內而媾乎』。今媾，郝又以不能必秦之不復攻也。今雖割六城，何益！來年復攻，又割其力之所不能取而媾，此自盡之術也，不如無媾。秦雖善攻，不能取六縣；趙雖不能守，終不失六城。秦倦而歸，兵必罷。我以六城收天下以攻罷秦，是我失之於天下而取償於秦也。吾國尚利，孰與坐而割地，自弱以彊秦哉？今郝曰『秦善韓、魏而攻趙者，必以爲韓魏不救趙也而王之軍必孤有以王之事秦不如韓、魏也』，是使王歲以六城事秦也，即坐而城盡。來年秦復求割地，王將與之乎？弗與，是棄前功而挑秦禍也；與之，則無地而給之。語曰『彊者善攻，弱者不能守』。今坐而聽秦，秦兵不獘而多得地，是彊秦而弱趙也。以益彊之秦而割愈弱之趙，其計故不止矣。且王之地有盡而秦之求無已，以有盡之地而給無已之求，其勢必無趙矣。」"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-076-pingyu:p012","text":"秦既解邯鄲圍，而趙王入朝，使趙郝約事於秦，割六縣而媾。虞卿謂趙王曰：「秦之攻王也，倦而歸乎？王以其力尚能進，愛王而弗攻乎？」王曰：「秦之攻我也，不遺餘力矣，必以倦而歸也。」虞卿曰：「秦以其力攻其所不能取，倦而歸，王又以其力之所不能取以送之，是助秦自攻也。來年秦復攻王，王無救矣。」王以虞卿之言趙郝。趙郝曰：「虞卿誠能盡秦力之所至乎？誠知秦力之所不能進，此彈丸之地弗予，令秦來年復攻王，王得無割其內而媾乎？」王曰：「請聽子割，子能必使來年秦之不復攻我乎？」趙郝對曰：「此非臣之所敢任也。他日三晉之交於秦，相善也。今秦善韓、魏而攻王，王之所以事秦必不如韓、魏也。今臣爲足下解負親之攻，開關通幣，齊交韓、魏，至來年而王獨取飽於秦，此王之所以事秦必在韓、魏之後也。此非臣之所敢任也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-076-pingyu:m012-0008","start":8,"end":10,"surface":"趙王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0014","start":14,"end":16,"surface":"趙郝","kind":"person","person_id":"r01_ago_low","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0027","start":27,"end":29,"surface":"虞卿","kind":"person","person_id":"cdg_kvt_y0p","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0030","start":30,"end":32,"surface":"趙王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0038","start":38,"end":39,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0046","start":46,"end":47,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0055","start":55,"end":56,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0062","start":62,"end":63,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0086","start":86,"end":88,"surface":"虞卿","kind":"person","person_id":"cdg_kvt_y0p","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0106","start":106,"end":107,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0132","start":132,"end":133,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0134","start":134,"end":135,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0140","start":140,"end":141,"surface":"王","kind":"person","person_id":"8ga_fba_dw9","status":"contextual_provisional"},{"id":"c-shiji-076-pingyu:m012-0142","start