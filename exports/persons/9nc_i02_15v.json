ily_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:p031:m0005","start":5,"end":7,"surface":"徐巿","kind":"person","person_id":"9nc_i02_15v","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p031","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p031:m0050","start":50,"end":52,"surface":"徐巿","kind":"person","person_id":"9nc_i02_15v","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p031","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p046:m0271","start":271,"end":273,"surface":"徐巿","kind":"person","person_id":"9nc_i02_15v","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p046","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p050:m0018","start":18,"end":22,"surface":"方士徐巿","kind":"person","person_id":"9nc_i02_15v","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p050","chapter_id":"c-shiji-006-shihuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p031","text":"既已，齊人徐巿等上書，言海中有三神山，名曰蓬萊、方丈、瀛洲，僊人居之。請得齋戒，與童男女求之。於是遣徐巿發童男女數千人，入海求僊人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p031:m0005","start":5,"end":7,"surface":"徐巿","kind":"person","person_id":"9nc_i02_15v","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p031:m0030","start":30,"end":32,"surface":"僊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官號、神祇或未定指代；不補造人物或已知姓名。"},{"id":"c-shiji-006-shihuang:p031:m0041","start":41,"end":44,"surface":"童男女","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官號、神祇或未定指代；不補造人物或已知姓名。"},{"id":"c-shiji-006-shihuang:p031:m0050","start":50,"end":52,"surface":"徐巿","kind":"person","person_id":"9nc_i02_15v","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p031:m0053","start":53,"end":56,"surface":"童男女","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官號、神祇或未定指代；不補造人物或已知姓名。"},{"id":"c-shiji-006-shihuang:p031:m0063","start":63,"end":65,"surface":"僊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官號、神祇或未定指代；不補造人物或已知姓名。"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:p046","text":"侯生盧生相與謀曰：「始皇為人，天性剛戾自用，起諸侯，并天下，意得欲從，以為自古莫及己。專任獄吏，獄吏得親幸。博士雖七十人，特備員弗用。丞相諸大臣皆受成事，倚辨於上。上樂以刑殺為威，天下畏罪持祿，莫敢盡忠。上不聞過而日驕，下懾伏謾欺以取容。秦法，不得兼方不驗，輒死。然候星氣者至三百人，皆良士，畏忌諱諛，不敢端言其過。天下之事無小大皆決於上，上至以衡石量書，日夜有呈，不中呈不得休息。貪於權勢至如此，未可為求僊藥。」於是乃亡去。始皇聞亡，乃大怒曰：「吾前收天下書不中用者盡去之。悉召文學方術士甚眾，欲以興太平，方士欲練以求奇藥。今聞韓眾去不報，徐巿等費以巨萬計，終不得藥，徒姦利相告日聞。盧生等吾尊賜之甚厚，今乃誹謗我，以重吾不德也。諸生在咸陽者，吾使人廉問，或為訞言以亂黔首。」於是使御史悉案問諸生，諸生傳相告引，乃自除犯禁者四百六十餘人，皆阬之咸陽，使天下知之，以懲後。益發謫徙邊。始皇長子扶蘇諫曰：「天下初定，遠方黔首未集，諸生皆誦法孔子，今上皆重法繩之，臣恐天下不安。唯上察之。」始皇怒，使扶蘇北監蒙恬於上郡。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p046:m0000","start":0,"end":2,"surface":"侯生","kind":"person","person_id":"4ky_3rl_efu","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p046:m0002","start":2,"end":4,"surface":"盧生","kind":"person","person_id":"17c_7g8_b8g","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p046:m0010","start":10,"end":12,"surface":"始皇","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p046:m0213","start":213,"end":215,"surface":"始皇","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p046:m0254","start":254,"end":256,"surface":"方士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、官稱、神祇或未核指代，不能以後