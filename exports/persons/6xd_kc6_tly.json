fault":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-045-daosheng-complete:p015:m0423","start":423,"end":425,"surface":"道登","kind":"person","person_id":"6xd_kc6_tly","status":"contextual_provisional","paragraph_id":"c-nanqishu-045-daosheng-complete:p015","chapter_id":"c-nanqishu-045-daosheng-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-045-daosheng-complete:p015","text":"　　宏又曰：「雲羅所掩，六合宜一。故往年與齊武有書，言今日之事，書似未達齊主，命也。南使旣反，情有愴然，朕亦休兵。此段猶是本意，不必專爲問罪。若如卿言，便可釋然。」慶遠曰：「見可而進，知難而退，聖人奇兵。今旨欲憲章聖人，不失舊好，豈不善哉！」宏曰：「卿爲欲朕和親？爲欲不和？」慶遠曰：「和親則二國交歡，蒼生再賴；不和則二國交怨，蒼生塗炭。和與不和，裁由聖衷。」宏曰：「朕來爲復遊行鹽境，北去洛都，率爾便至。亦不攻城，亦不伐塢，卿勿以爲慮。」宏設酒及羊炙雜果，又謂慶遠曰：「聽卿主克黜凶嗣，不違忠孝。何以不立近親，如周公輔成王，而苟欲自取？」慶遠答曰：「成王有亞聖之賢，故周公得輔而相之。今近蕃雖無悖德，未有成王之賢。霍光亦捨漢蕃親而遠立宣帝。」宏曰：「若爾，霍光嚮自立爲君，當復得爲忠臣不？」慶遠曰：「此非其類，乃可言宣帝立與不立義當云何。皇上豈得與霍光爲匹？若爾，何以不言『武王伐紂，何意不立微子而輔之，苟貪天下？』」宏大笑。明日引軍向城東，遣道登道人進城內施衆僧絹五百匹，慶遠、選之各褶絡帶。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":51,"last_line":51,"raw_start":3306,"raw_end":3763,"raw_character_offsets":[3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3377,3378,3379,3380,3381,3382,3383,3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3394,3395,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,343