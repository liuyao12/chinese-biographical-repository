tart":241,"end":243,"surface":"王陵","kind":"person","person_id":"5do_703_rfz","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m007-0250","start":250,"end":254,"surface":"左丞相平","kind":"person","person_id":"i3f_9l9_g53","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m007-0263","start":263,"end":266,"surface":"審食其","kind":"person","person_id":"qg7_n12_fne","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m007-0288","start":288,"end":290,"surface":"食其","kind":"person","person_id":"qg7_n12_fne","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m007-0293","start":293,"end":295,"surface":"太后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m007-0311","start":311,"end":314,"surface":"酈侯父","kind":"person","person_id":"acg_se3_w5x","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:p021","text":"高后已葬，以左丞相審食其為帝太傅。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m021-0000","start":0,"end":2,"surface":"高后","kind":"person","person_id":"i30_mjq_6q8_A","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m021-0009","start":9,"end":12,"surface":"審食其","kind":"person","person_id":"qg7_n12_fne","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:p026","text":"左丞相食其免。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m026-0003","start":3,"end":5,"surface":"食其","kind":"person","person_id":"qg7_n12_fne","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:p029","text":"朱虛侯已殺產，帝命謁者持節勞朱虛侯。朱虛侯欲奪節信，謁者不肯，朱虛侯則從與載，因節信馳走，斬長樂衛尉呂更始。還，馳入北軍，報太尉。太尉起，拜賀朱虛侯曰：「所患獨呂產，今已誅，天下定矣。」遂遣人分部悉捕諸呂男女，無少長皆斬之。辛酉，捕斬呂祿，而笞殺呂媭。使人誅燕王呂通，而廢魯王偃。壬戌，以帝太傅食其復為左丞相。戊辰，徙濟川王王梁，立趙幽王子遂為趙王。遣朱虛侯章以誅諸呂氏事告齊王，令罷兵。灌嬰兵亦罷滎陽而歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m029-0000","start":0,"end":3,"surface":"朱虛侯","kind":"person","person_id":"vfv_a3d_lsq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0005","start":5,"end":6,"surface":"產","kind":"person","person_id":"acg_se3_w5x_B","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0007","start":7,"end":8,"surface":"帝","kind":"person","person_id":"zht_ze7_m2d","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0009","start":9,"end":11,"surface":"謁者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m029-0014","start":14,"end":17,"surface":"朱虛侯","kind":"person","person_id":"vfv_a3d_lsq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0018","start":18,"end":21,"surface":"朱虛侯","kind":"person","person_id":"vfv_a3d_lsq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0026","start":26,"end":28,"surface":"謁者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m029-0031","start":31,"end":34,"surface":"朱虛侯","kind":"person","person_id":"vfv_a3d_lsq","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0050","start":50,"end":53,"surface":"呂更始","kind":"person","person_id":"g5b_oty_6le","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0062","start":62,"end":64,"surface":"太尉","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0065","start":65,"end":67,"surface":"太尉","kind":"person","person_id":"koy_6jg_gcc","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0071","start":71,"end":74,"surface