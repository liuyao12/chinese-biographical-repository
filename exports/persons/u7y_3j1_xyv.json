ferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-046-zhangshao:p002:m0062","start":62,"end":64,"surface":"從母","kind":"person","person_id":"u7y_3j1_xyv","status":"contextual_provisional","interpretation_note":"依完整傳文敘事、職官與親屬語境辨識；原字保留。","paragraph_id":"c-songshu-046-zhangshao:p002","chapter_id":"c-songshu-046-zhangshao"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-046-zhangshao:p002","text":"子敷演鏡有名於世敷字景𦙍生而母亡年數嵗問知之雖童䝉便有感慕之色至十嵗許求母遺物而散施已盡唯得一扇乃緘録之每至感思輒開笥流涕見從母悲感嗚咽性整貴風韻端雅好𤣥言善屬文初父邵使與南陽宗少文談繫象徃復數番少文每欲屈握麈尾歎曰吾道東矣於是名價日重武帝聞其羙召見竒之曰真千里駒也以為世子中軍參軍數見接引累遷江夏王義恭撫軍記室參軍義恭就文帝求一學義沙門會敷赴假江陵入辭文帝令以後車載沙門徃謂曰道中可得言晤敷不奉詔上甚不説遷正員中書郎敷小名查父邵小名梨文帝戲之曰查何如梨敷曰梨為百果之宗查何可比中書舍人狄當周赳並管要務以敷同省名家欲詣之赳曰彼恐不相容接不如勿徃當曰吾等並已員外郎矣何憂不得共坐敷先設二牀去壁三四尺二客就席敷呼左右曰移我逺客赳等失色而去其自標遇如此善持音儀盡詳緩之致與人别執手曰念相聞餘響久之不絶張氏後進皆慕之其源起自敷也遷黄門侍郎始興王濬後將軍司徒左長史未拜父在呉興亡成服凡十餘日方進水漿𦵏畢不進鹽菜遂毁瘠成疾伯父茂度每譬止之敷益更感慟絶而復續茂度曰我比止汝而乃益甚自是不復徃來期年而卒孝武即位旌其孝道追贈侍中改其所居為孝張里","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-songshu-046-zhangshao:p002:m0001","start":1,"end":2,"surface":"敷","kind":"person","person_id":"d50_8f5_wul_AAACA","status":"contextual_provisional","interpretation_note":"傳內短稱，依同一敘事主語／受話者辨識；不依最近長姓名自動續接。"},{"id":"c-songshu-046-zhangshao:p002:m0002","start":2,"end":3,"surface":"演","kind":"person","person_id":"d50_8f5_wul_AAAAA","status":"contextual_provisional","interpretation_note":"演鏡人物可標記，父系歧異另記不自動生兩組父子；未名母與沙門只限本段指涉。"},{"id":"c-songshu-046-zhangshao:p002:m0003","start":3,"end":4,"surface":"鏡","kind":"person","person_id":"d50_8f5_wul_AAAAB","status":"contextual_provisional","interpretation_note":"演鏡人物可標記，父系歧異另記不自動生兩組父子；未名母與沙門只限本段指涉。"},{"id":"c-songshu-046-zhangshao:p002:m0008","start":8,"end":9,"surface":"敷","kind":"person"