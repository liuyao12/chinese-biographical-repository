:true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-067-wenqiao:line056:m0188","start":188,"end":190,"surface":"羅洞","kind":"person","person_id":"jlu_k0f_ifn","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-wenqiao:line056","chapter_id":"c-jinshu-067-wenqiao"}],"relations":[],"title_holdings":[{"id":"th-w067-wen-49","person_id":"jlu_k0f_ifn","title":"江州別駕","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-067","chapter_id":"c-jinshu-067-wenqiao","source_id":"s-jinshu-067-wenqiao","paragraph_id":"c-jinshu-067-wenqiao:line056","quote":"嶠於是創建行廟，廣設壇場，告皇天后土祖宗之靈，親讀祝文，聲氣激揚，流涕覆面，三軍莫能仰視。其日侃督水軍向石頭，亮、嶠等率精勇一萬從白石以挑戰。時峻勞其將士，因醉，突陣馬躓，為侃將所斬，峻弟逸及子碩嬰城自固。嶠乃立行臺，布告天下，凡故吏二千石、臺郎御史以下，皆令赴臺。於是至者雲集。司徒王導因奏嶠、侃錄尚書，遣間使宣旨，並讓不受。賊將匡術以臺城來降，為逸所擊，求救於嶠。江州別駕羅洞曰：「今水暴長，救之不便，不如攻榻杭。榻杭軍若敗，術圍自解。」嶠從之，遂破賊石頭軍。奮威長史滕含抱天子奔于嶠船。時陶侃雖為盟主，而處分規略一出於嶠，及賊滅，拜驃騎將軍、開府儀同三司，加散騎常侍，封始安郡公，邑三千戶。","person_mention_id":"c-jinshu-067-wenqiao:line056:m0188"}],"attestations":[{"id":"th-w043-wen-49:a","paragraph_id":"c-jinshu-067-wenqiao:line056","start":184,"end":188,"surface":"江州別駕","person_mention_id":"c-jinshu-067-wenqiao:line056:m0188","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-067-wenqiao:line056","text":"嶠於是創建行廟，廣設壇場，告皇天后土祖宗之靈，親讀祝文，聲氣激揚，流涕覆面，三軍莫能仰視。其日侃督水軍向石頭，亮、嶠等率精勇一萬從白石以挑戰。時峻勞其將士，因醉，突陣馬躓，為侃將所斬，峻弟逸及子碩嬰城自固。嶠乃立行臺，布告天下，凡故吏二千石、臺郎御史以下，皆令赴臺。於是至者雲集。司徒王導因奏嶠、侃錄尚書，遣間使宣旨，並讓不受。賊將匡術以臺城來降，為逸所擊，求救於嶠。江州別駕