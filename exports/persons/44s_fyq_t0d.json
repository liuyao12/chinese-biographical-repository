ntity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-006-shihuang:p039:m0017","start":17,"end":19,"surface":"羨門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p039","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-012-wudi:m017-0178","start":178,"end":180,"surface":"羨門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional","paragraph_id":"c-shiji-012-wudi:p017","chapter_id":"c-shiji-012-wudi"},{"id":"c-shiji-117-xiangru:m052-0089","start":89,"end":91,"surface":"羡門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional","interpretation_note":"張揖釋碣石仙人羡門高，與始皇本紀碣石求羨門的名號及地域互證；保留羡／羨原字，不把高誓併成同名，也不補仙人生卒或任期。","paragraph_id":"c-shiji-117-xiangru:p052","chapter_id":"c-shiji-117-xiangru"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji012-016","person_id":"44s_fyq_t0d","surfaces":["羨門"],"scope":"cross_chapter","chapter_ids":["c-shiji-006-shihuang","c-shiji-012-wudi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p039","quote":"三十二年，始皇之碣石，使燕人盧生求羨門、高誓。刻碣石門。壞城郭，決通隄防。其辭曰："},{"paragraph_id":"c-shiji-012-wudi:p017","quote":"其春，樂成侯上書言欒大。欒大，膠東宮人，故嘗與文成將軍同師，已而為膠東王尚方。而樂成侯姊為康王后，毋子。康王死，他姬子立為王。而康后有淫行，與王不相中（得），相危以法。康后聞文成已死，而欲自媚於上，乃遣欒大因樂成侯求見言方。天子既誅文成，後悔恨其早死，惜其方不盡，及見欒大，大悅。大為人長美，言多方略，而敢為大言，處之不疑。大言曰：「臣嘗往來海中，見安期、羨門之屬。顧以為臣賤，不信臣。又以為康王諸侯耳，不足予方。臣數言康王，康王又不用臣。臣之師曰：『黃金可成，而河決可塞，不死之藥可得，僊人可致也。』臣恐效文成，則方士皆掩口，惡敢言方哉！」上曰：「文成食馬肝死耳。子誠能修其方，我何愛乎！」大曰：「臣師非有求人，人者求之。陛下必欲致之，則貴其使者，令有親屬，以客禮待之，勿卑，使各佩其信印，乃可使通言於神人。神人尚肯邪不邪。致尊其使，然後可致也。」於是上使先驗小方，鬬旗，旗自相觸擊。"}],"rationale":"依本篇封禪、方士、授官與神異引語的明示語境判讀異稱；神祇或傳說不轉為已確證生平，跨篇同指仍待版本與專門研究核對。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji117-daren-xianmen","person_id":"44s_fyq_t0d","surfaces":["羡門"],"scope":"cross_chapter","chapter_ids":["c-shiji-117-xiangru","c-shiji-006-shihuang"],"status":"contextual_provisional","confidence_level":"high","identification_basis":{"kind":"named_legendary_referent_with_explicit_commentary","target_mention_ids":["c-shiji-117-xiangru:m052-0089"],"historical_event_attendance_not_inferred":true},"evidence":[{"chapter_id":"c-shiji-117-xiangru","source_id":"s-shiji117-xiangru","paragraph_id":"c-shiji-117-xiangru:p052","quote":"邪絕少陽而登太陰兮，與真人乎相求。互折窈窕以右轉兮，橫厲飛泉以正東。悉徵靈圉而選之兮，部乘眾神於瑤光。使五帝先導兮，反太一而從陵陽。左玄冥而右含靁兮，前陸離而後潏湟。厮征北僑而役羡門兮，屬岐伯使尚方。祝融驚而蹕御兮，清氛氣而後行。屯余車其萬乘兮，綷雲蓋而樹華旗。使勾芒其將行兮，吾欲往乎南嬉。","mention_ids":["c-shiji-117-xiangru:m052-0089"]},{"chapter_id":"c-shiji-006-shihuang","source_id":"s-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p039","quote":"三十二年，始皇之碣石，使燕人盧生求羨門、高誓。刻碣石門。壞城郭，決通隄防。其辭曰：","mention_ids":["c-shiji-006-shihuang:p039:m0017"]}],"references":[{"title":"《漢書》卷57下·張揖釋羡門、岐伯，顏師古辨伯僑","url":"https://github.com/kanripo/KR2a0007/blob/683113d4baf6febecaf2ccb7913df87c4d68d454/KR2a0007_057.txt#L937-L939","quote":"厮征伯僑而役羡門兮詔岐伯使尚方(應劭曰厮役也/張揖曰伯僑仙)¶\n(人王子僑也羡門碣石山上仙人羡門髙也尚主也岐/伯者黄帝太醫屬使主方藥也師古曰征伯僑者仙人)¶\n(姓征名伯僑非王子僑也郊祀志征字作/正其音同耳或說云征謂役使之非也)祝融警而蹕¶","source_commit":"683113d4baf6febecaf2ccb7913df87c4d68d454","source_blob":"44cd0a168123204ab8369c8382018dbaaa846a86","cached_response_sha256":"024b03fcdb819f2edf0c84f816d618653f6fdafa4b48e6c2c36ec8fbe2ce1210","verified_extent":{"start_line":851,"end_line":980},"scope":"ancient_commentary_identification","image_verified":false}],"rationale":"張揖釋碣石仙人羡門高，與始皇本紀碣石求羨門的名號及地域互證；保留羡／羨原字，不把高誓併成同名，也不補仙人生卒或任期。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p039","text":"三十二年，始皇之碣石，使燕人盧生求羨門、高誓。刻碣石門。壞城郭，決通隄防。其辭曰：","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:p039:m0005","start":5,"end":7,"surface":"始皇","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0012","start":12,"end":16,"surface":"燕人盧生","kind":"person","person_id":"17c_7g8_b8g","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0017","start":17,"end":19,"surface":"羨門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:p039:m0020","start":20,"end":22,"surface":"高誓","kind":"person","person_id":"0d8_fpd_jlq","status":"contextual_provisional"}],"chapter_id":"c-shiji-006-shihuang","book_id":"b-shiji-006","work_id":"w-shiji","source_id":"s-shiji-006-shihuang"},{"id":"c-shiji-012-wudi:p017","text":"其春，樂成侯上書言欒大。欒大，膠東宮人，故嘗與文成將軍同師，已而為膠東王尚方。而樂成侯姊為康王后，毋子。康王死，他姬子立為王。而康后有淫行，與王不相中（得），相危以法。康后聞文成已死，而欲自媚於上，乃遣欒大因樂成侯求見言方。天子既誅文成，後悔恨其早死，惜其方不盡，及見欒大，大悅。大為人長美，言多方略，而敢為大言，處之不疑。大言曰：「臣嘗往來海中，見安期、羨門之屬。顧以為臣賤，不信臣。又以為康王諸侯耳，不足予方。臣數言康王，康王又不用臣。臣之師曰：『黃金可成，而河決可塞，不死之藥可得，僊人可致也。』臣恐效文成，則方士皆掩口，惡敢言方哉！」上曰：「文成食馬肝死耳。子誠能修其方，我何愛乎！」大曰：「臣師非有求人，人者求之。陛下必欲致之，則貴其使者，令有親屬，以客禮待之，勿卑，使各佩其信印，乃可使通言於神人。神人尚肯邪不邪。致尊其使，然後可致也。」於是上使先驗小方，鬬旗，旗自相觸擊。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-012-wudi:m017-0003","start":3,"end":6,"surface":"樂成侯","kind":"person","person_id":"hxk_jd2_eqg","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0009","start":9,"end":11,"surface":"欒大","kind":"person","person_id":"b4l_2ug_qy3","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0012","start":12,"end":14,"surface":"欒大","kind":"person","person_id":"b4l_2ug_qy3","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0023","start":23,"end":27,"surface":"文成將軍","kind":"person","person_id":"zg6_76t_xid","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0033","start":33,"end":36,"surfa