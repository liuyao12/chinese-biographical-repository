_qy3","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0162","start":162,"end":163,"surface":"大","kind":"person","person_id":"b4l_2ug_qy3","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0175","start":175,"end":177,"surface":"安期","kind":"person","person_id":"91s_bsz_pe8","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0178","start":178,"end":180,"surface":"羨門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0196","start":196,"end":198,"surface":"康王","kind":"person","person_id":"b8c_ev6_7ax","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0210","start":210,"end":212,"surface":"康王","kind":"person","person_id":"b8c_ev6_7ax","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0213","start":213,"end":215,"surface":"康王","kind":"person","person_id":"b8c_ev6_7ax","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0220","start":220,"end":223,"surface":"臣之師","kind":"unresolved","person_id":null,"status":"unresolved","note":"神祇、群體、匿名者或未定指代，保留來源，不補未見姓名與成員。"},{"id":"c-shiji-012-wudi:m017-0254","start":254,"end":256,"surface":"文成","kind":"person","person_id":"zg6_76t_xid","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0275","start":275,"end":277,"surface":"文成","kind":"person","person_id":"zg6_76t_xid","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0296","start":296,"end":297,"surface":"大","kind":"person","person_id":"b4l_2ug_qy3","status":"contextual_provisional"},{"id":"c-shiji-012-wudi:m017-0312","start":312,"end":314,"surface":"陛下","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"}],"chapter_id":"c-shiji-012-wudi","book_id":"b-shiji-012","work_id":"w-shiji","source_id":"s-shiji-012-wudi"},{"id":"c-shiji-117-xiangru:p052","text":"邪絕少陽而登太陰兮，與真人乎相求。互折窈窕以右轉兮，橫厲飛泉以正東。悉徵靈圉而選之兮，部乘眾神於瑤光。使五帝先導兮，反太一而從陵陽。左玄冥而右含靁兮，前陸離而後潏湟。厮征北僑而役羡門兮，屬岐伯使尚方。祝融驚而蹕御兮，清氛氣而後行。屯余車其萬乘兮，綷雲蓋而樹華旗。使勾芒其將行兮，吾欲往乎南嬉。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-117-xiangru:m052-0011","start":11,"end":13,"surface":"真人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m052-0036","start":36,"end":38,"surface":"靈圉","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m052-0045","start":45,"end":47,"surface":"眾神","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m052-0052","start":52,"end":54,"surface":"五帝","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本句神帝群稱，不指定五個世系人物；五畤與古注轉報五時分存。"},{"id":"c-shiji-117-xiangru:m052-0059","start":59,"end":61,"surface":"太一","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m052-0063","start":63,"end":65,"surface":"陵陽","kind":"person","person_id":"i4v_y28_wx0","status":"contextual_provisional","interpretation_note":"古注明稱仙人陵陽子明，與陽子古注所述陽陵子不能倒字合併。"},{"id":"c-shiji-117-xiangru:m052-0067","start":67,"end":69,"surface":"玄冥","kind":"person","person_id":"dal_xne_xt3","status":"contextual_provisional","interpretation_note":"古注稱北方黑帝之佐，只記神話身份，不補官爵任期或與其他祖系相接。"},{"id":"c-shiji-117-xiangru:m052-0071","start":71,"end":73,"surface":"含靁","kind":"person","person_id":"21k_m7f_sxc","status":"contextual_provisional","interpretation_note":"本篇含靁依所引注為黔嬴，造化神與水神兩說分存；不改原字，不將外部用字冒作本文別名。"},{"id":"c-shiji-117-xiangru:m052-0076","start":76,"end":78,"surface":"陸離","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本篇陸離與漢書長離的神名／靈鳥解釋分存，未改字或強接個人。"},{"id":"c-shiji-117-xiangru:m052-0080","start":80,"end":82,"surface":"潏湟","kind":"person","person_id":"oj8_zfy_dkl","status":"contextual_provisional","interpretation_note":"本篇潏湟依注為神名；漢書矞皇用字另存，不先作跨見證別名定論。"},{"id":"c-shiji-117-xiangru:m052-0085","start":85,"end":87,"surface":"北僑","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"本篇北僑與《漢書》伯僑用字不同；各注解釋與分詞並存，未把北、伯或征字自動改寫，也未接成已定人物。"},{"id":"c-shiji-117-xiangru:m052-0089","start":89,"end":91,"surface":"羡門","kind":"person","person_id":"44s_fyq_t0d","status":"contextual_provisional","interpretation_note":"張揖釋碣石仙人羡門高，與始皇本紀碣石求羨門的名號及地域互證；保留羡／羨原字，不把高誓併成同名，也不補仙人生卒或任期。"},{"id":"c-shiji-117-xiangru:m052-0094","start":94,"end":96,"surface":"岐伯","kind":"person","person_id":"l4l_iz8_ao0","status":"contextual_provisional","interpretation_note":"本篇岐伯主方藥，張揖明釋黃帝太醫；孝武本紀公玉帶亦引黃帝時岐伯，暫接同一傳說人物，不據賦辭增造官職或出行事件。"},{"id":"c-shiji-117-xiangru:m052-0100","start":100,"end":102,"surface":"祝融","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-117-xiangru:m052-0132","start":132,"end":134,"surface":"勾芒","kind":"person","person_id":"hd8_aho_qei","status":"contextual_provisional","interpretation_note":"本篇勾芒與漢書句芒各存，古注稱東方青帝之佐；不按造形補生平或親屬。"}],"chapter_id":"c-shiji-117-xiangru","book_id":"b-shiji-117","work_id":"w-shiji","source_id":"s-shiji117-xiangru"}],"sources":[{"chapter_id":"c-shiji-006-shihuang","work_id":"w-shiji","book_id":"b-shiji-006","source_id":"s-shiji-006-shihuang","source":{"title":"史記／卷006","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷006","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷006&oldid=7907969","revision_id":7907969,"accessed_on":"2026-10-09","extent":"數位見證127個文字區塊，含16個dd刻辭或嵌入引文及卷末附載班固記；排除導覽、跨站連結與註號。","image_verified":false,"rights":"古代原文與附載文字；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"note":"正文未改寫；行內校勘標記及附載文字仍待逐處核對。固定版本正文HTML重讀一致。","editorial_readings":[{"paragraph_id":"c-shiji-006-shihuang:p010","witness_form":"（四）［是］","body_reading":"四","note":"數位見證行內校勘標記另存；正文保留改讀前的字，不稱已校定底本。"},{"paragraph_id":"c-shiji-006-shihuang:p016","witness_form":"（薊）［荊］","body_reading":"薊","note":"數位見證行內校勘標記另存；正文保留改讀前的字，不稱已校定底本。"},{"paragraph_id":"c-shiji-006-shihuang:p051","witness_form":"（其）","body_reading":"","note":"數位見證行內刪字標記另存；未核底本，不稱校定讀法。"},{"paragrap