{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005020","identity_policy":"contextual_provisional","person_ids":["cbr-p000677","cbr-p005020"],"persons":[{"id":"cbr-p000677","label":"涉閒","status":"active","historicity":"historical_tradition","aliases":[{"surface":"涉閒","mention_ids":["c-shiji-007-xiangyu:m009-0060","c-shiji-007-xiangyu:m012-0120"]}],"evidence":[{"mention_id":"c-shiji-007-xiangyu:m009-0060","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p009","quote":"涉閒"},{"mention_id":"c-shiji-007-xiangyu:m012-0120","chapter_id":"c-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p012","quote":"涉閒"}]},{"id":"cbr-p005020","label":"渉閒（張耳陳餘列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"渉閒","mention_ids":["c-shiji-089-zhanger:m016-0094"]}],"evidence":[{"mention_id":"c-shiji-089-zhanger:m016-0094","chapter_id":"c-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p016","quote":"渉閒"}]}],"mentions":[{"id":"c-shiji-007-xiangyu:m009-0060","start":60,"end":62,"surface":"涉閒","kind":"person","person_id":"cbr-p000677","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p009","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m012-0120","start":120,"end":122,"surface":"涉閒","kind":"person","person_id":"cbr-p000677","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p012","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-089-zhanger:m016-0094","start":94,"end":96,"surface":"渉閒","kind":"person","person_id":"cbr-p005020","status":"contextual_provisional","paragraph_id":"c-shiji-089-zhanger:p016","chapter_id":"c-shiji-089-zhanger"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji089-043","person_id":"cbr-p005020","scope":"same_chapter","chapter_ids":["c-shiji-089-zhanger"],"status":"contextual_provisional","rationale":"按明示姓名及局部語境承接；武臣與趙歇、張敖的趙王用稱限各段，張黡張黶按同行事件暫接但原字分存。未名者不補姓名。","reviewer":"Codex（AI 代理）","surfaces":["渉閒"],"evidence":[{"paragraph_id":"c-shiji-089-zhanger:p016","quote":"當是時，燕、齊、楚聞趙急，皆來救。張敖亦北收代兵，得萬餘人，來，皆壁餘旁，未敢撃秦。項羽兵數絶章邯甬道，王離軍乏食，項羽悉引兵渡河，遂破章邯。章邯引兵解，諸侯軍乃敢撃圍鉅鹿秦軍，遂虜王離。渉閒自殺。卒存鉅鹿者，楚力也。"}]}],"equivalence_decisions":[{"id":"eq-shiji089-she","person_ids":["cbr-p000677","cbr-p005020"],"canonical_person_id":"cbr-p000677","scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-089-zhanger"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-007-xiangyu","source_id":"s-shiji-007-xiangyu","paragraph_id":"c-shiji-007-xiangyu:p012","quote":"項羽已殺卿子冠軍，威震楚國，名聞諸侯。乃遣當陽君、蒲將軍將卒二萬渡河，救鉅鹿。戰少利，陳餘復請兵。項羽乃悉引兵渡河，皆沈船，破釜甑，燒廬舍，持三日糧，以示士卒必死，無一還心。於是至則圍王離，與秦軍遇，九戰，絕其甬道，大破之，殺蘇角，虜王離。涉閒不降楚，自燒殺。當是時，楚兵冠諸侯。諸侯軍救鉅鹿下者十餘壁，莫敢縱兵。及楚擊秦，諸將皆從壁上觀。楚戰士無不一以當十，楚兵呼聲動天，諸侯軍無不人人惴恐。於是已破秦軍，項羽召見諸侯將，入轅門，無不膝行而前，莫敢仰視。項羽由是始為諸侯上將軍，諸侯皆屬焉。","mention_ids":["c-shiji-007-xiangyu:m012-0120"]},{"chapter_id":"c-shiji-089-zhanger","source_id":"s-shiji-089-zhanger","paragraph_id":"c-shiji-089-zhanger:p016","quote":"當是時，燕、齊、楚聞趙急，皆來救。張敖亦北收代兵，得萬餘人，來，皆壁餘旁，未敢撃秦。項羽兵數絶章邯甬道，王離軍乏食，項羽悉引兵渡河，遂破章邯。章邯引兵解，諸侯軍乃敢撃圍鉅鹿秦軍，遂虜王離。渉閒自殺。卒存鉅鹿者，楚力也。","mention_ids":["c-shiji-089-zhanger:m016-0094"]}],"rationale":"渉閒涉閒鉅鹿秦軍敗後自殺的姓名與特定事件相配；自燒殺與自殺原文字樣分存。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-007-xiangyu:p009","text":"章邯已破項梁軍，則以為楚地兵不足憂，乃渡河擊趙，大破之。當此時，趙歇為王，陳餘為將，張耳為相，皆走入鉅鹿城。章邯令王離、涉閒圍鉅鹿，章邯軍其南，筑甬道而輸之粟。陳餘為將，將卒數萬人而軍鉅鹿之北，此所謂河北之軍也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m009-0000","start":0,"end":2,"surface":"章邯","kind":"person","person_id":"cbr-p000605","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m009-0004","start":4,"end":6,"surface":"項梁","kind":"person","person_id":"cbr-p000603","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m009-0032","start":32