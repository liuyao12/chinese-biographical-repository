8,"end":32,"surface":"公子囊瓦","kind":"person","person_id":"548_u01_jnh","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p010","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m011-0038","start":38,"end":40,"surface":"囊瓦","kind":"person","person_id":"548_u01_jnh","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p011","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m011-0115","start":115,"end":117,"surface":"子常","kind":"person","person_id":"548_u01_jnh","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p011","chapter_id":"c-shiji-066-wu"},{"id":"c-shiji-066-wu:m011-0135","start":135,"end":137,"surface":"子常","kind":"person","person_id":"548_u01_jnh","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p011","chapter_id":"c-shiji-066-wu"}],"relations":[],"title_holdings":[{"id":"th-shiji066-011","person_id":"548_u01_jnh","title":"公子","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-066-wu","source_id":"s-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p010","quote":"四年，吳伐楚，取六與灊。五年，伐越，敗之。六年，楚昭王使公子囊瓦將兵伐吳。吳使伍員迎擊，大破楚軍於豫章，取楚之居巢。"}],"attestations":[{"id":"th-shiji066-011:a001","paragraph_id":"c-shiji-066-wu:p010","start":28,"end":30,"surface":"公子","person_mention_id":"c-shiji-066-wu:m010-0028","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官事件與文獻用稱分存。首次提及、逃亡、死亡不推定任期終點；平王、昭王、闔廬、夫差王稱隨敘事分辨。夫概自立王不作合法授爵，封堂谿未補侯爵；王子綦佯充王及石乞事成為卿的未遂條件均不當實際任職。白公的號與封邑分存，未確定爵級。來源相對年序未換算為精確紀年，版本及稱號性質仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-026","person_id":"548_u01_jnh","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["公子囊瓦","囊瓦","子常"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p010","quote":"四年，吳伐楚，取六與灊。五年，伐越，敗之。六年，楚昭王使公子囊瓦將兵伐吳。吳使伍員迎擊，大破楚軍於豫章，取楚之居巢。"},{"paragraph_id":"c-shiji-066-wu:p011","quote":"九年，吳王闔廬謂子胥、孫武曰：「始子言郢未可入，今果何如？」二子對曰：「楚將囊瓦貪，而唐、蔡皆怨之。王必欲大伐之，必先得唐、蔡乃可。」闔廬聽之，悉興師與唐、蔡伐楚，與楚夾漢水而陳。吳王之弟夫概將兵請從，王不聽，遂以其屬五千人擊楚將子常。己卯，楚昭王出奔。庚辰，吳王入郢。子常敗走，奔鄭。於是吳乘勝而前，五戰，遂至郢。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-066-wu:p010","text":"四年，吳伐楚，取六與灊。五年，伐越，敗之。六年，楚昭王使公子囊瓦將兵伐吳。吳使伍員迎擊，大破楚軍於豫章，取楚之居巢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m010-0024","start":24,"end":27,"surface":"楚昭王","kind":"person","person_id":"rjl_5bl_0dm_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m010-0028","start":28,"end":32,"surface":"公子囊瓦","kind":"person","person_id":"548_u01_jnh","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m010-0039","start":39,"end":41,"surface":"伍員","kind":"person","person_id":"g9h_5ih_ug1_A","status":"contextual_provisional"}],"chapter_id":"c-shiji-066-wu","book_id":"b-shiji-066","work_id":"w-shiji","source_id":"s-shiji-066-wu"},{"id":"c-shiji-066-wu:p011","text":"九年，吳王闔廬謂子胥、孫武曰：「始子言郢未可入，今果何如？」二子對曰：「楚將囊瓦貪，而唐、蔡皆怨之。王必欲大伐之，必先得唐、蔡乃可。」闔廬聽之，悉興師與唐、蔡伐楚，與楚夾漢水而陳。吳王之弟夫概將兵請從，王不聽，遂以其屬五千人擊楚將子常。己卯，楚昭王出奔。庚辰，吳王入郢。子常敗走，奔鄭。於是吳乘勝而前，五戰，遂至郢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m011-0003","start":3,"end":7,"surface":"吳王闔廬","kind":"person","person_id":"yb7_umd_09d","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0008","start":8,"end":10,"surface":"子胥","kind":"person","person_id":"g9h_5ih_ug1_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m011-0011","start":11,"end":13,"surface":"孫武","kind":"person","person_id":"own_sic_s7j","status":"contextual_provisional"},{"id":"c-shiji-0