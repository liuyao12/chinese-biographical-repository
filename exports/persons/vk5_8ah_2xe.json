然其游知交皆其大父行，天下有名之士也。武帝立，莊稍遷為魯中尉、濟南太守、江都相，至九卿為右內史。以武安侯魏其時議，貶秩為詹事，遷為大農令。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-120-jizheng:m016-0000","start":0,"end":2,"surface":"鄭莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0009","start":9,"end":11,"surface":"張羽","kind":"person","person_id":"68o_y46_3mf","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0020","start":20,"end":22,"surface":"孝景","kind":"person","person_id":"kkh_kew_u6x","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0046","start":46,"end":48,"surface":"故人","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m016-0051","start":51,"end":53,"surface":"賓客","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m016-0069","start":69,"end":70,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0101","start":101,"end":107,"surface":"天下有名之士","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-120-jizheng:m016-0109","start":109,"end":111,"surface":"武帝","kind":"person","person_id":"fu0_u16_g5t","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0113","start":113,"end":114,"surface":"莊","kind":"person","person_id":"jws_b08_hob","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0139","start":139,"end":142,"surface":"武安侯","kind":"person","person_id":"6rp_jqd_p41","status":"contextual_provisional"},{"id":"c-shiji-120-jizheng:m016-0142","start":142,"end":144,"surface":"魏其","kind":"person","person_id":"vk5_8ah_2xe","status":"contextual_provisional"}],"chapter_id":"c-shiji-120-jizheng","book_id":"b-shiji-120","work_id":"w-shiji","source_id":"s-shiji120-jizheng"}],"sources":[{"chapter_id":"c-shiji-120-jizheng","work_id":"w-shiji","book_id":"b-shiji-120","source_id":"s-shiji120-jizheng","so