al_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-035-guancai:m038-0029","start":29,"end":32,"surface":"中行偃","kind":"person","person_id":"rk0_huv_709","status":"contextual_provisional","paragraph_id":"c-shiji-035-guancai:p038","chapter_id":"c-shiji-035-guancai"},{"id":"c-shiji-039-jin:m112-0304","start":304,"end":307,"surface":"中行偃","kind":"person","person_id":"rk0_huv_709","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p112","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m112-0408","start":408,"end":411,"surface":"中行偃","kind":"person","person_id":"rk0_huv_709","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p112","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m113-0012","start":12,"end":15,"surface":"中行偃","kind":"person","person_id":"rk0_huv_709","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p113","chapter_id":"c-shiji-039-jin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji035-097","person_id":"rk0_huv_709","surfaces":["中行偃"],"scope":"same_chapter","chapter_ids":["c-shiji-035-guancai"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p038","quote":"成公三年，晉厲公伐曹，虜成公以歸，已復釋之。五年，晉欒書、中行偃使程滑弒其君厲公。二十三年，成公卒，子武公勝立。武公二十六年，楚公子棄疾弒其君靈王代立。二十七年，武公卒，子平公（頃）［須］立。平公四年卒，子悼公午立。是歲，宋、衛、陳、鄭皆火。"}],"rationale":"依文王子同母十人、蔡曹君世系、蔡女船中事件、楚公子圍弒其王及城濮／伐曹的具體敘事暫定異稱。郟敖／夾敖按同一事件、釐／僖負羈按本卷論贊暫同指；不同國與同國不同世代的同名者分開。匿名者、校勘及跨篇同指仍待核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-113","person_id":"rk0_huv_709","surfaces":["中行偃"],"scope":"cross_chapter","chapter_ids":["c-shiji-035-guancai","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-035-guancai:p038","quote":"成公三年，晉厲公伐曹，虜成公以歸，已復釋之。五年，晉欒書、中行偃使程滑弒其君厲公。二十三年，成公卒，子武公勝立。武公二十六年，楚公子棄疾弒其君靈王代立。二十七年，武公卒，子平公（頃）［須］立。平公四年卒，子悼公午立。是歲，宋、衛、陳、鄭皆火。"},{"paragraph_id":"c-shiji-039-jin:p112","quote":"厲公多外嬖姬，歸，欲盡去群大夫而立諸姬兄弟。寵姬兄曰胥童，嘗與郤至有怨，及欒書又怨郤至不用其計而遂敗楚，乃使人閒謝楚。楚來詐厲公曰：「鄢陵之戰，實至召楚，欲作亂，内子周立之。會與國不具，是以事不成。」厲公告欒書。欒書曰：「其殆有矣！願公試使人之周微考之。」果使郤至於周。欒書又使公子周見郤至，郤至不知見賣也。厲公驗之，信然，遂怨郤至，欲殺之。八年，厲公獵，與姬飲，郤至殺豕奉進，宦者奪之。郤至射殺宦者。公怒，曰：「季子欺予！」將誅三郤，未發也。郤鉤欲攻公，曰：「我雖死，公亦病矣。」郤至曰：「信不反君，智不害民，勇不作亂。失此三者，誰與我？我死耳！」十二月壬午，公令胥童以兵八百人襲攻殺三郤。胥童因以劫欒書、中行偃于朝，曰：「不殺二子，患必及公。」公曰：「一旦殺三卿，寡人不忍益也。」對曰：「人將忍君。」公弗聽，謝欒書等以誅郤氏罪：「大夫復位。」二子頓首曰：「幸甚幸甚！」公使胥童爲卿。閏月乙卯，厲公游匠驪氏，欒書、中行偃以其黨襲捕厲公，囚之，殺胥童，而使人迎公子周于周而立之，是爲悼公。"},{"paragraph_id":"c-shiji-039-jin:p113","quote":"悼公元年正月庚申，欒書、中行偃弒厲公，葬之以一乘車。厲公囚六日死，死十日庚午，智罃迎公子周來，至絳，刑鷄與大夫盟而立之，是爲悼公。辛巳，朝武宮。二月乙酉，卽位。"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-035-guancai:p038","text":"成公三年，晉厲公伐曹，虜成公以歸，已復釋之。五年，晉欒書、中行偃使程滑弒其君厲公。二十三年，成公卒，子武公勝立。武公二十六年，楚公子棄疾弒其君靈王代立。二十七年，武公卒，子平公（頃）［須］立。平公四年卒，子悼公午立。是歲，宋、衛、陳、鄭皆火。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-035-guancai:m038-0000","start":0,"end":2,"surface":"成公","kind":"person","person_id":"rr8_o9c_jc1","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0005","start":5,"end":8,"surface":"晉厲公","kind":"person","person_id":"f42_zl0_lkq","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0012","start":12,"end":14,"surface":"成公","kind":"person","person_id":"rr8_o9c_jc1","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0025","start":25,"end":28,"surface":"晉欒書","kind":"person","person_id":"c8b_f8t_ylf","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0029","start":29,"end":32,"surface":"中行偃","kind":"person","person_id":"rk0_huv_709","status":"contextual_provisional"},{"id":"c-shiji-035-guancai:m038-0033","start":33,"end":35,"surface":"程滑","kind":"person","person_id":"ox6_lqa_iko","status":"contextual_provisional"},{"id":"c-shi