variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-016-duji-dushu:unit031:m0338","start":338,"end":340,"surface":"孟思","kind":"person","person_id":"6hx_yai_3a6","status":"contextual_provisional","interpretation_note":"與王才所為不法、京師震動，特定樂人孟思；不推性別或宮廷親屬。","paragraph_id":"c-sanguozhi-016-duji-dushu:unit031","chapter_id":"c-sanguozhi-016-duji-dushu"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-016-duji-dushu:unit031","text_layer":"received_chapter","text":"樂安廉昭以才能抜擢頗好言事恕上疏極諫曰伏見尚書郎廉昭奏左丞曹璠以罰當關不依詔坐判問又云諸當坐者别奏尚書令陳矯自奏不敢辭罰亦不敢以處重為恭意至懇惻臣竊愍然為朝廷惜之夫聖人不擇世而興不易民而治然而生必有賢智之佐者蓋進之以道帥之以禮故也古之帝王之所以能輔世長民者莫不遠得百姓之懽心近盡羣臣之智力誠使今朝任職之臣皆天下之選而不能盡其力不可謂能使人若非天下之選亦不可謂能官人陛下憂勞萬幾或親燈火而庶事不康刑禁日弛豈非股肱不稱之明效歟原其所由非獨臣有不盡忠亦主有不能使百里奚愚於虞而智於秦豫讓苟容中行而著節智伯斯則古人之明騐矣今臣言一朝皆不忠是誣一朝也然其事類可推而得陛下感帑藏之不充實而軍事未息至乃斷四時之賦衣薄御府之私榖帥由聖意舉朝稱明與聞政事密勿大臣寜有懇懇憂此者乎騎都尉王才幸樂人孟思所為不法振動京都而其罪狀發於小吏公卿大臣初無一言自陛下踐阼以來司隷校尉御史中丞寜有舉綱維以督姦宄使朝廷肅然者邪若陛下以為今世無良才朝廷乏賢佐豈可追望稷契之遐蹤坐待來世之儁乂乎今之所謂賢者盡有大官而享厚禄矣然而奉上之節未立向公之心不一者委任之責不專而俗多忌諱故也臣以為忠臣不必親親臣不必忠何者以其居無嫌之地而事得自盡也今有疏者毁人不實其所毁而必曰私報所憎譽人不實其所譽而必曰私愛所親左右或因之以進憎愛之說非獨毁譽有之政事損益亦皆有嫌陛下當思所以闡廣朝臣之心篤厲有道之節使之自同古人望與竹帛耳反使如廉昭者擾亂其間臣懼大臣遂將容身保位坐觀得失為來世戒也昔周公戒魯侯曰無使大臣怨乎不以不言賢愚明皆當世用也堯數舜之功稱去四凶不言大小有罪則去也今者朝臣不自以為不能以陛下為不任也不自以為不智以陛下為不問也陛下何不遵周公之所以用大舜之所以去使侍中尚書坐則侍幄帷行則從華輦親對詔問所陳必達則羣臣之行能否皆可得而知忠能者進闇劣者退誰敢依違而不自盡以陛下之聖明親與羣臣論議政事使羣臣人得自進人自以為親人思所以報賢愚能否在陛下之所用以此治事何事不辦以此建功何功不成每有軍事詔書常曰誰當憂此者邪吾當自憂耳近詔又曰憂公忘私者必不然但先公後私即自辨也伏讀明詔乃知聖思究盡下情然亦怪陛下不知其本而憂其末也人之能否實有本性雖臣亦以為朝臣不盡稱職也明主之用人也使能者不敢遺其力而不能者不得處非其任選舉非其人未必為有罪也舉朝共容非其人乃為怪耳陛下知其不盡力也而代之憂其職知其不能也而敎之治其事豈徒主勞而臣逸哉雖聖賢並世終不能以此為治也陛下又患臺閣禁令之不密人事請屬之不絶聽伊尹作迎客出入之制選司徒更惡吏以守寺門威禁由之實未得為禁之本也昔漢安帝時少府竇嘉辟廷尉郭躬無罪之兄子猶見舉奏章劾紛紛近司隷校尉孔羡辟大將軍狂悖之弟而有司嘿爾望風希指甚於受屬選舉不以實人事之大者也","source_position":{"source_layer":"received_body","first_line":264,"last_line":323,"raw_projection_ref":"source-evidence/sgz016-duji-dushu/fixed-complete-unit.json"},"mentions":[{"id":"c-sanguozhi-016-duji-dushu:unit031:m0002","start":2,"end":4,"surface":"廉昭","kind":"person","person_id":"odi_u07_f5c","status":"contextual_provisional","interpretation_note":"樂安廉昭奏曹璠、杜恕諫其傾側，後昭等均承此廉昭；不沿先前鎮北吕昭。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0013","start":13,"end":14,"surface":"恕","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0024","start":24,"end":26,"surface":"廉昭","kind":"person","person_id":"odi_u07_f5c","status":"contextual_provisional","interpretation_note":"樂安廉昭奏曹璠、杜恕諫其傾側，後昭等均承此廉昭；不沿先前鎮北吕昭。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0029","start":29,"end":31,"surface":"曹璠","kind":"person","person_id":"vcb_arg_1ul","status":"contextual_provisional","interpretation_note":"廉昭所奏左丞曹璠為來源內特定人，不按姓曹接皇族或借任官主帝姓名。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0052","start":52,"end":54,"surface":"陳矯","kind":"person","person_id":"y5v_7tv_nxw","status":"contextual_provisional","interpretation_note":"尚書令陳矯自奏承廉昭案，與既有022/盧毓來源尚書令陳矯同身份；不將動詞陳或考功者陳周漢之法為陳矯。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0072","start":72,"end":73,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0182","start":182,"end":184,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0228","start":228,"end":231,"surface":"百里奚","kind":"person","person_id":"ylb_ttg_8dr","status":"contextual_provisional","interpretation_note":"愚於虞智於秦為秦穆公百里奚的具體典故，源奚和既存傒字樣分存，不造另一人。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0238","start":238,"end":240,"surface":"豫讓","kind":"person","person_id":"op3_d14_c7u","status":"contextual_provisional","interpretation_note":"苟容中行著節智伯為刺客列傳豫讓事，具體所事兩氏及捨身角色可合。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0242","start":242,"end":244,"surface":"中行","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"豫讓先主中行氏族稱，原句未唯一名其主人，不把氏族當單人。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0247","start":247,"end":249,"surface":"智伯","kind":"person","person_id":"fks_8ov_okp","status":"contextual_provisional","interpretation_note":"豫讓著節智伯之所事者，與趙世家智伯死亡及豫讓復仇同人物；不是後世名智伯。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0258","start":258,"end":259,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0278","start":278,"end":280,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0333","start":333,"end":335,"surface":"王才","kind":"person","person_id":"kfz_gjl_y7k","status":"contextual_provisional","interpretation_note":"與幸樂人孟思不法事件明騎都尉王才，未補其籍貫/親屬。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0338","start":338,"end":340,"surface":"孟思","kind":"person","person_id":"6hx_yai_3a6","status":"contextual_provisional","interpretation_note":"與王才所為不法、京師震動，特定樂人孟思；不推性別或宮廷親屬。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0365","start":365,"end":367,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0396","start":396,"end":398,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0414","start":414,"end":415,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"contextual_provisional","interpretation_note":"詔稷勤百穀、注明周棄，疏稷契相輔同古人后稷；不讀作任職官稱或杜氏人物。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0415","start":415,"end":416,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"contextual_provisional","interpretation_note":"冥為契六世孫及疏稷契佐唐虞，為商先祖契；不按契約普通詞標。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0555","start":555,"end":557,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0587","start":587,"end":589,"surface":"廉昭","kind":"person","person_id":"odi_u07_f5c","status":"contextual_provisional","interpretation_note":"樂安廉昭奏曹璠、杜恕諫其傾側，後昭等均承此廉昭；不沿先前鎮北吕昭。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0594","start":594,"end":595,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0614","start":614,"end":616,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"contextual_provisional","interpretation_note":"周公戒魯侯無使大臣怨乎不以的經典告子故事，首選周公旦，排共和周公/黑肩等。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0617","start":617,"end":619,"surface":"魯侯","kind":"person","person_id":"y4i_pjk_4gn_ADA","status":"contextual_provisional","interpretation_note":"周公戒魯侯語境、魯公為周公子伯禽的經典首選；不是戰國任一魯侯，源未明諱須contextual。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0638","start":638,"end":639,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"contextual_provisional","interpretation_note":"堯數舜功、去四凶為五帝傳統堯；不把唐虞每個王朝字都當個人。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0640","start":640,"end":641,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional","interpretation_note":"堯數舜功及大舜所以去四凶的上古人物；排漢景帝子舜。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0645","start":645,"end":647,"surface":"四凶","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"上古四凶為群體，未逐名不標單人。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0667","start":667,"end":669,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0680","start":680,"end":682,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0686","start":686,"end":688,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0691","start":691,"end":693,"surface":"周公","kind":"person","person_id":"y4i_pjk_4gn_AD","status":"contextual_provisional","interpretation_note":"周公戒魯侯無使大臣怨乎不以的經典告子故事，首選周公旦，排共和周公/黑肩等。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0697","start":697,"end":699,"surface":"大舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional","interpretation_note":"堯數舜功及大舜所以去四凶的上古人物；排漢景帝子舜。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0755","start":755,"end":757,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0790","start":790,"end":792,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0825","start":825,"end":826,"surface":"吾","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0866","start":866,"end":868,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0886","start":886,"end":887,"surface":"臣","kind":"person","person_id":"ip4_zrh_ttx","status":"contextual_provisional","interpretation_note":"本傳子恕嗣、務伯及幽州刺史，與034杜預父恕幽州刺史/幽死為具體父子官履橋。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0943","start":943,"end":945,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m0989","start":989,"end":991,"surface":"陛下","kind":"person","person_id":"932_46f_026","status":"contextual_provisional","interpretation_note":"太和散騎黃門侍郎杜恕疏及明帝崩為曹叡；長疏陛下受話人同此，後嘉平段先帝回指曹叡，不以最近宣王配。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m1008","start":1008,"end":1010,"surface":"伊尹","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"此迎客制度語境之伊尹/古制指涉未明，不直接沿古代殷臣，也不另造魏朝伊尹。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m1040","start":1040,"end":1043,"surface":"漢安帝","kind":"person","person_id":"7zd_hi5_fwe","status":"contextual_provisional","interpretation_note":"昔漢安帝時與少府竇嘉/郭躬案為東漢安帝，不取晉安帝；與後漢062安帝年世同指。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m1046","start":1046,"end":1048,"surface":"竇嘉","kind":"person","person_id":"qzm_7hy_ua4","status":"contextual_provisional","interpretation_note":"原明少府竇嘉辟郭躬兄子，漢安帝時；不與竇憲或竇武按族姓合。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m1051","start":1051,"end":1053,"surface":"郭躬","kind":"person","person_id":"xta_ah7_fqo","status":"contextual_provisional","interpretation_note":"原明廷尉郭躬及其兄子被辟，來源內漢代特定人，不接魏郭智/郭后或太原郭氏。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m1071","start":1071,"end":1073,"surface":"孔羡","kind":"person","person_id":"f0u_wfb_0um","status":"contextual_provisional","interpretation_note":"近司隷校尉孔羡辟大將軍弟，原羡不正羨；不依孔氏遠譜補世代。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m1074","start":1074,"end":1077,"surface":"大將軍","kind":"person","person_id":"dkn_ge4_286_AAAA","status":"contextual_provisional","interpretation_note":"裴松之明大將軍司馬宣王、第五弟通；又杜預宣王女壻，與晉034宣帝及037八達仲達身份合。"},{"id":"c-sanguozhi-016-duji-dushu:unit031:m1077","start":1077,"end":1081,"surface":"狂悖之弟","kind":"person","person_id":"dkn_ge4_286_AAAG","status":"contextual_provisional","interpretation_note":"裴注明宣王第五弟名通，與037安平孚本傳八達中通雅達的同家近系首選；不指蒯通或叔孫通。"}],"chapter_id":"c-sanguozhi-016-duji-dushu","book_id":"b-sanguozhi-016","work_id":"w-sanguozhi","source_id":"s-sanguozhi-016-duji-dushu-kr214fcafa"}],"sources":[{"chapter_id":"c-sanguozhi-016-duji-dushu","work_id":"w-sanguozhi","book_id":"b-sanguozhi-016","source_id":"s-sanguozhi-016-duji-dushu-kr214fcafa","source":{"title":"《三國志》卷十六杜畿、杜恕完整本傳及全部裴注","provider":"Kanripo","url":"https://github.com/kanripo/KR2a0012/blob/214fcafa79894355909c9d8c2c1533089e7791c6/KR2a0012_016.txt","permalink":"https://github.com/kanripo/KR2a0012/blob/214fcafa79894355909c9d8c2c1533089e7791c6/KR2a0012_016.txt","revision_id":"214fcafa79894355909c9d8c2c1533089e7791c6","source_commit":"214fcafa79894355909c9d8c2c1533089e7791c6","response_sha256":"82e8ba333863c0ad47843c72d6237a2d32b10bff3a28ec7f51d614bcb34c5e7f","accessed_on":"2026-10-23","extent":"固定原檔91–406行：杜畿字伯侯起至阮坦喪官王衍哭之，止鄭渾獨立本傳前；44層次單元，不稱全卷。","text_scope":"partial_chapter","review_status":"text_checked","image_verified":false,"license_url":"https://creativecommons.org/publicdomain/mark/1.0/","rights":"古籍原文；Kanripo固定數位文字見證，保來源歸屬。未核書影或實際古刊。","normalization":{"character_conversion":{},"extraction_note":"只移除版面頁碼、換行¶與外層注括號；正文/裴注依原次序、逐字位置全覆蓋。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year