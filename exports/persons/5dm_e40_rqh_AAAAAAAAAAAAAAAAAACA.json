05","quote_passage_ref":"data/corpus/shiji/086.json"}],"attestations":[{"id":"th-shiji086-002:a001","paragraph_id":"c-shiji-086-cike:p005","start":104,"end":105,"surface":"王","person_mention_id":"c-shiji-086-cike:m005-0102","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"accession","date_expression":null,"evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p005","quote_passage_ref":"data/corpus/shiji/086.json"}],"normalized_date":{"era":"BCE","era_year":526,"year":-525,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"光之父曰呉王諸樊。諸樊弟三人：次曰餘祭，次曰夷眛，次曰季子札。諸樊知季子札賢而不立太子，以次傳三弟，欲卒致國于季子札。諸樊既死，傳餘祭。餘祭死，傳夷眛。夷眛死，當傳季子札；季子札逃不肯立，呉人乃立夷眛之子僚爲王。公子光曰：「使以兄弟次邪，季子當立；必以子乎，則光眞適嗣，當立。」故嘗陰養謀臣以求立。","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p005","quote_passage_ref":"data/corpus/shiji/086.json"}],"references":[{"title":"《史記·十二諸侯年表》原紀年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","quote":"吳僚元年","scope":"received_parallel_event","image_verified":false,"table_cell_id":"shiji-014-r316-c15"},{"title":"《史記·十二諸侯年表》數位年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","quote":"526","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"table_cell_id":"shiji-014-r316-c00"}],"rationale":"按本篇具體事件與固定年表原格對讀；西元數字取數位編者附加對照，不是受傳文本原有紀年。未核書影或曆表，只到年，不換算月日。","reviewer":"Codex（AI 代理）","human_reviewed":false,"basis":{"kind":"parallel_event","source_event_quote":"呉人乃立夷眛之子僚爲王","reference_url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","reference_event_quote":"吳僚元年","reference_year_quote":"526"}}},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"實際授任與文獻用稱分存；四月丙子依本段事件，不換算絕對年。皇帝其明年保留相對日期；上客為禮遇。懸賞金邑、職稱首見、死亡、被虜或亡逃不推定任期起訖。 第二輪按明示立王、自立及立號分別記繼位或自立，不混為他人授予。","reviewer":"Codex（AI 代理）","source_term":"呉人乃立夷眛之子僚爲王"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[{"era":"BCE","era_year":515,"year":-514,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"四月丙子，光伏甲士於窟室中，而具酒請王僚。王僚使兵陳自宮至光之家，門戸階陛左右，皆王僚之親戚也。夾立侍，皆持長鈹。酒既酣，公子光詳爲足疾，入窟室中，使專諸置匕首魚炙之腹中而進之。既至王前，專諸擘魚，因以匕首刺王僚，王僚立死。左右亦殺專諸，王人擾亂。公子光出其伏甲以攻王僚之徒，盡滅之，遂自立爲王，是爲闔閭。闔閭乃封專諸之子以爲上卿。","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p007","person_mention_id":"c-shiji-086-cike:m007-0018","quote_passage_ref":"data/corpus/shiji/086.json"}],"references":[{"title":"《史記·十二諸侯年表》原紀年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","quote":"十二公子光使專諸殺僚，自立。","scope":"received_parallel_event","image_verified":false,"table_cell_id":"shiji-014-r327-c15"},{"title":"《史記·十二諸侯年表》數位年欄","url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","quote":"515","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false,"table_cell_id":"shiji-014-r327-c00"}],"rationale":"按本篇具體事件與固定年表原格對讀；西元數字取數位編者附加對照，不是受傳文本原有紀年。未核書影或曆表，只到年，不換算月日。","reviewer":"Codex（AI 代理）","human_reviewed":false,"basis":{"kind":"parallel_event","source_event_quote":"王僚立死","reference_url":"https://zh.wikisource.org/w/index.php?title=史記/卷014&oldid=2607001","reference_event_quote":"十二公子光使專諸殺僚，自立。","reference_year_quote":"515"},"record_id":"le-shiji086-005","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAACA","date_role":"life_event","event_type":"death"},{"era":"BCE","era_year":526,"year":-525,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"光之父曰呉王諸樊。諸樊弟三人：次曰餘祭，次曰夷眛，次曰季子札。諸樊知季子札賢而不立太子，以次傳三弟，欲卒致國于季子札。諸樊既死，傳餘祭。餘祭死，傳夷眛。夷眛死，當傳季子札；季子札逃不肯立，呉人乃立夷眛之子僚爲王。公子光曰：「使以兄弟次邪，季子當立；必以子乎，則光眞適嗣，當立。」故嘗陰養謀臣以求立。","evidence":[{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p005","quote_passage_ref":"data