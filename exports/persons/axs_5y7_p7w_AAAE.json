_note":"韋岐（韋放子，娶張率女），見本組原文及身份互校。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"axs_5y7_p7w_AAA","source_assertion_id":"a-liang028-fang-qi-father","evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-weifang-complete","source_id":"s-liangshu-028-weifang-complete-ws1511902","paragraph_id":"c-liangshu-028-weifang-complete:p004","quote":"放性弘厚篤實，輕財好施，于諸弟尤雍睦。每將遠別及行役初還，常同一室臥起，時稱爲「三姜」。初，放與吳郡張率皆有側室懷孕，因指爲婚姻。其後各產男女，未及成長而率亡，遺嗣孤弱，放常贍卹之。及爲北徐州，時有勢族請姻者，放曰：「吾不失信於故友。」乃以息岐娶率女，又以女適率子，時稱放能篤舊。長子粲嗣，別有傳。","subject_person_mention_id":"c-liangshu-028-weifang-complete:p004:m0121","object_person_mention_id":"c-liangshu-028-weifang-complete:p004:m0000","source_term":"息岐"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"放以其子岐娶張率女。"}}],"source_mention_summary":[{"source_id":"s-liangshu-028-weifang-complete-ws1511902","work_id":"w-liangshu","book_id":"b-liangshu-028","chapter_id":"c-liangshu-028-weifang-complete","raw_mention_count":1,"mention_ids":["c-liangshu-028-weifang-complete:p004:m0121"],"paragraph_ids":["c-liangshu-028-weifang-complete:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-liangshu-028-weifang-complete:p004:m0121","mention_ids":["c-liangshu-028-weifang-complete:p004:m0121"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-liangshu-028-weifang-complete-ws1511902"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_autho