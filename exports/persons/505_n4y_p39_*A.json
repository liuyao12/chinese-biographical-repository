iji-110-xiongnu:p004"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-shiji-110-xiongnu:m004-0288","mention_ids":["c-shiji-110-xiongnu:m004-0288"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-shiji-086-cike"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji110-003","subject_person_id":"505_n4y_p39_*A","predicate":"grandfather","object_person_id":"505_n4y_p39","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p004","quote":"自是之後百有餘年，晉悼公使魏絳和戎翟，戎翟朝晉。後百有餘年，趙襄子踰句注而破并代以臨胡貉。其後既與韓魏共滅智伯，分晉地而有之，則趙有代、句注之北，魏有河西、上郡，以與戎界邊。其後義渠之戎築城郭以自守，而秦稍蠶食，至於惠王，遂拔義渠二十五城。惠王擊魏，魏盡入西河及上郡于秦。秦昭王時，義渠戎王與宣太后亂，有二子。宣太后詐而殺義渠戎王於甘泉，遂起兵伐殘義渠。於是秦有隴西、北地、上郡，築長城以拒胡。而趙武靈王亦變俗胡服，習騎射，北破林胡、樓煩。築長城，自代并陰山下，至高闕爲塞。而置雲中、鴈門、代郡。其後燕有賢將秦開，爲質於胡，胡甚信之。歸而襲破走東胡，東胡卻千餘里。與荊軻刺秦王秦舞陽者，開之孫也。燕亦築長城，自造陽至襄平。置上谷、漁陽、右北平、遼西、遼東郡以拒胡。當是之時，冠帶戰國七，而三國邊於匈奴。其後趙將李牧時，匈奴不敢入趙邊。後秦滅六國，而始皇帝使蒙恬將十萬之眾北擊胡，悉收河南地。因河爲塞，築四十四縣城臨河，徙適戍以充之。而通直道，自九原至雲陽，因邊山險塹谿谷可繕者治之，起臨洮至遼東萬餘里。又度河據陽山北假中。"}],"qualifiers":{"source_term":"開之孫也","historicity":"historical_tradition"},"interpretation_note":"以孫明示祖孫，缺父不造人物，不補排行；父系連線為代理暫定讀法。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-086-cike:m032-0061","start":61,"end":64,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p032","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m032-0080","start":80,"end":83,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p032","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m032-0147","start":147,"end":150,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p032","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m034-0165","start":165,"end":168,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p034","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m034-0180","start":180,"end":183,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p034","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m034-0197","start":197,"end":199,"surface":"舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p034","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-086-cike:m034-0247","start":247,"end":249,"surface":"舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional","paragraph_id":"c-shiji-086-cike:p034","chapter_id":"c-shiji-086-cike"},{"id":"c-shiji-110-xiongnu:m004-0288","start":288,"end":291,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p004","chapter_id":"c-shiji-110-xiongnu"}],"relations":[{"id":"a-shiji110-003","subject_person_id":"505_n4y_p39_*A","predicate":"grandfather","object_person_id":"505_n4y_p39","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p004","quote":"自是之後百有餘年，晉悼公使魏絳和戎翟，戎翟朝晉。後百有餘年，趙襄子踰句注而破并代以臨胡貉。其後既與韓魏共滅智伯，分晉地而有之，則趙有代、句注之北，魏有河西、上郡，以與戎界邊。其後義渠之戎築城郭以自守，而秦稍蠶食，至於惠王，遂拔義渠二十五城。惠王擊魏，魏盡入西河及上郡于秦。秦昭王時，義渠戎王與宣太后亂，有二子。宣太后詐而殺義渠戎王於甘泉，遂起兵伐殘義渠。於是秦有隴西、北地、上郡，築長城以拒胡。而趙武靈王亦變俗胡服，習騎射，北破林胡、樓煩。築長城，自代并陰山下，至高闕爲塞。而置雲中、鴈門、代郡。其後燕有賢將秦開，爲質於胡，胡甚信之。歸而襲破走東胡，東胡卻千餘里。與荊軻刺秦王秦舞陽者，開之孫也。燕亦築長城，自造陽至襄平。置上谷、漁陽、右北平、遼西、遼東郡以拒胡。當是之時，冠帶戰國七，而三國邊於匈奴。其後趙將李牧時，匈奴不敢入趙邊。後秦滅六國，而始皇帝使蒙恬將十萬之眾北擊胡，悉收河南地。因河爲塞，築四十四縣城臨河，徙適戍以充之。而通直道，自九原至雲陽，因邊山險塹谿谷可繕者治之，起臨洮至遼東萬餘里。又度河據陽山北假中。"}],"qualifiers":{"source_term":"開之孫也","historicity":"historical_tradition"},"interpretation_note":"以孫明示祖孫，缺父不造人物，不補排行；父系連線為代理暫定讀法。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji086-047","person_id":"505_n4y_p39_*A","scope":"same_chapter","chapter_ids":["c-shiji-086-cike"],"status":"contextual_provisional","rationale":"依刺秦及篇末敘事暫接，蒙嘉之嘉限第34段，與代王嘉分開；燕王暫依第35段燕王喜承接，秦始皇及秦皇帝依第36段立號承接秦王。徐夫人不推定性別，所待客、家丈人與董生保留未名或氏稱；太史公口傳證據未作獨立核實。","reviewer":"Codex（AI 代理）","surfaces":["秦舞陽","舞陽"],"evidence":[{"paragraph_id":"c-shiji-086-cike:p032","quote":"於是太子豫求天下之利匕首，得趙人徐夫人匕首，取之百金，使工以藥焠之，以試人，血濡縷，人無不立死者。乃裝爲遣荊卿。燕國有勇士秦舞陽，年十三，殺人，人不敢忤視。乃令秦舞陽爲副。荊軻有所待，欲與倶；其人居遠未來，而爲治行。頃之，未發，太子遲之，疑其改悔，乃復請曰：「日已盡矣，荊卿豈有意哉？丹請得先遣秦舞陽。」荊軻怒，叱太子曰：「何太子之遣？往而不返者，豎子也！且提一匕首入不測之彊秦，仆所以留者，待吾客與倶。今太子遲之，請辭決矣！」遂發。"},{"paragraph_id":"c-shiji-086-cike:p034","quote":"遂至秦，持千金之資幣物，厚遺秦王寵臣中庶子蒙嘉。嘉爲先言於秦王曰：「燕王誠振怖大王之威，不敢舉兵以逆軍吏，願舉國爲内臣，比諸侯之列，給貢職如郡縣，而得奉守先王之宗廟。恐懼不敢自陳，謹斬樊於期之頭，及獻燕督亢之地圖，函封，燕王拜送于庭，使使以聞大王，唯大王命之。」秦王聞之，大喜，乃朝服，設九賓，見燕使者咸陽宮。荊軻奉樊於期頭函，而秦舞陽奉地圖柙，以次進。至陛，秦舞陽色變振恐，群臣怪之。荊軻顧笑舞陽，前謝曰：「北蕃蠻夷之鄙人，未嘗見天子，故振慴。願大王少假借之，使得畢使於前。」秦王謂軻曰：「取舞陽所持地圖。」軻既取圖奏之，秦王發圖，圖窮而匕首見。因左手把秦王之袖，而右手持匕首揕之。未至身，秦王驚，自引而起，袖絶。拔劍，劍長，操其室。時惶急，劍堅，故不可立拔。荊軻逐秦王，秦王環柱而走。群臣皆愕，卒起不意，盡失其度。而秦法，群臣侍殿上者不得持尺寸之兵；諸郎中執兵皆陳殿下，非有詔召不得上。方急時，不及召下兵，以故荊軻乃逐秦王。而卒惶急，無以撃軻，而以手共搏之。是時侍醫夏無且以其所奉藥囊提荊軻也。秦王方環柱走，卒惶急，不知所爲，左右乃曰：「王負劍！」負劍，遂拔以撃荊軻，斷其左股。荊軻廢，乃引其匕首以擿秦王，不中，中桐柱。秦王復撃軻，軻被八創。軻自知事不就，倚柱而笑，箕踞以罵曰：「事所以不成者，以欲生劫之，必得約契以報太子也。」於是左右既前殺軻，秦王不怡者良久。已而論功，賞群臣及當坐者各有差，而賜夏無且黃金二百溢，曰：「無且愛我，乃以藥囊提荊軻也。」"}]}],"equivalence_decisions":[{"id":"eq-shiji110-ancient-qinwuyang","person_ids":["505_n4y_p39_*A"],"canonical_person_id":"505_n4y_p39_*A","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-110-xiongnu","c-shiji-086-cike"],"rationale":"荊軻刺秦的秦舞陽與卷86燕勇士、荊軻之副同事件相合；沿用秦開祖孫家族ID，缺代父親保持未知，不從勇士年齡補生年。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p004","quote":"自是之後百有餘年，晉悼公使魏絳和戎翟，戎翟朝晉。後百有餘年，趙襄子踰句注而破并代以臨胡貉。其後既與韓魏共滅智伯，分晉地而有之，則趙有代、句注之北，魏有河西、上郡，以與戎界邊。其後義渠之戎築城郭以自守，而秦稍蠶食，至於惠王，遂拔義渠二十五城。惠王擊魏，魏盡入西河及上郡于秦。秦昭王時，義渠戎王與宣太后亂，有二子。宣太后詐而殺義渠戎王於甘泉，遂起兵伐殘義渠。於是秦有隴西、北地、上郡，築長城以拒胡。而趙武靈王亦變俗胡服，習騎射，北破林胡、樓煩。築長城，自代并陰山下，至高闕爲塞。而置雲中、鴈門、代郡。其後燕有賢將秦開，爲質於胡，胡甚信之。歸而襲破走東胡，東胡卻千餘里。與荊軻刺秦王秦舞陽者，開之孫也。燕亦築長城，自造陽至襄平。置上谷、漁陽、右北平、遼西、遼東郡以拒胡。當是之時，冠帶戰國七，而三國邊於匈奴。其後趙將李牧時，匈奴不敢入趙邊。後秦滅六國，而始皇帝使蒙恬將十萬之眾北擊胡，悉收河南地。因河爲塞，築四十四縣城臨河，徙適戍以充之。而通直道，自九原至雲陽，因邊山險塹谿谷可繕者治之，起臨洮至遼東萬餘里。又度河據陽山北假中。","mention_ids":["c-shiji-110-xiongnu:m004-0288"]},{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p032","quote":"於是太子豫求天下之利匕首，得趙人徐夫人匕首，取之百金，使工以藥焠之，以試人，血濡縷，人無不立死者。乃裝爲遣荊卿。燕國有勇士秦舞陽，年十三，殺人，人不敢忤視。乃令秦舞陽爲副。荊軻有所待，欲與倶；其人居遠未來，而爲治行。頃之，未發，太子遲之，疑其改悔，乃復請曰：「日已盡矣，荊卿豈有意哉？丹請得先遣秦舞陽。」荊軻怒，叱太子曰：「何太子之遣？往而不返者，豎子也！且提一匕首入不測之彊秦，仆所以留者，待吾客與倶。今太子遲之，請辭決矣！」遂發。","mention_ids":["c-shiji-086-cike:m032-0061","c-shiji-086-cike:m032-0080","c-shiji-086-cike:m032-0147"]},{"chapter_id":"c-shiji-086-cike","source_id":"s-shiji-086-cike","paragraph_id":"c-shiji-086-cike:p034","quote":"遂至秦，持千金之資幣物，厚遺秦王寵臣中庶子蒙嘉。嘉爲先言於秦王曰：「燕王誠振怖大王之威，不敢舉兵以逆軍吏，願舉國爲内臣，比諸侯之列，給貢職如郡縣，而得奉守先王之宗廟。恐懼不敢自陳，謹斬樊於期之頭，及獻燕督亢之地圖，函封，燕王拜送于庭，使使以聞大王，唯大王命之。」秦王聞之，大喜，乃朝服，設九賓，見燕使者咸陽宮。荊軻奉樊於期頭函，而秦舞陽奉地圖柙，以次進。至陛，秦舞陽色變振恐，群臣怪之。荊軻顧笑舞陽，前謝曰：「北蕃蠻夷之鄙人，未嘗見天子，故振慴。願大王少假借之，使得畢使於前。」秦王謂軻曰：「取舞陽所持地圖。」軻既取圖奏之，秦王發圖，圖窮而匕首見。因左手把秦王之袖，而右手持匕首揕之。未至身，秦王驚，自引而起，袖絶。拔劍，劍長，操其室。時惶急，劍堅，故不可立拔。荊軻逐秦王，秦王環柱而走。群臣皆愕，卒起不意，盡失其度。而秦法，群臣侍殿上者不得持尺寸之兵；諸郎中執兵皆陳殿下，非有詔召不得上。方急時，不及召下兵，以故荊軻乃逐秦王。而卒惶急，無以撃軻，而以手共搏之。是時侍醫夏無且以其所奉藥囊提荊軻也。秦王方環柱走，卒惶急，不知所爲，左右乃曰：「王負劍！」負劍，遂拔以撃荊軻，斷其左股。荊軻廢，乃引其匕首以擿秦王，不中，中桐柱。秦王復撃軻，軻被八創。軻自知事不就，倚柱而笑，箕踞以罵曰：「事所以不成者，以欲生劫之，必得約契以報太子也。」於是左右既前殺軻，秦王不怡者良久。已而論功，賞群臣及當坐者各有差，而賜夏無且黃金二百溢，曰：「無且愛我，乃以藥囊提荊軻也。」","mention_ids":["c-shiji-086-cike:m034-0165","c-shiji-086-cike:m034-0180","c-shiji-086-cike:m034-0197","c-shiji-086-cike:m034-0247"]}],"reviewer":"Codex（AI 代理）","model":null,"human_reviewed":false,"identity_materialized":true}],"passages":[{"id":"c-shiji-086-cike:p032","text":"於是太子豫求天下之利匕首，得趙人徐夫人匕首，取之百金，使工以藥焠之，以試人，血濡縷，人無不立死者。乃裝爲遣荊卿。燕國有勇士秦舞陽，年十三，殺人，人不敢忤視。乃令秦舞陽爲副。荊軻有所待，欲與倶；其人居遠未來，而爲治行。頃之，未發，太子遲之，疑其改悔，乃復請曰：「日已盡矣，荊卿豈有意哉？丹請得先遣秦舞陽。」荊軻怒，叱太子曰：「何太子之遣？往而不返者，豎子也！且提一匕首入不測之彊秦，仆所以留者，待吾客與倶。今太子遲之，請辭決矣！」遂發。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m032-0002","start":2,"end":4,"surface":"太子","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0014","start":14,"end":19,"surface":"趙人徐夫人","kind":"person","person_id":"sfi_am6_zn4","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0027","start":27,"end":29,"surface":"使工","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名人物或待核稱呼保留未解；未補姓名、性別或親屬名。"},{"id":"c-shiji-086-cike:m032-0034","start":34,"end":37,"surface":"以試人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名人物或待核稱呼保留未解；未補姓名、性別或親屬名。"},{"id":"c-shiji-086-cike:m032-0053","start":53,"end":55,"surface":"荊卿","kind":"person","person_id":"b83_37f_n0v","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0061","start":61,"end":64,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0080","start":80,"end":83,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0086","start":86,"end":88,"surface":"荊軻","kind":"person","person_id":"b83_37f_n0v","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0096","start":96,"end":98,"surface":"其人","kind":"person","person_id":"ehi_e39_173","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0114","start":114,"end":116,"surface":"太子","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0135","start":135,"end":137,"surface":"荊卿","kind":"person","person_id":"b83_37f_n0v","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0142","start":142,"end":143,"surface":"丹","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0147","start":147,"end":150,"surface":"秦舞陽","kind":"person","person_id":"505_n4y_p39_*A","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0152","start":152,"end":154,"surface":"荊軻","kind":"person","person_id":"b83_37f_n0v","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0157","start":157,"end":159,"surface":"太子","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0163","start":163,"end":165,"surface":"太子","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0197","start":197,"end":199,"surface":"吾客","kind":"person","person_id":"ehi_e39_173","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m032-0203","start":203,"end":205,"surface":"太子","kind":"person","person_id":"e3o_2bk_lhm","status":"contextual_provisional"}],"chapter_id":"c-shiji-086-cike","book_id":"b-shiji-086","work_id":"w-shiji","source_id":"s-shiji-086-cike"},{"id":"c-shiji-086-cike:p034","text":"遂至秦，持千金之資幣物，厚遺秦王寵臣中庶子蒙嘉。嘉爲先言於秦王曰：「燕王誠振怖大王之威，不敢舉兵以逆軍吏，願舉國爲内臣，比諸侯之列，給貢職如郡縣，而得奉守先王之宗廟。恐懼不敢自陳，謹斬樊於期之頭，及獻燕督亢之地圖，函封，燕王拜送于庭，使使以聞大王，唯大王命之。」秦王聞之，大喜，乃朝服，設九賓，見燕使者咸陽宮。荊軻奉樊於期頭函，而秦舞陽奉地圖柙，以次進。至陛，秦舞陽色變振恐，群臣怪之。荊軻顧笑舞陽，前謝曰：「北蕃蠻夷之鄙人，未嘗見天子，故振慴。願大王少假借之，使得畢使於前。」秦王謂軻曰：「取舞陽所持地圖。」軻既取圖奏之，秦王發圖，圖窮而匕首見。因左手把秦王之袖，而右手持匕首揕之。未至身，秦王驚，自引而起，袖絶。拔劍，劍長，操其室。時惶急，劍堅，故不可立拔。荊軻逐秦王，秦王環柱而走。群臣皆愕，卒起不意，盡失其度。而秦法，群臣侍殿上者不得持尺寸之兵；諸郎中執兵皆陳殿下，非有詔召不得上。方急時，不及召下兵，以故荊軻乃逐秦王。而卒惶急，無以撃軻，而以手共搏之。是時侍醫夏無且以其所奉藥囊提荊軻也。秦王方環柱走，卒惶急，不知所爲，左右乃曰：「王負劍！」負劍，遂拔以撃荊軻，斷其左股。荊軻廢，乃引其匕首以擿秦王，不中，中桐柱。秦王復撃軻，軻被八創。軻自知事不就，倚柱而笑，箕踞以罵曰：「事所以不成者，以欲生劫之，必得約契以報太子也。」於是左右既前殺軻，秦王不怡者良久。已而論功，賞群臣及當坐者各有差，而賜夏無且黃金二百溢，曰：「無且愛我，乃以藥囊提荊軻也。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-086-cike:m034-0014","start":14,"end":16,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m034-0018","start":18,"end":23,"surface":"中庶子蒙嘉","kind":"person","person_id":"kea_cx5_ey7","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m034-0024","start":24,"end":25,"surface":"嘉","kind":"person","person_id":"kea_cx5_ey7","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m034-0029","start":29,"end":31,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m034-0034","start":34,"end":36,"surface":"燕王","kind":"person","person_id":"lt4_hpv_4ku_AA","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m034-0077","start":77,"end":79,"surface":"先王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名人物或待核稱呼保留未解；未補姓名、性別或親屬名。"},{"id":"c-shiji-086-cike:m034-0092","start":92,"end":95,"surface":"樊於期","kind":"person","person_id":"2r3_3yo_3sa","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m034-0110","start":110,"end":112,"surface":"燕王","kind":"person","person_id":"lt4_hpv_4ku_AA","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m034-0131","start":131,"end":133,"surface":"秦王","kind":"person","person_id":"ao3_0fy_d45_AAA","status":"contextual_provisional"},{"id":"c-shiji-086-cike:m034-0155","start":155,"end":157,"surface":"荊軻","kind":"person","person_id":"b83_37f