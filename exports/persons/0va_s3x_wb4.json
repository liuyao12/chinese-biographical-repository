rson_id":"bpy_73i_0yy","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作寶誌。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:926ceb18b937c6612202ae0e975b51816ffe9fa93ccf09573b64985563a56669","source_layer":"received_biography","column_projection":[{"pdf_page":85,"half":"右","leaf":"二十三下","column_from_right":7,"start":1,"end":21,"text":"累遷太子洗馬中舍人並掌東宮管記昭明太子愛"},{"pdf_page":85,"half":"右","leaf":"二十三下","column_from_right":8,"start":0,"end":21,"text":"文學士常與筠及劉孝綽陸倕到洽殷鈞等遊宴玄圃"},{"pdf_page":85,"half":"右","leaf":"二十三下","column_from_right":9,"start":0,"end":21,"text":"太子獨執筠袖撫孝綽肩曰所謂左把浮丘袖右拍洪"},{"pdf_page":85,"half":"右","leaf":"二十三下","column_from_right":10,"start":0,"end":21,"text":"崖肩其見重如此筠又與殷鈞以方雅見禮後為中書"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":1,"start":0,"end":21,"text":"郎奉敕製開善寺寶誌法師碑文辭甚麗逸又敕撰中"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":2,"start":0,"end":15,"text":"書表奏三十卷及所上賦頌都為一集"}]},"chapter_id":"c-nanshi-022-wangyun-family-wyd","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangyun-family-wyd1739"},{"id":"c-nanshi-022-wangyun-family-wyd:p005","text":"後為太子家令復掌管記普通元年以母憂去職筠有孝性毀瘠過禮大通二年為司徒左長史三年昭明太子薨敕製哀策文復見嗟賞尋出為臨海太守在郡侵刻還資有芒屩兩舫他物稱是為有司奏不調累年後歷祕書監太府卿度支尚書司徒左長史及簡文卽位為太子詹事","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":15,"end":16,"surface":"母","id":"c-nanshi-022-wangyun-family-wyd:p005:m0015","person_id":"3cn_bb6_ety","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠母。"},{"start":19,"end":20,"surface":"筠","id":"c-nanshi-022-wangyun-family-wyd:p005:m0019","person_id":"mxz_qw8_acd_A","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作筠。"},{"start":39,"end":43,"surface":"昭明太子","id":"c-nanshi-022-wangyun-family-wyd:p005:m0039","person_id":"0va_s3x_wb4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭統。"},{"start":76,"end":78,"surface":"有司","id":"c-nanshi-022-wangyun-family-wyd:p005:u0076","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"受理臨海郡事的主管官員未具名"},{"start":101,"end":103,"surface":"簡文","id":"c-nanshi-022-wangyun-family-wyd:p005:m0101","person_id":"rtd_v0b_nyn","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭綱。"}],"source_position":{"revision_id":"cbr-ai-transcription-sha256:926ceb18b937c6612202ae0e975b51816ffe9fa93ccf09573b64985563a56669","source_layer":"received_biography","column_projection":[{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":2,"start":15,"end":21,"text":"後為太子家令"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":3,"start":0,"end":21,"text":"復掌管記普通元年以母憂去職筠有孝性毀瘠過禮"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":4,"start":0,"end":21,"text":"大通二年為司徒左長史三年昭明太子薨敕製哀策"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":5,"start":0,"end":21,"text":"文復見嗟賞尋出為臨海太守在郡侵刻還資有芒屩"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":6,"start":0,"end":21,"text":"兩舫他物稱是為有司奏不調累年後歷祕書監太府"},{"pdf_page":85,"half":"左","leaf":"二十四上","column_from_right":7,"start":0,"end":20,"text":"卿度支尚書司徒左長史及簡文卽位為太子詹事"}]},"chapter_id":"c-nanshi-022-wangyun-family-wyd","book_id":"b-nanshi-022","work_id":"w-nanshi","source_id":"s-nanshi-022-wangyun-family-wyd1739"},{"id":"c-nanshi-022-wangyun-family:p004","text":"累遷太子洗馬，中舍人，並掌東宮管記。昭明太子愛文學士，常與筠及劉孝綽、陸倕、到洽、殷鈞等游宴玄圃，太子獨執筠袖，撫孝綽肩曰：「所謂左把浮丘袖，右拍洪崖肩。」其見重如此。筠又與殷鈞以方雅見禮。後爲中書郎，奉敕制開善寺寶志法師碑文，辭甚麗逸。又敕撰中書表奏三十卷，及所上賦頌都爲一集。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"start":18,"end":22,"surface":"昭明太子","id":"c-nanshi-022-wangyun-family:p004:m0018","person_id":"0va_s3x_wb4","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作蕭統。"},{"start":23,"end":26,"surface":"文學士","id":"c-nanshi-022-wangyun-family:p004:u0023","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"東宮文學之士合稱"},{"st