hip_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-110-xiongnu:m016-0059","start":59,"end":65,"surface":"後義盧侯難氏","kind":"person","person_id":"a2v_qle_qys","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p016","chapter_id":"c-shiji-110-xiongnu"},{"id":"c-shiji-110-xiongnu:m017-0047","start":47,"end":53,"surface":"後義盧侯難氏","kind":"person","person_id":"a2v_qle_qys","status":"contextual_provisional","paragraph_id":"c-shiji-110-xiongnu:p017","chapter_id":"c-shiji-110-xiongnu"}],"relations":[],"title_holdings":[{"id":"th-shiji110-037","person_id":"a2v_qle_qys","title":"後義盧侯","kind":"unclassified","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p016","quote_passage_ref":"data/corpus/shiji/110.json"},{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p017","quote_passage_ref":"data/corpus/shiji/110.json"}],"attestations":[{"id":"th-shiji110-037:a001","paragraph_id":"c-shiji-110-xiongnu:p016","start":59,"end":63,"surface":"後義盧侯","person_mention_id":"c-shiji-110-xiongnu:m016-0059","usage":"narrative","date_expression":"其明年","normalized_date":{"era":"BCE","era_year":176,"year":-175,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"其明年，單于遺漢書曰：「天所立匈奴大單于敬問皇帝無恙。前時皇帝言和親事，稱書意，合歡。漢邊吏侵侮右賢王，右賢王不請，聽後義盧侯難氏等計，與漢吏相距，絕二主之約，離兄弟之親。皇帝讓書再至，發使以書報，不來，漢使不至，漢以其故不和，鄰國不附。今以小吏之敗約故，罰右賢王，使之西求月氏擊之。以天之福，吏卒良，馬彊力，以夷滅月氏，盡斬殺降下之。定樓蘭、烏孫、呼揭及其旁二十六國，皆以爲匈奴。諸引弓之民，并爲一家。北州已定，願寢兵休士卒養馬，除前事，復故約，以安邊民，以應始古，使少者得成其長，老者安其處，世世平樂。未得皇帝之志也，故使郎中系雩淺奉書請，獻橐他一匹，騎馬二匹，駕二駟。皇帝即不欲匈奴近塞，則且詔吏民遠舍。使者至，即遣之。」以六月中來至薪望之地。書至，漢議擊與和親孰便。公卿皆曰：「單于新破月氏，乘勝，不可擊。且得匈奴地，澤鹵，非可居也。和親甚便。」漢許之。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p016","quote_passage_ref":"data/corpus/shiji/110.json"},{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p015","quote_passage_ref":"data/corpus/shiji/110.json"}],"references":[{"title":"《資治通鑑》卷十四數位編輯紀年標題","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷014&oldid=1554008","quote":"文帝前四年（乙丑，公元前一七六年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"依 傳世正文 紀年承接換算：第16段其明年承前段文帝三年為前四年，第17段明示前六年；只換年尺度，六月不換公曆月日。書信當時用稱不等於引述舊事的發生年，重引前書不算獨立證據。","reviewer":"Codex（AI 代理）","human_reviewed":false}},{"id":"th-shiji110-037:a002","paragraph_id":"c-shiji-110-xiongnu:p017","start":47,"end":51,"surface":"後義盧侯","person_mention_id":"c-shiji-110-xiongnu:m017-0047","usage":"narrative","date_expression":"孝文皇帝前六年","normalized_date":{"era":"BCE","era_year":174,"year":-173,"year_numbering":"astronomical","precision":"year","status":"editorial_provisional","original_quote":"孝文皇帝前六年，漢遺匈奴書曰：「皇帝敬問匈奴大單于無恙。使郎中系雩淺遺朕書曰：『右賢王不請，聽後義盧侯難氏等計，絕二主之約，離兄弟之親，漢以故不和，鄰國不附。今以小吏敗約，故罰右賢王使西擊月氏，盡定之。願寢兵休士卒養馬，除前事，復故約，以安邊民，使少者得成其長，老者安其處，世世平樂。』朕甚嘉之，此古聖主之意也。漢與匈奴約爲兄弟，所以遺單于甚厚。倍約離兄弟之親者，常在匈奴。然右賢王事已在赦前，單于勿深誅。單于若稱書意，明告諸吏，使無負約，有信，敬如單于書。使者言單于自將伐國有功，甚苦兵事。服繡袷綺衣、繡袷長襦、錦袷袍各一，比余一，黃金飾具帶一，黃金胥紕一，繡十匹，錦三十匹，赤綈、綠繒各四十匹，使中大夫意、謁者令肩遺單于。」","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p017","quote_passage_ref":"data/corpus/shiji/110.json"}],"references":[{"title":"《資治通鑑》卷十四數位編輯紀年標題","url":"https://zh.wikisource.org/w/index.php?title=資治通鑑/卷014&oldid=1554008","quote":"文帝前六年（丁卯，公元前一七四年）","scope":"digital_editorial_regnal_year_equivalence_only","image_verified":false}],"rationale":"依 傳世正文 紀年承接換算：第16段其明年承前段文帝三年為前四年，第17段明示前六年；只換年尺度，六月不換公曆月日。書信當時用稱不等於引述舊事的發生年，重引前書不算獨立證據。","reviewer":"Codex（AI 代理）","human_reviewed":false}}],"effective_period":{