堰開田數千頃郡人頼之富贍丹淅二州蠻屢為寇邵誘其帥因大會誅之悉掩其徒黨既失信羣蠻所在並起水陸斷絶子敷至襄陽定省當還都羣蠻伺欲取之會蠕蠕國遣使朝貢賊以為敷遂執之邵坐降號揚烈將軍江夏王義恭鎮江陵以邵為撫軍長史持節南蠻校尉坐在雝州營私蓄取贓貨二百四十五萬下廷尉免官削爵土後為呉興太守卒追復爵邑諡曰簡伯邵臨終遺命祭以菜果葦蓆為轜車諸子從焉","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-songshu-046-zhangshao:p001:m0000","start":0,"end":2,"surface":"張邵","kind":"person","person_id":"d50_8f5_wul_AAAC","status":"contextual_provisional","interpretation_note":"依完整傳文敘事、職官與親屬語境辨識；原字保留。"},{"id":"c-songshu-046-zhangshao:p001:m0003","start":3,"end":5,"surface":"茂宗","kind":"person","person_id":"d50_8f5_wul_AAAC","status":"contextual_provisional","interpretation_note":"依完整傳文敘事、職官與親屬語境辨識；原字保留。"},{"id":"c-songshu-046-zhangshao:p001:m0009","start":9,"end":10,"surface":"裕","kind":"person","person_id":"d50_8f5_wul_AAAA","status":"contextual_provisional","interpretation_note":"傳內短稱，依同一敘事主語／受話者辨識；不依最近長姓名自動續接。"},{"id":"c-songshu-046-zhangshao:p001:m0020","start":20,"end":22,"surface":"王誕","kind":"person","person_id":"vhf_729_g6z","status":"contextual_provisional","interpretation_note":"依完整傳文敘事、職官與親屬語境辨識；原字保留。"},{"id":"c-songshu-046-zhangshao:p001:m0027","start":27,"end":29,"surface":"桓𤣥","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional","interpretation_note":"依完整傳文敘事、職官與親屬語境辨識；原字保留。"},{"id":"c-songshu-046-zhangshao:p001:m0030","start":30,"end":31,"surface":"誕","kind":"person","person_id":"vhf_729_g6z","status":"contextual_provisional","interpretation_note":"傳內短稱，依同一敘事主語／受話者辨識；不依最近長姓名自動續接。"},{"id":"c-songshu-046-zhangshao:p001:m0041","start":41,"end":42,"surface":"邵","kind":"person","person_id":"d50_8f5_wul_AAAC","status":"contextual_provisional","interpretation_note":"傳內短稱，依同一敘事主語／受話者辨識；不依最近長姓名自動續接。"},{"id":"c-songshu-046-zhangshao:p001:m0061","start":61,"end":63,"surface":"桓𤣥","kind":"person","person_id":"lf6_f95_379","status":"contextual_provisional","interpretation_note":"依完整傳文敘事、職官與親屬語境辨識；原字保留。"},{"id":"c-songshu-046-zhangshao:p001:m0066","start":66,"end":67,"surface":"敞","kind":"person","pe