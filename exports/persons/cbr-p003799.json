ot_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji065-003","subject_person_id":"61h_0sk_4pb","predicate":"mother","object_person_id":"sa8_c1b_7dw","status":"source_attested","evidence":[{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p007","quote":"魯人或惡吳起曰：「起之為人，猜忍人也。其少時，家累千金，游仕不遂，遂破其家，鄉黨笑之，吳起殺其謗己者三十餘人，而東出衛郭門。與其母訣，齧臂而盟曰：『起不為卿相，不復入衛。』遂事曾子。居頃之，其母死，起終不歸。曾子薄之，而與起絕。起乃之魯，學兵法以事魯君。魯君疑之，起殺妻以求將。夫魯小國，而有戰勝之名，則諸侯圖魯矣。且魯衛兄弟之國也，而君用起，則是棄衛。」魯君疑之，謝吳起。"}],"qualifiers":{"source_term":"與其母訣","historicity":"historical_tradition"},"interpretation_note":"依明示取妻、母、其子及故事局部父稱保存。孫武後世子孫只記祖先，不補直接父子；病卒家屬不接吳起親屬，公叔公主不接試延吳起公主。引語與來源故事保留範圍，不作獨立史實確證。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-065-sun:m007-0063","start":63,"end":65,"surface":"其母","kind":"person","person_id":"sa8_c1b_7dw","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p007","chapter_id":"c-shiji-065-sun"},{"id":"c-shiji-065-sun:m007-0095","start":95,"end":97,"surface":"其母","kind":"person","person_id":"sa8_c1b_7dw","status":"contextual_provisional","paragraph_id":"c-shiji-065-sun:p007","chapter_id":"c-shiji-065-sun"}],"relations":[{"id":"a-shiji065-003","subject_person_id":"61h_0sk_4pb","predicate":"mother","object_person_id":"sa8_c1b_7dw","status":"source_attested","evidence":[{"chapter_id":"c-shiji-065-sun","source_id":"s-shiji-065-sun","paragraph_id":"c-shiji-065-sun:p007","quote":"魯人或惡吳起曰：「起之為人，猜忍人也。其少時，家累千金，游仕不遂，遂破其家，鄉黨笑之，吳起殺其謗己者三十餘人，而東出衛郭門。與其母訣，齧臂而盟曰：『起不為卿相，不復入衛。』遂事曾子。居頃之，其母死，起終不歸。曾子薄之，而與起絕。起乃之魯，學兵法以事魯君。魯君疑之，起殺妻以求將。夫魯小國，而有戰勝之名，則諸侯圖魯矣。且魯衛兄弟之國也，而君用起，則是棄衛。」魯君疑之，謝吳起。"}],"qualifiers":{"source_term":"與其母訣","historicity":"historical_tradition"},"interpretation_note":"依明示取妻、母、其子及故事局部父稱保存。孫武後世子孫只記祖先，不補直接