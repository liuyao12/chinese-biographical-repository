nd":"person","person_id":"2gx_dt8_kun","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0149","start":149,"end":151,"surface":"呂后","kind":"person","person_id":"2gx_dt8_kun","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0157","start":157,"end":160,"surface":"辟陽侯","kind":"person","person_id":"qg7_n12_fne","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0165","start":165,"end":168,"surface":"厲王母","kind":"person","person_id":"kuc_m3w_ux2","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0170","start":170,"end":172,"surface":"厲王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0181","start":181,"end":183,"surface":"厲王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0184","start":184,"end":185,"surface":"上","kind":"person","person_id":"brp_v5i_sjg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0186","start":186,"end":187,"surface":"上","kind":"person","person_id":"brp_v5i_sjg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0190","start":190,"end":192,"surface":"呂后","kind":"person","person_id":"2gx_dt8_kun","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0197","start":197,"end":200,"surface":"厲王母","kind":"person","person_id":"kuc_m3w_ux2","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0206","start":206,"end":209,"surface":"厲王母","kind":"person","person_id":"kuc_m3w_ux2","status":"contextual_provisional"}],"chapter_id":"c-shiji-118-huainan","book_id":"b-shiji-118","work_id":"w-shiji","source_id":"s-shiji118-huainan"},{"id":"c-shiji-118-huainan:p002","text":"高祖十一年（十）［七］月，淮南王黥布反，立子長為淮南王，王黥布故地，凡四郡。上自將兵擊滅布，厲王遂即位。厲王蚤失母，常附呂后，孝惠、呂后時以故得幸無患害，而常心怨辟陽侯，弗敢發。及孝文帝初即位，淮南王自以為最親，驕蹇，數不奉法。上以親故，常寬赦之。三年，入朝。甚橫。從上入苑囿獵，與上同車，常謂上「大兄」。厲王有材力，力能扛鼎，乃往請辟陽侯。辟陽侯出見之，即自袖鐵椎椎辟陽侯，令從者魏敬剄之。厲王乃馳走闕下，肉袒謝曰：「臣母不當坐趙事，其時辟陽侯力能得之呂后，弗爭，罪一也。趙王如意子母無罪，呂後殺之，辟陽侯弗爭，罪二也。呂后王諸呂，欲以危劉氏，辟陽侯弗爭，罪三也。臣謹為天下誅賊臣辟陽侯，報母之仇，謹伏闕下請罪。」孝文傷其志，為親故，弗治，赦厲王。當是時，薄太后及太子諸大臣皆憚厲王，厲王以此歸國益驕恣，不用漢法，出入稱警蹕，稱制，自為法令，擬於天子。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m002-0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"brp_v5i_sjg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0013","start":13,"end":18,"surface":"淮南王黥布","kind":"person","person_id":"zxd_afr_2xg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0021","start":21,"end":23,"surface":"子長","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0024","start":24,"end":27,"surface":"淮南王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0029","start":29,"end":31,"surface":"黥布","kind":"person","person_id":"zxd_afr_2xg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0038","start":38,"end":39,"surface":"上","kind":"person","person_id":"brp_v5i_sjg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0044","start":44,"end":45,"surface":"布","kind":"person","person_id":"zxd_afr_2xg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0046","start":46,"end":48,"surface":"厲王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0052","start":52,"end":54,"surface":"厲王","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0060","start":60,"end":62,"surface":"呂后","kind":"person","person_id":"2gx_dt8_kun","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0063","start":63,"end":65,"surface":"孝惠","kind":"person","person_id":"koo_4b5_1jm","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m002-0066","start":66,"end":68,"surface":"呂后","kind":"person","person_id":"2gx_dt8_kun","status":