d":229,"surface":"呂后","kind":"person","person_id":"2gx_dt8_kun","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p002","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m002-0246","start":246,"end":248,"surface":"呂後","kind":"person","person_id":"2gx_dt8_kun","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p002","chapter_id":"c-shiji-118-huainan"},{"id":"c-shiji-118-huainan:m002-0261","start":261,"end":263,"surface":"呂后","kind":"person","person_id":"2gx_dt8_kun","status":"contextual_provisional","paragraph_id":"c-shiji-118-huainan:p002","chapter_id":"c-shiji-118-huainan"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-118-huainan:p001","text":"淮南厲王長者，高祖少子也，其母故趙王張敖美人。高祖八年，從東垣過趙，趙王獻之美人。厲王母得幸焉，有身。趙王敖弗敢內宮，為筑外宮而捨之。及貫高等謀反柏人事發覺，并逮治王，盡收捕王母兄弟美人，繋之河內。厲王母亦繋，告吏曰：「得幸上，有身。」吏以聞上，上方怒趙王，未理厲王母。厲王母弟趙兼因辟陽侯言呂后，呂后妒，弗肯白，辟陽侯不彊爭。及厲王母已生厲王，恚，即自殺。吏奉厲王詣上，上悔，令呂后母之，而葬厲王母真定。真定，厲王母之家在焉，父世縣也。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-118-huainan:m001-0000","start":0,"end":5,"surface":"淮南厲王長","kind":"person","person_id":"yqp_nlb_p1p_AF","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0007","start":7,"end":9,"surface":"高祖","kind":"person","person_id":"brp_v5i_sjg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0013","start":13,"end":15,"surface":"其母","kind":"person","person_id":"kuc_m3w_ux2","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0016","start":16,"end":20,"surface":"趙王張敖","kind":"person","person_id":"agx_sqm_4ou_A","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0023","start":23,"end":25,"surface":"高祖","kind":"person","person_id":"brp_v5i_sjg","status":"contextual_provisional"},{"id":"c-shiji-118-huainan:m001-0034","start":34,"end"