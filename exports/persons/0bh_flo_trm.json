son","person_id":"0bh_flo_trm","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p079","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m079-0072","start":72,"end":75,"surface":"季桓子","kind":"person","person_id":"0bh_flo_trm","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p079","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m079-0079","start":79,"end":81,"surface":"桓子","kind":"person","person_id":"0bh_flo_trm","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p079","chapter_id":"c-shiji-033-lu"},{"id":"c-shiji-033-lu:m080-0085","start":85,"end":88,"surface":"季桓子","kind":"person","person_id":"0bh_flo_trm","status":"contextual_provisional","paragraph_id":"c-shiji-033-lu:p080","chapter_id":"c-shiji-033-lu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji033-167","person_id":"0bh_flo_trm","surfaces":["季桓子","桓子"],"scope":"same_chapter","chapter_ids":["c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-033-lu:p079","quote":"定公五年，季平子卒。陽虎私怒，囚季桓子，與盟，乃捨之。七年，齊伐我，取鄆，以爲魯陽虎邑以從政。八年，陽虎欲盡殺三桓適，而更立其所善庶子以代之；載季桓子將殺之，桓子詐而得脫。三桓共攻陽虎，陽虎居陽關。九年，魯伐陽虎，陽虎奔齊，已而奔晉趙氏。"},{"paragraph_id":"c-shiji-033-lu:p080","quote":"十年，定公與齊景公會於夾谷，孔子行相事。齊欲襲魯君，孔子以禮歷階，誅齊淫樂，齊矦懼，乃止，歸魯侵地而謝過。十二年，使仲由毀三桓城，收其甲兵。孟氏不肯墮城，伐之，不克而止。季桓子受齊女樂，孔子去。"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-033-lu:p079","text":"定公五年，季平子卒。陽虎私怒，囚季桓子，與盟，乃捨之。七年，齊伐我，取鄆，以爲魯陽虎邑以從政。八年，陽虎欲盡殺三桓適，而更立其所善庶子以代之；載季桓子將殺之，桓子詐而得脫。三桓共攻陽虎，陽虎居陽關。九年，魯伐陽虎，陽虎奔齊，已而奔晉趙氏。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m079-0000","start":0,"end":2,"surface":"定公","kind":"person","person_id":"ath_xsq_n4i","status":"contextual_provisional"},{"id":"c-shiji-033-lu