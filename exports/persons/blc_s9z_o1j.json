{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"blc_s9z_o1j","canonical_person_id":"blc_s9z_o1j","id_aliases":[],"identity_policy":"contextual_provisional","person_ids":["blc_s9z_o1j"],"persons":[{"id":"blc_s9z_o1j","label":"杜式（酷吏列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"杜式","mention_ids":["c-shiji-122-kuli:m028-0219"]}],"evidence":[{"mention_id":"c-shiji-122-kuli:m028-0219","chapter_id":"c-shiji-122-kuli","paragraph_id":"c-shiji-122-kuli:p028","quote":"杜式"}]}],"source_mention_summary":[{"source_id":"s-shiji122-kuli","work_id":"w-shiji","book_id":"b-shiji-122","chapter_id":"c-shiji-122-kuli","mention_count":1,"mention_ids":["c-shiji-122-kuli:m028-0219"],"paragraph_ids":["c-shiji-122-kuli:p028"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-shiji122-kuli"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-122-kuli:m028-0219","start":219,"end":221,"surface":"杜式","kind":"person","person_id":"blc_s9z_o1j","status":"contextual_provisional","paragraph_id":"c-shiji-122-kuli:p028","chapter_id":"c-shiji-122-kuli"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-122-kuli:p028","text":"是時趙禹、張湯以深刻爲九卿矣，然其治尚寬，輔法而行，而縱以鷹撃毛摯爲治。後會五銖錢白金起，民爲姦，京師尤甚，乃以縱爲右内史，王温舒爲中尉。温舒至惡，其所爲不先言縱，縱必以氣淩之，敗壞其功。其治，所誅殺甚多，然取爲小治，姦益不勝，直指始出矣。吏之治以斬殺縛束爲務，閻奉以惡用矣。縱廉，其治放郅都。上幸鼎湖，病久，已而卒起幸甘泉，道多不治。上怒曰：「縱以我爲不復行此道乎？」嗛之。至冬，楊可方受告緡，縱以爲此亂民，部吏捕其爲可使者。天子聞，使杜式治，以爲廢格沮事，棄縱市。後一歳，張湯亦死。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-122-kuli:m028-0002","start":2,"end":4,"surface":"趙禹","kind":"person","person_id":"vkr_lkp_dme","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0005","start":5,"end":7,"surface":"張湯","kind":"person","person_id":"1ex_se1_yef_A","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0027","start":27,"end":28,"surface":"縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0056","start":56,"end":57,"surface":"縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0062","start":62,"end":65,"surface":"王温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0069","start":69,"end":71,"surface":"温舒","kind":"person","person_id":"6ym_eva_k4a","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0080","start":80,"end":81,"surface":"縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0082","start":82,"end":83,"surface":"縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0131","start":131,"end":133,"surface":"閻奉","kind":"person","person_id":"0xp_j8o_cl2","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0138","start":138,"end":139,"surface":"縱","kind":"person","person_id":"sg1_243_d92","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0144","start":144,"end":146,"surface":"郅都","kind":"person","person_id":"rbv_387_iwe","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0147","start":147,"end":148,"surface":"上","kind":"person","person_id":"yqp_nlb_p1p_ACAA","status":"contextual_provisional"},{"id":"c-shiji-122-kuli:m028-0168","