000260","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0401","start":401,"end":404,"surface":"匠驪氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0405","start":405,"end":407,"surface":"欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0408","start":408,"end":411,"surface":"中行偃","kind":"person","person_id":"cbr-p001438","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0416","start":416,"end":418,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0423","start":423,"end":425,"surface":"胥童","kind":"person","person_id":"cbr-p001804","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0430","start":430,"end":433,"surface":"公子周","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0441","start":441,"end":443,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p113","text":"悼公元年正月庚申，欒書、中行偃弒厲公，葬之以一乘車。厲公囚六日死，死十日庚午，智罃迎公子周來，至絳，刑鷄與大夫盟而立之，是爲悼公。辛巳，朝武宮。二月乙酉，卽位。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m113-0000","start":0,"end":2,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m113-0009","start":9,"end":11,"surface":"欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m113-0012","start":12,"end":15,"surface":"中行偃","kind":"person","person_id":"cbr-p001438","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m113-0016","start":16,"end":18,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m113-0026","start":26,"end":28,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m113-0039","start":39,"end":41,"surface":"智罃","kind":"person","person_id":"cbr-p001785","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m113-0042","start":42,"end":45,"surface":"公子周","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m113-0062","start":62,"end":64,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p114","text":"悼公周者，其大父捷，晉襄公少子也，不得立，號爲桓叔，桓叔最愛。桓叔生惠伯談，談生悼公周。周之立，年十四矣。悼公曰：「大父、父皆不得立而辟難於周，客死焉。寡人自以疎遠，毋幾爲君。今大夫不忘文、襄之意而惠立桓叔之後，賴宗廟大夫之靈，得奉晉祀，豈敢不戰戰乎？大夫其亦佐寡人！」於是逐不臣者七人，修舊功，施德惠，收文公入時功臣後。秋，伐鄭。鄭師敗，遂至陳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m114-0000","start":0,"end":3,"surface":"悼公周","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0008","start":8,"end":9,"surface":"捷","kind":"person","person_id":"cbr-p001806","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0010","start":10,"end":13,"surface":"晉襄公","kind":"person","person_id":"cbr-p000396","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0023","start":23,"end":25,"surface":"桓叔","kind":"person","person_id":"cbr-p001806","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0026","start":26,"end":28,"surface":"桓叔","kind":"person","person_id":"cbr-p001806","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0031","start":31,"end":33,"surface":"桓叔","kind":"person","person_id":"cbr-p001806","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0034","start":34,"end":37,"surface":"惠伯談","kind":"person","person_id":"cbr-p001807","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0038","start":38,"end":39,"surface":"談","kind":"person","person_id":"cbr-p001807","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0040","start":40,"end":43,"surface":"悼公周","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0044","start":44,"end":45,"surface":"周","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0053","start":53,"end":55,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0101","start":101,"end":103,"surface":"桓叔","kind":"person","person_id":"cbr-p001806","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m114-0153","start":153,"end":155,"surface":"文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p115","text":"三年，晉會諸侯。悼公問群臣可用者，祁傒舉解狐。解狐，傒之仇。復問，舉其子祁午。君子曰：「祁傒可謂不黨矣！外舉不隱仇，内舉不隱子。」方會諸侯，悼公弟楊干亂行，魏絳戮其仆。悼公怒，或諫公，公卒賢絳，任之政，使和戎，戎大親附。十一年，悼公曰：「自吾用魏絳，九合諸侯，和戎、翟，魏子之力也。」賜之樂，三讓乃受之。冬，秦取我櫟。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m115-0008","start":8,"end":10,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0017","start":17,"end":19,"surface":"祁傒","kind":"person","person_id":"cbr-p001808","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0020","start":20,"end":22,"surface":"解狐","kind":"person","person_id":"cbr-p001809","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0023","start":23,"end":25,"surface":"解狐","kind":"person","person_id":"cbr-p001809","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0026","start":26,"end":27,"surface":"傒","kind":"person","person_id":"cbr-p001808","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0036","start":36,"end":38,"surface":"祁午","kind":"person","person_id":"cbr-p001810","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0044","start":44,"end":46,"surface":"祁傒","kind":"person","person_id":"cbr-p001808","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0070","start":70,"end":72,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0073","start":73,"end":75,"surface":"楊干","kind":"person","person_id":"cbr-p001811","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0078","start":78,"end":80,"surface":"魏絳","kind":"person","person_id":"cbr-p001812","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0081","start":81,"end":83,"surface":"其仆","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m115-0084","start":84,"end":86,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0095","start":95,"end":96,"surface":"絳","kind":"person","person_id":"cbr-p001812","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0114","start":114,"end":116,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0122","start":122,"end":124,"surface":"魏絳","kind":"person","person_id":"cbr-p001812","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m115-0135","start":135,"end":137,"surface":"魏子","kind":"person","person_id":"cbr-p001812","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p117","text":"十五年，悼公問治國於師曠。師曠曰：「惟仁義爲本。」冬，悼公卒，子平公彪立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m117-0004","start":4,"end":6,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m117-0010","start":10,"end":12,"surface":"師曠","kind":"person","person_id":"cbr-p001813","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m117-0013","start":13,"end":15,"surface":"師曠","kind":"person","person_id":"cbr-p001813","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m117-0027","start":27,"end":29,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m117-0032","start":32,"end":35,"surface":"平公彪","kind":"person","person_id":"cbr-p000416","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p142","text":"太史公曰：晉文公，古所謂明君也，亡居外十九年，至困約，及卽位而行賞，尚忘介子推，況驕主乎？靈公旣弒，其後成、景致嚴，至厲大刻，大夫懼誅，禍作。悼公以後日衰，六卿專權。故君道之御其臣下。固不易哉！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m142-0000","start":0,"end":3,"surface":"太史公","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m142-0005","start":5,"end":8,"surface":"晉文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m142-0036","start":36,"end":39,"surface":"介子推","kind":"person","person_id":"cbr-p001753","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m142-0052","start":52,"end":55,"surface":"成、景","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m142-0071","start":71,"end":73,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m142-0078","start":78,"end":80,"surface":"六卿","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"}],"chapter_id":"c-shiji-039-jin","boo