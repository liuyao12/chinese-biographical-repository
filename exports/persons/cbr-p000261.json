":114,"end":116,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p115","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m117-0004","start":4,"end":6,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p117","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m117-0027","start":27,"end":29,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p117","chapter_id":"c-shiji-039-jin"},{"id":"c-shiji-039-jin:m142-0071","start":71,"end":73,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional","paragraph_id":"c-shiji-039-jin:p142","chapter_id":"c-shiji-039-jin"}],"relations":[{"id":"a-shiji039-053","subject_person_id":"cbr-p000261","predicate":"father","object_person_id":"cbr-p001807","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p114","quote":"悼公周者，其大父捷，晉襄公少子也，不得立，號爲桓叔，桓叔最愛。桓叔生惠伯談，談生悼公周。周之立，年十四矣。悼公曰：「大父、父皆不得立而辟難於周，客死焉。寡人自以疎遠，毋幾爲君。今大夫不忘文、襄之意而惠立桓叔之後，賴宗廟大夫之靈，得奉晉祀，豈敢不戰戰乎？大夫其亦佐寡人！」於是逐不臣者七人，修舊功，施德惠，收文公入時功臣後。秋，伐鄭。鄭師敗，遂至陳。"}],"qualifiers":{"source_term":"談生悼公周","historicity":"historical_tradition"},"interpretation_note":"保存本段明示親屬或生育敘事；不由繼位補父子，不補闕代。母、女弟、庶孫等依原文；人物暫同指及不同篇主張仍待覆核。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji039-054","subject_person_id":"cbr-p000261","predicate":"grandfather","object_person_id":"cbr-p001806","status":"source_attested","evidence":[{"chapter_id":"c-shiji-039-jin","source_id":"s-shiji-039-jin","paragraph_id":"c-shiji-039-jin:p114","quote":"悼公周者，其大父捷，晉襄公少子也，不得立，號爲桓叔，桓叔最愛。桓叔生惠伯談，談生悼公周。周之立，年十四矣。悼公曰：「大父、父皆不得立而辟難於周，客死焉。寡人自以疎遠，毋幾爲君。今大夫不忘文、襄之意而惠立桓叔之後，賴宗廟大夫之靈，得奉晉祀，豈敢不戰戰乎？大夫其亦佐寡人！」於是逐不臣者七人，修舊功，施德惠，收文公入時功臣後。秋，伐鄭。鄭師敗，遂至陳。"}],"qualifiers":{"source_term":"其大父捷","historicity":"historical_tradition"},"interpretation_note":"保存本段明示親屬或生育敘事；不由繼位補父子，不補闕代。母、女弟、庶孫等依原文；人物暫同指及不同篇主張仍待覆核。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji032-075","person_id":"cbr-p000261","surfaces":["晉悼公"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-032-qi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p057","quote":"二十一年，定王崩，子簡王夷立。簡王十三年，晉殺其君厲公，迎子周於周，立為悼公。"},{"paragraph_id":"c-shiji-032-qi:p060","quote":"靈公九年，晉欒書弒其君厲公。十年，晉悼公伐齊，齊令公子光質晉。十九年，立子光為太子，高厚傅之，令會諸侯盟於鐘離。二十七年，晉使中行獻子伐齊。齊師敗，靈公走入臨菑。晏嬰止靈公，靈公弗從。曰：「君亦無勇矣！」晉兵遂圍臨菑，臨菑城守不敢出，晉焚郭中而去。"}],"rationale":"按齊君繼位、家族明示與田氏政變的具體敘事暫定異稱。晉／魯昭公、齊／吳公子光分開，鮑子、鮑牧及監止、子我暫不合併，所錄或曰及疑讀仍待版本覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji033-099","person_id":"cbr-p000261","surfaces":["悼公","晉悼公"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-033-lu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p057","quote":"二十一年，定王崩，子簡王夷立。簡王十三年，晉殺其君厲公，迎子周於周，立為悼公。"},{"paragraph_id":"c-shiji-033-lu:p063","quote":"襄公元年，晉立悼公。往年冬，晉欒書弒其君厲公。四年，襄公朝晉。"},{"paragraph_id":"c-shiji-033-lu:p065","quote":"九年，與晉伐鄭。晉悼公冠襄公於衛，季武子從，相行禮。"}],"rationale":"按文公以後立嗣、昭公出奔、夾谷會盟、徵百牢與魯君世系的具體事件及國別暫定異稱，後期同爵稱不與先君混同。身份、匿名指代與數位疑讀待覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji039-031","person_id":"cbr-p000261","surfaces":["公子周","周","悼公","悼公周"],"scope":"cross_chapter","chapter_ids":["c-shiji-004-zhou","c-shiji-039-jin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-004-zhou:p057","quote":"二十一年，定王崩，子簡王夷立。簡王十三年，晉殺其君厲公，迎子周於周，立為悼公。"},{"paragraph_id":"c-shiji-039-jin:p112","quote":"厲公多外嬖姬，歸，欲盡去群大夫而立諸姬兄弟。寵姬兄曰胥童，嘗與郤至有怨，及欒書又怨郤至不用其計而遂敗楚，乃使人閒謝楚。楚來詐厲公曰：「鄢陵之戰，實至召楚，欲作亂，内子周立之。會與國不具，是以事不成。」厲公告欒書。欒書曰：「其殆有矣！願公試使人之周微考之。」果使郤至於周。欒書又使公子周見郤至，郤至不知見賣也。厲公驗之，信然，遂怨郤至，欲殺之。八年，厲公獵，與姬飲，郤至殺豕奉進，宦者奪之。郤至射殺宦者。公怒，曰：「季子欺予！」將誅三郤，未發也。郤鉤欲攻公，曰：「我雖死，公亦病矣。」郤至曰：「信不反君，智不害民，勇不作亂。失此三者，誰與我？我死耳！」十二月壬午，公令胥童以兵八百人襲攻殺三郤。胥童因以劫欒書、中行偃于朝，曰：「不殺二子，患必及公。」公曰：「一旦殺三卿，寡人不忍益也。」對曰：「人將忍君。」公弗聽，謝欒書等以誅郤氏罪：「大夫復位。」二子頓首曰：「幸甚幸甚！」公使胥童爲卿。閏月乙卯，厲公游匠驪氏，欒書、中行偃以其黨襲捕厲公，囚之，殺胥童，而使人迎公子周于周而立之，是爲悼公。"},{"paragraph_id":"c-shiji-039-jin:p113","quote":"悼公元年正月庚申，欒書、中行偃弒厲公，葬之以一乘車。厲公囚六日死，死十日庚午，智罃迎公子周來，至絳，刑鷄與大夫盟而立之，是爲悼公。辛巳，朝武宮。二月乙酉，卽位。"},{"paragraph_id":"c-shiji-039-jin:p114","quote":"悼公周者，其大父捷，晉襄公少子也，不得立，號爲桓叔，桓叔最愛。桓叔生惠伯談，談生悼公周。周之立，年十四矣。悼公曰：「大父、父皆不得立而辟難於周，客死焉。寡人自以疎遠，毋幾爲君。今大夫不忘文、襄之意而惠立桓叔之後，賴宗廟大夫之靈，得奉晉祀，豈敢不戰戰乎？大夫其亦佐寡人！」於是逐不臣者七人，修舊功，施德惠，收文公入時功臣後。秋，伐鄭。鄭師敗，遂至陳。"},{"paragraph_id":"c-shiji-039-jin:p115","quote":"三年，晉會諸侯。悼公問群臣可用者，祁傒舉解狐。解狐，傒之仇。復問，舉其子祁午。君子曰：「祁傒可謂不黨矣！外舉不隱仇，内舉不隱子。」方會諸侯，悼公弟楊干亂行，魏絳戮其仆。悼公怒，或諫公，公卒賢絳，任之政，使和戎，戎大親附。十一年，悼公曰：「自吾用魏絳，九合諸侯，和戎、翟，魏子之力也。」賜之樂，三讓乃受之。冬，秦取我櫟。"},{"paragraph_id":"c-shiji-039-jin:p117","quote":"十五年，悼公問治國於師曠。師曠曰：「惟仁義爲本。」冬，悼公卒，子平公彪立。"},{"paragraph_id":"c-shiji-039-jin:p142","quote":"太史公曰：晉文公，古所謂明君也，亡居外十九年，至困約，及卽位而行賞，尚忘介子推，況驕主乎？靈公旣弒，其後成、景致嚴，至厲大刻，大夫懼誅，禍作。悼公以後日衰，六卿專權。故君道之御其臣下。固不易哉！"}],"rationale":"按本篇明示名與稱號、晉世系與具體事件暫定所列提及同指；附各段原文，未按同字短名全域合併；紀年與版本差異待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p057","text":"二十一年，定王崩，子簡王夷立。簡王十三年，晉殺其君厲公，迎子周於周，立為悼公。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m057-0005","start":5,"end":7,"surface":"定王","kind":"person","person_id":"cbr-p000256","status":"source_identified"},{"id":"c-shiji-004-zhou:m057-0010","start":10,"end":13,"surface":"簡王夷","kind":"person","person_id":"cbr-p000259","status":"source_identified"},{"id":"c-shiji-004-zhou:m057-0015","start":15,"end":17,"surface":"簡王","kind":"person","person_id":"cbr-p000259","status":"source_identified"},{"id":"c-shiji-004-zhou:m057-0025","start":25,"end":27,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"source_identified"},{"id":"c-shiji-004-zhou:m057-0029","start":29,"end":31,"surface":"子周","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m057-0036","start":36,"end":38,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-005-qin:p043","text":"景公四年，晉欒書弒其君厲公。十五年，救鄭，敗晉兵於櫟。是時晉悼公為盟主。十八年，晉悼公彊，數會諸侯，率以伐秦，敗秦軍。秦軍走，晉兵追之，遂渡涇，至棫林而還。二十七年，景公如晉，與平公盟，已而背之。三十六年，楚公子圍弒其君而自立，是為靈王。景公母弟後子鍼有寵，景公母弟富，或譖之，恐誅，乃奔晉，車重千乘。晉平公曰：「后子富如此，何以自亡？」對曰：「秦公無道，畏誅，欲待其後世乃歸。」三十九年，楚靈王彊，會諸侯於申，為盟主，殺齊慶封。景公立四十年卒，子哀公立。后子復來歸秦。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-005-qin:m043-0000","start":0,"end":2,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0005","start":5,"end":8,"surface":"晉欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0009","start":9,"end":11,"surface":"其君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m043-0011","start":11,"end":13,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0029","start":29,"end":32,"surface":"晉悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0040","start":40,"end":43,"surface":"晉悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0083","start":83,"end":85,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0089","start":89,"end":91,"surface":"平公","kind":"person","person_id":"cbr-p000416","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0103","start":103,"end":107,"surface":"楚公子圍","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0108","start":108,"end":110,"surface":"其君","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m043-0116","start":116,"end":118,"surface":"靈王","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0119","start":119,"end":121,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0123","start":123,"end":126,"surface":"後子鍼","kind":"person","person_id":"cbr-p000418","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0129","start":129,"end":131,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0151","start":151,"end":154,"surface":"晉平公","kind":"person","person_id":"cbr-p000416","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0157","start":157,"end":159,"surface":"后子","kind":"person","person_id":"cbr-p000418","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0173","start":173,"end":175,"surface":"秦公","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體或待核指代；不由官稱或熟知世系補造個人。"},{"id":"c-shiji-005-qin:m043-0195","start":195,"end":198,"surface":"楚靈王","kind":"person","person_id":"cbr-p000417","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0211","start":211,"end":214,"surface":"齊慶封","kind":"person","person_id":"cbr-p000419","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0215","start":215,"end":217,"surface":"景公","kind":"person","person_id":"cbr-p000414","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0224","start":224,"end":226,"surface":"哀公","kind":"person","person_id":"cbr-p000420","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m043-0228","start":228,"end":230,"surface":"后子","kind":"person","person_id":"cbr-p000418","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-032-qi:p060","text":"靈公九年，晉欒書弒其君厲公。十年，晉悼公伐齊，齊令公子光質晉。十九年，立子光為太子，高厚傅之，令會諸侯盟於鐘離。二十七年，晉使中行獻子伐齊。齊師敗，靈公走入臨菑。晏嬰止靈公，靈公弗從。曰：「君亦無勇矣！」晉兵遂圍臨菑，臨菑城守不敢出，晉焚郭中而去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-032-qi:m060-0000","start":0,"end":2,"surface":"靈公","kind":"person","person_id":"cbr-p001156","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0006","start":6,"end":8,"surface":"欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0011","start":11,"end":13,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0017","start":17,"end":20,"surface":"晉悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0025","start":25,"end":28,"surface":"公子光","kind":"person","person_id":"cbr-p000264","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0036","start":36,"end":38,"surface":"子光","kind":"person","person_id":"cbr-p000264","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0042","start":42,"end":44,"surface":"高厚","kind":"person","person_id":"cbr-p001157","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0063","start":63,"end":67,"surface":"中行獻子","kind":"person","person_id":"cbr-p001158","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0074","start":74,"end":76,"surface":"靈公","kind":"person","person_id":"cbr-p001156","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0081","start":81,"end":83,"surface":"晏嬰","kind":"person","person_id":"cbr-p001044","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0084","start":84,"end":86,"surface":"靈公","kind":"person","person_id":"cbr-p001156","status":"contextual_provisional"},{"id":"c-shiji-032-qi:m060-0087","start":87,"end":89,"surface":"靈公","kind":"person","person_id":"cbr-p001156","status":"contextual_provisional"}],"chapter_id":"c-shiji-032-qi","book_id":"b-shiji-032","work_id":"w-shiji","source_id":"s-shiji-032-qi"},{"id":"c-shiji-033-lu:p063","text":"襄公元年，晉立悼公。往年冬，晉欒書弒其君厲公。四年，襄公朝晉。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m063-0000","start":0,"end":2,"surface":"襄公","kind":"person","person_id":"cbr-p001273","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m063-0007","start":7,"end":9,"surface":"悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m063-0014","start":14,"end":17,"surface":"晉欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m063-0020","start":20,"end":22,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m063-0026","start":26,"end":28,"surface":"襄公","kind":"person","person_id":"cbr-p001273","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-033-lu:p065","text":"九年，與晉伐鄭。晉悼公冠襄公於衛，季武子從，相行禮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-033-lu:m065-0008","start":8,"end":11,"surface":"晉悼公","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m065-0012","start":12,"end":14,"surface":"襄公","kind":"person","person_id":"cbr-p001273","status":"contextual_provisional"},{"id":"c-shiji-033-lu:m065-0017","start":17,"end":20,"surface":"季武子","kind":"person","person_id":"cbr-p001274","status":"contextual_provisional"}],"chapter_id":"c-shiji-033-lu","book_id":"b-shiji-033","work_id":"w-shiji","source_id":"s-shiji-033-lu"},{"id":"c-shiji-039-jin:p112","text":"厲公多外嬖姬，歸，欲盡去群大夫而立諸姬兄弟。寵姬兄曰胥童，嘗與郤至有怨，及欒書又怨郤至不用其計而遂敗楚，乃使人閒謝楚。楚來詐厲公曰：「鄢陵之戰，實至召楚，欲作亂，内子周立之。會與國不具，是以事不成。」厲公告欒書。欒書曰：「其殆有矣！願公試使人之周微考之。」果使郤至於周。欒書又使公子周見郤至，郤至不知見賣也。厲公驗之，信然，遂怨郤至，欲殺之。八年，厲公獵，與姬飲，郤至殺豕奉進，宦者奪之。郤至射殺宦者。公怒，曰：「季子欺予！」將誅三郤，未發也。郤鉤欲攻公，曰：「我雖死，公亦病矣。」郤至曰：「信不反君，智不害民，勇不作亂。失此三者，誰與我？我死耳！」十二月壬午，公令胥童以兵八百人襲攻殺三郤。胥童因以劫欒書、中行偃于朝，曰：「不殺二子，患必及公。」公曰：「一旦殺三卿，寡人不忍益也。」對曰：「人將忍君。」公弗聽，謝欒書等以誅郤氏罪：「大夫復位。」二子頓首曰：「幸甚幸甚！」公使胥童爲卿。閏月乙卯，厲公游匠驪氏，欒書、中行偃以其黨襲捕厲公，囚之，殺胥童，而使人迎公子周于周而立之，是爲悼公。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m112-0000","start":0,"end":2,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0003","start":3,"end":6,"surface":"外嬖姬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0017","start":17,"end":21,"surface":"諸姬兄弟","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0022","start":22,"end":25,"surface":"寵姬兄","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m112-0026","start":26,"end":28,"surface":"胥童","kind":"person","person_id":"cbr-p001804","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0031","start":31,"end":33,"surface":"郤至","kind":"person","person_id":"cbr-p001802","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0037","start":37,"end":39,"surface":"欒書","kind":"person","person_id":"cbr-p000415","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0041","start":41,"end":43,"surface":"郤至","kind":"person","person_id":"cbr-p001802","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0062","start":62,"end":64,"surface":"厲公","kind":"person","person_id":"cbr-p000260","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0073","start":73,"end":74,"surface":"至","kind":"person","person_id":"cbr-p001802","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0083","start":83,"end":84,"surface":"周","kind":"person","person_id":"cbr-p000261","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m112-0100","start":100,"end":102,"surfac