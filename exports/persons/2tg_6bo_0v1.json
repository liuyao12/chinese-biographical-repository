ue,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-056-jiang-dun:p001:m0178","surface":"阮裕","start":178,"end":180,"person_id":"2tg_6bo_0v1","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-056-jiang-dun:p001","chapter_id":"c-jinshu-056-jiang-dun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-056-jiang-dun:p001","text":"惇字思悛，孝友淳粹，高節邁俗。性好學，儒玄並綜。每以為君子立行，應依禮而動，雖隱顯殊途，未有不傍禮教者也。若乃放達不羈，以肆縱為貴者，非但動違禮法，亦道之所棄也。乃著《通道崇檢論》，世咸稱之。蘇峻之亂，避地東陽山，太尉郗鑒檄為兗州治中，又辟太尉掾；康帝為司徒，亦辟焉；征西將軍庾亮請為儒林參軍；徵拜博士、著作郎，皆不就。邑裏宗其道，有事必諮而後行。東陽太守阮裕、長山令王濛，皆一時名士，並與惇遊處，深相欽重。養志二十餘年，永和九年卒，時年四十九，友朋相與刊石立頌，以表德美雲。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":56,"last_line":56,"raw_start":5519,"raw_end":5766,"raw_character_offsets":[5521,5522,5523,5524,5525,5526,5527,5528,5529,5530,5531,5532,5533,5534,5535,5536,5537,5538,5539,5540,5541,5542,5543,5544,5545,5546,5547,5548,5549,5550,5551,5552,5553,5554,5555,5556,5557,5558,5559,5560,5561,5562,5563,5564,5565,5566,5567,5568,5569,5570,5571,5572,5573,5574,5575,5576,5577,5578,5579,5580,5581,5582,5583,5584,5585,5586,5587,5588,5589,5590,5591,5592,5593,5594,5595,5596,5597,5598,5599,5600,5601,5602,5603,5604,5605,5606,5607,5608,5609,5610,5611,5612,5613,5614,5615,5616,5617,5618,5619,5620,5621,5622,5623,5624,5625,5626,5627,5628,5629,5630,5631,5632,5633,5634,5635,5636,5637,5638,5639,5640,5641,5642,5643,5644,5645,5646,5647,5648,5649,5650,5651,5652,5653,5654,5655,5656,5657,5658,5659,5660,5661,5662,5663,5664,5665,5666,5667,5668,5669,5670,5671,5672,5673,5674,5675,5676,5677,5678,5679,5680,5681,5682,5683,5684,5685,5686,5687,5688,5689,5690,5691,5692,5693,5694,5695,5696,5697,5698,5699,5700,5701,5702,5703,5704,5705,5706,5707,5708,5709,5710,5711,5712,5713,5714,5715,5716,5717,5718,5719,5720,5721,5