urrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-075-xunsong-families"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"person_id":"xmr_2es_v7z","title":null,"surname":"段","ming":"龕","additional_names":[],"work_id":"w-jinshu","book_id":"b-jinshu-075","chapter_id":"c-jinshu-075-xunsong-families","source_id":"s-jinshu-075-xunsong-families","paragraph_id":"c-jinshu-075-xunsong-families:xunxian-north:p001","status":"editorial_provisional","human_reviewed":false,"model":null,"note":"本段段蘭及蘭指廣固被圍而荀羨奉詔救援的段龕；卷110明段蘭之子龕及同次援救、王騰事件，通鑑亦明段龕。保留正文段蘭，不把段蘭當段龕本名或合併其父；後文慕容蘭另人。","references":[{"title":"《晉書》卷110段龕被圍及荀羨援救","url":"https://zh.wikisource.org/w/index.php?oldid=2812770","source_revision":2812770,"source_position":{"first_line":43,"last_line":43},"quote":"初，段蘭之子龕因冉閔之亂","raw_context_quote":"初，段蘭之子龕因冉閔之亂，擁眾東屯廣固，自號齊王，稱籓於建鄴，遣書抗中表之儀，非俊正位。俊遣慕容恪、慕容塵討之。恪既濟河。龕弟羆驍勇有智計，言於龕曰：「慕容恪善用兵，加其眾旅既盛，恐不可抗也。若頓兵城下，雖復請降，懼終不聽。王但固守，羆請率精銳距之。若其戰捷，王可馳來追擊，使虜匹馬無反。如其敗也，遽出請降，不失千戶侯也。」龕弗從。羆固請行，龕怒斬之，率眾三萬來距恪。恪遇龕于濟水之南，與戰，大敗之，遂斬其弟欽，盡俘其眾。恪進圍廣固，諸將勸恪宜急攻之，恪曰：「軍勢有宜緩以克敵，有宜急而取之。若彼我勢均，且有強援，慮腹背之患者，須急攻之，以速大利。如其我強彼弱，外無寇援，力足制之者，當羈縻守之，以待其斃。兵法十圍五攻，此之謂也。龕恩結賊黨，眾未離心，濟南之戰，非不銳也，但其用之無術，以致敗耳。今憑固天險，上下同心，攻守勢倍，軍之常法。若其促攻，不過數旬，克之必矣，但恐傷吾士眾。自有事已來，卒不獲寧，吾每思之，不覺忘寢，亦何宜輕殘人命乎！當持久以取耳。」諸將皆曰：「非所及也。」乃築室反耕，嚴固圍壘。龕所署徐州刺史王騰、索頭單于薛雲降於恪。段龕之被圍也，遣使詣建鄴請救。穆帝遣北中郎將荀羨赴之，憚虜強遷延不敢進。攻破陽都，斬王騰以歸。恪遂克廣固，以龕為伏順將軍，徙鮮卑胡羯三千餘戶於薊，留慕容塵鎮廣固，恪振旅而歸。","raw_context_quote_sha256":"e8eb84a50f33233a222389e8b8781175e7cdb87d22bebb6c5f431d63dcfca602","wikitext_sha256":"4f0b6b922365125c9ef7d6a2965cd75bd1719a6bfc5050e0f6f42c968ca20db9","scope":"primary_parallel_context_identification","image_verified":false},{"title":"《資治通鑑》卷100荀羨救段龕","url":"https://zh.wikisource.org/w/index.php?oldid=1151319","source_revision":1151319,"source_position":{"first_line":97,"last_line":97},"quote":"段龕遣其屬段□來求救","raw_context_quote":"段龕遣其屬段□來求救，詔徐州刺史荀羨將兵隨□救之。羨至琅邪，憚燕兵之強，不敢進。王騰寇鄄城，羨進攻陽都，會霖雨，城壞，獲騰，斬之。","raw_context_quote_sha256":"e3eb399755f1bffbaf67a110c4fd1daacaaa2090a0ffaa36dcd2978423ee4b10","wikitext_sha256":"417fbfdd7e6385fb274034f7fb66b5b60d65f773935acb4712939e6375e45341","scope":"primary_parallel_context_identification","image_verified":false}],"quote_passage_ref":"data/corpus/jinshu/075.json"}],"mentions":[{"id":"c-jinshu-075-xunsong-families:xunxian-north:p001:m0005","start":5,"end":7,"surface":"段蘭","kind":"person","person_id":"xmr_2es_v7z","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunxian-north:p001","chapter_id":"c-jinshu-075-xunsong-families"},{"id":"c-jinshu-075-xunsong-families:xunxian-north:p001:m0053","start":53,"end":54,"surface":"蘭","kind":"person","person_id":"xmr_2es_v7z","status":"contextual_provisional","paragraph_id":"c-jinshu-075-xunsong-families:xunxian-north:p001","chapter_id":"c-jinshu-075-xunsong-families"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-jinshu075-duankan-received-duanlan","person_id":"xmr_2es_v7z","surfaces":["段蘭","蘭"],"scope":"same_chapter","chapter_ids":["c-jinshu-075-xunsong-families"],"status":"contextual_provisional","confidence_level":"high","identification_basis":