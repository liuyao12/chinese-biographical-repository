pretation_note":"本篇明示父子，匿名父祖不補姓名；分支字母不表示出生排行。","reviewer":"Codex（AI 代理）","human_reviewed":false}},{"id":"rl6_a40_3hj_AA","label":"馮唐（張釋之馮唐列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"馮唐","mention_ids":["c-shiji-102-zhangfeng:m011-0000","c-shiji-102-zhangfeng:m012-0490","c-shiji-102-zhangfeng:m013-0024"]},{"surface":"馮公","mention_ids":["c-shiji-102-zhangfeng:m014-0018","c-shiji-102-zhangfeng:m014-0085","c-shiji-102-zhangfeng:m015-0036"]},{"surface":"唐","mention_ids":["c-shiji-102-zhangfeng:m011-0020","c-shiji-102-zhangfeng:m011-0041","c-shiji-102-zhangfeng:m011-0057","c-shiji-102-zhangfeng:m011-0116","c-shiji-102-zhangfeng:m011-0143","c-shiji-102-zhangfeng:m011-0233","c-shiji-102-zhangfeng:m011-0268","c-shiji-102-zhangfeng:m011-0287","c-shiji-102-zhangfeng:m012-0031","c-shiji-102-zhangfeng:m012-0051","c-shiji-102-zhangfeng:m012-0507","c-shiji-102-zhangfeng:m013-0008","c-shiji-102-zhangfeng:m013-0027","c-shiji-102-zhangfeng:m013-0042"]},{"surface":"父老","mention_ids":["c-shiji-102-zhangfeng:m011-0045"]},{"surface":"父","mention_ids":["c-shiji-102-zhangfeng:m011-0110"]}],"evidence":[{"mention_id":"c-shiji-102-zhangfeng:m011-0000","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p011","quote":"馮唐"},{"mention_id":"c-shiji-102-zhangfeng:m012-0490","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p012","quote":"馮唐"},{"mention_id":"c-shiji-102-zhangfeng:m013-0024","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p013","quote":"馮唐"},{"mention_id":"c-shiji-102-zhangfeng:m014-0018","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p014","quote":"馮公"},{"mention_id":"c-shiji-102-zhangfeng:m014-0085","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p014","quote":"馮公"},{"mention_id":"c-shiji-102-zhangfeng:m015-0036","chapter_id":"c-shiji-102-zhangfeng","paragraph_id":"c-shiji-102-zhangfeng:p015","quote":"馮公"},{"menti