gshu-epitaph-zju/capture.json","metadata_path":"source-evidence/yangshu-epitaph-zju/witness-metadata.json","transcription_page_visually_checked":false,"original_stone_or_rubbing_image_verified":false,"underlying_rubbing_personally_accessed":false,"scope":"complete_single_inscription_not_modern_article"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chinese_civil_year","civil_year_label_coverage":"partial","regnal_year_crosses_ce_year_is_gregorian_projection":true},"assembled_identity":{"person_id":"fum_370_iq6_AAB","representative_source_person_id":"fum_370_iq6_AAB","source_person_ids":["fum_370_iq6_AAB"],"identity_equivalence_decision_ids":[],"parent_person_id":"fum_370_iq6_AA","source_assertion_id":null,"parent_connection":{"type":"parent_between_consecutive_ancestors","interpretation_basis":"epitaph_bound_titled_ancestor_sequence","chain_subject_person_id":"fum_370_iq6_AABA","nearer_ancestor_assertion_id":"a-yangshu-zju-nearkin-001","farther_ancestor_assertion_id":"a-yangshu-zju-nearkin-002","status":"contextual_provisional","human_reviewed":false,"rationale":"同誌二郡府君之孫與匿名簡公之第六子，按相鄰世距編輯安置；祖首選真可撤回，父不合懿或暉。","references":[{"work_id":"w-epitaph-yangshu","book_id":"b-epitaph-yangshu-full","source_id":"s-epitaph-yangshu-zju-b-xabl-004","chapter_id":"c-epitaph-yangshu-zju-full","paragraph_id":"c-epitaph-yangshu-zju-full:p001","quote":"魏故鎮遠將軍華州刺史楊君墓誌銘。君姓楊，諱舒，字延景，恒農華陰潼鄉習仙里人也。河內清河二郡府君之孫，洛州刺史恒農簡公之第六子。漢太尉震，晉儀同瑤，即其世矣。君體河嶽之淑靈，膺積福之餘慶。淵度凝深，風流濬邈。閨門垂孝敬之譽，鄉黨流汎愛之仁。爰自弱冠，銳情典誥，終朝下幃，薄暮潭思。業尚三禮之學，廣采百家之論。才藝優贍，道術通洽。汪汪焉，詳詳焉。允所謂黃中之儁髦，德音之令准者已。太和中，以勳望之冑，而除散騎郎。暨世宗即祚，壽春送款，君為揚武長史受降納附。未幾，以援接之功，除大鴻臚丞。弼贊九儀，賓翼四門，蕃衛載緝，戎陌來庭。義陽之役，君參鎮南軍事，職掌壘和，任屬防禦。嚴栅櫓之剬，峻雲梯之嶮。憑陵之志莫展，窺〓之望斯絕。又監別將田益宗軍事，破偽鈞城而還。俘虜二千，收甲萬計。以功遷司空府中兵參軍。俄而偽臨川王簫宏，敢率蟻徒殲我粱城，以君歷試惟允，復參征南軍事。都督元王，特深器春，杖以幃幄之任，諮以决勝之謀。及偽軍一遁，烽煙四起。君領羽林鐵騎，長驅淮滸，救其燌燒之委，收其器械之資。乃令邊儲載衍，軍士充仍者，君有力焉。永平初載，望府啟建，寮佐之選，妙盡時英。以君為伏波將軍、參太尉高陽王府事。於是翼亮台鉉，毗道鼎司。剋昭文薄之能，實允官人之職。及遭新昌君艱，幾盡者二三。孺慕之音，晝夜不絕，漿溢之禮，歷口莫飲。自爾尫頓，日就危惙。雖顏丁之居憂，遠有慙德；曾柴之銜恤，寧或能擬。春秋卌有六，以延昌四年九月九日，於洛陽縣之依仁里第瘠甚而卒。皇帝悼惜，朝野嗟痛。詔遣謁者持節册贈鎮遠將軍、華州刺史，所以旌崇孝德，禮也。粵以熙平二年九月二日，卜窆於本縣之舊塋焉。乃作銘曰：於鑠使君，清風獨絕。太尉之胤，儀同之裔。冠盖三秦，本枝百世。粵挺明德，聿遵前列。如玉之瑩，如冰之潔。永言孝友，率志貞厲。沖年受業，雅愛斯文。銳情無惰，潭思能懃。終朝章句，旦夕典墳。淵才博贍，高志脫群。九流畢鏡，八素咸分。振韍玉墀，濯纓朱廡。四門載穆，九儀率序。帝求鼎佐，唯德是與。我有儁哲，攬衣而處。三緝戎機，再遊台府。軍政允洽，槐風克舉。新昌殞世，瘠甚而卒。忪忪遺嗣，哀哀弟姪。書宮寂寥，琴庭蕭瑟。皇鑒乃春，追增顯秩。輝賁泉門，光昭松室。輒勒徽猷，恧慙無述。","subject_person_mention_id":"c-epitaph-yangshu-zju-full:p001:m0059","object_person_mention_id":"c-epitaph-yangshu-zju-full:p001:m0050","assertion_id":"a-yangshu-zju-nearkin-001","url":"http://csid.zju.edu.cn/tomb/stone/detail?id=40288b955bd07752015bfb74a80002de","scope":"同一完整墓誌父與祖相鄰世距，祖官稱首選身份可撤回；僅編輯安置，不添來源父子。"},{"work_id":"w-epitaph-yangshu","book_id":"b-epitaph-yangshu-full","source_id":"s-epitaph-yangshu-zju-b-xabl-004","chapter_id":"c-epitaph-yangshu-zju-full","paragraph_id":"c-epitaph-yangshu-zju-full:p001","quote":"魏故鎮遠將軍華州刺史楊君墓誌銘。君姓楊，諱舒，字延景，恒農華陰潼鄉習仙里人也。河內清河二郡府君之孫，洛州刺史恒農簡公之第六子。漢太尉震，晉儀同瑤，即其世矣。君體河嶽之淑靈，膺積福之餘慶。淵度凝深，風流濬邈。閨門垂孝敬之譽，鄉黨流汎愛之仁。爰自弱冠，銳情典誥，終朝下幃，薄暮潭思。業尚三禮之學，廣采百家之論。才藝優贍，道術通洽。汪汪焉，詳詳焉。允所謂黃中之儁髦，德音之令准者已。太和中，以勳望之冑，而除散騎郎。暨世宗即祚，壽春送款，君為揚武長史受降納附。未幾，以援接之功，除大鴻臚丞。弼贊九儀，賓翼四門，蕃衛載緝，戎陌來庭。義陽之役，君參鎮南軍事，職掌壘和，任屬防禦。嚴栅櫓之剬，峻雲梯之嶮。憑陵之志莫展，窺〓之望斯絕。又監別將田益宗軍事，破偽鈞城而還。俘虜二千，收甲萬計。以功遷司空府中兵參軍。俄而偽臨川王簫宏，敢率蟻徒殲我粱城，以君歷試惟允，復參征南軍事。都督元王，特深器春，杖以幃幄之任，諮以决勝之謀。及偽軍一遁，烽煙四起。君領羽林鐵騎，長驅淮滸，救其燌燒之委，收其器械之資。乃令邊儲載衍，軍士充仍者，君有力焉。永平初載，望府啟建，寮佐之選，妙盡時英。以君為伏波將軍、參太尉高陽王府事。於是翼亮台鉉，毗道鼎司。剋昭文薄之能，實允官人之職。及遭新昌君艱，幾盡者二三。孺慕之音，晝夜不絕，漿溢之禮，歷口莫飲。自爾尫頓，日就危惙。雖顏丁之居憂，遠有慙德；曾柴之銜恤，寧或能擬。春秋卌有六，以延昌四年九月九日，於洛陽縣之依仁里第瘠甚而卒。皇帝悼惜，朝野嗟痛。詔遣謁者持節册贈鎮遠將軍、華州刺史，所以旌崇孝德，禮也。粵以熙平二年九月二日，卜窆於本縣之舊塋焉。乃作銘曰：於鑠使君，清風獨絕。太尉之胤，儀同之裔。冠盖三秦，本枝百世。粵挺明德，聿遵前列。如玉之瑩，如冰之潔。永言孝友，率志貞厲。沖年受業，雅愛斯文。銳情無惰，潭思能懃。終朝章句，旦夕典墳。淵才博贍，高志脫群。九流畢鏡，八素咸分。振韍玉墀，濯纓朱廡。四門載穆，九儀率序。帝求鼎佐，唯德是與。我有儁哲，攬衣而處。三緝戎機，再遊台府。軍政允洽，槐風克舉。新昌殞世，瘠甚而卒。忪忪遺嗣，哀哀弟姪。書宮寂寥，琴庭蕭瑟。皇鑒乃春，追增顯秩。輝賁泉門，光昭松室。輒勒徽猷，恧慙無述。","subject_person_mention_id":"c-epitaph-yangshu-zju-full:p001:m0048","object_person_mention_id":"c-epitaph-yangshu-zju-full:p001:m0039","assertion_id":"a-yangshu-zju-nearkin-002","url":"http://csid.zju.edu.cn/tomb/stone/detail?id=40288b955bd07752015bfb74a80002de","scope":"同一完整墓誌父與祖相鄰世距，祖官稱首選身份可撤回；僅編輯安置，不添來源父子。"}],"ancestor_identity_reference":{"path":"source-evidence/yangshu-family-placement/current-projections/identity-review.json","decision_key":"grandfather"}},"assembly_id":"family-hongnong-yang-jie-close","root_person_id":"fum_370_iq6","status":"contextual_provisional","human_reviewed":false}}
