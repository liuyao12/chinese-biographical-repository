-zju-full:p001:m0050","mention_ids":["c-epitaph-yangshu-zju-full:p001:m0050"],"kind":"paragraph"}],"mention_count":1,"duplicate_mention_count":0,"paragraph_occurrence_count":1,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"1處獨立位置，1個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-epitaph-yangshu-zju-b-xabl-004"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-yangshu-zju-nearkin-001","subject_person_id":"fum_370_iq6_AABA","predicate":"father","object_person_id":"fum_370_iq6_AAB","status":"source_attested","qualifiers":{"source_term":"第六子","source_clause_binding":{"kind":"epitaph_named_head_titled_ancestors","paragraph_id":"c-epitaph-yangshu-zju-full:p001","source_id":"s-epitaph-yangshu-zju-b-xabl-004","paragraph_sha256":"a6f61c0ba2bad09388efd4e6a7ee86acd5c0ae798c778685c81df6b8a7c21fc3","roles":{"surname":"c-epitaph-yangshu-zju-full:p001:m0018","head":"c-epitaph-yangshu-zju-full:p001:m0021","zi":"c-epitaph-yangshu-zju-full:p001:m0024","grandfather":"c-epitaph-yangshu-zju-full:p001:m0039","grandchild":"c-epitaph-yangshu-zju-full:p001:m0048","father":"c-epitaph-yangshu-zju-full:p001:m0050","son":"c-epitaph-yangshu-zju-full:p001:m0059"}},"birth_order":{"parent_person_id":"fum_370_iq6_AAB","scope":"sons_of_parent","ordinal":6,"position":"unspecified","interpretation_status":"source_attested"}},"evidence":[{"work_id":"w-epitaph-yangshu","book_id":"b-epitaph-yangshu-full","source_id":"s-epitaph-yangshu-zju-b-xabl-004","chapter_id":"c-epitaph-yangshu-zju-full","paragraph_id":"c-epitaph-yangshu-zju-full:p001","quote":"魏故鎮遠將軍華州刺史楊君墓誌銘。君姓楊，諱舒，字延景，恒農華陰潼鄉習仙里人也。河內清河二郡府君之孫，洛州刺史恒農簡公之第六子。漢太尉震，晉儀同瑤，即其世矣。君體河嶽之淑靈，膺積福之餘慶。淵度凝深，風流濬邈。閨門垂孝敬之譽，鄉黨流汎愛之仁。爰自弱冠，銳情典誥，終朝下幃，薄暮潭思。業尚三禮之學，廣采百家之論。才藝優贍，道術通洽。汪汪焉，詳詳焉。允所謂黃中之儁髦，德音之令准者已。太和中，以勳望之冑，而除散騎郎。暨世宗即祚，壽春送款，君為揚武長史受降納附。未幾，以援接之功，除大鴻臚丞。弼贊九儀，賓翼四門，蕃衛載緝，戎陌來庭。義陽之役，君參鎮南軍事，職掌壘和，任屬防禦。嚴栅櫓之剬，峻雲梯之嶮。憑陵之志莫展，窺〓之望斯絕。又監別將田益宗軍事，破偽鈞城而還。俘虜二千，收甲萬計。以功遷司空府中兵參軍。俄而偽臨川王簫宏，敢率蟻徒殲我粱城，以君歷試惟允，復參征南軍事。都督元王，特深器春，杖以幃幄之任，諮以决勝之謀。及偽軍一遁，烽煙四起。君領羽林鐵騎，長驅淮滸，救其燌燒之委，收其器械之資。乃令邊儲載衍，軍士充仍者，君有力焉。永平初載，望府啟建，寮佐之選，妙盡時英。以君為伏波將軍、參太尉高陽王府事。於是翼亮台鉉，毗道鼎司。剋昭文薄之能，實允官人之職。及遭新昌君艱，幾盡者二三。孺慕之音，晝夜不絕，漿溢之禮，歷口莫飲。自爾尫頓，日就危惙。雖顏丁之居憂，遠有慙德；曾柴之銜恤，寧或能擬。春秋卌有六，以延昌四年九月九日，於洛陽縣之依仁里第瘠甚而卒。皇帝悼惜，朝野嗟痛。詔遣謁者持節册贈鎮遠將軍、華州刺史，所以旌崇孝德，禮也。粵以熙平二年九月二日，卜窆於本縣之舊塋焉。乃作銘曰：於鑠使君，清風獨絕。太尉之胤，儀同之裔。冠盖三秦，本枝百世。粵挺明德，聿遵前列。如玉之瑩，如冰之潔。永言孝友，率志貞厲。沖年受業，雅愛斯文。銳情無惰，潭思能懃。終朝章句，旦夕典墳。淵才博贍，高志脫群。九流畢鏡，八素咸分。振韍玉墀，濯纓朱廡。四門載穆，九儀率序。帝求鼎佐，唯德是與。我有儁哲，攬衣而處。三緝戎機，再遊台府。軍政允洽，槐風克舉。新昌殞世，瘠甚而卒。忪忪遺嗣，哀哀弟姪。書宮寂寥，琴庭蕭瑟。皇鑒乃春，追增顯秩。輝賁泉門，光昭松室。輒勒徽猷，恧慙無述。","subject_person_mention_id":"c-epitaph-yangshu-zju-full:p001:m0059","object_person_mention_id":"c-epitaph-yangshu-zju-full:p001:m0050"}],"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-epitaph-yangshu-zju-full:p001:m0050","start":50,"end":58,"surface":"洛州刺史恒農簡公","kind":"person","person_id":"fum_370_iq6_AAB","status":"contextual_provisional","interpretation_note":"依完整碑文同一敘事身份；非新增typed親屬。","paragraph_id":"c-epitaph-yangshu-zju-full:p001","chapter_id":"c-epitaph-yangshu-zju-full"}],"relations":[{"id":"a-yangshu-zju-nearkin-001","subject_person_id":"fum_370_iq6_AABA","predicate":"father","object_person_id":"fum_370_iq6_AAB","status":"source_attested","qualifiers":{"source_term":"第六子","source_clause_binding":{"kind":"epitaph_named_head_titled_ancestors","paragraph_id":"c-epitaph-yangshu-zju-full:p001","source_id":"s-epitaph-yangshu-zju-b-xabl-004","paragraph_sha256":"a6f61c0ba2bad09388efd4e6a7ee86acd5c0ae798c778685c81df6b8a7c21fc3","roles":{"surname":"c-epitaph-yangshu-zju-full:p001:m0018","head":"c-epitaph-yangshu-zju-full:p001:m0021","zi":"c-epitaph-yangshu-zju-full:p001:m0024","grandfather":"c-epitaph-yangshu-zju-full:p001:m0039","grandchild":"c-epitaph-yangshu-zju-full:p001:m0048","father":"c-epitaph-yangshu-zju-full:p001:m0050","son":"c-epitaph-yangshu-zju-full:p001:m0059"}},"birth_order":{"parent_person_id":"fum_370_iq6_AAB","scope":"sons_of_parent","ordinal":6,"position":"unspecified","interpretation_status":"source_attested"}},"evidence":[{"work_id":"w-epitaph-yangshu","book_id":"b-epitaph-yangshu-full","source_id":"s-epitaph-yangshu-zju-b-xabl-004","chapter_id":"c-epitaph-yangshu-zju-full","paragraph_id":"c-epitaph-yangshu-zju-full:p001","quote":"魏故鎮遠將軍華州刺史楊君墓誌銘。君姓楊，諱舒，字延景，恒農華陰潼鄉習仙里人也。河內清河二郡府君之孫，洛州刺史恒農簡公之第六子。漢太尉震，晉儀同瑤，即其世矣。君體河嶽之淑靈，膺積福之餘慶。淵度凝深，風流濬邈。閨門垂孝敬之譽，鄉黨流汎愛之仁。爰自弱冠，銳情典誥，終朝下幃，薄暮潭思。業尚三禮之學，廣采百家之論。才藝優贍，道術通洽。汪汪焉，詳詳焉。允所謂黃中之儁髦，德音之令准者已。太和中，以勳望之冑，而除散騎郎。暨世宗即祚，壽春送款，君為揚武長史受降納附。未幾，以援接之功，除大鴻臚丞。弼贊九儀，賓翼四門，蕃衛載緝，戎陌來庭。義陽之役，君參鎮南軍事，職掌壘和，任屬防禦。嚴栅櫓之剬，峻雲梯之嶮。憑陵之志莫展，窺〓之望斯絕。又監別將田益宗軍事，破偽鈞城而還。俘虜二千，收甲萬計。以功遷司空府中兵參軍。俄而偽臨川王簫宏，敢率蟻徒殲我粱城，以君歷試惟允，復參征南軍事。都督元王，特深器春，杖以幃幄之任，諮以决勝之謀。及偽軍一遁，烽煙四起。君領羽林鐵騎，長驅淮滸，救其燌燒之委，收其器械之資。乃令邊儲載衍，軍士充仍者，君有力焉。永平初載，望府啟建，寮佐之選，妙盡時英。以君為伏波將軍、參太尉高陽王府事。於是翼亮台鉉，毗道鼎司。剋昭文薄之能，實允官人之職。及遭新昌君艱，幾盡者二三。孺慕之音，晝夜不絕，漿溢之禮，歷口莫飲。自爾尫頓，日就危惙。雖顏丁之居憂，遠有慙德；曾柴之銜恤，寧或能擬。春秋卌有六，以延昌四年九月九日，於洛陽縣之依仁里第瘠甚而卒。皇帝悼惜，朝野嗟痛。詔遣謁者持節册贈鎮遠將軍、華州刺史，所以旌崇孝德，禮也。粵以熙平二年九月二日，卜窆於本縣之舊塋焉。乃作銘曰：於鑠使君，清風獨絕。太尉之胤，儀同之裔。冠盖三秦，本枝百世。粵挺明德，聿遵前列。如玉之瑩，如冰之潔。永言孝友，率志貞厲。沖年受業，雅愛斯文。銳情無惰，潭思能懃。終朝章句，旦夕典墳。淵才博贍，高志脫群。九流畢鏡，八素咸分。振韍玉墀，濯纓朱廡。四門載穆，九儀率序。帝求鼎佐，唯德是與。我有儁哲，攬衣而處。三緝戎機，再遊台府。軍政允洽，槐風克舉。新昌殞世，瘠甚而卒。忪忪遺嗣，哀哀弟姪。書宮寂寥，琴庭蕭瑟。皇鑒乃春，追增顯秩。輝賁泉門，光昭松室。輒勒徽猷，恧慙無述。","subject_person_mention_id":"c-epitaph-yangshu-zju-full:p001:m0059","object_person_mention_id":"c-epitaph-yangshu-zju-full:p001:m0050"}],"human_reviewed":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_ord