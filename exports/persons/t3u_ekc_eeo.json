788,1789,1790,1791,1792,1793,1794,1795,1796,1797,1798],"revision_id":1508012},"mentions":[{"id":"c-nanqishu-027-wangshi-concordance:p008:m0004","start":4,"end":7,"surface":"王道隆","kind":"person","person_id":"t3u_ekc_eeo","status":"contextual_provisional"},{"id":"c-nanqishu-027-wangshi-concordance:p008:m0011","start":11,"end":13,"surface":"懷珍","kind":"person","person_id":"w3a_mm0_hw1_*A","status":"contextual_provisional"}],"chapter_id":"c-nanqishu-027-wangshi-concordance","book_id":"b-nanqishu-027","work_id":"w-nanqishu","source_id":"s-nanqishu-027-wangshi-concordance-ws1508012"},{"id":"c-nanshi-023-wangyu-jingwen:p005","text":"景和元年，為尚書右僕射。明帝即位，加領左衛將軍，尋加丹陽尹。遭父憂，起為尚書左僕射、丹陽尹，固辭僕射。出為江州刺史，加都督，服闋乃受詔。封江安縣侯，固讓不許。後徵為尚書左僕射、領吏部、揚州刺史，加太子詹事。不願還朝，求為湘州，不許。時又謂景文在江州不能潔己，景文與上幸臣王道隆書，深自申理。","mentions":[{"id":"c-nanshi-023-wangyu-jingwen:p005:m0119","surface":"景文","start":119,"end":121,"person_id":"1tc_q18_x7v","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p005:m0129","surface":"景文","start":129,"end":131,"person_id":"1tc_q18_x7v","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangyu-jingwen:p005:m0135","surface":"王道隆","start":135,"end":138,"person_id":"t3u_ekc_eeo","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2478204,"source_layer":"received_biography","first_line":109,"last_line":109,"line_start":0,"line_end":145,"raw_start":7893,"raw_end":8038,"raw_character_offsets":[7893,7894,7895,7896,7897,7898,7899,7900,7901,7902,7903,7904,7905,7906,7907,7908,7909,7910,7911,7912,7913,7914,7915,7916,7917,7918,7919,7920,7921,7922,7923,7924,7925,7926,7927,7928,7929,7930,7931,7932,7933,7934,7935,7936,7937,7938,7939,7940,7941,7942,7943,7944,7945,7946,7947,7948,7949,7950,7951,7952,7953,7954,7955,7956,7957,7958,7959,7960,7961,7962,7963,7964,