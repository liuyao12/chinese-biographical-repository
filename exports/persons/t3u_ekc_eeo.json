maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-027-wangshi-concordance:event_context8-7","kind":"event_context","person_id":"t3u_ekc_eeo","source_quote":"宣旨","reading":"此人傳達旨意，實授冠軍將軍、豫章太守者為懷珍。","note":"此人傳達旨意，實授冠軍將軍、豫章太守者為懷珍。","paragraph_id":"c-nanqishu-027-wangshi-concordance:p008","start_codepoint":7,"end_codepoint":9,"human_reviewed":false,"chapter_id":"c-nanqishu-027-wangshi-concordance","source_id":"s-nanqishu-027-wangshi-concordance-ws1508012"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-nan023-wangyun-daolong","person_id":"t3u_ekc_eeo","event_type":"death","source_term":"為亂兵所殺","source_anchor":{"paragraph_id":"c-nanshi-023-wangyun-yanshen:p002","surface":"為亂兵所殺","start":8,"end":13},"date_expression":null,"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangyun-yanshen-ws2478204","chapter_id":"c-nanshi-023-wangyun-yanshen","paragraph_id":"c-nanshi-023-wangyun-yanshen:p002","quote":"桂陽之逼，王道隆為亂兵所殺，蘊力戰，重創禦溝側，或扶以免。事平，撫軍長史褚澄為吳郡太守，司徒左長史蕭惠明言於朝曰：「褚澄開城以納賊，更為股肱大郡，王蘊被甲死戰，棄而不收，賞罰如此，何憂不亂！」褚彥回慚，乃議用蘊為湘州刺史。及齊高帝輔政，蘊與沈攸之連謀，事敗，斬於秣陵市。","person_mention_id":"c-nanshi-023-wangyun-yanshen:p002:m0005"}],"status":"source_attested","interpretation_note":"桂陽王逼京時，同段蘊重創得免。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"mentions":[{"id":"c-nanqishu-027-wangshi-concordance:p008:m0004","start":4,"end":7,"surface":"王道隆","kind":"person","person_id":"t3u_ekc_eeo","status":"contextual_provisional","paragraph_id":"c-nanqishu-027-wangshi-concordance:p008","chapter_id":"c-nanqishu-027-wangshi-concordance"},{"id":"c-nanshi-023-wangyu-jingwen:p005:m0135","surface":"王道隆","start":135,"end":138,"person_id":"t3u_ekc_eeo","kind":"person","status":"cont