me_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-059-prince-yue:p002:m0189","surface":"曹馥","start":189,"end":191,"person_id":"qhk_thu_1ml","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-059-prince-yue:p002","chapter_id":"c-jinshu-059-prince-yue"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-059-prince-yue:p002","text":"成都王穎攻長沙王乂，乂固守洛陽，殿中諸將及三部司馬疲于戰守，密與左衛將軍硃默夜收乂別省，逼越為主，啟惠帝免乂官。事定，越稱疾遜位。帝不許，加守尚書令。太安初，帝北征鄴，以越為大都督。六軍敗，越奔下邳，徐州都督、東平王楙不納，越徑還東海。成都王穎以越兄弟宗室之美，下寬令招之，越不應命。帝西幸，以越為太傅，與太宰顒夾輔朝政，讓不受。東海中尉劉洽勸越發兵以備穎，越以洽為左司馬，尚書曹馥為軍司。既起兵，楙懼，乃以州與越。越以司空領徐州都督，以楙領兗州刺史。越三弟並據方任征伐，輒選刺史守相，朝士多赴越。而河間王顒挾天子，發詔罷越等，皆令就國。越唱義奉迎大駕，還復舊都，率甲卒三萬，西次蕭縣。豫州刺史劉喬不受越命，遣子祐距之，越軍敗。范陽王虓遣督護田徽以突騎八百迎越，遇祐於譙，祐眾潰，越進屯陽武。山東兵盛，關中大懼，顒斬送張方首求和，尋變計距越。越率諸侯及鮮卑許扶曆、駒次宿歸等步騎迎惠帝反洛陽。詔越乙太傅錄尚書，以下邳、濟陽二郡增封。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":185,"last_line":185,"raw_start":19054,"raw_end":19573,"raw_character_offsets":[19056,19057,19058,19059,19060,19061,19062,19063,19064,19065,19066,19067,19068,19069,19070,19071,19072,19073,19074,19075,19076,19077,19078,19079,19080,19081,19082,19083,19084,19085,19086,19087,19088,19089,19090,19091,19092,19093,19094,19095,19096,19097,19098,19099,19100,19101,19102,19103,19104,19105,19106,19107,19108,19109,19110,19111,19112,19113,19114,19115,19116,19117,19118,19119,19120,19121,19122,19123,19124,19125,19126,19127,19128,19129,19130,19131,19132,19133,19165,19166,19167,19168,19169,19170,19171,19172,19173,19174,19175,19176,19177,19178,19179,19180,19181,19182,19183,19184,19185,19186,19187,19188,19189,19190,19191,19192,19193,19194,19195,19196,19197,19198,19199,19200,19201,19202,19203,19204,19205,19206,19207,19208,19209,19210,19211,19212,19213,19214,19215,19216,19217,19218,19219,19220,19221,19222,19223,19224,1