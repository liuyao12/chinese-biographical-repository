status":"contextual_provisional"},{"id":"c-shiji-039-jin:m082-0217","start":217,"end":219,"surface":"襄公","kind":"person","person_id":"cbr-p000396","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m082-0224","start":224,"end":226,"surface":"賈季","kind":"person","person_id":"cbr-p001769","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m082-0232","start":232,"end":235,"surface":"秦繆公","kind":"person","person_id":"cbr-p000253","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p083","text":"靈公元年四月，秦康公曰：「昔文公之入也無衞，故有呂、郤之患。」乃多與公子雍衞。太子母繆嬴日夜抱太子以號泣於朝，曰：「先君何罪？其嗣亦何罪？舍適而外求君，將安置此？」出朝，則抱以適趙盾所，頓首曰：「先君奉此子而屬之子，曰『此子材，吾受其賜；不材，吾怨子』。今君卒，言猶在耳，而棄之，若何？」趙盾與諸大夫皆患繆嬴，且畏誅，乃背所迎而立太子夷皋，是爲靈公。發兵以距秦送公子雍者。趙盾爲將，往撃秦，敗之令狐。先蔑、隨會亡奔秦。秋，齊、宋、衞、鄭、曹、許君皆會趙盾，盟於扈，以靈公初立故也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m083-0000","start":0,"end":2,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0007","start":7,"end":10,"surface":"秦康公","kind":"person","person_id":"cbr-p000405","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0014","start":14,"end":16,"surface":"文公","kind":"person","person_id":"cbr-p000252","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0034","start":34,"end":37,"surface":"公子雍","kind":"person","person_id":"cbr-p000406","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0039","start":39,"end":44,"surface":"太子母繆嬴","kind":"person","person_id":"cbr-p001773","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0089","start":89,"end":91,"surface":"趙盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0144","start":144,"end":146,"surface":"趙盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0152","start":152,"end":154,"surface":"繆嬴","kind":"person","person_id":"cbr-p001773","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0165","start":165,"end":169,"surface":"太子夷皋","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0172","start":172,"end":174,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0181","start":181,"end":184,"surface":"公子雍","kind":"person","person_id":"cbr-p000406","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0186","start":186,"end":188,"surface":"趙盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0200","start":200,"end":202,"surface":"先蔑","kind":"person","person_id":"cbr-p001766","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0203","start":203,"end":205,"surface":"隨會","kind":"person","person_id":"cbr-p000408","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0211","start":211,"end":223,"surface":"齊、宋、衞、鄭、曹、許君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m083-0224","start":224,"end":225,"surface":"會","kind":"person","person_id":"cbr-p000408","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0225","start":225,"end":227,"surface":"趙盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m083-0233","start":233,"end":235,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p086","text":"十四年，靈公壯，侈，厚斂以彫牆。從臺上彈人，觀其避丸也。宰夫胹熊蹯不熟，靈公怒，殺宰夫，使婦人持其尸出棄之，過朝。趙盾、隨會前數諫，不聽；已又見死人手，二人前諫。隨會先諫，不聽。靈公患之，使鉏麑刺趙盾。盾閨門開，居處節，鉏麑退，嘆曰：「殺忠臣，棄君命，罪一也。」遂觸樹而死。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m086-0004","start":4,"end":6,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0028","start":28,"end":30,"surface":"宰夫","kind":"person","person_id":"cbr-p001776","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0036","start":36,"end":38,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0041","start":41,"end":43,"surface":"宰夫","kind":"person","person_id":"cbr-p001776","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0045","start":45,"end":47,"surface":"婦人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m086-0057","start":57,"end":59,"surface":"趙盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0060","start":60,"end":62,"surface":"隨會","kind":"person","person_id":"cbr-p000408","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0081","start":81,"end":83,"surface":"隨會","kind":"person","person_id":"cbr-p000408","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0089","start":89,"end":91,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0095","start":95,"end":97,"surface":"鉏麑","kind":"person","person_id":"cbr-p001777","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0098","start":98,"end":100,"surface":"趙盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0101","start":101,"end":102,"surface":"盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m086-0110","start":110,"end":112,"surface":"鉏麑","kind":"person","person_id":"cbr-p001777","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"},{"id":"c-shiji-039-jin:p087","text":"初，盾常田首山，見桑下有餓人。餓人，示瞇明也。盾與之食，食其半。問其故，曰：「宦三年，未知母之存不，願遺母。」盾義之，益與之飯肉。已而爲晉宰夫，趙盾弗復知也。九月，晉靈公飲趙盾酒，伏甲將攻盾。公宰示瞇明知之，恐盾醉不能起，而進曰：「君賜臣，觴三行可以罷。」欲以去趙盾，令先，毋及難。盾旣去，靈公伏士未會，先縱齧狗名敖。明爲盾搏殺狗。盾曰：「棄人用狗，雖猛何爲。」然不知明之爲陰德也。已而靈公縱伏士出逐趙盾，示瞇明反撃靈公之伏士，伏士不能進，而竟脱盾。盾問其故，曰：「我桑下餓人。」問其名，弗告。明亦因亡去。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-039-jin:m087-0002","start":2,"end":3,"surface":"盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0012","start":12,"end":14,"surface":"餓人","kind":"person","person_id":"cbr-p001778","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0015","start":15,"end":17,"surface":"餓人","kind":"person","person_id":"cbr-p001778","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0018","start":18,"end":21,"surface":"示瞇明","kind":"person","person_id":"cbr-p001778","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0023","start":23,"end":24,"surface":"盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0045","start":45,"end":49,"surface":"母之存不","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、職官泛稱、校勘、神異或未定指代；不補未見名、成員、爵等或闕代。"},{"id":"c-shiji-039-jin:m087-0055","start":55,"end":56,"surface":"盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0072","start":72,"end":74,"surface":"趙盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0083","start":83,"end":85,"surface":"靈公","kind":"person","person_id":"cbr-p000412","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0086","start":86,"end":88,"surface":"趙盾","kind":"person","person_id":"cbr-p000407","status":"contextual_provisional"},{"id":"c-shiji-039-jin:m087-0094","start":94,"end":95,"surface":"盾","kin