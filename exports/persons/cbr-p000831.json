兵。灌嬰兵亦罷滎陽而歸。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m029-0000","start":0,"end":3,"surface":"朱虛侯","kind":"person","person_id":"cbr-p000832","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0005","start":5,"end":6,"surface":"產","kind":"person","person_id":"cbr-p000823","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0007","start":7,"end":8,"surface":"帝","kind":"person","person_id":"cbr-p000840","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0009","start":9,"end":11,"surface":"謁者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m029-0014","start":14,"end":17,"surface":"朱虛侯","kind":"person","person_id":"cbr-p000832","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0018","start":18,"end":21,"surface":"朱虛侯","kind":"person","person_id":"cbr-p000832","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0026","start":26,"end":28,"surface":"謁者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m029-0031","start":31,"end":34,"surface":"朱虛侯","kind":"person","person_id":"cbr-p000832","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0050","start":50,"end":53,"surface":"呂更始","kind":"person","person_id":"cbr-p000847","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0062","start":62,"end":64,"surface":"太尉","kind":"person","person_id":"cbr-p000805","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0065","start":65,"end":67,"surface":"太尉","kind":"person","person_id":"cbr-p000805","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0071","start":71,"end":74,"surface":"朱虛侯","kind":"person","person_id":"cbr-p000832","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m029-0080","start":80,"end":82,"surface":"呂產","kind":"pe