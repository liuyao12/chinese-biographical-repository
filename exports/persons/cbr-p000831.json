"cbr-p000831","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p024","chapter_id":"c-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:m029-0136","start":136,"end":139,"surface":"魯王偃","kind":"person","person_id":"cbr-p000831","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p029","chapter_id":"c-shiji-009-lvhou"}],"relations":[{"id":"a-shiji009-010","subject_person_id":"cbr-p000831","predicate":"father","object_person_id":"cbr-p000787","status":"source_attested","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p008","quote":"子偃為魯王。魯王父，宣平侯張敖也","chapter_id":"c-shiji-009-lvhou","source_id":"s-shiji-009-lvhou"}],"qualifiers":{"source_term":"父","historicity":"historical_tradition"},"interpretation_note":"僅保存原文明示主張，不補闕代、同父同母或未見姓名；不推導少帝生物父親。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji009-040","person_id":"cbr-p000831","surfaces":["偃","子偃","魯元王","魯元王偃","魯王偃"],"scope":"same_chapter","chapter_ids":["c-shiji-009-lvhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-009-lvhou:p015","quote":"宣平侯張敖卒，以子偃為魯王，敖賜謚為魯元王。"},{"paragraph_id":"c-shiji-009-lvhou:p019","quote":"高后為外孫魯元王偃年少，蚤失父母，孤弱，乃封張敖前姬兩子，侈為新都侯，壽為樂昌侯，以輔魯元王偃。及封中大謁者張釋為建陵侯，呂榮為祝茲侯。諸中宦者令丞皆為關內侯，食邑五百戶。"},{"paragraph_id":"c-shiji-009-lvhou:p024","quote":"呂祿、呂產欲發亂關中，內憚絳侯、朱虛等，外畏齊、楚兵，又恐灌嬰畔之，欲待灌嬰兵與齊合而發，猶豫未決。當是時，濟川王太、淮陽王武、常山王朝名為少帝弟，及魯元王呂后外孫，皆年少未之國，居長安。趙王祿、梁王產各將兵居南北軍，皆呂氏之人。列侯群臣莫自堅其命。"},{"paragraph_id":"c-shiji-009-lvhou:p029","quote":"朱虛侯已殺產，帝命謁者持節勞朱虛侯。朱虛侯欲奪節信，謁者不肯，朱虛侯則從與載，因節信馳走，斬長樂衛尉呂更始。還，馳入北軍，報太尉。太尉起，拜賀朱虛侯曰：「所患獨呂產，今已誅，天下定矣。」遂遣人分部悉捕諸呂男女，無少長皆斬之。辛酉，捕斬呂祿，而笞殺呂媭。使人誅燕王呂通，而廢魯王偃。壬戌，以帝太傅食其復為左丞相。戊辰，徙濟川王王梁，立趙幽王子遂為趙王。遣朱虛侯章以誅諸呂氏事告齊王，令罷兵。灌嬰兵亦罷滎陽而歸。"}],"rationale":"所列漢初諸王分封、平呂及接任敘事中暫定同指；同名不作全庫匹配，匿名者不補未見姓名，仍待異源覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-009-lvhou:p008","text":"四月，太后欲侯諸呂，乃先封高祖之功臣郎中令無擇為博城侯。魯元公主薨，賜謚為魯元太后。子偃為魯王。魯王父，宣平侯張敖也。封齊悼惠王子章為朱虛侯，以呂祿女妻之。齊丞相壽為平定侯。少府延為梧侯。乃封呂種為沛侯，呂平為扶柳侯，張買為南宮侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m008-0003","start":3,"end":5,"surface":"太后","kind":"person","person_id":"cbr-p000717","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0013","start":13,"end":15,"surface":"高祖","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0018","start":18,"end":23,"surface":"郎中令無擇","kind":"person","person_id":"cbr-p000830","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0028","start":28,"end":32,"surface":"魯元公主","kind":"person","person_id":"cbr-p000714","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0037","start":37,"end":41,"surface":"魯元太后","kind":"person","person_id":"cbr-p000714","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0043","start":43,"end":44,"surface":"偃","kind":"person","person_id":"cbr-p000831","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0055","start":55,"end":57,"surface":"張敖","kind":"person","person_id":"cbr-p000787","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0060","start":60,"end":64,"surface":"齊悼惠王","kind":"person","person_id":"cbr-p000795","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0064","start":64,"end":66,"surface":"子章","kind":"person","person_id":"cbr-p000832","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0072","start":72,"end":74,"surface":"呂祿","kind":"person","person_id":"cbr-p000829","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0078","start":78,"end":82,"surface":"齊丞相壽","kind":"person","person_id":"cbr-p000833","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0087","start":87,"end":90,"surface":"少府延","kind":"person","person_id":"cbr-p000834","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m008-0096","start":96,"end":98,"surface":"呂種","kind":"person","perso