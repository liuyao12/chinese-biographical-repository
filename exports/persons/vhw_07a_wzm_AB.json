，廬于墓側。服闋，與徴士戴顒、王弘之及王敬弘等共爲人外之游。敬弘以女適淳之子尚。會稽太守謝方明苦要入郡，終不肯往。茅室蓬戸，庭草蕪逕，唯牀上有數巻書。元嘉初，復徴爲散騎侍郎，乃逃于上虞縣界，家人莫知所之。弟默之爲廣州刺史，出都與別。司徒王弘要淳之集冶城，即日命駕東歸，遂不顧也。元嘉七年，卒，時年五十九。默之儒學，注穀梁春秋。","subject_person_mention_id":"c-songshu-093-recluses:line082:m0107","object_person_mention_id":"c-songshu-093-recluses:line082:m0039"}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"a-songshu093-xixian-father","subject_person_id":"vhw_07a_wzm_ABA","predicate":"father","object_person_id":"vhw_07a_wzm_AB","status":"source_attested","qualifiers":{"source_term":"默之子熙先","lineage":"paternal"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-093","chapter_id":"c-songshu-093-recluses","source_id":"s-songshu-093-recluses","paragraph_id":"c-songshu-093-recluses:line084","quote":"默之子熙先，事在范曄傳。","subject_person_mention_id":"c-songshu-093-recluses:line084:m0003","object_person_mention_id":"c-songshu-093-recluses:line084:m0000"}],"reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-093-recluses:line082:m0107","start":107,"end":109,"surface":"默之","kind":"person","person_id":"vhw_07a_wzm_AB","status":"contextual_provisional","paragraph_id":"c-songshu-093-recluses:line082","chapter_id":"c-songshu-093-recluses"},{"id":"c-songshu-093-recluses:line082:m0156","start":156,"end":158,"surface":"默之","kind":"person","person_id":"vhw_07a_wzm_AB","status":"contextual_provisional","paragraph_id":"c-songshu-093-recluses:line082","chapter_id":"c-songshu-093-recluses"},{"id":"c-songshu-093-recluses:line084:m0000","start":0,"end":2,"surface":"默之","kind":"person","person_id":"vhw_07a_wzm_AB","status":"contextual_provisional","paragraph_id":"c-songshu-093-recluses:line084","chapter_id":"c-songshu-093-recluses"}],"relations":[{"id":"a-songshu093-mozhi-brother","subject_person_id":"vhw_07a_wzm_AB","