7:m0000","object_person_mention_id":"c-sanguozhi-063-zhaoda:line037:m0013"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-063-zhaoda:line037:m0013","start":13,"end":15,"surface":"單甫","kind":"person","person_id":"q0q_cip_p4x","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-063-zhaoda:line037","chapter_id":"c-sanguozhi-063-zhaoda"}],"relations":[{"id":"a-wu063-zhaoda-0","subject_person_id":"9vq_kh2_cfv","object_person_id":"q0q_cip_p4x","predicate":"teacher","qualifiers":{"source_term":"少從漢侍中單甫受學","relationship_basis":"teaching"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-063","chapter_id":"c-sanguozhi-063-zhaoda","source_id":"s-sanguozhi-063-zhaoda","paragraph_id":"c-sanguozhi-063-zhaoda:line037","quote":"趙達，河南人也。少從漢侍中單甫受學，用思精密。謂東南有王者氣，可以避難，故脫身渡江。治九宮一算之術，究其微旨，是以能應機立成。對問若神，至計飛蝗，射隱伏，無不中效。或難達曰：「飛者固不可校，誰知其然，此殆妄耳。」達使其人取小豆數斗，播之席上，立處其數，驗覆果信。嘗過知故，知故爲之具食。食畢，謂曰：「倉卒乏酒，又無嘉肴，無以敘意，如何？」達因取盤中隻箸，再三從橫之，乃言：「卿東壁下有美酒一斛，又有鹿肉三斤，何以辭無？」時坐有他賓，內得主人情。主人慚曰：「以卿善射有無，欲相試耳，竟效如此。」遂出酒酣飲。又有書簡上作千萬數，著空倉中封之，令達算之。達處如數，云：「但有名無實。」其精微若是。","subject_person_mention_id":"c-sanguozhi-063-zhaoda:line037:m0000","object_person_mention_id":"c-sanguozhi-063-zhaoda:line037:m0013"}],"interpretation_note":"以此來源所述兩端為據。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"title_holdings":[{"id":"t-wu063-t-wu063-zhaoda0","person_id":"q0q_cip_p4x","kind":"office","title":"侍中","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-s