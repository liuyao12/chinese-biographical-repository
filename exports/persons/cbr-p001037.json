{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p001037","identity_policy":"contextual_provisional","person_ids":["cbr-p001037"],"persons":[{"id":"cbr-p001037","label":"曹宣公","status":"active","historicity":"historical_tradition","aliases":[{"surface":"曹宣公","mention_ids":["c-shiji-031-wu:m007-0023"]}],"evidence":[{"mention_id":"c-shiji-031-wu:m007-0023","chapter_id":"c-shiji-031-wu","paragraph_id":"c-shiji-031-wu:p007","quote":"曹宣公"}]}],"mentions":[{"id":"c-shiji-031-wu:m007-0023","start":23,"end":26,"surface":"曹宣公","kind":"person","person_id":"cbr-p001037","status":"contextual_provisional","paragraph_id":"c-shiji-031-wu:p007","chapter_id":"c-shiji-031-wu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-031-wu:p007","text":"王諸樊元年，諸樊已除喪，讓位季札。季札謝曰：「曹宣公之卒也，諸侯與曹人不義曹君，將立子臧，子臧去之，以成曹君，君子曰『能守節矣』。君義嗣，誰敢干君！有國，非吾節也。劄雖不材，原附於子臧之義。」吳人固立季札，季札棄其室而耕，乃舍之。秋，吳伐楚，楚敗我師。四年，晉平公初立。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-031-wu:m007-0000","start":0,"end":3,"surface":"王諸樊","kind":"person","person_id":"cbr-p001033","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m007-0006","start":6,"end":8,"surface":"諸樊","kind":"person","person_id":"cbr-p001033","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m007-0014","start":14,"end":16,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m007-0017","start":17,"end":19,"surface":"季札","kind":"person","person_id":"cbr-p001036","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m007-0023","start":23,"end":26,"surface":"曹宣公","kind":"person","person_id":"cbr-p001037","status":"contextual_provisional"},{"id":"c-shiji-031-wu:m007-0037","start":37,"end":39,"surface":"曹君","kind":"unresolved","person_id":null,"status":"unresolved","no