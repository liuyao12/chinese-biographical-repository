0,"surface":"少君","kind":"person","person_id":"xoj_go3_gl0","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:p016","text":"竇皇后病，失明。文帝幸邯鄲慎夫人、尹姬，皆毋子。孝文帝崩，孝景帝立，乃封廣國為章武侯。長君前死，封其子彭祖為南皮侯。吳楚反時，竇太后從昆弟子竇嬰，任俠自喜，將兵，以軍功為魏其侯。竇氏凡三人為侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-049-waiqi:m016-0000","start":0,"end":3,"surface":"竇皇后","kind":"person","person_id":"ixk_6fg_v6f_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0008","start":8,"end":10,"surface":"文帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0013","start":13,"end":16,"surface":"慎夫人","kind":"person","person_id":"evh_7zu_u3x","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0017","start":17,"end":19,"surface":"尹姬","kind":"person","person_id":"oj5_zy0_x0t","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0024","start":24,"end":27,"surface":"孝文帝","kind":"person","person_id":"yqp_nlb_p1p_AC","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0029","start":29,"end":32,"surface":"孝景帝","kind":"person","person_id":"yqp_nlb_p1p_ACA","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0036","start":36,"end":38,"surface":"廣國","kind":"person","person_id":"xoj_go3_gl0","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0043","start":43,"end":45,"surface":"長君","kind":"person","person_id":"ra9_o4d_rli","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0051","start":51,"end":53,"surface":"彭祖","kind":"person","person_id":"ra9_o4d_rli_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0063","start":63,"end":66,"surface":"竇太后","kind":"person","person_id":"ixk_6fg_v6f_A","status":"contextual_provisional"},{"id":"c-shiji-049-waiqi:m016-0066","start":66,"end":70,"surface":"從昆弟子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或待核稱謂；不由熟悉生平補姓名。"},{"id":"c-shiji-049-waiqi:m016-0070","start":70,"end":72,"surface":"竇嬰","kind":"person","person_id":"45y_6ae_x2a","status":"contextual_provisional"}],"chapter_id":"c-shiji-049-waiqi","book_id":"b-shiji-049","work_id":"w-shiji","source_id":"s-shiji-049-waiqi"},{"id":"c-shiji-100-jibu:p004","text":"楚人曹丘生，辯士，數招權顧金錢。事貴人趙同等，與竇長君善。季布聞之，寄書諫竇長君曰：「吾聞曹丘生非長者，勿與通。」及曹丘生歸，欲得書請季布。竇長君曰：「季將軍不説足下，足下無往。」固請書，遂行。使人先發書，季布果大怒，待曹丘。曹丘至，即揖季布曰：「楚人諺曰『得黃金百（斤），不如得季布一諾』，足下何以得此聲於梁楚閒哉？且仆楚人，足下亦楚人也。仆游揚足下之名於天下，顧不重邪？何足下距仆之深也！」季布乃大説，引入，留數月，爲上客，厚送之。季布名所以益聞者，曹丘揚之也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-100-jibu:m004-0002","start":2,"end":5,"surface":"曹丘生","kind":"person","person_id":"tnc_ag2_eej","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m004-0019","start":19,"end":21,"surface":"趙同","kind":"person","person_id":"qyn_07y_0gt","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m004-0024","start":24,"end":27,"surface":"竇長君","kind":"person","person_id":"ra9_o4d_rli","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m004-0029","start":29,"end":31,"surface":"季布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m004-0037","start":37,"end":40,"surface":"竇長君","kind":"person","person_id":"ra9_o4d_rli","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m004-0045","start":45,"end":48,"surface":"曹丘生","kind":"person","person_id":"tnc_ag2_eej","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m004-0058","start":58,"end":61,"surface":"曹丘生","kind":"person","person_id":"tnc_ag2_eej","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m004-0067","start":67,"end":69,"surface":"季布","kind":"person","person_id":"udu_dyy_4wd","status":"contextual_provisional"},{"id":"c-shiji-100-jibu:m004-0070","start":70,"end":73,"surface":"竇長君","kind":"person","person_id":