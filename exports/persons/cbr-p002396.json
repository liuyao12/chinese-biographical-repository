d":51,"surface":"王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m074-0054","start":54,"end":57,"surface":"惠文王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m074-0058","start":58,"end":61,"surface":"惠文王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m074-0062","start":62,"end":66,"surface":"惠后吳娃","kind":"person","person_id":"cbr-p002396","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m074-0069","start":69,"end":72,"surface":"武靈王","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m074-0075","start":75,"end":77,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-043-zhao:p082","text":"是時王少，成、兌專政，畏誅，故圍主父。主父初以長子章爲太子，後得吳娃，愛之，爲不出者數歳，生子何，乃廢太子章而立何爲王。吳娃死，愛弛，憐故太子，欲兩王之，猶豫未決，故亂起，以至父子倶死，爲天下笑，豈不痛乎！","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-043-zhao:m082-0002","start":2,"end":3,"surface":"王","kind":"person","person_id":"cbr-p002424","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0005","start":5,"end":6,"surface":"成","kind":"person","person_id":"cbr-p002404","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0007","start":7,"end":8,"surface":"兌","kind":"person","person_id":"cbr-p002428","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0016","start":16,"end":18,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0019","start":19,"end":21,"surface":"主父","kind":"person","person_id":"cbr-p002380","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m082-0023","start":23,"end":26,"surface":"長子章","kind":"person","perso