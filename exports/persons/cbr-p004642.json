isional"},{"id":"c-shiji-082-tiandan:m008-0013","start":13,"end":15,"surface":"湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0016","start":16,"end":18,"surface":"法章","kind":"person","person_id":"cbr-p004651","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0021","start":21,"end":24,"surface":"太史嬓","kind":"person","person_id":"cbr-p004653","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0032","start":32,"end":34,"surface":"嬓女","kind":"person","person_id":"cbr-p004640","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0041","start":41,"end":43,"surface":"法章","kind":"person","person_id":"cbr-p004651","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0047","start":47,"end":48,"surface":"女","kind":"person","person_id":"cbr-p004640","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0049","start":49,"end":50,"surface":"女","kind":"person","person_id":"cbr-p004640","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0059","start":59,"end":61,"surface":"法章","kind":"person","person_id":"cbr-p004651","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0062","start":62,"end":64,"surface":"齊王","kind":"person","person_id":"cbr-p004651","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0071","start":71,"end":75,"surface":"太史氏女","kind":"person","person_id":"cbr-p004640","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m008-0082","start":82,"end":85,"surface":"君王后","kind":"person","person_id":"cbr-p004640","status":"contextual_provisional"}],"chapter_id":"c-shiji-082-tiandan","book_id":"b-shiji-082","work_id":"w-shiji","source_id":"s-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:p009","text":"燕之初入齊，聞畫邑人王蠋賢，令軍中曰「環畫邑三十里無入」，以王蠋之故。已而使人謂蠋曰：「齊人多高子之義，吾以子為將，封子萬家。」蠋固謝。燕人曰：「子不聽，吾引三軍而屠畫邑。」王蠋曰：「忠臣不事二君，貞女不更二夫。齊王不聽吾諫，故退而耕於野。國既破亡，吾不能存；今又劫之以兵為君將，是助桀為暴也。與其生而無義，固不如烹！」遂經其頸於樹枝，自奮絕脰而死。齊亡大夫聞之，曰：「王蠋，布衣也，義不北面於燕，況在位食祿者乎！」乃相聚如莒，求諸子，立為襄王。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-082-tiandan:m009-0010","start":10,"end":12,"surface":"王蠋","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0030","start":30,"end":32,"surface":"王蠋","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0040","start":40,"end":41,"surface":"蠋","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0048","start":48,"end":49,"surface":"子","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0054","start":54,"end":55,"surface":"子","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0059","start":59,"end":60,"surface":"子","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0064","start":64,"end":65,"surface":"蠋","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0068","start":68,"end":70,"surface":"燕人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存；神為策略敘事，不補具名神祇或宗族親屬。"},{"id":"c-shiji-082-tiandan:m009-0073","start":73,"end":74,"surface":"子","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0087","start":87,"end":89,"surface":"王蠋","kind":"person","person_id":"cbr-p004654","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m009-0092","start":92,"end":94,"surface":"忠臣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存；神為策略敘事，不補具名神祇或宗族親屬。"},{"id":"c-shiji-082-tiandan:m009-0096","start":96,"end":98,"surface":"二君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存；神為策略敘事，不補具名神祇或宗族親屬