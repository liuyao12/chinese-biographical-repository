2-tiandan:m001-0011","start":11,"end":13,"surface":"湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p001","chapter_id":"c-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:m001-0035","start":35,"end":38,"surface":"齊湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p001","chapter_id":"c-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:m001-0141","start":141,"end":143,"surface":"齊王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p001","chapter_id":"c-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:m001-0155","start":155,"end":157,"surface":"湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p001","chapter_id":"c-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:m002-0035","start":35,"end":37,"surface":"齊王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p002","chapter_id":"c-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:m008-0006","start":6,"end":8,"surface":"湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p008","chapter_id":"c-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:m008-0013","start":13,"end":15,"surface":"湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p008","chapter_id":"c-shiji-082-tiandan"},{"id":"c-shiji-082-tiandan:m009-0106","start":106,"end":108,"surface":"齊王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional","paragraph_id":"c-shiji-082-tiandan:p009","chapter_id":"c-shiji-082-tiandan"}],"relations":[{"id":"a-shiji082-001","subject_person_id":"cbr-p004651","predicate":"father","object_person_id":"cbr-p004642","status":"source_attested","evidence":[{"chapter_id":"c-shiji-082-tiandan","source_id":"s-shiji-082-tiandan","paragraph_id":"c-shiji-082-tiandan:p008","quote":"初，淖齒之殺湣王也，莒人求湣王子法章，得之太史嬓之家，為人灌園。嬓女憐而善遇之。後法章私以情告女，女遂與通。及莒人共立法章為齊王，以莒距燕，而太史氏女遂為后，所謂「君王后」也。"}],"qualifiers":{"source_term":"湣王子法章","historicity":"historical_tradition"},"interpretation_note":"只保存明示王子、女及立后事件的父親與配偶主張，宗族疏屬不補父母，妻妾群體不補姓名。","reviewer":"Codex（AI 代理）"}],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji082-003","person_id":"cbr-p004642","surfaces":["湣王","齊湣王","齊王"],"scope":"same_chapter","chapter_ids":["c-shiji-082-tiandan"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-082-tiandan:p001","quote":"田單者，齊諸田疏屬也。湣王時，單為臨菑市掾，不見知。及燕使樂毅伐破齊，齊湣王出奔，已而保莒城。燕師長驅平齊，而田單走安平，令其宗人盡斷其車軸末而傅鐵籠。已而燕軍攻安平，城壞，齊人走，爭涂，以轊折車敗，為燕所虜，唯田單宗人以鐵籠故得脫，東保即墨。燕既盡降齊城，唯獨莒、即墨不下。燕軍聞齊王在莒，并兵攻之。淖齒既殺湣王於莒，因堅守，距燕軍，數年不下。燕引兵東圍即墨，即墨大夫出與戰，敗死。城中相與推田單，曰：「安平之戰，田單宗人以鐵籠得全，習兵。」立以為將軍，以即墨距燕。"},{"paragraph_id":"c-shiji-082-tiandan:p002","quote":"頃之，燕昭王卒，惠王立，與樂毅有隙。田單聞之，乃縱反閒於燕，宣言曰：「齊王已死，城之不拔者二耳。樂毅畏誅而不敢歸，以伐齊為名，實欲連兵南面而王齊。齊人未附，故且緩攻即墨以待其事。齊人所懼，唯恐他將之來，即墨殘矣。」燕王以為然，使騎劫代樂毅。"},{"paragraph_id":"c-shiji-082-tiandan:p008","quote":"初，淖齒之殺湣王也，莒人求湣王子法章，得之太史嬓之家，為人灌園。嬓女憐而善遇之。後法章私以情告女，女遂與通。及莒人共立法章為齊王，以莒距燕，而太史氏女遂為后，所謂「君王后」也。"},{"paragraph_id":"c-shiji-082-tiandan:p009","quote":"燕之初入齊，聞畫邑人王蠋賢，令軍中曰「環畫邑三十里無入」，以王蠋之故。已而使人謂蠋曰：「齊人多高子之義，吾以子為將，封子萬家。」蠋固謝。燕人曰：「子不聽，吾引三軍而屠畫邑。」王蠋曰：「忠臣不事二君，貞女不更二夫。齊王不聽吾諫，故退而耕於野。國既破亡，吾不能存；今又劫之以兵為君將，是助桀為暴也。與其生而無義，固不如烹！」遂經其頸於樹枝，自奮絕脰而死。齊亡大夫聞之，曰：「王蠋，布衣也，義不北面於燕，況在位食祿者乎！」乃相聚如莒，求諸子，立為襄王。"}],"rationale":"依9段明示姓名、君序與復齊事件暫接；法章立齊王與襄王迎莒、末段立襄王依同一復國敘事接。嬓女太史氏女君王后按明示，嬓與女先處完整稱謂。假神師是未名卒、臣其自稱，君指田單；燕將未名不盲接騎劫，宗族不補父母。誘王蠋授將被固謝，不當實授。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-082-tiandan:p001","text":"田單者，齊諸田疏屬也。湣王時，單為臨菑市掾，不見知。及燕使樂毅伐破齊，齊湣王出奔，已而保莒城。燕師長驅平齊，而田單走安平，令其宗人盡斷其車軸末而傅鐵籠。已而燕軍攻安平，城壞，齊人走，爭涂，以轊折車敗，為燕所虜，唯田單宗人以鐵籠故得脫，東保即墨。燕既盡降齊城，唯獨莒、即墨不下。燕軍聞齊王在莒，并兵攻之。淖齒既殺湣王於莒，因堅守，距燕軍，數年不下。燕引兵東圍即墨，即墨大夫出與戰，敗死。城中相與推田單，曰：「安平之戰，田單宗人以鐵籠得全，習兵。」立以為將軍，以即墨距燕。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-082-tiandan:m001-0000","start":0,"end":2,"surface":"田單","kind":"person","person_id":"cbr-p004641","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0004","start":4,"end":9,"surface":"齊諸田疏屬","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存；神為策略敘事，不補具名神祇或宗族親屬。"},{"id":"c-shiji-082-tiandan:m001-0011","start":11,"end":13,"surface":"湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0015","start":15,"end":16,"surface":"單","kind":"person","person_id":"cbr-p004641","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0029","start":29,"end":31,"surface":"樂毅","kind":"person","person_id":"cbr-p004643","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0035","start":35,"end":38,"surface":"齊湣王","kind":"person","person_id":"cbr-p004642","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0055","start":55,"end":57,"surface":"田單","kind":"person","person_id":"cbr-p004641","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0063","start":63,"end":65,"surface":"宗人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存；神為策略敘事，不補具名神祇或宗族親屬。"},{"id":"c-shiji-082-tiandan:m001-0087","start":87,"end":89,"surface":"齊人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存；神為策略敘事，不補具名神祇或宗族親屬。"},{"id":"c-shiji-082-tiandan:m001-0106","start":106,"end":108,"surface":"田單","kind":"person","person_id":"cbr-p004641","status":"contextual_provisional"},{"id":"c-shiji-082-tiandan:m001-0108","start":108,"end":110,"surface":"宗人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未定角色或泛論保存；神為策略敘事，不補具名神祇或宗族親屬。"},{"id":"c-shiji-082-tiandan:m001-0141","start":141,"end":143,"surface":"齊王","kind":"person","person_id":"cbr-p004642","status":"contextual_pro