_msa_t3x","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p002","text":"呉回生陸終。陸終生子六人，坼剖而産焉。其長一曰昆吾；二曰參胡；三曰彭祖；四曰會人；五曰曹姓；六曰季連，羋姓，楚其後也。昆吾氏，夏之時嘗爲侯伯，桀之時湯滅之。彭祖氏，殷之時嘗爲侯伯，殷之末世滅彭祖氏。季連生附沮，附沮生穴熊。其後中微，或在中國，或在蠻夷，弗能紀其世。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m002-0000","start":0,"end":2,"surface":"呉回","kind":"person","person_id":"uk3_s1y_7c7","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0003","start":3,"end":5,"surface":"陸終","kind":"person","person_id":"c92_v5d_med","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0006","start":6,"end":8,"surface":"陸終","kind":"person","person_id":"c92_v5d_med","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0023","start":23,"end":25,"surface":"昆吾","kind":"person","person_id":"52f_fie_3vj","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0028","start":28,"end":30,"surface":"參胡","kind":"person","person_id":"sjs_nr4_k35","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0033","start":33,"end":35,"surface":"彭祖","kind":"person","person_id":"a9s_bmk_9h5","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0038","start":38,"end":40,"surface":"會人","kind":"person","person_id":"ghj_5dg_gu1","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0043","start":43,"end":45,"surface":"曹姓","kind":"person","person_id":"883_mfp_qi1","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0048","start":48,"end":50,"surface":"季連","kind":"person","person_id":"ids_h4k_pn5","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m002-0059","start":59,"end":62,"surface":"昆吾氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"本處為氏族／群體稱呼，與祖系中的具名個人分開，未補全體成員。"},{"id":"c-shiji-040-chu:m002-0071","start":71,"end":72,"surface":"桀","kind":"person","person_id":"65f_dvi_lj