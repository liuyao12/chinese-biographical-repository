ot_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-nanshi019-chun-wife-yu","subject_person_id":"my8_62g_1b9","object_person_id":"aa6_83c_juy_ABA","predicate":"spouse","status":"source_attested","qualifiers":{"source_term":"純妻庾"},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-019","chapter_id":"c-nanshi-019-xieshu","source_id":"s-nanshi-019-xieshu-ws1531762","paragraph_id":"c-nanshi-019-xieshu:p001","quote":"甝弟述字景先，小字道兒。少有至行，隨純在江陵，純遇害，述奉純喪還都，至西塞遇暴風，純喪舫流漂不知所在，述乘小船尋求，經純妻庾舫過。庾遣人謂曰：「小郎去必無及，寧可存亡俱盡邪。」述號泣答曰：「若安全至岸，尙須營理；如其已致意外，述亦無心獨存。」因冒浪而進，見純喪幾沒，述號叫呼天，幸而獲免。咸以爲精誠所致，武帝聞而嘉之。及臨豫州，諷中正以爲迎主簿，甚被器遇。","subject_person_mention_id":"c-nanshi-019-xieshu:p001:m0061","object_person_mention_id":"c-nanshi-019-xieshu:p001:m0059"}],"interpretation_note":"某氏庾乘舫，明為純妻。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-song052-xieshu-pure-wife","subject_person_id":"my8_62g_1b9","object_person_id":"aa6_83c_juy_ABA","predicate":"spouse","qualifiers":{"source_term":"純妻庾","song052_xieshu_reading":"pure-wife"},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-052","source_id":"s-songshu-052-xieshu-ws2190655","chapter_id":"c-songshu-052-xieshu","paragraph_id":"c-songshu-052-xieshu:p001","quote":"述字景先，少有志行，隨兄純在江陵。純遇害，述奉純喪還都。行至西塞，值暴風，純喪舫流漂，不知所在，述乘小船尋求之。經純妻庾舫過，庾遣人謂述曰：「喪舫存沒，已應有在，風波如此，豈可小船所冒？小郎去必無及，寧可存亡俱盡邪。」述號泣答曰：「若安全至岸，當須營理。如其已致意外，述亦無心獨存。」因冒浪而進，見純喪幾沒，述號叫呼天，幸而獲免，咸以為精誠所致也。高祖聞而嘉之，及臨豫州，諷中正以述為主簿，甚被知器。景仁愛其第三弟甝而憎述，嘗設饌請高祖，希命甝豫坐，而高祖召述。述知非景仁夙意，又慮高祖命之，請急不從。高祖馳遣呼述，須至乃歡。及景仁有疾，述盡心營視，湯藥飲食，必嘗而後進，不解帶、不盥櫛者累旬，景仁深懷感愧。","subject_person_mention_id":"c-songshu-052-xieshu:p001:m0059","object_person_mention_id":"c-songshu-052-xieshu:p001:m0057"}],"status":"source_attested","interpretation_note":"庾氏是純妻。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required