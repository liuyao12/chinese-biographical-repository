entioned_source_ids":["s-shiji-004-zhou"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-004-zhou:m034-0012","start":12,"end":14,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p034","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m034-0078","start":78,"end":80,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p034","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m034-0095","start":95,"end":97,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p034","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m035-0006","start":6,"end":8,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p035","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m035-0020","start":20,"end":22,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p035","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m036-0000","start":0,"end":2,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p036","chapter_id":"c-shiji-004-zhou"},{"id":"c-shiji-004-zhou:m036-0034","start":34,"end":36,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified","paragraph_id":"c-shiji-004-zhou:p036","chapter_id":"c-shiji-004-zhou"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-004-zhou:p034","text":"王行暴虐侈傲，國人謗王。召公諫曰：「民不堪命矣。」王怒，得衛巫，使監謗者，以告則殺之。其謗鮮矣，諸侯不朝。三十四年，王益嚴，國人莫敢言，道路以目。厲王喜，告召公曰：「吾能弭謗矣，乃不敢言。」召公曰：「是鄣之也。防民之口，甚於防水。水壅而潰，傷人必多，民亦如之。是故為水者決之使導，為民者宣之使言。故天子聽政，使公卿至於列士獻詩，瞽獻曲，史獻書，師箴，瞍賦，矇誦，百工諫，庶人傳語，近臣盡規，親戚補察，瞽史教誨，耆艾修之，而後王斟酌焉，是以事行而不悖。民之有口也，猶土之有山川也，財用於是乎出：猶其有原隰衍沃也，衣食於是乎生。口之宣言也，善敗於是乎興。行善而備敗，所以產財用衣食者也。夫民慮之於心而宣之於口，成而行之。若壅其口，其與能幾何？」王不聽。於是國莫敢出言，三年，乃相與畔，襲厲王。厲王出奔於彘。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m034-0012","start":12,"end":14,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0029","start":29,"end":31,"surface":"衛巫","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、官號或文字疑讀；保留錨點，不補熟知姓名或假定同指。"},{"id":"c-shiji-004-zhou:m034-0073","start":73,"end":75,"surface":"厲王","kind":"person","person_id":"cbr-p000208","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0078","start":78,"end":80,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0095","start":95,"end":97,"surface":"召公","kind":"person","person_id":"cbr-p000211","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0341","start":341,"end":343,"surface":"厲王","kind":"person","person_id":"cbr-p000208","status":"source_identified"},{"id":"c-shiji-004-zhou:m034-0344","start":344,"end":346,"surface":"厲王","kind":"person","person_id":"cbr-p000208","status":"source_identified"}],"chapter_id":"c-shiji-004-zhou","book_id":"b-shiji-004","work_id":"w-shiji","source_id":"s-shiji-004-zhou"},{"id":"c-shiji-004-zhou:p035","text":"厲王太子靜匿召公之家，國人聞之，乃圍之。召公曰：「昔吾驟諫王，王不從，以及此難也。今殺王太子，王其以我為讎而懟怒乎？夫事君者，險而不讎懟，怨而不怒，況事王乎！」乃以其子代王太子，太子竟得脫。","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-shiji-004-zhou:m035-0000","start":0,"end":2,"surface":"厲王","kind":"person","person_id":"cbr-p000208","status":"source_identified"},{"id":"c-shiji-004-zhou:m035-0002","start":2,"end":5,"surface":"太子靜","kind":"person","person_id":"cbr-p000213","status":"source_identified"},{"id":"c-shiji-004-zhou:m035-0006","sta