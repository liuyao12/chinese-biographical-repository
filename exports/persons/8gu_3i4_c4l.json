ing-shi-ws2478204","chapter_id":"c-nanshi-023-wangying-shi","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"實","mention_id":"c-nanshi-023-wangying-shi:p006:m0149"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangying-shi-ws2478204","chapter_id":"c-nanshi-023-wangying-shi","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"實","mention_id":"c-nanshi-023-wangying-shi:p006:m0162"}],"review":"ai_provisional","identity_note":"南史王瑩傳末少子實嗣，並敘尚安吉公主、襲建城公及二府任事。","family_path":{"connection":"father","generation_distance":1,"parent_person_id":"7r6_k52_qji_ABAACAABCA","source_assertion_id":"a-nan023-wangying-shi-father","evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangying-shi-ws2478204","chapter_id":"c-nanshi-023-wangying-shi","paragraph_id":"c-nanshi-023-wangying-shi:p005","quote":"十五年，位左光祿大夫、開府儀同三司、丹陽尹。既為公，須開黃合。宅前促，欲買南鄰朱侃半宅。侃懼見侵，貨得錢百萬，瑩乃回合向東。時人為之語曰：「欲向南，錢可貪；遂向東，為黃銅。」及將拜，印工鑄印，六鑄而龜六毀。及成，頭空不實，補而用之。居職六日暴疾薨，諡曰靜恭。","object_person_mention_id":"c-nanshi-023-wangying-shi:p005:m0055"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangying-shi-ws2478204","chapter_id":"c-nanshi-023-wangying-shi","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"少子實嗣。起家秘書郎，尚梁武帝女安吉公主，襲爵建城縣公，為新安太守。實從兄來郡，就求告。實與銅錢五十萬，不聽於郡及道散用。從兄密于郡市貨，還都求利。及去郡數十里，實乃知，命追之。呼從兄上岸盤頭，令卒與杖，搏頰乞原，劣得免。後為南康嗣王湘州長史、長沙郡。王三日出禊，實衣冠傾崎，王性方嚴，見之意殊惡。實稱主名謂王曰：「蕭玉志念實，殿下何見憎？」王驚赧即起。後密啟之，因此廢錮。","subject_person_mention_id":"c-nanshi-023-wangying-shi:p006:m0002"}],"status":"contextual_provisional","interpretation_note":"少子未給數字序，嗣父爵見下句。","human_reviewed":false}},{"id":"8gu_3i4_c4l","label":"王實從兄（求告者，未名）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"從兄","mention_ids":["c-nanshi-023-wangying-shi:p006:m0035","c-nanshi-023-wangying-shi:p006:m0061","c-nanshi-023-wangying-shi:p006:m0090"]}],"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangying-shi-ws2478204","chapter_id":"c-nanshi-023-wangying-shi","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"從兄","mention_id":"c-nanshi-023-wangying-shi:p006:m0035"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangying-shi-ws2478204","chapter_id":"c-nanshi-023-wangying-shi","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"從兄","mention_id":"c-nanshi-023-wangying-shi:p006:m0061"},{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangying-shi-ws2478204","chapter_id":"c-nanshi-023-wangying-shi","paragraph_id":"c-nanshi-023-wangying-shi:p006","quote":"從兄","mention_id":"c-nanshi-023-wangying-shi:p006:m0090"}],"review":"ai_provisional","identity_note":"南史所敘受杖從兄有可追溯事跡，沒有名字與父親。"}],"source_mention_summary":[{"source_id":"s-nanshi-023-wangying-shi-ws2478204","work_id":"w-nanshi","book_id":"b-nanshi-023","chapter_id":"c-nanshi-023-wangying-shi","raw_mention_count":3,"mention_ids":["c-nanshi-023-wangying-shi:p006:m0035","c-nanshi-023-wangying-shi:p006:m0061","c-nanshi-023-wangying-shi:p006:m0090"],"paragraph_ids":["c-nanshi-023-wangying-shi:p006"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanshi-023-wangying-shi:p006:m0035","mention_ids":["c-nanshi-023-wangying-shi:p006:m0035"],"kind":"paragraph"},{"canonical_mention_id":"c-nanshi-023-wangying-shi:p006:m0061","mention_ids":["c-nanshi-023-wangying-shi:p006:m0061"],"kind":"paragraph"},{"canonical_mention_id":"c-nanshi-023-wangying-shi:p006:m0090","mention_ids":["c-nanshi-023-wangying-shi:p006:m0090"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanshi-023-wangying-shi-ws2478204"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annota