{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003675","identity_policy":"contextual_provisional","person_ids":["cbr-p003675"],"persons":[{"id":"cbr-p003675","label":"宗正使者（三王世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"宗正","mention_ids":["c-shiji-060-sanwang:m030-0092","c-shiji-060-sanwang:m030-0130"]}],"evidence":[{"mention_id":"c-shiji-060-sanwang:m030-0092","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p030","quote":"宗正"},{"mention_id":"c-shiji-060-sanwang:m030-0130","chapter_id":"c-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p030","quote":"宗正"}]}],"mentions":[{"id":"c-shiji-060-sanwang:m030-0092","start":92,"end":94,"surface":"宗正","kind":"person","person_id":"cbr-p003675","status":"contextual_provisional","paragraph_id":"c-shiji-060-sanwang:p030","chapter_id":"c-shiji-060-sanwang"},{"id":"c-shiji-060-sanwang:m030-0130","start":130,"end":132,"surface":"宗正","kind":"person","person_id":"cbr-p003675","status":"contextual_provisional","paragraph_id":"c-shiji-060-sanwang:p030","chapter_id":"c-shiji-060-sanwang"}],"relations":[],"title_holdings":[{"id":"th-shiji060-026","person_id":"cbr-p003675","title":"宗正","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-060-sanwang","source_id":"s-shiji-060-sanwang","paragraph_id":"c-shiji-060-sanwang:p030","quote":"會武帝崩，昭帝初立，旦果作怨而望大臣。自以長子當立，與齊王子劉澤等謀為叛逆，出言曰：「我安得弟在者！今立者乃大將軍子也。」欲發兵。事發覺，當誅。昭帝緣恩寬忍，抑案不揚。公卿使大臣請，遣宗正與太中大夫公戶滿意、御史二人，偕往使燕，風喻之。到燕，各異日，更見責王。宗正者，主宗室諸劉屬籍，先見王，為列陳道昭帝實武帝子狀。侍御史乃復見王，責之以正法，問：「王欲發兵罪名明白，當坐之。漢家有正法，王犯纖介小罪過，即行法直斷耳，安能寬王。」驚動以文法。王意益下，心恐。公戶滿意習於經術，最後見王，稱引古今通義，國家大禮，文章爾雅。謂王曰：「古者天子必內有異姓大夫，所以正骨肉也；外有同姓大夫，所以正異族也。周公輔成王，誅其兩弟，故治。武帝在時，尚能寬王。今昭帝始立，年幼，富於春秋，未臨政，委任大臣。古者誅罰不阿親戚，故天下治。方今大臣輔政，奉法直行，無敢所阿，恐不能寬王。王可自謹，無自令身死國滅，為天下笑。」於是燕王旦乃恐懼服罪，叩頭謝過。大臣欲和合骨肉，難傷之以法。"}],"attestations":[{"id":"th-shiji060-026:a001","paragraph_id":"c-shiji-060-sanwang:p030","start":92,"end":94,"surface":"宗正","pers