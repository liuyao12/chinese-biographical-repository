{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000551","identity_policy":"contextual_provisional","person_ids":["cbr-p000551"],"persons":[{"id":"cbr-p000551","label":"楊端和","status":"active","historicity":"historical_tradition","aliases":[{"surface":"楊端和","mention_ids":["c-shiji-006-shihuang:m010-0278","c-shiji-006-shihuang:m012-0010"]},{"surface":"端和","mention_ids":["c-shiji-006-shihuang:m015-0020","c-shiji-006-shihuang:m015-0031"]}],"evidence":[{"mention_id":"c-shiji-006-shihuang:m010-0278","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p010","quote":"楊端和"},{"mention_id":"c-shiji-006-shihuang:m012-0010","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p012","quote":"楊端和"},{"mention_id":"c-shiji-006-shihuang:m015-0020","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p015","quote":"端和"},{"mention_id":"c-shiji-006-shihuang:m015-0031","chapter_id":"c-shiji-006-shihuang","paragraph_id":"c-shiji-006-shihuang:p015","quote":"端和"}],"identity_note":"依本卷特定時代與事件暫定人物；不以同稱、官號或短名全域合併，未見本名不補造。","review":"ai_provisional"}],"mentions":[{"id":"c-shiji-006-shihuang:m010-0278","start":278,"end":281,"surface":"楊端和","kind":"person","person_id":"cbr-p000551","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p010","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:m012-0010","start":10,"end":13,"surface":"楊端和","kind":"person","person_id":"cbr-p000551","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p012","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:m015-0020","start":20,"end":22,"surface":"端和","kind":"person","person_id":"cbr-p000551","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p015","chapter_id":"c-shiji-006-shihuang"},{"id":"c-shiji-006-shihuang:m015-0031","start":31,"end":33,"surface":"端和","kind":"person","person_id":"cbr-p000551","status":"contextual_provisional","paragraph_id":"c-shiji-006-shihuang:p015","chapter_id":"c-shiji-006-shihuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji006-013","person_id":"cbr-p000551","surfaces":["端和"],"scope":"same_chapter","chapter_ids":["c-shiji-006-shihuang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-006-shihuang:p012","quote":"十一年，王翦、桓齮、楊端和攻鄴，取九城。王翦攻閼與、橑楊，皆并為一軍。翦將十八日，軍歸斗食以下，什推二人從軍取鄴安陽，桓齮將。十二年，文信侯不韋死，竊葬。其舍人臨者，晉人也逐出之；秦人六百石以上奪爵，遷；五百石以下不臨，遷，勿奪爵。自今以來，操國事不道如嫪毐、不韋者籍其門，視此。秋，復嫪毐舍人遷蜀者。當是之時，天下大旱，六月至八月乃雨。"},{"paragraph_id":"c-shiji-006-shihuang:p015","quote":"十八年，大興兵攻趙，王翦將上地，下井陘，端和將河內，羌瘣伐趙，端和圍邯鄲城。十九年，王翦、羌瘣盡定取趙地東陽，得趙王。引兵欲攻燕，屯中山。秦王之邯鄲，諸嘗與王生趙時母家有仇怨，皆阬之。秦王還，從太原、上郡歸。始皇帝母太后崩。趙公子嘉率其宗數百人之代，自立為代王，東與燕合兵，軍上谷。大饑。"}],"rationale":"按本段或連續事件中已引入人物的名、授號或短稱暫定同指；不將單字套用至地名或普通詞。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-006-shihuang:p010","text":"嫪毐封為長信侯。予之山陽地，令毐居之。宮室車馬衣服苑囿馳獵恣毐。事無小大皆決於毐。又以河西太原郡更為毐國。九年，彗星見，或竟天。攻魏垣、蒲陽。四月，上宿雍。己酉，王冠，帶劍。長信侯毐作亂而覺，矯王御璽及太后璽以發縣卒及衛卒、官騎、戎翟君公、舍人，將欲攻蘄年宮為亂。王知之，令相國昌平君、昌文君發卒攻毐。戰咸陽，斬首數百，皆拜爵，及宦者皆在戰中，亦拜爵一級。毐等敗走。即令國中：有生得毐，賜錢百萬；殺之，五十萬。盡得毐等。衛尉竭、內史肆、佐弋竭、中大夫令齊等二十人皆梟首。車裂以徇，滅其宗。及其舍人，輕者為鬼薪。及奪爵遷蜀四千餘家，家房陵。四月寒凍，有死者。楊端和攻衍氏。彗星見西方，又見北方，從斗以南八十日。十年，相國呂不韋坐嫪毐免。桓齮為將軍。齊、趙來置酒。齊人茅焦說秦王曰：「秦方以天下為事，而大王有遷母太后之名，恐諸侯聞之，由此倍秦也。」秦王乃迎太后於雍而入咸陽，復居甘泉宮。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-006-shihuang:m010-0000","start":0,"end":2,"surface":"嫪毐","kind":"person","person_id":"cbr-p000544","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0004","start":4,"end":7,"surface":"長信侯","kind":"person","person_id":"cbr-p000544","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0015","start":15,"end":16,"surface":"毐","kind":"person","person_id":"cbr-p000544","status":"contextual_provisional"},{"id":"c-shiji-006-shihuang:m010-0030","start":30,"end":31,"surface":"毐","kind":"person"