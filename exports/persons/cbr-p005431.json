{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005431","canonical_person_id":"4qa_pqm_6hr","id_aliases":["cbr-p005431"],"identity_policy":"contextual_provisional","person_ids":["4qa_pqm_6hr"],"persons":[{"id":"4qa_pqm_6hr","label":"繁君（丞相司直）（張丞相列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"繁君","mention_ids":["c-shiji-096-zhang:m023-0142"]}],"evidence":[{"mention_id":"c-shiji-096-zhang:m023-0142","chapter_id":"c-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p023","quote":"繁君"}],"id_aliases":["cbr-p005431"]}],"source_mention_summary":[{"source_id":"s-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","chapter_id":"c-shiji-096-zhang","mention_count":1,"mention_ids":["c-shiji-096-zhang:m023-0142"],"paragraph_ids":["c-shiji-096-zhang:p023"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-096-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-096-zhang:m023-0142","start":142,"end":144,"surface":"繁君","kind":"person","person_id":"4qa_pqm_6hr","status":"contextual_provisional","paragraph_id":"c-shiji-096-zhang:p023","chapter_id":"c-shiji-096-zhang"}],"relations":[],"title_holdings":[{"id":"th-shiji096-074","person_id":"4qa_pqm_6hr","title":"丞相司直","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p023","quote":"魏丞相相者，濟陰人也。以文吏至丞相。其人好武，皆令諸吏帶劍，帶劍前奏事。或有不帶劍者，當入奏事，至乃借劍而敢入奏事。其時京兆尹趙君，丞相奏以免罪，使人執魏丞相，欲求脫罪而不聽。復使人脅恐魏丞相，以夫人賊殺待婢事而私獨奏請驗之，發吏卒至丞相舍，捕奴婢笞擊問之，實不以兵刃殺也。而丞相司直繁君奏京兆尹趙君迫脅丞相，誣以夫人賊殺婢，發吏卒圍捕丞相舍，不道；又得擅屏騎士事，趙京兆坐要斬。又有使掾陳平等劾中尚書，疑以獨擅劫事而坐之，大不敬，長史以下皆坐死，或下蠶室。而魏丞相竟以丞相病死。子嗣。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。魏丞相卒，以御史大夫邴吉代。"}],"attestations":[{"id":"th-shiji096-074:a001","paragraph_id":"c-shiji-096-zhang:p023","start":138,"end":142,"surface":"丞相司直","person_mention_id":"c-shiji-096-zhang:m023-0142","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、轉任、用稱與諡稱分存；未明示時任期起訖未知。欲任竇廣國及欲令周苛將皆不作實授；死亡或首次用稱不自動作任期端點。十四年、四年、二年等先保留原語，不擅定年號或西曆。曹窋免職段含（不）異文，未先強定其終點。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji096-073","person_id":"4qa_pqm_6hr","scope":"same_chapter","chapter_ids":["c-shiji-096-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["繁君"],"evidence":[{"paragraph_id":"c-shiji-096-zhang:p023","quote":"魏丞相相者，濟陰人也。以文吏至丞相。其人好武，皆令諸吏帶劍，帶劍前奏事。或有不帶劍者，當入奏事，至乃借劍而敢入奏事。其時京兆尹趙君，丞相奏以免罪，使人執魏丞相，欲求脫罪而不聽。復使人脅恐魏丞相，以夫人賊殺待婢事而私獨奏請驗之，發吏卒至丞相舍，捕奴婢笞擊問之，實不以兵刃殺也。而丞相司直繁君奏京兆尹趙君迫脅丞相，誣以夫人賊殺婢，發吏卒圍捕丞相舍，不道；又得擅屏騎士事，趙京兆坐要斬。又有使掾陳平等劾中尚書，疑以獨擅劫事而坐之，大不敬，長史以下皆坐死，或下蠶室。而魏丞相竟以丞相病死。子嗣。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。魏丞相卒，以御史大夫邴吉代。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定短稱；韋賢與韋玄成分傳區別，第23段掾陳平另候選，第25段長安相工田文不與孟嘗君合併。趙堯、任敖、申屠嘉、鄧通、晁錯的短名依各段人物語境，王陵夫人與王陵分人。張蒼父長不滿五尺的長為身長敘述，不作父名。王侯與太子未詳名不補名，跨篇同指另待證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-096-zhang:p023","text":"魏丞相相者，濟陰人也。以文吏至丞相。其人好武，皆令諸吏帶劍，帶劍前奏事。或有不帶劍者，當入奏事，至乃借劍而敢入奏事。其時京兆尹趙君，丞相奏以免罪，使人執魏丞相，欲求脫罪而不聽。復使人脅恐魏丞相，以夫人賊殺待婢事而私獨奏請驗之，發吏卒至丞相舍，捕奴婢笞擊問之，實不以兵刃殺也。而丞相司直繁君奏京兆尹趙君迫脅丞相，誣以夫人賊殺婢，發吏卒圍捕丞相舍，不道；又得擅屏騎士事，趙京兆坐要斬。又有使掾陳平等劾中尚書，疑以獨擅劫事而坐之，大不敬，長史以下皆坐死，或下蠶室。而魏丞相竟以丞相病死。子嗣。後坐騎至廟，不敬，有詔奪爵一級，為關內侯，失列侯，得食其故國邑。魏丞相卒，以御史大夫邴吉代。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-096-zhan