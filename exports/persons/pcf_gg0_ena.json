nstraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-songshu-066-wangjinghong:line014","text":"高祖以為車騎從事中郎，徐州治中從事史，征西將軍道規諮議參軍。時府主簿宗協亦有高趣，道規並以事外相期。嘗共酣飲致醉，敬弘因醉失禮，為外司所白，道規即更引還，重申初讌。召為中書侍郎，始攜家累自作唐還京邑。久之，轉黃門侍郎，不拜。仍除太尉從事中郎，出為吳興太守。舊居餘杭縣，悅是舉也。尋徵為侍中。高祖西討司馬休之，敬弘奉使慰勞，通事令史潘尚於道疾病，敬弘單船送還都，存亡不測，有司奏免官，詔可。未及釋朝服，值赦復官。宋國初建，為度支尚書，遷太常。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-songshu-066-wangjinghong:line014:m0000","start":0,"end":2,"surface":"高祖","kind":"person","person_id":"3dv_ken_w58","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0023","start":23,"end":25,"surface":"道規","kind":"person","person_id":"1ut_j9y_xn7","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0034","start":34,"end":36,"surface":"宗協","kind":"person","person_id":"hl3_sbq_hs8","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0041","start":41,"end":43,"surface":"道規","kind":"person","person_id":"1ut_j9y_xn7","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0057","start":57,"end":59,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0070","start":70,"end":72,"surface":"道規","kind":"person","person_id":"1ut_j9y_xn7","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0145","start":145,"end":147,"surface":"高祖","kind":"person","person_id":"3dv_ken_w58","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0149","start":149,"end":153,"surface":"司馬休之","kind":"person","person_id":"pcf_gg0_ena","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0154","start":154,"end":156,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0165","start":165,"end":167,"surface":"潘尚","kind":"person","person_id":"bqg_ph5_9y6","status":"contextual_provisional"},{"id":"c-songshu-066-wangjinghong:line014:m0172","start":172,"end":174,"surface":"敬弘","kind":"person","person_id":"7r6_k52_qji_ABDABAA","status":"contextual_provisional"}],"source_position":{"first_line":14,"last_line":14,"revision_id":2069104,"editorial_excerpt_boundary":false},"chapter_id":"c-songshu-066-wangjinghong","book_id":"b-songshu-066","work_id":"w-songshu","source_id":"s-songshu-066-wangjinghong"},{"id":"c-weishu-weishou-035-cuihao:p004","text":"泰常元年司馬德宗將劉裕伐姚泓舟師自淮泗入清欲泝河西上假道於國詔羣臣議之外朝公卿咸曰函谷闗號曰天險一人荷戈萬夫不得進裕舟舩歩兵何能西入脫我乘其後還路甚難若北上河岸其行為易揚言伐姚意或難測假其水道宼不可縱宜先發軍斷河上流勿令西過又議之内朝咸同外計太宗將從之浩曰此非上䇿司馬休之之徒擾其荆州劉裕切齒來久今興死子劣乘其危亡而伐之臣觀其意必欲入闗勁躁之人不顧後患今若塞其西路裕必上岸北侵如此則姚無事而我受敵今蠕蠕内宼民食又乏不可發軍發軍赴南則北宼進擊若其救北則東州復危未若假之水道縱裕西入然後興兵塞其東歸之路所謂卞莊刺虎兩得之勢也使裕勝也必徳我假道之恵令姚氏勝也亦不失救隣之名縱使裕得闗中縣逺難守彼不能守終為我物今不勞兵馬坐觀成敗鬭兩虎而收長久之利上䇿也夫為國之計擇利而為之豈顧婚姻酬一女子之恵哉假令國家棄恒山以南裕必不能發吳越之兵與官軍爭守河北也居然可知議者猶曰裕西入函谷則進退路窮腹背受敵北上岸則姚軍必不出闗助我揚聲西行意在北進其勢然也太宗遂從羣議遣長孫嵩發兵拒之戰於畔城為裕將朱超石所敗師人多傷太宗聞之恨不用浩計","text_layer":"received_chapter","annotation_status":"in_progress","source_position":{"first_line":59,"last_line":84,"revision_id":"17b6525eb5aaa878b9640f5a61e90da934ce5fc4","source_layer":"received_biography","projection_sha256":"3f7e17a43b51df5d9b2822772c5b346d0acae6ed97716e66af236e2d8d3a87ad","raw_character_positions":[{"line":59,"column":18},{"line":59,"column":19},{"line":59,"column":20},{"line":60,"column":0},{"line":60,"column":1},{"line":60,"column":2},{"line":60,"column":3},{"line":60,"column":4},{"line":60,"column":5},{"line":60,"column":6},{"line":60,"column":7},{"line":60,"column":8},{"line":60,"column":9},{"line":60,"column":10},{"line":60,"column":11},{"line":60,"column":12},{"line":60,"column":13},{"line":60,"column":14},{"line":60,"column":15},{"line":60,"column":16},{"line":60,"column":17},{"line":60,"column":18},{"line":60,"column":19},{"line":60,"column":20},{"line":62,"column":0},{"line":62,"column":1},{"line":62,"column":2},{"line":62,"column":3},{"line":62,"column":4},{"line":62,"colum