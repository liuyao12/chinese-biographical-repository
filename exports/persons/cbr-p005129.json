{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p005129","identity_policy":"contextual_provisional","person_ids":["cbr-p005129"],"persons":[{"id":"cbr-p005129","label":"陳平（淮陰侯列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"陳平","mention_ids":["c-shiji-092-hanxin:m016-0110","c-shiji-092-hanxin:m023-0072"]}],"evidence":[{"mention_id":"c-shiji-092-hanxin:m016-0110","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p016","quote":"陳平"},{"mention_id":"c-shiji-092-hanxin:m023-0072","chapter_id":"c-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p023","quote":"陳平"}]}],"mentions":[{"id":"c-shiji-092-hanxin:m016-0110","start":110,"end":112,"surface":"陳平","kind":"person","person_id":"cbr-p005129","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p016","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m023-0072","start":72,"end":74,"surface":"陳平","kind":"person","person_id":"cbr-p005129","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p023","chapter_id":"c-shiji-092-hanxin"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji092-033","person_id":"cbr-p005129","scope":"same_chapter","chapter_ids":["c-shiji-092-hanxin"],"status":"contextual_provisional","rationale":"按明示姓名及局部事件承接；王號限敘事主體，酈食其酈生及蒯通蒯生暫接，未名者與引古人物各存。不補邯欣翳及周召等短稱完整姓名。","reviewer":"Codex（AI 代理）","surfaces":["陳平"],"evidence":[{"paragraph_id":"c-shiji-092-hanxin:p016","quote":"漢四年，遂皆降平齊。使人言漢王曰：『齊偽詐多變，反覆之國也，南邊楚，不爲假王以鎮之，其勢不定。願爲假王便。』當是時，楚方急圍漢王於滎陽，韓信使者至，發書，漢王大怒，罵曰：『吾困於此，旦暮望若來佐我，乃欲自立爲王！』張良、陳平躡漢王足，因附耳語曰：『漢方不利，寧能禁信之王乎？不如因而立，善遇之，使自爲守。不然，變生。』漢王亦悟，因復罵曰：『大丈夫定諸侯，即爲真王耳，何以假爲！』乃遣張良往立信爲齊王，徵其兵擊楚。"},{"paragraph_id":"c-shiji-092-hanxin:p023","quote":"項王亡將鐘離眛家在伊廬，素與信善。項王死後，亡歸信。漢王怨眛，聞其在楚，詔楚捕眛。信初之國，行縣邑，陳兵出入。漢六年，人有上書告楚王信反。髙帝以陳平計，天子巡狩會諸侯，南方有雲夢，發使告諸侯會陳：『吾將游雲夢。』實欲襲信，信弗知。髙祖且至楚，信欲發兵反，自度無罪，欲謁上，恐見禽。人或說信曰：『斬眛謁上，上必喜，無患。』信見眛計事。眛曰：『漢所以不擊取楚，以眛在公所。若欲捕我以自媚於漢，吾今日死，公亦隨手亡矣。』乃罵信曰：『公非長者！』卒自剄。信持其首，謁髙祖於陳。上令武士縛信，載後車。信曰：『果若人言，「狡兔死，良狗亨；髙鳥盡，良弓藏；敵國破，謀臣亡。」天下已定，我固當亨！』上曰：『人告公反。』遂械系信。至雒陽，赦信罪，以爲淮陰侯。"}]}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-092-hanxin:p016","text":"漢四年，遂皆降平齊。使人言漢王曰：『齊偽詐多變，反覆之國也，南邊楚，不爲假王以鎮之，其勢不定。願爲假王便。』當是時，楚方急圍漢王於滎陽，韓信使者至，發書，漢王大怒，罵曰：『吾困於此，旦暮望若來佐我，乃欲自立爲王！』張良、陳平躡漢王足，因附耳語曰：『漢方不利，寧能禁信之王乎？不如因而立，善遇之，使自爲守。不然，變生。』漢王亦悟，因復罵曰：『大丈夫定諸侯，即爲真王耳，何以假爲！』乃遣張良往立信爲齊王，徵其兵擊楚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m016-0013","start":13,"end":15,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0062","start":62,"end":64,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0068","start":68,"end":70,"surface":"韓信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0077","start":77,"end":79,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0107","start":107,"end":109,"surface":"張良","kind":"person","person_id":"cbr-p005128","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0110","start":110,"end":112,"surface":"陳平","kind":"person","person_id":"cbr-p005129","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0113","start":113,"end":115,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0132","start":132,"end":133,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0159","start":159,"end":161,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m016-0191","start":191,"end":193,"surface":"張良","kind":"person","per