-kong:m057-0037","chapter_id":"c-shiji-047-kong","paragraph_id":"c-shiji-047-kong:p057","quote":"康子"}]}],"mentions":[{"id":"c-shiji-047-kong:m039-0044","start":44,"end":46,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p039","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m039-0075","start":75,"end":77,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p039","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m039-0126","start":126,"end":128,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p039","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m053-0018","start":18,"end":21,"surface":"季康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p053","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m053-0022","start":22,"end":24,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p053","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m055-0021","start":21,"end":24,"surface":"季康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p055","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m055-0054","start":54,"end":57,"surface":"季康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p055","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m055-0109","start":109,"end":111,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p055","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m055-0195","start":195,"end":198,"surface":"季康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p055","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m057-0016","start":16,"end":19,"surface":"季康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p057","chapter_id":"c-shiji-047-kong"},{"id":"c-shiji-047-kong:m057-0037","start":37,"end":39,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional","paragraph_id":"c-shiji-047-kong:p057","chapter_id":"c-shiji-047-kong"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji047-087","person_id":"cbr-p002909","scope":"same_chapter","chapter_ids":["c-shiji-047-kong"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["季康子","康子"],"evidence":[{"paragraph_id":"c-shiji-047-kong:p039","quote":"秋，季桓子病，輦而見魯城，喟然嘆曰：「昔此國幾興矣，以吾獲罪於孔子，故不興也。」顧謂其嗣康子曰：「我即死，若必相魯；相魯，必召仲尼。」後數日，桓子卒，康子代立。已葬，欲召仲尼。公之魚曰：「昔吾先君用之不終，終為諸侯笑。今又用之，不能終，是再為諸侯笑。」康子曰：「則誰召而可？」曰：「必召冉求。」於是使使召冉求。冉求將行，孔子曰：「魯人召求，非小用之，將大用之也。」是日，孔子曰：「歸乎歸乎！吾黨之小子狂簡，斐然成章，吾不知所以裁之。」子貢知孔子思歸，送冉求，因誡曰「即用，以孔子為招」云。"},{"paragraph_id":"c-shiji-047-kong:p053","quote":"其明年，吳與魯會繒，徵百牢。太宰嚭召季康子。康子使子貢往，然後得已。"},{"paragraph_id":"c-shiji-047-kong:p055","quote":"其明年，冉有為季氏將師，與齊戰於郎，克之。季康子曰：「子之於軍旅，學之乎？性之乎？」冉有曰：「學之於孔子。」季康子曰：「孔子何如人哉？」對曰：「用之有名；播之百姓，質諸鬼神而無憾。求之至於此道，雖累千社，夫子不利也。」康子曰：「我欲召之，可乎？」對曰：「欲召之，則毋以小人固之，則可矣。」而衞孔文子將攻太叔，問策於仲尼。仲尼辭不知，退而命載而行，曰：「鳥能擇木，木豈能擇鳥乎！」文子固止。會季康子逐公華、公賓、公林，以幣迎孔子，孔子歸魯。"},{"paragraph_id":"c-shiji-047-kong:p057","quote":"魯哀公問政，對曰：「政在選臣。」季康子問政，曰：「舉直錯諸枉，則枉者直。」康子患盜，孔子曰：「苟子之不欲，雖賞之不竊。」然魯終不能用孔子，孔子亦不求仕。"}],"rationale":"限本篇明示名、字、對話自稱、世系及附贊局部對應；世系求與冉求分開，武不接漢武帝，今皇帝與高皇帝不補姓名。子路仲由明示同指另存，冉有冉求與秦繆秦穆仍待核；附贊不當獨立作者正文或獨立見證。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-047-kong:p039","text":"秋，季桓子病，輦而見魯城，喟然嘆曰：「昔此國幾興矣，以吾獲罪於孔子，故不興也。」顧謂其嗣康子曰：「我即死，若必相魯；相魯，必召仲尼。」後數日，桓子卒，康子代立。已葬，欲召仲尼。公之魚曰：「昔吾先君用之不終，終為諸侯笑。今又用之，不能終，是再為諸侯笑。」康子曰：「則誰召而可？」曰：「必召冉求。」於是使使召冉求。冉求將行，孔子曰：「魯人召求，非小用之，將大用之也。」是日，孔子曰：「歸乎歸乎！吾黨之小子狂簡，斐然成章，吾不知所以裁之。」子貢知孔子思歸，送冉求，因誡曰「即用，以孔子為招」云。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-047-kong:m039-0002","start":2,"end":5,"surface":"季桓子","kind":"person","person_id":"cbr-p002843","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0031","start":31,"end":33,"surface":"孔子","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0042","start":42,"end":44,"surface":"其嗣","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、神怪、對話、廟稱合稱或親屬指代待核，不補姓名、成員及闕代。"},{"id":"c-shiji-047-kong:m039-0044","start":44,"end":46,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0063","start":63,"end":65,"surface":"仲尼","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0071","start":71,"end":73,"surface":"桓子","kind":"person","person_id":"cbr-p002843","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0075","start":75,"end":77,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0085","start":85,"end":87,"surface":"仲尼","kind":"person","person_id":"cbr-p002851","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0088","start":88,"end":91,"surface":"公之魚","kind":"person","person_id":"cbr-p002892","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0126","start":126,"end":128,"surface":"康子","kind":"person","person_id":"cbr-p002909","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0143","start":143,"end":145,"surface":"冉求","kind":"person","person_id":"cbr-p002910","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0152","start":152,"end":154,"surface":"冉求","kind":"person","person_id":"cbr-p002910","status":"contextual_provisional"},{"id":"c-shiji-047-kong:m039-0155","start":155,"end":157,"s