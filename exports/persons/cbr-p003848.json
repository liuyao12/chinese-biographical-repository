{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003848","identity_policy":"contextual_provisional","person_ids":["cbr-p003848"],"persons":[{"id":"cbr-p003848","label":"悼公（伍胥列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"悼公","mention_ids":["c-shiji-066-wu:m020-0018"]}],"evidence":[{"mention_id":"c-shiji-066-wu:m020-0018","chapter_id":"c-shiji-066-wu","paragraph_id":"c-shiji-066-wu:p020","quote":"悼公"}]}],"source_mention_summary":[{"source_id":"s-shiji-066-wu","work_id":"w-shiji","book_id":"b-shiji-066","chapter_id":"c-shiji-066-wu","mention_count":1,"mention_ids":["c-shiji-066-wu:m020-0018"],"paragraph_ids":["c-shiji-066-wu:p020"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-066-wu"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"family_paths":[],"mentions":[{"id":"c-shiji-066-wu:m020-0018","start":18,"end":20,"surface":"悼公","kind":"person","person_id":"cbr-p003848","status":"contextual_provisional","paragraph_id":"c-shiji-066-wu:p020","chapter_id":"c-shiji-066-wu"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-041","person_id":"cbr-p003848","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["悼公"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p020","quote":"吳王既誅伍子胥，遂伐齊。齊鮑氏殺其君悼公而立陽生。吳王欲討其賊，不勝而去。其後二年，吳王召魯衛之君會之橐皋。其明年，因北大會諸侯於黃池，以令周室。越王句踐襲殺吳太子，破吳兵。吳王聞之，乃歸，使使厚幣與越平。後九年，越王句踐遂滅吳，殺王夫差；而誅太宰嚭，以不忠於其君，而外受重賂，與己比周也。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-066-wu:p020","text":"吳王既誅伍子胥，遂伐齊。齊鮑氏殺其君悼公而立陽生。吳王欲討其賊，不勝而去。其後二年，吳王召魯衛之君會之橐皋。其明年，因北大會諸侯於黃池，以令周室。越王句踐襲殺吳太子，破吳兵。吳王聞之，乃歸，使使厚幣與越平。後九年，越王句踐遂滅吳，殺王夫差；而誅太宰嚭，以不忠於其君，而外受重賂，與己比周也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m020-0000","start":0,"end":2,"surface":"吳王","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m020-0004","start":4,"end":7,"surface":"伍子胥","kind":"person","person_id":"cbr-p003808","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m020-0012","start":12,"end":15,"surface":"齊鮑氏","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m020-0018","start":18,"end":20,"surface":"悼公","kind":"person","person_id":"cbr-p003848","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m020-0022","start":22,"end":24,"surface":"陽生","kind":"person","person_id":"cbr-p003849","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m020-0025","start":25,"end":27,"surface":"吳王","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m020-0042","start":42,"end":44,"surface":"吳王","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m020-0045","start":45,"end":49,"surface":"魯衛之君","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m020-0062","start":62,"end":64,"surface":"諸侯","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名及成員；鮑氏不直接等同鮑牧。"},{"id":"c-shiji-066-wu:m020-0073","start":73,"end":77,"surface":"越王句踐","kind":"person","person_id":"cbr-p003842","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m020-0079","start":79,"end":82,"surface":"吳太子","kind":"person","person_id":"cbr-p003850","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m020-0087","start":87,"end":89,"surface":"吳王","kind":"person","person_id":"cbr-p003840","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m