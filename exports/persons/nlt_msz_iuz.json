tions":[{"id":"c-shiji-095-fankuang:m012-0043","start":40,"end":43,"surface":"雍將軍","kind":"person","person_id":"nlt_msz_iuz","status":"contextual_provisional","note":"焉氏依古注及漢書平行段為地名；本處標雍將軍，未詳姓名，不由地名補姓名。","paragraph_id":"c-shiji-095-fankuang:p012","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[{"id":"th-shiji095-102","person_id":"nlt_msz_iuz","title":"雍將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p012","quote":"項羽滅秦，立沛公為漢王。漢王賜商爵信成君，以將軍為隴西都尉。別將定北地、上郡。破雍將軍焉氏，周類軍栒邑，蘇駔軍於泥陽。賜食邑武成六千戶。以隴西都尉從擊項籍軍五月，出鉅野，與鐘離眛戰，疾鬬，受梁相國印，益食邑四千戶。以梁相國將從擊項羽二歲三月，攻胡陵。"}],"attestations":[{"id":"th-shiji095-102:a001","paragraph_id":"c-shiji-095-fankuang:p012","start":40,"end":43,"surface":"雍將軍","person_mention_id":"c-shiji-095-fankuang:m012-0043","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"僅記本處用稱；未知姓名、授職日期、離任及尊稱起訖不補。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-059","person_id":"nlt_msz_iuz","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["雍將軍"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p012","quote":"項羽滅秦，立沛公為漢王。漢王賜商爵信成君，以將軍為隴西都尉。別將定北地、上郡。破雍將軍焉氏，周類軍栒邑，蘇駔軍於泥陽。賜食邑武成六千戶。以隴西都尉從擊項籍軍五月，出鉅野，與鐘離眛戰，疾鬬，受梁相國印，益食邑四千戶。以梁相國將從擊項羽二歲三月，攻胡陵。"}],"rationale":"焉氏據《索隱》縣名及《漢書》破章邯別將於烏氏的平行句辨為地名；將人物錨點移至雍將軍，保留未名對手候選，不補姓名，也不校改正文焉氏為烏氏。","references":[{"title":"《史記索隱·樊酈滕灌列傳》焉氏注","url":"https://zh.wikisource.org/w/index.php?title=史記三家註/卷095&oldid=2514765","quote":"上音於然反，下音支。縣名，屬安定。《漢書》云破章邯別將。","status":"reported_not_collated","image_verified":false},{"title":"《漢書·樊酈滕灌傅靳周傳》酈商段","url":"https://zh.wikisource.org/w/index.php?title=漢書/卷041&oldid=2342290","quote":"別定北地郡，破章邯別將於烏氏、栒邑、泥陽，賜食邑武城六千戶。","status":"text_checked","image_verified":false}],"human_reviewed":false,"model":null}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p012","text":"項羽滅秦，立沛公為漢王。漢王賜商爵信成君，以將軍為隴西都尉。別將定北地、上郡。破雍將軍焉氏，周類軍栒邑，蘇駔軍於泥陽。賜食邑武成六千戶。以隴西都尉從擊項籍軍五月，出鉅野，與鐘離眛戰，疾鬬，受梁相國印，益食邑四千戶。以梁相國將從擊項羽二歲三月，攻胡陵。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m012-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m012-0006","start":6,"end":8,"surface":"沛公","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m012-0009","start":9,"end":11,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m012-0012","start":12,"end":14,"surface":"漢王","kind":"person","person_id":"yqp_nlb_p1p_A","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m012-0015","start":15,"end":16,"surface":"商","kind":"person","person_id":"xny_prn_zyi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m012-0043","start":40,"end":43,"surface":"雍將軍","kind":"person","person_id":"nlt_msz_iuz","status":"contextual_provisional","note":"焉氏依古注及漢書平行段為地名；本處標雍將軍，未詳姓名，不由地名補姓名。"},{"id":"c-shiji-095-fankuang:m012-0046","start":46,"end":48,"surface":"周類","kind":"person","person_id":"cjo_gf9_e2j","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m012-0052","start":52,"end":54,"surface":"蘇駔","kind":"person","person_id":"ln0_7gp_jh7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m012-0075","start":75,"end":77,"surface":"項籍","kind":"person","person_id":"ob7_g6i_7pp","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m012-0086","start":86,"end":89,"surface":"鐘離眛","kind