-ws1557685"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin056-volume-sun-tong-father","subject_person_id":"jt6_wrb_iv0","object_person_id":"jr4_rog_dnq","predicate":"father","qualifiers":{"source_term":"纂子統、綽"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-056","chapter_id":"c-jinshu-056-sun-chu","source_id":"s-jinshu-056-sun-chu-ws1557685","paragraph_id":"c-jinshu-056-sun-chu:p011","quote":"三子：眾、洵、纂。眾及洵俱未仕而早終，惟纂子統、綽並知名。","subject_person_mention_id":"c-jinshu-056-sun-chu:p011:m0022","object_person_mention_id":"c-jinshu-056-sun-chu:p011:m0007"}],"status":"source_attested","interpretation_note":"本段明言統為纂子。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-jin056-volume-sun-teng-father","subject_person_id":"22x_o5h_te6","object_person_id":"jt6_wrb_iv0","predicate":"father","qualifiers":{"source_term":"子騰嗣"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-056","chapter_id":"c-jinshu-056-sun-tong","source_id":"s-jinshu-056-sun-tong-ws1557685","paragraph_id":"c-jinshu-056-sun-tong:p001","quote":"統字承公。幼與綽及從弟盛過江。誕任不羈，而善屬文，時人以為有楚風。征北將軍褚裒聞其名，命為參軍，辭不就，家於會稽。性好山水，乃求為鄞令，轉在吳寧。居職不留心碎務，縱意遊肆，名山勝川，靡不窮究。後為余姚令，卒。子騰嗣，以博學著稱，位至廷尉。騰弟登，少善名理，注《老子》，行於世，仕至尚書郎，早終。","subject_person_mention_id":"c-jinshu-056-sun-tong:p001:m0105","object_person_mention_id":"c-jinshu-056-sun-tong:p001:m0000"}],"status":"source_attested","interpretation_note":"孫統下文以子騰承嗣。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-jinshu-056-appraisal:p001:m0198","surface":"統","start":198,"end":199,"person_id":"jt6_wrb_iv0","kind":"person","status":"contextual_provisional","paragraph_id":"c-jinshu-056-appraisal:p001","chapter_id":"c-jinshu-056-appraisal"},{"id":"c-jinshu-056-sun-chu:p011:m0022","surface":"統","start":22,"end":23,"person_id":"jt6_