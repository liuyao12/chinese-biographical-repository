d":false}],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-056-appraisal:p001","text":"史臣曰：江統風檢操行，良有可稱，陳留多士，斯為其冠。《徙戎》之論，實乃經國遠圖。然運距中衰，陵替有漸，假其言見用，恐速禍招怨，無救於將顛也。逮湣懷廢徙，冒禁拜辭，所謂命輕鴻毛，義貴熊掌。虨位隆端石，竭誠獻替。惇遺忽榮利，聿修天爵。雖出處異途，俱難兄弟矣。孫楚體英絢之姿，超然出類，見知武子，誠無愧色。覽其貽皓之書，諒曩代之佳筆也。而負才誕傲，蔑苞忿奕，違遜讓之道，肆陵憤之氣，丁年沈廢，諒自取矣。統、綽棣華秀髮，名顯中興，可謂無忝爾祖。統竟淪跡下邑，窮觀勝地，會其心焉。綽獻直論辭，都不懾元子，有匪躬之節，豈徒文雅而已哉！","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":106,"last_line":106,"raw_start":9954,"raw_end":10217,"raw_character_offsets":[9956,9957,9958,9959,9960,9961,9962,9963,9964,9965,9966,9967,9968,9969,9970,9971,9972,9973,9974,9975,9976,9977,9978,9979,9980,9981,9982,9983,9984,9985,9986,9987,9988,9989,9990,9991,9992,9993,9994,9995,9996,9997,9998,9999,10000,10001,10002,10003,10004,10005,10006,10007,10008,10009,10010,10011,10012,10013,10014,10015,10016,10017,10018,10019,10020,10021,10022,10023,10024,10025,10026,10027,10028,10029,10030,10031,10032,10033,10034,10035,10036,10037,10038,10039,10040,10041,10042,10043,10044,10045,10046,10047,10048,10049,10050,10051,10052,10053,10054,10055,10056,10057,10058,10059,10060,10061,10062,10063,10064,10065,10066,10067,10068,10069,10070,10071,10072,10073,10074,10075,10076,10077,10078,10079,10080,10081,10082,10083,10084,10085,10086,10087,10088,10089,10090,10091,10092,10093,10094,10095,10096,10097,10098,10099,10100,10101,10102,10103,10104,10105,10106,10107,10108,10109,10110,10111,10112,10113,10114,10115,10116,10117,10118,10119,10120,10121,10122,10123,10124,10125,10126,10127,10128,10129,10130,10131,10132,10133,10134,10135,10136,10137,10138,10139,10140,10141,10142,10143,10144,10145,10146,10147,10148,10149,10150,10151,10152,10153,10154,10155,10156,10157,10158,10159,10160,10161,10162,10163,10164,10165,10166,10167,10168,10169,10170,10171,10172,10173,10174,10175,10176,1017