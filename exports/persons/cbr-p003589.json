595","status":"contextual_provisional"},{"id":"c-shiji-059-wuzong:m039-0066","start":66,"end":69,"surface":"仁賢者","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m039-0071","start":71,"end":72,"surface":"浡","kind":"unresolved","person_id":null,"status":"unresolved","note":"匿名者、群體、制度泛稱、未名皇帝或未定指代；不補未見姓名、親屬成員或確定身份。"},{"id":"c-shiji-059-wuzong:m039-0076","start":76,"end":78,"surface":"兒姁","kind":"person","person_id":"cbr-p003589","status":"contextual_provisional"}],"chapter_id":"c-shiji-059-wuzong","book_id":"b-shiji-059","work_id":"w-shiji","source_id":"s-shiji-059-wuzong"}],"sources":[{"chapter_id":"c-shiji-059-wuzong","work_id":"w-shiji","book_id":"b-shiji-059","source_id":"s-shiji-059-wuzong","source":{"title":"史記／卷059","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷059","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷059&oldid=2621125","revision_id":2621125,"accessed_on":"2026-10-09","extent":"38段篇文及1段索隱述贊。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白；保留河閒、閼于／閼於、取笔、皁、上（問）［聞］、棁、王後／王后、壖、卑溼、禔與浡等見證原字及符號。取笔中的笔為數位見證所見，不默改為其他版本。","note":"全39段已核讀並作明示人物首輪；未核底本、影像或現代研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
