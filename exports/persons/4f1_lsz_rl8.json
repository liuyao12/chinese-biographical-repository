:[{"source_id":"s-jinshu-040-ws2606035-jiachong-family","work_id":"w-jinshu","book_id":"b-jinshu-040","chapter_id":"c-jinshu-040-jiachong-family","raw_mention_count":2,"mention_ids":["c-jinshu-040-jiachong-family:p029:m0208","c-jinshu-040-jiachong-family:p029:m0210"],"paragraph_ids":["c-jinshu-040-jiachong-family:p029"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-jinshu-040-jiachong-family:p029:m0208","mention_ids":["c-jinshu-040-jiachong-family:p029:m0208"],"kind":"paragraph"},{"canonical_mention_id":"c-jinshu-040-jiachong-family:p029:m0210","mention_ids":["c-jinshu-040-jiachong-family:p029:m0210"],"kind":"paragraph"}],"mention_count":2,"duplicate_mention_count":0,"paragraph_occurrence_count":2,"table_occurrence_count":0,"passage_count":1,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"2處獨立位置，2個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-jinshu-040-ws2606035-jiachong-family"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_details":[{"id":"bd-jin040-jiachong-family-detail_233","person_id":"4f1_lsz_rl8","status":"source_attested","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-040","source_id":"s-jinshu-040-ws2606035-jiachong-family","chapter_id":"c-jinshu-040-jiachong-family","paragraph_id":"c-jinshu-040-jiachong-family:p029","quote":"是時賈后既豫朝政，欲委信親黨，拜模散騎常侍，二日擢爲侍中。模乃盡心匡弼，推張華、裴顗同心輔政。數年之中，朝野寧靜，模之力也。乃加授光祿大夫。然模潛執權勢，外形欲遠之，每有啟奏賈后事，入輒取急，或托疾以避之。至於素有嫌忿，多所中陷，朝廷甚憚之。加貪冒聚斂，富擬王公。但賈后性甚強暴，模每盡言爲陳禍福，後不能從，反謂模毀己。於是委任之情日衰，而讒間之徒遂進。模不得志，憂憤成疾。卒，追贈車騎將軍、開府儀同三司，諡曰成。子遊字彥將嗣，歷官太子侍講、員外散騎侍郎。","person_mention_id":"c-jinshu-040-jiachong-family:p029:m0208"}],"reviewer":"Co