nt":1,"mention_ids":["c-shiji-040-chu:m072-0028"],"paragraph_ids":["c-shiji-040-chu:p072"],"table_cell_ids":[],"passage_count":1},{"source_id":"s-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","chapter_id":"c-shiji-084-qujia","mention_count":1,"mention_ids":["c-shiji-084-qujia:m004-0153"],"paragraph_ids":["c-shiji-084-qujia:p004"],"table_cell_ids":[],"passage_count":1},{"source_id":"table-witness-shiji-015","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","mention_count":1,"mention_ids":["shiji-015-r165-c06-m007"],"paragraph_ids":[],"table_cell_ids":["shiji-015-r165-c06"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-070-zhang"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"life_events":[{"id":"le-shiji070-002","person_id":"c38_dzq_0o4","event_type":"death","status":"source_attested","date_expression":null,"source_term":"殺屈丐","evidence":[{"chapter_id":"c-shiji-070-zhang","source_id":"s-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p022","quote":"張儀至秦，詳失綏墮車，不朝三月。楚王聞之，曰：「儀以寡人絕齊未甚邪？」乃使勇士至宋，借宋之符，北罵齊王。齊王大怒，折節而下秦。秦齊之交合，張儀乃朝，謂楚使者曰：「臣有奉邑六里，願以獻大王左右。」楚使者曰：「臣受令於王，以商於之地六百里，不聞六里。」還報楚王，楚王大怒，發兵而攻秦。陳軫曰：「軫可發口言乎？攻之不如割地反以賂秦，與之并兵而攻齊，是我出地於秦，取償於齊也，王國尚可存。」楚王不聽，卒發兵而使將軍屈丐擊秦。秦齊共攻楚，斬首八萬，殺屈丐，遂取丹陽、漢中之地。楚又復益發兵而襲秦，至藍田，大戰，楚大敗，於是楚割兩城以與秦平。","person_mention_id":"c-shiji-070-zhang:m022-0203"}],"interpretation_note":"本篇明示殺屈丐；〈秦本紀〉相同丹陽事件作虜其將屈丐，既有跨ID同指是人物判讀，不解決殺／虜事件差異。來源主張與相反記載均保留，未宣稱死亡已獨立確證。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"mentions":[{"id":"c-shiji-005-qin:m066-0255","start":255,"end":257,"surface":"屈丐","kind":"person","person_id":"c38_dzq_0o4","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p066","chapter_id":"c-shiji-005-qin"},{"id":"c-shiji-040-chu:m072-0028","start":28,"end":30,"surface":"屈匄","kind":"person","person_id":"c38_dzq_0o4","status":"contextual_provisional","paragraph_id":"c-shiji-040-chu:p072","chapter_id":"c-shiji-040-chu"},{"id":"c-shiji-070-zhang:m022-0203","start":203,"end":205,"surface":"屈丐","kind":"person","person_id":"c38_dzq_0o4","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p022","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-070-zhang:m022-0220","start":220,"end":222,"surface":"屈丐","kind":"person","person_id":"c38_dzq_0o4","status":"contextual_provisional","paragraph_id":"c-shiji-070-zhang:p022","chapter_id":"c-shiji-070-zhang"},{"id":"c-shiji-084-qujia:m004-0153","start":153,"end":157,"surface":"楚將屈丐","kind":"person","person_id":"c38_dzq_0o4","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p004","chapter_id":"c-shiji-084-qujia"}],"relations":[],"title_holdings":[{"id":"th-shiji040-028","person_id":"c38_dzq_0o4","title":"大將軍","kind":"office","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p072","quote":"十七年春，與秦戰丹陽，秦大敗我軍，斬甲士八萬，虜我大將軍屈匄、裨將軍逢侯丑等七十餘人，遂取漢中之郡。楚懷王大怒，乃悉國兵復襲秦，戰於藍田，大敗楚軍。韓、魏聞楚之困，乃南襲楚，至於鄧。楚聞，乃引兵歸。"}],"attestations":[{"id":"th-shiji040-028:a001","paragraph_id":"c-shiji-040-chu:p072","start":25,"end":28,"surface":"大將軍","person_mention_id":"c-shiji-040-chu:m072-0028","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存本段授位、任事或既有用稱；原紀年不換算，未知起訖不由首次提及、卒日、逃亡或被俘補造。追稱、制度含義與跨篇身份仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[{"id":"shiji-015-r165-c06-m007","start":7,"end":9,"surface":"屈饨","person_id":"c38_dzq_0o4","status":"contextual_provisional","interpretation_note":"依原格國別、紀年與同一受敗或死亡記事暫定對讀；保留原格姓名及用字。","identity_evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p066","quote":"十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬"}],"table_id":"shiji-015","table_fragment_id":"shiji-015-digital-table-1","table_row_id":"shiji-015-r165","table_cell_id":"shiji-015-r165-c06","work_id":"w-shiji","book_id":"b-shiji-015","chapter_id":"table-chapter-shiji-015","source_id":"table-witness-shiji-015","source_revision":"2607002","kind":"table_person_mention","quote":"十七。秦敗我將屈饨。"}],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji070-024","person_id":"c38_dzq_0o4","scope":"same_chapter","chapter_ids":["c-shiji-070-zhang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["屈丐"],"evidence":[{"paragraph_id":"c-shiji-070-zhang:p022","quote":"張儀至秦，詳失綏墮車，不朝三月。楚王聞之，曰：「儀以寡人絕齊未甚邪？」乃使勇士至宋，借宋之符，北罵齊王。齊王大怒，折節而下秦。秦齊之交合，張儀乃朝，謂楚使者曰：「臣有奉邑六里，願以獻大王左右。」楚使者曰：「臣受令於王，以商於之地六百里，不聞六里。」還報楚王，楚王大怒，發兵而攻秦。陳軫曰：「軫可發口言乎？攻之不如割地反以賂秦，與之并兵而攻齊，是我出地於秦，取償於齊也，王國尚可存。」楚王不聽，卒發兵而使將軍屈丐擊秦。秦齊共攻楚，斬首八萬，殺屈丐，遂取丹陽、漢中之地。楚又復益發兵而襲秦，至藍田，大戰，楚大敗，於是楚割兩城以與秦平。"}],"rationale":"按第1至23段局部明示姓名與引語判讀；魏襄王卒後哀王受話語境分開。楚懷王與秦惠王在出使鄭袖段分辨，不按最近名字或全域王字判讀。擬議秦女、美人與子母不補姓名或婚姻；未名齊王不按年代記憶定名，異稱、史實及時序仍待覆核。"},{"id":"d-shiji084-010","person_id":"c38_dzq_0o4","surfaces":["楚將屈丐"],"scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-084-qujia:p004","quote":"屈平既絀，其後秦欲伐齊。齊與楚從親，惠王患之。乃令張儀詳去秦，厚幣委質事楚，曰：「秦甚憎齊，齊與楚從親。楚誠能絕齊，秦願獻商、於之地六百里。」楚懷王貪而信張儀，遂絕齊，使使如秦受地。張儀詐之曰：「儀與王約六里，不聞六百里。」楚使怒去，歸告懷王。懷王怒，大興師伐秦。秦發兵擊之，大破楚師於丹、淅，斬首八萬，虜楚將屈丐，遂取楚之漢中地。懷王乃悉發國中兵以深入擊秦，戰於藍田。魏聞之，襲楚至鄧。楚兵懼，自秦歸。而齊竟怒不救楚，楚大困。"}],"rationale":"依前5段明示屈原名平、屈平與懷王張儀敘事暫接；湯武短稱各存，未補姓名。王、臣、吾等嵌套指代仍待逐處核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji070-qu","person_ids":["c38_dzq_0o4"],"canonical_person_id":"c38_dzq_0o4","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-070-zhang"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p066","quote":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","mention_ids":["c-shiji-005-qin:m066-0255"]},{"chapter_id":"c-shiji-070-zhang","source_id":"s-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p022","quote":"張儀至秦，詳失綏墮車，不朝三月。楚王聞之，曰：「儀以寡人絕齊未甚邪？」乃使勇士至宋，借宋之符，北罵齊王。齊王大怒，折節而下秦。秦齊之交合，張儀乃朝，謂楚使者曰：「臣有奉邑六里，願以獻大王左右。」楚使者曰：「臣受令於王，以商於之地六百里，不聞六里。」還報楚王，楚王大怒，發兵而攻秦。陳軫曰：「軫可發口言乎？攻之不如割地反以賂秦，與之并兵而攻齊，是我出地於秦，取償於齊也，王國尚可存。」楚王不聽，卒發兵而使將軍屈丐擊秦。秦齊共攻楚，斬首八萬，殺屈丐，遂取丹陽、漢中之地。楚又復益發兵而襲秦，至藍田，大戰，楚大敗，於是楚割兩城以與秦平。","mention_ids":["c-shiji-070-zhang:m022-0203","c-shiji-070-zhang:m022-0220"]}],"rationale":"兩篇均載楚將屈丐、丹陽漢中之役及斬首八萬，人物與事件相配；秦本紀虜而本篇殺的差異保留，不確證死亡。 各篇原文與已發ID保留；同書篇章不當獨立見證。同指不確證年代、任職、人物傳說或所有敘事，版本仍待覆核。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true},{"id":"eq-shiji084-qugai","person_ids":["c38_dzq_0o4"],"canonical_person_id":"c38_dzq_0o4","scope":"cross_chapter","chapter_ids":["c-shiji-005-qin","c-shiji-040-chu","c-shiji-070-zhang","c-shiji-084-qujia"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-005-qin","source_id":"s-shiji-005-qin","paragraph_id":"c-shiji-005-qin:p066","quote":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","mention_ids":["c-shiji-005-qin:m066-0255"]},{"chapter_id":"c-shiji-040-chu","source_id":"s-shiji-040-chu","paragraph_id":"c-shiji-040-chu:p072","quote":"十七年春，與秦戰丹陽，秦大敗我軍，斬甲士八萬，虜我大將軍屈匄、裨將軍逢侯丑等七十餘人，遂取漢中之郡。楚懷王大怒，乃悉國兵復襲秦，戰於藍田，大敗楚軍。韓、魏聞楚之困，乃南襲楚，至於鄧。楚聞，乃引兵歸。","mention_ids":["c-shiji-040-chu:m072-0028"]},{"chapter_id":"c-shiji-070-zhang","source_id":"s-shiji-070-zhang","paragraph_id":"c-shiji-070-zhang:p022","quote":"張儀至秦，詳失綏墮車，不朝三月。楚王聞之，曰：「儀以寡人絕齊未甚邪？」乃使勇士至宋，借宋之符，北罵齊王。齊王大怒，折節而下秦。秦齊之交合，張儀乃朝，謂楚使者曰：「臣有奉邑六里，願以獻大王左右。」楚使者曰：「臣受令於王，以商於之地六百里，不聞六里。」還報楚王，楚王大怒，發兵而攻秦。陳軫曰：「軫可發口言乎？攻之不如割地反以賂秦，與之并兵而攻齊，是我出地於秦，取償於齊也，王國尚可存。」楚王不聽，卒發兵而使將軍屈丐擊秦。秦齊共攻楚，斬首八萬，殺屈丐，遂取丹陽、漢中之地。楚又復益發兵而襲秦，至藍田，大戰，楚大敗，於是楚割兩城以與秦平。","mention_ids":["c-shiji-070-zhang:m022-0203","c-shiji-070-zhang:m022-0220"]},{"chapter_id":"c-shiji-084-qujia","source_id":"s-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p004","quote":"屈平既絀，其後秦欲伐齊。齊與楚從親，惠王患之。乃令張儀詳去秦，厚幣委質事楚，曰：「秦甚憎齊，齊與楚從親。楚誠能絕齊，秦願獻商、於之地六百里。」楚懷王貪而信張儀，遂絕齊，使使如秦受地。張儀詐之曰：「儀與王約六里，不聞六百里。」楚使怒去，歸告懷王。懷王怒，大興師伐秦。秦發兵擊之，大破楚師於丹、淅，斬首八萬，虜楚將屈丐，遂取楚之漢中地。懷王乃悉發國中兵以深入擊秦，戰於藍田。魏聞之，襲楚至鄧。楚兵懼，自秦歸。而齊竟怒不救楚，楚大困。","mention_ids":["c-shiji-084-qujia:m004-0153"]}],"rationale":"秦楚丹陽之戰、八萬斬首與取漢中的具體戰事相配，暫接楚將屈丐與屈匄。005、040及084作虜，070作殺，各篇原字與事件保存，不據同指判定唯一死因或死亡時點，不補屈原親屬。同書平行敘事不是獨立史實見證，未核版本影像。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null,"identity_materialized":true}],"passages":[{"id":"c-shiji-005-qin:p066","text":"十四年，更為元年。二年，張儀與齊、楚大臣會齧桑。三年，韓、魏太子來朝。張儀相魏。五年，王游至北河。七年，樂池相秦。韓、趙、魏、燕、齊帥匈奴共攻秦。秦使庶長疾與戰修魚，虜其將申差，敗趙公子渴、韓太子奐，斬首八萬二千。八年，張儀復相秦。九年，司馬錯伐蜀，滅之。伐取趙中都、西陽十年，韓太子蒼來質。伐取韓石章。伐敗趙將泥。伐取義渠二十五城。十一年，摢裏疾攻魏焦，降之。敗韓岸門，斬首萬，其將犀首走。公子通封於蜀。燕君讓其臣子之。十二年，王與梁王會臨晉。庶長疾攻趙，虜趙將莊。張儀相楚。十三年，庶長章擊楚於丹陽，虜其將屈丐，斬首八萬；又攻楚漢中，取地六百里，置漢中郡。楚圍雍氏，秦使庶長疾助韓而東攻齊，到滿助魏攻燕。十四年，伐楚，取召陵。丹、犁臣，蜀相壯殺蜀侯來降。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m066-0012","start":12,"end":14,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m066-0027","start":27,"end":32,"surface":"韓、魏太子","kind