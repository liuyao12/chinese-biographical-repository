d":35,"surface":"滿奮","kind":"person","person_id":"m2r_kh3_98l","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-043-leguang:line154","chapter_id":"c-jinshu-043-leguang"},{"id":"c-jinshu-044-luzhi:line060:m0325","start":325,"end":327,"surface":"滿奮","kind":"person","person_id":"m2r_kh3_98l","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-044-luzhi:line060","chapter_id":"c-jinshu-044-luzhi"},{"id":"c-jinshu-061-zhou-family:p021:m0074","start":74,"end":76,"surface":"滿奮","kind":"person","person_id":"m2r_kh3_98l","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p021","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-061-zhou-family:p021:m0090","start":90,"end":91,"surface":"奮","kind":"person","person_id":"m2r_kh3_98l","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。","paragraph_id":"c-jinshu-061-zhou-family:p021","chapter_id":"c-jinshu-061-zhou-family"},{"id":"c-jinshu-067-xijian:line074:m0128","start":128,"end":131,"surface":"滿武秋","kind":"person","person_id":"m2r_kh3_98l","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line074","chapter_id":"c-jinshu-067-xijian"},{"id":"c-jinshu-067-xijian:line074:m0185","start":185,"end":187,"surface":"武秋","kind":"person","person_id":"m2r_kh3_98l","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-jinshu-067-xijian:line074","chapter_id":"c-jinshu-067-xijian"}],"relations":[],"title_holdings":[{"id":"th-w043-le-main-10","person_id":"m2r_kh3_98l","title":"司隸校尉","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-043","chapter_id":"c-jinshu-043-leguang","source_id":"s-jinshu-043-leguang","paragraph_id":"c-jinshu-043-leguang:line154","quote":"湣懷太子之廢也，詔故臣不得辭送，眾官不勝憤歎，皆冒禁拜辭。司隸校尉滿奮敕河南中部收縛拜者送獄，廣即便解遣。眾人代廣危懼。孫琰說賈謐曰：「前以太子罪惡，有斯廢黜，其臣不懼嚴詔，冒罪而送。今若系之，是彰太子之善，不如釋去。」謐然其言，廣故得不坐。","person_mention_id":"c-jinshu-043-leguang:line154:m0033"}],"attestations":[{"id":"th-w043-le-main-10:a","paragraph_id":"c-jinshu-043-leguang:line154","start":29,"end":33,"surface":"司隸校尉","person_mention_id":"c-jinshu-043-leguang:line154:m0033","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本來源官稱或所任，未受另記。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null},{"id":"th-w044-luzhi-12","person_id":"m2r_kh3_98l","title":"司隸校尉","kind":"office","mode":"attestation","evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-044","chapter_id":"c-jinshu-044-luzhi","source_id":"s-jinshu-044-luzhi","paragraph_id":"c-jinshu-044-luzhi:line060","quote":"及乂死，穎表志為中書監，留鄴，參署相府事。乘與敗于蕩陰，穎遣志督兵迎帝。及王浚攻鄴，志勸穎奉天子還洛陽。時甲士尚萬五千人，志夜部分，至曉，眾皆成列，而程太妃戀鄴不欲去，穎未能決。俄而眾潰，唯志與子謐、兄子綝、殿中武賁千人而已，志復勸穎早發。時有道士姓黃，號曰聖人，太妃信之。及使呼人，道士求兩杯酒，飲訖，拋杯而去，於是志計始決。而人馬復散，志于營陣間尋索，得數乘鹿車，司馬督韓玄收集黃門，得百餘人。志入，帝問志曰：「何故散敗至此？」志曰：「賊去鄴尚八十里，而人士一朝駭散，太弟今欲奉陛下還洛陽。」帝曰：「甚佳。」於是禦犢車便發。屯騎校尉郝昌先領兵八千守洛陽，帝召之，至汲郡而昌至，兵仗甚盛。志喜於復振，啟天子宜下赦書，與百姓同其休慶。既達洛陽，志啟以滿奮為司隸校尉。奔散者多還，百官粗備，帝悅，賜志絹二百匹、綿百斤、衣一襲、鶴綾袍一領。","person_mention_id":"c-jinshu-044-luzhi:line060:m0325"}],"attestations":[{"id":"th-w043-luzhi-12:a","paragraph_id":"c-jinshu-044-luzhi:line060","start":328,"end":332,"surface":"司隸校尉","person_mention_id":"c-jinshu-044-luzhi:line060:m0325","usage":"narrative","date_expression":null}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"志啟以滿奮為司隸校尉。","status":"source_attested","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":