:115,"end":116,"surface":"廣","kind":"person","person_id":"591_360_8ca","status":"contextual_provisional","interpretation_note":"以來源原字標記。"}],"source_position":{"first_line":154,"last_line":154,"raw_start":12131,"raw_end":12254,"revision_id":2618531},"chapter_id":"c-jinshu-043-leguang","book_id":"b-jinshu-043","work_id":"w-jinshu","source_id":"s-jinshu-043-leguang"},{"id":"c-jinshu-044-luzhi:line060","text":"及乂死，穎表志為中書監，留鄴，參署相府事。乘與敗于蕩陰，穎遣志督兵迎帝。及王浚攻鄴，志勸穎奉天子還洛陽。時甲士尚萬五千人，志夜部分，至曉，眾皆成列，而程太妃戀鄴不欲去，穎未能決。俄而眾潰，唯志與子謐、兄子綝、殿中武賁千人而已，志復勸穎早發。時有道士姓黃，號曰聖人，太妃信之。及使呼人，道士求兩杯酒，飲訖，拋杯而去，於是志計始決。而人馬復散，志于營陣間尋索，得數乘鹿車，司馬督韓玄收集黃門，得百餘人。志入，帝問志曰：「何故散敗至此？」志曰：「賊去鄴尚八十里，而人士一朝駭散，太弟今欲奉陛下還洛陽。」帝曰：「甚佳。」於是禦犢車便發。屯騎校尉郝昌先領兵八千守洛陽，帝召之，至汲郡而昌至，兵仗甚盛。志喜於復振，啟天子宜下赦書，與百姓同其休慶。既達洛陽，志啟以滿奮為司隸校尉。奔散者多還，百官粗備，帝悅，賜志絹二百匹、綿百斤、衣一襲、鶴綾袍一領。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-044-luzhi:line060:m0001","start":1,"end":2,"surface":"乂","kind":"person","person_id":"4c6_984_9ed","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line060:m0004","start":4,"end":5,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line060:m0006","start":6,"end":7,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line060:m0028","start":28,"end":29,"surface":"穎","kind":"person","person_id":"e81_f09_000","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line060:m0030","start":30,"end":31,"surface":"志","kind":"person","person_id":"m8n_ntm_79h_ABB","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line060:m0037","start":37,"end":39,"surface":"王浚","kind":"person","person_id":"9c1_ff0_1b5","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-jinshu-044-luzhi:line06