772-raw.wikitext"},"mentions":[{"id":"c-jinshu-061-zhou-family:p021:m0000","start":0,"end":2,"surface":"惠帝","kind":"person","person_id":"dkn_ge4_286_AAAAIAA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0005","start":5,"end":9,"surface":"成都王穎","kind":"person","person_id":"dkn_ge4_286_AAAAIAC","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0010","start":10,"end":11,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0016","start":16,"end":18,"surface":"陳眕","kind":"person","person_id":"p1n_kla_0x7","status":"contextual_provisional","interpretation_note":"兩固定數位見證同一清河王太子事件，姓氏相異，原字不改；暫不裁定名姓。"},{"id":"c-jinshu-061-zhou-family:p021:m0019","start":19,"end":22,"surface":"上官已","kind":"person","person_id":"j42_q6m_ymn","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0024","start":24,"end":28,"surface":"清河王覃","kind":"person","person_id":"dkn_ge4_286_AAAAIAFA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0033","start":33,"end":34,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0042","start":42,"end":43,"surface":"馥","kind":"person","person_id":"3xx_gdy_or6_BA","status":"contextual_provisional","interpretation_note":"076王廙元帝鎮江左、討周馥脈絡與本段相合；不是只從單字馥匹配韓馥。"},{"id":"c-jinshu-061-zhou-family:p021:m0047","start":47,"end":48,"surface":"覃","kind":"person","person_id":"dkn_ge4_286_AAAAIAFA","status":"contextual_provisional","interpretation_note":"本單元明見人物；尚未原生匯入。"},{"id":"c-jinshu-061-zhou-family:p021:m0049","start":49,"end":50,"surface":"馥","kind":"per