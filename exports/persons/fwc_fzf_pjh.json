on_note":"依本段敘事與具名角色讀作謝朓。"},{"start":4,"end":7,"surface":"王敬則","id":"c-nanshi-019-xietiao:p006:m0004","person_id":"7a0_95e_c4a","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作王敬則。"},{"start":9,"end":11,"surface":"敬則","id":"c-nanshi-019-xietiao:p006:m0009","person_id":"7a0_95e_c4a","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作王敬則。"},{"start":11,"end":12,"surface":"女","id":"c-nanshi-019-xietiao:p006:u0011","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"敬則之女即朓妻，未見個人名。"},{"start":13,"end":14,"surface":"朓","id":"c-nanshi-019-xietiao:p006:m0013","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝朓。"},{"start":14,"end":15,"surface":"妻","id":"c-nanshi-019-xietiao:p006:u0014","kind":"unresolved","person_id":null,"status":"unresolved","interpretation_note":"朓之妻即敬則之女；「寡妻」另為引語用語。"},{"start":21,"end":22,"surface":"朓","id":"c-nanshi-019-xietiao:p006:m0021","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝朓。"},{"start":23,"end":24,"surface":"朓","id":"c-nanshi-019-xietiao:p006:m0023","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝朓。"},{"start":43,"end":45,"surface":"範縝","id":"c-nanshi-019-xietiao:p006:m0043","person_id":"fwc_fzf_pjh","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作范縝。"},{"start":68,"end":69,"surface":"朓","id":"c-nanshi-019-xietiao:p006:m0068","person_id":"aa6_83c_juy_ABCBA","kind":"person","status":"contextual_provisional","interpretation_note":"依本段敘事與具名角色讀作謝朓。"}],"source_position":{"revision_id":1531762,"source_layer":"received_biography","raw_start":7090,"raw_end":7194,"raw_character_offsets":[7090,7091,7092,7093,7094,7095,7096,7097,7098,7099,7100,7101,7102,7103,7104,7105,7106,7107,7108,7109,7110,7111,7112,7113,7114,7115,7116,7117,7118,7119,7120,7121,7122,7123,7124,7125,7126,7127,7128,7129,7130,7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193],"projection_sha256":"2d032715274b2fa4c4e371b26d3234c9d8caccd6837a08279f72177d6f4e972f","first_line":134,"last_line":134,"editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-019-xietiao","book_id":"b-nanshi-019","work_id":"w-nanshi","source_id":"s-nanshi-019-xietiao-ws1531762"},{"id":"c-nanshi-023-wangliang:p007","text":"四年，帝宴華光殿，求讜言。尚書左丞范縝起曰：「司徒謝朏本有虛名，陛下擢之如此；前尚書令王亮頗有政體，陛下棄之如彼。愚臣所不知。」帝變色曰：「卿可更餘言。」縝固執不已，帝不悅。御史中丞任昉因奏縝妄陳褒貶，請免縝官。詔可。亮因屏居閉掃，不通賓客。遭母憂，居喪盡禮。後為中書監，加散騎常侍。卒，諡煬子。","mentions":[{"id":"c-nanshi-023-wangliang:p007:m0017","surface":"范縝","start":17,"end":19,"person_id":"fwc_fzf_pjh","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangliang:p007:m0025","surface":"謝朏","start":25,"end":27,"person_id":"aa6_83c_juy_DBABAB","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangliang:p007:m0043","surface":"王亮","start":43,"end":45,"person_id":"7r6_k52_qji_ABAACAABDA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangliang:p007:m0077","surface":"縝","start":77,"end":78,"person_id":"fwc_fzf_pjh","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangliang:p007:m0091","surface":"任昉","start":91,"end":93,"person_id":"tvc_q3c_t7w","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangliang:p007:m0095","surface":"縝","start":95,"end":96,"person_id":"fwc_fzf_pjh","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangliang:p007:m0103","surface":"縝","start":103,"end":104,"person_id":"fwc_fzf_pjh","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangliang:p007:m0109","surface":"亮","start":109,"end":110,"person_id":"7r6_k52_qji_ABAACAABDA","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"},{"id":"c-nanshi-023-wangliang:p007:m0122","surface":"母","start":122,"end":123,"person_id":"mp1_n0s_rk5","kind":"person","status":"contextual_provisional","interpretation_note":"按本傳及官府原句。"}],"text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"revision_id":2478204,"source_layer":"received_biography","first_line":48,"last_line":48,"line_start":0,"line_end":148,"raw_start":3604,"raw_end":3752,"raw_character_offsets":[3604,3605,3606,3607,3608,3609,3610,3611,3612,3613,3614,3615,3616,3617,3618,3619,3620,3621,3622,3623,3624,3625,3626,3627,3628,3629,3630,3631,3632,3633,3634,3635,3636,3637,3638,3639,3640,3641,3642,3643,3644,3645,3646,3647,3648,3649,3650,3651,3652,3653,3654,3655,3656,3657,3658,3659,3660,3661,3662,3663,3664,3665,3666,3667,3668,3669,3670,3671,3672,3673,3674,3675,3676,3677,3678,3679,3680,3681,3682,3683,3684,3685,3686,3687,3688,3689,3690,3691,3692,3693,3694,3695,3696,3697,3698,3699,3700,3701,3702,3703,3704,3705,3706,3707,3708,3709,3710,3711,3712,3713,3714,3715,3716,3717,3718,3719,3720,3721,3722,3723,3724,3725,3726,3727,3728,3729,3730,3731,3732,3733,3734,3735,3736,3737,3738,3739,3740,3741,3742,3743,3744,3745,3746,3747,3748,3749,3750,3751],"projection_sha256":"e57d38866b20eb07792a8df0c694d4423e98f1211f2f8a4e9a8010d21eddcbf8","editorial_excerpt_boundary":true},"chapter_id":"c-nanshi-023-wangliang","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangliang-ws2478204"},{"text":"久之兼廷尉正，時三官通署獄，子野嘗不在，同僚輒署其名。奏有不允，子野從坐免職。或勸言請有司，可無咎，子野笑曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。中書郎範縝與子野未遇，聞其行業而善焉。會遷國子博士，乃上表讓之，有司以資歷非次，不為通。","source_position":{"start":10378,"end":10505,"raw":"久之兼廷尉正，時三官通署獄，子野嘗不在，同僚輒署其名。奏有不允，子野從坐免職。或勸言請有司，可無咎，子野笑曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。中書郎範縝與子野未遇，聞其行業而善焉。會遷國子博士，乃上表讓之，有司以資歷非次，不為通。","raw_path":"sources/nanshi/wikisource-1554233-raw.wikitext"},"id":"c-nanshi-033-pei-family:p016","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-nanshi-033-pei-family:p016:m0014","start":14,"end":16,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p016:m0024","start":24,"end":25,"surface":"其","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p016:m0032","start":32,"end":34,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p016:m0050","start":50,"end":52,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p016:m0058","start":58,"end":60,"surface":"柳季","kind":"person","person_id":"myy_zdg_6b6","status":"contextual_provisional","interpretation_note":"固定《論語註疏》卷15孔注明柳下惠展禽，疏並及柳下季；卷18士師三黜直道不枉之章對上子野兼廷尉正受代署牽連而免職、拒向有司申訟且終無恨意之完整語境。判同柳季，保原稱；不是依同名或單一候選自動配人。古注二十字五十字不作年齡資料。"},{"id":"c-nanshi-033-pei-family:p016:m0086","start":86,"end":88,"surface":"範縝","kind":"person","person_id":"fwc_fzf_pjh","status":"contextual_provisional","interpretation_note":"中書郎範縝未遇子野而聞行欲讓國子博士，梁030范縝同官同讓官事；範字不改。"},{"id":"c-nanshi-033-pei-family:p016:m0089","start":89,"end":91,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"},{"id":"c-nanshi-033-pei-family:p016:m0095","start":95,"end":96,"surface":"其","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"字幾原、父昭明、著宋略、掌國史及中大通卒，梁030同字、同家系、同著述與朝事。"}],"chapter_id":"c-nanshi-033-pei-family","book_id":"b-nanshi-033","work_id":"w-nanshi","source_id":"s-nanshi033-ws1554233"}],"sources":[{"chapter_id":"c-liangshu-030-peiziye","work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","source":{"title":"梁書/卷30","revision_id":1508510,"revision_timestamp":"2018-10-23T11:04:54Z","status":200,"response_sha256":"a0c2fde0d659c9579a74194db70540c89ea4ff8160f8761aecdeeeec25530db4","raw_sha256":"930b640ef553931a6d0f2c2b8c548fbd69e0f0db12dd6637222764518d1b871f","url":"https://zh.wikisource.org/w/index.php?title=%E6%A2%81%E6%9B%B8%2F%E5%8D%B730&oldid=1508510","api_url":"https://zh.wikisource.org/w/api.php?action=query&format=json&formatversion=2&prop=revisions&rvprop=ids%7Ctimestamp%7Ccontent&rvslots=main&titles=%E6%A2%81%E6%9B%B8%2F%E5%8D%B730","image_verified":false,"human_reviewed":false,"provider":"Wikisource","permalink":"https://zh.wikisource.org/w/index.php?title=%E6%A2%81%E6%9B%B8%2F%E5%8D%B730&oldid=1508510","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext","raw_file_sha256":"930b640ef553931a6d0f2c2b8c548fbd69e0f0db12dd6637222764518d1b871f","edition":null,"accessed_on":"2026-10-20","text_scope":"partial_chapter","review_status":"text_checked","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"description":"原字不轉換；僅移除明示wiki wrapper與排版空白，逐碼projection另存；未影像校勘。","omitted_digital_paratext":[]},"extent":"裴子野完整本傳8段1836字，止於顧協傳前；不是卷三十全卷。"}},{"chapter_id":"c-nanshi-019-xietiao","work_id":"w-nanshi","book_id":"b-nanshi-019","source_id":"s-nanshi-019-xietiao-ws1531762","source":{"title":"南史卷十九·謝朓及子謨附敘","provider":"Wikisource","url":"https://zh.wikisource.org/w/index.php?title=南史/卷19&oldid=1531762","permalink":"https://zh.wikisource.org/w/index.php?title=南史/卷19&oldid=1531