rt":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-023","source_id":"s-nanshi-023-wangliang-ws2478204","chapter_id":"c-nanshi-023-wangliang","paragraph_id":"c-nanshi-023-wangliang:p007","quote":"四年，帝宴華光殿，求讜言。尚書左丞范縝起曰：「司徒謝朏本有虛名，陛下擢之如此；前尚書令王亮頗有政體，陛下棄之如彼。愚臣所不知。」帝變色曰：「卿可更餘言。」縝固執不已，帝不悅。御史中丞任昉因奏縝妄陳褒貶，請免縝官。詔可。亮因屏居閉掃，不通賓客。遭母憂，居喪盡禮。後為中書監，加散騎常侍。卒，諡煬子。","person_mention_id":"c-nanshi-023-wangliang:p007:m0017"}],"status":"source_attested","interpretation_note":"按本見證原職名及其所屬人。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"address_assertions":[],"person_references":[{"id":"c-nanshi-023-wangliang:p007:r0057","surface":"愚臣","start":57,"end":59,"person_id":"fwc_fzf_pjh","referent_role":"speaker_self","paragraph_id":"c-nanshi-023-wangliang:p007","quote":"四年，帝宴華光殿，求讜言。尚書左丞范縝起曰：「司徒謝朏本有虛名，陛下擢之如此；前尚書令王亮頗有政體，陛下棄之如彼。愚臣所不知。」帝變色曰：「卿可更餘言。」縝固執不已，帝不悅。御史中丞任昉因奏縝妄陳褒貶，請免縝官。詔可。亮因屏居閉掃，不通賓客。遭母憂，居喪盡禮。後為中書監，加散騎常侍。卒，諡煬子。","note":"依原段當事人、稱謂及發言層。","chapter_id":"c-nanshi-023-wangliang","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangliang-ws2478204"},{"id":"c-nanshi-023-wangliang:p007:r0070","surface":"卿","start":70,"end":71,"person_id":"fwc_fzf_pjh","referent_role":"addressee","paragraph_id":"c-nanshi-023-wangliang:p007","quote":"四年，帝宴華光殿，求讜言。尚書左丞范縝起曰：「司徒謝朏本有虛名，陛下擢之如此；前尚書令王亮頗有政體，陛下棄之如彼。愚臣所不知。」帝變色曰：「卿可更餘言。」縝固執不已，帝不悅。御史中丞任昉因奏縝妄陳褒貶，請免縝官。詔可。亮因屏居閉掃，不通賓客。遭母憂，居喪盡禮。後為中書監，加散騎常侍。卒，諡煬子。","note":"依原段當事人、稱謂及發言層。","chapter_id":"c-nanshi-023-wangliang","book_id":"b-nanshi-023","work_id":"w-nanshi","source_id":"s-nanshi-023-wangliang-ws2478204"}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-liang030-fanzhen","person_id":"fwc_fzf_pjh","surfaces":["范縝","臣"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-liangshu-030-peiziye:p003:m0030","c-liangshu-030-peiziye:p003:m0288","c-liangshu-030-peiziye:p003:m0325","c-liangshu-030-peiziye:p003:m0358"]},"evidence":[{"work_id":"w-liangshu","book_id":"b-liangshu-030","source_id":"s-liang030-ws1508510","chapter_id":"c-liangshu-030-peiziye","paragraph_id":"c-liangshu-030-peiziye:p003","quote":"二年，吳平侯蕭景爲南兗州刺史，引爲冠軍錄事，府遷職解。時中書范縝與子野未遇，聞其行業而善焉。會遷國子博士，乃上表讓之曰：「伏見前冠軍府錄事參軍河東裴子野，年四十，字幾原，幼稟至人之行，長厲國士之風。居喪有禮，毀瘠幾滅，免憂之外，蔬水不進。棲遲下位，身賤名微，而性不憛憛，情無汲汲，是以有識嗟推，州閭嘆服。且家傳素業，世習儒史，苑囿經籍，遊息文藝。著《宋略》二十卷，彌綸首尾，勒成一代，屬辭比事，有足觀者。且章句洽悉，訓故可傳。脫置之膠庠，以弘獎後進，庶一夔之辯可尋，三豕之疑無謬矣。伏惟皇家淳耀，多士盈庭，官人邁乎有媯，棫朴越於姬氏，苟片善宜錄，無論厚薄，一介可求，不由等級。臣歷觀古今人君，欽賢好善，未有聖朝孜孜若是之至也。敢緣斯義，輕陳愚瞽，乞以臣斯忝，回授子野。如此，則賢否之宜，各全其所，訊之物議，誰曰不允。臣與子野雖未嘗銜杯，訪之邑裏，差非虛謬，不勝慺慺微見，冒昧陳聞。伏願陛下哀憐悾款，鑒其愚實，干犯之諐，乞垂赦宥。」有司以資歷非次，弗爲通。尋除尚書比部郎，仁威記室參軍。出爲諸暨令，在縣不行鞭罰，民有爭者，示之以理，百姓稱悅，合境無訟。"}],"rationale":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null},{"id":"d-nanshi033-范縝","person_id":"fwc_fzf_pjh","surfaces":["範縝"],"scope":"same_chapter","status":"contextual_provisional","confidence_level":"medium","identification_basis":{"kind":"source_context","target_mention_ids":["c-nanshi-033-pei-family:p016:m0086"]},"evidence":[{"work_id":"w-nanshi","book_id":"b-nanshi-033","chapter_id":"c-nanshi-033-pei-family","source_id":"s-nanshi033-ws1554233","paragraph_id":"c-nanshi-033-pei-family:p016","quote":"久之兼廷尉正，時三官通署獄，子野嘗不在，同僚輒署其名。奏有不允，子野從坐免職。或勸言請有司，可無咎，子野笑曰：「雖慚柳季之道，豈因訟以受服。」自此免黜久之，終無恨意。中書郎範縝與子野未遇，聞其行業而善焉。會遷國子博士，乃上表讓之，有司以資歷非次，不為通。"}],"rationale":"中書郎範縝未遇子野而聞行欲讓國子博士，梁030范縝同官同讓官事；範字不改。","human_reviewed":false,"reviewer":"Codex（AI代理）","model":null}],"equivalence_decisions":[],"passages":[{"id":"c-liangshu-030-peiziye:p003","text":"二年，吳平侯蕭景爲南兗州刺史，引爲冠軍錄事，府遷職解。時中書范縝與子野未遇，聞其行業而善焉。會遷國子博士，乃上表讓之曰：「伏見前冠軍府錄事參軍河東裴子野，年四十，字幾原，幼稟至人之行，長厲國士之風。居喪有禮，毀瘠幾滅，免憂之外，蔬水不進。棲遲下位，身賤名微，而性不憛憛，情無汲汲，是以有識嗟推，州閭嘆服。且家傳素業，世習儒史，苑囿經籍，遊息文藝。著《宋略》二十卷，彌綸首尾，勒成一代，屬辭比事，有足觀者。且章句洽悉，訓故可傳。脫置之膠庠，以弘獎後進，庶一夔之辯可尋，三豕之疑無謬矣。伏惟皇家淳耀，多士盈庭，官人邁乎有媯，棫朴越於姬氏，苟片善宜錄，無論厚薄，一介可求，不由等級。臣歷觀古今人君，欽賢好善，未有聖朝孜孜若是之至也。敢緣斯義，輕陳愚瞽，乞以臣斯忝，回授子野。如此，則賢否之宜，各全其所，訊之物議，誰曰不允。臣與子野雖未嘗銜杯，訪之邑裏，差非虛謬，不勝慺慺微見，冒昧陳聞。伏願陛下哀憐悾款，鑒其愚實，干犯之諐，乞垂赦宥。」有司以資歷非次，弗爲通。尋除尚書比部郎，仁威記室參軍。出爲諸暨令，在縣不行鞭罰，民有爭者，示之以理，百姓稱悅，合境無訟。","source_position":{"start":537,"end":1014,"raw":"　　二年，吳平侯蕭景爲南兗州刺史，引爲冠軍錄事，府遷職解。時中書范縝與子野未遇，聞其行業而善焉。會遷國子博士，乃上表讓之曰：「伏見前冠軍府錄事參軍河東裴子野，年四十，字幾原，幼稟至人之行，長厲國士之風。居喪有禮，毀瘠幾滅，免憂之外，蔬水不進。棲遲下位，身賤名微，而性不憛憛，情無汲汲，是以有識嗟推，州閭嘆服。且家傳素業，世習儒史，苑囿經籍，遊息文藝。著《宋略》二十卷，彌綸首尾，勒成一代，屬辭比事，有足觀者。且章句洽悉，訓故可傳。脫置之膠庠，以弘獎後進，庶一夔之辯可尋，三豕之疑無謬矣。伏惟皇家淳耀，多士盈庭，官人邁乎有媯，棫朴越於姬氏，苟片善宜錄，無論厚薄，一介可求，不由等級。臣歷觀古今人君，欽賢好善，未有聖朝孜孜若是之至也。敢緣斯義，輕陳愚瞽，乞以臣斯忝，回授子野。如此，則賢否之宜，各全其所，訊之物議，誰曰不允。臣與子野雖未嘗銜杯，訪之邑裏，差非虛謬，不勝慺慺微見，冒昧陳聞。伏願陛下哀憐悾款，鑒其愚實，干犯之諐，乞垂赦宥。」有司以資歷非次，弗爲通。尋除尚書比部郎，仁威記室參軍。出爲諸暨令，在縣不行鞭罰，民有爭者，示之以理，百姓稱悅，合境無訟。","raw_path":"sources/liangshu/wikisource-1508510-raw.wikitext"},"mentions":[{"id":"c-liangshu-030-peiziye:p003:m0006","start":6,"end":8,"surface":"蕭景","kind":"person","person_id":"mnv_izb_7w3","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p003:m0030","start":30,"end":32,"surface":"范縝","kind":"person","person_id":"fwc_fzf_pjh","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p003:m0033","start":33,"end":35,"surface":"子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p003:m0073","start":73,"end":76,"surface":"裴子野","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p003:m0082","start":82,"end":84,"surface":"幾原","kind":"person","person_id":"vpy_180_2oi_AAAAA","status":"contextual_provisional","interpretation_note":"主本明見人物；來源局部身份，此次分配來源局部ID，未宣稱跨史身份已全部覆核。"},{"id":"c-liangshu-030-peiziye:p003:m0227","start"