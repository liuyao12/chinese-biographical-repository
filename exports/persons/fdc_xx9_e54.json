sional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"name_components":[{"id":"name-jin098-zhouzha-literal","person_id":"fdc_xx9_e54","surname":"周","ming":"劄","hao":null,"title":null,"additional_names":[],"chapter_id":"c-jinshu-098-wangdun-comparison","paragraph_id":"c-jinshu-098-wangdun-comparison:p018","person_mention_id":"c-jinshu-098-wangdun-comparison:p018:m0035","source_anchor":{"start":35,"end":37,"surface":"周劄"},"quote":"敦至石頭，欲攻劉隗，其將杜弘曰：「劉隗死士眾多，未易可克，不如攻石頭。周劄少恩，兵不為用，攻之必敗。劄敗，則隗自走。」敦從之。劄果開城門納弘。諸將與敦戰，王師敗績。既入石頭，擁兵不朝，放肆兵士劫掠內外。官省奔散，惟有侍中二人侍帝。帝脫戎衣，著朝服，顧而言曰：「欲得我處，但當早道，我自還琅邪，何至困百姓如此！」敦收周顗、戴若思害之。以敦為丞相、江州牧，進爵武昌郡公，邑萬戶，使太常荀崧就拜，又加羽葆鼓吹，並偽讓不受。還屯武昌，多害忠良，寵樹親戚，以兄含為衛將軍、都督沔南軍事、領南蠻校尉、荊州刺史，以義陽太守任愔督河北諸軍事、南中郎將，敦又自督寧、益二州。","status":"source_attested","human_reviewed":false,"model":null,"work_id":"w-jinshu","book_id":"b-jinshu-098","source_id":"s-jinshu098-wangdun-ws2614273-comparison"}],"mentions":[{"id":"c-jinshu-098-wangdun-comparison:p018:m0035","start":35,"end":37,"surface":"周劄","person_id":"fdc_xx9_e54","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p018","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p018:m0050","start":50,"end":51,"surface":"劄","person_id":"fdc_xx9_e54","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p018","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p018:m0063","start":63,"end":64,"surface":"劄","person_id":"fdc_xx9_e54","kind":"person","paragraph_id":"c-jinshu-098-wangdun-comparison:p018","chapter_id":"c-jinshu-098-wangdun-comparison"},{"id":"c-jinshu-098-wangdun-comparison:p021:m0003","start":3,"end":5,"surface":"周劄","person_id":"fdc_xx9_e54","kind":"person"