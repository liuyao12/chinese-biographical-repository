urface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0367","start":367,"end":369,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:p031","text":"漢王之出滎陽，南走宛、葉，得九江王布，行收兵，復入保成皋。漢之四年，項王進兵圍成皋。漢王逃，獨與滕公出成皋北門，渡河走修武，從張耳、韓信軍。諸將稍稍得出成皋，從漢王。楚遂拔成皋，欲西。漢使兵距之鞏，令其不得西。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m031-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m031-0014","start":14,"end":18,"surface":"九江王布","kind":"person","person_id":"cbr-p000656","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m031-0034","start":34,"end":36,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m031-0042","start":42,"end":44,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m031-0048","start":48,"end":50,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m031-0063","start":63,"end":65,"surface":"張耳","kind":"person","person_id":"cbr-p000676","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m031-0066","start":66,"end":68,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m031-0070","start":70,"end":72,"surface":"諸將","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m031-0080","start":80,"end":82,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"}],"chapter_id":"c-shiji-007-xiangyu","book_id":"b-shiji-007","work_id":"w-shiji","source_id":"s-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:p043","text":"漢王跳，獨與滕公共車出成皋玉門，北渡河，馳宿修武。自稱使者，晨馳入張耳、韓信壁，而奪之軍。乃使張耳北益收兵趙地，使韓信東擊齊。漢王得韓信軍，則復振。引兵臨河，南饗軍小修武南，欲復戰。郎中鄭忠乃說止漢王，使高壘深塹，勿與戰。漢王聽其計，使盧綰、劉賈將卒二萬人，騎數百，渡白馬津，入楚地，與彭越復擊破楚軍燕郭西，遂復下梁地十餘城。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-008-gaozu:m043-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0006","start":6,"end":8,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0033","start":33,"end":35,"surface":"張耳","kind":"person","person_id":"cbr-p000676","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0036","start":36,"end":38,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0047","start":47,"end":49,"surface":"張耳","kind":"person","person_id":"cbr-p000676","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0057","start":57,"end":59,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0063","start":63,"end":65,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0066","start":66,"end":68,"surface":"韓信","kind":"person","person_id":"cbr-p000724","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0093","start":93,"end":95,"surface":"鄭忠","kind":"person","person_id":"cbr-p000726","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0098","start":98,"end":100,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0111","start":111,"end":113,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0118","start":118,"end":120,"surface":"盧綰","kind":"person","person_id":"cbr-p000780","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0121","start":121,"end":123,"surface":"劉賈","kind":"person","person_id":"cbr-p000727","status":"contextual_provisional"},{"id":"c-shiji-008-gaozu:m043-0143","start":143,"end":145,"surface":"彭越","kind":"person","person_id":"cbr-p000707","status":"contextual_provisional"}],"chapter_id":"c-shiji-008-gaozu","book_id":"b-shiji-008","work_id":"w-shiji","source_id":"s-shiji-008-gaozu"},{"id":"c-shiji-009-lvhou:p031","text":"東牟侯興居曰：「誅呂氏吾無功，請得除宮。」乃與太仆汝陰侯滕公入宮，前謂少帝曰：「足下非劉氏，不當立。」乃顧麾左右執戟者掊兵罷去。有數人不肯去兵，宦者令張澤諭告，亦去兵。滕公乃召乘輿車載少帝出。少帝曰：「欲將我安之乎？」滕公曰「出就舍。」舍少府。乃奉天子法駕，迎代王於邸。報曰：「宮謹除。」代王即夕入未央宮。有謁者十人持戟衛端門，曰：「天子在也，足下何為者而入？」代王乃謂太尉。太尉往諭，謁者十人皆掊兵而去。代王遂入而聽政。夜，有司分部誅滅梁、淮陽、常山王及少帝於邸。代王立為天子。二十三年崩，謚為孝文皇帝。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-009-lvhou:m031-0003","start":3,"end":5,"surface":"興居","kind":"person","person_id":"cbr-p000851","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0028","start":28,"end":30,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0035","start":35,"end":37,"surface":"少帝","kind":"person","person_id":"cbr-p000840","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0072","start":72,"end":75,"surface":"宦者令","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m031-0075","start":75,"end":77,"surface":"張澤","kind":"person","person_id":"cbr-p000878","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0084","start":84,"end":86,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0092","start":92,"end":94,"surface":"少帝","kind":"person","person_id":"cbr-p000840","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0096","start":96,"end":98,"surface":"少帝","kind":"person","person_id":"cbr-p000840","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0109","start":109,"end":111,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0130","start":130,"end":132,"surface":"代王","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0144","start":144,"end":146,"surface":"代王","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0154","start":154,"end":158,"surface":"謁者十人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m031-0167","start":167,"end":169,"surface":"天子","kind":"person","person_id":"cbr-p000840","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0181","start":181,"end":183,"surface":"代王","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0185","start":185,"end":187,"surface":"太尉","kind":"person","person_id":"cbr-p000805","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0188","start":188,"end":190,"surface":"太尉","kind":"person","person_id":"cbr-p000805","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0193","start":193,"end":197,"surface":"謁者十人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m031-0203","start":203,"end":205,"surface":"代王","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0219","start":219,"end":227,"surface":"梁、淮陽、常山王","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、匿名者或未定官稱；不補造姓名或把身世指控當定論。"},{"id":"c-shiji-009-lvhou:m031-0228","start":228,"end":230,"surface":"少帝","kind":"person","person_id":"cbr-p000840","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0233","start":233,"end":235,"surface":"代王","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"},{"id":"c-shiji-009-lvhou:m031-0248","start":248,"end":252,"surface":"孝文皇帝","kind":"person","person_id":"cbr-p000806","status":"contextual_provisional"}],"chapter_id":"c-shiji-009-lvhou","book_id":"b-shiji-009","work_id":"w-shiji","source_id":"s-shiji-009-lvhou"},{"id":"c-shiji-092-hanxin:p004","text":"及項梁渡淮，信杖劍從之，居戲下，無所知名。項梁敗，又屬項羽，羽以爲郎中。數以策干項羽，羽不用。漢王之入蜀，信亡楚歸漢，未得知名，爲連敖。坐法當斬，其輩十三人皆已斬，次至信，信乃仰視，適見滕公，曰：『上不欲就天下乎？何爲斬壯士！』滕公奇其言，壯其貌，釋而不斬。與語，大說之。言於上，上拜以爲治粟都尉，上未之奇也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m004-0001","start":1,"end":3,"surface":"項梁","kind":"person","person_id":"cbr-p005103","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0006","start":6,"end":7,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0021","start":21,"end":23,"surface":"項梁","kind":"person","person_id":"cbr-p005103","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0027","start":27,"end":29,"surface":"項羽","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0030","start":30,"end":31,"surface":"羽","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0040","start":40,"end":42,"surface":"項羽","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0043","start":43,"end":44,"surface":"羽","kind":"person","person_id":"cbr-p005104","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0047","start":47,"end":49,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0053","start":53,"end":54,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0073","start":73,"end":78,"surface":"其輩十三人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體或未定指代，不補姓名成員。"},{"id":"c-shiji-092-hanxin:m004-0084","start":84,"end":85,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0086","start":86,"end":87,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0093","start":93,"end":95,"surface":"滕公","kind":"person","person_id":"cbr-p005106","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0099","start":99,"end":100,"surface":"上","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0114","start":114,"end":116,"surface":"滕公","kind":"person","person_id":"cbr-p005106","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0138","start":138,"end":139,"surface":"上","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0140","start":140,"end":141,"surface":"上","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m004-0149","start":149,"end":150,"surface":"上","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"}],"chapter_id":"c-shiji-092-hanxin","book_id":"b-shiji-092","work_id":"w-shiji","source_id":"s-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:p013","text":"楚數使奇兵渡河擊趙，趙王耳、韓信往來救趙，因行定趙城邑，發兵詣漢。楚方急圍漢王於滎陽，漢王南出，之宛、葉閒，得黥布，走入成皋，楚又復急圍之。六月，漢王出成皋，東渡河，獨與滕公俱，從張耳軍修武。至，宿傳舍。晨自稱漢使，馳入趙壁。張耳、韓信未起，即其臥內上奪其印符，以麾召諸將，易置之。信、耳起，乃知漢王來，大驚。漢王奪兩人軍，即令張耳備守趙地。拜韓信爲相國，收趙兵未發者擊齊。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-092-hanxin:m013-0010","start":10,"end":13,"surface":"趙王耳","kind":"person","person_id":"cbr-p005115","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0014","start":14,"end":16,"surface":"韓信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0037","start":37,"end":39,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0043","start":43,"end":45,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0055","start":55,"end":57,"surface":"黥布","kind":"person","person_id":"cbr-p005125","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0073","start":73,"end":75,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0085","start":85,"end":87,"surface":"滕公","kind":"person","person_id":"cbr-p005106","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0090","start":90,"end":92,"surface":"張耳","kind":"person","person_id":"cbr-p005115","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0113","start":113,"end":115,"surface":"張耳","kind":"person","person_id":"cbr-p005115","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0116","start":116,"end":118,"surface":"韓信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0125","start":125,"end":126,"surface":"上","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0141","start":141,"end":142,"surface":"信","kind":"person","person_id":"cbr-p005099","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0148","start":148,"end":150,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0155","start":155,"end":157,"surface":"漢王","kind":"person","person_id":"cbr-p005105","status":"contextual_provisional"},{"id":"c-shiji-092-hanxin:m013-0164","start":1