c-shiji-007-xiangyu:m025-0291","start":291,"end":293,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p025","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-007-xiangyu:m031-0048","start":48,"end":50,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional","paragraph_id":"c-shiji-007-xiangyu:p031","chapter_id":"c-shiji-007-xiangyu"},{"id":"c-shiji-008-gaozu:m043-0006","start":6,"end":8,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional","paragraph_id":"c-shiji-008-gaozu:p043","chapter_id":"c-shiji-008-gaozu"},{"id":"c-shiji-009-lvhou:m031-0028","start":28,"end":30,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p031","chapter_id":"c-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:m031-0084","start":84,"end":86,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p031","chapter_id":"c-shiji-009-lvhou"},{"id":"c-shiji-009-lvhou:m031-0109","start":109,"end":111,"surface":"滕公","kind":"person","person_id":"cbr-p000715","status":"contextual_provisional","paragraph_id":"c-shiji-009-lvhou:p031","chapter_id":"c-shiji-009-lvhou"},{"id":"c-shiji-092-hanxin:m004-0093","start":93,"end":95,"surface":"滕公","kind":"person","person_id":"cbr-p005106","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p004","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m004-0114","start":114,"end":116,"surface":"滕公","kind":"person","person_id":"cbr-p005106","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p004","chapter_id":"c-shiji-092-hanxin"},{"id":"c-shiji-092-hanxin:m013-0085","start":85,"end":87,"surface":"滕公","kind":"person","person_id":"cbr-p005106","status":"contextual_provisional","paragraph_id":"c-shiji-092-hanxin:p013","chapter_id":"c-shiji-092-hanxin"}],"relations":[],"title_holdings":[],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji008-067","person_id":"cbr-p000715","surfaces":["滕公"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-008-gaozu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p025","quote":"春，漢王部五諸侯兵，凡五十六萬人，東伐楚。項王聞之，即令諸將擊齊，而自以精兵三萬人南從魯出胡陵。四月，漢皆已入彭城，收其貨寶美人，日置酒高會。項王乃西從蕭，晨擊漢軍而東，至彭城，日中，大破漢軍。漢軍皆走，相隨入穀、泗水，殺漢卒十餘萬人。漢卒皆南走山，楚又追擊至靈壁東睢水上。漢軍卻，為楚所擠，多殺，漢卒十餘萬人皆入睢水，睢水為之不流。圍漢王三匝。於是大風從西北而起，折木發屋，揚沙石，窈冥晝晦，逢迎楚軍。楚軍大亂，壞散，而漢王乃得與數十騎遁去，欲過沛，收家室而西；楚亦使人追之沛，取漢王家：家皆亡，不與漢王相見。漢王道逢得孝惠、魯元，乃載行。楚騎追漢王，漢王急，推墮孝惠、魯元車下，滕公常下收載之。如是者三。曰：「雖急不可以驅，柰何棄之？」於是遂得脫。求太公、呂后不相遇。審食其從太公、呂后閒行，求漢王，反遇楚軍。楚軍遂與歸，報項王，項王常置軍中。"},{"paragraph_id":"c-shiji-008-gaozu:p043","quote":"漢王跳，獨與滕公共車出成皋玉門，北渡河，馳宿修武。自稱使者，晨馳入張耳、韓信壁，而奪之軍。乃使張耳北益收兵趙地，使韓信東擊齊。漢王得韓信軍，則復振。引兵臨河，南饗軍小修武南，欲復戰。郎中鄭忠乃說止漢王，使高壘深塹，勿與戰。漢王聽其計，使盧綰、劉賈將卒二萬人，騎數百，渡白馬津，入楚地，與彭越復擊破楚軍燕郭西，遂復下梁地十餘城。"}],"rationale":"僅在所列漢初戰事、分封與家族敘事內暫定同指；前卷對讀須依相接事件，不據同名全域合併，仍待異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji009-036","person_id":"cbr-p000715","surfaces":["滕公"],"scope":"cross_chapter","chapter_ids":["c-shiji-007-xiangyu","c-shiji-009-lvhou"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-007-xiangyu:p025","quote":"春，漢王部五諸侯兵，凡五十六萬人，東伐楚。項王聞之，即令諸將擊齊，而自以精兵三萬人南從魯出胡陵。四月，漢皆已入彭城，收其貨寶美人，日置酒高會。項王乃西從蕭，晨擊漢軍而東，至彭城，日中，大破漢軍。漢軍皆走，相隨入穀、泗水，殺漢卒十餘萬人。漢卒皆南走山，楚又追擊至靈壁東睢水上。漢軍卻，為楚所擠，多殺，漢卒十餘萬人皆入睢水，睢水為之不流。圍漢王三匝。於是大風從西北而起，折木發屋，揚沙石，窈冥晝晦，逢迎楚軍。楚軍大亂，壞散，而漢王乃得與數十騎遁去，欲過沛，收家室而西；楚亦使人追之沛，取漢王家：家皆亡，不與漢王相見。漢王道逢得孝惠、魯元，乃載行。楚騎追漢王，漢王急，推墮孝惠、魯元車下，滕公常下收載之。如是者三。曰：「雖急不可以驅，柰何棄之？」於是遂得脫。求太公、呂后不相遇。審食其從太公、呂后閒行，求漢王，反遇楚軍。楚軍遂與歸，報項王，項王常置軍中。"},{"paragraph_id":"c-shiji-009-lvhou:p031","quote":"東牟侯興居曰：「誅呂氏吾無功，請得除宮。」乃與太仆汝陰侯滕公入宮，前謂少帝曰：「足下非劉氏，不當立。」乃顧麾左右執戟者掊兵罷去。有數人不肯去兵，宦者令張澤諭告，亦去兵。滕公乃召乘輿車載少帝出。少帝曰：「欲將我安之乎？」滕公曰「出就舍。」舍少府。乃奉天子法駕，迎代王於邸。報曰：「宮謹除。」代王即夕入未央宮。有謁者十人持戟衛端門，曰：「天子在也，足下何為者而入？」代王乃謂太尉。太尉往諭，謁者十人皆掊兵而去。代王遂入而聽政。夜，有司分部誅滅梁、淮陽、常山王及少帝於邸。代王立為天子。二十三年崩，謚為孝文皇帝。"}],"rationale":"所列漢初諸王分封、平呂及接任敘事中暫定同指；同名不作全庫匹配，匿名者不補未見姓名，仍待異源覆核。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji092-010","person_id":"cbr-p005106","surfaces":["滕公"],"scope":"same_chapter","chapter_ids":["c-shiji-092-hanxin"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-092-hanxin:p004","quote":"及項梁渡淮，信杖劍從之，居戲下，無所知名。項梁敗，又屬項羽，羽以爲郎中。數以策干項羽，羽不用。漢王之入蜀，信亡楚歸漢，未得知名，爲連敖。坐法當斬，其輩十三人皆已斬，次至信，信乃仰視，適見滕公，曰：『上不欲就天下乎？何爲斬壯士！』滕公奇其言，壯其貌，釋而不斬。與語，大說之。言於上，上拜以爲治粟都尉，上未之奇也。"},{"paragraph_id":"c-shiji-092-hanxin:p013","quote":"楚數使奇兵渡河擊趙，趙王耳、韓信往來救趙，因行定趙城邑，發兵詣漢。楚方急圍漢王於滎陽，漢王南出，之宛、葉閒，得黥布，走入成皋，楚又復急圍之。六月，漢王出成皋，東渡河，獨與滕公俱，從張耳軍修武。至，宿傳舍。晨自稱漢使，馳入趙壁。張耳、韓信未起，即其臥內上奪其印符，以麾召諸將，易置之。信、耳起，乃知漢王來，大驚。漢王奪兩人軍，即令張耳備守趙地。拜韓信爲相國，收趙兵未發者擊齊。"}],"rationale":"按開篇姓名與局部事件承接，未名者不補姓名；信羽何上限明確人名主語，不以同字全域替換。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji092-teng","person_ids":["cbr-p000715","cbr-p005106"],"canonical_person_id":"cbr-p000715","scope":"cross_chapter","chapter_ids":["c-shiji-008-gaozu","c-shiji-092-hanxin"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-008-gaozu","source_id":"s-shiji-008-gaozu","paragraph_id":"c-shiji-008-gaozu:p043","quote":"漢王跳，獨與滕公共車出成皋玉門，北渡河，馳宿修武。自稱使者，晨馳入張耳、韓信壁，而奪之軍。乃使張耳北益收兵趙地，使韓信東擊齊。漢王得韓信軍，則復振。引兵臨河，南饗軍小修武南，欲復戰。郎中鄭忠乃說止漢王，使高壘深塹，勿與戰。漢王聽其計，使盧綰、劉賈將卒二萬人，騎數百，渡白馬津，入楚地，與彭越復擊破楚軍燕郭西，遂復下梁地十餘城。","mention_ids":["c-shiji-008-gaozu:m043-0006"]},{"chapter_id":"c-shiji-092-hanxin","source_id":"s-shiji-092-hanxin","paragraph_id":"c-shiji-092-hanxin:p013","quote":"楚數使奇兵渡河擊趙，趙王耳、韓信往來救趙，因行定趙城邑，發兵詣漢。楚方急圍漢王於滎陽，漢王南出，之宛、葉閒，得黥布，走入成皋，楚又復急圍之。六月，漢王出成皋，東渡河，獨與滕公俱，從張耳軍修武。至，宿傳舍。晨自稱漢使，馳入趙壁。張耳、韓信未起，即其臥內上奪其印符，以麾召諸將，易置之。信、耳起，乃知漢王來，大驚。漢王奪兩人軍，即令張耳備守趙地。拜韓信爲相國，收趙兵未發者擊齊。","mention_ids":["c-shiji-092-hanxin:m013-0085"]}],"rationale":"滕公同漢王出成皋渡河入修武軍壁事件相配。 各篇原字、原文與已發ID保留，同書不視為獨立見證；同指不確證所有紀年、任職、親屬或敘事，不按全域同名批量改號。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-007-xiangyu:p025","text":"春，漢王部五諸侯兵，凡五十六萬人，東伐楚。項王聞之，即令諸將擊齊，而自以精兵三萬人南從魯出胡陵。四月，漢皆已入彭城，收其貨寶美人，日置酒高會。項王乃西從蕭，晨擊漢軍而東，至彭城，日中，大破漢軍。漢軍皆走，相隨入穀、泗水，殺漢卒十餘萬人。漢卒皆南走山，楚又追擊至靈壁東睢水上。漢軍卻，為楚所擠，多殺，漢卒十餘萬人皆入睢水，睢水為之不流。圍漢王三匝。於是大風從西北而起，折木發屋，揚沙石，窈冥晝晦，逢迎楚軍。楚軍大亂，壞散，而漢王乃得與數十騎遁去，欲過沛，收家室而西；楚亦使人追之沛，取漢王家：家皆亡，不與漢王相見。漢王道逢得孝惠、魯元，乃載行。楚騎追漢王，漢王急，推墮孝惠、魯元車下，滕公常下收載之。如是者三。曰：「雖急不可以驅，柰何棄之？」於是遂得脫。求太公、呂后不相遇。審食其從太公、呂后閒行，求漢王，反遇楚軍。楚軍遂與歸，報項王，項王常置軍中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-007-xiangyu:m025-0002","start":2,"end":4,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0021","start":21,"end":23,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0062","start":62,"end":64,"surface":"美人","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m025-0071","start":71,"end":73,"surface":"項王","kind":"person","person_id":"cbr-p000610","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0168","start":168,"end":170,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0211","start":211,"end":213,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0227","start":227,"end":229,"surface":"家室","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、匿名者、群體、動物或未定指代保留待核；不補姓名、闕代或個別成員。"},{"id":"c-shiji-007-xiangyu:m025-0241","start":241,"end":243,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0251","start":251,"end":253,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0256","start":256,"end":258,"surface":"漢王","kind":"person","person_id":"cbr-p000662","status":"contextual_provisional"},{"id":"c-shiji-007-xiangyu:m025-0261","