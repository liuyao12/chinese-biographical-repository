interpretation_cases":[],"reported_variants":[{"id":"rv-shiji097-hongru","paragraph_id":"c-shiji-097-luli:p018","person_ids":["nxn_szf_9gi"],"source_term":"孝惠幸臣閎籍孺","received_reading":"閎籍孺","reported_reading":"閎孺","commentator":"司馬貞〈索隱〉辨誤（《史記三家註》數位見證）","quote":"案：佞幸傳云高祖時有籍孺，孝惠時有閎孺。今總言「閎籍孺」，誤也。","url":"https://zh.wikisource.org/w/index.php?title=史記三家註/卷097&oldid=2514767","status":"reported_not_collated","adopted":false,"image_verified":false,"revision_id":2514767}],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-097-luli:m018-0093","start":93,"end":96,"surface":"閎籍孺","kind":"person","person_id":"nxn_szf_9gi","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p018","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-097-luli:m018-0196","start":196,"end":199,"surface":"閎籍孺","kind":"person","person_id":"nxn_szf_9gi","status":"contextual_provisional","paragraph_id":"c-shiji-097-luli:p018","chapter_id":"c-shiji-097-luli"},{"id":"c-shiji-125-ningxing:m001-0067","start":67,"end":69,"surface":"閎孺","kind":"person","person_id":"nxn_szf_9gi","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p001","chapter_id":"c-shiji-125-ningxing"},{"id":"c-shiji-125-ningxing:m001-0117","start":117,"end":118,"surface":"閎","kind":"person","person_id":"nxn_szf_9gi","status":"contextual_provisional","paragraph_id":"c-shiji-125-ningxing:p001","chapter_id":"c-shiji-125-ningxing"}],"relations":[],"title_holdings":[],"address_assertions":[{"id":"pa-shiji125-002","person_id":"nxn_szf_9gi","relation":"migration_destination","place":{"source_name":"安陵","place_id":null,"modern_identification":null},"status":"source_attested","date_expression":null,"evidence":[{"chapter_id":"c-shiji-125-ningxing","source_id":"s-shiji125-ningxing","paragraph_id":"c-shiji-125-ningxing:p001","quote":"諺曰「力田不如逢年，善仕不如遇合」，固無虛言。非獨女以色媚，而士宦亦有之。昔以色幸者多矣。至漢興，高祖至暴抗也，然籍孺以佞幸；孝惠時有閎孺。此兩人非有材能，徒以婉佞貴幸，與上臥起，公卿皆因關說。故孝惠時郎侍中皆冠鵕䴊，貝帶，傅脂粉，化閎、籍之屬也。兩人徙家安陵。孝文時中寵臣，士人則鄧通，宦者則趙同、北宮伯子。北宮伯子以愛人長者；而趙同以星氣幸，常為文帝參乘；鄧通無伎能。"}],"source_term":"兩人徙家安陵","interpretation_note":"按原籍或徙家記錄分型保留原地名，不推出生地或現代轄區。","reviewer":"Codex（AI 代理）","human_reviewed":false}],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji097-024","person_id":"nxn_szf_9gi","scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["閎籍孺"],"evidence":[{"paragraph_id":"c-shiji-097-luli:p018","quote":"辟陽侯幸呂太后，人或毀辟陽侯於孝惠帝，孝惠帝大怒，下吏，欲誅之。呂太后慚，不可以言。大臣多害辟陽侯行，欲遂誅之。辟陽侯急，因使人欲見平原君。平原君辭曰：「獄急，不敢見君。」乃求見孝惠幸臣閎籍孺，說之曰：「君所以得幸帝，天下莫不聞。今辟陽侯幸太后而下吏，道路皆言君讒，欲殺之。今日辟陽侯誅，旦日太后含怒，亦誅君。何不肉袒為辟陽侯言於帝？帝聽君出辟陽侯，太后大驩。兩主共幸君，君貴富益倍矣。」於是閎籍孺大恐，從其計，言帝，果出辟陽侯。辟陽侯之囚，欲見平原君，平原君不見辟陽侯，辟陽侯以為倍己，大怒。及其成功出之，乃大驚。"}],"rationale":"本篇明孝惠幸臣；佞幸篇區別高祖籍孺與孝惠閎孺，索隱明指閎籍孺混稱有誤。暫辨所指為閎孺，仍保本篇原字並另記首選校讀，不把閎籍孺當閎孺通用別名，不合籍孺。","references":[{"id":"rv-shiji097-hongru","paragraph_id":"c-shiji-097-luli:p018","person_ids":["nxn_szf_9gi"],"source_term":"孝惠幸臣閎籍孺","received_reading":"閎籍孺","reported_reading":"閎孺","commentator":"司馬貞〈索隱〉辨誤（《史記三家註》數位見證）","quote":"案：佞幸傳云高祖時有籍孺，孝惠時有閎孺。今總言「閎籍孺」，誤也。","url":"https://zh.wikisource.org/w/index.php?title=史記三家註/卷097&oldid=2514767","status":"reported_not_collated","adopted":false,"image_verified":false,"revision_id":2514767}],"human_reviewed":false,"preferred_reading":{"person_mention_id":"c-shiji-097-luli:m018-0093","received_surface":"閎籍孺","preferred_surface":"閎孺","source_spelling_is_not_alias":true,"variant_id":"rv-shiji097-hongru","status":"editorial_provisional","rationale":"本篇明孝惠幸臣；佞幸篇區別高祖籍孺與孝惠閎孺，索隱明指閎籍孺混稱有誤。暫辨所指為閎孺，仍保本篇原字並另記首選校讀，不把閎籍孺當閎孺通用別名，不合籍孺。"}},{"id":"d-shiji097-hongru-second-mention","person_id":"nxn_szf_9gi","scope":"same_chapter","chapter_ids":["c-shiji-097-luli"],"status":"contextual_provisional",