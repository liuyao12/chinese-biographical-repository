isional"},{"id":"c-shiji-040-chu:m045-0054","start":54,"end":56,"surface":"子西","kind":"person","person_id":"yfx_myv_qft","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m045-0078","start":78,"end":81,"surface":"太子珍","kind":"person","person_id":"0va_zus_2zt_AAEA","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m045-0084","start":84,"end":86,"surface":"昭王","kind":"person","person_id":"0va_zus_2zt_AAEA","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p046","text":"昭王元年，楚衆不説費無忌，以其讒亡太子建，殺伍奢子父與郤宛。宛之宗姓伯氏子及子胥皆奔呉，呉兵數侵楚，楚人怨無忌甚。楚令尹子常誅無忌以説衆，衆乃喜。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m046-0000","start":0,"end":2,"surface":"昭王","kind":"person","person_id":"0va_zus_2zt_AAEA","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0009","start":9,"end":12,"surface":"費無忌","kind":"person","person_id":"z4i_gl4_8un","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0017","start":17,"end":20,"surface":"太子建","kind":"person","person_id":"gau_cq7_7g1","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0022","start":22,"end":24,"surface":"伍奢","kind":"person","person_id":"zk0_g6b_nbq","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0027","start":27,"end":29,"surface":"郤宛","kind":"person","person_id":"lqh_592_x11","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0030","start":30,"end":31,"surface":"宛","kind":"person","person_id":"lqh_592_x11","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0034","start":34,"end":37,"surface":"伯氏子","kind":"person","person_id":"dnz_dal_a9s","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0038","start":38,"end":40,"surface":"子胥","kind":"person","person_id":"zk0_g6b_nbq_B","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0053","start":53,"end":55,"surface":"無忌","kind":"person","person_id":"z4i_gl4_8un","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0060","start":60,"end":62,"surface":"子常","kind":"person","person_id":"yy2_ghd_owh","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m046-0063","start":63,"end":65,"surface":"無忌","kind":"person","person_id":"z4i_gl4_8un","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p047","text":"四年，呉三公子奔楚，楚封之以捍呉。五年，呉伐取楚之六、潛。七年，楚使子常伐呉，呉大敗楚於豫章。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m047-0003","start":3,"end":7,"surface":"呉三公子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、寓言人物或未定指代，未補未見姓名、全體成員或親屬關係。"},{"id":"c-shiji-040-chu:m047-0034","start":34,"end":36,"surface":"子常","kind":"person","person_id":"yy2_ghd_owh","status":"contextual_provisional"}],"chapter_id":"c-shiji-040-chu","book_id":"b-shiji-040","work_id":"w-shiji","source_id":"s-shiji-040-chu"},{"id":"c-shiji-040-chu:p048","text":"十年冬，呉王闔閭、伍子胥、伯與唐、蔡倶伐楚，楚大敗，呉兵遂入郢，辱平王之墓，以伍子胥故也。呉兵之來，楚使子常以兵迎之，夾漢水陣。呉伐敗子常，子常亡奔鄭。楚兵走，呉乘勝逐之，五戰及郢。己卯，昭王出奔。庚辰，呉人入郢。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-040-chu:m048-0004","start":4,"end":8,"surface":"呉王闔閭","kind":"person","person_id":"5dm_e40_rqh_AAAAAAAAAAAAAAAAAAAA","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0009","start":9,"end":12,"surface":"伍子胥","kind":"person","person_id":"zk0_g6b_nbq_B","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0013","start":13,"end":14,"surface":"伯","kind":"unresolved","person_id":null,"status":"unresolved","note":"本版僅作伯，未補嚭字或直接連到他篇伯嚭；需核對版本與同一伐楚事件。"},{"id":"c-shiji-040-chu:m048-0033","start":33,"end":35,"surface":"平王","kind":"person","person_id":"0va_zus_2zt_AAE","status":"contextual_provisional"},{"id":"c-shiji-040-chu:m048-0039","st