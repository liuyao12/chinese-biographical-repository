wudi:m025-0025","start":25,"end":27,"surface":"伯夷","kind":"person","person_id":"uxv_pg9_8rm","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0035","start":35,"end":36,"surface":"垂","kind":"person","person_id":"kp0_vu0_i9h","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0045","start":45,"end":46,"surface":"益","kind":"person","person_id":"gec_tof_7li","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0053","start":53,"end":54,"surface":"棄","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0055","start":55,"end":56,"surface":"稷","kind":"person","person_id":"jqy_1fv_u7v","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0062","start":62,"end":63,"surface":"契","kind":"person","person_id":"ea8_yum_lvj","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0072","start":72,"end":73,"surface":"龍","kind":"person","person_id":"rjb_0hy_dsi","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0081","start":81,"end":84,"surface":"十二牧","kind":"unresolved","person_id":null,"status":"unresolved","note":"可能為個人、官職、群體、氏族或國號；不憑本篇未明示的外部對應補造身份。"},{"id":"c-shiji-001-wudi:m025-0094","start":94,"end":95,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0180","start":180,"end":182,"surface":"帝舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0187","start":187,"end":188,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-001-wudi:m025-0210","start":210,"end":212,"surface":"虞帝","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"}],"chapter_id":"c-shiji-001-wudi","book_id":"b-shiji-001","work_id":"w-shiji","source_id":"s-shiji-001-wudi"},{"id":"c-shiji-002-xia:p020","text":"皋陶作士以理民。帝舜朝，禹、伯夷、皋陶相與語帝前。皋陶述其謀曰：「信其道德，謀明輔和。」禹曰：「然，如何？」皋陶曰：「於！慎其身脩，思長，敦序九族，衆明高翼，近可遠在已。」禹拜美言，曰：「然。」皋陶曰：「於！在知人，在安民。」禹曰：「吁！皆若是，惟帝其難之。知人則智，能官人；能安民則惠，黎民懷之。能知能惠，何憂乎驩兜，何遷乎有苗，何畏乎巧言善色佞人？」皋陶曰：「然，於！亦行有九德，亦言其有德。」乃言曰：「始事事，寬而栗，柔而立，愿而共，治而敬，擾而毅，直而溫，簡而廉，剛而實，彊而義，章其有常，吉哉。日宣三德，蚤夜翊明有家。日嚴振敬六德，亮采有國。翕受普施，九德咸事，俊乂在官，百吏肅謹。毋教邪淫奇謀。非其人居其官，是謂亂天事。天討有辠，五刑五用哉。吾言厎可行乎？」禹曰：「女言致可績行。」皋陶曰：「余未有知，思贊道哉。」","mentions":[{"id":"c-shiji-002-xia:m020-0000","start":0,"end":2,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0008","start":8,"end":10,"surface":"帝舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0012","start":12,"end":13,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0014","start":14,"end":16,"surface":"伯夷","kind":"person","person_id":"uxv_pg9_8rm","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0017","start":17,"end":19,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0022","start":22,"end":23,"surface":"帝","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional","interpretation_note":"依本段與前後段的帝舜及對話敘事暫定為舜，非全篇所有「帝」的自動對應。"},{"id":"c-shiji-002-xia:m020-0025","start":25,"end":27,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0044","start":44,"end":45,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0054","start":54,"end":56,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0086","start":86,"end":87,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0097","start":97,"end":99,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0113","start":113,"end":114,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0124","start":124,"end":125,"surface":"帝","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional","interpretation_note":"依本段與前後段的帝舜及對話敘事暫定為舜，非全篇所有「帝」的自動對應。"},{"id":"c-shiji-002-xia:m020-0157","start":157,"end":159,"surface":"驩兜","kind":"person","person_id":"kh7_12u_kei","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0163","start":163,"end":165,"surface":"有苗","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、氏族、官職或未定指代；不推造個別姓名。"},{"id":"c-shiji-002-xia:m020-0177","start":177,"end":179,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0335","start":335,"end":336,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"source_identified"},{"id":"c-shiji-002-xia:m020-0347","start":347,"end":349,"surface":"皋陶","kind":"person","person_id":"p3l_pp3_n6i","status":"source_identified"}],"chapter_id":"c-shiji-002-xia","book_id":"b-shiji-002","work_id":"w-shiji","source_id":"s-shiji-002-xia"},{"id":"c-shiji-036-chenqi:p030","text":"舜之後，周武王封之陳，至楚惠王滅之，有世家言。禹之後，周武王封之杞，楚惠王滅之，有世家言。契之後為殷，殷有本紀言。殷破，周封其後於宋，齊湣王滅之，有世家言。后稷之後為周，秦昭王滅之，有本紀言。皋陶之後，或封英、六，楚穆王滅之，無譜。伯夷之後，至周武王復封於齊，曰太公望，陳氏滅之，有世家言。伯翳之後，至周平王時封為秦，項羽滅之，有本紀言。垂、益、夔、龍，其後不知所封，不見也。右十一人者，皆唐虞之際名有功德臣也；其五人之後皆至帝王，餘乃為顯諸侯。滕、薛、騶，夏、殷、周之閒封也，小，不足齒列，弗論也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-036-chenqi:m030-0000","start":0,"end":1,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0004","start":4,"end":7,"surface":"周武王","kind":"person","person_id":"y4i_pjk_4gn_AA","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0012","start":12,"end":15,"surface":"楚惠王","kind":"person","person_id":"bff_e4b_8yv","status":"contextual_provisional"},{"id":"c-shiji-036-chenqi:m030-0023","start":23,"end":24,"surface":"禹","kind":"person","person_id":"6ip_dr3_fbl","status":"contextua