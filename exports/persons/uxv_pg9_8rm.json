graph_id":"c-shiji-001-wudi:p025","chapter_id":"c-shiji-001-wudi"},{"id":"c-shiji-002-xia:m020-0014","start":14,"end":16,"surface":"伯夷","kind":"person","person_id":"uxv_pg9_8rm","status":"source_identified","paragraph_id":"c-shiji-002-xia:p020","chapter_id":"c-shiji-002-xia"},{"id":"c-shiji-036-chenqi:m030-0116","start":116,"end":118,"surface":"伯夷","kind":"person","person_id":"uxv_pg9_8rm","status":"contextual_provisional","paragraph_id":"c-shiji-036-chenqi:p030","chapter_id":"c-shiji-036-chenqi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji002-cross-012","person_id":"uxv_pg9_8rm","surfaces":["伯夷"],"scope":"cross_chapter","chapter_ids":["c-shiji-001-wudi","c-shiji-002-xia"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-001-wudi:p025","quote":"伯夷主禮"},{"paragraph_id":"c-shiji-002-xia:p020","quote":"帝舜朝，禹、伯夷、皋陶相與語帝前"}],"rationale":"依連續敘事、人物職事、親屬與相同事件暫定為前卷所指人物；不以同字通用於其他時代同名者。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji036-008","person_id":"uxv_pg9_8rm","surfaces":["伯夷"],"scope":"cross_chapter","chapter_ids":["c-shiji-001-wudi","c-shiji-036-chenqi"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-001-wudi:p024","quote":"舜入于大麓，烈風雷雨不迷，堯乃知舜之足授天下。堯老，使舜攝行天子政，巡狩。舜得舉，用事二十年，而堯使攝政。攝政八年而堯崩。三年喪畢，讓丹朱，天下歸舜。而禹、皋陶、契、后稷、伯夷、夔、龍、倕、益、彭祖自堯時而皆舉用，未有分職。於是舜乃至於文祖，謀于四嶽，辟四門，明通四方耳目，命十二牧論帝德，行厚德，遠佞人，則蠻夷率服。舜謂四嶽曰：「有能奮庸美堯之事者，使居官相事？」皆曰：「伯禹爲司空，可美帝功。」舜曰：「嗟，然！禹，汝平水土，維是勉哉。」禹拜稽首，讓於稷、契與皋陶。舜曰：「然，往矣。」舜曰：「棄，黎民始飢，汝后稷，播時百穀。」舜曰：「契，百姓不親，五品不馴，汝爲司徒，而敬敷五教，在寬。」舜曰：「皋陶，蠻夷猾夏，寇賊姦軌，汝作士，五刑有服，五服三就；五流有度，五度三居：維明能信。」舜曰：「誰能馴予工？」皆曰垂可。於是以垂爲共工。舜曰：「誰能馴予上下草木鳥獸？」皆曰益可。於是以益爲朕虞。益拜稽首，讓于諸臣朱虎、熊羆。舜曰：「往矣，汝諧。」遂以朱虎、熊羆爲佐。舜曰：「嗟！四嶽，有能典朕三禮？」皆曰伯夷可。舜曰：「嗟！伯夷，以汝爲秩宗，夙夜維敬，直哉維靜絜。」伯夷讓夔、龍。舜曰：「然。以夔爲典樂，教稺子，直而溫，寬而栗，剛而毋虐，簡而毋傲；詩言意，歌長言，聲依永，律和聲，八音能諧，毋相奪倫，神人以和。」夔曰：「於！予擊石拊石，百獸率舞。」舜曰：「龍，朕畏忌讒說殄僞，振驚朕衆，命汝爲納言，夙夜出入朕命，惟信。」舜曰：「嗟！女二十有二人，敬哉，惟時相天事。」三歲一考功，三考絀陟，遠近衆功咸興。分北三苗。"},{"paragraph_id":"c-shiji-036-chenqi:p030","quote":"舜之後，周武王封之陳，至楚惠王滅之，有世家言。禹之後，周武王封之杞，楚惠王滅之，有世家言。契之後為殷，殷有本紀言。殷破，周封其後於宋，齊湣王滅之，有世家言。后稷之後為周，秦昭王滅之，有本紀言。皋陶之後，或封英、六，楚穆王滅之，無譜。伯夷之後，至周武王復封於齊，曰太公望，陳氏滅之，有世家言。伯翳之後，至周平王時封為秦，項羽滅之，有本紀言。垂、益、夔、龍，其後不知所封，不見也。右十一人者，皆唐虞之際名有功德臣也；其五人之後皆至帝王，餘乃為顯諸侯。滕、薛、騶，夏、殷、周之閒封也，小，不足齒列，弗論也。"}],"rationale":"本篇第30段按明示名與稱號、陳／杞世系及具體敘事暫定「伯夷」同指；引句均保留，不按同名字面跨篇合併。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-001-wudi:p024","text":"舜入于大麓，烈風雷雨不迷，堯乃知舜之足授天下。堯老，使舜攝行天子政，巡狩。舜得舉，用事二十年，而堯使攝政。攝政八年而堯崩。三年喪畢，讓丹朱，天下歸舜。而禹、皋陶、契、后稷、伯夷、夔、龍、倕、益、彭祖自堯時而皆舉用，未有分職。於是舜乃至於文祖，謀于四嶽，辟四門，明通四方耳目，命十二牧論帝德，行厚德，遠佞人，則蠻夷率服。舜謂四嶽曰：「有能奮庸美堯之事者，使居官相事？」皆曰：「伯禹爲司空，可美帝功。」舜曰：「嗟，然！禹，汝平水土，維是勉哉。」禹拜稽首，讓於稷、契與皋陶。舜曰：「然，往矣。」舜曰：「棄，黎民始飢，汝后稷，播時百穀。」舜曰：「契，百姓不親，五品不馴，汝爲司徒，而敬敷五教，在寬。」舜曰：「皋陶，蠻夷猾夏，寇賊姦軌，汝作士，五刑有服，五服三就；五流有度，五度三居：維明能信。」舜曰：「誰能馴予工？」皆曰垂可。於是以垂爲共工。舜曰：「誰能馴予上下草木鳥獸？」皆曰益可。於是以益爲朕虞。益拜稽首，讓于諸臣朱虎、熊羆。舜曰：「往矣，汝諧。」遂以朱虎、熊羆爲佐。舜曰：「嗟！四嶽，有能典朕三禮？」皆曰伯夷可。舜曰：「嗟！伯夷，以汝爲秩宗，夙夜維敬，直哉維靜絜。」伯夷讓夔、龍。舜曰：「然。以夔爲典樂，教稺子，直而溫，寬而栗，剛而毋虐，簡而毋傲；詩言意，歌長言，聲依永，律和聲，八音能諧，毋相奪倫，神人以和。」夔曰：「於！予擊石拊石，百獸率舞。」舜曰：「龍，朕畏忌讒說殄僞，振驚朕衆，命汝爲納言，夙夜出入朕命，惟信。」舜曰：「嗟！女二十有二人，敬哉，惟時相天事。」三歲一考功，三考絀陟，遠近衆功咸興。分北三苗。","mentions":[{"id":"c-shiji-001-wudi:m024-0000","start":0,"end":1,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0013","start":13,"end":14,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0016","start":16,"end":17,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0023","start":23,"end":24,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0027","start":27,"end":28,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-0037","start":37,"end":38,"surface":"舜","kind":"person","person_id":"ddb_l4j_4j2","status":"source_identified"},{"id":"c-shiji-001-wudi:m024-