erson_id":"cbr-p003861","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p057","text":"子張問干祿，孔子曰：「多聞闕疑，慎言其餘，則寡尤；多見闕殆，慎行其餘，則寡悔。言寡尤，行寡悔，祿在其中矣。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m057-0000","start":0,"end":2,"surface":"子張","kind":"person","person_id":"cbr-p003898","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m057-0006","start":6,"end":8,"surface":"孔子","kind":"person","person_id":"cbr-p003861","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p058","text":"他日從在陳蔡閒，困，問行。孔子曰：「言忠信，行篤敬，雖蠻貊之國行也；言不忠信，行不篤敬，雖州里行乎哉！立則見其參於前也，在輿則見其倚於衡，夫然後行。」子張書諸紳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m058-0013","start":13,"end":15,"surface":"孔子","kind":"person","person_id":"cbr-p003861","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m058-0075","start":75,"end":77,"surface":"子張","kind":"person","person_id":"cbr-p003898","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p059","text":"子張問：「士何如斯可謂之達矣？」孔子曰：「何哉，爾所謂達者？」子張對曰：「在國必聞，在家必聞。」孔子曰：「是聞也，非達也。夫達者，質直而好義，察言而觀色，慮以下人，在國及家必達。夫聞也者，色取仁而行違，居之不疑，在國及家必聞。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m059-0000","start":0,"end":2,"surface":"子張","kind":"person","person_id":"cbr-p003898","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m059-0005","start":5,"end":6,"surface":"士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m059-0016","start":16,"end":18,"surface":"孔子","kind":"person","person_id":"cbr-p003861","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m059-0027","start":27,"end":29,"surface":"達者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m059-0031","start":31,"end":33,"surface":"子張","kind":"person","person_id":"cbr-p003898","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m059-0048","start":48,"end":50,"surface":"孔子","kind":"person","person_id":"cbr-p003861","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m059-0062","start":62,"end":64,"surface":"達者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"}],"sources":[{"chapter_id":"c-shiji-067-disciples","work_id":"w-shiji","book_id":"b-shiji-067","source_id":"s-shiji-067-disciples","source":{"title":"史記／卷067","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷067","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷067&oldid=7869003","revision_id":7869003,"accessed_on":"2026-10-09","extent":"152段正文，自孔子曰受業身通者至太史公論贊；排除ws-header中的導覽名單、後附索隱述贊及現代版權告示。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{},"editorial_readings":[],"extraction_note":"取得時HTML與固定修訂一致，只去外緣空白；保留髙、歳、衞、漆彫、曾蒧等原字。導覽名單與正文異體不混接。","note":"全152段已核讀，人物標註待逐段處理；未核可靠底本、影像或現代研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
