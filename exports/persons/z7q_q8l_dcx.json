7223,7224,7225,7226,7227,7228,7229,7230]},"attribution":{"annotator":"裴松之","attribution_kind":"quoted_work","source_label":"會稽典錄","attribution_marker":"《会稽典录》曰：","quoted_work":"會稽典錄"},"attachment":{"received_paragraph_id":"c-sanguozhi-057-yufan:line029","received_codepoint":61,"note_ordinal":1,"source_ordinal":1},"chapter_id":"c-sanguozhi-057-yufan","book_id":"b-sanguozhi-057","work_id":"w-sanguozhi","source_id":"s-sanguozhi-057-yufan"},{"id":"c-shiji-034-yan:p022","text":"鹿毛壽謂燕王：「不如以國讓相子之。人之謂堯賢者，以其讓天下於許由，許由不受，有讓天下之名而實不失天下。今王以國讓於子之，子之必不敢受，是王與堯同行也。」燕王因屬國於子之，子之大重。或曰：「禹薦益，已而以啓人爲吏。及老，而以啓人爲不足任乎天下，傳之於益。已而啓與交黨攻益，奪之。天下謂禹名傳天下於益，已而實令啓自取之。今王言屬國於子之，而吏無非太子人者，是名屬子之而實太子用事也。」王因收印自三百石吏已上而效之子之。子之南面行王事，而噲老不聽政，顧爲臣，國事皆決於子之。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-034-yan:m022-0000","start":0,"end":3,"surface":"鹿毛壽","kind":"person","person_id":"8w3_sd6_lr3","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m022-0004","start":4,"end":6,"surface":"燕王","kind":"person","person_id":"n4f_fqh_04q_A","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m022-0014","start":14,"end":16,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m022-0020","start":20,"end":21,"surface":"堯","kind":"person","person_id":"oho_r3f_c6y","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m022-0030","start":30,"end":32,"surface":"許由","kind":"person","person_id":"z7q_q8l_dcx","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m022-0033","start":33,"end":35,"surface":"許由","kind":"person","person_id":"z7q_q8l_dcx","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m022-0057","start":57,"end":59,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m022-0060","start":60,"end":62,"surface":"子之","kind":"person","person_id":"8w9_x0s_cyf","status":"contextual_provisional"},{"id":"c-shiji-034-yan:m022-0070","start":