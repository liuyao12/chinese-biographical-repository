ce_ids":["s-nanqishu-057-northern-wei-complete-ws1999801"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-nanqishu-057-northern-wei-complete:p015:m0571","start":571,"end":574,"surface":"解奉君","kind":"person","person_id":"p0v_rns_g2p","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p015","chapter_id":"c-nanqishu-057-northern-wei-complete"},{"id":"c-nanqishu-057-northern-wei-complete:p015:m0584","start":584,"end":586,"surface":"奉君","kind":"person","person_id":"p0v_rns_g2p","status":"contextual_provisional","paragraph_id":"c-nanqishu-057-northern-wei-complete:p015","chapter_id":"c-nanqishu-057-northern-wei-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-nanqishu-057-northern-wei-complete:p015","text":"上未遑外略，以虜既摧破，且欲示以威懷，遣後軍參軍車僧朗北使。虜問僧朗曰：「齊輔宋日淺，何故便登天位？」僧朗曰：「虞、夏登庸，親當革禪；魏、晉匡（戰）〔輔〕，貽厥子孫。豈二聖促促於天位，兩賢謙虛以獨善？時宜各異，豈得一揆？苟曰事宜，故屈己應物。」虜又問：「齊主悉有何功業？」僧朗曰：「主上聖性寬仁，天識弘遠。少為宋文皇所器遇，入參禁旅。泰始之初，四方寇叛，東平劉子房、張淹，北討薛索兒，兼掌軍國，豫司顧命。宋桂陽、建平二王阻兵內侮，一麾殄滅。蒼梧王反道敗德，有過桀、紂，遠遵伊、霍，行廢立之事。袁粲、劉秉、沈攸之同惡相濟，又秉旄杖鉞，大定凶黨。戮力佐時，四十餘載，經綸夷險，十五六年，此功此德，可謂物無異議。」虜又問：「南國無復齊土，何故封齊？」僧朗曰：「營丘表海，實為大國。宋朝光啟土宇，謂是呂尚先封。今淮海之間，自有青、齊，非無地也。」又問：「蒼梧何故遂加斬戮？」僧朗曰：「蒼梧暴虐，書契未聞，武王斬紂，懸之黃鉞，共是所聞，何傷於義？」昇明中，北使殷靈誕、苟昭先在虜，聞太祖登極，靈誕謂虜典客曰：「宋魏通好，憂患是同。宋今滅亡，魏不相救，何用和親？」及虜寇豫州，靈誕因請為劉昶司馬，不獲。僧朗至北，虜置之靈誕下，僧朗立席言曰：「靈誕昔是宋使，今成齊民。實希魏主以禮見處。」靈誕交言，遂相忿詈，調虜曰：「使臣不能立節本朝，誠自慙恨。」劉昶賂客解奉君於會刺殺僧朗，虜即收奉君誅之，殯斂僧朗，送喪隨靈誕等南歸，厚加贈賻。世祖踐阼，昭先具以啟聞，靈誕下獄死，贈僧朗散騎侍郎。","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":38,"last_line":38,"raw_start":3114,"raw_end":3781,"raw_character_offsets":[3114,3115,3116,3117,3118,3119,3120,3121,3122,3123,3124,3125,3126,3127,3128,3129,3130,3131,3132,3133,3134,3135,3136,3137,3138,3139,3140,3141,3142,3143,3144,3145,3146,3147,3148,3149,3150,3151,3152,3153,3154,3155,3156,3157,3158,3159,3160,3161,3162,3163,3164,3165,3166,3167,3168,3169,3170,3171,3172,3173,3174,3175,3176,3177,3178,3179,3180,3181,3182,3183,3184,3185,3186,3187,3188,3189,3190,3191,3225,3226,3227,3228,3229,3230,3231,3232,3233,3234,3235,3236,3237,3238,3239,3240,3241,3242,3243,3244,3245,3246,3247,3248,3249,3250,3251,3252,3253,3254,3255,3256,3257,3258,3259,3260,3261,3262,3263,3264,3265,3266,3267,3268,3269,3270,3271,3272,3273,3274,3275,3276,3277,3278,3279,3280,3281,3282,3283,3284,3285,3286,3287,3288,3289,3290,3291,3292,3293,3294,3295,3296,3297,3298,3299,3300,3301,3302,3303,3304,3305,3306,3307,3308,3309,3310,3311,3312,3313,3314,3315,3316,3317,3318,3319,3320,3321,3322,3323,3324,3325,3326,3327,3328,3329,3330,3331,3332,3333,3334,3335,3336,3337,3338,3339,3340,3341,3342,3343,3344,3345,3346,3347,3348,3349,3350,3351,3352,3353,3354,3355,3356,3357,3358,3359,3360,3361,3362,3363,3364,3365,3366,3367,3368,3369,3370,3371,3372,3373,3374,3375,3376,3377,3378,3379,3380,3381,3382,3383,3384,3385,3386,3387,3388,3389,3390,3391,3392,3393,3394,3395,3396,3397,3398,3399,3400,3401,3402,3403,3404,3405,3406,3407,3408,3409,3410,3411,3412,3413,3414,3415,3416,3417,3418,3419,3420,3421,3422,3423,3424,3425,3426,3427,3428,3429,3430,3431,3432,3433,3434,3435,3436,3437,3438,3439,3440,3441,3442,3443,3444,3445,3446,3447,3448,3449,3450,3451,3452,3453,3454,3455,3456,3457,3458,3459,3460,3461,3462,3463,3464,3465,3466,3467,3468,3469,3470,3471,3472,3473,3