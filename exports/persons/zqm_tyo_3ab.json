ed_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-jin068-jizhi-father","subject_person_id":"23e_6ed_438","object_person_id":"zqm_tyo_3ab","predicate":"father","qualifiers":{"source_term":"父陟，光祿大夫"},"evidence":[{"work_id":"w-jinshu","book_id":"b-jinshu-068","chapter_id":"c-jinshu-068-jizhan","source_id":"s-jinshu-068-jizhan-ws2581578","paragraph_id":"c-jinshu-068-jizhan:p001","quote":"紀瞻，字思遠，丹陽秣陵人也。祖亮，吳尚書令。父陟，光祿大夫。瞻少以方直知名。吳平，徙家曆陽郡。察孝廉，不行。","subject_person_mention_id":"c-jinshu-068-jizhan:p001:m0000","object_person_mention_id":"c-jinshu-068-jizhan:p001:m0023"}],"status":"source_attested","interpretation_note":"紀陟與祖亮各具原官。","reviewer":"Codex（AI代理）","model":null,"human_reviewed":false},{"id":"a-wu048-ji-father","subject_person_id":"zqm_tyo_3ab","object_person_id":"8h9_qyd_2x6","predicate":"father","qualifiers":{"source_term":"父亮爲尚書令"},"evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-048","chapter_id":"c-sanguozhi-048-sun-hao","source_id":"s-sanguozhi-048-sun-hao-ws2085142","paragraph_id":"c-sanguozhi-048-sun-hao:p007","quote":"《江表傳》曰：皓書兩頭言白，稱名言而不著姓。　《吳錄》曰：陟字子上，丹楊人。初爲中書郎，孫峻使詰南陽王和，令其引分。陟密使令正辭自理，峻怒。陟懼，閉門不出。孫休時，父亮爲尚書令，而陟爲中書令，每朝會，詔以屏風隔其座。出爲豫章太守。　干寶《晉紀》曰：陟、璆奉使如魏，入境而問諱，入國而問俗。壽春將王布示之馬射，旣而問之曰：「吳之君子亦能斯乎？」陟曰：「此軍人騎士肄業所及，士大夫君子未有爲之者矣。」布大慙。旣至，魏帝見之，使儐問曰：「來時吳王何如？」陟對曰：「來時皇帝臨軒，百寮陪位，御膳無恙。」晉文王饗之，百寮畢會，使儐者告曰：「某者安樂公也，某者匈奴單于也。」陟曰：「西主失土，爲君王所禮，位同三代，莫不感義，匈奴邊塞難羈之國，君王懷之，親在坐席，此誠威恩遠著。」又問：「吳之戍備幾何？」對曰：「自西陵以至江都，五千七百里。」又問曰：「道里甚遠，難爲堅固？」對曰：「疆界雖遠，而其險要必爭之地，不過數四，猶人雖有八尺之軀靡不受患，其護風寒亦數處耳。」文王善之，厚爲之禮。　臣松之以爲人有八尺之體靡不受患，防護風寒豈唯數處？取譬若此，未足稱能。若曰譬如金城萬雉，所急防者四門而已。方陟此對，不猶愈乎！　《吳錄》曰：皓以諸父與和相連及者，家屬皆徙東冶，唯陟以有密旨，特封子孚都亭侯。孚弟瞻，字思遠，入仕晉驃騎將軍。弘璆，曲阿人，弘咨之孫，權外甥也。璆後至中書令、太子少傅。","subject_person_mention_id":"c-sanguozhi-048-sun-hao:p007:m0029","object_person_mention_id":"c-sanguozhi-048-sun-hao:p007:m0083"}],"status":"source_attested","inte