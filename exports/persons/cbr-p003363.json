{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p003363","identity_policy":"contextual_provisional","person_ids":["cbr-p003363"],"persons":[{"id":"cbr-p003363","label":"韓宣惠王（留侯世家候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"宣惠王","mention_ids":["c-shiji-055-liu:m001-0022"]}],"evidence":[{"mention_id":"c-shiji-055-liu:m001-0022","chapter_id":"c-shiji-055-liu","paragraph_id":"c-shiji-055-liu:p001","quote":"宣惠王"}]}],"mentions":[{"id":"c-shiji-055-liu:m001-0022","start":22,"end":25,"surface":"宣惠王","kind":"person","person_id":"cbr-p003363","status":"contextual_provisional","paragraph_id":"c-shiji-055-liu:p001","chapter_id":"c-shiji-055-liu"}],"relations":[],"title_holdings":[{"id":"th-shiji055-005","person_id":"cbr-p003363","title":"宣惠王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-055-liu","source_id":"s-shiji-055-liu","paragraph_id":"c-shiji-055-liu:p001","quote":"留侯張良者，其先韓人也。大父開地，相韓昭侯、宣惠王、襄哀王。父平，相釐王、悼惠王。悼惠王二十三年，平卒。卒二十歲，秦滅韓。良年少，未宦事韓。韓破，良家僮三百人，弟死不葬，悉以家財求客刺秦王，為韓報仇，以大父、父五世相韓故。"}],"attestations":[{"id":"th-shiji055-005:a001","paragraph_id":"c-shiji-055-liu:p001","start":22,"end":25,"surface":"宣惠王","person_mention_id":"c-shiji-055-liu:m001-0022","usage":"retrospective"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授予、自立、貶降、任事與文獻用稱分存；未知任期不由首見或卒日推定。廄將、申徒、什方及四人稱名保留見證原字，未定制度性質者不補爵秩。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji055-005","person_id":"cbr-p003363","surfaces":["宣惠王"],"scope":"same_chapter","chapter_ids":["c-shiji-055-liu"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-055-liu:p001","quote":"留侯張良者，其先韓人也。大父開地，相韓昭侯、宣惠王、襄哀王。父平，相釐王、悼惠王。悼惠王二十三年，平卒。卒二十歲，秦滅韓。良年少，未宦事韓。韓破，良家僮三百人，弟死不葬，悉以家財求客刺秦王，為韓報仇，以大父、父五世相韓故。"}],"rationale":"依明示名字、局部任事、授封及引語暫接；良久、每上冢與愛子之上排除人物短稱。老父場景的父不接張良父平；韓悼惠王不接齊王，秦王子嬰不接博浪沙秦皇帝，未名者不補姓名。神異與古代比擬不表示人物當時在場或神蹟已證。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-055-liu:p001","text":"留侯張良者，其先韓人也。大父開地，相韓昭侯、宣惠王、襄哀王。父平，相釐王、悼惠王。悼惠王二十三年，平卒。卒二十歲，秦滅韓。良年少，未宦事韓。韓破，良家僮三百人，弟死不葬，悉以家財求客刺秦王，為韓報仇，以大父、父五世相韓故。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-055-liu:m001-0000","start":0,"end":4,"surface":"留侯張良","kind":"person","person_id":"cbr-p003359","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0006","start":6,"end":8,"surface":"其先","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、書名署稱、神異所指或代詞待覆核，不補姓名或未見家屬。"},{"id":"c-shiji-055-liu:m001-0014","start":14,"end":16,"surface":"開地","kind":"person","person_id":"cbr-p003360","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0018","start":18,"end":21,"surface":"韓昭侯","kind":"person","person_id":"cbr-p003362","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0022","start":22,"end":25,"surface":"宣惠王","kind":"person","person_id":"cbr-p003363","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0026","start":26,"end":29,"surface":"襄哀王","kind":"person","person_id":"cbr-p003364","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0031","start":31,"end":32,"surface":"平","kind":"person","person_id":"cbr-p003361","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0034","start":34,"end":36,"surface":"釐王","kind":"person","person_id":"cbr-p003365","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0037","start":37,"end":40,"surface":"悼惠王","kind":"person","person_id":"cbr-p003366","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0041","start":41,"end":44,"surface":"悼惠王","kind":"person","person_id":"cbr-p003366","status":"contextual_provisional"},{"id":"c-shiji-055-liu:m001-0049","start":49,"end":50,"surface":"平","kind":"person","person_