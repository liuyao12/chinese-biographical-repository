urce_attested","evidence":[{"chapter_id":"c-shiji-067-disciples","source_id":"s-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p086","quote":"子路使子羔爲費郈宰，孔子曰：「賊夫人之子！」子路曰：「有民人焉，有社稷焉，何必讀書然後爲學！」孔子曰：「是故惡夫佞者。」"}],"attestations":[{"id":"th-shiji067-021:a001","paragraph_id":"c-shiji-067-disciples:p086","start":6,"end":9,"surface":"費郈宰","person_mention_id":"c-shiji-067-disciples:m086-0003","usage":"narrative"}],"effective_period":{"start":{"status":"source_event","event_type":"grant","date_expression":null,"evidence":[{"chapter_id":"c-shiji-067-disciples","source_id":"s-shiji-067-disciples","paragraph_id":"c-shiji-067-disciples:p086","quote":"子路使子羔爲費郈宰，孔子曰：「賊夫人之子！」子路曰：「有民人焉，有社稷焉，何必讀書然後爲學！」孔子曰：「是故惡夫佞者。」"}]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"保存授予事件與文獻用稱，不以首次用稱、死亡或出奔推定全部任期邊界。閔損不仕、漆彫開未能信而未出仕、孔子可使等評論均不當已任。相魯衞與相衞照原文，未定官名或精確時段；有若共立為師不作官職。楊何元朔中用稱未換算精確日期。諡稱及來源敘事仍待底本與研究覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji067-035","person_id":"b7o_fu7_sjf","surfaces":["子羔","柴","髙柴"],"scope":"same_chapter","chapter_ids":["c-shiji-067-disciples"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-067-disciples:p001","quote":"孔子曰「受業身通者七十有七人」，皆異能之士也。德行：顏淵，閔子騫，冉伯牛，仲弓。政事：冉有，季路。言語：宰我，子貢。文學：子游，子夏。師也辟，參也魯，柴也愚，由也喭，回也屢空。賜不受命而貨殖焉，億則屢中。"},{"paragraph_id":"c-shiji-067-disciples:p029","quote":"初，衞靈公有寵姬曰南子。靈公太子蕢聵得過南子，懼誅出奔。及靈公卒而夫人欲立公子郢。郢不肯，曰：「亡人太子之子輒在。」於是衞立輒爲君，是爲出公。出公立十二年，其父蕢聵居外，不得入。子路爲衞大夫孔悝之邑宰。蕢聵乃與孔悝作亂，謀入孔悝家，遂與其徒襲攻出公。出公奔魯，而蕢聵入立，是爲莊公。方孔悝作亂，子路在外，聞之而馳往。遇子羔出衞城門，謂子路曰：「出公去矣，而門已閉，子可還矣，毋空受其禍。」子路曰：「食其食者不避其難。」子羔卒去。有使者入城，城門開，子路隨而入。造蕢聵，蕢聵與孔悝登臺。子路曰：「君焉用孔悝？請得而殺之。」蕢聵弗聽。於是子路欲燔臺，蕢聵懼，乃下石乞、壺黶攻子路，擊斷子路之纓。子路曰：「君子死而冠不免。」遂結纓而死。"},{"paragraph_id":"c-shiji-067-disciples:p084","quote":"髙柴字子羔。少孔子三十歳。"},{"paragraph_id":"c-shiji-067-disciples:p085","quote":"子羔長不盈五尺，受業孔子，孔子以爲愚。"},{"paragraph_id":"c-shiji-067-disciples:p086","quote":"子路使子羔爲費郈宰，孔子曰：「賊夫人之子！」子路曰：「有民人焉，有社稷焉，何必讀書然後爲學！」孔子曰：「是故惡夫佞者。」"}],"rationale":"依篇內明示姓名字稱及局部問答暫接。吳越王稱按夫差句踐連續敘事；第71段夫子指原憲，第90段指代未定。傳易短何分田子莊何與楊何，傳授不當父子；引古人物保留傳說性。冉季字子產不接鄭子產，原憲子思不接孔子後世子思；名錄各條同字子徒、子聲、子上、皙等均保留不同候選，鄭國是此條人名。魯昭公夫人孟子不接戰國孟子。全152段明示姓名首輪已存，未名者、代詞、版本及跨篇身份待覆核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-033-wanglan-family:p013","text":"及疾篤，著遺令訓子孫曰：「夫生之有死，自然之理。吾年八十有五，啟手何恨。不有遺言，使爾無述。吾生值季末，登庸曆試，無毗佐之勳，沒無以報。氣絶但洗手足，不須沐浴，勿纏屍，皆浣故衣，隨時所服。所賜山玄玉佩、衞氏玉玦、綬笥皆勿以斂。西芒上土自堅貞，勿用甓石，勿起墳隴。穿深二丈，槨取容棺。勿作前堂、布几筵、置書箱鏡奩之具，棺前但可施床榻而已。Я脯各一盤，玄酒一杯，爲朝夕奠。家人大小不須送喪，大小祥乃設特牲。無違餘命！高柴泣血三年，夫子謂之愚。閔子除喪出見。援琴切切而哀，仲尼謂之孝。故哭泣之哀，日月降殺，飲食之宜，自有制度。夫言行可覆，信之至也；推美引過，德之至也；揚名顯親，孝之至也；兄弟怡怡，宗族欣欣，悌之至也；臨財莫過乎讓：此五者，立身之本。顏子所以爲命，未之思也，夫何遠之有！」其子皆奉而行之。","text_layer":"received_chapter","annotation_status":"in_progress","mentions":[{"id":"c-jinshu-033-wanglan-family:p013:m0206","start":206,"end":208,"surface":"高柴","kind":"person","person_id":"b7o_fu7_sjf","status":"contextual_provisional","interpretation_note":"按本段敘事、稱謂與引語身份辨識；不由同名自動合併。"},{"id":"c-jinshu-033-wanglan-family:p013:m0213","start":213,"end":215,"surface":"夫子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","interpretation_note":"按本段敘事、稱謂與引語身份辨識；不由同名自動合併。"},{"id":"c-jinshu-033-wanglan-family:p013:m0219","start":219,"end":221,"surface":"閔子","kind":"person","person_id":"we8_mkq_luc","status":"contextual_provisional","interpretation_note":"按本段敘事、稱謂與引語身份辨識；不由同名自動合併。"},{"id":"c-jinshu-033-wanglan-family:p013:m0233","start":233,"end":235,"surface":"仲尼","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional","interpretation_note":"按本段敘事、稱謂與引語身份辨識；不由同名自動合併。"},{"id":"c-jinshu-033-wanglan-family:p013:m0322","start":322,"end":324,"surface":"顏子","kind":"person","person_id":"gsq_vgq_esv","status":"contextual_provisional","interpretation_note":"按本段敘事、稱謂與引語身份辨識；不由同名自動合併。"}],"source_position":{"first_line":28,"last_line":29,"revision_id":2650519,"editorial_excerpt_boundary":true},"chapter_id":"c-jinshu-033-wanglan-family","book_id":"b-jinshu-033","work_id":"w-jinshu","source_id":"s-jinshu-033-wanglan-family"},{"id":"c-shiji-067-disciples:p001","text":"孔子曰「受業身通者七十有七人」，皆異能之士也。德行：顏淵，閔子騫，冉伯牛，仲弓。政事：冉有，季路。言語：宰我，子貢。文學：子游，子夏。師也辟，參也魯，柴也愚，由也喭，回也屢空。賜不受命而貨殖焉，億則屢中。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m001-0000","start":0,"end":2,"surface":"孔子","kind":"person","person_id":"fp6_ia6_7yw","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0004","start":4,"end":9,"surface":"受業身通者","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m001-0017","start":17,"end":21,"surface":"異能之士","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者、氏族或未定指代，尚未補姓名及成員。"},{"id":"c-shiji-067-disciples:m001-0026","start":26,"end":28,"surface":"顏淵","kind":"person","person_id":"gsq_vgq_esv","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0029","start":29,"end":32,"surface":"閔子騫","kind":"person","person_id":"we8_mkq_luc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0033","start":33,"end":36,"surface":"冉伯牛","kind":"person","person_id":"n7v_qo9_v4f","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0037","start":37,"end":39,"surface":"仲弓","kind":"person","person_id":"5bo_dxd_69k_A","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0043","start":43,"end":45,"surface":"冉有","kind":"person","person_id":"wnp_vk6_qhe","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0046","start":46,"end":48,"surface":"季路","kind":"person","person_id":"t7x_2x7_1fc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0052","start":52,"end":54,"surface":"宰我","kind":"person","person_id":"sng_c8u_vn9","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0055","start":55,"end":57,"surface":"子貢","kind":"person","person_id":"7c4_6v2_yvm","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0061","start":61,"end":63,"surface":"子游","kind":"person","person_id":"mqt_zhu_byy","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0064","start":64,"end":66,"surface":"子夏","kind":"person","person_id":"z8l_wje_08d","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0067","start":67,"end":68,"surface":"師","kind":"person","person_id":"482_ly0_otk","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0071","start":71,"end":72,"surface":"參","kind":"person","person_id":"c7w_nyj_95u","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0075","start":75,"end":76,"surface":"柴","kind":"person","person_id":"b7o_fu7_sjf","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0079","start":79,"end":80,"surface":"由","kind":"person","person_id":"t7x_2x7_1fc","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0083","start":83,"end":84,"surface":"回","kind":"person","person_id":"gsq_vgq_esv","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m001-0088","start":88,"end":89,"surface":"賜","kind":"person","person_id":"7c4_6v2_yvm","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p029","text":"初，衞靈公有寵姬曰南子。靈公太子蕢聵得過南子，懼誅出奔。及靈公卒而夫人欲立公子郢。郢不肯，曰：「亡人太子之子輒在。」於是衞立輒爲君，是爲出公。出公立十二年，其父蕢聵居外，不得入。子路爲衞大夫孔悝之邑宰。蕢聵乃與孔悝作亂，謀入孔悝家，遂與其徒襲攻出公。出公奔魯，而蕢聵入立，是爲莊公。方孔悝作亂，子路在外，聞之而馳往。遇子羔出衞城門，謂子路曰：「出公去矣，而門已閉，子可還矣，毋空受其禍。」子路曰：「食其食者不避其難。」子羔卒去。有使者入城，城門開，子路隨而入。造蕢聵，蕢聵與孔悝登臺。子路曰：「君焉用孔悝？請得而殺之。」蕢聵弗聽。於是子路欲燔臺，蕢聵懼，乃下石乞、壺黶攻子路，擊斷子路之纓。子路曰：「君子死而冠不免。」遂結纓而死。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m029-0002","start":2,"end":5,"surface":"衞靈公","kind":"person","person_id":"xqw_bie_izn","status":"co