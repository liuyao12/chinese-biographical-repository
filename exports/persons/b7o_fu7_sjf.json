ji-067-disciples:m029-0285","start":285,"end":287,"surface":"子路","kind":"person","person_id":"cgc_imx_hn5","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m029-0290","start":290,"end":292,"surface":"子路","kind":"person","person_id":"cgc_imx_hn5","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m029-0295","start":295,"end":297,"surface":"子路","kind":"person","person_id":"cgc_imx_hn5","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p084","text":"髙柴字子羔。少孔子三十歳。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m084-0000","start":0,"end":2,"surface":"髙柴","kind":"person","person_id":"b7o_fu7_sjf","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m084-0003","start":3,"end":5,"surface":"子羔","kind":"person","person_id":"b7o_fu7_sjf","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m084-0007","start":7,"end":9,"surface":"孔子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p085","text":"子羔長不盈五尺，受業孔子，孔子以爲愚。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m085-0000","start":0,"end":2,"surface":"子羔","kind":"person","person_id":"b7o_fu7_sjf","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m085-0010","start":10,"end":12,"surface":"孔子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m085-0013","start":13,"end":15,"surface":"孔子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"},{"id":"c-shiji-067-disciples:p086","text":"子路使子羔爲費郈宰，孔子曰：「賊夫人之子！」子路曰：「有民人焉，有社稷焉，何必讀書然後爲學！」孔子曰：「是故惡夫佞者。」","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-067-disciples:m086-0000","start":0,"end":2,"surface":"子路","kind":"person","person_id":"cgc_imx_hn5","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m086-0003","start":3,"end":5,"surface":"子羔","kind":"person","person_id":"b7o_fu7_sjf","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m086-0010","start":10,"end":12,"surface":"孔子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m086-0016","start":16,"end":20,"surface":"夫人之子","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m086-0022","start":22,"end":24,"surface":"子路","kind":"person","person_id":"cgc_imx_hn5","status":"contextual_provisional"},{"id":"c-shiji-067-disciples:m086-0028","start":28,"end":30,"surface":"民人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、未名者或未定指代，未補姓名、成員或親屬；譬喻與未遂取室不作已確證家屬。"},{"id":"c-shiji-067-disciples:m086-0047","start":47,"end":49,"surface":"孔子","kind":"person","person_id":"0xl_7ir_tmn","status":"contextual_provisional"}],"chapter_id":"c-shiji-067-disciples","book_id":"b-shiji-067","work_id":"w-shiji","source_id":"s-shiji-067-disciples"}],"sources":[{"chapter_id":"c-shiji-067-disciples","work_id":"w-shiji","book_id":"b-shiji-067","source_id":"s-shiji-067-disciples","source":{"title":"史記／卷067","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷067","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷067&oldid=7869003","revision_id":7869003,"accessed_on":"2026-10-09","extent":"152段正文，自孔子曰受業身通者至太史公論贊；排除ws-header中的導覽名單、後附索隱述贊及現代版權告示。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/