116,"surface":"衛氏","kind":"unresolved","person_id":null,"status":"unresolved"}],"chapter_id":"c-shiji-111-wei-huo","book_id":"b-shiji-111","work_id":"w-shiji","source_id":"s-shiji111-wei-huo"},{"id":"c-shiji-111-wei-huo:p003","text":"青壯，為侯家騎，從平陽主。建元二年春，青姊子夫得入宮幸上。皇后，堂邑大長公主女也，無子，妒。大長公主聞衛子夫幸，有身，妒之，乃使人捕青。青時給事建章，未知名。大長公主執囚青，欲殺之。其友騎郎公孫敖與壯士往篡取之，以故得不死。上聞，乃召青為建章監，侍中，及同母昆弟貴，賞賜數日閒累千金。孺為太僕公孫賀妻。少兒故與陳掌通，上召貴掌。公孫敖由此益貴。子夫為夫人。青為大中大夫。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-111-wei-huo:m003-0000","start":0,"end":1,"surface":"青","kind":"person","person_id":"6z2_ipx_avk","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0004","start":4,"end":5,"surface":"侯","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-111-wei-huo:m003-0009","start":9,"end":12,"surface":"平陽主","kind":"person","person_id":"ov6_n6f_jka","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0019","start":19,"end":20,"surface":"青","kind":"person","person_id":"6z2_ipx_avk","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0021","start":21,"end":23,"surface":"子夫","kind":"person","person_id":"wli_blb_o53","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0027","start":27,"end":28,"surface":"上","kind":"person","person_id":"3fp_1n5_jvi","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0029","start":29,"end":31,"surface":"皇后","kind":"person","person_id":"5h9_hid_7gc","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0032","start":32,"end":38,"surface":"堂邑大長公主","kind":"person","person_id":"z0x_g24_g28","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0046","start":46,"end":50,"surface":"大長公主","kind":"person","person_id":"z0x_g24_g28","status":"contextual_provisional"},{"id":"c-shiji-111-wei-huo:m003-0051","start":51,"end":54,"surface":"衛子夫","kind":"person","person_id":"wli_blb_o53","status":"contextual_provisional"},{"id":"c-shiji-111-