404,12405,12754,12755,12756,12757,12758,12759,12760,12761,12762,12763,12764,12765,12766,12767,12768,12776,12777,12780,12781,12782,12783,12784,12785,12786,12787,12788,12789,12790,12791,12792,12793,12794,12795,12796,12797,12798,12799,12800],"revision_id":2602668},"mentions":[{"id":"c-sanguozhi-047-sun-quan:p058:m0010","surface":"孫邵","start":10,"end":12,"kind":"person","person_id":"pte_u94_orp","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p058:m0020","surface":"顧雍","start":20,"end":22,"kind":"person","person_id":"syc_ik6_bq5_**A","status":"contextual_provisional"},{"id":"c-sanguozhi-047-sun-quan:p058:m0041","surface":"彭綺","start":41,"end":43,"kind":"person","person_id":"fmk_v82_0t4","status":"contextual_provisional"}],"chapter_id":"c-sanguozhi-047-sun-quan","book_id":"b-sanguozhi-047","work_id":"w-sanguozhi","source_id":"s-sanguozhi-047-sun-quan-ws2602668"},{"id":"c-sanguozhi-047-sun-quan:p059","text":"吳錄曰：邵字長緒，北海人，長八尺。爲孔融功曹，融稱曰「廊廟才也」。從劉繇於江東。及權統事，數陳便宜，以爲應納貢聘，權即從之。拜廬江太守，遷車騎長史。黃武初爲丞相，威遠將軍，封陽羨侯。張温、暨艷奏其事，邵辭位請罪，權釋令復職，年六十三卒。志林曰：吳之創基，邵爲首相，史無其傳，竊常怪之。嘗問劉聲叔。聲叔，博物君子也，云：「推其名位，自應立傳。項竣、（吳孚）〔丁孚〕時已有注記，此云與張惠恕不能。後韋氏作史，蓋惠恕之黨，故不見書。」","text_layer":"witness_appended_pei_songzhi_note","annotation_status":"reviewed","source_position":{"first_line":65,"last_line":65,"raw_start":12161,"raw_end":12383,"raw_character_offsets":[12161,12162,12163,12164,12165,12166,12167,12168,12169,12170,12171,12172,12173,12174,12175,12176,12177,12178,12179,12180,12181,12182,12183,12184,12185,12186,12187,12188,12189,12190,12191,12192,12193,12194,12195,12196,12197,12198,12199,12200,12201,12202,12203,12204,12205,12206,12207,12208,12209,12210,12211,12212,12213,12214,12215,12216,12217,12218,12219,12220,12221,12222,12223,12224,12225,12226,12227,12228,12229,12230,12231,12232,12233,12234,12235,12236,12237,12238,12239,12240,12241,12242,12243,12244,12245,12246,12247,12248,12249,12250,12251,12252,12253,12254,12255,12256,12257,12258,12259,12260,12261,12262,12263,12264,12265,12266,12267,12268,12269,12270,