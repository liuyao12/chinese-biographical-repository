:"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p015","quote":"少君"},{"mention_id":"c-shiji-049-waiqi:m016-0036","chapter_id":"c-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p016","quote":"廣國"}],"id_aliases":["cbr-p003067"]}],"source_mention_summary":[{"source_id":"s-shiji-049-waiqi","work_id":"w-shiji","book_id":"b-shiji-049","chapter_id":"c-shiji-049-waiqi","mention_count":7,"mention_ids":["c-shiji-049-waiqi:m014-0010","c-shiji-049-waiqi:m014-0015","c-shiji-049-waiqi:m014-0018","c-shiji-049-waiqi:m014-0081","c-shiji-049-waiqi:m014-0121","c-shiji-049-waiqi:m015-0068","c-shiji-049-waiqi:m016-0036"],"paragraph_ids":["c-shiji-049-waiqi:p014","c-shiji-049-waiqi:p015","c-shiji-049-waiqi:p016"],"passage_count":3},{"source_id":"s-shiji-096-zhang","work_id":"w-shiji","book_id":"b-shiji-096","chapter_id":"c-shiji-096-zhang","mention_count":3,"mention_ids":["c-shiji-096-zhang:m016-0117","c-shiji-096-zhang:m016-0133","c-shiji-096-zhang:m016-0137"],"paragraph_ids":["c-shiji-096-zhang:p016"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-049-waiqi"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji049-014","subject_person_id":"xoj_go3_gl0","predicate":"brother","object_person_id":"ixk_6fg_v6f_A","status":"source_attested","evidence":[{"chapter_id":"c-shiji-049-waiqi","source_id":"s-shiji-049-waiqi","paragraph_id":"c-shiji-049-waiqi:p014","quote":"竇皇后兄竇長君，弟曰竇廣國，字少君。少君年四五歲時，家貧，為人所略賣，其家不知其處。傳十餘家，至宜陽，為其主入山作炭，（寒）［暮］臥岸下百餘人，岸崩，盡壓殺臥者，少君獨得脫，不死。自卜數日當為侯，從其家之長安。聞竇皇后新立，家在觀津，姓竇氏。廣國去時雖小，識其縣名及姓，又常與其姊採桑墮，用為符信，上書自陳。竇皇后言之於文帝，召見，問之，具言其故，果是。又復問他何以為驗？對曰：「姊去我西時，與我決於傳舍中，丐沐沐我，請食飯我，乃去。」於是竇后持之而泣，泣涕交橫下。侍御左右皆伏地泣，助皇后悲哀。乃厚賜田宅金錢，封公昆弟，家於長安。"}],"qualifiers":{"source_term":"弟曰竇廣國","historicity":"historical_tradition"},"interpretation_note":"按明示子女、生、母、兄弟姊及婚姻的局部敘事保存；祖孫不作父子，不補未名者姓名。衛青子數各層原語並存，親屬判讀不代表數量已核定。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji096-009","subject_person_id":"3tp_ab0_hlx","predicate":"brother","object_person_id":"6af_362_yyq","status":"source_attested","evidence":[{"chapter_id":"c-shiji-096-zhang","source_id":"s-shiji-096-zhang","paragraph_id":"c-shiji-096-zhang:p016","quote":"申屠丞相嘉者，梁人，以材官蹶張從高帝擊項籍，遷為隊率。從擊黥布軍，為都尉。孝惠時，為淮陽守。孝文帝元年，舉故吏士二千石從高皇帝者，悉以為關內侯，食邑二十四人，而申屠嘉食邑五百戶。張蒼已為丞相，嘉遷為御史大夫。張蒼免相，孝文帝欲用皇后弟竇廣國為丞相，曰：「恐天下以吾私廣國。」廣國賢有行，故欲相之，念久之不可，而高帝時大臣又皆多死，餘見無可者，乃以御史大夫嘉為丞相，因故邑封為故安侯。"}],"qualifiers":{"source_term":"皇后弟竇廣國","historicity":"historical_tradition","relative_birth_order":{"older_person_id":"6af_362_yyq","younger_person_id":"3tp_ab0_hlx","operator":"lt","older_ordinal":null,"younger_ordinal":null,"scope":"siblings","interpretation_status":"source_attested","comparison_basis":"birth_chronology"}},"interpretation_note":"按原文明示親屬保存；父事不作生父，繼位不自行推父子，不補闕代或同母。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-049-waiqi:m014-0010","start":10,"end":13,"surface":"竇廣國","kind":"person","person_id":"xoj_go3_gl0","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p014","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m014-0015","start":15,"end":17,"surface":"少君","kind":"person","person_id":"xoj_go3_gl0","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p014","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m014-0018","start":18,"end":20,"surface":"少君","kind":"person","person_id":"xoj_go3_gl0","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p014","chapter_id":"c-shiji-049-waiqi"},{"id":"c-shiji-049-waiqi:m014-0081","start":81,"end":83,"surface":"少君","kind":"person","person_id":"xoj_go3_gl0","status":"contextual_provisional","paragraph_id":"c-shiji-049-waiqi:p014","chapter_id":"c