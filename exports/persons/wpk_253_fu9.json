"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-052-zhugerong-complete:line080:m0204","start":204,"end":206,"surface":"孫壹","kind":"person","person_id":"wpk_253_fu9","status":"contextual_provisional","interpretation_note":"以來源原字標記。","paragraph_id":"c-sanguozhi-052-zhugerong-complete:line080","chapter_id":"c-sanguozhi-052-zhugerong-complete"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-052-zhugerong-complete:line080","text":"恪已自封侯，故弟融襲爵。攝兵業駐公安，部曲吏士親附之。疆外無事，秋冬則射獵講武，春夏則延賓高會，休吏假卒，或不遠千里而造焉。每會輒歷問賓客，各言其能，乃合榻促席，量敵選對，或有博弈，或有摴蒱，投壺弓彈，部別類分，於是甘果繼進，清酒徐行，融周流觀覽，終日不倦。融父兄質素，雖在軍旅，身無采飾；而融錦罽文繡，獨爲奢綺。孫權薨，徙奮威將軍。後恪征淮南，假融節，令引軍入沔，以擊西兵。恪既誅，遺無難督施寬就將軍施績、孫壹、全熙等取融。融卒聞兵士至，惶懼猶豫，不能決計，兵到圍城，飲藥而死，三子皆伏誅。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-sanguozhi-052-zhugerong-complete:line080:m0000","start":0,"end":1,"surface":"恪","kind":"person","person_id":"512_1cd_a4b","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugerong-complete:line080:m0008","start":8,"end":9,"surface":"融","kind":"person","person_id":"lpo_z63_vzb_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugerong-complete:line080:m0118","start":118,"end":119,"surface":"融","kind":"person","person_id":"lpo_z63_vzb_B","status":"contextual_provisional","interpretation_note":"以來源原字標記。"},{"id":"c-sanguozhi-052-zhugerong-complete:line080:m0129","start":129,"end":130,"surface":"融","kind":"person","person_id":"lpo_z63_vzb_B","status":"contextual_prov