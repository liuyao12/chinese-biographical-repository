ine049"],"table_cell_ids":[],"passage_count":1}],"most_mentioned_source_ids":["s-songshu-053-yu-dengzhi"],"mention_count_policy":{"scope":"currently_annotated_mentions","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-yu-batch-020","subject_person_id":"dae_159_a76","predicate":"brother","object_person_id":"a11_d36_c74_DBA","status":"source_attested","qualifiers":{"source_term":"弟炳之","relative_birth_order":{"older_person_id":"a11_d36_c74_DBA","younger_person_id":"dae_159_a76","operator":"lt","scope":"siblings","older_ordinal":null,"younger_ordinal":null}},"evidence":[{"work_id":"w-songshu","book_id":"b-songshu-053","chapter_id":"c-songshu-053-yu-dengzhi","source_id":"s-songshu-053-yu-dengzhi","paragraph_id":"c-songshu-053-yu-dengzhi:line049","quote":"元嘉五年，起為衡陽王義季征虜長史。義季年少，未親政，眾事一以委之。尋加南東海太守。入為司徒右長史，尚書吏部郎，司徒左長史，南東海太守。府公彭城王義康專覽政事，不欲自下厝懷，而登之性剛，每陳己意，義康甚不悅，出為吳郡太守。州郡相臨，執意無改，因其莅任贓貨，以事免官。弟炳之時為臨川內史，登之隨弟之郡，優游自適。俄而除豫章太守，便道之官。登之初至臨川，吏民咸相輕侮，豫章與臨川接境，郡又華大，儀迓光赫，土人並驚歎焉。十八年，遷江州刺史。疾篤，徵為中護軍，未拜。二十年，卒，時年六十二。即以為贈。","subject_person_mention_id":"c-songshu-053-yu-dengzhi:line049:m0133","object_person_mention_id":"c-songshu-053-yu-dengzhi:line049:m0031"}],"interpretation_note":"只保存該句直接支持之親屬種類；不由兄弟推出父親或同母，不由並列推出絕對排行。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-songshu-053-yu-dengzhi:line049:m0133","start":133,"end":135,"surface":"炳之","kind":"person","person_id":"dae_159_a76","status":"contextual_provisional","paragraph_id":"c-songshu-053-yu-dengzhi:line049","chapter_id":"c-songshu-053-yu-dengzhi"}],"relations":[{"id":"a-yu-batch-020","subject_person_id":"dae_159_a76","predic