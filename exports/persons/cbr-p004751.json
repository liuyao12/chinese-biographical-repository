{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p004751","canonical_person_id":"otx_w5y_yup","id_aliases":["cbr-p004751"],"identity_policy":"contextual_provisional","person_ids":["otx_w5y_yup"],"persons":[{"id":"otx_w5y_yup","label":"武引古短稱（屈原賈生列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"武","mention_ids":["c-shiji-084-qujia:m003-0204"]}],"evidence":[{"mention_id":"c-shiji-084-qujia:m003-0204","chapter_id":"c-shiji-084-qujia","paragraph_id":"c-shiji-084-qujia:p003","quote":"武"}],"id_aliases":["cbr-p004751"]}],"source_mention_summary":[{"source_id":"s-shiji-084-qujia","work_id":"w-shiji","book_id":"b-shiji-084","chapter_id":"c-shiji-084-qujia","mention_count":1,"mention_ids":["c-shiji-084-qujia:m003-0204"],"paragraph_ids":["c-shiji-084-qujia:p003"],"passage_count":1}],"most_mentioned_source_ids":["s-shiji-084-qujia"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-084-qujia:m003-0204","start":204,"end":205,"surface":"武","kind":"person","person_id":"otx_w5y_yup","status":"contextual_provisional","paragraph_id":"c-shiji-084-qujia:p003","chapter_id":"c-shiji-084-qujia"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji084-007","person_id":"otx_w5y_yup","surfaces":["武"],"scope":"same_chapter","chapter_ids":["c-shiji-084-qujia"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-084-qujia:p003","quote":"屈平疾王聽之不聰也，讒諂之蔽明也，邪曲之害公也，方正之不容也，故憂愁幽思而作《離騷》。離騷者，猶離憂也。夫天者，人之始也；父母者，人之本也。人窮則反本，故勞苦倦極，未嘗不呼天也；疾痛慘怛，未嘗不呼父母也。屈平正道直行，竭忠盡智以事其君，讒人間之，可謂窮矣。信而見疑，忠而被謗，能無怨乎？屈平之作《離騷》，蓋自怨生也。《國風》好色而不淫，《小雅》怨誹而不亂。若《離騷》者，可謂兼之矣。上稱帝嚳，下道齊桓，中述湯武，以刺世事。明道德之廣崇，治亂之條貫，靡不畢見。其文約，其辭微，其志絜，其行廉。其稱文小而其指極大，舉類邇而見義遠。其志絜，故其稱物芳；其行廉，故死而不容自疏。濯淖汙泥之中，蟬蛻於濁穢，以浮游塵埃之外，不獲世之滋垢，皭然泥而不滓者也。推此志也，雖與日月爭光可也。"}],"rationale":"依前5段明示屈原名平、屈平與懷王張儀敘事暫接；湯武短稱各存，未補姓名。王、臣、吾等嵌套指代仍待逐處核定。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-084-qujia:p003","text":"屈平疾王聽之不聰也，讒諂之蔽明也，邪曲之害公也，方正之不容也，故憂愁幽思而作《離騷》。離騷者，猶離憂也。夫天者，人之始也；父母者，人之本也。人窮則反本，故勞苦倦極，未嘗不呼天也；疾痛慘怛，未嘗不呼父母也。屈平正道直行，竭忠盡智以事其君，讒人間之，可謂窮矣。信而見疑，忠而被謗，能無怨乎？屈平之作《離騷》，蓋自怨生也。《國風》好色而不淫，《小雅》怨誹而不亂。若《離騷》者，可謂兼之矣。上稱帝嚳，下道齊桓，中述湯武，以刺世事。明道德之廣崇，治亂之條貫，靡不畢見。其文約，其辭微，其志絜，其行廉。其稱文小而其指極大，舉類邇而見義遠。其志絜，故其稱物芳；其行廉，故死而不容自疏。濯淖汙泥之中，蟬蛻於濁穢，以浮游塵埃之外，不獲世之滋垢，皭然泥而不滓者也。推此志也，雖與日月爭光可也。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-084-qujia:m003-0000","start":0,"end":2,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0061","start":61,"end":63,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m003-0098","start":98,"end":100,"surface":"父母","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m003-0102","start":102,"end":104,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0118","start":118,"end":120,"surface":"讒人","kind":"unresolved","person_id":null,"status":"unresolved","note":"群體、泛論或未定指代保留。"},{"id":"c-shiji-084-qujia:m003-0143","start":143,"end":145,"surface":"屈平","kind":"person","person_id":"qpw_pw5_eqn","status":"contextual_provisional"},{"id":"c-shiji-084-qujia:m003-0193","start":193,"end":195,"surface":"帝嚳","kind":"person","person_id":"irt_r82_b3b","status":"contextual_provisional"},{"id":"c-shi