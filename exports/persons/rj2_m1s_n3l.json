漢》；裴頠論前言往行，袞袞可聽；王戎談子房、季劄之間，超然玄著。」其為識鑒者所賞如此。","text_layer":"received_chapter","annotation_status":"named_mentions_first_pass","mentions":[{"id":"c-jinshu-043-wangrong:p002:m0000","start":0,"end":2,"surface":"阮籍","kind":"person","person_id":"6d5_075_29b","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0003","start":3,"end":4,"surface":"渾","kind":"person","person_id":"rj2_m1s_n3l","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0007","start":7,"end":8,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0013","start":13,"end":14,"surface":"渾","kind":"person","person_id":"rj2_m1s_n3l","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0018","start":18,"end":19,"surface":"戎","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0020","start":20,"end":21,"surface":"籍","kind":"person","person_id":"6d5_075_29b","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0026","start":26,"end":27,"surface":"籍","kind":"person","person_id":"6d5_075_29b","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0028","start":28,"end":29,"surface":"之","kind":"person","person_id":"48e_04a_3d8","status":"contextual_provisional","resolution_note":"籍與十五歲戎交。"},{"id":"c-jinshu-043-wangrong:p002:m0031","start":31,"end":32,"surface":"籍","kind":"person","person_id":"6d5_075_29b","status":"contextual_provisional","resolution_note":"渾/籍/戎三端對話分辨；王濟轉述張華、裴頠與引古子房季劄。"},{"id":"c-jinshu-043-wangrong:p002:m0034","start":34,"end":35,"surface":