isions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-005-qin:m065-0031","start":31,"end":34,"surface":"公子卬","kind":"person","person_id":"bjd_so0_6y9","status":"contextual_provisional","paragraph_id":"c-shiji-005-qin:p065","chapter_id":"c-shiji-005-qin"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-005-qin:p061","text":"二十二年，衛鞅擊魏，虜魏公子卬。封鞅為列侯，號商君。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m061-0005","start":5,"end":7,"surface":"衛鞅","kind":"person","person_id":"2wp_usr_ncd","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m061-0011","start":11,"end":15,"surface":"魏公子卬","kind":"person","person_id":"apz_fp8_twe","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m061-0017","start":17,"end":18,"surface":"鞅","kind":"person","person_id":"2wp_usr_ncd","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m061-0023","start":23,"end":25,"surface":"商君","kind":"person","person_id":"2wp_usr_ncd","status":"source_identified"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-005-qin:p065","text":"五年，陰晉人犀首為大良造。六年，魏納陰晉，陰晉更名寧秦。七年，公子卬與魏戰，虜其將龍賈，斬首八萬。八年，魏納河西地。九年，渡河，取汾陰、皮氏。與魏王會應。圍焦，降之。十年，張儀相秦。魏納上郡十五縣。十一年，縣義渠。歸魏焦、曲沃。義渠君為臣。更名少梁曰夏陽。十二年，初臘。十三年四月戊午，魏君為王，韓亦為王。使張儀伐取陜，出其人與魏。","annotation_status":"in_progress","mentions":[{"id":"c-shiji-005-qin:m065-0006","start":6,"end":8,"surface":"犀首","kind":"person","person_id":"naf_s08_xqw","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m065-0031","start":31,"end":34,"surface":"公子卬","kind":"person","person_id":"bjd_so0_6y9","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m065-0041","start":41,"end":43,"surface":"龍賈","kind":"person","person_id":"bb8_fpc_b3e","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m065-0072","start":72,"end":74,"surface":"魏王","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m065-0086","start":86,"end":88,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m065-0114","start":114,"end":117,"surface":"義渠君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m065-0143","start":143,"end":145,"surface":"魏君","kind":"unresolved","person_id":null,"status":"unresolved","note":"官稱、氏族、群體或未核指代；不補造個人或按熟知世系自動合併。"},{"id":"c-shiji-005-qin:m065-0154","start":154,"end":156,"surface":"張儀","kind":"person","person_id":"uq6_74z_vtv","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"}],"sources":[{"chapter_id":"c-shiji-005-qin","work_id":"w-shiji","book_id":"b-shiji-005","source_id":"s-shiji-005-qin","source":{"title":"史記／卷005","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷005","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷005&oldid=8744286","revision_id":8744286,"accessed_on":"2026-10-09","extent":"77段數位正文；排除註釋版導覽與註號，見證行內校勘符號暫原樣保留。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫 CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"铚":"銍","绖":"絰","龁":"齕"},"note":"第9段編者重複標記另存，其餘行內校勘符號仍待逐處分離；不稱已核讀底本。","editorial_readings":[{"paragraph_id":"c-shiji-005-qin:p009","witness_form":"（世父）世父","body_reading":"世父","note":"數位見證重複的括號標記另存；不作第二個正文人物提及。"},{"paragraph_id":"c-shiji-005-qin:p022","witness_form":"铚","body_reading":"銍","note":"數位見證混入簡體字，轉繁體並保留字形轉換記錄；未核讀影像。"},{"paragraph_id":"c-shiji-005-qi