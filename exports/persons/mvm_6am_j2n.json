":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[{"id":"a-shiji001-031","subject_person_id":"mvm_6am_j2n","predicate":"father","object_person_id":"ddb_l4j_4j2","status":"source_attested","evidence":[{"chapter_id":"c-shiji-001-wudi","source_id":"s-shiji-001-wudi","paragraph_id":"c-shiji-001-wudi:p026","quote":"舜年二十以孝聞，年三十堯舉之，年五十攝行天子事，年五十八堯崩，年六十一代堯踐帝位。踐帝位三十九年，南巡狩，崩於蒼梧之野。葬於江南九疑，是爲零陵。舜之踐帝位，載天子旗，往朝父瞽叟，夔夔唯謹，如子道。封弟象爲諸侯。舜子商均亦不肖，舜乃豫薦禹於天。十七年而崩。三年喪畢，禹亦乃讓舜子，如舜讓堯子。諸侯歸之，然後禹踐天子位。堯子丹朱，舜子商均，皆有疆土，以奉先祀。服其服，禮樂如之。以客見天子，天子弗臣，示不敢專也。"}],"qualifiers":{"source_term":"舜子商均"},"interpretation_note":"逐句保存上古傳說的親屬陳述，不作史實確證，不因繼位推父子；後妻為象生母，不是舜生母。其他篇同關係另有來源，不替換原有證據。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji002-008","subject_person_id":"mvm_6am_j2n","predicate":"father","object_person_id":"ddb_l4j_4j2","status":"source_attested","evidence":[{"chapter_id":"c-shiji-002-xia","source_id":"s-shiji-002-xia","paragraph_id":"c-shiji-002-xia:p026","quote":"舜之子商均"}],"qualifiers":{"source_term":"子","historicity":"legendary_tradition"},"interpretation_note":"僅記來源明示的親屬關係，不把繼位推成父子。","reviewer":"Codex（AI 代理）"},{"id":"a-shiji036-002","subject_person_id":"mvm_6am_j2n","predicate":"father","object_person_id":"ddb_l4j_4j2","status":"source_attested","evidence":[{"chapter_id":"c-shiji-036-chenqi","source_id":"s-shiji-036-chenqi","paragraph_id":"c-shiji-036-chenqi:p001","quote":"陳胡公滿者，虞帝舜之後也。昔舜為庶人時，堯妻之二女，居于媯汭，其後因為氏姓，姓媯氏。舜已崩，傳禹天下，而舜子商均為封國。夏后之時，或失或續。至于周武王克殷紂，乃復求舜後，得媯滿，封之於陳，以奉帝舜祀，是為胡公。"}],"qualifiers":{"source_term":"舜子","historicity":"historical_tradition"},"interpretation_note":"保存本篇明示子、生、妻、兄弟及祖先原稱；不由繼位補父子，不把舜／禹之後改直接父親，不補世系闕代或同父同母。未核底本與現代研究，來源主張不表示已確證史實。","reviewer":"Codex（AI 代理）"}],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"