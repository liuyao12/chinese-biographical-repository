provisional"},{"id":"c-shiji-039-jin:m096-0037","start":37,"end":39,"surface":"先軫","kind":"person","person_id":"cbr-p001742","status":"contextual_provisional"}],"chapter_id":"c-shiji-039-jin","book_id":"b-shiji-039","work_id":"w-shiji","source_id":"s-shiji-039-jin"}],"sources":[{"chapter_id":"c-shiji-039-jin","work_id":"w-shiji","book_id":"b-shiji-039","source_id":"s-shiji-039-jin","source":{"title":"史記／卷039","provider":"維基文庫","url":"https://zh.wikisource.org/wiki/史記/卷039","permalink":"https://zh.wikisource.org/w/index.php?title=史記/卷039&oldid=2588534","revision_id":2588534,"accessed_on":"2026-10-09","extent":"142段正文，自晉唐叔虞至太史公論贊，另保留1段索隱述贊並分層；排除2個dd導覽及段首尾版面換行。","image_verified":false,"rights":"古代原文；數位轉錄依維基文庫CC BY-SA 4.0，保留署名及固定版本。","license_url":"https://creativecommons.org/licenses/by-sa/4.0/","normalization":{"character_conversion":{"鲁":"魯","隐":"隱","绖":"絰"},"editorial_readings":[],"extraction_note":"固定版本與實讀HTML一致。第14段鲁隐轉魯隱，第46、79段绖轉絰，去除段首尾換行，其餘古字、內外異說及校勘保留。","note":"同版原始標記亦作子胛桓叔，不默補代字或莊伯名字。保留冀芮／郤芮、郤鉤、欒逞、示瞇明、歩陽、郤臻、砹、六（卿）［軍］、［復］等見證字；未核可靠底本、影像或專門研究。"}}}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical"}}
