id":"c-shiji-005-qin:m070-0985","start":985,"end":989,"surface":"五大夫陵","kind":"person","person_id":"cbr-p000525","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1005","start":1005,"end":1006,"surface":"陵","kind":"person","person_id":"cbr-p000525","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1007","start":1007,"end":1008,"surface":"陵","kind":"person","person_id":"cbr-p000525","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1014","start":1014,"end":1016,"surface":"王齕","kind":"person","person_id":"cbr-p000523","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1023","start":1023,"end":1027,"surface":"將軍張唐","kind":"person","person_id":"cbr-p000526","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1031","start":1031,"end":1034,"surface":"蔡尉捐","kind":"person","person_id":"cbr-p000527","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1047","start":1047,"end":1052,"surface":"武安君白起","kind":"person","person_id":"cbr-p000303","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1063","start":1063,"end":1065,"surface":"張唐","kind":"person","person_id":"cbr-p000526","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1083","start":1083,"end":1088,"surface":"武安君白起","kind":"person","person_id":"cbr-p000303","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1093","start":1093,"end":1094,"surface":"齕","kind":"person","person_id":"cbr-p000523","status":"contextual_provisional"},{"id":"c-shiji-005-qin:m070-1135","start":1135,"end":1136,"surface":"唐","kind":"person","person_id":"cbr-p000526","status":"contextual_provisional"}],"chapter_id":"c-shiji-005-qin","book_id":"b-shiji-005","work_id":"w-shiji","source_id":"s-shiji-005-qin"},{"id":"c-shiji-072-rang:p004","text":"欲誅呂禮，禮出奔齊。昭王十四年，魏冉舉白起，使代向壽將而攻韓、魏，敗之伊闕，斬首二十四萬，虜魏將公孫喜。明年，又取楚之宛、葉。魏冉謝病免相，以客卿壽燭為相。其明年，燭免，復相冉，乃封魏冉於穰，復益封陶，號曰穰侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-072-rang:m004-0002","start":2,"end":4,"surface":"呂禮","kind":"person","person_id":"cbr-p004211","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0005","start":5,"end":6,"surface":"禮","kind":"person","person_id":"cbr-p004211","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0010","start":10,"end":12,"surface":"昭王","kind":"person","person_id":"cbr-p004198","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0016","start":16,"end":18,"surface":"魏冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0019","start":19,"end":21,"surface":"白起","kind":"person","person_id":"cbr-p004212","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0024","start":24,"end":26,"surface":"向壽","kind":"person","person_id":"cbr-p004213","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0046","start":46,"end":51,"surface":"魏將公孫喜","kind":"person","person_id":"cbr-p004214","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0063","start":63,"end":65,"surface":"魏冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0071","start":71,"end":75,"surface":"客卿壽燭","kind":"person","person_id":"cbr-p004215","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0082","start":82,"end":83,"surface":"燭","kind":"person","person_id":"cbr-p004215","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0087","start":87,"end":88,"surface":"冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0091","start":91,"end":93,"surface":"魏冉","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"},{"id":"c-shiji-072-rang:m004-0103","start":103,"end":105,"surface":"穰侯","kind":"person","person_id":"cbr-p004197","status":"contextual_provisional"}],"chapter_id":"c-shiji-072-rang","book_id":"b-shiji-072","work_id":"w-shiji","source_id":"s-shiji-072-rang"},{"id":"c-shiji-073-baiwang:p001","text":"白起者，郿人也。善用兵，事秦昭王。昭王十三年，而白起為左庶長，將而擊韓之新城。是歲，穰侯相秦，舉任鄙以為漢中守。其明年，白起為左更，攻韓、魏於伊闕，斬首二十四萬，又虜其將公孫喜，拔五城。起遷為國尉。涉河取韓安邑以東，到乾河。明年，白起為大良造。攻魏，拔之，取城小大六十一。明年，起與客卿錯攻垣城，拔之。後五年，白起攻趙，拔光狼城。後七年，白起攻楚，拔鄢、鄧五城。其明年，攻楚，拔郢，燒夷陵，遂東至竟陵。楚王亡去郢，東走徙陳。秦以郢為南郡。白起遷為武安君。武安君因取楚，定巫、黔中郡。昭王三十四年，白起攻魏，拔華陽，走芒卯，而虜三晉將，斬首十三萬。與趙將賈偃戰，沈其卒二萬人於河中。昭王四十三年，白起攻韓陘城，拔五城，斬首五萬。四十四年，白起攻南陽太行道，絕之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-073-baiwang:m001-0000","start":0,"end":2,"surface":"白起","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0013","start":13,"end":16,"surface":"秦昭王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0017","start":17,"end":19,"surface":"昭王","kind":"person","person_id":"cbr-p004233","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0024","start":24,"end":26,"surface":"白起","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0042","start":42,"end":44,"surface":"穰侯","kind":"person","person_id":"cbr-p004234","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0048","start":48,"end":50,"surface":"任鄙","kind":"person","person_id":"cbr-p004235","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0060","start":60,"end":62,"surface":"白起","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0085","start":85,"end":88,"surface":"公孫喜","kind":"person","person_id":"cbr-p004236","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0093","start":93,"end":94,"surface":"起","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-073-baiwang:m001-0115","start":115,"end":117,"surface":"白起","kind":"person","person_id":"cbr-p004232","status":"contextual_provisional"},{"id":"c-shiji-0