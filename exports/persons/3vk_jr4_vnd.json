{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"3vk_jr4_vnd","canonical_person_id":"3vk_jr4_vnd","id_aliases":["cbr-p005263"],"identity_policy":"contextual_provisional","person_ids":["3vk_jr4_vnd"],"persons":[{"id":"3vk_jr4_vnd","label":"齮（南陽守）（樊酈滕灌列傳候選）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"齮","mention_ids":["c-shiji-095-fankuang:m002-0298","c-shiji-095-fankuang:m022-0126"]}],"evidence":[{"mention_id":"c-shiji-095-fankuang:m002-0298","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p002","quote":"齮"},{"mention_id":"c-shiji-095-fankuang:m022-0126","chapter_id":"c-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p022","quote":"齮"}],"id_aliases":["cbr-p005263"]}],"source_mention_summary":[{"source_id":"s-shiji-095-fankuang","work_id":"w-shiji","book_id":"b-shiji-095","chapter_id":"c-shiji-095-fankuang","mention_count":2,"mention_ids":["c-shiji-095-fankuang:m002-0298","c-shiji-095-fankuang:m022-0126"],"paragraph_ids":["c-shiji-095-fankuang:p002","c-shiji-095-fankuang:p022"],"passage_count":2}],"most_mentioned_source_ids":["s-shiji-095-fankuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m002-0298","start":298,"end":299,"surface":"齮","kind":"person","person_id":"3vk_jr4_vnd","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p002","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m022-0126","start":126,"end":127,"surface":"齮","kind":"person","person_id":"3vk_jr4_vnd","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p022","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-013","person_id":"3vk_jr4_vnd","surfaces":["齮"],"scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-095-fankuang:p002","quote":"初從高祖起豐，攻下沛。高祖為沛公，以噲為舍人。從攻胡陵、方與，還守豐，擊泗水監豐下，破之。復東定沛，破泗水守薛西。與司馬夷戰碭東，卻敵，斬首十五級，賜爵國大夫。常從，沛公擊章邯軍濮陽，攻城先登，斬首二十三級，賜爵列大夫。復常從，從攻城陽，先登。下戶牖，破李由軍，斬首十六級，賜上閒爵。從攻圍東郡守尉於成武，卻敵，斬首十四級，捕虜十一人，賜爵五大夫。從擊秦軍，出亳南。河閒守軍於杠里，破之。擊破趙賁軍開封北，以卻敵先登，斬候一人，首六十八級，捕虜二十七人，賜爵卿。從攻破楊熊軍於曲遇。攻宛陵，先登，斬首八級，捕虜四十四人，賜爵封號賢成君。從攻長社、轘轅，絕河津，東攻秦軍於尸，南攻秦軍於犨。破南陽守齮於陽城。東攻宛城，先登。西至酈，以卻敵，斬首二十四級，捕虜四十人，賜重封。攻武關，至霸上，斬都尉一人，首十級，捕虜百四十六人，降卒二千九百人。"},{"paragraph_id":"c-shiji-095-fankuang:p022","quote":"潁陰侯灌嬰者，睢陽販繒者也。高祖之為沛公，略地至雍丘下，章邯敗殺項梁，而沛公還軍於碭，嬰初以中涓從擊破東郡尉於成武及秦軍於扛裏，疾鬬，賜爵七大夫。從攻秦軍亳南、開封、曲遇，戰疾力，賜爵執帛，號宣陵君。從攻陽武以西至雒陽，破秦軍尸北，北絕河津，南破南陽守齮陽城東，遂定南陽郡。西入武關，戰於藍田，疾力，至霸上，賜爵執珪，號昌文君。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p002","text":"初從高祖起豐，攻下沛。高祖為沛公，以噲為舍人。從攻胡陵、方與，還守豐，擊泗水監豐下，破之。復東定沛，破泗水守薛西。與司馬夷戰碭東，卻敵，斬首十五級，賜爵國大夫。常從，沛公擊章邯軍濮陽，攻城先登，斬首二十三級，賜爵列大夫。復常從，從攻城陽，先登。下戶牖，破李由軍，斬首十六級，賜上閒爵。從攻圍東郡守尉於成武，卻敵，斬首十四級，捕虜十一人，賜爵五大夫。從擊秦軍，出亳南。河閒守軍於杠里，破之。擊破趙賁軍開封北，以卻敵先登，斬候一人，首六十八級，捕虜二十七人，賜爵卿。從攻破楊熊軍於曲遇。攻宛陵，先登，斬首八級，捕虜四十四人，賜爵封號賢成君。從攻長社、轘轅，絕河津，東攻秦軍於尸，南攻秦軍於犨。破南陽守齮於陽城。東攻宛城，先登。西至酈，以卻敵，斬首二十四級，捕虜四十人，賜重封。攻武關，至霸上，斬都尉一人，首十級，捕虜百四十六人，降卒二千九百人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m002-0002","start":2,"end":4,"surface":"高祖","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m002-0011","start":11,"end":13,"surface":"高祖",