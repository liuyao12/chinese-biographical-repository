ntion_id":"c-nanqishu-051-pei-cui-zhang-complete:p015:m0127","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p015","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","quote":"覺"},{"mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p017:m0132","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p017","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","quote":"覺"},{"mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p019:m0054","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p019","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","quote":"覺"},{"mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p020:m0121","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p020","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","quote":"覺"},{"mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p020:m0147","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p020","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","quote":"覺"},{"mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p020:m0160","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p020","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","quote":"覺"},{"mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p023:m0002","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p023","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","quote":"覺"},{"mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p024:m0002","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p024","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","quote":"覺"}],"review":"ai_provisional","identity_note":"崔覺（崔慧景子，南齊直閤將軍），見本組原文及身份互校。"}],"source_mention_summary":[{"source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716","work_id":"w-nanqishu","book_id":"b-nanqishu-051","chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","raw_mention_count":3,"mention_ids":["c-nanqishu-051-pei-cui-zhang-complete:p024:m0004","c-nanqishu-051-pei-cui-zhang-complete:p027:m0005","c-nanqishu-051-pei-cui-zhang-complete:p034:m0037"],"paragraph_ids":["c-nanqishu-051-pei-cui-zhang-complete:p024","c-nanqishu-051-pei-cui-zhang-complete:p027","c-nanqishu-051-pei-cui-zhang-complete:p034"],"table_cell_ids":[],"occurrence_groups":[{"canonical_mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p024:m0004","mention_ids":["c-nanqishu-051-pei-cui-zhang-complete:p024:m0004"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p027:m0005","mention_ids":["c-nanqishu-051-pei-cui-zhang-complete:p027:m0005"],"kind":"paragraph"},{"canonical_mention_id":"c-nanqishu-051-pei-cui-zhang-complete:p034:m0037","mention_ids":["c-nanqishu-051-pei-cui-zhang-complete:p034:m0037"],"kind":"paragraph"}],"mention_count":3,"duplicate_mention_count":0,"paragraph_occurrence_count":3,"table_occurrence_count":0,"passage_count":3,"passage_count_scope":"annotation_containers_not_independent_witness_passages","count_explanation":"3處獨立位置，3個原始錨點；0項為同底本同位置重出。頻次不是來源權威度。"}],"most_mentioned_source_ids":["s-nanqishu-051-pei-cui-zhang-complete-ws1504716"],"mention_count_policy":{"scope":"independent_fixed_witness_occurrences","raw_mentions_preserved":true,"passage_count_scope":"annotation_containers","explanation":"頻次依已驗同底本同位置去重；原始錨點完整保留，頻次不代表來源權威度。","included_kinds":["paragraph","table_cell"],"identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"source_reading_cases":[{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review24-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　覺弟偃，爲始安內史，藏竄得免。和帝西臺立，以爲寧朔將軍。中興元年，詣公車門上書曰：","reading":"覺弟偃任始安內史，西臺授寧朔，詣公車者在中興元年。","note":"覺弟偃任始安內史，西臺授寧朔，詣公車者在中興元年。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p024","start_codepoint":0,"end_codepoint":43,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review25-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　臣竊惟太祖、高宗之孝子忠臣，而昏主之賊臣亂子者，江夏王與陛下，先臣與鎮軍是也。臣聞堯舜之心，常以天下爲憂，而不以位爲樂。彼孑然之舜，壟畝之人，猶尚若此；況祖業之重，家國之切？江夏旣行之於前，陛下又蹈之於後，雖成敗異術，而所由同方也。","reading":"第一書先並舉江夏王、和帝及父慧景、鎮軍。保留奏者自身的判斷。","note":"第一書先並舉江夏王、和帝及父慧景、鎮軍。保留奏者自身的判斷。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p025","start_codepoint":0,"end_codepoint":118,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review26-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　陛下初登至尊，與天合符。天下纖介之屈，尚望陛下申之，絲髮之冤，尚望陛下理之。況先帝之子，陛下之兄，所行之道，卽陛下所由哉？如此尚弗恤，其餘何幾哉？陛下德侔造化，仁育羣生，雖在昆蟲草木，有不得其所者，覽而傷焉。而況乎友愛天至，孔懷之深。夫豈不懷，將以事割。此實左右不明，未之或詳。惟陛下公聽竝觀，以詢之芻蕘。羣臣有以臣言爲不可，乞使臣廷辯之。則天人之意塞，四海之疑釋。必若不然，僥小民之無識耳。使其曉然知此，相聚而逃，陛下以責江夏之冤，朝廷將何以應之哉？若天聽沛然回光，發惻愴之詔，而使東牟朱虛東褒儀父之節，則何戈之士，誰不盡死？愚戇之言，萬一上合，事乞留中。","reading":"第一書末以兄弟與冤屈進諫，請留中。","note":"第一書末以兄弟與冤屈進諫，請留中。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p026","start_codepoint":0,"end_codepoint":281,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review27-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"事寢不報。偃又上疏曰：","reading":"首書不報，以下另起第二疏。","note":"首書不報，以下另起第二疏。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p027","start_codepoint":0,"end_codepoint":11,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review28-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　近冒陳江夏之冤，定承聖詔，已有褒贈，此臣狂疏之罪也。然臣所以諮問者，不得其實，罪在萬沒，無所復云。但愚心所恨，非敢以父子之親，骨肉之閒，而僥幸曲陛下之法，傷至公之義。誠不曉聖朝所以然之意。若以狂主雖狂，而實是天子，江夏雖賢，實是人臣，先臣奉人臣逆人君，以爲不可申明詔，得矣；然未審陛下亦是人臣不？而鎮軍亦復奉人臣逆人君，今之嚴兵勁卒，方指於象魏者，其故何哉？臣所不死，苟存視息，非有他故，所以待皇運之開泰，申冤魂之枉屈。今皇運旣已開泰矣，而死於社稷盡忠，反以爲賊，臣何用此生陛下世矣。","reading":"第二疏以江夏王、和帝與兩方臣屬進退相問。","note":"第二疏以江夏王、和帝與兩方臣屬進退相問。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p028","start_codepoint":0,"end_codepoint":244,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review29-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　臣聞王臣之節，竭智盡公，以奉其上。居股肱之任者，申理冤滯，薦達羣賢。凡此衆臣，夙興夜寐，心未嘗須臾之閒而不在公。故萬物無不得其理，而頌聲作焉。臣謹案鎮軍將軍臣穎冑，宗室之親，股肱之重，身有伊、霍之功，荷陛下稷、旦之任。中領軍臣詳，受帷幄之寄，副宰相之尊。皆所以棟樑朝廷，社稷之臣，天下所當，遑遑匪懈，盡忠竭誠，欲使萬物得理，而頌聲大興者，豈復宜踰此哉？而同知先臣股肱江夏，匡濟王室，天命未遂，王亡與亡，而不爲陛下瞥然一言。知而不言，是不忠之臣，不知而言，乃不智之臣，此而不知，將何所知？","reading":"第二疏具名蕭穎冑等，所稱先臣為父慧景。","note":"第二疏具名蕭穎冑等，所稱先臣為父慧景。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p029","start_codepoint":0,"end_codepoint":245,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review30-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　如以江夏心異先臣，受制臣力，則江夏同致死斃，聽可昏政淫刑，見殘無道。然江夏之異，以何爲明，孔、呂二人，誰以爲戮。手御麾幡，言輙任公，同心共志，心若膠漆，而以爲異，臣竊惑焉。如以先臣遣使，江夏斬之，則征東之驛，何爲見戮？陛下斬征東之使，寔詐山陽；江夏違先臣之請，實謀孔矜。天命有歸，故事業不遂耳。夫唯聖人，乃知天命，守忠之臣，唯知盡死，安顧成敗。詔稱江夏遭時屯故，迹屈行令，內恕探情，無玷純節。今茲之旨，又何以處鎮軍哉？","reading":"第二疏論孔、呂和使者之死，與卷五十寶玄傳並觀。此是奏疏語境。","note":"第二疏論孔、呂和使者之死，與卷五十寶玄傳並觀。此是奏疏語境。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p030","start_codepoint":0,"end_codepoint":211,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review31-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　臣所言畢矣，乞就湯鑊。然臣雖萬沒，猶願陛下必申先臣。何則？惻愴而申之，則天下伏；不惻愴而申之，天下之人北面而事陛下者，徒以力屈耳。先臣之忠，有識所知，南史之筆，千載可期，亦何待陛下屈申而爲褒貶。然小臣惓惓之愚，爲陛下計耳。臣之所言，非孝於父，實忠於君。唯陛下孰察，少留心焉。","reading":"第二疏又陳先臣冤枉，敘父子君臣之辨仍依原句。","note":"第二疏又陳先臣冤枉，敘父子君臣之辨仍依原句。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p031","start_codepoint":0,"end_codepoint":139,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review32-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　臣頻觸宸嚴，而不彰露，所以每上封事者，非自爲戇地，猶以春秋之義有隱諱之意也。臣雖淺薄，然今日之事，斬足斷頭，殘身滅形，何所不能，爲陛下耳。臣聞生人之死，肉人之骨，有識之士，未爲多感。公聽竝觀，申人之冤，秉德任公，理人之屈，則普天之人，爭爲之死。何則？理之所不可以已也。陛下若引臣冤，免臣兄之罪，收往失，發惻愴之詔，懷可報之意，則桀之犬實可吠堯，跖之客實可刺由，又何況由之犬，堯之客。臣非生，實爲陛下重此名於天下。已成之基，可惜之寶，莫復是加。寖明寖昌，不可不循，寖微寖滅，不可不慎。惟陛下熟察，詳擇其衷。","reading":"第二疏言上封事及申冤益處。","note":"第二疏言上封事及申冤益處。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p032","start_codepoint":0,"end_codepoint":254,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review33-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"　　若陛下猶以爲疑，鎮軍未之允決，乞下征東共詳可否，無以向隅之悲，而傷陛下滿堂之樂。何則？陛下昏主之弟，江夏亦昏主之弟；鎮軍受遺託之恩，先臣亦荷顧命之重。情節無異，所爲皆同，殊者唯以成敗仰資聖朝耳。臣不勝愚忠，請使羣臣廷辯者，臣乞專令一人，精賜本語。僥幸萬一，天聽昭然，則軻沈七族，離燔妻子，人以爲難，臣豈不易。","reading":"第二疏末請群臣廷辯，征東、鎮軍與江夏仍依官稱。","note":"第二疏末請群臣廷辯，征東、鎮軍與江夏仍依官稱。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p033","start_codepoint":0,"end_codepoint":156,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"},{"id":"c-nanqishu-051-pei-cui-zhang-complete:source_review34-0","kind":"source_review","person_id":"94i_b9g_aec","source_quote":"詔報曰：「具卿冤切之懷。卿門首義，而旌德未彰，亦追以慨然，今當顯加贈謚。」偃尋下獄死。","reading":"詔報表示加贈謚，本段末明寫崔偃下獄死。","note":"詔報表示加贈謚，本段末明寫崔偃下獄死。","paragraph_id":"c-nanqishu-051-pei-cui-zhang-complete:p034","start_codepoint":0,"end_codepoint":43,"human_reviewed":false,"chapter_id":"c-nanqishu-051-pei-cui-zhang-complete","source_id":"s-nanqishu-051-pei-cui-zhang-complete-ws1504716"}],"reported_variants":[],"family_tree_decisions":[],"preferred_relatio