ng:m051-0020","start":20,"end":22,"surface":"驪姬","kind":"person","person_id":"mzj_kli_tfn","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m051-0030","start":30,"end":32,"surface":"重耳","kind":"person","person_id":"xnk_yt8_2uc","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m051-0041","start":41,"end":43,"surface":"六卿","kind":"unresolved","person_id":null,"status":"unresolved"},{"id":"c-shiji-130-taishigong:m051-0052","start":52,"end":54,"surface":"文公","kind":"person","person_id":"xnk_yt8_2uc","status":"contextual_provisional"}],"chapter_id":"c-shiji-130-taishigong","book_id":"b-shiji-130","work_id":"w-shiji","source_id":"s-shiji130-taishigong"},{"id":"c-shiji-130-taishigong:p055","text":"維驥騄耳，乃章造父。趙夙事獻，衰續厥緒。佐文尊王，卒為晉輔。襄子困辱，乃禽智伯。主父生縛，餓死探爵。王遷辟淫，良將是斥。嘉鞅討周亂，作趙世家第十三。","annotation_status":"in_progress","text_layer":"received_chapter","mentions":[{"id":"c-shiji-130-taishigong:m055-0007","start":7,"end":9,"surface":"造父","kind":"person","person_id":"sot_rib_196","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m055-0010","start":10,"end":12,"surface":"趙夙","kind":"person","person_id":"kb4_31o_a97","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m055-0013","start":13,"end":14,"surface":"獻","kind":"person","person_id":"acl_kkr_aug","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m055-0015","start":15,"end":16,"surface":"衰","kind":"person","person_id":"fk3_j50_onw","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m055-0021","start":21,"end":22,"surface":"文","kind":"person","person_id":"xnk_yt8_2uc","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m055-0030","start":30,"end":32,"surface":"襄子","kind":"person","person_id":"imx_mp1_q7v","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m055-0037","start":37,"end":39,"surface":"智伯","kind":"person","person_id":"htl_szu_1k7","status":"contextual_provisional"},{"id":"c-shiji-130-taishigong:m055-0040","start"