-shiji","book_id":"b-shiji-108","chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p009","mention_ids":["c-shiji-108-han:m009-0163","c-shiji-108-han:m009-0169","c-shiji-108-han:m009-0172","c-shiji-108-han:m009-0217","c-shiji-108-han:m009-0226","c-shiji-108-han:m009-0230"],"quote_passage_ref":"data/corpus/shiji/108.json"}],"reviewer":"Codex（AI 代理）","model":null,"human_reviewed":false},{"id":"eq-shiji110-2a2_j2z_xyc","person_ids":["2a2_j2z_xyc"],"canonical_person_id":"2a2_j2z_xyc","status":"contextual_provisional","scope":"cross_chapter","chapter_ids":["c-shiji-110-xiongnu","c-shiji-108-han"],"rationale":"按文景交替後今帝為武帝，或馬邑誘敵、同一護軍及尉史受天王號的具名事件對讀。軍臣承第28段敘事至馬邑單于；保留兩篇兵數、護軍稱與王恢斬／自殺的差異，不以同指抹平事件異說。","evidence":[{"chapter_id":"c-shiji-110-xiongnu","source_id":"s-shiji110-xiongnu","paragraph_id":"c-shiji-110-xiongnu:p030","mention_ids":["c-shiji-110-xiongnu:m030-0116","c-shiji-110-xiongnu:m030-0143","c-shiji-110-xiongnu:m030-0178","c-shiji-110-xiongnu:m030-0191"],"quote_passage_ref":"data/corpus/shiji/110.json"},{"chapter_id":"c-shiji-108-han","source_id":"s-shiji-108-han","paragraph_id":"c-shiji-108-han:p009","mention_ids":["c-shiji-108-han:m009-0163","c-shiji-108-han:m009-0169","c-shiji-108-han:m009-0172","c-shiji-108-han:m009-0217","c-shiji-108-han:m009-0226"],"quote_passage_ref":"data/corpus/shiji/108.json"}],"reviewer":"Codex（AI 代理）","model":null,"human_reviewed":false,"identity_materialized":true}],"sources":[{"chapter_id":"c-shiji-108-han","work_id":"w-shiji","book_id":"b-shiji-108","source_id":"s-shiji-108-han","source_ref":"corpus/shiji/108.json"},{"chapter_id":"c-shiji-110-xiongnu","work_id":"w-shiji","book_id":"b-shiji-110","source_id":"s-shiji110-xiongnu","source_ref":"corpus/shiji/110.json"}],"time_policy":{"unknown_is_not_unbounded":true,"attestation_is_not_tenure":true,"date_expressions_are_not_normalized":false,"date_normalization_coverage":"partial","normalized_year_numbering":"astronomical","civil_year_label_field":"chin