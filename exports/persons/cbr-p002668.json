:"c-shiji-043-zhao:m018-0018","start":18,"end":20,"surface":"趙武","kind":"person","person_id":"cbr-p002278","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m018-0048","start":48,"end":50,"surface":"趙武","kind":"person","person_id":"cbr-p002278","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m018-0065","start":65,"end":68,"surface":"趙宣孟","kind":"person","person_id":"cbr-p002259","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m018-0069","start":69,"end":73,"surface":"公孫杵臼","kind":"person","person_id":"cbr-p002276","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m018-0075","start":75,"end":77,"surface":"趙武","kind":"person","person_id":"cbr-p002278","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m018-0107","start":107,"end":109,"surface":"程嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional"},{"id":"c-shiji-043-zhao:m018-0146","start":146,"end":148,"surface":"趙武","kind":"person","person_id":"cbr-p002278","status":"contextual_provisional"}],"chapter_id":"c-shiji-043-zhao","book_id":"b-shiji-043","work_id":"w-shiji","source_id":"s-shiji-043-zhao"},{"id":"c-shiji-045-han:p002","text":"韓厥，晉景公之三年，晉司寇屠岸賈將作亂，誅靈公之賊趙盾。趙盾已死矣，欲誅其子趙朔。韓厥止賈，賈不聽。厥告趙朔令亡。朔曰：「子必能不絶趙祀，死不恨矣。」韓厥許之。及賈誅趙氏，厥稱疾不出。程嬰、公孫杵臼之藏趙孤趙武也，厥知之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-045-han:m002-0000","start":0,"end":2,"surface":"韓厥","kind":"person","person_id":"cbr-p002624","status":"contextual_provisional"},{"id":"c-shiji-045-han:m002-0003","start":3,"end":6,"surface":"晉景公","kind":"person","person_id":"cbr-p002625","status":"contextual_provisional"},{"id":"c-shiji-045-han:m002-0013","start":13,"end":16,"surface":"屠岸賈","kind":"person","person_id":"cbr-p002626","status":"contextual_provisional"},{"id":"c-shiji-045-han:m002-0021","start":21,"end":23,"surface":"靈公","kind":"person","person_id":"cbr-p002665","status":"contextual_provisional"},{"id":"c-shiji-045-han:m002-0025","s