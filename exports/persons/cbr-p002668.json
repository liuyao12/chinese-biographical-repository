iji-043-zhao:m016-0256","start":256,"end":257,"surface":"嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p016","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m016-0292","start":292,"end":294,"surface":"程嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p016","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m016-0309","start":309,"end":311,"surface":"程嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p016","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m016-0414","start":414,"end":416,"surface":"程嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p016","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m017-0290","start":290,"end":292,"surface":"程嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p017","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m017-0300","start":300,"end":302,"surface":"程嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p017","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m018-0009","start":9,"end":11,"surface":"程嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p018","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-043-zhao:m018-0107","start":107,"end":109,"surface":"程嬰","kind":"person","person_id":"cbr-p002277","status":"contextual_provisional","paragraph_id":"c-shiji-043-zhao:p018","chapter_id":"c-shiji-043-zhao"},{"id":"c-shiji-045-han:m002-0092","start":92,"end":94,"surface":"程嬰","kind":"person","person_id":"cbr-p002668","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p002","chapter_id":"c-shiji-045-han"},{"id":"c-shiji-045-han:m036-0022","start":22,"end":24,"surface":"程嬰","kind":"person","person_id":"cbr-p002668","status":"contextual_provisional","paragraph_id":"c-shiji-045-han:p036","chapter_id":"c-shiji-045-han"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji043-048","person_id":"cbr-p002277","surfaces":["嬰","程嬰"],"scope":"same_chapter","chapter_ids":["c-shiji-043-zhao"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-043-zhao:p016","quote":"趙朔妻成公姊，有遺腹，走公宮匿。趙朔客曰公孫杵臼，杵臼謂朔友人程嬰曰：「胡不死？」程嬰曰：「朔之婦有遺腹，若幸而男，吾奉之；卽女也，吾徐死耳。」居無何，而朔婦免身，生男。屠岸賈聞之，索於宮中。夫人置兒叱罅祝曰：「趙宗滅乎，若號；卽不滅，若無聲。」及索，兒竟無聲。已脱，程嬰謂公孫杵臼曰：「今一索不得，後必且復索之，柰何？」公孫杵臼曰：「立孤與死孰難？」程嬰曰：「死易，立孤難耳。」公孫杵臼曰：「趙氏先君遇子厚，子彊爲其難者，吾爲其易者，請先死。」乃二人謀取他人嬰兒負之，衣以文葆，匿山中。程嬰出，謬謂諸將軍曰：「嬰不肖，不能立趙孤。誰能與我千金，吾告趙氏孤處。」諸將皆喜，許之，發師隨程嬰攻公孫杵臼。杵臼謬曰：「小人哉程嬰！昔下宮之難不能死，與我謀匿趙氏孤兒，今又賣我。縱不能立，而忍賣之乎！」抱兒呼曰：「天乎天乎！趙氏孤兒何罪？請活之，獨殺杵臼可也。」諸將不許，遂殺杵臼與孤兒。諸將以爲趙氏孤兒良已死，皆喜。然趙氏眞孤乃反在，程嬰卒與倶匿山中。"},{"paragraph_id":"c-shiji-043-zhao:p017","quote":"居十五年，晉景公疾，卜之，大業之後不遂者爲祟。景公問韓厥，厥知趙孤在，乃曰：「大業之後在晉絶祀者，其趙氏乎？夫自中衍者皆嬴姓也。中衍人面鳥噣，降佐殷帝大戊，及周天子，皆有明德。下及幽厲無道，而叔帶去周適晉，事先君文侯，至于成公，世有立功，未嘗絶祀。今吾君獨滅趙宗，國人哀之，故見龜策。唯君圖之。」景公問：「趙尚有後子孫乎？」韓厥具以實告。於是景公乃與韓厥謀立趙孤兒，召而匿之宮中。諸將入問疾，景公因韓厥之衆以脅諸將而見趙孤。趙孤名曰武。諸將不得已，乃曰：「昔下宮之難，屠岸賈爲之，矯以君命，并命群臣。非然，孰敢作難！微君之疾，群臣固且請立趙後。今君有命，群臣之願也。」於是召趙武、程嬰遍拜諸將，遂反與程嬰、趙武攻屠岸賈，滅其族。復與趙武田邑如故。"},{"paragraph_id":"c-shiji-043-zhao:p018","quote":"及趙武冠，爲成人，程嬰乃辭諸大夫，謂趙武曰：「昔下宮之難，皆能死。我非不能死，我思立趙氏之後。今趙武旣立，爲成人，復故位，我將下報趙宣孟與公孫杵臼。」趙武啼泣頓首固請，曰：「武願苦筋骨以報子至死，而子忍去我死乎！」程嬰曰：「不可。彼以我爲能成事，故先我死；今我不報，是以我事爲不成。」遂自殺。趙武服齊衰三年，爲之祭邑，春秋祠之，世世勿絶。"}],"rationale":"限本篇明示名字、是為與連續事件暫接異稱；真孤與替代兒分開，馬匹、群體與闕代不當個人，不以模型記憶補熟知姓名。","reviewer":"Codex（AI 代理）"},{"id":"d-shiji045-046","person_id":"cbr-p002668","surfaces":["程嬰"],"scope":"same_chapter","chapter_ids":["c-shiji-045-han"],"status":"contextual_provisional","evidence":[{"paragraph_id":"c-shiji-045-han:p002","quote":"韓厥，晉景公之三年，晉司寇屠岸賈將作亂，誅靈公之賊趙盾。趙盾已死矣，欲誅其子趙朔。韓厥止賈，賈不聽。厥告趙朔令亡。朔曰：「子必能不絶趙祀，死不恨矣。」韓厥許之。及賈誅趙氏，厥稱疾不出。程嬰、公孫杵臼之藏趙孤趙武也，厥知之。"},{"paragraph_id":"c-shiji-045-han:p036","quote":"太史公曰：韓厥之感晉景公，紹趙孤之子武，以成程嬰、公孫杵臼之義，此天下之陰德也。韓氏之功，於晉未睹其大者也。然與趙、魏終爲諸侯十餘世，宜乎哉！"}],"rationale":"限本篇明示姓名、號稱、是為與連續敘事；兩位韓武子、韓趙簡子、韓魏文侯及不同時段未名楚王分開。原字及韓姬弒悼公、蟣蝨等疑點不訂正；裸王與回敘指代留待核。","reviewer":"Codex（AI 代理）"}],"equivalence_decisions":[{"id":"eq-shiji045-ying","person_ids":["cbr-p002277","cbr-p002668"],"canonical_person_id":"cbr-p002277","scope":"cross_chapter","chapter_ids":["c-shiji-043-zhao","c-shiji-045-han"],"status":"contextual_provisional","evidence":[{"chapter_id":"c-shiji-043-zhao","source_id":"s-shiji-043-zhao","paragraph_id":"c-shiji-043-zhao:p016","quote":"趙朔妻成公姊，有遺腹，走公宮匿。趙朔客曰公孫杵臼，杵臼謂朔友人程嬰曰：「胡不死？」程嬰曰：「朔之婦有遺腹，若幸而男，吾奉之；卽女也，吾徐死耳。」居無何，而朔婦免身，生男。屠岸賈聞之，索於宮中。夫人置兒叱罅祝曰：「趙宗滅乎，若號；卽不滅，若無聲。」及索，兒竟無聲。已脱，程嬰謂公孫杵臼曰：「今一索不得，後必且復索之，柰何？」公孫杵臼曰：「立孤與死孰難？」程嬰曰：「死易，立孤難耳。」公孫杵臼曰：「趙氏先君遇子厚，子彊爲其難者，吾爲其易者，請先死。」乃二人謀取他人嬰兒負之，衣以文葆，匿山中。程嬰出，謬謂諸將軍曰：「嬰不肖，不能立趙孤。誰能與我千金，吾告趙氏孤處。」諸將皆喜，許之，發師隨程嬰攻公孫杵臼。杵臼謬曰：「小人哉程嬰！昔下宮之難不能死，與我謀匿趙氏孤兒，今又賣我。縱不能立，而忍賣之乎！」抱兒呼曰：「天乎天乎！趙氏孤兒何罪？請活之，獨殺杵臼可也。」諸將不許，遂殺杵臼與孤兒。諸將以爲趙氏孤兒良已死，皆喜。然趙氏眞孤乃反在，程嬰卒與倶匿山中。","mention_ids":["c-shiji-043-zhao:m016-0031","c-shiji-043-zhao:m016-0041","c-shiji-043-zhao:m016-0134","c-shiji-043-zhao:m016-0176","c-shiji-043-zhao:m016-0244","c-shiji-043-zhao:m016-0256","c-shiji-043-zhao:m016-0292","c-shiji-043-zhao:m016-0309","c-shiji-043-zhao:m016-0414"]},{"chapter_id":"c-shiji-045-han","source_id":"s-shiji-045-han","paragraph_id":"c-shiji-045-han:p002","quote":"韓厥，晉景公之三年，晉司寇屠岸賈將作亂，誅靈公之賊趙盾。趙盾已死矣，欲誅其子趙朔。韓厥止賈，賈不聽。厥告趙朔令亡。朔曰：「子必能不絶趙祀，死不恨矣。」韓厥許之。及賈誅趙氏，厥稱疾不出。程嬰、公孫杵臼之藏趙孤趙武也，厥知之。","mention_ids":["c-shiji-045-han:m002-0092"]}],"rationale":"兩篇同記程嬰與公孫杵臼藏趙孤，按名字組與救孤敘事暫同指。 同一著作不同篇的敘事不當獨立多份見證，未選定事實、年代或來源優先，已發ID各保留。","reviewer":"Codex（AI 代理）","human_reviewed":false,"model":null}],"passages":[{"id":"c-shiji-043-zhao:p016","text":"趙朔妻成公姊，有遺腹，走公宮匿。趙朔客曰公孫杵臼，杵臼謂朔友人程嬰曰：「胡不死？」程嬰曰：「朔之婦有遺腹，若幸而男，吾奉之；卽女也，吾徐死耳。」居無何，而朔婦免身，生男。屠岸賈聞之，索於宮中。夫人置兒叱罅祝曰：「趙宗滅乎，若號；卽不滅，若無聲。」及索，兒竟無聲。已脱，程嬰謂公孫杵臼曰：「今一索不得，後必且復索之，柰何？」公孫杵臼曰：「立孤與死孰難？」程嬰曰：「死易，立孤難耳。」公孫杵臼曰：「趙氏先君遇子厚，子彊爲其難者，吾爲其易者，請先死。」乃二人謀取他人嬰兒負之，衣以文葆