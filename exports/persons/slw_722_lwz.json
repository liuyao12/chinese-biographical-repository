:[{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001","text":"祏、祀密謂吏部郎謝朓曰：「江夏年少，脫不堪負荷，豈可復行廢立！始安年長，入纂不乖物望。非以此要富貴，政是求安國家耳。」遙光又遣所親丹陽丞南陽劉祏密緻意於祏，欲引以為黨，祏不答。頃之，遙光以朓兼知衛尉事，朓懼，即以祏謀告太子右衛率左興盛，興盛不敢發。朓又說劉暄曰：「始安一旦南面，則劉渢、劉晏居卿今地，但以卿為反覆人耳。」晏者，遙光城局參軍也。暄陽驚，馳告遙光及祏。遙光欲出朓為東陽郡，朓常輕祏，祏尉議除之。遙光乃收朓付廷尉，與孝嗣、祏、暄等連名啟「朓扇動內外，妄貶乘輿，竊論宮禁，間謗親賢，輕議朝宰。」朓遂死獄中。","text_layer":"received_chapter","mentions":[{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0001","kind":"person","start":0,"end":1,"surface":"祏","status":"contextual_provisional","source_role":"jiangshi","person_id":"qfs_t8x_ez4_AA"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0002","kind":"person","start":2,"end":3,"surface":"祀","status":"contextual_provisional","source_role":"jiangsi","person_id":"qfs_t8x_ez4_AB"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0003","kind":"person","start":8,"end":10,"surface":"謝朓","status":"contextual_provisional","source_role":"xietiao","person_id":"aa6_83c_juy_ABCBA"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0004","kind":"person","start":13,"end":15,"surface":"江夏","status":"contextual_provisional","source_role":"baoxuan","person_id":"z5d_9zy_u5h_BC"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0005","kind":"person","start":31,"end":33,"surface":"始安","status":"contextual_provisional","source_role":"yaoguang","person_id":"z5d_9zy_u5h_AA"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0006","kind":"person","start":59,"end":61,"surface":"遙光","status":"contextual_provisional","source_role":"yaoguang","person_id":"z5d_9zy_u5h_AA"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0007","kind":"person","start":70,"end":72,"surface":"劉祏","status":"contextual_provisional","source_role":"liufeng","person_id":"tsg_gnw_ghc"},{"id":"c-zizhitongjian-142-xietiao-death-rendered:p001:m0008","kind":"person","start":76,"end":77,"surface":"祏","status":"contextual_provisional","source_role":"xietiao","person_id":"aa6_83c_juy_ABCBA"},{"id":"c-zizhitongjian-14