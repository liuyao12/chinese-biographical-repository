":"c-sanguozhi-062-shiyi:line013","chapter_id":"c-sanguozhi-062-shiyi"},{"id":"c-sanguozhi-062-shiyi:line013:m0158","start":158,"end":159,"surface":"嘉","kind":"person","person_id":"8t6_j65_p3m","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-062-shiyi:line013","chapter_id":"c-sanguozhi-062-shiyi"},{"id":"c-sanguozhi-062-shiyi:line013:m0198","start":198,"end":199,"surface":"嘉","kind":"person","person_id":"8t6_j65_p3m","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-062-shiyi:line013","chapter_id":"c-sanguozhi-062-shiyi"}],"relations":[],"title_holdings":[{"id":"t-wu062-t-wu062-shiyi13","person_id":"8t6_j65_p3m","kind":"office","title":"江夏太守","mode":"attestation","status":"source_attested","effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"本句所載職官，任免時間未詳。","evidence":[{"work_id":"w-sanguozhi","book_id":"b-sanguozhi-062","chapter_id":"c-sanguozhi-062-shiyi","source_id":"s-sanguozhi-062-shiyi","paragraph_id":"c-sanguozhi-062-shiyi:line013","quote":"　　大駕東遷，太子登留鎮武昌，使儀輔太子。太子敬之，事先咨詢，然後施行。進封都鄉侯。後從太子還建業，復拜侍中、中執法，平諸官事、領辭訟如舊。典校郎呂壹誣白故江夏太守刁嘉謗仙國政，權怒，收嘉繫獄，悉驗問。時同坐人皆怖畏壹，並言聞之，儀獨雲無聞。於是見窮詰累日，詔旨轉厲，群臣為之屏息。儀對曰：\"今刀鋸已在臣頸，臣何敢為嘉隱諱，自取夷滅，為不忠之鬼!顧以聞知當有本末。\"據實答問，辭不傾移。權遂捨之，嘉亦得免。蜀相諸葛亮卒，權垂心西州，遣儀使蜀申固盟好。奉使稱意，後拜尚書僕射。南、魯二宮初立，儀以本職領魯王傅。儀嫌二宮相近切，乃上疏曰：\"臣竊以魯王天挺懿德，兼資文武，當今之宜，宜鎮四方，為國藩輔。宣揚德美，廣耀威靈，乃國家之良規，海內所瞻望。但臣言辭鄙野，不能究盡其意。愚以二宮宜有降殺，正上下之序，明教化之本。\"書三四上。為傅盡忠，動輒規諫；事上勤，與人恭。","person_mention_id":"c-sanguozhi-062-shiyi:line013:m0082"}],"attestations":[{"id":"t-wu062-t-wu062-shiyi13:a","paragraph_id":"c-sanguozhi-062-shiyi:line013","person_mention_id":"c-sanguozhi-062-shiyi:line013:m0082","start":78,"end":82,"surface":"江夏太守","usage":"narrative","date_expression":null}],"human_reviewed":false,"reviewer":"Codex（AI 代理）","model":null}],"address_assertions":[],"table_occurrences":[],"date_normalizations":[