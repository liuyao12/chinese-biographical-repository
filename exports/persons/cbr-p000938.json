{"format_version":"0.1","record_type":"person_source_bundle","requested_person_id":"cbr-p000938","identity_policy":"contextual_provisional","person_ids":["cbr-p000938"],"persons":[{"id":"cbr-p000938","label":"將廬（齊王）","status":"active","historicity":"historical_tradition","aliases":[{"surface":"齊王將廬","mention_ids":["c-shiji-011-jingdi:m004-0196"]}],"evidence":[{"mention_id":"c-shiji-011-jingdi:m004-0196","chapter_id":"c-shiji-011-jingdi","paragraph_id":"c-shiji-011-jingdi:p004","quote":"齊王將廬"}]}],"mentions":[{"id":"c-shiji-011-jingdi:m004-0196","start":196,"end":200,"surface":"齊王將廬","kind":"person","person_id":"cbr-p000938","status":"contextual_provisional","paragraph_id":"c-shiji-011-jingdi:p004","chapter_id":"c-shiji-011-jingdi"}],"relations":[],"title_holdings":[],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-shiji-011-jingdi:p004","text":"三年正月乙巳，赦天下。長星出西方。天火燔雒陽東宮大殿城室。吳王濞、楚王戊、趙王遂、膠西王卬、濟南王辟光、菑川王賢、膠東王雄渠反，發兵西鄉。天子為誅晁錯，遣袁盎諭告，不止，遂西圍梁。上乃遣大將軍竇嬰、太尉周亞夫將兵誅之。六月乙亥。赦亡軍及楚元王子藝等與謀反者。封大將軍竇嬰為魏其侯。立楚元王子平陸侯禮為楚王。立皇子端為膠西王，子勝為中山王。徙濟北王志為菑川王，淮陽王餘為魯王，汝南王非為江都王。齊王將廬、燕王嘉皆薨。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-011-jingdi:m004-0029","start":29,"end":32,"surface":"吳王濞","kind":"person","person_id":"cbr-p000810","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0033","start":33,"end":36,"surface":"楚王戊","kind":"person","person_id":"cbr-p000924","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0037","start":37,"end":40,"surface":"趙王遂","kind":"person","person_id":"cbr-p000876","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0041","start":41,"end":45,"surface":"膠西王卬","kind":"person","person_id":"cbr-p000925","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0046","start":46,"end":51,"surface":"濟南王辟光","kind":"person","person_id":"cbr-p000926","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0052","start":52,"end":56,"surface":"菑川王賢","kind":"person","person_id":"cbr-p000927","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0057","start":57,"end":62,"surface":"膠東王雄渠","kind":"person","person_id":"cbr-p000928","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0069","start":69,"end":71,"surface":"天子","kind":"person","person_id":"cbr-p000889","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0073","start":73,"end":75,"surface":"晁錯","kind":"person","person_id":"cbr-p000929","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0077","start":77,"end":79,"surface":"袁盎","kind":"person","person_id":"cbr-p000918","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0090","start":90,"end":91,"surface":"上","kind":"person","person_id":"cbr-p000889","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0096","start":96,"end":98,"surface":"竇嬰","kind":"person","person_id":"cbr-p000930","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0101","start":101,"end":104,"surface":"周亞夫","kind":"person","person_id":"cbr-p000913","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0118","start":118,"end":121,"surface":"楚元王","kind":"person","person_id":"cbr-p000794","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0121","start":121,"end":123,"surface":"子藝","kind":"person","person_id":"cbr-p000931","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0133","start":133,"end":135,"surface":"竇嬰","kind":"person","person_id":"cbr-p000930","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0141","start":141,"end":144,"surface":"楚元王","kind":"person","person_id":"cbr-p000794","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004-0145","start":145,"end":149,"surface":"平陸侯禮","kind":"person","person_id":"cbr-p000932","status":"contextual_provisional"},{"id":"c-shiji-011-jingdi:m004