ence":[{"work_id":"w-songshu","book_id":"b-songshu-048","chapter_id":"c-songshu-048-zhu-family-passages","source_id":"s-songshu-048-zhu-family-passages-ws1791560","paragraph_id":"c-songshu-048-zhu-family-passages:p001","quote":"朱齡石字伯兒，沛郡沛人也。家世將帥。祖騰，建威將軍、吳國內史。伯父憲及斌，並為西中郎袁真將佐，憲為梁國內史，斌為汝南內史。大司馬桓溫伐真於壽陽，真以憲兄弟與溫潛通，並殺之。齡石父綽逃走歸溫，攻戰常居先，不避矢石。壽陽平，真已死，綽輒發棺戮尸，溫怒，將斬之，溫弟沖苦請得免。綽為人忠烈，受沖更生之恩，事沖如父。參沖車騎軍事、西陽廣平太守。及沖薨，綽歐血死。沖諸子遇齡石如兄弟。","subject_person_mention_id":"c-songshu-048-zhu-family-passages:p001:m0000","object_person_mention_id":"c-songshu-048-zhu-family-passages:p001:m0089","source_term":"齡石父綽"}],"status":"contextual_provisional","human_reviewed":false,"interpretation_note":"齡石父綽，另存兩筆朱綽舊號，只採同事桓沖者。"}},{"id":"wip_vh5_2zm_AA","label":"朱景符","status":"active","historicity":"historical_tradition","aliases":[{"surface":"景符","mention_ids":["c-songshu-048-zhu-family-passages:p004:m0001","c-songshu-048-zhu-family-passages:p004:m0005","c-songshu-048-zhu-succession:p002:m0001","c-songshu-048-zhu-succession:p002:m0005","c-songshu-048-zhujingfu:p001:m0001","c-songshu-048-zhujingfu:p001:m0005"]}],"evidence":[{"mention_id":"c-songshu-048-zhu-family-passages:p004:m0001","paragraph_id":"c-songshu-048-zhu-family-passages:p004","chapter_id":"c-songshu-048-zhu-family-passages","quote":"景符"},{"mention_id":"c-songshu-048-zhu-family-passages:p004:m0005","paragraph_id":"c-songshu-048-zhu-family-passages:p004","chapter_id":"c-songshu-048-zhu-family-passages","quote":"景符"},{"mention_id":"c-songshu-048-zhu-succession:p002:m0001","paragraph_id":"c-songshu-048-zhu-succession:p002","chapter_id":"c-songshu-048-zhu-succession","quote":"景符"},{"mention_id":"c-songshu-048-zhu-succession:p002:m0005","paragraph_id":"c-songshu-048-zhu-succession:p002","chapter_id":"c-songshu-048-zhu-succession","quote":"景符"},{"mention_id":"c-songshu-048-zhujingfu:p001:m0001","paragraph_id":"c-songshu-048-zhujingfu:p001","chapter_id":"c-songshu-048-zhujingfu","quote":"景符"},{"mention_id":"c-songshu-048-zhujingfu:p001:m0005","paragraph_id