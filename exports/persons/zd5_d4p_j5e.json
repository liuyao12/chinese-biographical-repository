ferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-sanguozhi-058-luxun:line025:m0177","start":177,"end":180,"surface":"沙靡柯","kind":"person","person_id":"zd5_d4p_j5e","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。","paragraph_id":"c-sanguozhi-058-luxun:line025","chapter_id":"c-sanguozhi-058-luxun"}],"relations":[],"title_holdings":[],"address_assertions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-luxun:line025","text":"諸將並曰：「攻備當在初，今乃令人五六百里，相銜持經七八月，其諸要害皆以固守，擊之必無利矣。」遜曰：「備是猾虜，更嘗事多，其軍始集，思慮精專，未可干也。今住己久，不得我便，兵疲意沮，計不復生，掎角此寇，正在今日。」乃先攻一營，不利。諸將皆曰：「空殺兵耳。」遜曰：「吾已曉破之之術。」乃敕各持一把茅，以火攻拔之。一爾勢成，通率諸軍同時俱攻，斬張南、馮習及胡王沙靡柯等首，破其四十餘營。備將杜路、劉寧等窮逼請降。備升馬鞍山，陳兵自繞。遜督促諸軍四面蹙之，土崩瓦解，死者萬數。備因夜遁，驛人自擔燒鐃鎧斷後，僅得入白帝城。其舟船器械，水步軍資，一時略盡，屍骸漂流，塞江而下。備大慚恚，曰：「吾乃為遜所折辱，豈非天邪!」","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line025:m0007","start":7,"end":8,"surface":"備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line025:m0046","start":46,"end":47,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line025:m0050","start":50,"end":51,"surface":"備","kind":"person","person_id":"5f2_396_25c","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line025:m0127","start":127,"end":128,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line025:m0169","start":169,"end":171,"surface":"張南","kind":"person","person_id":"rfm_te3_2ek","status":"contextual_provisional","interpretation_n