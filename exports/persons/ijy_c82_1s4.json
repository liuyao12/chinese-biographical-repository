,"status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0015","surface":"賈謐","start":15,"end":17,"person_id":"ga3_phu_mfa","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0024","surface":"崇","start":24,"end":25,"person_id":"385_7fd_092","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0032","surface":"湣懷","start":32,"end":34,"person_id":"74e_68c_9ae","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0037","surface":"岳","start":37,"end":38,"person_id":"d2b_1d3_333","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0042","surface":"謐","start":42,"end":43,"person_id":"ga3_phu_mfa","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0048","surface":"岳","start":48,"end":49,"person_id":"d2b_1d3_333","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0053","surface":"謐","start":53,"end":54,"person_id":"ga3_phu_mfa","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0062","surface":"岳","start":62,"end":63,"person_id":"d2b_1d3_333","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0068","surface":"母","start":68,"end":69,"person_id":"ijy_c82_1s4","kind":"person","status":"contextual_provisional"},{"id":"c-jinshu-055-pan-yue:p014:m0089","surface":"岳","start":89,"end":90,"person_id":"d2b_1d3_333","kind":"person","status":"contextual_provisional"}],"chapter_id":"c-jinshu-055-pan-yue","book_id":"b-jinshu-055","work_id":"w-jinshu","source_id":"s-jinshu-055-pan-yue-ws2316433"},{"id":"c-jinshu-055-pan-yue:p016","text":"岳讀《汲黯傳》至司馬安四至九卿，而良史書之，題以巧宦之目，未曾不慨然廢書而歎也。曰：嗟乎！巧誠有之，拙亦宜然。顧常以為士之生也，非至聖無軌微妙玄通者，則必立功立事，效當年之用。是以資忠履信以進德，修辭立誠以居業。僕少竊鄉曲之譽，忝司空太尉之命，所奉之主，即太宰魯武公其人也。舉秀才為郎。逮事世祖武皇帝，為河陽、懷令，尚書郎，廷尉評。今天子諒暗之際，領太傅主簿。府主誅，除名為民。俄而復官，除長安令。遷博士，未召拜，親疾輒去，官免。自弱冠涉於知命之年，八徙官而一進階，再免，一除名，一不拜職，遷者三而已矣。雖通塞有遇，抑亦拙之效也。昔通人和長輿之論餘也，固曰「拙於用多」。稱多者，吾豈敢；言拙，則信而有征。方今俊乂在官，百工惟時，拙者可以絕意乎寵榮之事矣。太夫人在堂，有羸老之疾，尚何能違膝下色養，而屑屑從斗筲之役？於是覽止足之分，庶浮雲之志，築室種樹，逍遙自得。池沼足以漁釣，舂稅足以代耕。灌園鬻蔬，供朝夕之膳；牧羊酤酪，俟伏臘之費。孝乎惟孝，友于兄弟，此亦拙者之為政也。乃作《閒居賦》以歌事遂情焉。其辭曰：","text_layer":"received_chapter","annotation_status":"reviewed","source_position":{"first_line":88,"last_line":88,"raw_start":7050,"raw_end":7504,"raw_character_offsets":[7050,7051,7052,7053,7054,7055,7056,7057,7058,7059,7060,7061,7062,7063,7064,7065,7066,7067,7068,7069,7070,7071,7072,7073,7074,7075,7076,7077,7078,7079,7080,7081,7082,7083,7084,7085,7086,7087,7088,7089,7090,7091,7092,7093,7094,7095,7096,7097,7098,7099,7100,7101,7102,7103,7104,7105,7106,7107,7108,7109,7110,7111,7112,7113,7114,7115,7116,7117,7118,7119,7120,7121,7122,7123,7124,7125,7126,7127,7128,7129,7130,7131,7132,7133,7134,7135,7136,7137,7138,7139,7140,7141,7142,7143,7144,7145,7146,7147,7148,7149,7150,7151,7152,7153,7154,7155,7156,7157,7158,7159,7160,7161,7162,7163,7164,7165,7166,7167,7168,7169,7170,7171,7172,7173,7174,7175,7176,7177,7178,7179,7180,7181,7182,7183,7184,7185,7186,7187,7188,7189,7190,7191,7192,7193,7194,7195,7196,7197,7198,7199,7200,7201,7202,7203,7204,7205,7206,7207,7208,7209,7210,7211,7212,7213,7214,7215,7216,7217,7218,7219,7220,7221,7222,7223,7224,7225,7226,7227,7228,7229,7230,7231,7232,7233,7234,7235,7236,7237,7238,7239,7240,7241,7242,7243,7244,7245,7246,7247,7248,7249,7250,7251,7252,7253,7254,7255,7256,7257,7258,7259,7260,7261,7262,7263,7264,7265,7266,7267,7268,7269,7270,7271,7272,7273,7274,7275,7276,7277,7278,7279,7280,7281,7282,7283,7284,7285,7286,7287,7288,7289,7290,7291,7292,7293,7294,7295,7296,7297,7298,7299,7300,7301,7302,7303,7304,7305,7306,7307,7308,7309,7310,7311,7312,7313,7314,7315,7316,7317,7318,7319,7320,7321,7322,7323,7324,7325,7326,7327,7328,7329,7330,7331,7332,7333,7334,7335,7336,7337,7338,7339,7340,7341,7342,7343,7344,7345,7346,7347,7348,7349,7350,7351,7352,7353,7354,7355,7356,7357,7358,7359,7360,7361,7362,7363,7364,7365,7366,7367,7368,7369,7370,7371,7372,7373,7374,7375,7376,7377,7378,7379,7380,