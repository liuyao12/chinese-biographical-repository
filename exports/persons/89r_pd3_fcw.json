,"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-sanguozhi-058-luxun:line048","text":"六年，中郎將周祗乞於鄱陽召募，事下問遜。遜以為此郡民易動難安，不可與召。恐致賊寇。而祗固陳取之，郡民吳遽等果作賊殺祗，攻沒諸縣。豫章、廬陵宿惡民並應遽為寇。遜自聞，輒討即破，遽等相率降，遜料得精兵八千餘人，三郡平。時中書典校呂壹，竊弄權柄，擅作威福。遜與太常潘浚同心憂之，言至流涕。後權誅壹，深以自責，語在《權傳》。","text_layer":"received_chapter","mentions":[{"id":"c-sanguozhi-058-luxun:line048:m0007","start":7,"end":8,"surface":"祗","kind":"person","person_id":"o2h_1j3_vqy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line048:m0018","start":18,"end":19,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line048:m0020","start":20,"end":21,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line048:m0042","start":42,"end":43,"surface":"祗","kind":"person","person_id":"o2h_1j3_vqy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line048:m0051","start":51,"end":52,"surface":"遽","kind":"person","person_id":"89r_pd3_fcw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line048:m0057","start":57,"end":58,"surface":"祗","kind":"person","person_id":"o2h_1j3_vqy","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line048:m0074","start":74,"end":75,"surface":"遽","kind":"person","person_id":"89r_pd3_fcw","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line048:m0078","start":78,"end":79,"surface":"遜","kind":"person","person_id":"lii_454_vuv","status":"contextual_provisional","interpretation_note":"依本段姓名與上下文定位。"},{"id":"c-sanguozhi-058-luxun:line048:m0087","start":87,"end":88,"surface":"遽","kind":"person","person_id":"89r_pd