006-0256","start":256,"end":258,"surface":"解福","kind":"person","person_id":"q0l_cnu_l8r","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0278","start":278,"end":280,"surface":"盧綰","kind":"person","person_id":"4k0_mri_buk","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0282","start":282,"end":283,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0287","start":287,"end":289,"surface":"盧綰","kind":"person","person_id":"4k0_mri_buk","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p013","text":"項羽既已死，漢王為帝。其秋，燕王臧荼反，商以將軍從擊荼，戰龍脫，先登陷陣，破荼軍易下，卻敵，遷為右丞相，賜爵列侯，與諸侯剖符，世世勿絕，食邑涿五千戶，號曰涿侯。以右丞相別定上谷，因攻代，受趙相國印。以右丞相趙相國別與絳侯等定代、鴈門，得代丞相程縱、守相郭同、將軍已下至六百石十九人。還，以將軍為太上皇衛一歲七月。以右丞相擊陳豨，殘東垣。又以右丞相從高帝擊黥布，攻其前拒，陷兩陳，得以破布軍，更食曲周五千一百戶，除前所食，凡別破軍三，降定郡六，縣七十三，得丞相、守相、大將各一人，小將二人，二千石已下至六百石十九人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m013-0000","start":0,"end":2,"surface":"項羽","kind":"person","person_id":"qcp_ou0_2g1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0006","start":6,"end":8,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0016","start":16,"end":18,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0020","start":20,"end":21,"surface":"商","kind":"person","person_id":"bni_7nd_jnt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0026","start":26,"end":27,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0038","start":38,"end":39,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0108","start":108,"end":110,"surface":"絳侯","kind":"person","person_id":"s8n_dgg_60b","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0121","start":121,"end":123,"surface":"程縱","kind":"person","person_id":"2k3_1v0_aqi","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0126","start":126,"end":128,"surface":"郭同","kind":"person","person_id":"xjx_97m_qss","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0147","start":147,"end":150,"surface":"太上皇","kind":"person","person_id":"q5a_q1s_wq7","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0161","start":161,"end":163,"surface":"陳豨","kind":"person","person_id":"ht1_kdz_izj","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0174","start":174,"end":176,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m013-0177","start":177,"end":179,"surface":"黥布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p020","text":"漢王立為帝。其秋，燕王臧荼反，嬰以太僕從擊荼。明年，從至陳，取楚王信。更食汝陰，剖符世世勿絕。以太僕從擊代，至武泉、雲中，益食千戶。因從擊韓信軍胡騎晉陽旁，大破之。追北至平城，為胡所圍，七日不得通。高帝使使厚遺閼氏，冒頓開圍一角。高帝出欲馳，嬰固徐行，弩皆持滿外向，卒得脫。益食嬰細陽千戶。復以太僕從擊胡騎句注北，大破之。以太僕擊胡騎平城南，三陷陳，功為多，賜所奪邑五百戶。以太僕擊陳豨、黥布軍，陷陳卻敵，益食千戶，定食汝陰六千九百戶，除前所食。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m020-0000","start":0,"end":2,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0011","start":11,"end":13,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0015","start":15,"end":16,"surface":"嬰","kind":"person","person_id":"e9l_7dr_a7o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0021","start":21,"end":22,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0031","start":31,"end":34,"surface":"楚王信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0069","start":69,"end":71,"surface":"韓信","kind":"person","person_id":"39e_wj9_6m0","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0099","start":99,"end":101,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0105","start":105,"end":107,"surface":"閼氏","kind":"person","person_id":"g0p_ahe_0bb","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0108","start":108,"end":110,"surface":"冒頓","kind":"person","person_id":"2kq_omm_diy","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0115","start":115,"end":117,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0121","start":121,"end":122,"surface":"嬰","kind":"person","person_id":"e9l_7dr_a7o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0139","start":139,"end":140,"surface":"嬰","kind":"person","person_id":"e9l_7dr_a7o","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0191","start":191,"end":193,"surface":"陳豨","kind":"person","person_id":"ht1_kdz_izj","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m020-0194","start":194,"end":196,"surface":"黥布","kind":"person","person_id":"664_wah_z4z","status":"contextual_provisional"}],"chapter_id":"c-shiji-095-fankuang","book_id":"b-shiji-095","work_id":"w-shiji","source_id":"s-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:p028","text":"漢王立為皇帝，賜益嬰邑三千戶。其秋，以車騎將軍從擊破燕王臧荼。明年，從至陳，取楚王信。還，剖符，世世勿絕，食潁陰二千五百戶，號曰潁陰侯。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-0