":8,"mention_ids":["c-shiji-095-fankuang:m006-0031","c-shiji-095-fankuang:m006-0035","c-shiji-095-fankuang:m013-0016","c-shiji-095-fankuang:m013-0026","c-shiji-095-fankuang:m013-0038","c-shiji-095-fankuang:m020-0011","c-shiji-095-fankuang:m020-0021","c-shiji-095-fankuang:m028-0028"],"paragraph_ids":["c-shiji-095-fankuang:p006","c-shiji-095-fankuang:p013","c-shiji-095-fankuang:p020","c-shiji-095-fankuang:p028"],"passage_count":4}],"most_mentioned_source_ids":["s-shiji-095-fankuang"],"mention_count_policy":{"scope":"currently_annotated_mentions","identity_policy":"contextual_provisional","ties":"all_maxima","frequency_is_not_authority":true},"kinship_interpretation_cases":[],"reported_variants":[],"family_tree_decisions":[],"preferred_relations":[],"family_tree_policy":{"default":"editorial_preferred","original_assertions_preserved":true,"unreviewed_conflicts_may_remain":true,"runtime_ai_required":false},"family_paths":[],"mentions":[{"id":"c-shiji-095-fankuang:m006-0031","start":31,"end":33,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p006","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m006-0035","start":35,"end":36,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p006","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m013-0016","start":16,"end":18,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p013","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m013-0026","start":26,"end":27,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p013","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m013-0038","start":38,"end":39,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p013","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m020-0011","start":11,"end":13,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p020","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m020-0021","start":21,"end":22,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p020","chapter_id":"c-shiji-095-fankuang"},{"id":"c-shiji-095-fankuang:m028-0028","start":28,"end":30,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional","paragraph_id":"c-shiji-095-fankuang:p028","chapter_id":"c-shiji-095-fankuang"}],"relations":[],"title_holdings":[{"id":"th-shiji095-018","person_id":"un2_jcz_dkt","title":"燕王","kind":"royal_rank","mode":"attestation","status":"source_attested","evidence":[{"chapter_id":"c-shiji-095-fankuang","source_id":"s-shiji-095-fankuang","paragraph_id":"c-shiji-095-fankuang:p006","quote":"項籍既死，漢王為帝，以噲堅守戰有功，益食八百戶。從高帝攻反燕王臧荼，虜荼，定燕地。楚王韓信反，噲從至陳，取信，定楚。更賜爵列侯，與諸侯剖符，世世勿絕，食舞陽，號為舞陽侯，除前所食。以將軍從高祖攻反韓王信於代。自霍人以往至雲中，與絳侯等共定之，益食千五百戶。因擊陳豨與曼丘臣軍，戰襄國，破柏人，先登，降定清河、常山凡二十七縣，殘東垣，遷為左丞相。破得綦毋卹、尹潘軍於無終、廣昌。破豨別將胡人王黃軍於代南，因擊韓信軍於參合。軍所將卒斬韓信，破豨胡騎橫谷，斬將軍趙既，虜代丞相馮梁、守孫奮、大將王黃、將軍、（太卜）太仆解福等十人。與諸將共定代鄉邑七十三。其後燕王盧綰反，噲以相國擊盧綰，破其丞相抵薊南，定燕地，凡縣十八，鄉邑五十一。益食邑千三百戶，定食舞陽五千四百戶。從，斬首百七十六級，虜二百八十八人。別，破軍七，下城五，定郡六，縣五十二，得丞相一人，將軍十二人，二千石已下至三百石十一人。"}],"attestations":[{"id":"th-shiji095-018:a001","paragraph_id":"c-shiji-095-fankuang:p006","start":29,"end":31,"surface":"燕王","person_mention_id":"c-shiji-095-fankuang:m006-0031","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"原文實授、敘事用稱及諡稱分存；未明示時任期起訖未知。爵號用字不擅自補足，單稱侯不自動展開爵邑名；死亡、被捕、罷兵不自動作所有官爵終點。欲拜李必駱甲為騎將未作實授，左右校尉據實際令授。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji095-025","person_id":"un2_jcz_dkt","scope":"same_chapter","chapter_ids":["c-shiji-095-fankuang"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["臧荼","荼"],"evidence":[{"paragraph_id":"c-shiji-095-fankuang:p006","quote":"項籍既死，漢王為帝，以噲堅守戰有功，益食八百戶。從高帝攻反燕王臧荼，虜荼，定燕地。楚王韓信反，噲從至陳，取信，定楚。更賜爵列侯，與諸侯剖符，世世勿絕，食舞陽，號為舞陽侯，除前所食。以將軍從高祖攻反韓王信於代。自霍人以往至雲中，與絳侯等共定之，益食千五百戶。因擊陳豨與曼丘臣軍，戰襄國，破柏人，先登，降定清河、常山凡二十七縣，殘東垣，遷為左丞相。破得綦毋卹、尹潘軍於無終、廣昌。破豨別將胡人王黃軍於代南，因擊韓信軍於參合。軍所將卒斬韓信，破豨胡騎橫谷，斬將軍趙既，虜代丞相馮梁、守孫奮、大將王黃、將軍、（太卜）太仆解福等十人。與諸將共定代鄉邑七十三。其後燕王盧綰反，噲以相國擊盧綰，破其丞相抵薊南，定燕地，凡縣十八，鄉邑五十一。益食邑千三百戶，定食舞陽五千四百戶。從，斬首百七十六級，虜二百八十八人。別，破軍七，下城五，定郡六，縣五十二，得丞相一人，將軍十二人，二千石已下至三百石十一人。"},{"paragraph_id":"c-shiji-095-fankuang:p013","quote":"項羽既已死，漢王為帝。其秋，燕王臧荼反，商以將軍從擊荼，戰龍脫，先登陷陣，破荼軍易下，卻敵，遷為右丞相，賜爵列侯，與諸侯剖符，世世勿絕，食邑涿五千戶，號曰涿侯。以右丞相別定上谷，因攻代，受趙相國印。以右丞相趙相國別與絳侯等定代、鴈門，得代丞相程縱、守相郭同、將軍已下至六百石十九人。還，以將軍為太上皇衛一歲七月。以右丞相擊陳豨，殘東垣。又以右丞相從高帝擊黥布，攻其前拒，陷兩陳，得以破布軍，更食曲周五千一百戶，除前所食，凡別破軍三，降定郡六，縣七十三，得丞相、守相、大將各一人，小將二人，二千石已下至六百石十九人。"},{"paragraph_id":"c-shiji-095-fankuang:p020","quote":"漢王立為帝。其秋，燕王臧荼反，嬰以太僕從擊荼。明年，從至陳，取楚王信。更食汝陰，剖符世世勿絕。以太僕從擊代，至武泉、雲中，益食千戶。因從擊韓信軍胡騎晉陽旁，大破之。追北至平城，為胡所圍，七日不得通。高帝使使厚遺閼氏，冒頓開圍一角。高帝出欲馳，嬰固徐行，弩皆持滿外向，卒得脫。益食嬰細陽千戶。復以太僕從擊胡騎句注北，大破之。以太僕擊胡騎平城南，三陷陳，功為多，賜所奪邑五百戶。以太僕擊陳豨、黥布軍，陷陳卻敵，益食千戶，定食汝陰六千九百戶，除前所食。"},{"paragraph_id":"c-shiji-095-fankuang:p028","quote":"漢王立為皇帝，賜益嬰邑三千戶。其秋，以車騎將軍從擊破燕王臧荼。明年，從至陳，取楚王信。還，剖符，世世勿絕，食潁陰二千五百戶，號曰潁陰侯。"}],"rationale":"按本篇分傳、明示姓名與敘事承接限定異稱。酈寄字況據第14段；夏侯嬰的嬰限定第16至21段，灌嬰限定第22至33段，桓嬰另人。第6與20、28段楚王信和反韓王信分人；未詳名王侯不補名。同名跨篇同指另待逐項證據。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-095-fankuang:p006","text":"項籍既死，漢王為帝，以噲堅守戰有功，益食八百戶。從高帝攻反燕王臧荼，虜荼，定燕地。楚王韓信反，噲從至陳，取信，定楚。更賜爵列侯，與諸侯剖符，世世勿絕，食舞陽，號為舞陽侯，除前所食。以將軍從高祖攻反韓王信於代。自霍人以往至雲中，與絳侯等共定之，益食千五百戶。因擊陳豨與曼丘臣軍，戰襄國，破柏人，先登，降定清河、常山凡二十七縣，殘東垣，遷為左丞相。破得綦毋卹、尹潘軍於無終、廣昌。破豨別將胡人王黃軍於代南，因擊韓信軍於參合。軍所將卒斬韓信，破豨胡騎橫谷，斬將軍趙既，虜代丞相馮梁、守孫奮、大將王黃、將軍、（太卜）太仆解福等十人。與諸將共定代鄉邑七十三。其後燕王盧綰反，噲以相國擊盧綰，破其丞相抵薊南，定燕地，凡縣十八，鄉邑五十一。益食邑千三百戶，定食舞陽五千四百戶。從，斬首百七十六級，虜二百八十八人。別，破軍七，下城五，定郡六，縣五十二，得丞相一人，將軍十二人，二千石已下至三百石十一人。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-095-fankuang:m006-0000","start":0,"end":2,"surface":"項籍","kind":"person","person_id":"qcp_ou0_2g1","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0005","start":5,"end":7,"surface":"漢王","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0011","start":11,"end":12,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0025","start":25,"end":27,"surface":"高帝","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0031","start":31,"end":33,"surface":"臧荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0035","start":35,"end":36,"surface":"荼","kind":"person","person_id":"un2_jcz_dkt","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0041","start":41,"end":45,"surface":"楚王韓信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0047","start":47,"end":48,"surface":"噲","kind":"person","person_id":"d9y_q1n_fte","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0053","start":53,"end":54,"surface":"信","kind":"person","person_id":"j4e_gam_0tl","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0094","start":94,"end":96,"surface":"高祖","kind":"person","person_id":"vok_rjp_tag","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0098","start":98,"end":101,"surface":"韓王信","kind":"person","person_id":"39e_wj9_6m0","status":"contextual_provisional"},{"id":"c-shiji-095-fankuang:m006-0114","start":114,"end":116,"surface":"絳侯","kind":"person","person_id":"s8n_dgg_60b","status":"contextual_provisional"},{"id":"c-shiji-095