tions":[],"table_occurrences":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[],"equivalence_decisions":[],"passages":[{"id":"c-jinshu-080-wangxizhi-family:line092","text":"時吳中一士大夫家有好竹，欲觀之，便出坐輿造竹下，諷嘯良久。主人灑掃請坐，徽之不顧。將出，主人乃閉門，徽之便以此賞之，盡歎而去。嘗寄居空宅中，便令種竹。或問其故，徽之但嘯詠，指竹曰：「何可一日無此君邪！」嘗居山陰，夜雪初霽，月色清朗，四望皓然，獨酌酒詠左思《招隱詩》，忽憶戴逵。逵時在剡，便夜乘小船詣之，經宿方至，造門不前而反。人問其故，徽之曰：「本乘興而行，興盡而反，何必見安道邪！」雅性放誕，好聲色，嘗夜與弟獻之共讀《高士傳贊》，獻之賞井丹高潔，徽之曰：「未若長卿慢世也。」其傲達若此。時人皆欽其才而穢其行。","text_layer":"received_chapter","annotation_status":"reviewed","mentions":[{"id":"c-jinshu-080-wangxizhi-family:line092:m0036","start":36,"end":38,"surface":"徽之","person_id":"326_faf_cd3_B","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line092:m0050","start":50,"end":52,"surface":"徽之","person_id":"326_faf_cd3_B","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line092:m0080","start":80,"end":82,"surface":"徽之","person_id":"326_faf_cd3_B","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line092:m0125","start":125,"end":127,"surface":"左思","person_id":"e96_7e2_34a","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line092:m0135","start":135,"end":137,"surface":"戴逵","person_id":"056_cvo_54m","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line092:m0138","start":138,"end":139,"surface":"逵","person_id":"056_cvo_54m","kind":"person","status":"contextual_provisional","interpretation_note":"依本段人物敘述及相應早期文獻確定。"},{"id":"c-jinshu-080-wangxizhi-family:line092:m0168","start":168,"end":170,"surface":"徽之","person_id":"326_faf_cd3_B","kind":"person","status":"contextual_provisional","interpreta