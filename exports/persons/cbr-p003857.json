testations":[{"id":"th-shiji066-026:a001","paragraph_id":"c-shiji-066-wu:p023","start":62,"end":64,"surface":"夫人","person_mention_id":"c-shiji-066-wu:m023-0061","usage":"narrative"}],"effective_period":{"start":{"status":"unknown","date_expression":null,"evidence":[]},"end":{"status":"unknown","date_expression":null,"evidence":[]}},"interpretation_note":"授官事件與文獻用稱分存。首次提及、逃亡、死亡不推定任期終點；平王、昭王、闔廬、夫差王稱隨敘事分辨。夫概自立王不作合法授爵，封堂谿未補侯爵；王子綦佯充王及石乞事成為卿的未遂條件均不當實際任職。白公的號與封邑分存，未確定爵級。來源相對年序未換算為精確紀年，版本及稱號性質仍待覆核。","reviewer":"Codex（AI 代理）"}],"address_assertions":[],"date_normalizations":[],"birth_order_constraints":[],"preferred_birth_order_constraints":[],"identity_decisions":[{"id":"d-shiji066-050","person_id":"l7z_yra_bbp","scope":"same_chapter","chapter_ids":["c-shiji-066-wu"],"status":"contextual_provisional","reviewer":"Codex（AI 代理）","surfaces":["昭夫人"],"evidence":[{"paragraph_id":"c-shiji-066-wu:p023","quote":"其後四歲，白公勝與石乞襲殺楚令尹子西、司馬子綦於朝。石乞曰：「不殺王，不可。」乃劫（之）王如高府。石乞從者屈固負楚惠王亡走昭夫人之宮。葉公聞白公為亂，率其國人攻白公。白公之徒敗，亡走山中，自殺。而虜石乞，而問白公尸處，不言將亨。石乞曰：「事成為卿，不成而亨，固其職也。」終不肯告其尸處。遂亨石乞，而求惠王復立之。"}],"rationale":"依本篇明示姓名及局部敘事暫接異稱：公子光自立為闔廬、軫立為昭王、勝號白公；王稱隨敘事主體分段。王子綦佯充王不接昭王，與後文司馬子綦暫分候選但不斷言異人。悼公與陽生按本文分存，矛盾待版本覆核；鮑氏不強接鮑牧。未名父子只按本段明示保存，不補姓名。"}],"equivalence_decisions":[],"passages":[{"id":"c-shiji-066-wu:p023","text":"其後四歲，白公勝與石乞襲殺楚令尹子西、司馬子綦於朝。石乞曰：「不殺王，不可。」乃劫（之）王如高府。石乞從者屈固負楚惠王亡走昭夫人之宮。葉公聞白公為亂，率其國人攻白公。白公之徒敗，亡走山中，自殺。而虜石乞，而問白公尸處，不言將亨。石乞曰：「事成為卿，不成而亨，固其職也。」終不肯告其尸處。遂亨石乞，而求惠王復立之。","annotation_status":"named_mentions_first_pass","text_layer":"received_chapter","mentions":[{"id":"c-shiji-066-wu:m023-0005","start":5,"end":8,"surface":"白公勝","kind":"person","person_id":"h69_ln7_f94_A","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0009","start":9,"end":11,"surface":"石乞","kind":"person","person_id":"6xf_5sb_pd8","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0013","start":13,"end":18,"surface":"楚令尹子西","kind":"person","person_id":"ehf_uuv_att","status":"contextual_provisional"},{"id":"c-shiji-066-wu:m023-0019"