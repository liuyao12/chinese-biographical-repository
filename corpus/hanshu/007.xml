<text format-version="0.2" work-id="w-hanshu" book-id="b-hanshu-007" chapter-id="c-hanshu-007-zhaodi" source-id="s-hanshu-007-zhaodi">
  <p id="c-hanshu-007-zhaodi:accession:p001" annotation-status="in_progress" text-layer="received_chapter">明日<persName id="c-hanshu-007-zhaodi:accession:p001:m0002" ref="yqp_nlb_p1p_ACAA">武帝</persName>崩戊辰<persName id="c-hanshu-007-zhaodi:accession:p001:m0007" ref="yqp_nlb_p1p_ACAAE">太子</persName>即皇帝位謁高廟<persName id="c-hanshu-007-zhaodi:accession:p001:m0016" ref="yqp_nlb_p1p_ACAAE">帝</persName>姊<persName id="c-hanshu-007-zhaodi:accession:p001:m0018" ref="6it_qfa_gdg">鄂邑公主</persName>益湯沐邑為<persName id="c-hanshu-007-zhaodi:accession:p001:m0027" ref="6it_qfa_gdg">長公主</persName>共養省中</p>
  <p id="c-hanshu-007-zhaodi:empress:p001" annotation-status="in_progress" text-layer="received_chapter">四年春三月甲寅立<persName id="c-hanshu-007-zhaodi:empress:p001:m0008" ref="1kj_vhc_cx9_AA">皇后上官氏</persName>赦天下</p>
  <p id="c-hanshu-007-zhaodi:empress-father:p001" annotation-status="in_progress" text-layer="received_chapter">六月封<persName id="c-hanshu-007-zhaodi:empress-father:p001:m0003" ref="1kj_vhc_cx9_AA">皇后</persName>父驃騎將軍<persName id="c-hanshu-007-zhaodi:empress-father:p001:m0010" ref="1kj_vhc_cx9_A">上官安</persName>為桑樂侯</p>
  <p id="c-hanshu-007-zhaodi:conspiracy:p001" annotation-status="in_progress" text-layer="received_chapter">九月<persName id="c-hanshu-007-zhaodi:conspiracy:p001:m0002" ref="6it_qfa_gdg">鄂邑長公主</persName><persName id="c-hanshu-007-zhaodi:conspiracy:p001:m0007" ref="yqp_nlb_p1p_ACAAB">燕王旦</persName>與左將軍<persName id="c-hanshu-007-zhaodi:conspiracy:p001:m0014" ref="1kj_vhc_cx9">上官桀</persName><persName id="c-hanshu-007-zhaodi:conspiracy:p001:m0017" ref="1kj_vhc_cx9">桀</persName>子票騎將軍<persName id="c-hanshu-007-zhaodi:conspiracy:p001:m0023" ref="1kj_vhc_cx9_A">安</persName>御史大夫<persName id="c-hanshu-007-zhaodi:conspiracy:p001:m0028" ref="fi2_2cl_w22">桑𢎞羊</persName>皆謀反伏誅</p>
</text>
