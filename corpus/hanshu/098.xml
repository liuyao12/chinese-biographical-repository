<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-hanshu" book-id="b-hanshu-098" chapter-id="c-hanshu-098-yuanhou" source-id="s-hanshu-098-yuanhou">
  <p id="c-hanshu-098-yuanhou:p-origin-001" annotation-status="named_mentions_first_pass" text-layer="received_chapter">今<persName id="c-hanshu-098-yuanhou:m-origin-001-0001" ref="4w5_b4e_vf5">王翁孺</persName>徙正直其地日月當之元城郭東有五鹿之虚即沙鹿地也後八十年當有貴女興天下云</p>
  <p id="c-hanshu-098-yuanhou:p-kin-001" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-hanshu-098-yuanhou:m-kin-001-0000" ref="4w5_b4e_vf5">翁孺</persName>生<persName id="c-hanshu-098-yuanhou:m-kin-001-0003" ref="4w5_b4e_vf5_A">禁</persName>字<persName id="c-hanshu-098-yuanhou:m-kin-001-0005" ref="4w5_b4e_vf5_A">稚君</persName>少學法律長安為廷尉史本始三年生女<persName id="c-hanshu-098-yuanhou:m-kin-001-0023" ref="4w5_b4e_vf5_AB">政君</persName>即<persName id="c-hanshu-098-yuanhou:m-kin-001-0026" ref="4w5_b4e_vf5_AB">元后</persName>也</p>
  <p id="c-hanshu-098-yuanhou:p-kin-002" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-hanshu-098-yuanhou:m-kin-002-0000" ref="4w5_b4e_vf5_A">禁</persName>有大志不修㢘隅好酒色多取傍妻凡有四女八男長女<persName id="c-hanshu-098-yuanhou:m-kin-002-0023" ref="4w5_b4e_vf5_AA">君俠</persName>次即<persName id="c-hanshu-098-yuanhou:m-kin-002-0027" ref="4w5_b4e_vf5_AB">元后</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0029" ref="4w5_b4e_vf5_AB">政君</persName>次<persName id="c-hanshu-098-yuanhou:m-kin-002-0032" ref="4w5_b4e_vf5_AC">君力</persName>次<persName id="c-hanshu-098-yuanhou:m-kin-002-0035" ref="4w5_b4e_vf5_AD">君弟</persName>長男<persName id="c-hanshu-098-yuanhou:m-kin-002-0039" ref="4w5_b4e_vf5_AE">鳳</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0040" ref="4w5_b4e_vf5_AE">孝卿</persName>次<persName id="c-hanshu-098-yuanhou:m-kin-002-0043" ref="4w5_b4e_vf5_AF">曼</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0044" ref="4w5_b4e_vf5_AF">元卿</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0046" ref="4w5_b4e_vf5_AG">譚</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0047" ref="4w5_b4e_vf5_AG">子元</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0049" ref="4w5_b4e_vf5_AH">崇</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0050" ref="4w5_b4e_vf5_AH">少子</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0052" ref="4w5_b4e_vf5_AI">商</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0053" ref="4w5_b4e_vf5_AI">子夏</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0055" ref="4w5_b4e_vf5_AJ">立</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0056" ref="4w5_b4e_vf5_AJ">子叔</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0058" ref="4w5_b4e_vf5_AK">根</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0059" ref="4w5_b4e_vf5_AK">稚卿</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0061" ref="4w5_b4e_vf5_AL">逢時</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0063" ref="4w5_b4e_vf5_AL">季卿</persName>唯<persName id="c-hanshu-098-yuanhou:m-kin-002-0066" ref="4w5_b4e_vf5_AE">鳳</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0067" ref="4w5_b4e_vf5_AH">崇</persName>與<persName id="c-hanshu-098-yuanhou:m-kin-002-0069" ref="4w5_b4e_vf5_AB">元后</persName><persName id="c-hanshu-098-yuanhou:m-kin-002-0071" ref="4w5_b4e_vf5_AB">政君</persName>同母母適妻魏郡<persName id="c-hanshu-098-yuanhou:m-kin-002-0080" ref="2cf_ibm_2cg">李氏</persName>女也</p>
</text>
