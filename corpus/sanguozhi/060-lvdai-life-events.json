    {
      "id": "le-wu060-lvdai3",
      "person_id": "xqk_f8a_dvz",
      "event_type": "death",
      "source_term": "桓、厲等皆見斬獲",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-060",
