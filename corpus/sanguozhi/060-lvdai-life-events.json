      "person_id": "gw4_n7v_ssj",
      "event_type": "death",
      "source_term": "及原死",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-060",
          "chapter_id": "c-sanguozhi-060-lvdai",
          "source_id": "s-sanguozhi-060-lvdai",
          "paragraph_id": "c-sanguozhi-060-lvdai:line063",
          "quote": "　　始，岱親近吳郡徐原，慷慨有才志，岱知其可成，賜巾褠，與共言論，後遂薦拔，官至侍御史。原性忠壯，好直言，岱時有得失，原輒諫諍，又公論之，人或以告岱，岱歎曰：\"是我所以貴德淵者也。\"及原死，岱哭之甚哀。曰：“德淵，呂岱之益友，今不幸，岱復於何聞過？”談者美之。",
          "person_mention_id": "c-sanguozhi-060-lvdai:line063:m0009"
        }
      ],
      "interpretation_note": "本來源所記。",
      "status": "source_attested",
