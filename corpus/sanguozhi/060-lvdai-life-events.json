    {
      "id": "le-wu060-lvdai8",
      "person_id": "lii_454_vuv",
      "event_type": "death",
      "source_term": "及陸遜卒",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-060",
          "chapter_id": "c-sanguozhi-060-lvdai",
          "source_id": "s-sanguozhi-060-lvdai",
          "paragraph_id": "c-sanguozhi-060-lvdai:line061",
          "quote": "及陸遜卒，諸葛恪代遜，權乃分武昌為兩部，岱督右部，自武昌上至蒲圻。遷上大將軍，拜子凱副軍校尉，監兵蒲圻，孫亮即位，拜大司馬。岱清身奉公，所在可述。初在交州，歷年不餉家，妻子饑乏。權聞之歎息，以讓群臣曰：“呂岱出身萬里，為國勤事，家門內困，而孤不早知。股肱耳目，其責安在？”於是加賜錢米布絹，歲有常限。",
          "person_mention_id": "c-sanguozhi-060-lvdai:line061:m0001"
        }
      ],
      "interpretation_note": "本來源所記。",
      "status": "source_attested",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false,
