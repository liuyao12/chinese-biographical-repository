      "source_term": "年四十四卒",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-060",
          "chapter_id": "c-sanguozhi-060-quancong",
          "source_id": "s-sanguozhi-060-quancong",
          "paragraph_id": "c-sanguozhi-060-quancong:line042-pei01-01",
          "quote": "吴书曰：琮长子绪，幼知名，奉朝请，出授兵，稍迁扬武将军、牛渚督。孙亮即位，迁镇北将军。东关之役，绪与丁奉建议引兵先出，以破魏军，封一子亭侯，年四十四卒。次子寄，坐阿党鲁王霸赐死。小子吴，孙权外孙，封都乡侯。",
          "person_mention_id": "c-sanguozhi-060-quancong:line042-pei01-01:m0007"
        }
