    {
      "id": "le-wu059-he2",
      "person_id": "572_278_cba_A",
      "event_type": "death",
      "source_term": "又遣使者賜死",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-059",
          "chapter_id": "c-sanguozhi-059-he",
          "source_id": "s-sanguozhi-059-he",
          "paragraph_id": "c-sanguozhi-059-he:line034",
          "quote": "太元二年正月，封和爲南陽王，遣之長沙。四月，權薨，諸葛恪秉政。恪即和妃張之舅也。妃使黃門陳遷之建業上疏中宮，并致問於恪。臨去，恪謂遷曰：「爲我達妃，期當使勝他人。」此言頗泄。又恪有徙都意，使治武昌宮，民間或言欲迎和。及恪被誅，孫峻因此奪和璽綬，徙新都，又遣使者賜死。和與妃張辭別，張曰：「吉凶當相隨，終不獨生活也。」亦自殺，舉邦傷焉。",
          "person_mention_id": "c-sanguozhi-059-he:line034:m0008"
        }
      ],
      "interpretation_note": "本來源所記。",
      "status": "source_attested",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false,
      "model": null
    },
