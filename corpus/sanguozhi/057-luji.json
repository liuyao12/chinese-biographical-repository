    "source_reading_cases": [
      {
        "id": "c-sanguozhi-057-luji:line037:reading-000-207",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-057-luji:line037",
        "start_codepoint": 0,
        "end_codepoint": 207,
        "source_quote": "陸績字公紀，吳郡吳人也。父康，漢末為廬江太守。績年六歲，於九江見袁術。術出橘，績懷三枚，去，拜辭墮地，術謂曰：“陸郎作賓客而懷橘乎？”績跪答曰：\"欲歸遺母。\"術大奇之。孫策在吳，張昭、張紘、秦松為上賓，共論四海未泰，須當用武治而平之，績年少末坐，遙大聲言曰：\"昔管夷吾相齊桓公，九合諸候，一匡天下，不用兵車。孔子曰：'遠人不服，則修文德以來之。'今論者不務道德懷取之術，而惟尚武，績雖童蒙，竊所未安也。\"昭等異焉。",
        "person_id": "7ec_qvv_x1c",
        "related_person_ids": [
          "tfy_qzo_rqx",
          "865_b69_cb0",
          "e9c_070_567",
          "roi_rz4_ute",
          "6bz_2xv_ow3",
          "2fy_jac_mju",
          "h1v_8ap_b9y",
          "9w2_c77_53m",
          "fp6_ia6_7yw"
        ],
        "reading": "吳郡吳人。績為廬江太守康之子，六歲見袁術；孫策賓客張昭、張紘、秦松與績論治。末引管仲事及孔子。"
      },
      {
        "id": "c-sanguozhi-057-luji:line037-pei01-01:reading-000-076",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-057-luji:line037-pei01-01",
        "start_codepoint": 0,
        "end_codepoint": 76,
        "source_quote": "谢承《后汉书》曰：康字季宁，少惇孝悌，勤脩操行，太守李肃察孝廉。肃后坐事伏法，康敛尸送丧还颍川，行服，礼终，举茂才，历三郡太守，所在称治，后拜庐江太守。",
        "person_id": "tfy_qzo_rqx",
        "related_person_ids": [
          "khh_wth_u1d",
          "tlp_ivr_mb3"
        ],
        "reading": "謝承後漢書補康之字與歷官。察康孝廉者太守李肅，康在肅身後收葬服喪。"
      },
      {
        "id": "c-sanguozhi-057-luji:line039:reading-000-245",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-057-luji:line039",
        "start_codepoint": 0,
        "end_codepoint": 245,
        "source_quote": "績容貌雄壯，博學多識，星歷算數無不該覽。虞翻舊齒名盛，龐統荊州令士，年亦差長，皆與績友善。孫權統事，闢為奏曹掾，以直道見憚，出為鬱林太守，加偏將軍，給兵二千人。績既有躄疾，又意在儒雅，非其志也。雖有軍事，著述不廢，作《渾天圖》，注《易》釋《玄》，皆傳於世。豫自知亡日，乃為辭曰：\"有漢志士吳郡陸績，幼敦《詩》、《書》，長玩《禮》、《易》受命南征，遘疾遇厄，遭命不幸，嗚呼悲隔！\"又曰：\"從今已去，六十年之外，車同軌，書同文，恨不及見也。\"年三十二卒。長子宏，會稽南部都尉，次子睿，長水校尉。",
        "person_id": "7ec_qvv_x1c",
        "related_person_ids": [
          "izi_e36_p1g",
          "ty3_zpc_cxm",
          "572_278_cba",
          "7ec_qvv_x1c_A",
          "7ec_qvv_x1c_B"
        ],
        "reading": "出為鬱林太守。自作辭中六十年之外為所述後事，卒年三十二。長子宏、次子睿分任都尉、校尉。"
      },
      {
        "id": "c-sanguozhi-057-luji:line039-pei01-01:reading-000-019",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-057-luji:line039-pei01-01",
        "start_codepoint": 0,
        "end_codepoint": 19,
        "source_quote": "绩於鬱林所生女，名曰鬱生，適张温弟白。",
        "person_id": "7ec_qvv_x1c_C",
        "related_person_ids": [
          "7ec_qvv_x1c",
          "xuu_do0_zbf",
          "xpd_ary_5a9"
        ],
        "reading": "裴注先敘績在鬱林所生女名鬱生，配張溫弟白；再引姚信集表。"
      },
      {
        "id": "c-sanguozhi-057-luji:line039-pei01-02:reading-000-341",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-057-luji:line039-pei01-02",
        "start_codepoint": 0,
        "end_codepoint": 341,
        "source_quote": "姚信《集》有表称之曰：“臣闻唐、虞之政，举善而教，旌德擢异，三王所先，是以忠臣烈士，显名国朝，淑妇贞女，表迹家闾。盖所以阐崇化业，广殖清风，使苟有令性，幽明俱著，苟怀懿姿，士女同荣。故王蠋建寒松之节而齐王表其里，义姑立殊绝之操而鲁侯高其门。臣切见故鬱林太守陆绩女子鬱生，少履贞特之行，幼立匪石之节，年始十三，適同郡张白。侍庙三月，妇礼未卒，白遭罹家祸，迁死异郡。鬱生抗声昭节，义形於色，冠盖交横，誓而不许，奉白姊妹嶮巇之中，蹈履水火，志怀霜雪，义心固於金石，体信贯於神明，送终以礼，邦士慕则。臣闻昭德以行，显行以爵，苟非名爵，则劝善不严，故士之有诔，鲁人志其勇，杞妇见书，齐人哀其哭。乞蒙圣朝，斟酌前训，上开天聪，下垂坤厚，褒鬱生以义姑之号，以厉两髦之节，则皇风穆暢，士女改视矣。”",
        "person_id": "evj_3wb_3l3",
        "related_person_ids": [
          "rqv_zm4_apj",
          "7ec_qvv_x1c",
          "7ec_qvv_x1c_C",
          "xpd_ary_5a9"
        ],
        "reading": "姚信上表求褒鬱生。姚表記年始十三適張白、婚後三月白遷死；請賜義姑之號，未言獲准。"
      }
    ],
