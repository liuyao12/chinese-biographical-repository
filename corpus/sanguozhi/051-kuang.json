    "source_reading_cases": [
      {
        "id": "c-sanguozhi-051-kuang:line044:reading-000-160",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-051-kuang:line044",
        "start_codepoint": 0,
        "end_codepoint": 160,
        "source_quote": "　　孫匡字季佐，翊弟也。舉孝廉茂才，未試用，卒。時年二十餘。子泰，曹氏之甥也，為長水校尉。嘉禾三年，從權圍新城，中流矢死。泰子秀為前將軍、夏口督。秀公室至親，握兵在外，皓意不能平。建衡二年，皓遣何定將五千人至夏口獵。先是，民間歛言秀當見圖，而定遠獵，秀遂驚，夜將妻子親兵數百人奔晉。晉以秀為驃騎將軍、儀同三司，封會稽公。",
        "person_id": "icr_lwq_9mp",
        "related_person_ids": [
          "iyi_e4b_ig6",
          "icr_lwq_9mp_A",
          "572_278_cba",
          "icr_lwq_9mp_AA",
          "05e_9bb_55a",
          "h6n_ozv_ytl"
        ],
        "reading": "匡為翊弟，未試用，卒年二十餘。子泰為曹氏甥，未能以曹氏一詞定其舅姓名。泰子秀以吳夏口督奔晉。"
      },
      {
        "id": "c-sanguozhi-051-kuang:line044-pei01-01:reading-000-068",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-051-kuang:line044-pei01-01",
        "start_codepoint": 0,
        "end_codepoint": 68,
        "source_quote": "《江表传》曰：曹休出洞口，吕范率军御之。时匡为定武中郎将，（遣）范令放火，烧损茅芒，以乏军用，范即启送匡还吴。权别其族为丁氏，禁固终身。",
        "person_id": "icr_lwq_9mp",
        "related_person_ids": [
          "h7n_w5t_i1c_AA",
          "908_816_219",
          "572_278_cba"
        ],
        "reading": "江表傳所署名匡，犯軍令並改其族為丁氏；下一段裴按異議。"
      },
      {
        "id": "c-sanguozhi-051-kuang:line044-pei01-02:reading-000-141",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-051-kuang:line044-pei01-02",
        "start_codepoint": 0,
        "end_codepoint": 141,
        "source_quote": "臣松之案本传曰：“匡未试用卒，时年二十餘。”而《江表传》云吕范在洞口，匡为定武中郎将。既为定武，非为未试用。且孙坚以初平二年卒，洞口之役在黃初三年，坚卒至此合三十一年，匡时若尚在，本传不得云卒时年二十餘也。此盖权别生弟朗，《江表传》误以为匡也。朗之名位见《三朝录》及虞喜《志林》也。",
        "person_id": "vpy_180_2oi_AA",
        "related_person_ids": [
          "icr_lwq_9mp",
          "908_816_219",
          "ki7_rgz_3l4",
          "572_278_cba",
          "z00_8wa_sky",
          "fq3_53z_4os"
        ],
        "reading": "裴據初平二年與黃初三年、三十一年及本傳未試用，推江表傳誤匡為朗。其說保留，不改江表傳原稱。"
      },
      {
        "id": "c-sanguozhi-051-kuang:line044-pei02-01:reading-000-018",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-051-kuang:line044-pei02-01",
        "start_codepoint": 0,
        "end_codepoint": 18,
        "source_quote": "《江表传》曰：皓大怒，追改秀姓曰厉。",
        "person_id": "icr_lwq_9mp_AA",
        "related_person_ids": [
          "05e_9bb_55a"
        ],
        "reading": "江表傳說孫皓因秀奔晉追改姓厉；只在本段記命改。"
      },
      {
        "id": "c-sanguozhi-051-kuang:line044-pei02-02:reading-000-084",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-051-kuang:line044-pei02-02",
        "start_codepoint": 0,
        "end_codepoint": 84,
        "source_quote": "干宝《晋纪》曰：秀在晋朝，初闻皓降，群臣毕贺，秀称疾不与，南向流涕曰：“昔讨逆弱冠以一校尉创业，今后主举江南而弃之，宗庙山陵，於此为墟。悠悠苍天，此何人哉！”朝廷美之。",
        "person_id": "icr_lwq_9mp_AA",
        "related_person_ids": [
          "58b_0c7_605",
          "05e_9bb_55a",
          "e9c_070_567"
        ],
        "reading": "干寶晉紀載吳降時秀稱疾，所追念討逆為孫策、後主為孫皓。"
      },
      {
        "id": "c-sanguozhi-051-kuang:line044-pei02-03:reading-000-047",
        "kind": "annotation_sentence",
        "paragraph_id": "c-sanguozhi-051-kuang:line044-pei02-03",
        "start_codepoint": 0,
        "end_codepoint": 47,
        "source_quote": "《晋诸公赞》曰：吴平，降为伏波将军，开府如故。永宁中卒，追赠骠骑、开府。子俭，字仲节，给事中。",
        "person_id": "icr_lwq_9mp_AA",
        "related_person_ids": [
          "icr_lwq_9mp_AAA"
        ],
        "reading": "晉諸公贊載吳平後降伏波、永寧中卒及追贈。子儉字仲節，為給事中。"
      }
    ],
