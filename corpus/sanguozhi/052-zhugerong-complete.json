    "source_reading_cases": [
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080:reading-000-027",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [
          "512_1cd_a4b",
          "lpo_z63_vzb"
        ],
        "start_codepoint": 0,
        "end_codepoint": 27,
        "source_quote": "恪已自封侯，故弟融襲爵。攝兵業駐公安，部曲吏士親附之。",
        "reading": "兄恪已有侯爵，弟融繼承父爵與公安兵眾。卷六十四恪致弟書題稱公安督融。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080:reading-027-129",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [],
        "start_codepoint": 27,
        "end_codepoint": 129,
        "source_quote": "疆外無事，秋冬則射獵講武，春夏則延賓高會，休吏假卒，或不遠千里而造焉。每會輒歷問賓客，各言其能，乃合榻促席，量敵選對，或有博弈，或有摴蒱，投壺弓彈，部別類分，於是甘果繼進，清酒徐行，融周流觀覽，終日不倦。",
        "reading": "四季講武、設宴與賓客的遊藝。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080:reading-129-157",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [
          "lpo_z63_vzb",
          "512_1cd_a4b"
        ],
        "start_codepoint": 129,
        "end_codepoint": 157,
        "source_quote": "融父兄質素，雖在軍旅，身無采飾；而融錦罽文繡，獨爲奢綺。",
        "reading": "「父兄」分指父諸葛瑾與兄諸葛恪。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080:reading-157-188",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [
          "572_278_cba",
          "512_1cd_a4b"
        ],
        "start_codepoint": 157,
        "end_codepoint": 188,
        "source_quote": "孫權薨，徙奮威將軍。後恪征淮南，假融節，令引軍入沔，以擊西兵。",
        "reading": "孫權死後融徙奮威將軍。恪征淮南，融受節進沔。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080:reading-188-213",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [
          "512_1cd_a4b",
          "672_8ty_yoe",
          "cfb_d3e_1b8",
          "wpk_253_fu9",
          "aa5_798_24b"
        ],
        "start_codepoint": 188,
        "end_codepoint": 213,
        "source_quote": "恪既誅，遺無難督施寬就將軍施績、孫壹、全熙等取融。",
        "reading": "恪誅後，無難督施寬會同將軍施績、孫壹、全熙取融。卷五十一孫奐傳則由壹追述此役。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080:reading-213-246",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [],
        "start_codepoint": 213,
        "end_codepoint": 246,
        "source_quote": "融卒聞兵士至，惶懼猶豫，不能決計，兵到圍城，飲藥而死，三子皆伏誅。",
        "reading": "正文作飲藥而死，三子伏誅而均未具名。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080-pei01-01:reading-000-051",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080-pei01-01",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [],
        "start_codepoint": 0,
        "end_codepoint": 51,
        "source_quote": "吴书曰：融字叔长，生於宠贵，少而骄乐，学为章句，博而不精，性宽容，多技艺，数以巾褐奉朝请，后拜骑都尉。",
        "reading": "裴注所引《吳書》字叔長及少時技藝、騎都尉。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080-pei01-01:reading-051-091",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080-pei01-01",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [
          "djn_r5z_2w9",
          "syc_ik6_bq5_**AAB"
        ],
        "start_codepoint": 51,
        "end_codepoint": 91,
        "source_quote": "赤乌中，诸郡出部伍，新都都尉陈表、吴郡都尉顾承各率所领人会佃毗陵，男女各数万口。",
        "reading": "吳書分稱新都都尉陳表與吳郡都尉顧承。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080-pei01-01:reading-091-108",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080-pei01-01",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [
          "djn_r5z_2w9",
          "572_278_cba",
          "lpo_z63_vzb"
        ],
        "start_codepoint": 91,
        "end_codepoint": 108,
        "source_quote": "表病死，权以融代表，后代父瑾领摄。",
        "reading": "表死後孫權先以融代陳表，繼而融代父瑾領攝。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080-pei02-01:reading-000-045",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080-pei02-01",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [],
        "start_codepoint": 0,
        "end_codepoint": 45,
        "source_quote": "江表传曰：先是，公安有灵鼍鸣，童谣曰：「白鼍鸣，龟背平，南郡城中可长生，守死不去义无成。」",
        "reading": "《江表傳》以公安鼉鳴與童謠為先兆，按所引書記傳聞。"
      },
      {
        "id": "c-sanguozhi-052-zhugerong-complete:line080-pei02-01:reading-045-062",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhugerong-complete:line080-pei02-01",
        "person_id": "lpo_z63_vzb_B",
        "related_person_ids": [
          "512_1cd_a4b"
        ],
        "start_codepoint": 45,
        "end_codepoint": 62,
        "source_quote": "及恪被诛，融果刮金印龟，服之而死。",
        "reading": "刮金印龜服之而死是《江表傳》的具體說法。正文僅作飲藥。"
      }
    ],
