        "start_codepoint": 0,
        "end_codepoint": 10,
        "source_quote": "谢景事在〈孙登传〉。",
        "reading": "裴注轉指卷五十九孫登傳，有謝景字叔發、南陽宛人及卒官。"
      },
      {
        "id": "c-sanguozhi-052-zhangcheng-complete:line032-pei02-01:reading-000-026",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhangcheng-complete:line032-pei02-01",
        "person_id": "vpy_180_2oi_AA",
