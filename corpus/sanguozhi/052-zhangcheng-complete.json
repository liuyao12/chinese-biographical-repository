        "start_codepoint": 0,
        "end_codepoint": 35,
        "source_quote": "吴录曰：款字文德，历位内外，以清贞显於当世。后以卫尉领中书令，封留侯。",
        "reading": "吳錄記款字、官爵。"
      },
      {
        "id": "c-sanguozhi-052-zhangcheng-complete:line032-pei01-01:reading-035-064",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhangcheng-complete:line032-pei01-01",
