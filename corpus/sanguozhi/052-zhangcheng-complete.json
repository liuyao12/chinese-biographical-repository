        "end_codepoint": 26,
        "source_quote": "承字仲嗣，少以才學知名，與諸葛瑾、歩騭、嚴畯相友善。",
        "reading": "名、字與交遊。"
      },
      {
        "id": "c-sanguozhi-052-zhangcheng-complete:line032:reading-026-084",
        "kind": "received_sentence",
        "paragraph_id": "c-sanguozhi-052-zhangcheng-complete:line032",
