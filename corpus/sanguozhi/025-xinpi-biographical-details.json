      "date_expression": null,
      "source_revision": "214fcafa79894355909c9d8c2c1533089e7791c6",
      "paragraph_sha256": "8faa2f1389b713c18758f695458c4eff3c0486c72973733ce2853ba4037065f0",
      "values": {
        "author_person_id": "r5i_988_cxa",
