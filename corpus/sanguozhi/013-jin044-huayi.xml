<text format-version="0.2" work-id="w-sanguozhi" book-id="b-sanguozhi-013" chapter-id="c-sanguozhi-013-jin044-huayi" source-id="s-sanguozhi-013-jin044-huayi">
  <p id="c-sanguozhi-013-jin044-huayi:sons" annotation-status="reviewed" text-layer="witness_appended_pei_songzhi_note"><persName id="c-sanguozhi-013-jin044-huayi:sons:m0000" ref="418_c91_b6b">廙</persName>三子。<persName id="c-sanguozhi-013-jin044-huayi:sons:m0004" ref="418_c91_b6b_A">昆</persName>字<persName id="c-sanguozhi-013-jin044-huayi:sons:m0006" ref="418_c91_b6b_A">敬倫</persName>，清粹有檢，爲尚書。<persName id="c-sanguozhi-013-jin044-huayi:sons:m0018" ref="4e0_afd_055">薈</persName>字<persName id="c-sanguozhi-013-jin044-huayi:sons:m0020" ref="4e0_afd_055">敬叔</persName>。世語稱<persName id="c-sanguozhi-013-jin044-huayi:sons:m0026" ref="4e0_afd_055">薈</persName>貴正。<persName id="c-sanguozhi-013-jin044-huayi:sons:m0030" ref="eom_42c_5zd">恒</persName>字<persName id="c-sanguozhi-013-jin044-huayi:sons:m0032" ref="eom_42c_5zd">敬則</persName>，以通理稱。<persName id="c-sanguozhi-013-jin044-huayi:sons:m0040" ref="418_c91_b6b_A">昆</persName>，尚書；<persName id="c-sanguozhi-013-jin044-huayi:sons:m0045" ref="4e0_afd_055">薈</persName>，河南尹；<persName id="c-sanguozhi-013-jin044-huayi:sons:m0051" ref="eom_42c_5zd">恒</persName>，左光祿大夫開府。</p>
</text>
