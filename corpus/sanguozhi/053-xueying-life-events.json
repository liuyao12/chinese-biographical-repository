    {
      "id": "le-wu053-xueying1",
      "person_id": "5sl_p6s_iab",
      "event_type": "death",
      "source_term": "昭、廣先亡",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-053",
          "chapter_id": "c-sanguozhi-053-xueying",
          "source_id": "s-sanguozhi-053-xueying",
          "paragraph_id": "c-sanguozhi-053-xueying:line066",
          "quote": "臣聞五帝三王皆立史官，敘錄功美，垂之無窮。漢時司馬遷、班固，咸命世大才，所撰精妙，與六經俱傳。大吳受命，建國南土。大皇帝末年，命太史令丁孚、郎中項峻始撰《吳書》。孚、峻俱非史才，其所撰作，不足紀錄。至少帝時，更差韋曜、周昭、薛瑩、梁廣及臣五人，訪求往事，所共撰立，備有本末。昭、廣先亡，曜負恩蹈罪，瑩出為將，復以過徙，其書遂委滯，迄今末撰奏。臣愚淺才劣，適可為瑩等記注而已，若使撰合，必襲孚、峻之跡，懼墜大皇帝之元功，損當世之盛美。瑩涉學既博，文章尤妙，同寮之中，瑩為冠首。今者見吏，雖多經學，記述之才，如瑩者少，是以慺慺為國惜之。實欲使卒垂成之功，編於前史之末。奏上之後，退填溝壑，無所復恨。",
          "person_mention_id": "c-sanguozhi-053-xueying:line066:m0109"
        }
      ],
      "interpretation_note": "本來源所記。",
      "status": "source_attested",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false,
