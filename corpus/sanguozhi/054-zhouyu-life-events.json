    {
      "id": "le-wu054-zhouyu3",
      "person_id": "f56_938_997_B",
      "event_type": "death",
      "source_term": "會胤病死",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-sanguozhi",
          "book_id": "b-sanguozhi-054",
          "chapter_id": "c-sanguozhi-054-zhouyu",
          "source_id": "s-sanguozhi-054-zhouyu",
          "paragraph_id": "c-sanguozhi-054-zhouyu:line036",
          "quote": "權答曰：「腹心舊勳，與孤協事，公瑾有之，誠所不忘。昔胤年少，初無功勞，橫受精兵，爵以侯將，蓋念公瑾以及於胤也。而胤恃此，酗淫自恣，前後告喻，曾無悛改。孤於公瑾，義猶二君，樂胤成就，豈有已哉？迫胤罪惡，未宜便還，且欲苦之，使自知耳。今二君勤勤援引漢高河山之誓，孤用恧然。雖德非其疇，猶欲庶幾，事亦如爾，故未順旨。以公瑾之子，而二君在中間，苟使能改，亦何患乎！」瑾、騭表比上，朱然及全琮亦俱陳乞，權乃許之。會胤病死。",
          "person_mention_id": "c-sanguozhi-054-zhouyu:line036:m0026"
        }
      ],
      "interpretation_note": "本來源所記。",
      "status": "source_attested",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false,
      "model": null
