      "relation": "migration_destination",
      "place": {
        "source_name": "廬江",
        "place_id": null,
        "modern_identification": null
      },
      "status": "source_attested",
      "date_expression": null,
      "source_term": "避地廬江",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-033",
          "source_id": "s-jinshu-033-wanglan-family",
          "chapter_id": "c-jinshu-033-wanglan-family",
          "paragraph_id": "c-jinshu-033-wanglan-family:p003",
          "person_mention_id": "c-jinshu-033-wanglan-family:p003:m0053",
          "quote": "漢未遭亂，扶母攜弟覽避地廬江，隱居三十餘年，不應州郡之命。母終，居喪毀瘁，杖而後起。徐州刺史呂虔檄爲別駕，祥年垂耳順，固辭不受。覽勸之，爲具車牛，祥乃應召，虔委以州事。於時寇盜充斥，祥率勵兵士，頻討破之。州界清靜，政化大行。時人歌之曰：「海沂之康，實賴王祥。邦國不空，別駕之功。」"
        }
      ],
      "interpretation_note": "扶母攜弟覽避地廬江的同行人物，分錄遷居目的地，不作出生地或傳首籍貫。漢未原字未修，未知確年不填。",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false,
      "model": null
    },
