<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-009" chapter-id="c-jinshu-009-jin098-huanwen-succession" source-id="s-jinshu-009-jin098-huanwen-succession">
  <p id="c-jinshu-009-jin098-huanwen-succession:refusal" annotation-status="reviewed" text-layer="received_chapter">庚申，加大司馬<persName id="c-jinshu-009-jin098-huanwen-succession:refusal:m0007" ref="u9s_w6j_8mc_AA">桓溫</persName>爲丞相，不受。辛酉，<persName id="c-jinshu-009-jin098-huanwen-succession:refusal:m0019" ref="u9s_w6j_8mc_AA">溫</persName>旋自白石，因鎮姑孰。</p>
  <p id="c-jinshu-009-jin098-huanwen-succession:testament" annotation-status="reviewed" text-layer="received_chapter">遺詔以<persName id="c-jinshu-009-jin098-huanwen-succession:testament:m0003" ref="u9s_w6j_8mc_AA">桓溫</persName>輔政，依<persName id="c-jinshu-009-jin098-huanwen-succession:testament:m0009" ref="11e_f2d_5d2">諸葛亮</persName>、<persName id="c-jinshu-009-jin098-huanwen-succession:testament:m0013" ref="7r6_k52_qji_ABAA">王導</persName>故事。</p>
  <p id="c-jinshu-009-jin098-huanwen-succession:emperor" annotation-status="reviewed" text-layer="received_chapter">立會稽王<persName id="c-jinshu-009-jin098-huanwen-succession:emperor:m0004" ref="uke_dff_yrf">昌明</persName>爲皇太子，皇子<persName id="c-jinshu-009-jin098-huanwen-succession:emperor:m0013" ref="dkn_ge4_286_AAAAAAAFA">道子</persName>爲琅邪王，領會稽內史。是日，<persName id="c-jinshu-009-jin098-huanwen-succession:emperor:m0029" ref="dkn_ge4_286_AAAAAAAF">帝</persName>崩于東堂，時年五十三。葬高平陵，廟號<persName id="c-jinshu-009-jin098-huanwen-succession:emperor:m0048" ref="dkn_ge4_286_AAAAAAAF">太宗</persName>。</p>
  <p id="c-jinshu-009-jin098-huanwen-succession:son" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-009-jin098-huanwen-succession:son:m0000" ref="uke_dff_yrf">孝武皇帝</persName>諱<persName id="c-jinshu-009-jin098-huanwen-succession:son:m0005" ref="uke_dff_yrf">曜</persName>，字<persName id="c-jinshu-009-jin098-huanwen-succession:son:m0008" ref="uke_dff_yrf">昌明</persName>，<persName id="c-jinshu-009-jin098-huanwen-succession:son:m0011" ref="dkn_ge4_286_AAAAAAAF">簡文帝</persName>第三子也。</p>
  <p id="c-jinshu-009-jin098-huanwen-succession:wen" annotation-status="reviewed" text-layer="received_chapter">秋七月己亥，使持節、侍中、都督中外諸軍事、丞相、錄尚書、大司馬、揚州牧、平北將軍、徐兗二州刺史、南郡公<persName id="c-jinshu-009-jin098-huanwen-succession:wen:m0051" ref="u9s_w6j_8mc_AA">桓溫</persName>薨。</p>
</text>
