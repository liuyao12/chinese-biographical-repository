<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-031" chapter-id="c-jinshu-031-jingxian-yanghou" source-id="s-jinshu-031-ws2479706-jingxian-yanghou">
  <p id="c-jinshu-031-jingxian-yanghou:p001" text-layer="received_chapter"><persName id="c-jinshu-031-jingxian-yanghou:p001:m0001" ref="dqd_5q9_pkz_BC">景獻羊皇后</persName>諱<persName id="c-jinshu-031-jingxian-yanghou:p001:m0002" ref="dqd_5q9_pkz_BC">徽瑜</persName>，泰山南城人。父<persName id="c-jinshu-031-jingxian-yanghou:p001:m0003" ref="dqd_5q9_pkz_B">茞</persName>，上黨太守；<persName id="c-jinshu-031-jingxian-yanghou:p001:m0004" ref="dqd_5q9_pkz_BC">后</persName>母陳留<persName id="c-jinshu-031-jingxian-yanghou:p001:m0005" ref="6bs_o1d_9ti">蔡氏</persName>，漢左中郎將<persName id="c-jinshu-031-jingxian-yanghou:p001:m0006" ref="gs5_qqu_9ui">邕</persName>之女也。</p>
  <p id="c-jinshu-031-jingxian-yanghou:p002" text-layer="received_chapter"><persName id="c-jinshu-031-jingxian-yanghou:p002:m0001" ref="dqd_5q9_pkz_BC">后</persName>聰敏有才行。<persName id="c-jinshu-031-jingxian-yanghou:p002:m0002" ref="m79_hpb_hq8">景懷皇后</persName>崩，<persName id="c-jinshu-031-jingxian-yanghou:p002:m0003" ref="dkn_ge4_286_AAAAH">景帝</persName>更娶鎮北將軍濮陽<persName id="c-jinshu-031-jingxian-yanghou:p002:m0004" ref="354_b66_61e">吳質</persName><persName id="c-jinshu-031-jingxian-yanghou:p002:m0005" ref="zrm_vi7_fpe">女</persName>，見黜，復納<persName id="c-jinshu-031-jingxian-yanghou:p002:m0006" ref="dqd_5q9_pkz_BC">后</persName>，無子。<persName id="c-jinshu-031-jingxian-yanghou:p002:m0007" ref="hgm_jvn_hle">武帝</persName>受禪，居弘訓宮，號<persName id="c-jinshu-031-jingxian-yanghou:p002:m0008" ref="dqd_5q9_pkz_BC">弘訓太后</persName>。泰始九年，追贈<persName id="c-jinshu-031-jingxian-yanghou:p002:m0009" ref="6bs_o1d_9ti">蔡氏</persName><persName id="c-jinshu-031-jingxian-yanghou:p002:m0010" ref="6bs_o1d_9ti">濟陽縣君</persName>，諡曰<persName id="c-jinshu-031-jingxian-yanghou:p002:m0011" ref="6bs_o1d_9ti">穆</persName>。咸寧四年，<persName id="c-jinshu-031-jingxian-yanghou:p002:m0012" ref="dqd_5q9_pkz_BC">太后</persName>崩，時年六十五，祔葬峻平陵。</p>
</text>
