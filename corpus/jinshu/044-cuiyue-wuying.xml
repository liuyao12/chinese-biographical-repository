  <p id="c-jinshu-044-cuiyue-wuying:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-044-cuiyue-wuying:p001:m0000" ref="yd9_rqt_a0v">悅</persName>字<persName id="c-jinshu-044-cuiyue-wuying:p001:m0002" ref="yd9_rqt_a0v">道儒</persName>魏司空<persName id="c-jinshu-044-cuiyue-wuying:p001:m0007" ref="cvr_exv_dku">林</persName>曾孫<persName id="c-jinshu-044-cuiyue-wuying:p001:m0010" ref="b21_e55_8bd">劉琨</persName>妻之姪也與<persName id="c-jinshu-044-cuiyue-wuying:p001:m0017" ref="m8n_ntm_79h_ABBA">諶</persName>俱為<persName id="c-jinshu-044-cuiyue-wuying:p001:m0020" ref="b21_e55_8bd">琨</persName>司空從事中郎後為<persName id="c-jinshu-044-cuiyue-wuying:p001:m0029" ref="92h_q40_d2s">末波</persName>佐史沒石氏亦居大官</p>
