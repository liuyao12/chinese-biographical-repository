<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-112" chapter-id="c-jinshu-112-jin098-huanwen-guanzhong" source-id="s-jinshu-112-jin098-huanwen-guanzhong">
  <p id="c-jinshu-112-jin098-huanwen-guanzhong:heir" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-112-jin098-huanwen-guanzhong:heir:m0000" ref="2id_twi_nzj">健</persName>遣其子<persName id="c-jinshu-112-jin098-huanwen-guanzhong:heir:m0004" ref="2id_twi_nzj_A">萇</persName>率<persName id="c-jinshu-112-jin098-huanwen-guanzhong:heir:m0006" ref="o0k_xjc_d5b">雄</persName>、<persName id="c-jinshu-112-jin098-huanwen-guanzhong:heir:m0008" ref="0sa_2nb_upr">菁</persName>等眾五萬，距<persName id="c-jinshu-112-jin098-huanwen-guanzhong:heir:m0015" ref="u9s_w6j_8mc_AA">溫</persName>于堯柳城、愁思堆。</p>
  <p id="c-jinshu-112-jin098-huanwen-guanzhong:white-deer" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-112-jin098-huanwen-guanzhong:white-deer:m0000" ref="2id_twi_nzj">健</persName>別使<persName id="c-jinshu-112-jin098-huanwen-guanzhong:white-deer:m0003" ref="o0k_xjc_d5b">雄</persName>領騎七千，與<persName id="c-jinshu-112-jin098-huanwen-guanzhong:white-deer:m0010" ref="u9s_w6j_8mc_AE">桓沖</persName>戰于白鹿原，王師敗績，又破<persName id="c-jinshu-112-jin098-huanwen-guanzhong:white-deer:m0025" ref="8dm_11s_z5x">司馬勳</persName>于子午穀。</p>
  <p id="c-jinshu-112-jin098-huanwen-guanzhong:succession" annotation-status="reviewed" text-layer="received_chapter">初，<persName id="c-jinshu-112-jin098-huanwen-guanzhong:succession:m0002" ref="u9s_w6j_8mc_AA">桓溫</persName>之入關也，其太子<persName id="c-jinshu-112-jin098-huanwen-guanzhong:succession:m0012" ref="2id_twi_nzj_A">萇</persName>與<persName id="c-jinshu-112-jin098-huanwen-guanzhong:succession:m0014" ref="u9s_w6j_8mc_AA">溫</persName>戰，為流矢所中死。至是，立其子<persName id="c-jinshu-112-jin098-huanwen-guanzhong:succession:m0030" ref="wbk_0hg_v5e">生</persName>為太子。</p>
  <p id="c-jinshu-112-jin098-huanwen-guanzhong:sheng" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-112-jin098-huanwen-guanzhong:sheng:m0000" ref="wbk_0hg_v5e">生</persName>字<persName id="c-jinshu-112-jin098-huanwen-guanzhong:sheng:m0002" ref="wbk_0hg_v5e">長生</persName>，<persName id="c-jinshu-112-jin098-huanwen-guanzhong:sheng:m0005" ref="2id_twi_nzj">健</persName>第三子也。</p>
</text>
