<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-064" chapter-id="c-jinshu-064-wudi-sons-intro" source-id="s-jinshu-064-wudi-sons-intro-ws2622004">
  <p id="c-jinshu-064-wudi-sons-intro:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-064-wudi-sons-intro:p001:m0000" ref="hgm_jvn_hle">武帝</persName>二十六男：<persName id="c-jinshu-064-wudi-sons-intro:p001:m0007" ref="5mf_0mr_7v3">楊元后</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0011" ref="8lv_2pn_v62">毗陵悼王軌</persName>、<persName id="c-jinshu-064-wudi-sons-intro:p001:m0017" ref="7e0_f69_1ac">惠帝</persName>、<persName id="c-jinshu-064-wudi-sons-intro:p001:m0020" ref="x5m_ca9_16w">秦獻王柬</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0025" ref="ukf_quv_9j3">審美人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0029" ref="1ik_vcj_7h6">城陽懷王景</persName>、<persName id="c-jinshu-064-wudi-sons-intro:p001:m0035" ref="20b_1c2_a06">楚隱王瑋</persName>、<persName id="c-jinshu-064-wudi-sons-intro:p001:m0040" ref="4c6_984_9ed">長沙厲王乂</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0046" ref="5wx_g8v_0ux">徐才人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0050" ref="b8p_82e_1d1">城陽殤王憲</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0056" ref="srf_ta9_ta6">匱才人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0060" ref="xvn_8o9_kzw">東海沖王祗</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0066" ref="evv_ilu_817">趙才人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0070" ref="7ra_yru_xbm">始平哀王裕</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0076" ref="q2e_xlv_scw">趙美人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0080" ref="9ca_6ue_hy2">代哀王演</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0085" ref="stw_bol_ren">李夫人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0089" ref="7y2_w80_i71">淮南忠壯王允</persName>、<persName id="c-jinshu-064-wudi-sons-intro:p001:m0096" ref="k08_xhu_k3k">吳孝王晏</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0101" ref="v9w_wcb_bo5">嚴保林</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0105" ref="3ux_40i_yaa">新都懷王該</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0111" ref="8gx_ewt_47m">陳美人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0115" ref="dn2_wer_1hg">清河康王遐</persName>。諸姬生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0124" ref="4k0_mdv_f29">汝陰哀王謨</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0130" ref="6re_l9t_wfh">程才人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0134" ref="x4m_ygm_1d3">成都王穎</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0139" ref="wb0_os1_1m8">王才人</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0143" ref="83d_b6e_058">孝懷帝</persName>。<persName id="c-jinshu-064-wudi-sons-intro:p001:m0147" ref="603_131_11e_A">楊悼后</persName>生<persName id="c-jinshu-064-wudi-sons-intro:p001:m0151" ref="pqa_eel_52e">渤海殤王恢</persName>。餘八子不顯母氏，並早夭，又無封國及追諡，今並略之。其瑋、乂、穎自有傳。</p>
</text>
