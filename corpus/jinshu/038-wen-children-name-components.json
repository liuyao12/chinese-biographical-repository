    {
      "id": "name-jin038-children-jing_head",
      "person_id": "dkn_ge4_286_AAAAD",
      "surname": "司馬",
      "ming": "京",
      "additional_names": [],
      "chapter_id": "c-jinshu-038-wen-children-rendered",
      "paragraph_id": "c-jinshu-038-wen-children-rendered:p001",
      "person_mention_id": "c-jinshu-038-wen-children-rendered:p001:m0000",
      "source_anchor": {
        "paragraph_id": "c-jinshu-038-wen-children-rendered:p001",
        "start": 4,
        "end": 5,
        "surface": "京"
      },
      "quote": "清惠亭侯京，字子佐，魏末以公子賜爵。年二十四薨，追贈射聲校尉，以文帝子機字太玄為嗣。泰始元年，封燕王，邑六千六百六十三戶。機之國，咸甯初徵為步兵校尉，以漁陽郡益其國，加侍中之服。拜青州都督、鎮東將軍、假節，以北平、上谷、廣甯郡一萬三百三十七戶增燕國為二萬戶。薨，無子，齊王冏表以子幾嗣。後冏敗，國除。",
      "status": "contextual_provisional",
      "human_reviewed": false,
      "model": null,
      "surname_basis": {
        "kind": "source_bound_jin038_wen_children_name_roles",
        "role_key": "jing_head",
        "source_contract": "source-evidence/jin038-wen-children-rendered/source-contract.json",
