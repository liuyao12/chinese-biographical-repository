<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-005" chapter-id="c-jinshu-005-jin043-wangyan" source-id="s-jinshu-005-jin043-wangyan">
  <p id="c-jinshu-005-jin043-wangyan:event0" annotation-status="reviewed" text-layer="received_chapter">尚書左僕射<persName id="c-jinshu-005-jin043-wangyan:event0:m0005" ref="b0c_13f_c3a">王衍</persName>爲司空。</p>
  <p id="c-jinshu-005-jin043-wangyan:event1" annotation-status="reviewed" text-layer="received_chapter">五月甲子，<persName id="c-jinshu-005-jin043-wangyan:event1:m0005" ref="tyf_qc0_xq2">彌</persName>遂寇洛陽，司徒<persName id="c-jinshu-005-jin043-wangyan:event1:m0013" ref="b0c_13f_c3a">王衍</persName>帥衆禦之，<persName id="c-jinshu-005-jin043-wangyan:event1:m0020" ref="tyf_qc0_xq2">彌</persName>退走。</p>
  <p id="c-jinshu-005-jin043-wangyan:event2" annotation-status="reviewed" text-layer="received_chapter">丁卯，太尉<persName id="c-jinshu-005-jin043-wangyan:event2:m0005" ref="ohv_l50_sf5">劉寔</persName>請老，以司徒<persName id="c-jinshu-005-jin043-wangyan:event2:m0013" ref="b0c_13f_c3a">王衍</persName>爲太尉。</p>
  <p id="c-jinshu-005-jin043-wangyan:event3" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-005-jin043-wangyan:event3:m0000" ref="9o2_vhv_r7y">越</persName>軍次項，自領豫州牧，以太尉<persName id="c-jinshu-005-jin043-wangyan:event3:m0014" ref="b0c_13f_c3a">王衍</persName>爲軍司。</p>
  <p id="c-jinshu-005-jin043-wangyan:event4" annotation-status="reviewed" text-layer="received_chapter">太尉<persName id="c-jinshu-005-jin043-wangyan:event4:m0002" ref="b0c_13f_c3a">王衍</persName>、吏部尚書<rs id="c-jinshu-005-jin043-wangyan:event4:u0009" type="unresolved">劉望</rs>、廷尉<rs id="c-jinshu-005-jin043-wangyan:event4:u0014" type="unresolved">諸葛銓</rs>、尚書<rs id="c-jinshu-005-jin043-wangyan:event4:u0020" type="unresolved">鄭豫</rs>、<persName id="c-jinshu-005-jin043-wangyan:event4:m0023" ref="dkn_ge4_286_AAAAAB">武陵王澹</persName>等皆遇害，</p>
</text>
