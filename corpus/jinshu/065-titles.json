    {
      "id": "th-jinshu065-wang-005",
      "person_id": "7r6_k52_qji_ABAAA",
      "title": "散騎",
      "kind": "office",
      "mode": "grant",
      "status": "source_attested",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-065",
          "chapter_id": "c-jinshu-065-wangdao-family",
          "source_id": "s-jinshu-065-wangdao-family",
          "paragraph_id": "c-jinshu-065-wangdao-family:p003",
          "quote": "洽字敬和，導諸子中最知名，與荀羨俱有美稱。弱冠，歷散騎、中書郎、中軍長史、司徒左長史、建武將軍、呉郡內史。徵拜領軍，尋加中書令，固讓，表疏十上。穆帝詔曰：「敬和清裁貴令，昔爲中書郎，吾時尚小，數呼見，意甚親之。今所以用爲令，既機任須才，且欲時時相見，共講文章，待以友臣之義。而累表固讓，甚違本懷。其催洽令拜。」苦讓，遂不受。昇平二年卒於官，年三十六。二子：珣、瑉。",
          "person_mention_id": "c-jinshu-065-wangdao-family:p003:m0002"
        }
      ],
