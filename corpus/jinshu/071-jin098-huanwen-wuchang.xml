<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-071" chapter-id="c-jinshu-071-jin098-huanwen-wuchang" source-id="s-jinshu-071-jin098-huanwen-wuchang">
  <p id="c-jinshu-071-jin098-huanwen-wuchang:author" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-071-jin098-huanwen-wuchang:author:m0000" ref="dkn_ge4_286_AAAAAAAF">簡文帝</persName>輔政，引為撫軍司馬。時<persName id="c-jinshu-071-jin098-huanwen-wuchang:author:m0014" ref="u9s_w6j_8mc_AA">桓溫</persName>擅威，率眾北伐，軍次武昌，<persName id="c-jinshu-071-jin098-huanwen-wuchang:author:m0029" ref="dkn_ge4_286_AAAAAAAF">簡文</persName>患之。<persName id="c-jinshu-071-jin098-huanwen-wuchang:author:m0034" ref="745_5cb_b3e">崧</persName>曰：</p>
  <p id="c-jinshu-071-jin098-huanwen-wuchang:draft" annotation-status="reviewed" text-layer="received_chapter">便於坐為<persName id="c-jinshu-071-jin098-huanwen-wuchang:draft:m0004" ref="dkn_ge4_286_AAAAAAAF">簡文</persName>書草曰：「寇難宜平，時會宜接，此實為國遠圖，經略大算。能弘斯會，非足下而誰！</p>
  <p id="c-jinshu-071-jin098-huanwen-wuchang:letter" annotation-status="reviewed" text-layer="received_chapter">皆由吾暗弱，德信不著，不能鎮靜群庶，保固維城，所以內愧於心，外慚良友。吾與足下雖職有內外，安社稷，保家國，其致一也。</p>
</text>
