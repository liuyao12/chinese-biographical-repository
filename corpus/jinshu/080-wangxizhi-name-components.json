    {
      "id": "nc-jin080-wangxizhi-zhenzhi",
      "person_id": "7r6_k52_qji_ABDCBCA",
      "surname": "王",
      "ming": "楨之",
      "additional_names": [],
      "chapter_id": "c-jinshu-080-wangxizhi",
      "paragraph_id": "c-jinshu-080-wangxizhi:p040",
      "person_mention_id": "c-jinshu-080-wangxizhi:p040:m0000",
      "quote": "楨之字公幹，歷位侍中、大司馬長史。桓玄為太尉，朝臣畢集，問楨之：「我何如君亡叔？」在坐咸為氣咽。楨之曰：「亡叔一時之標，公是千載之英。」一坐皆悅。",
      "status": "contextual_provisional",
