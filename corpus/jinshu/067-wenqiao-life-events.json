      "event_type": "death",
      "source_term": "卒于官",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-067",
          "chapter_id": "c-jinshu-067-wenqiao",
          "source_id": "s-jinshu-067-wenqiao",
          "paragraph_id": "c-jinshu-067-wenqiao:line064",
          "quote": "放之嗣爵，少歷清官，累至給事黃門侍郎。以貧，求為交州，朝廷許之。王述與會稽王牋曰：「放之溫嶠之子，宜見優異，而投之嶺外，竊用愕然。願遠存周禮，近參人情，則望實惟允。」時竟不納。放之既至南海，甚有威惠。將征林邑，交阯太守杜寶、別駕阮朗並不從，放之以其沮眾，誅之，勒兵而進，遂破林邑而還。卒于官。",
          "person_mention_id": "c-jinshu-067-wenqiao:line064:m0000"
        }
      ],
      "interpretation_note": "依本來源登記。",
