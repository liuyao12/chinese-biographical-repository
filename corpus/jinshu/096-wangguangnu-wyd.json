        "column_projection": [
          {
            "pdf_page": 54,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "王廣女者不知何許人也容質甚美慷慨有丈夫之節"
          },
          {
            "pdf_page": 54,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "廣仕劉聰為西揚州刺史蠻帥梅芳攻陷揚州而廣被"
          },
          {
            "pdf_page": 55,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "殺王時年十五芳納之俄於闇室擊芳不中芳驚起曰"
          },
          {
            "pdf_page": 55,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "何故反邪王罵曰蠻畜我欲誅反賊可謂反乎吾聞父"
          },
          {
            "pdf_page": 55,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "仇不同天母仇不同地汝反逆無狀害人父母而復以"
          },
          {
            "pdf_page": 55,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "無禮陵人吾所以不死者欲誅汝耳今死自吾分不待"
          },
          {
            "pdf_page": 55,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "汝殺但恨不得梟汝首於通達以塞大恥辭氣猛厲言"
          },
          {
            "pdf_page": 55,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 6,
            "start": 0,
            "end": 9,
            "text": "終乃自殺芳止之不可"
          }
        ]
      }
    }
