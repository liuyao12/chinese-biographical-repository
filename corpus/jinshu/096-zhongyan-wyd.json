      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:e3f85ab24772f58e5e2db1a9e8c9c8085493fe8ae46082be1771111997bc5320",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 45,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 2,
            "start": 16,
            "end": 21,
            "text": "渾嘗共琰坐"
          },
          {
            "pdf_page": 45,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "濟趨庭而過渾欣然曰生子如此足慰人心琰笑曰若"
          },
          {
            "pdf_page": 45,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "使新婦得配參軍生子故不翅如此參軍謂渾中弟淪"
          },
          {
            "pdf_page": 45,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "也琰女亦有才淑為求賢夫時有兵家子甚俊濟欲妻"
          },
          {
            "pdf_page": 45,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "之白琰琰曰要令我見之濟令此兵與羣小雜處琰自"
          },
          {
            "pdf_page": 45,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "幃中察之既而謂濟曰緋衣者非汝所拔乎濟曰是琰"
          },
          {
            "pdf_page": 45,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "曰此人才足拔萃然地寒壽促不足展其器用不可與"
          },
          {
            "pdf_page": 45,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 9,
            "start": 0,
            "end": 18,
            "text": "婚遂止其人數年果亡琰明鑒遠識皆此類也"
          }
        ]
      }
    },
    {
