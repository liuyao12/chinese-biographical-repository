    {
      "id": "le-jin034-yanghu-hu-death",
      "person_id": "dqd_5q9_pkz_BD",
      "status": "source_attested",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-034",
