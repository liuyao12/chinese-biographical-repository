<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-032" chapter-id="c-jinshu-032-jin098-huanwen-succession" source-id="s-jinshu-032-jin098-huanwen-succession">
  <p id="c-jinshu-032-jin098-huanwen-succession:name" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-032-jin098-huanwen-succession:name:m0000" ref="xke_dj3_6ba_AAB">康獻褚皇后</persName>諱<persName id="c-jinshu-032-jin098-huanwen-succession:name:m0006" ref="xke_dj3_6ba_AAB">蒜子</persName>，河南陽翟人也。</p>
  <p id="c-jinshu-032-jin098-huanwen-succession:time" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-032-jin098-huanwen-succession:time:m0000" ref="dkn_ge4_286_AAAAAAAF">簡文帝</persName>即位，尊后為<persName id="c-jinshu-032-jin098-huanwen-succession:time:m0009" ref="xke_dj3_6ba_AAB">崇德太后</persName>。及<persName id="c-jinshu-032-jin098-huanwen-succession:time:m0015" ref="dkn_ge4_286_AAAAAAAF">帝</persName>崩，<persName id="c-jinshu-032-jin098-huanwen-succession:time:m0018" ref="uke_dff_yrf">孝武帝</persName>幼沖，<persName id="c-jinshu-032-jin098-huanwen-succession:time:m0024" ref="u9s_w6j_8mc_AA">桓溫</persName>又薨。</p>
</text>
