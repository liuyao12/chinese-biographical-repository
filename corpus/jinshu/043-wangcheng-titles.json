    {
      "id": "th-w043-cheng-120-3",
      "person_id": "rlk_lzd_86c",
      "title": "荊州刺史",
      "kind": "office",
      "mode": "attestation",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-043",
