<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-039" chapter-id="c-jinshu-039-wangxun-feng" source-id="s-jinshu-039-wangxun-feng">
  <p id="c-jinshu-039-wangxun-feng:yi-intro:p001" annotation-status="in_progress" text-layer="received_chapter"><persName id="c-jinshu-039-wangxun-feng:yi-intro:p001:m0000" ref="yoo_ox0_545_BAA">荀顗</persName>，字<persName id="c-jinshu-039-wangxun-feng:yi-intro:p001:m0004" ref="yoo_ox0_545_BAA">景倩</persName>，潁川人，魏太尉<persName id="c-jinshu-039-wangxun-feng:yi-intro:p001:m0014" ref="yoo_ox0_545_BA">彧</persName>之第六子也。</p>
  <p id="c-jinshu-039-wangxun-feng:xu-intro:p001" annotation-status="in_progress" text-layer="received_chapter"><persName id="c-jinshu-039-wangxun-feng:xu-intro:p001:m0000" ref="yoo_ox0_545_FAAA">荀勖</persName>，字<persName id="c-jinshu-039-wangxun-feng:xu-intro:p001:m0004" ref="yoo_ox0_545_FAAA">公曾</persName>，潁川潁陰人，漢司空<persName id="c-jinshu-039-wangxun-feng:xu-intro:p001:m0016" ref="yoo_ox0_545_F">爽</persName>曾孫也。祖<persName id="c-jinshu-039-wangxun-feng:xu-intro:p001:m0022" ref="yoo_ox0_545_FA">棐</persName>，射聲校尉。父<persName id="c-jinshu-039-wangxun-feng:xu-intro:p001:m0030" ref="yoo_ox0_545_FAA">肸</persName>，早亡。</p>
  <p id="c-jinshu-039-wangxun-feng:xu-sons:p001" annotation-status="in_progress" text-layer="received_chapter"><persName id="c-jinshu-039-wangxun-feng:xu-sons:p001:m0000" ref="yoo_ox0_545_FAAA">勖</persName>有十子，其達者<persName id="c-jinshu-039-wangxun-feng:xu-sons:p001:m0008" ref="yoo_ox0_545_FAAAB">輯</persName>、<persName id="c-jinshu-039-wangxun-feng:xu-sons:p001:m0010" ref="yoo_ox0_545_FAAAA">藩</persName>、<persName id="c-jinshu-039-wangxun-feng:xu-sons:p001:m0012" ref="yoo_ox0_545_FAAAC">組</persName>。</p>
</text>
