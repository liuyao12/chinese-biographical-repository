    {
      "id": "th-w044-zhengm-17",
      "person_id": "67b_2b2_4b8",
      "title": "尚書令",
      "kind": "office",
      "mode": "attestation",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-044",
          "chapter_id": "c-jinshu-044-zhengmo",
          "source_id": "s-jinshu-044-zhengmo",
          "paragraph_id": "c-jinshu-044-zhengmo:line030",
          "quote": "太康元年卒，時年六十八，諡曰成。尚書令衛瓘奏：「默才行名望，宜居論道，五升九卿，位未稱德，宜贈三司。」而後父楊駿先欲以女妻默子豫，默曰：「吾每讀《雋不疑傳》，常想其人。畏遠權貴，奕世所守。」遂辭之。駿深為恨。至此，駿議不同，遂不施行。默寬沖博愛，謙虛溫謹，不以才地矜物，事上以禮，遇下以和，雖僮豎廝養不加聲色，而猶有嫌怨，故士君子以為居世之難。子球。",
          "person_mention_id": "c-jinshu-044-zhengmo:line030:m0019"
        }
      ],
