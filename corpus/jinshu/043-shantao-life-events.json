    {
      "id": "le-jin043-shantao-life_004",
      "person_id": "0uv_x8k_mfc_A",
      "event_type": "death",
      "source_term": "薨",
      "source_anchor": {
        "paragraph_id": "c-jinshu-043-shantao:p013",
