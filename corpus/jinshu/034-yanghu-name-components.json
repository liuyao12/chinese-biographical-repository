    {
      "id": "nc-jin034-yanghu-cheng",
      "person_id": "dqd_5q9_pkz_BB",
      "surname": null,
      "ming": "承",
      "additional_names": [],
      "chapter_id": "c-jinshu-034-yanghu",
      "paragraph_id": "c-jinshu-034-yanghu:p040",
      "person_mention_id": "c-jinshu-034-yanghu:p040:m0029",
      "quote": "祜前母，孔融女，生兄發，官至都督淮北護軍。初，發與祜同母兄承俱得病，祜母度不能兩存，乃專心養發，故得濟，而承竟死。",
      "status": "source_attested",
      "human_reviewed": false,
      "model": null,
      "fixed_biography_name_binding": {
