      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-044",
          "chapter_id": "c-jinshu-044-luchen-cuiyue",
          "source_id": "s-jinshu-044-ws1775345-luchen-cuiyue",
          "paragraph_id": "c-jinshu-044-luchen-cuiyue:p002",
          "quote": "建興末，隨琨投段匹磾。匹磾自領幽州，取諶為別駕。匹磾既害琨，尋亦敗喪。時南路阻絕，段末波在遼西，諶往投之。元帝之初，末波通使于江左，諶因其使抗表理琨，文旨甚切，於是即加弔祭。累徵諶為散騎中書侍郎，而為末波所留，遂不得南渡。末波死，弟遼代立，諶流離世故且二十載。石季龍破遼西，復為季龍所得，以為中書侍郎、國子祭酒、侍中、中書監。屬冉閔誅石氏，諶隨閔軍，于襄國遇害，時年六十七，是歲永和六年也。",
          "person_mention_id": "c-jinshu-044-luchen-cuiyue:p002:m0170"
        }
      ],
      "interpretation_note": "襄國為本源遇害地；四地望式用稱不升出生地或現居；無現代定位。",
      "status": "source_attested",
      "reviewer": "Codex（AI代理）",
      "human_reviewed": false,
      "model": null
    },
