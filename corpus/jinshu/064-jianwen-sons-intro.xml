  <p id="c-jinshu-064-jianwen-sons-intro:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-064-jianwen-sons-intro:p001:m0000" ref="dkn_ge4_286_AAAAAAAF">簡文帝</persName>七子：<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0006" ref="xyg_gy3_92q">王皇后</persName>生<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0010" ref="k9q_h4e_j2q">會稽思世子道生</persName>、<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0018" ref="jum_3gp_v5x">皇子俞生</persName>。<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0023" ref="m1p_h4f_a48">胡淑儀</persName>生<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0027" ref="70z_zog_t15">臨川獻王郁</persName>、<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0033" ref="p25_kbf_wc4">皇子朱生</persName>。<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0038" ref="pis_fl7_hce">王淑儀</persName>生<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0042" ref="7n4_86s_vc0">皇子天流</persName>。<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0047" ref="4bj_vno_7w6">李夫人</persName>生<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0051" ref="uke_dff_yrf">孝武帝</persName>、<persName id="c-jinshu-064-jianwen-sons-intro:p001:m0055" ref="dkn_ge4_286_AAAAAAAFA">會稽文孝王道子</persName>。俞生、朱生、天流並早夭，今並略之。</p>
</text>
