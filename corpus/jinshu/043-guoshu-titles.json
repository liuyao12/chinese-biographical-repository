    {
      "id": "th-jin043-guoshu-career-06",
      "person_id": "7mp_r23_bds",
      "status": "source_attested",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-043",
          "source_id": "s-jinshu-043-ws2618531-guoshu",
          "chapter_id": "c-jinshu-043-guoshu",
          "paragraph_id": "c-jinshu-043-guoshu:p002",
          "quote": "王澄聞其名，引為別駕。澄終日酣飲，不以眾務在意，舒常切諫之。及天下大亂，又勸澄修德養威，保完州境。澄以為亂自京都起，非復一州所能匡禦，雖不能從，然重其忠亮。荊土士人宗庾廞嘗因酒忤澄，澄怒，叱左右棒廞。舒厲色謂左右曰：「使君過醉，汝輩何敢妄動！」澄恚曰：「別駕狂邪，誑言我醉！」因遣掐其鼻，灸其眉頭，舒跪而受之。澄意少釋，而廞遂得免。",
          "person_mention_id": "c-jinshu-043-guoshu:p002:m0003"
        }
      ],
      "reviewer": "Codex（AI代理）",
      "human_reviewed": false,
      "model": null,
      "interpretation_note": "王澄引郭舒為別駕。",
