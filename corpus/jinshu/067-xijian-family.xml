<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-067" chapter-id="c-jinshu-067-xijian-family" source-id="s-jinshu-067-ws2592755-xijian-excerpts">
  <p id="c-jinshu-067-xijian-family:p001" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p001:m0000" ref="6lr_zci_i0j">郗鑒</persName>，字道徽，高平金鄉人，漢御史大夫<persName id="c-jinshu-067-xijian-family:p001:m0001" ref="66f_b00_777">慮</persName>之玄孫也。祖<persName id="c-jinshu-067-xijian-family:p001:m0002" ref="66f_b00_777_*A">紹</persName>，魏尚書。父<persName id="c-jinshu-067-xijian-family:p001:m0003" ref="66f_b00_777_*AA">璿</persName>，州別駕。</p>
  <p id="c-jinshu-067-xijian-family:p002" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p002:m0000" ref="6lr_zci_i0j">鑒</persName>……二子：<persName id="c-jinshu-067-xijian-family:p002:m0001" ref="ier_lqj_x4q">愔</persName>、<persName id="c-jinshu-067-xijian-family:p002:m0002" ref="e5k_f2i_cog">曇</persName>。</p>
  <p id="c-jinshu-067-xijian-family:p003" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p003:m0000" ref="ier_lqj_x4q">愔</persName>字方回。……會弟<persName id="c-jinshu-067-xijian-family:p003:m0001" ref="e5k_f2i_cog">曇</persName>卒。</p>
  <p id="c-jinshu-067-xijian-family:p004" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p004:m0000" ref="ier_lqj_x4q">愔</persName>……三子。<persName id="c-jinshu-067-xijian-family:p004:m0001" ref="57b_1cb_a1b">超</persName>、<persName id="c-jinshu-067-xijian-family:p004:m0002" ref="66f_b00_777_*AAAAB">融</persName>、<persName id="c-jinshu-067-xijian-family:p004:m0003" ref="66f_b00_777_*AAAAC">沖</persName>。超最知名。</p>
  <p id="c-jinshu-067-xijian-family:p005" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p005:m0000" ref="57b_1cb_a1b">超</persName>無子，從弟<persName id="c-jinshu-067-xijian-family:p005:m0001" ref="am6_k2t_j0x">儉之</persName>以子<persName id="c-jinshu-067-xijian-family:p005:m0002" ref="be3_978_f9f">僧施</persName>嗣。</p>
  <p id="c-jinshu-067-xijian-family:p006" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p006:m0000" ref="e5k_f2i_cog">曇</persName>字重熙。……子<persName id="c-jinshu-067-xijian-family:p006:m0001" ref="ebb_5a7_96e">恢</persName>嗣。</p>
  <p id="c-jinshu-067-xijian-family:p007" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p007:m0000" ref="ebb_5a7_96e">恢</persName>字道胤。……子<persName id="c-jinshu-067-xijian-family:p007:m0001" ref="66f_b00_777_*AAABAA">循</persName>嗣。</p>
  <p id="c-jinshu-067-xijian-family:p008" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p008:m0000" ref="jlw_330_62b">隆</persName>以兄子<persName id="c-jinshu-067-xijian-family:p008:m0001" ref="6lr_zci_i0j">鑒</persName>為趙王掾，諸子悉在京洛。</p>
  <p id="c-jinshu-067-xijian-family:p009" annotation-status="named_mentions_first_pass" text-layer="received_chapter"><persName id="c-jinshu-067-xijian-family:p009:m0000" ref="6v8_pk9_7k5">溫嶠</persName><persName id="c-jinshu-067-xijian-family:p009:m0001" ref="6lr_zci_i0j">郗鑒</persName>〈（子<persName id="c-jinshu-067-xijian-family:p009:m0002" ref="ier_lqj_x4q">愔</persName> 愔子<persName id="c-jinshu-067-xijian-family:p009:m0003" ref="57b_1cb_a1b">超</persName> 愔弟<persName id="c-jinshu-067-xijian-family:p009:m0004" ref="e5k_f2i_cog">曇</persName> 叔父<persName id="c-jinshu-067-xijian-family:p009:m0005" ref="jlw_330_62b">隆</persName>）〉</p>
</text>
