      "source_term": "遂死之，時年四十八",
      "source_anchor": {
        "paragraph_id": "c-jinshu-070-bianhu:p012",
        "start": 144,
        "end": 153,
        "surface": "遂死之，時年四十八"
      },
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-070",
          "chapter_id": "c-jinshu-070-bianhu",
          "source_id": "s-jinshu-070-bianhu-ws2595540",
          "paragraph_id": "c-jinshu-070-bianhu:p012",
          "quote": "峻至東陵口，詔以壼都督大桁東諸軍事、假節，復加領軍將軍、給事中。壼率郭默、趙胤等與峻大戰於西陵，爲峻所破。壼與鍾雅皆退還，死傷者以千數。壼、雅並還節，詣闕謝罪。峻進攻青溪，壼與諸軍距擊，不能禁。賊放火燒宮寺，六軍敗績。壼時發背創，猶未合，力疾而戰，率厲散眾及左右吏數百人，攻賊麾下，苦戰，遂死之，時年四十八。二子眕、盱見父沒，相隨赴賊，同時見害。",
          "person_mention_id": "c-jinshu-070-bianhu:p012:m0109"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "按同段人物與次第核所屬卒事。",
