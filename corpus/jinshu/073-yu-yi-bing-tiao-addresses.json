      "status": "source_attested",
      "date_expression": null,
      "source_term": "希聞難，便與弟邈及子攸之逃於海陵陂澤中",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-073",
