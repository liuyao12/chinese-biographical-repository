    {
      "id": "le-jinshu033-wang-rong-death",
      "person_id": "7r6_k52_qji_A",
      "event_type": "death",
      "status": "source_attested",
      "date_expression": null,
      "source_term": "祥喪父之後",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-033",
          "source_id": "s-jinshu-033-wanglan-family",
          "chapter_id": "c-jinshu-033-wanglan-family",
          "paragraph_id": "c-jinshu-033-wanglan-family:p004",
          "quote": "覽字玄通。母朱，遇祥無道。覽年數歲，見祥被楚撻，輒涕泣抱持。至於成童，每諫其母，其母少止凶虐。朱屢以非理使祥，覽輒與祥俱。又虐使祥妻，覽妻亦趨而共之。朱患之，乃止。祥喪父之後，漸有時譽。朱深疾之，密使鴆祥。覽知之，徑起取酒。祥疑其有毒，爭而不與，朱遽奪反之。自後朱賜祥饌，覽輒先嘗。朱懼覽致斃，遂止。",
          "person_reference_id": "c-jinshu-033-wanglan-family:p004:m0084",
          "relative_assertion_id": "a-jinshu033-wang-001",
          "relative_subject_mention_id": "c-jinshu-033-wanglan-family:p004:m0009"
        }
      ],
      "interpretation_note": "原文喪父或母終記死亡；父承王祥父融，母承前述繼母朱氏。未記年份不補，附傳回顧幼年不按段落順序強排日期。",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false,
      "model": null
