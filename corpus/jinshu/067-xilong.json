          "kind": "person",
          "person_id": "jlw_330_62b",
          "status": "contextual_provisional",
          "interpretation_note": "以來源原字標記。"
        },
        {
          "id": "c-jinshu-067-xilong:line126:m0002",
          "start": 2,
          "end": 4,
          "surface": "弘始",
          "kind": "person",
          "person_id": "jlw_330_62b",
          "status": "contextual_provisional",
          "interpretation_note": "以來源原字標記。"
        }
      ],
      "source_position": {
