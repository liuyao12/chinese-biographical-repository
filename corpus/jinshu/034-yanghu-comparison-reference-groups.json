        "biological_mother_status": "not_stated",
        "surname_restoration": "孔融女；本名未知"
      },
      "rationale": "僅保本源角色語詞及資訊邊界，非新增生母/父子/前世同一人物斷言。",
      "evidence": [
        {
          "work_id": "w-jinshu",
          "book_id": "b-jinshu-034",
          "source_id": "s-jinshu-034-yanghu-ws2567662-rendered-comparison",
          "chapter_id": "c-jinshu-034-yanghu-comparison",
          "paragraph_id": "c-jinshu-034-yanghu-comparison:p040",
          "quote": "祜前母，孔融女，生兄發，官至都督淮北護軍。初，發與祜同母兄承俱得病，祜母度不能兩存，乃專心養發，故得濟，而承竟死。",
          "mention_ids": [
            "c-jinshu-034-yanghu-comparison:p040:m0001"
          ]
        }
      ],
      "human_reviewed": false
    },
    {
      "id": "reading-jin034-deceased_li_child",
      "interpretation_kind": "source_role_qualification",
      "subject_person_id": "m1v_bdg_km8",
