<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-jinshu" book-id="b-jinshu-121" chapter-id="c-jinshu-121-jin098-huanwen-shu" source-id="s-jinshu-121-jin098-huanwen-shu">
  <p id="c-jinshu-121-jin098-huanwen-shu:advise" annotation-status="reviewed" text-layer="received_chapter">其中書監<persName id="c-jinshu-121-jin098-huanwen-shu:advise:m0004" ref="ma7_g13_qdd">王嘏</persName>、散騎常侍<persName id="c-jinshu-121-jin098-huanwen-shu:advise:m0011" ref="qcg_to7_3aq">常璩</persName>等勸<persName id="c-jinshu-121-jin098-huanwen-shu:advise:m0015" ref="agn_6ch_sus">勢</persName>降。<persName id="c-jinshu-121-jin098-huanwen-shu:advise:m0018" ref="agn_6ch_sus">勢</persName>以問侍中<persName id="c-jinshu-121-jin098-huanwen-shu:advise:m0023" ref="0ar_lzt_v9w">馮孚</persName>，<persName id="c-jinshu-121-jin098-huanwen-shu:advise:m0026" ref="0ar_lzt_v9w">孚</persName>言：</p>
  <p id="c-jinshu-121-jin098-huanwen-shu:signed" annotation-status="reviewed" text-layer="received_chapter">三月十七日，略陽<persName id="c-jinshu-121-jin098-huanwen-shu:signed:m0008" ref="agn_6ch_sus">李勢</persName>叩頭死罪。</p>
  <p id="c-jinshu-121-jin098-huanwen-shu:envoy" annotation-status="reviewed" text-layer="received_chapter">即日到白水城，謹遣私署散騎常侍<persName id="c-jinshu-121-jin098-huanwen-shu:envoy:m0015" ref="q2b_bkn_3a5">王幼</persName>奉箋以聞，並敕州郡投戈釋杖。</p>
  <p id="c-jinshu-121-jin098-huanwen-shu:family" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-jinshu-121-jin098-huanwen-shu:family:m0000" ref="agn_6ch_sus">勢</persName>尋輿櫬面縛軍門，<persName id="c-jinshu-121-jin098-huanwen-shu:family:m0009" ref="u9s_w6j_8mc_AA">溫</persName>解其縛，焚其櫬，遷<persName id="c-jinshu-121-jin098-huanwen-shu:family:m0019" ref="agn_6ch_sus">勢</persName>及弟<persName id="c-jinshu-121-jin098-huanwen-shu:family:m0022" ref="4ys_87g_ilk">福</persName>、從兄<persName id="c-jinshu-121-jin098-huanwen-shu:family:m0026" ref="l2p_ktv_dyf">權</persName>親族十餘人于健康，封<persName id="c-jinshu-121-jin098-huanwen-shu:family:m0037" ref="agn_6ch_sus">勢</persName>歸義侯。</p>
</text>
