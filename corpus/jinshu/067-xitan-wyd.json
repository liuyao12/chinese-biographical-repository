        "column_projection": [
          {
            "pdf_page": 65,
            "half": "右",
            "leaf": "二十二下",
            "column_from_right": 8,
            "text": "曇字重熙少賜爵東安縣開國伯司徒王導辟祕書郎",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 65,
            "half": "右",
            "leaf": "二十二下",
            "column_from_right": 9,
            "text": "朝論以曇名臣之子每逼以憲制年三十始拜通直散",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 65,
            "half": "右",
            "leaf": "二十二下",
            "column_from_right": 10,
            "text": "騎侍郎遷中書侍郎簡文帝為撫軍引為司馬尋除尚",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 65,
            "half": "左",
            "leaf": "二十三上",
            "column_from_right": 1,
            "text": "書吏部郎拜御史中丞時北中郎荀羨有疾朝廷以曇",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 65,
            "half": "左",
            "leaf": "二十三上",
            "column_from_right": 2,
            "text": "為羨軍司加散騎常侍頃之羨徵還仍除北中郎將都",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 65,
            "half": "左",
            "leaf": "二十三上",
            "column_from_right": 3,
            "text": "督徐兗青幽揚州之晉陵諸軍事領徐兗二州刺史假",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 65,
            "half": "左",
            "leaf": "二十三上",
            "column_from_right": 4,
            "text": "節鎮下邳後與賊帥傅末波等戰失利降號建威將軍",
            "start": 0,
            "end": 21
          },
          {
            "pdf_page": 65,
            "half": "左",
            "leaf": "二十三上",
            "column_from_right": 5,
            "text": "尋卒年四十二追贈北中郎諡曰簡子恢嗣",
            "start": 0,
            "end": 17
          }
        ]
      }
    }
  ],
