      "evidence": [
        {
          "chapter_id": "c-shiji-036-chenqi",
          "source_id": "s-shiji-036-chenqi",
          "paragraph_id": "c-shiji-036-chenqi:p025",
          "quote": "湣公六年，孔子適陳。吳王夫差伐陳，取三邑而去。十三年，吳復來伐陳，陳告急楚，楚昭王來救，軍於城父，吳師去。是年，楚昭王卒於城父。時孔子在陳。十五年，宋滅曹。十六年，吳王夫差伐齊，敗之艾陵，使人召陳侯。陳侯恐，如吳。楚伐陳。二十一年，齊田常弒其君簡公。二十三年，楚之白公勝殺令尹子西、子綦，襲惠王。葉公攻敗白公，白公自殺。",
          "person_mention_id": "c-shiji-036-chenqi:m025-0038"
        }
      ],
      "source_term": "楚昭王卒於城父",
      "interpretation_note": "陳湣十三年語境卒地，未補現代位置。",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false
