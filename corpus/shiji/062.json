    {
      "id": "c-shiji-062-guanyan:p010",
      "text": "太史公曰：吾讀管子牧民、山高、乘馬、輕重、九府，及晏子春秋，詳哉其言之也。既見其著書，欲觀其行事，故次其傳。至其書，世多有之，是以不論，論其軼事。",
      "annotation_status": "named_mentions_first_pass",
      "text_layer": "received_chapter",
      "mentions": [
        {
          "id": "c-shiji-062-guanyan:m010-0000",
