      "date_expression": null,
      "evidence": [
        {
          "chapter_id": "c-shiji-003-yin",
          "source_id": "s-shiji-003-yin",
          "paragraph_id": "c-shiji-003-yin:p001",
          "quote": "殷契，母曰簡狄，有娀氏之女，為帝嚳次妃。三人行浴，見玄鳥墮其卵，簡狄取吞之，因孕生契。契長而佐禹治水有功。帝舜乃命契曰：「百姓不親，五品不訓，汝為司徒而敬敷五教，五教在寬。」封于商，賜姓子氏。契興於唐、虞、大禹之際，功業著於百姓，百姓以平。",
          "person_mention_id": "c-shiji-003-yin:m001-0041"
        }
      ],
      "source_term": "因孕生契",
      "interpretation_note": "保存明言出生或卒的來源敘述；玄鳥故事及商先祖譜系不作獨立史實確證，不補生父或公元年。",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false
    },
