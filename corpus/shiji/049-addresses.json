    },
    {
      "id": "pa-shiji049-013",
      "person_id": "ixk_6fg_v6f_A",
      "relation": "biographical_origin",
      "place": {
        "source_name": "趙之清河觀津",
        "place_id": null,
        "modern_identification": null
      },
      "status": "source_attested",
      "date_expression": null,
      "evidence": [
        {
          "chapter_id": "c-shiji-049-waiqi",
          "source_id": "s-shiji-049-waiqi",
          "paragraph_id": "c-shiji-049-waiqi:p012",
          "quote": "竇太后，趙之清河觀津人也。呂太后時，竇姬以良家子入宮侍太后。太后出宮人以賜諸王，各五人，竇姬與在行中。竇姬家在清河，欲如趙近家，請其主遣宦者吏：「必置我籍趙之伍中。」宦者忘之，誤置其籍代伍中。籍奏，詔可，當行。竇姬涕泣，怨其宦者，不欲往，相彊，乃肯行。至代，代王獨幸竇姬，生女嫖，後生兩男。而代王王后生四男。先代王未入立為帝而王后卒。及代王立為帝，而王后所生四男更病死。孝文帝立數月，公卿請立太子，而竇姬長男最長，立為太子。立竇姬為皇后，女嫖為長公主。其明年，立少子武為代王，已而又徙梁，是為梁孝王。",
          "person_mention_id": "c-shiji-049-waiqi:m012-0000"
        }
      ],
      "source_term": "趙之清河觀津人也",
      "interpretation_note": "來源出處、實行行程、居處、死地與葬地分存；不補現代定位，地名承接限本段明示敘事。",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false
    },
