      },
      "status": "source_attested",
      "date_expression": null,
      "evidence": [
        {
          "chapter_id": "c-shiji-038-song",
          "source_id": "s-shiji-038-song",
          "paragraph_id": "c-shiji-038-song:p034",
          "quote": "十年夏，宋伐魯，戰於乘丘，魯生虜宋南宮萬。宋人請萬，萬歸宋。十一年秋，湣公與南宮萬獵，因博爭行，湣公怒，辱之，曰：「始吾敬若；今若，魯虜也。」萬有力，病此言，遂以局殺湣公于蒙澤。大夫仇牧聞之，以兵造公門。萬搏牧，牧齒著門闔死。因殺太宰華督，乃更立公子游爲君。諸公子奔蕭，公子御說奔亳。萬弟南宮牛將兵圍亳。冬，蕭及宋之諸公子共擊殺南宮牛，弒宋新君游而立湣公弟御說，是爲桓公。宋萬奔陳。宋人請以賂陳。陳人使婦人飲之醇酒，以革裹之，歸宋。宋人醢萬也。",
          "person_mention_id": "c-shiji-038-song:m034-0035"
        }
      ],
      "source_term": "殺湣公于蒙澤",
      "interpretation_note": "明示卒地，不補現代定位。",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false
    },
