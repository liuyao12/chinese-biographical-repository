    {
      "id": "le-shiji059-012",
      "person_id": "yqp_nlb_p1p_ACAG",
      "event_type": "death",
      "status": "source_attested",
      "date_expression": "三十二年",
      "source_term": "立三十二年卒",
      "evidence": [
