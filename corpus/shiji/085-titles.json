    {
      "id": "th-shiji085-005",
      "person_id": "cbr-p004798",
      "title": "夫人",
      "kind": "royal_rank",
      "mode": "grant",
      "status": "source_attested",
      "evidence": [
        {
          "chapter_id": "c-shiji-085-lubuwei",
