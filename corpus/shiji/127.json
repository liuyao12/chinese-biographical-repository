  "paragraphs": [
    {
      "id": "c-shiji-127-rizhe:p001",
      "text": "自古受命而王，王者之興何嘗不以卜筮決於天命哉！其於周尤甚，及秦可見。代王之入，任於卜者。太卜之起，由漢興而有。",
      "annotation_status": "in_progress",
      "text_layer": "received_chapter",
      "mentions": [
        {
          "id": "c-shiji-127-rizhe:m001-0034",
          "start": 34,
          "end": 36,
          "surface": "代王",
          "kind": "person",
          "person_id": "ubd_p3l_sji",
          "status": "contextual_provisional"
        }
      ]
    },
    {
      "id": "c-shiji-127-rizhe:p002",
      "text": "司馬季主者，楚人也。卜於長安東市。",
      "annotation_status": "in_progress",
      "text_layer": "received_chapter",
      "mentions": [
        {
          "id": "c-shiji-127-rizhe:m002-0000",
          "start": 0,
