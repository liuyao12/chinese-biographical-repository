    {
      "id": "le-shiji063-003",
      "person_id": "n2o_l90_fnm",
      "event_type": "death",
      "status": "source_attested",
      "date_expression": null,
      "source_term": "非已死矣",
      "evidence": [
        {
          "chapter_id": "c-shiji-063-laohan",
          "source_id": "s-shiji-063-laohan",
          "paragraph_id": "c-shiji-063-laohan:p024",
          "quote": "人或傳其書至秦。秦王見《孤憤》、《五蠹》之書，曰：「嗟乎，寡人得見此人與之游，死不恨矣！」李斯曰：「此韓非之所著書也。」秦因急攻韓。韓王始不用非，及急，乃遣非使秦。秦王悅之，未信用。李斯、姚賈害之，毀之曰：「韓非，韓之諸公子也。今王欲并諸侯，非終為韓不為秦，此人之情也。今王不用，久留而歸之，此自遺患也，不如以過法誅之。」秦王以為然，下吏治非。李斯使人遺非藥，使自殺。韓非欲自陳，不得見。秦王後悔之，使人赦之，非已死矣。",
          "person_mention_id": "c-shiji-063-laohan:m024-0051"
        },
        {
          "chapter_id": "c-shiji-063-laohan",
          "source_id": "s-shiji-063-laohan",
          "paragraph_id": "c-shiji-063-laohan:p014",
          "quote": "然韓非知說之難，為《說難》書甚具，終死於秦，不能自脫。",
          "person_mention_id": "c-shiji-063-laohan:m014-0001"
        }
      ],
