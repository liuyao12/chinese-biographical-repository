      "status": "source_attested",
      "evidence": [
        {
          "chapter_id": "c-shiji-047-kong",
          "source_id": "s-shiji-047-kong",
          "paragraph_id": "c-shiji-047-kong:p005",
          "quote": "孔子貧且賤。及長，嘗為季氏史，料量平；嘗為司職吏而畜蕃息。由是為司空。已而去魯，斥乎齊，逐乎宋、衞，困於陳蔡之間，於是反魯。孔子長九尺有六寸，人皆謂之「長人」而異之。魯復善待，由是反魯。"
        }
      ],
