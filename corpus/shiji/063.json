    {
      "id": "c-shiji-063-laohan:p014",
      "text": "然韓非知說之難，為《說難》書甚具，終死於秦，不能自脫。",
      "annotation_status": "named_mentions_first_pass",
      "text_layer": "received_chapter",
      "mentions": [
        {
          "id": "c-shiji-063-laohan:m014-0001",
          "start": 1,
          "end": 3,
          "surface": "韓非",
