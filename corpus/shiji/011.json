          "status": "contextual_provisional"
        },
        {
          "id": "c-shiji-011-jingdi:m010-0043",
          "start": 43,
          "end": 45,
          "surface": "子寄",
          "kind": "person",
          "person_id": "cbr-p000954",
          "status": "contextual_provisional"
        }
      ]
    },
    {
      "id": "c-shiji-011-jingdi:p011",
      "text": "中三年冬，罷諸侯御史中丞。春，匈奴王二人率其徒來降，皆封為列侯。",
      "annotation_status": "named_mentions_first_pass",
      "text_layer": "received_chapter",
      "mentions": [
        {
          "id": "c-shiji-011-jingdi:m011-0015",
