    {
      "id": "le-shiji031-005",
      "person_id": "5dm_e40_rqh_AAAA",
      "event_type": "death",
      "status": "source_attested",
      "date_expression": null,
      "evidence": [
        {
          "chapter_id": "c-shiji-031-wu",
          "source_id": "s-shiji-031-wu",
          "paragraph_id": "c-shiji-031-wu:p003",
          "quote": "周章卒，子熊遂立，熊遂卒，子柯相立。柯相卒，子彊鳩夷立。彊鳩夷卒，子餘橋疑吾立。餘橋疑吾卒，子柯盧立。柯盧卒，子周繇立。周繇卒，子屈羽立。屈羽卒，子夷吾立。夷吾卒，子禽處立。禽處卒，子轉立。轉卒，子頗髙立。頗髙卒，子句卑立。是時晉獻公滅周北虞公，以開晉伐虢也。句卑卒，子去齊立。去齊卒，子壽夢立。壽夢立而吳始益大，稱王。",
          "person_mention_id": "c-shiji-031-wu:m003-0000"
        }
      ],
      "source_term": "周章卒",
      "interpretation_note": "本篇世系敘事的死亡見證，不補年次或今日地點。",
      "reviewer": "Codex（AI 代理）",
      "human_reviewed": false
    },
