    {
      "id": "le-shiji031-001",
      "person_id": "5dm_e40_rqh_B",
      "event_type": "death",
      "status": "source_attested",
      "date_expression": null,
      "evidence": [
        {
          "chapter_id": "c-shiji-031-wu",
          "source_id": "s-shiji-031-wu",
          "paragraph_id": "c-shiji-031-wu:p002",
          "quote": "太伯卒，無子，弟仲雍立，是爲吳仲雍。仲雍卒，子季簡立。季簡卒，子叔達立。叔達卒，子周章立。是時周武王克殷，求太伯、仲雍之後，得周章。周章已君吳，因而封之。乃封周章弟虞仲於周之北故夏虛，是爲虞仲，列爲諸侯。",
          "person_mention_id": "c-shiji-031-wu:m002-0000"
        }
      ],
      "source_term": "太伯卒",
      "interpretation_note": "本篇世系敘事的死亡與繼位分開，未知日期不補。",
