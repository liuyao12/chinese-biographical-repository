  "assertions": [
    {
      "id": "a-shiji031-001",
      "subject_person_id": "cbr-p000172",
      "predicate": "father",
      "object_person_id": "cbr-p000171",
      "status": "source_attested",
      "evidence": [
        {
          "chapter_id": "c-shiji-031-wu",
          "source_id": "s-shiji-031-wu",
          "paragraph_id": "c-shiji-031-wu:p001",
          "quote": "吳太伯，太伯弟仲雍，皆周太王之子，而王季暦之兄也。季歴賢，而有聖子昌，太王欲立季暦以及昌，於是太伯、仲雍二人乃犇荊蠻，文身斷髮，示不可用，以避季暦。季暦果立，是爲王季，而昌爲文王。太伯之犇荊蠻，自號句吳。荊蠻義之，從而歸之千餘家，立爲吳太伯。"
        }
      ],
      "qualifiers": {
        "source_term": "皆周太王之子",
        "historicity": "historical_tradition"
      },
