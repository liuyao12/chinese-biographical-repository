      "evidence": [
        {
          "work_id": "w-nanshi",
          "book_id": "b-nanshi-022",
          "chapter_id": "c-nanshi-022-wangsengqian",
          "source_id": "s-nanshi-022-wangsengqian-ws1477957",
          "paragraph_id": "c-nanshi-022-wangsengqian:p002",
          "quote": "兄僧綽為宋元凶所害，親賓咸勸之逃，僧虔泣曰：「吾兄奉國以忠貞，撫我以慈愛，今日之事，苦不見及耳。若同歸九泉，猶羽化也。」孝武初，出為武陵太守，攜諸子侄。兄子儉中塗得病，僧虔為廢寢食，同行客慰喻之。僧虔曰：「昔馬援處子侄之間，一情不異，鄧攸于弟子，更逾所生，吾實懷其心，誠未異古。亡兄之胤，不宜忽諸，若此兒不救，便當回舟謝職。」還為中書郎，再遷太子中庶子。",
          "person_mention_id": "c-nanshi-022-wangsengqian:p002:m0084"
        }
      ],
      "status": "source_attested",
