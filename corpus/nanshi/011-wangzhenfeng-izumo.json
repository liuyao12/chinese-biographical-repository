      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:80c2b36684dc90339438687348b987e2c3388212c5127da7c3e4b85e39544fb3",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 1,
            "start": 12,
            "end": 18,
            "text": "廢帝即位尊為"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 2,
            "start": 0,
            "end": 18,
            "text": "皇太后宮曰弘訓廢帝失德太后每加勗譬始"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 3,
            "start": 0,
            "end": 18,
            "text": "猶見順後狂慝稍甚太后嘗賜帝玉柄毛扇帝"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 4,
            "start": 0,
            "end": 18,
            "text": "嫌毛扇不華因此欲加酖害令太醫煑藥左右"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 5,
            "start": 0,
            "end": 18,
            "text": "止之曰若行此事官便作孝子豈得出入狡獪"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 6,
            "start": 0,
            "end": 18,
            "text": "帝曰汝語大有理乃止順帝即位齊高帝執權"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 7,
            "start": 0,
            "end": 18,
            "text": "宗室劉晃劉綽卜伯興等有異志太后頗與相"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 8,
            "start": 0,
            "end": 18,
            "text": "關順帝禪位太后與帝遜于東邸因遷居丹楊"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 9,
            "start": 0,
            "end": 18,
            "text": "宮拜汝陰王太妃順帝殂于丹楊更立第都下"
          },
          {
            "pdf_page": 16,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 1,
            "start": 0,
            "end": 18,
            "text": "建元元年薨于第追加諡葬以宋禮后父僧朗"
          },
          {
            "pdf_page": 16,
            "half": "右",
            "leaf": "十三下",
            "column_from_right": 2,
            "start": 0,
            "end": 3,
            "text": "別有傳"
          }
        ]
      }
    }
  ],
