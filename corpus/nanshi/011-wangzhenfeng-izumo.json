      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:80c2b36684dc90339438687348b987e2c3388212c5127da7c3e4b85e39544fb3",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 1,
            "start": 0,
            "end": 18,
            "text": "明恭王皇后諱貞風琅邪臨沂人也初拜淮陽"
          },
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 2,
            "start": 0,
            "end": 18,
            "text": "王妃明帝改封又為湘東王妃生晉陵長公主"
          },
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 3,
            "start": 0,
            "end": 18,
            "text": "伯姒建安長公主伯媛明帝即位立為皇后上"
          },
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 4,
            "start": 0,
            "end": 18,
            "text": "嘗宮內大集而裸婦人觀之以為歡笑后以扇"
          },
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 5,
            "start": 0,
            "end": 18,
            "text": "鄣面獨無所言帝怒曰外舍家寒乞今共作笑"
          },
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 6,
            "start": 0,
            "end": 18,
            "text": "樂何獨不視后曰為樂之事其方自多豈有姑"
          },
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 7,
            "start": 0,
            "end": 18,
            "text": "姊妹集聚而裸婦人形體以此為樂外舍為歡"
          },
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 8,
            "start": 0,
            "end": 18,
            "text": "適與此不同帝大怒令后起后兄揚州刺史景"
          },
          {
            "pdf_page": 15,
            "half": "右",
            "leaf": "十二下",
            "column_from_right": 9,
            "start": 0,
            "end": 18,
            "text": "文以此事語從舅陳郡謝綽曰后在家為儜弱"
          },
          {
            "pdf_page": 15,
            "half": "左",
            "leaf": "十三上",
            "column_from_right": 1,
            "start": 0,
            "end": 12,
            "text": "婦人不知今段遂能剛正如此"
          }
        ]
      }
    },
    {
      "id": "c-nanshi-011-wangzhenfeng-izumo:p002",
      "text": "廢帝即位尊為皇太后宮曰弘訓廢帝失德太后每加勗譬始猶見順後狂慝稍甚太后嘗賜帝玉柄毛扇帝嫌毛扇不華因此欲加酖害令太醫煑藥左右止之曰若行此事官便作孝子豈得出入狡獪帝曰汝語大有理乃止順帝即位齊高帝執權宗室劉晃劉綽卜伯興等有異志太后頗與相關順帝禪位太后與帝遜于東邸因遷居丹楊宮拜汝陰王太妃順帝殂于丹楊更立第都下建元元年薨于第追加諡葬以宋禮后父僧朗別有傳",
      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
