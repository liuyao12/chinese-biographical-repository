  <p id="c-nanshi-023-wanghuan:p001" annotation-status="in_progress" text-layer="received_chapter"><persName id="c-nanshi-023-wanghuan:p001:m0000" ref="q7m_r8k_2vn_AA">奐</persName>字道明，<persName id="c-nanshi-023-wanghuan:p001:m0005" ref="1tc_q18_x7v">彧</persName>兄子也。父<persName id="c-nanshi-023-wanghuan:p001:m0011" ref="q7m_r8k_2vn_A">粹</persName>字景深，位黃門侍郎。<persName id="c-nanshi-023-wanghuan:p001:m0022" ref="q7m_r8k_2vn_AA">奐</persName>繼從祖<persName id="c-nanshi-023-wanghuan:p001:m0026" ref="3c9_d1d_870_B">球</persName>，故小字彥孫。</p>
</text>
