      },
      "evidence": [
        {
          "work_id": "w-nanshi",
          "book_id": "b-nanshi-022",
          "chapter_id": "c-nanshi-022-wangtai",
          "source_id": "s-nanshi-022-wangtai-ws1477957",
          "paragraph_id": "c-nanshi-022-wangtai:p002",
          "quote": "梁天監元年為秘書丞。自齊永元之末，後宮火延燒秘書，圖書散亂殆盡。泰表校定繕寫，武帝從之。曆中書侍郎，掌吏部，仍即真。自過江，吏部郎不復典大選，令史以下，小人求競者輻湊前後，少能稱職。泰為之，不為貴賤請屬易意，天下稱平。轉黃門侍郎，每預朝宴，刻燭賦詩，文不加點，帝深賞歎。沈約常曰：「王有養、炬，謝有覽、舉。」養，泰小字，炬，筠小字也。",
          "person_mention_id": "c-nanshi-022-wangtai:p002:m0032"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "本句所載官名，任期無確切年月。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    },
