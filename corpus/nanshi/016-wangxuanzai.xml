  <p id="c-nanshi-016-wangxuanzai:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-nanshi-016-wangxuanzai:p001:m0000" ref="85g_yq3_0w6_AA">玄載</persName>字<persName id="c-nanshi-016-wangxuanzai:p001:m0003" ref="85g_yq3_0w6_AA">彦休</persName>，<persName id="c-nanshi-016-wangxuanzai:p001:m0006" ref="31b_fd1_f77">玄謨</persName>從弟也。父<persName id="c-nanshi-016-wangxuanzai:p001:m0013" ref="85g_yq3_0w6_A">蕤</persName>，東莞太守。<persName id="c-nanshi-016-wangxuanzai:p001:m0020" ref="85g_yq3_0w6_AA">玄載</persName>仕宋，位益州刺史。<persName id="c-nanshi-016-wangxuanzai:p001:m0031" ref="16c_0og_lvl_A">沈攸之</persName>之難，<persName id="c-nanshi-016-wangxuanzai:p001:m0037" ref="85g_yq3_0w6_AA">玄載</persName>起義，送誠于齊髙帝，封鄂縣子。齊建元元年，爲左戸尚書。永明四年，位兗州刺史，卒官。諡烈子。</p>
</text>
