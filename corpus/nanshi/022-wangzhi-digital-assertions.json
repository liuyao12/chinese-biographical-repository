      },
      "evidence": [
        {
          "work_id": "w-nanshi",
          "book_id": "b-nanshi-022",
          "chapter_id": "c-nanshi-022-wangzhi-digital",
          "source_id": "s-nanshi-022-wangzhi-digital-ws1477957",
          "paragraph_id": "c-nanshi-022-wangzhi-digital:p004",
          "quote": "志善草隸，當時以為楷法。齊遊擊將軍徐希秀亦號能書，常謂志為「書聖」。志家居建康禁中裏馬糞巷。父僧虔門風寬恕，志尤惇厚，所曆不以罪咎劾人。門下客嘗盜脫志車幰賣之，志知而不問，待之如初。賓客遊其門者，專蓋其過而稱其善。兄弟子侄皆篤實謙和，時人號馬糞諸王為長者。普通四年，志改葬，武帝厚賻贈之，諡曰安。有五子：緝、休、諲、操、素。",
          "subject_person_mention_id": "c-nanshi-022-wangzhi-digital:p004:m0152",
          "object_person_mention_id": "c-nanshi-022-wangzhi-digital:p004:m0133"
        }
      ],
      "interpretation_note": "同一枚舉中的一位明名兒子。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    },
