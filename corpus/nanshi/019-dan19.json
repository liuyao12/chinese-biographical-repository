    {
      "id": "c-nanshi-019-dan19:p003",
      "text": "景平中，累遷光祿大夫。從子晦爲荊州，將之鎮，詣澹別。晦色自矜，澹問晦年，答曰三十五。澹笑曰：「昔荀中郎年二十九爲北府都督，卿比之已爲老矣。」晦色甚愧。元嘉中，位侍中、特進、金紫光祿大夫，卒。",
      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
      "mentions": [
        {
          "id": "c-nanshi-019-dan19:p003:m0013",
          "start": 13,
          "end": 14,
          "surface": "晦",
          "person_id": "aa6_83c_juy_AAAA",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "赴鎮者。"
        },
        {
          "id": "c-nanshi-019-dan19:p003:m0023",
          "start": 23,
          "end": 24,
          "surface": "澹",
          "person_id": "ph1_0cf_nxw",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "晦辭別對象。"
        },
        {
          "id": "c-nanshi-019-dan19:p003:m0026",
          "start": 26,
          "end": 27,
          "surface": "晦",
          "person_id": "aa6_83c_juy_AAAA",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "與澹對話之前。"
        },
        {
          "id": "c-nanshi-019-dan19:p003:m0031",
          "start": 31,
          "end": 32,
          "surface": "澹",
          "person_id": "ph1_0cf_nxw",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "問者。"
        },
        {
          "id": "c-nanshi-019-dan19:p003:m0033",
          "start": 33,
          "end": 34,
          "surface": "晦",
          "person_id": "aa6_83c_juy_AAAA",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "答三十五者。"
        },
        {
          "id": "c-nanshi-019-dan19:p003:m0042",
          "start": 42,
          "end": 43,
          "surface": "澹",
          "person_id": "ph1_0cf_nxw",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "以下發言者。"
        },
        {
          "id": "c-nanshi-019-dan19:p003:m0070",
          "start": 70,
          "end": 71,
          "surface": "晦",
          "person_id": "aa6_83c_juy_AAAA",
          "kind": "person",
          "status": "contextual_provisional",
          "interpretation_note": "引語結束後之主語。"
        }
      ],
