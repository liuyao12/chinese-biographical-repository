  <p id="c-nanshi-019-dan19:p001" annotation-status="in_progress" text-layer="received_chapter"><persName id="c-nanshi-019-dan19:p001:m0000" ref="ph1_0cf_nxw">澹</persName>字<persName id="c-nanshi-019-dan19:p001:m0002" ref="ph1_0cf_nxw">景恆</persName>，<persName id="c-nanshi-019-dan19:p001:m0005" ref="aa6_83c_juy_AAAA">晦</persName>從叔也。祖<persName id="c-nanshi-019-dan19:p001:m0011" ref="aa6_83c_juy_B">安</persName>，晉太傅。父<persName id="c-nanshi-019-dan19:p001:m0018" ref="6na_bet_3ch">瑤</persName>，琅邪王友。</p>
