          "evidence": [
            {
              "work_id": "w-nanshi",
              "book_id": "b-nanshi-024",
              "source_id": "s-nanshi-024-wangyuezhi-ws1765279",
              "chapter_id": "c-nanshi-024-wangyuezhi",
              "paragraph_id": "c-nanshi-024-wangyuezhi:p002",
              "quote": "悅之少厲清操，亮直有風檢。爲吏部郎，鄰省有會同者，遺悅之餅一甌。辭不受，曰：「此費誠小，然少來不願當之。」宋明帝泰始中爲黃門郎、御史中丞。上以其廉介，賜良田五頃，以爲侍中，在門下盡其心力。掌檢校禦府太官太醫諸署。時承奢忲之後，奸竊者眾，悅之按覆無所避，得奸巧甚多，於是眾署共咒詛。悅之病甚，恒見兩烏衣人捶之。及卒，上乃收典掌者十許人，桎梏之送淮陰，密令度瓜歩江，投之中流。",
              "person_mention_id": "c-nanshi-024-wangyuezhi:p002:m0000"
            }
          ]
        },
        "end": {
          "status": "unknown",
          "date_expression": null,
          "evidence": []
        }
      },
