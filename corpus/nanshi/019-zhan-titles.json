    {
      "id": "th-nanshi019-zhan-50-27",
      "person_id": "aa6_83c_juy_CDA",
      "title": "祕書郎",
      "kind": "office",
      "mode": "attestation",
      "status": "source_attested",
      "evidence": [
        {
          "work_id": "w-nanshi",
          "book_id": "b-nanshi-019",
          "chapter_id": "c-nanshi-019-nan19",
          "source_id": "s-nanshi-019-nan19-ws1531762",
          "paragraph_id": "c-nanshi-019-nan19:zhan-l050",
          "quote": "瞻文章之美，與從叔混、族弟靈運相抗。靈運父瑍無才能，爲祕書郎早卒，而靈運好臧否人物。混患之，欲加裁折，未有其方。謂瞻曰：「非汝莫能。」乃與晦、曜、弘微等共遊戲，使瞻與靈運共車。靈運登車便商較人物，瞻謂曰：「祕書早亡，談者亦互有同異。」靈運默然，言論自此衰止。",
          "person_mention_id": "c-nanshi-019-nan19:zhan-l050:m0021"
        }
