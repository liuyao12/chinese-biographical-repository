      "evidence": [
        {
          "work_id": "w-nanqishu",
          "book_id": "b-nanqishu-032",
          "chapter_id": "c-nanqishu-032-chuxuan",
          "source_id": "s-nanqishu-032-chuxuan-ws1513918",
          "paragraph_id": "c-nanqishu-032-chuxuan:p004",
          "quote": "昇明初，炫以清尚，與劉俁、謝朏、江效入殿侍文義，號爲「四友」。遷黃門郎，太祖驃騎長史，遷侍中，復爲長史。齊臺建，復爲侍中，領步兵校尉。以家貧，建元初，出補東陽太守，加秩中二千石。還，復爲侍中，領步兵。凡三爲侍中。出爲竟陵王征北長史，加輔國將軍，尋徙爲冠軍長史、江夏內史，將軍如故。",
          "person_mention_id": "c-nanqishu-032-chuxuan:p004:m0004"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "所見原官稱，未載全任期。",
