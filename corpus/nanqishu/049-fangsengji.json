    "source_reading_cases": [
      {
        "id": "c-nanqishu-049-fangsengji:received_sentence1-0",
        "kind": "received_sentence",
        "person_id": "d61_8b9_780",
        "source_quote": "時竟陵太守房僧寄被代還至郢，東昏敕僧寄留守魯山，除驍騎將軍。",
        "reading": "竟陵太守房僧寄得代還郢，東昏令留守魯山，授驍騎將軍。",
        "note": "竟陵太守房僧寄得代還郢，東昏令留守魯山，授驍騎將軍。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p001",
        "start_codepoint": 0,
        "end_codepoint": 30,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-fangsengji:received_sentence1-30",
        "kind": "received_sentence",
        "person_id": "d61_8b9_780",
        "source_quote": "僧寄謂沖曰：「臣雖未荷朝廷深恩，實蒙先帝厚澤。",
        "reading": "向張沖自述曾蒙先帝厚澤。",
        "note": "向張沖自述曾蒙先帝厚澤。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p001",
        "start_codepoint": 30,
        "end_codepoint": 53,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-fangsengji:received_sentence1-53",
        "kind": "received_sentence",
        "person_id": "d61_8b9_780",
        "source_quote": "蔭其樹者不折其枝，實欲微立塵效。」",
        "reading": "以蔭樹護枝為喻，自誓盡力。",
        "note": "以蔭樹護枝為喻，自誓盡力。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p001",
        "start_codepoint": 53,
        "end_codepoint": 70,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-fangsengji:received_sentence1-70",
        "kind": "received_sentence",
        "person_id": "d61_8b9_780",
        "source_quote": "沖深相許諾，共結盟誓。",
        "reading": "張沖許諾，兩人盟誓。",
        "note": "張沖許諾，兩人盟誓。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p001",
        "start_codepoint": 70,
        "end_codepoint": 81,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-fangsengji:received_sentence1-81",
        "kind": "received_sentence",
        "person_id": "d61_8b9_780",
        "source_quote": "乃分部拒守。",
        "reading": "分部守備。",
        "note": "分部守備。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p001",
        "start_codepoint": 81,
        "end_codepoint": 87,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-fangsengji:received_sentence1-87",
        "kind": "received_sentence",
        "person_id": "d61_8b9_780",
        "source_quote": "遣軍主孫樂祖數千人助僧寄據魯山岸立城壘。",
        "reading": "軍主孫樂祖領數千人協守魯山。",
        "note": "軍主孫樂祖領數千人協守魯山。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p001",
        "start_codepoint": 87,
        "end_codepoint": 107,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-fangsengji:received_sentence2-0",
        "kind": "received_sentence",
        "person_id": "d61_8b9_780",
        "source_quote": "房僧寄病死，",
        "reading": "郢、魯相守中房僧寄病死；他死後孫樂祖才以城降。",
        "note": "郢、魯相守中房僧寄病死；他死後孫樂祖才以城降。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p002",
        "start_codepoint": 0,
        "end_codepoint": 6,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-fangsengji:received_sentence3-0",
        "kind": "received_sentence",
        "person_id": "d61_8b9_780",
        "source_quote": "贈僧寄益州刺史。",
        "reading": "本傳明記身後贈益州刺史。",
        "note": "本傳明記身後贈益州刺史。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p003",
        "start_codepoint": 0,
        "end_codepoint": 8,
        "human_reviewed": false
      },
      {
        "id": "c-nanqishu-049-fangsengji:metaphor1-53",
        "kind": "metaphor",
        "person_id": "d61_8b9_780",
        "source_quote": "蔭其樹者不折其枝",
        "reading": "事先帝而保其嗣，以樹蔭及枝為喻；未說僧寄與齊帝有親屬關係。",
        "note": "事先帝而保其嗣，以樹蔭及枝為喻；未說僧寄與齊帝有親屬關係。",
        "paragraph_id": "c-nanqishu-049-fangsengji:p001",
        "start_codepoint": 53,
        "end_codepoint": 61,
        "human_reviewed": false,
        "prior_ruler_id": "w4m_9tw_147",
        "current_ruler_id": "w4m_9tw_147_A"
      },
