      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:25c5d630868360f6d8d6790f10c11c47da006a69c0cf3704c24be72a9760c19c",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 3,
            "half": "右",
            "leaf": "一下",
            "column_from_right": 4,
            "start": 4,
            "end": 21,
            "text": "后少家貧勤織作家人矜其勞或止之后終"
          },
          {
            "pdf_page": 3,
            "half": "右",
            "leaf": "一下",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "不改嫁于宣帝庶生衡陽元王道度始安貞王道生后"
          },
          {
            "pdf_page": 3,
            "half": "右",
            "leaf": "一下",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "生太祖太祖年二歲乳人乏乳后夢人以兩甌麻粥與"
          },
          {
            "pdf_page": 3,
            "half": "右",
            "leaf": "一下",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "之覺而乳大出異而說之宣帝從仕在外后常留家治"
          },
          {
            "pdf_page": 3,
            "half": "右",
            "leaf": "一下",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "事教子孫有相者謂后曰夫人有貴子而不見也后歎"
          },
          {
            "pdf_page": 3,
            "half": "右",
            "leaf": "一下",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "曰我三兒誰當應之呼太祖小字曰正應是汝耳宣帝"
          },
          {
            "pdf_page": 3,
            "half": "右",
            "leaf": "一下",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "殂後后親自執勤婢使有過誤恕不問也太祖雖從官"
          },
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "而家業本貧為建康令時高宗等冬月猶無縑纊而奉"
          },
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "膳甚厚后每撤去兼肉曰於我過足矣殂于縣舍年七"
          },
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "十三昇明三年追贈竟陵公國太夫人蜜印畫青綬祠"
          },
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 4,
            "start": 0,
            "end": 21,
            "text": "以太牢建元元年追尊孝皇后贈外祖父肇之金紫光"
          },
          {
            "pdf_page": 3,
            "half": "左",
            "leaf": "二上",
            "column_from_right": 5,
            "start": 0,
            "end": 17,
            "text": "祿大夫諡曰敬侯后母胡氏為永昌縣靖君"
          }
        ]
      }
    }
  ],
