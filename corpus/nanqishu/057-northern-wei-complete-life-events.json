    {
      "id": "le-qi057-xian-wen-death",
      "person_id": "e12_05z_jc2",
      "event_type": "death",
      "source_term": "死",
      "source_anchor": {
        "paragraph_id": "c-nanqishu-057-northern-wei-complete:p009",
        "start": 33,
