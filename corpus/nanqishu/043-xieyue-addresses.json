        "source_name": "陳郡陽夏",
        "place_id": null,
        "modern_identification": null
      },
      "source_term": "陳郡陽夏人也",
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-nanqishu",
          "book_id": "b-nanqishu-043",
          "source_id": "s-nanqishu043-ws2400356",
          "chapter_id": "c-nanqishu-043-xieyue",
          "paragraph_id": "c-nanqishu-043-xieyue:p001",
          "quote": "謝𤅢字義潔，陳郡陽夏人也。祖弘微，宋太常。父莊，金紫光祿大夫。𤅢四兄颺、朏、顥、嵷，世謂謝莊名兒爲風、月、景、山、水。顥字仁悠，少簡靜。解褐祕書郎，累至太祖驃騎從事中郎。建元初，爲吏部郎，至太尉從事中郎。永明初，高選友、學，以顥爲竟陵王友。至北中郎長史。卒。",
          "person_mention_id": "c-nanqishu-043-xieyue:p001:m0000"
        }
      ],
      "interpretation_note": "傳首原稱籍貫，不附今地。"
    },
    {
      "status": "source_attested",
      "reviewer": "Codex（AI代理）",
      "human_reviewed": false,
      "model": null,
      "id": "pa-nanqi043-xieyue-lu",
