      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:1451b22776c00842bf23a00518b5d0d5b965d55a829aaf03fce637709369d16c",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 5,
            "half": "右",
            "leaf": "三下",
            "column_from_right": 4,
            "start": 7,
            "end": 21,
            "text": "宋世太祖為文惠太子納后桂陽賊"
          },
          {
            "pdf_page": 5,
            "half": "右",
            "leaf": "三下",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "至太祖在新亭傳言已沒宅復為人所抄掠文惠太子"
          },
          {
            "pdf_page": 5,
            "half": "右",
            "leaf": "三下",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "竟陵王子良奉穆后庾妃及后挺身送后兄昺之家事"
          },
          {
            "pdf_page": 5,
            "half": "右",
            "leaf": "三下",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "平乃出建元元年為南郡王妃四年為皇太子妃無寵"
          },
          {
            "pdf_page": 5,
            "half": "右",
            "leaf": "三下",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "太子為宮人製新麗衣裳及首飾而后牀帷陳設故舊"
          },
          {
            "pdf_page": 5,
            "half": "右",
            "leaf": "三下",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "釵鑷十餘枚永明十一年為皇太孫太妃鬱林即位尊"
          },
          {
            "pdf_page": 5,
            "half": "右",
            "leaf": "三下",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "為皇太后稱宣德宮贈后父金紫光祿大夫母桓氏豐"
          },
          {
            "pdf_page": 5,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "安縣君其年十二月備法駕謁太廟高宗即位出居鄱"
          },
          {
            "pdf_page": 5,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "陽王故第為宣德宮永元三年梁王定京邑迎后入宮"
          },
          {
            "pdf_page": 5,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "稱制至禪位天監十一年薨年五十八葬崇安陵諡曰"
          },
          {
            "pdf_page": 5,
            "half": "左",
            "leaf": "四上",
            "column_from_right": 4,
            "start": 0,
            "end": 8,
            "text": "安后兄晃義興太守"
          }
        ]
      }
    }
  ],
  "text_sha256": "66a83ef48cceea17aff3b6c53f77a346c9c72c04a217ca9c9cfa2cfb44b03128"
