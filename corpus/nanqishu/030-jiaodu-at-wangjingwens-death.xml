<text format-version="0.2" work-id="w-nanqishu" book-id="b-nanqishu-030" chapter-id="c-nanqishu-030-jiaodu-at-wangjingwens-death" source-id="s-nanqishu-030-jiaodu-at-wangjingwens-death-ws1513917">
  <p id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p001:m0000" ref="g83_41s_o52_*A">焦度</persName>字<persName id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p001:m0003" ref="g83_41s_o52_*A">文續</persName>，南安氐人也。祖<persName id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p001:m0013" ref="g83_41s_o52">文珪</persName></p>
  <p id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p002" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p002:m0000" ref="1tc_q18_x7v">景文</persName>被害夕，<persName id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p002:m0006" ref="g83_41s_o52_*A">度</persName>大怒，勸<persName id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p002:m0011" ref="1tc_q18_x7v">景文</persName>拒命，<persName id="c-nanqishu-030-jiaodu-at-wangjingwens-death:p002:m0016" ref="1tc_q18_x7v">景文</persName>不從。明帝不知也。</p>
</text>
