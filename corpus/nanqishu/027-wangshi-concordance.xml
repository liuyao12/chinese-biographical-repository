<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-nanqishu" book-id="b-nanqishu-027" chapter-id="c-nanqishu-027-wangshi-concordance" source-id="s-nanqishu-027-wangshi-concordance-ws1508012">
  <p id="c-nanqishu-027-wangshi-concordance:p001" annotation-status="reviewed" text-layer="received_chapter">率龍驤將軍<persName id="c-nanqishu-027-wangshi-concordance:p001:m0005" ref="7a0_95e_c4a">王敬則</persName>、<persName id="c-nanqishu-027-wangshi-concordance:p001:m0009" ref="9e9_8qw_my0">姜產</persName>步騎五千討壽陽。</p>
  <p id="c-nanqishu-027-wangshi-concordance:p002" annotation-status="reviewed" text-layer="received_chapter">廬江太守<persName id="c-nanqishu-027-wangshi-concordance:p002:m0004" ref="ex1_ave_xuz">王仲子</persName>南奔</p>
  <p id="c-nanqishu-027-wangshi-concordance:p003" annotation-status="reviewed" text-layer="received_chapter">引軍至晉熙，偽太守<persName id="c-nanqishu-027-wangshi-concordance:p003:m0009" ref="m9e_n5s_i8p">閻湛</persName>拒守，<persName id="c-nanqishu-027-wangshi-concordance:p003:m0014" ref="902_55f_656">劉子勛</persName>遣將<persName id="c-nanqishu-027-wangshi-concordance:p003:m0019" ref="vip_96q_tbs">王仲虯</persName>步卒萬人救之，<persName id="c-nanqishu-027-wangshi-concordance:p003:m0029" ref="w3a_mm0_hw1_*A">懷珍</persName>遣馬步三千人襲擊<persName id="c-nanqishu-027-wangshi-concordance:p003:m0039" ref="vip_96q_tbs">仲虯</persName>，大破之於莫邪山，遂進壽陽。</p>
  <p id="c-nanqishu-027-wangshi-concordance:p004" annotation-status="reviewed" text-layer="received_chapter">又遣<persName id="c-nanqishu-027-wangshi-concordance:p004:m0002" ref="7a0_95e_c4a">王敬則</persName>破<persName id="c-nanqishu-027-wangshi-concordance:p004:m0006" ref="mj8_5ic_4kk_A">殷琰</persName>將<persName id="c-nanqishu-027-wangshi-concordance:p004:m0009" ref="6v9_6kw_j5b">劉從</persName>等四壘於橫塘死虎，</p>
  <p id="c-nanqishu-027-wangshi-concordance:p005" annotation-status="reviewed" text-layer="received_chapter">帝使<persName id="c-nanqishu-027-wangshi-concordance:p005:m0002" ref="w3a_mm0_hw1_*A">懷珍</persName>率龍驤將軍<persName id="c-nanqishu-027-wangshi-concordance:p005:m0009" ref="m4d_lon_pyg">王廣之</persName>五百騎，步卒二千人，沿海救援</p>
  <p id="c-nanqishu-027-wangshi-concordance:p006" annotation-status="reviewed" text-layer="received_chapter">遣<persName id="c-nanqishu-027-wangshi-concordance:p006:m0001" ref="m4d_lon_pyg">王廣之</persName>將百騎襲陷其城</p>
  <p id="c-nanqishu-027-wangshi-concordance:p007" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-nanqishu-027-wangshi-concordance:p007:m0000" ref="w3a_mm0_hw1_*A">懷珍</persName>又遣寧朔將軍<persName id="c-nanqishu-027-wangshi-concordance:p007:m0008" ref="9ye_u8v_u9b">明慶符</persName>與<persName id="c-nanqishu-027-wangshi-concordance:p007:m0012" ref="m4d_lon_pyg">廣之</persName>擊降<persName id="c-nanqishu-027-wangshi-concordance:p007:m0016" ref="9wk_za0_43k">延僧</persName>，遣高麗使詣京師。</p>
  <p id="c-nanqishu-027-wangshi-concordance:p008" annotation-status="reviewed" text-layer="received_chapter">中書舍人<persName id="c-nanqishu-027-wangshi-concordance:p008:m0004" ref="t3u_ekc_eeo">王道隆</persName>宣旨，以<persName id="c-nanqishu-027-wangshi-concordance:p008:m0011" ref="w3a_mm0_hw1_*A">懷珍</persName>為冠軍將軍、豫章太守。</p>
  <p id="c-nanqishu-027-wangshi-concordance:p009" annotation-status="reviewed" text-layer="received_chapter">偽軍主<persName id="c-nanqishu-027-wangshi-concordance:p009:m0003" ref="eid_mj9_js7">沈仲</persName>、<persName id="c-nanqishu-027-wangshi-concordance:p009:m0006" ref="tfa_2qs_xk5">王張</persName>引軍自&lt;魚貴&gt;口欲斷江，<persName id="c-nanqishu-027-wangshi-concordance:p009:m0020" ref="4xf_x1f_vsg">安民</persName>進軍合戰破之。</p>
  <p id="c-nanqishu-027-wangshi-concordance:p010" annotation-status="reviewed" text-layer="received_chapter">時<persName id="c-nanqishu-027-wangshi-concordance:p010:m0001" ref="7a0_95e_c4a">王敬則</persName>以勳誠見親，至於家國密事，上唯與<persName id="c-nanqishu-027-wangshi-concordance:p010:m0020" ref="4xf_x1f_vsg">安民</persName>論議</p>
  <p id="c-nanqishu-027-wangshi-concordance:p011" annotation-status="reviewed" text-layer="received_chapter">又善結尚書令<persName id="c-nanqishu-027-wangshi-concordance:p011:m0006" ref="7r6_k52_qji_ABAAAAEAA">王儉</persName>，故世傳<persName id="c-nanqishu-027-wangshi-concordance:p011:m0012" ref="7r6_k52_qji_ABAAAAEAA">儉</persName>啟有此授。</p>
</text>
