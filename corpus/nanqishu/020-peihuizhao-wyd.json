        "source_layer": "received_biography",
        "column_projection": [
          {
            "column": "4L03",
            "pdf_page": 4,
            "half": "左",
            "leaf": "3上",
            "column_from_right": 3,
            "url": "https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4",
            "start": 2,
            "end": 21,
            "text": "舊顯陽昭陽殿太后皇后所居也永明中無太后"
          },
          {
            "column": "4L04",
            "pdf_page": 4,
            "half": "左",
            "leaf": "3上",
            "column_from_right": 4,
            "url": "https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4",
            "start": 0,
            "end": 21,
            "text": "皇后羊貴嬪居昭陽殿西范貴妃居昭陽殿東寵姬荀"
          },
          {
            "column": "4L05",
            "pdf_page": 4,
            "half": "左",
            "leaf": "3上",
            "column_from_right": 5,
            "url": "https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4",
            "start": 0,
            "end": 21,
            "text": "昭華居鳳華栢殿宮內御所居壽昌畫殿南閣置白鷺"
          },
          {
            "column": "4L06",
            "pdf_page": 4,
            "half": "左",
            "leaf": "3上",
            "column_from_right": 6,
            "url": "https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4",
            "start": 0,
            "end": 21,
            "text": "鼓吹二部乾光殿東西頭置鍾磬兩廂皆宴樂處也上"
          },
          {
            "column": "4L07",
            "pdf_page": 4,
            "half": "左",
            "leaf": "3上",
            "column_from_right": 7,
            "url": "https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4",
            "start": 0,
            "end": 21,
            "text": "數遊幸諸苑囿載宮人從後車宮內深隱不聞端門鼓"
          },
          {
            "column": "4L08",
            "pdf_page": 4,
            "half": "左",
            "leaf": "3上",
            "column_from_right": 8,
            "url": "https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4",
            "start": 0,
            "end": 21,
            "text": "漏聲置鍾於景陽樓上宮人聞鍾聲早起裝飾至今此"
          },
          {
            "column": "4L09",
            "pdf_page": 4,
            "half": "左",
            "leaf": "3上",
            "column_from_right": 9,
            "url": "https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4",
            "start": 0,
            "end": 21,
            "text": "鍾唯應五鼓及三鼓也車駕數幸琅邪城宮人常從早"
          },
          {
            "column": "4L10",
            "pdf_page": 4,
            "half": "左",
            "leaf": "3上",
            "column_from_right": 10,
            "url": "https://upload.wikimedia.org/wikipedia/commons/0/01/NLC892-411999017142-12428_%E4%BA%8C%E5%8D%81%E5%9B%9B%E5%8F%B2_%E7%AC%AC158%E5%86%8A.pdf#page=4",
            "start": 0,
            "end": 8,
            "text": "發至湖北埭鷄始鳴"
          }
        ]
      }
    }
  ],
