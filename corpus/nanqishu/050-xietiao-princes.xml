<text format-version="0.2" work-id="w-nanqishu" book-id="b-nanqishu-050" chapter-id="c-nanqishu-050-xietiao-princes" source-id="s-nanqishu-050-xietiao-princes-ws2272731">
  <p id="c-nanqishu-050-xietiao-princes:p001" annotation-status="named_mentions_first_pass" text-layer="received_chapter">巴陵隱王<persName id="c-nanqishu-050-xietiao-princes:p001:m0004" ref="w4m_9tw_147_C">寶義</persName>字智勇，明帝長子也。本名<persName id="c-nanqishu-050-xietiao-princes:p001:m0018" ref="w4m_9tw_147_C">明基</persName>。</p>
  <p id="c-nanqishu-050-xietiao-princes:p002" annotation-status="named_mentions_first_pass" text-layer="received_chapter">江夏王<persName id="c-nanqishu-050-xietiao-princes:p002:m0003" ref="w4m_9tw_147_B">寶玄</persName>字智深，明帝第三子也。</p>
</text>
