    {
      "id": "th-nanqishu-020-wangbaoming-3",
      "person_id": "m9u_v4i_tk5",
      "title": "南郡王妃",
      "kind": "honorific",
      "mode": "attestation",
      "status": "source_attested",
      "evidence": [
        {
          "work_id": "w-nanqishu",
          "book_id": "b-nanqishu-020",
          "chapter_id": "c-nanqishu-020-wangbaoming",
          "source_id": "s-nanqishu-020-wangbaoming-ws2074177",
          "paragraph_id": "c-nanqishu-020-wangbaoming:p002",
          "quote": "宋世，太祖為文惠太子納后，桂陽賊至，太祖在新亭，傳言已沒，宅復為人所抄掠，文惠太子、竟陵王子良奉穆后、庾妃及后挺身送后兄昺之家，事平乃出。建元元年，為南郡王妃。四年，為皇太子妃，無寵。太子為宮人製新麗衣裳及首飾，而后牀帷陳設故舊，釵鑷十餘枚。永明十一年，為皇太孫太妃。鬱林即位，尊為皇太后，稱宣德宮。贈后父金紫光祿大夫，母桓氏豐安縣君。其年十二月，備法駕謁太廟。高宗即位，出居鄱陽王故第，為宣德宮。永元三年，梁王定京邑，迎后入宮稱制，至禪位。天監十一年，薨，年五十八。葬崇安陵。諡曰安后。兄晃義興太守。",
          "person_mention_id": "c-nanqishu-020-wangbaoming:p002:m0011"
        }
      ],
