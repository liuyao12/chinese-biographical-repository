<text format-version="0.2" work-id="w-nanqishu" book-id="b-nanqishu-049" chapter-id="c-nanqishu-049-wanghuan" source-id="s-nanqishu-049-ws2261984-wanghuan">
  <p id="c-nanqishu-049-wanghuan:p001" annotation-status="in_progress" text-layer="received_chapter"><persName id="c-nanqishu-049-wanghuan:p001:m0000" ref="q7m_r8k_2vn_AA">王奐</persName>字彥孫，琅邪臨沂人也。祖<persName id="c-nanqishu-049-wanghuan:p001:m0014" ref="q7m_r8k_2vn">僧朗</persName>，宋左光祿、儀同。父<persName id="c-nanqishu-049-wanghuan:p001:m0026" ref="q7m_r8k_2vn_A">粹</persName>，黃門郎。<persName id="c-nanqishu-049-wanghuan:p001:m0032" ref="q7m_r8k_2vn_AA">奐</persName>出繼從祖中書令<persName id="c-nanqishu-049-wanghuan:p001:m0040" ref="3c9_d1d_870_B">球</persName>，故字彥孫。</p>
</text>
