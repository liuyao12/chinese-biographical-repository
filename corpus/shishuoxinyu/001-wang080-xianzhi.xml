<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-001" chapter-id="c-shishuoxinyu-001-wang080-xianzhi" source-id="s-shishuoxinyu-001-wang080-xianzhi">
  <p id="c-shishuoxinyu-001-wang080-xianzhi:wangpu" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-001-wang080-xianzhi:wangpu:m0000" ref="sm1_jfi_7k2">獻之</persName>娶髙平<persName id="c-shishuoxinyu-001-wang080-xianzhi:wangpu:m0005" ref="e5k_f2i_cog">郗曇</persName>女，名<persName id="c-shishuoxinyu-001-wang080-xianzhi:wangpu:m0010" ref="e5k_f2i_cog_A">道茂</persName>，後離婚。</p>
  <p id="c-shishuoxinyu-001-wang080-xianzhi:biezhuan" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note">祖父<persName id="c-shishuoxinyu-001-wang080-xianzhi:biezhuan:m0002" ref="2hq_5un_2av">曠</persName>，淮南太守。父<persName id="c-shishuoxinyu-001-wang080-xianzhi:biezhuan:m0010" ref="326_faf_cd3">羲之</persName>，右將軍。咸寧中，詔尚<persName id="c-shishuoxinyu-001-wang080-xianzhi:biezhuan:m0023" ref="dkn_ge4_286_AAAAAAAFB">餘姚公主</persName>，遷中書令，卒。</p>
</text>
