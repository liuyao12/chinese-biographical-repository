  <p id="c-shishuoxinyu-006-jin080-xizhi:wangshipu" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-006-jin080-xizhi:wangshipu:m0000" ref="326_faf_cd3">逸少</persName>，<persName id="c-shishuoxinyu-006-jin080-xizhi:wangshipu:m0003" ref="326_faf_cd3">羲之</persName>小字。<persName id="c-shishuoxinyu-006-jin080-xizhi:wangshipu:m0008" ref="326_faf_cd3">羲之</persName>妻，太傅<persName id="c-shishuoxinyu-006-jin080-xizhi:wangshipu:m0014" ref="6lr_zci_i0j">郗鑒</persName>女，名<persName id="c-shishuoxinyu-006-jin080-xizhi:wangshipu:m0019" ref="6lr_zci_i0j_A">璿</persName>，字<persName id="c-shishuoxinyu-006-jin080-xizhi:wangshipu:m0022" ref="6lr_zci_i0j_A">子房</persName>。</p>
