<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-001" chapter-id="c-shishuoxinyu-001-wangdao-source" source-id="s-shishuoxinyu-001-wangdao-source">
  <p id="c-shishuoxinyu-001-wangdao-source:zhengwen" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-001-wangdao-source:zhengwen:m0000" ref="7r6_k52_qji_ABAAB">王長豫</persName>爲人謹順，事親盡色養之孝。</p>
  <p id="c-shishuoxinyu-001-wangdao-source:zhongxing" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-001-wangdao-source:zhongxing:m0000" ref="7r6_k52_qji_ABAAB">王悅</persName>字<persName id="c-shishuoxinyu-001-wangdao-source:zhongxing:m0003" ref="7r6_k52_qji_ABAAB">長豫</persName>，丞相<persName id="c-shishuoxinyu-001-wangdao-source:zhongxing:m0008" ref="7r6_k52_qji_ABAA">導</persName>長子也。仕至中書侍郎。</p>
  <p id="c-shishuoxinyu-001-wangdao-source:wenzi" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-001-wangdao-source:wenzi:m0000" ref="7r6_k52_qji_ABAAC">王恬</persName>字<persName id="c-shishuoxinyu-001-wangdao-source:wenzi:m0003" ref="7r6_k52_qji_ABAAC">敬豫</persName>，<persName id="c-shishuoxinyu-001-wangdao-source:wenzi:m0006" ref="7r6_k52_qji_ABAA">導</persName>次子也。</p>
  <p id="c-shishuoxinyu-001-wangdao-source:caoshu" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-001-wangdao-source:caoshu:m0000" ref="7r6_k52_qji_ABAA">導</persName>娶彭城<persName id="c-shishuoxinyu-001-wangdao-source:caoshu:m0004" ref="peq_fze_t0g">曹韶</persName>女，名<persName id="c-shishuoxinyu-001-wangdao-source:caoshu:m0009" ref="3da_7da_fe2">淑</persName>。</p>
</text>
