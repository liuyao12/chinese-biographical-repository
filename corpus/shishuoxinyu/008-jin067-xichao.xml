<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-008" chapter-id="c-shishuoxinyu-008-jin067-xichao" source-id="s-shishuoxinyu-008-jin067-xichao">
  <p id="c-shishuoxinyu-008-jin067-xichao:address" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-008-jin067-xichao:address:m0000" ref="u9s_w6j_8mc_AA">桓公</persName>語<persName id="c-shishuoxinyu-008-jin067-xichao:address:m0003" ref="57b_1cb_a1b">嘉賓</persName>：「<persName id="c-shishuoxinyu-008-jin067-xichao:address:m0007" ref="djo_u3b_i9w_A">阿源</persName>有德有言，向使作令僕，足以儀刑百揆。朝廷用違其才耳。」</p>
  <p id="c-shishuoxinyu-008-jin067-xichao:courtesy" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-008-jin067-xichao:courtesy:m0000" ref="57b_1cb_a1b">嘉賓</persName>，<persName id="c-shishuoxinyu-008-jin067-xichao:courtesy:m0003" ref="57b_1cb_a1b">郗超</persName>小字也。<persName id="c-shishuoxinyu-008-jin067-xichao:courtesy:m0009" ref="djo_u3b_i9w_A">阿源</persName>，<persName id="c-shishuoxinyu-008-jin067-xichao:courtesy:m0012" ref="djo_u3b_i9w_A">殷浩</persName>也。</p>
</text>
