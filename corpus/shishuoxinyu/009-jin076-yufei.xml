<?xml version="1.0" encoding="UTF-8"?>
<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-009" chapter-id="c-shishuoxinyu-009-jin076-yufei" source-id="s-shishuoxinyu-009-jin076-yufei">
  <p id="c-shishuoxinyu-009-jin076-yufei:peers" annotation-status="reviewed" text-layer="received_chapter">會稽<persName id="c-shishuoxinyu-009-jin076-yufei:peers:m0002" ref="u40_zod_c8p">虞𩦎</persName>，<persName id="c-shishuoxinyu-009-jin076-yufei:peers:m0005" ref="dkn_ge4_286_AAAAAAA">元皇</persName>時與<persName id="c-shishuoxinyu-009-jin076-yufei:peers:m0009" ref="u9s_w6j_8mc_AA">桓宣武</persName>同俠，其人有才理勝望。</p>
  <p id="c-shishuoxinyu-009-jin076-yufei:yu" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-009-jin076-yufei:yu:m0000" ref="u40_zod_c8p">𩦎</persName>字<persName id="c-shishuoxinyu-009-jin076-yufei:yu:m0002" ref="u40_zod_c8p">思行</persName>，會稽餘姚人。<persName id="c-shishuoxinyu-009-jin076-yufei:yu:m0011" ref="izi_e36_p1g">虞翻</persName>曾孫，右光祿<persName id="c-shishuoxinyu-009-jin076-yufei:yu:m0019" ref="9v9_cj5_dor">潭</persName>兄子也。雖機榦不及<persName id="c-shishuoxinyu-009-jin076-yufei:yu:m0029" ref="9v9_cj5_dor">潭</persName>，而至行過之。歷吏部郎、吳興守，徵為金紫光祿大夫，卒。</p>
  <p id="c-shishuoxinyu-009-jin076-yufei:comment" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-009-jin076-yufei:comment:m0000" ref="7r6_k52_qji_ABAA">王丞相</persName>嘗謂<persName id="c-shishuoxinyu-009-jin076-yufei:comment:m0005" ref="u40_zod_c8p">𩦎</persName>曰：「<persName id="c-shishuoxinyu-009-jin076-yufei:comment:m0009" ref="f84_da6_42a">孔愉</persName>有公才而無公望，<persName id="c-shishuoxinyu-009-jin076-yufei:comment:m0019" ref="o9i_f7k_d6z">丁潭</persName>有公望而無公才，</p>
  <p id="c-shishuoxinyu-009-jin076-yufei:ding" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-009-jin076-yufei:ding:m0000" ref="o9i_f7k_d6z">潭</persName>字<persName id="c-shishuoxinyu-009-jin076-yufei:ding:m0002" ref="o9i_f7k_d6z">世康</persName>，山陰人，吳司徒<persName id="c-shishuoxinyu-009-jin076-yufei:ding:m0012" ref="uxk_94s_ndu">固</persName>曾孫也。沈婉有雅望，少與<persName id="c-shishuoxinyu-009-jin076-yufei:ding:m0025" ref="f84_da6_42a">孔愉</persName>齊名。仕至光祿大夫。</p>
  <p id="c-shishuoxinyu-009-jin076-yufei:death" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-009-jin076-yufei:death:m0000" ref="u40_zod_c8p">𩦎</persName>未登台鼎，時論稱屈。</p>
</text>
