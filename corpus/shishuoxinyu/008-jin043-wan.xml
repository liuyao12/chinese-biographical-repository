<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-008" chapter-id="c-shishuoxinyu-008-jin043-wan" source-id="s-shishuoxinyu-008-jin043-wan">
  <p id="c-shishuoxinyu-008-jin043-wan:narrative" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-008-jin043-wan:narrative:m0000" ref="48e_04a_3d8">戎</persName>子<persName id="c-shishuoxinyu-008-jin043-wan:narrative:m0002" ref="brc_n26_ekm">萬子</persName>，有大成之風，苗而不秀。</p>
  <p id="c-shishuoxinyu-008-jin043-wan:zhugong" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-008-jin043-wan:zhugong:m0000" ref="brc_n26_ekm">王綏</persName>字<persName id="c-shishuoxinyu-008-jin043-wan:zhugong:m0003" ref="brc_n26_ekm">萬子</persName>，辟太尉掾，不就。年十九卒。</p>
  <p id="c-shishuoxinyu-008-jin043-wan:jinshu" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-008-jin043-wan:jinshu:m0000" ref="48e_04a_3d8">戎</persName>子<persName id="c-shishuoxinyu-008-jin043-wan:jinshu:m0002" ref="brc_n26_ekm">萬</persName>，有美號而太肥，<persName id="c-shishuoxinyu-008-jin043-wan:jinshu:m0011" ref="48e_04a_3d8">戎</persName>令食糠，而肥愈甚也。</p>
</text>
