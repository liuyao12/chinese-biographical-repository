<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-007" chapter-id="c-shishuoxinyu-007-jin043-xuan" source-id="s-shishuoxinyu-007-jin043-xuan">
  <p id="c-shishuoxinyu-007-jin043-xuan:prediction" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-007-jin043-xuan:prediction:m0000" ref="rlk_lzd_86c">王平子</persName>素不知<persName id="c-shishuoxinyu-007-jin043-xuan:prediction:m0006" ref="35b_mo3_adg">眉子</persName>，曰：「志大其量，終當死塢壁間。」</p>
  <p id="c-shishuoxinyu-007-jin043-xuan:zhugong" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-007-jin043-xuan:zhugong:m0000" ref="35b_mo3_adg">王玄</persName>字<persName id="c-shishuoxinyu-007-jin043-xuan:zhugong:m0003" ref="35b_mo3_adg">眉子</persName>，<persName id="c-shishuoxinyu-007-jin043-xuan:zhugong:m0006" ref="b0c_13f_c3a">夷甫</persName>子也。<persName id="c-shishuoxinyu-007-jin043-xuan:zhugong:m0011" ref="9o2_vhv_r7y">東海王越</persName>辟爲掾，後行陳留太守。大行威罰，爲塢人所害。</p>
</text>
