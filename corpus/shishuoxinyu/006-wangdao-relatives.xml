<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-006" chapter-id="c-shishuoxinyu-006-wangdao-relatives" source-id="s-shishuoxinyu-006-wangdao-relatives">
  <p id="c-shishuoxinyu-006-wangdao-relatives:shao-hui" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-006-wangdao-relatives:shao-hui:m0000" ref="7r6_k52_qji_ABAAE">王劭</persName>、<persName id="c-shishuoxinyu-006-wangdao-relatives:shao-hui:m0003" ref="7r6_k52_qji_ABAAF">王薈</persName>共詣<persName id="c-shishuoxinyu-006-wangdao-relatives:shao-hui:m0007" ref="u9s_w6j_8mc_AA">宣武</persName>，</p>
  <p id="c-shishuoxinyu-006-wangdao-relatives:shao" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-006-wangdao-relatives:shao:m0000" ref="7r6_k52_qji_ABAAE">劭</persName>字<persName id="c-shishuoxinyu-006-wangdao-relatives:shao:m0002" ref="7r6_k52_qji_ABAAE">敬倫</persName>，丞相<persName id="c-shishuoxinyu-006-wangdao-relatives:shao:m0007" ref="7r6_k52_qji_ABAA">導</persName>第五子。淸貴簡素，研味玄賾。大司馬<persName id="c-shishuoxinyu-006-wangdao-relatives:shao:m0025" ref="u9s_w6j_8mc_AA">桓温</persName>稱爲『<persName id="c-shishuoxinyu-006-wangdao-relatives:shao:m0030" ref="7r6_k52_qji_ABAAE">鳳鶵</persName>』。</p>
  <p id="c-shishuoxinyu-006-wangdao-relatives:hui" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-006-wangdao-relatives:hui:m0000" ref="7r6_k52_qji_ABAAF">薈</persName>字<persName id="c-shishuoxinyu-006-wangdao-relatives:hui:m0002" ref="7r6_k52_qji_ABAAF">敬文</persName>，<persName id="c-shishuoxinyu-006-wangdao-relatives:hui:m0005" ref="7r6_k52_qji_ABAA">丞相</persName>最小子。有淸譽，夷泰無競，仕至鎭軍將軍。</p>
  <p id="c-shishuoxinyu-006-wangdao-relatives:xiaonu" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-006-wangdao-relatives:xiaonu:m0000" ref="7r6_k52_qji_ABAAAB">王僧彌</persName>、<persName id="c-shishuoxinyu-006-wangdao-relatives:xiaonu:m0004" ref="aa6_83c_juy_CD">謝車騎</persName>共<persName id="c-shishuoxinyu-006-wangdao-relatives:xiaonu:m0008" ref="7r6_k52_qji_ABAAF">王小奴</persName>許集。</p>
</text>
