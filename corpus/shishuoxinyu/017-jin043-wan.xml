<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-017" chapter-id="c-shishuoxinyu-017-jin043-wan" source-id="s-shishuoxinyu-017-jin043-wan">
  <p id="c-shishuoxinyu-017-jin043-wan:mourning" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-017-jin043-wan:mourning:m0000" ref="48e_04a_3d8">王戎</persName>喪兒<persName id="c-shishuoxinyu-017-jin043-wan:mourning:m0004" ref="brc_n26_ekm">萬子</persName>，<persName id="c-shishuoxinyu-017-jin043-wan:mourning:m0007" ref="82k_3oi_qf8">山簡</persName>往省之，<persName id="c-shishuoxinyu-017-jin043-wan:mourning:m0013" ref="48e_04a_3d8">王</persName>悲不自勝。</p>
  <p id="c-shishuoxinyu-017-jin043-wan:wangyin" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-017-jin043-wan:wangyin:m0000" ref="48e_04a_3d8">戎</persName>子<persName id="c-shishuoxinyu-017-jin043-wan:wangyin:m0002" ref="brc_n26_ekm">綏</persName>，欲取<rs id="c-shishuoxinyu-017-jin043-wan:wangyin:u0006" type="unresolved">裴遁</rs>女。<persName id="c-shishuoxinyu-017-jin043-wan:wangyin:m0010" ref="brc_n26_ekm">綏</persName>既蚤亡，<persName id="c-shishuoxinyu-017-jin043-wan:wangyin:m0015" ref="48e_04a_3d8">戎</persName>過傷痛，不許人求之，遂至老無敢取者。</p>
</text>
