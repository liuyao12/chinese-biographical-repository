<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-006" chapter-id="c-shishuoxinyu-006-wang080-short" source-id="s-shishuoxinyu-006-wang080-short">
  <p id="c-shishuoxinyu-006-wang080-short:baiguan" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-006-wang080-short:baiguan:m0000" ref="326_faf_cd3_B">王徽之</persName>，字<persName id="c-shishuoxinyu-006-wang080-short:baiguan:m0005" ref="326_faf_cd3_B">子猷</persName>。</p>
  <p id="c-shishuoxinyu-006-wang080-short:zhongxing" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-006-wang080-short:zhongxing:m0000" ref="326_faf_cd3_B">徽之</persName>，<persName id="c-shishuoxinyu-006-wang080-short:zhongxing:m0003" ref="326_faf_cd3">羲之</persName>第五子。卓犖不羈，欲爲傲達，仕至黃門侍郎。</p>
  <p id="c-shishuoxinyu-006-wang080-short:dai" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-006-wang080-short:dai:m0000" ref="056_cvo_54m">戴逵</persName>字<persName id="c-shishuoxinyu-006-wang080-short:dai:m0003" ref="056_cvo_54m">安道</persName>，譙國人。</p>
