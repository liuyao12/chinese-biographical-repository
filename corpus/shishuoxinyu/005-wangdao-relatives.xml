<text format-version="0.2" work-id="w-shishuoxinyu" book-id="b-shishuoxinyu-005" chapter-id="c-shishuoxinyu-005-wangdao-relatives" source-id="s-shishuoxinyu-005-wangdao-relatives">
  <p id="c-shishuoxinyu-005-wangdao-relatives:succession" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-shishuoxinyu-005-wangdao-relatives:succession:m0000" ref="dkn_ge4_286_AAAAAAA">元皇帝</persName>既登阼，以{{ProperNoun|<persName id="c-shishuoxinyu-005-wangdao-relatives:succession:m0021" ref="ll1_7jh_vr0_AA">鄭后</persName>}}之寵，欲舍<persName id="c-shishuoxinyu-005-wangdao-relatives:succession:m0030" ref="dkn_ge4_286_AAAAAAAA">明帝</persName>而立<persName id="c-shishuoxinyu-005-wangdao-relatives:succession:m0034" ref="dkn_ge4_286_AAAAAAAF">簡文</persName>。</p>
  <p id="c-shishuoxinyu-005-wangdao-relatives:zhongxing" annotation-status="reviewed" text-layer="witness_appended_liuxiaobiao_note"><persName id="c-shishuoxinyu-005-wangdao-relatives:zhongxing:m0000" ref="dkn_ge4_286_AAAAAAA">元皇</persName>以<persName id="c-shishuoxinyu-005-wangdao-relatives:zhongxing:m0003" ref="dkn_ge4_286_AAAAAAAA">明帝</persName>及<persName id="c-shishuoxinyu-005-wangdao-relatives:zhongxing:m0006" ref="dkn_ge4_286_AAAAAAAB">琅邪王裒</persName>並非{{ProperNoun|敬后}}所生，而謂<persName id="c-shishuoxinyu-005-wangdao-relatives:zhongxing:m0034" ref="dkn_ge4_286_AAAAAAAB">裒</persName>有大成之度，勝於<persName id="c-shishuoxinyu-005-wangdao-relatives:zhongxing:m0043" ref="dkn_ge4_286_AAAAAAAA">明帝</persName></p>
</text>
