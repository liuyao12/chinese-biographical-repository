<text format-version="0.2" work-id="w-taipingyulan" book-id="b-taipingyulan-149" chapter-id="c-taipingyulan-149-wang080-xianzhi" source-id="s-taipingyulan-149-wang080-xianzhi">
  <p id="c-taipingyulan-149-wang080-xianzhi:wangyin" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-taipingyulan-149-wang080-xianzhi:wangyin:m0000" ref="sm1_jfi_7k2_A">安僖皇后王氏</persName>，字<persName id="c-taipingyulan-149-wang080-xianzhi:wangyin:m0008" ref="sm1_jfi_7k2_A">神受</persName>，太常<persName id="c-taipingyulan-149-wang080-xianzhi:wangyin:m0013" ref="sm1_jfi_7k2">王獻之</persName>女，<persName id="c-taipingyulan-149-wang080-xianzhi:wangyin:m0018" ref="dkn_ge4_286_AAAAAAAFB">新安公主</persName>生，即<persName id="c-taipingyulan-149-wang080-xianzhi:wangyin:m0025" ref="s6y_280_81r">安帝</persName>姑也。</p>
  <p id="c-taipingyulan-149-wang080-xianzhi:donggong" annotation-status="reviewed" text-layer="received_chapter">故中書令太常<persName id="c-taipingyulan-149-wang080-xianzhi:donggong:m0006" ref="sm1_jfi_7k2">王獻之</persName>、<persName id="c-taipingyulan-149-wang080-xianzhi:donggong:m0010" ref="dkn_ge4_286_AAAAAAAFB">新安公主</persName>息女，六行聿修，四德允備</p>
  <p id="c-taipingyulan-149-wang080-xianzhi:qijuzhu" annotation-status="reviewed" text-layer="received_chapter">百官朱服，會于<persName id="c-taipingyulan-149-wang080-xianzhi:qijuzhu:m0007" ref="dkn_ge4_286_AAAAAAAFB">新安公主</persName>第，秘書監<persName id="c-taipingyulan-149-wang080-xianzhi:qijuzhu:m0016" ref="326_faf_cd3_C">王操之</persName>爲主人。</p>
</text>
