  "paragraphs": [
    {
      "id": "c-chenshu-021-chen21:p001",
      "text": "王固字子堅，左光祿大夫通之弟也。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": [
        {
