        },
        {
          "id": "c-chenshu-021-chen21:p001:m0011",
          "start": 11,
          "end": 12,
          "surface": "通",
          "kind": "person",
          "person_id": "q7m_r8k_2vn_ABAC",
          "identification_status": "contextual_provisional",
          "interpretation_note": "《陳書》王通本傳明載父琳、祖份。"
        }
      ]
    },
    {
      "id": "c-chenshu-021-chen21:p002",
      "text": "荊州陷，固之鄱陽，隨兄質度東嶺，居信安縣。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": [
        {
          "id": "c-chenshu-021-chen21:p002:m0004",
          "start": 4,
          "end": 5,
          "surface": "固",
          "kind": "person",
          "person_id": "q7m_r8k_2vn_ABAE",
          "identification_status": "contextual_provisional",
          "interpretation_note": "《陳書》稱王通之弟，並明言隨兄質。"
        },
        {
          "id": "c-chenshu-021-chen21:p002:m0011",
          "start": 11,
          "end": 12,
          "surface": "質",
          "kind": "person",
          "person_id": "q7m_r8k_2vn_ABAD",
          "identification_status": "contextual_provisional",
          "interpretation_note": "《陳書》稱王通之弟；同父為家系判讀。"
        }
      ]
    },
    {
      "id": "c-chenshu-021-chen21:p003",
      "text": "高宗以固本無兵權，且居處清潔，止免所居官，禁錮。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": [
        {
          "id": "c-chenshu-021-chen21:p003:m0003",
          "start": 3,
          "end": 4,
          "surface": "固",
          "kind": "person",
          "person_id": "q7m_r8k_2vn_ABAE",
          "identification_status": "contextual_provisional",
          "interpretation_note": "《陳書》稱王通之弟，並明言隨兄質。"
        }
      ]
    },
    {
      "id": "c-chenshu-021-chen21:p004",
      "text": "太建二年，隨例為招遠將軍、宣惠豫章王諮議參軍。遷太中大夫、太常卿、南徐州大中正。七年，卒官，時年六十三。贈金紫光祿大夫。喪事所須，隨由資給。至德二年改葬，謚曰恭子。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": []
    },
    {
      "id": "c-chenshu-021-chen21:p005",
      "text": "固清虛寡慾，居喪以孝聞。又崇信佛法，及丁所生母憂，遂終身蔬食，夜則坐禪，晝誦佛經，兼習成實論義，而於玄言非所長。嘗聘於西魏，因宴饗之際，請停殺一羊，羊於固前跪拜。又宴於昆明池，魏人以南人嗜魚，大設罟網，固以佛法呪之，遂一鱗不獲。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
