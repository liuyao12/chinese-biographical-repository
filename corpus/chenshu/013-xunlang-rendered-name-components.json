    {
      "id": "name-chenshu013-fashang",
      "person_id": "vh4_rsb_xo3_AAA",
      "surname": "荀",
      "ming": "法尚",
      "chapter_id": "c-chenshu-013-xunlang-rendered",
      "paragraph_id": "c-chenshu-013-xunlang-rendered:p004",
      "person_mention_id": "c-chenshu-013-xunlang-rendered:p004:m0051",
      "source_anchor": {
        "paragraph_id": "c-chenshu-013-xunlang-rendered:p004",
        "start": 134,
        "end": 136,
        "surface": "法尚"
      },
      "quote": "高祖崩，宣太后與舍人蔡景歷祕不發喪，朗弟曉在都微知之，乃謀率其家兵襲臺。事覺，景歷殺曉，仍繫其兄弟。世祖即位，並釋之。因厚撫慰朗，令與侯安都等共拒王琳。琳平，遷使持節、安北將軍、散騎常侍、都督霍晉合三州諸軍事、合州刺史。天嘉六年卒，時年四十八。贈南豫州刺史，諡曰壯。子法尚嗣。",
      "additional_names": [],
      "status": "contextual_provisional",
      "human_reviewed": false,
      "model": null,
      "surname_basis": {
        "kind": "contextual_surname_from_same_source_father_chain",
        "status": "contextual_provisional",
        "human_reviewed": false,
        "rationale": "完整荀朗姓名seed與既存明父子斷言補省姓；不依ID、不推生年或新親屬。",
        "source_name_record_id": "name-chenshu013-xunlang",
        "source_full_quote": "荀朗字深明，潁川潁陰人也。祖延祖，梁潁川太守，父伯道，衛尉卿。",
        "steps": [
          {
            "assertion_id": "a-chenshu013-fashang-father-lang",
            "from_person_id": "vh4_rsb_xo3_AA",
            "to_person_id": "vh4_rsb_xo3_AAA",
            "traversal": "father_to_child",
            "source_term": "子法尚嗣",
            "evidence": {
