    "person_reference_occurrences": [
      {
        "id": "c-chenshu-023-lushan-complete:p002:r0071",
        "paragraph_id": "c-chenshu-023-lushan-complete:p002",
        "start": 71,
        "end": 72,
        "surface": "父",
        "person_id": "jss_82r_1ct_AAA",
        "referent_role": "third_person",
        "quote": "繕幼有志尚，以雅正知名。起家梁宣惠武陵王法曹參軍。承聖中，授中書侍郎，掌東宮管記。江陵陷，繕微服遁還京師。紹泰元年，除司徒右長史，御史中丞，以父任所終，固辭不就。高祖引繕為司徒司馬，遷給事黃門侍郎、領步兵校尉、通直散騎常侍，兼侍中。永定元年，遷侍中。時留異擁割東陽，新安人向文政與異連結，因據本郡，朝廷以繕為貞威將軍、新安太守。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-chenshu-023-lushan-complete:p003:r0113",
        "paragraph_id": "c-chenshu-023-lushan-complete:p003",
        "start": 113,
        "end": 114,
        "surface": "父",
        "person_id": "jss_82r_1ct_AAA",
        "referent_role": "third_person",
        "quote": "世祖嗣位，徵為太子中庶子，領步兵校尉，掌東宮管記。繕儀表端麗，進退閑雅，世祖使太子諸王咸取則焉。其趨步躡履，皆令習繕規矩。除尚書吏部郎中，步兵如故，仍侍東宮。陳寶應平後，出為貞毅將軍、建安太守。秩滿，為散騎常侍、御史中丞，猶以父之所終，固辭，不許，乃權換廨宇徙居之。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-chenshu-023-lushan-complete:p003:r0039",
        "paragraph_id": "c-chenshu-023-lushan-complete:p003",
        "start": 39,
        "end": 41,
        "surface": "太子",
        "person_id": "2mj_6rl_6xs",
        "referent_role": "third_person",
        "quote": "世祖嗣位，徵為太子中庶子，領步兵校尉，掌東宮管記。繕儀表端麗，進退閑雅，世祖使太子諸王咸取則焉。其趨步躡履，皆令習繕規矩。除尚書吏部郎中，步兵如故，仍侍東宮。陳寶應平後，出為貞毅將軍、建安太守。秩滿，為散騎常侍、御史中丞，猶以父之所終，固辭，不許，乃權換廨宇徙居之。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-chenshu-023-lushan-complete:p004:r0031",
        "paragraph_id": "c-chenshu-023-lushan-complete:p004",
        "start": 31,
        "end": 33,
        "surface": "太子",
        "person_id": "icd_mkz_d9n_A",
        "referent_role": "third_person",
        "quote": "太建初，遷度支尚書、侍中、太子詹事，行東宮事，領揚州大中正。及太子親蒞庶政，解行事，加散騎常侍，改加侍中。遷尚書右僕射，尋遷左僕射，參掌選事，侍中如故。更為尚書僕射，領前將軍。重授左僕射，領揚州大中正，別敕令與徐陵等七人參議政事。十二年卒，時年六十三。贈侍中、特進、金紫光祿大夫，諡曰安子。太子以繕東宮舊臣，特賜祖奠。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-chenshu-023-lushan-complete:p004:r0145",
        "paragraph_id": "c-chenshu-023-lushan-complete:p004",
        "start": 145,
        "end": 147,
        "surface": "太子",
        "person_id": "icd_mkz_d9n_A",
        "referent_role": "third_person",
        "quote": "太建初，遷度支尚書、侍中、太子詹事，行東宮事，領揚州大中正。及太子親蒞庶政，解行事，加散騎常侍，改加侍中。遷尚書右僕射，尋遷左僕射，參掌選事，侍中如故。更為尚書僕射，領前將軍。重授左僕射，領揚州大中正，別敕令與徐陵等七人參議政事。十二年卒，時年六十三。贈侍中、特進、金紫光祿大夫，諡曰安子。太子以繕東宮舊臣，特賜祖奠。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-chenshu-023-lushan-complete:p005:r0022",
        "paragraph_id": "c-chenshu-023-lushan-complete:p005",
        "start": 22,
        "end": 23,
        "surface": "父",
        "person_id": "jss_82r_1ct_AAAA",
        "referent_role": "third_person",
        "quote": "繕子辯惠，年數歲，詔引入殿內，辯惠應對進止有父風，高宗因賜名辯惠，字敬仁云。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-chenshu-023-lushan-complete:p006:r0001",
        "paragraph_id": "c-chenshu-023-lushan-complete:p006",
        "start": 1,
        "end": 2,
        "surface": "兄",
        "person_id": "jss_82r_1ct_AAAB",
        "referent_role": "third_person",
        "quote": "繕兄子見賢，亦方雅，高宗為揚州牧，乃以為治中從事史，深被知遇。歷給事黃門侍郎，長沙鄱陽二王長史，帶尋陽太守，少府卿。太建十年卒，時年五十。贈廷尉卿，諡曰平子。",
        "note": "依本段敘事、稱謂及語者受者定。"
      }
    ],
