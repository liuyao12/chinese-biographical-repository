      "evidence": [
        {
          "work_id": "w-chenshu",
          "book_id": "b-chenshu-017",
          "chapter_id": "c-chenshu-017-wangtong-complete",
          "source_id": "s-chenshu-017-wangtong-complete-ws1544244",
          "paragraph_id": "c-chenshu-017-wangtong-complete:p004",
          "quote": "江陵陷，敬帝承制以通為吏部尚書。紹泰元年，加侍中，尚書如故。尋為尚書右僕射，吏部如故。高祖受禪，遷左僕射，侍中如故。文帝嗣位，領太子少傅。天康元年，為翊右將軍、右光祿大夫，量置佐史。廢帝即位，號安右將軍，又領南徐州大中正。太建元年，遷左光祿大夫。六年，加特進，侍中、將軍、光祿、佐史嵭如故。未拜卒，時年七十二。詔贈本官，諡曰成，葬日給鼓吹一部。弟質、弟固各有傳。",
          "person_mention_id": "c-chenshu-017-wangtong-complete:p004:m0009"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "所見原官稱，未載全任期。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
