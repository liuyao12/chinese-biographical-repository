    {
      "id": "le-song044-digital-35-2dj_m53_6zg",
      "person_id": "2dj_m53_6zg",
      "event_type": "death",
      "source_term": "並即大憲",
      "date_expression": null,
      "source_anchor": {
        "paragraph_id": "c-songshu-044-xiehui-digital:p014",
        "start": 120,
        "end": 124,
        "surface": "並即大憲"
      },
      "evidence": [
        {
          "work_id": "w-songshu",
          "book_id": "b-songshu-044",
          "source_id": "s-songshu-044-xiehui-digital-ws1746033",
          "chapter_id": "c-songshu-044-xiehui-digital",
          "paragraph_id": "c-songshu-044-xiehui-digital:p014",
          "quote": "禍福無門，逆順有數，天道微於影響，人事鑒於前圖，未有蹈義而福不延，從惡而禍不至也。故智計之士，審敗以立功，守正之臣，臨難以全節。徐羡之、傅亮、謝晦，安忍鴆殺，獲罪於天，名教所極，政邢所取，已遠暴四海，宣於聖詔。羨之父子、亮及晦息，電斷之初，並即大憲。復王室之讎，攄義夫之憤，國典澄明，人神感悅。三姓同罪，既擒其二，晦之室屬，縲仆獄戶，苟幽明所怨，孤根易拔，以順討逆，雖厚必崩。然歸死難圖，獸困則噬，是以爰整其旅，用為過防。京師之眾，天下雲集，士練兵精，大號響震。",
          "person_mention_id": "c-songshu-044-xiehui-digital:p014:m0110"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "尚書符敘傅亮等伏法，前文另記晦為亮舉哀。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    },
    {
      "id": "le-song044-digital-75-f2z_47w_81j",
      "person_id": "f2z_47w_81j",
      "event_type": "death",
      "source_term": "投水死",
      "date_expression": null,
      "source_anchor": {
        "paragraph_id": "c-songshu-044-xiehui-digital:p034",
        "start": 68,
        "end": 71,
        "surface": "投水死"
      },
      "evidence": [
        {
          "work_id": "w-songshu",
          "book_id": "b-songshu-044",
          "source_id": "s-songshu-044-xiehui-digital-ws1746033",
          "chapter_id": "c-songshu-044-xiehui-digital",
          "paragraph_id": "c-songshu-044-xiehui-digital:p034",
          "quote": "初，河東人商玄石為晦參軍，晦為逆，玄石密欲推西人庾田夫及到彥之從弟為主，田夫等不敢許。玄石知獨謀不立，遂為晦領幢。事既平，恨本心之不遂，投水死。太祖嘉之，以其子懷福為衡陽王義季右軍參軍督護。晦走，左右皆棄之，唯有延陵蓋追隨不舍。太祖嘉之，後以蓋為長沙王義欣鎮軍功曹督護。",
          "person_mention_id": "c-songshu-044-xiehui-digital:p034:m0043"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "商玄石投水死，非同段庾田夫。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    },
    {
      "id": "le-song044-digital-executed-aa6_83c_juy_AAAA",
      "person_id": "aa6_83c_juy_AAAA",
      "event_type": "death",
      "source_term": "並伏誅",
      "date_expression": null,
      "source_anchor": {
        "paragraph_id": "c-songshu-044-xiehui-digital:p033",
        "start": 88,
        "end": 91,
        "surface": "並伏誅"
      },
      "evidence": [
        {
          "work_id": "w-songshu",
          "book_id": "b-songshu-044",
          "source_id": "s-songshu-044-xiehui-digital-ws1746033",
          "chapter_id": "c-songshu-044-xiehui-digital",
          "paragraph_id": "c-songshu-044-xiehui-digital:p033",
          "quote": "周超既降，到彥之以參府事，劉粹遣參軍沈敞之告彥之沙橋之敗，事由周超，彥之乃執之。先繫㬭等，猶未即戮，於是與晦、遯、兄子世基、世猷及同黨孔延秀、周超、費愔、竇應期、蔣虔、嚴千斯等並伏誅。世基，絢之子也，有才氣。臨死為連句詩曰：「偉哉橫海鱗，壯矣垂天翼。一旦失風水，翻為螻蟻食。」晦續之曰：「功遂侔昔人，保退無智力。既涉太行險，斯路信難陟。」晦死時，年三十七。庾登之、殷道鸞、何承天並皆原免。",
          "person_mention_id": "c-songshu-044-xiehui-digital:p033:m0053"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "此數位本列伏誅者；㬭承「先繫㬭等，猶未即戮」，其後乃與晦等同誅。世平、紹未在此具名逐敘。",
      "reviewer": "Codex（AI代理）",
      "model": null,
      "human_reviewed": false
    },
