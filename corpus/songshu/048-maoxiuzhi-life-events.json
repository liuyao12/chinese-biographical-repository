    {
      "id": "le-song048-maoxiuzhi-毛瑾",
      "person_id": "d9b_790_9f0_AB",
      "event_type": "death",
      "source_term": "殺",
      "source_anchor": {
        "paragraph_id": "c-songshu-048-maoxiuzhi:p003",
