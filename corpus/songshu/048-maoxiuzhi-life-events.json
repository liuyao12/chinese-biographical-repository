    {
      "id": "le-song048-maoxiuzhi-王鎮惡",
      "person_id": "quq_d6y_akf",
      "event_type": "death",
      "source_term": "死",
      "source_anchor": {
        "paragraph_id": "c-songshu-048-maoxiuzhi:p009",
