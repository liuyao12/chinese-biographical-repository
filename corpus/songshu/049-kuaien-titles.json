      "evidence": [
        {
          "work_id": "w-songshu",
          "book_id": "b-songshu-049",
          "chapter_id": "c-songshu-049-kuaien",
          "source_id": "s-songshu-049-kuaien-ws2118585",
          "paragraph_id": "c-songshu-049-kuaien:p003",
          "quote": "高祖西征劉毅，恩與王鎮惡輕軍襲江陵，事在鎮惡傳。以本官為太尉長兼行參軍，領眾二千，隨益州刺史朱齡石伐蜀。至彭模，恩所領居前，大戰，自朝至日昃，勇氣益奮，賊破走。進平成都，擢為行參軍，改封北至縣五等男。高祖伐司馬休之及魯宗之，恩與建威將軍徐逵之前進。逵之敗沒，恩陳于隄下，宗之子軌乘勝擊恩，矢下如雨，呼聲震地，恩整厲將士，置陣堅嚴。軌屢衝之不動，知不可攻，乃退。高祖善其能將軍持重。江陵平定，復追魯軌於石城。軌棄城走，恩追至襄陽，宗之奔羌，恩與諸將追討至魯陽關乃還。",
          "person_mention_id": "c-songshu-049-kuaien:p003:m0007"
        }
      ],
