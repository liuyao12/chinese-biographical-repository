    "person_reference_occurrences": [
      {
        "id": "c-songshu-050-yuan-family-continuations:p001:r0022",
        "paragraph_id": "c-songshu-050-yuan-family-continuations:p001",
        "start": 22,
        "end": 23,
        "surface": "妻",
        "person_id": "l1u_gad_qtx",
        "referent_role": "third_person",
        "quote": "孝建元年，南郡王義宣反，兗州刺史徐遺寶，護之妻弟也，遠相連結，與護之書，勸使同逆。護之馳使以聞。遺寶時戍湖陸，護之留子恭祖守歷城，自率步騎襲遺寶。道經鄒山，破其別戍。未至湖陸六十里，遺寶焚城西走。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-songshu-050-yuan-family-continuations:p003:r0034",
        "paragraph_id": "c-songshu-050-yuan-family-continuations:p003",
        "start": 34,
        "end": 36,
        "surface": "太宗",
        "person_id": "cti_o52_4nz",
        "referent_role": "third_person",
        "quote": "子承祖嗣。承祖卒，子顯宗嗣。齊受禪，國除。護之次子恭祖，勇果有父風。太宗泰始初，以軍功為梁、南秦二州刺史。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-songshu-050-yuan-family-continuations:p004:r0016",
        "paragraph_id": "c-songshu-050-yuan-family-continuations:p004",
        "start": 16,
        "end": 17,
        "surface": "母",
        "person_id": "v6w_es3_yke",
        "referent_role": "third_person",
        "quote": "遵子閬，元嘉中，為員外散騎侍郎。母墓為東阿寺道人曇洛等所發，閬與弟殿中將軍閎共殺曇洛等五人，詣官歸罪，見原。閬，大明三年，自義興太守為寧朔將軍、兗州刺史，為竟陵王誕所殺。追贈征虜將軍，刺史如故。",
        "note": "依本段敘事、稱謂及語者受者定。"
      }
    ]
  },
