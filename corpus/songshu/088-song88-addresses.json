      },
      "source_term": "冀州刺史，鎮歷城",
      "source_anchor": {
        "paragraph_id": "c-songshu-088-song88:p002",
        "start": 12,
        "end": 20,
        "surface": "冀州刺史，鎮歷城"
      },
      "date_expression": "景和元年",
      "status": "source_attested",
      "evidence": [
        {
          "work_id": "w-songshu",
          "book_id": "b-songshu-088",
          "chapter_id": "c-songshu-088-song88",
          "source_id": "s-songshu-088-song88-ws2069210",
          "paragraph_id": "c-songshu-088-song88:p002",
          "quote": "景和元年，出為寧朔將軍、冀州刺史，鎮歷城。泰始二年，進號輔國將軍，又進號征虜將軍。時徐州刺史薛安都同逆，上即還道固本號為徐州代之。道固不受命，遣子景微、軍主傅靈越率眾赴安都。既而為土人起義所攻，屢戰失利，閉門自守。會四方平定，上遣使宣慰，道固奉詔歸順。先是與沈文秀共引虜，虜既至，固守距之，因被圍逼。虜每進，輒為道固所摧。三年，以為都督冀青兗幽并五州諸軍事、前將軍、冀州刺史，加節，又進號平北將軍。其年，為虜所陷，被送桑乾，死於虜中。",
          "person_mention_id": "c-songshu-088-song88:p002:m0055"
        }
      ],
      "interpretation_note": "本傳明記軍鎮所在地。",
      "reviewer": "Codex（AI代理）",
      "human_reviewed": false,
      "model": null,
      "qualifiers": {
        "source_position": "冀州刺史"
      }
    },
