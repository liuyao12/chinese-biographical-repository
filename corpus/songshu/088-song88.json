          "end": 51,
          "surface": "焦恭",
          "kind": "person",
          "person_id": "lhq_hig_joo",
          "identification_status": "contextual_provisional",
          "interpretation_note": "破古冢得玉鎧者。"
        },
        {
          "id": "c-songshu-088-song88:p001:m0059",
          "start": 59,
          "end": 61,
          "surface": "道固",
          "kind": "person",
          "person_id": "23q_wcp_hny",
          "identification_status": "contextual_provisional",
          "interpretation_note": "承傳首，檢得焦恭所得玉鎧。"
        },
        {
