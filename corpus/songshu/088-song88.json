          "kind": "person",
          "person_id": "23q_wcp_hny",
          "identification_status": "contextual_provisional",
          "interpretation_note": "傳首全名；下文任冀州刺史，鎮歷城。"
        },
        {
          "id": "c-songshu-088-song88:p001:m0049",
