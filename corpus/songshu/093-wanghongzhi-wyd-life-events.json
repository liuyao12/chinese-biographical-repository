              "source_position": {
                "revision_id": "cbr-ai-transcription-sha256:b7170dce6be9a5980d5373556ef7d70d8234d1f7af16af3aa30bf21f6e707b20",
                "source_layer": "received_biography",
                "column_projection": [
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 1,
                    "start": 0,
                    "end": 21,
                    "text": "王𢎞之字方平琅邪臨沂人宣訓衞尉鎮之弟也少孤"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 2,
                    "start": 0,
                    "end": 21,
                    "text": "貧為外祖徵士何淮所撫育從叔獻之及太原王恭並"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 3,
                    "start": 0,
                    "end": 21,
                    "text": "貴重之晉安帝隆安中為琅邪王中軍參軍遷司徒主"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 4,
                    "start": 0,
                    "end": 21,
                    "text": "簿家貧而性好山水求為烏程令尋以病歸桓𤣥輔晉"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 5,
                    "start": 0,
                    "end": 21,
                    "text": "桓謙以為衞軍參軍時琅邪殷仲文還姑孰祖送傾朝"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 6,
                    "start": 0,
                    "end": 21,
                    "text": "謙要𢎞之同行答曰凡祖離送別必在有情下官與殷"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 7,
                    "start": 0,
                    "end": 21,
                    "text": "風馬不接無緣扈從謙貴其言每隨兄鎮之之安成郡"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 8,
                    "start": 0,
                    "end": 21,
                    "text": "𢎞之解職同行荊州刺史桓偉請為南蠻長史義熙初"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 9,
                    "start": 0,
                    "end": 21,
                    "text": "何無忌又請為右軍司馬高祖命為徐州治中從事史"
                  },
                  {
                    "pdf_page": 9,
                    "half": "左",
                    "column_from_right": 10,
                    "start": 0,
                    "end": 21,
                    "text": "除員外散騎常侍並不就家在會稽上虞從兄敬𢎞為"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 1,
                    "start": 0,
                    "end": 21,
                    "text": "吏部尚書奏曰聖明司契載德惟新垂鑒仄微表揚隱"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 2,
                    "start": 0,
                    "end": 21,
                    "text": "介默語仰風荒遐傾首前員外散騎常侍琅邪王𢎞之"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 3,
                    "start": 0,
                    "end": 21,
                    "text": "恬漠丘園放心居逸前衞將軍參軍武昌郭希林素履"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 4,
                    "start": 0,
                    "end": 21,
                    "text": "純潔嗣徽前武並擊壤聖朝未蒙表飾宜加旌聘賁于"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 5,
                    "start": 0,
                    "end": 21,
                    "text": "丘園以彰止遜之美以祛動求之累臣愚謂𢎞之可太"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 6,
                    "start": 0,
                    "end": 21,
                    "text": "子庶子希林可著作郎即徵𢎞之為庶子不就太祖即"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 7,
                    "start": 0,
                    "end": 21,
                    "text": "位敬𢎞為左僕射又陳𢎞之高行表於初筮苦節彰於"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 8,
                    "start": 0,
                    "end": 21,
                    "text": "莫年今內外晏然當修太平之化宜招空谷以敦沖退"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 9,
                    "start": 0,
                    "end": 21,
                    "text": "之美元嘉四年徵為通直散騎常侍又不就敬𢎞嘗解"
                  },
                  {
                    "pdf_page": 10,
                    "half": "右",
                    "column_from_right": 10,
                    "start": 0,
                    "end": 21,
                    "text": "貂裘與之即着以采藥性好釣上虞江有一處名三石"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 1,
                    "start": 0,
                    "end": 21,
                    "text": "頭𢎞之常垂綸於此經過者不識之或問漁師得魚賣"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 2,
                    "start": 0,
                    "end": 21,
                    "text": "不𢎞之曰亦自不得得亦不賣日夕載魚入上虞郭經"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 3,
                    "start": 0,
                    "end": 21,
                    "text": "親故門各以一兩頭置門內而去始寧汰川有佳山水"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 4,
                    "start": 0,
                    "end": 21,
                    "text": "𢎞之又依巖築室謝靈運顏延之並相欽重靈運與廬"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 5,
                    "start": 0,
                    "end": 21,
                    "text": "陵王義真牋曰會境既豐山水是以江左嘉遁並多居"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 6,
                    "start": 0,
                    "end": 21,
                    "text": "之但季世慕榮幽棲者寡或復才為時求弗獲從志至"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 7,
                    "start": 0,
                    "end": 21,
                    "text": "若王𢎞之拂衣歸耕踰歷三紀孔淳之隱約窮岫自始"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 8,
                    "start": 0,
                    "end": 21,
                    "text": "迄今阮萬齡辭事就閒纂成先業浙河之外棲遲山澤"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 9,
                    "start": 0,
                    "end": 21,
                    "text": "如斯而已既遠同羲唐亦激貪厲競殿下愛素好古常"
                  },
                  {
                    "pdf_page": 10,
                    "half": "左",
                    "column_from_right": 10,
                    "start": 0,
                    "end": 21,
                    "text": "若布衣每憶昔聞虛想巖穴若遣一介有以相存真可"
                  },
                  {
                    "pdf_page": 11,
                    "half": "右",
                    "column_from_right": 1,
                    "start": 0,
                    "end": 21,
                    "text": "謂千載盛美也𢎞之四年卒時年六十三顏延之欲為"
                  },
                  {
                    "pdf_page": 11,
                    "half": "右",
                    "column_from_right": 2,
                    "start": 0,
                    "end": 21,
                    "text": "作誄書與𢎞之子曇生曰君家高世之節有識歸重豫"
                  },
                  {
                    "pdf_page": 11,
                    "half": "右",
                    "column_from_right": 3,
                    "start": 0,
                    "end": 21,
                    "text": "染豪翰所應載述況僕託慕末風竊以敘德為事但恨"
                  },
                  {
                    "pdf_page": 11,
                    "half": "右",
                    "column_from_right": 4,
                    "start": 0,
                    "end": 10,
                    "text": "短筆不足書美誄竟不就"
                  }
                ]
              }
            }
          ],
