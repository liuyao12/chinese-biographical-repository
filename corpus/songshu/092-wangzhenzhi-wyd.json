      ],
      "source_position": {
        "revision_id": "cbr-ai-transcription-sha256:316503bbf73485e119ac53b41c67206cb3224497dff86f5264f4b3cf3b0d6af6",
        "source_layer": "received_biography",
        "column_projection": [
          {
            "pdf_page": 92,
            "half": "左",
            "leaf": "三上",
            "column_from_right": 4,
            "start": 5,
            "end": 21,
            "text": "出為使持節都督交廣二州諸軍事建威"
          },
          {
            "pdf_page": 92,
            "half": "左",
            "leaf": "三上",
            "column_from_right": 5,
            "start": 0,
            "end": 21,
            "text": "將軍平越中郎將廣州刺史高祖謂人曰王鎮之少著"
          },
          {
            "pdf_page": 92,
            "half": "左",
            "leaf": "三上",
            "column_from_right": 6,
            "start": 0,
            "end": 21,
            "text": "清績必將繼美吳隱之嶺南之弊非此不康也在鎮不"
          },
          {
            "pdf_page": 92,
            "half": "左",
            "leaf": "三上",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "受俸祿蕭然無所營去官之日不異始至高祖初建相"
          },
          {
            "pdf_page": 92,
            "half": "左",
            "leaf": "三上",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "國府以為諮議參軍領録事善於吏職嚴而不殘遷宋"
          },
          {
            "pdf_page": 92,
            "half": "左",
            "leaf": "三上",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "臺祠部尚書高祖踐阼鎮之以脚患自陳出為輔國將"
          },
          {
            "pdf_page": 92,
            "half": "左",
            "leaf": "三上",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "軍琅邪太守遷宣訓衞尉領本州大中正永初三年卒"
          },
          {
            "pdf_page": 93,
            "half": "右",
            "leaf": "三下",
            "column_from_right": 1,
            "start": 0,
            "end": 13,
            "text": "官時年六十六弟𢎞之在隱逸傳"
          }
        ]
      }
    }
  ],
