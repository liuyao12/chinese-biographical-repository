          "end": 3,
          "surface": "薛安都",
          "kind": "person",
          "person_id": "u3k_51j_4ul_A",
          "identification_status": "contextual_provisional",
          "interpretation_note": "傳首明名及籍貫。"
        },
        {
          "id": "c-songshu-088-xueandu:p001:m0024",
          "start": 24,
          "end": 25,
          "surface": "廣",
          "kind": "person",
          "person_id": "u3k_51j_4ul",
          "identification_status": "contextual_provisional",
          "interpretation_note": "薛安都之父，稱廣。"
        }
      ]
    },
    {
      "id": "c-songshu-088-xueandu:p002",
      "text": "道固遣子景徵、傅靈越領眾，並應安都。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": [
