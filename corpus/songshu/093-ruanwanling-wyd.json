        "column_projection": [
          {
            "pdf_page": 11,
            "half": "右",
            "column_from_right": 7,
            "start": 0,
            "end": 21,
            "text": "阮萬齡陳留尉氏人也祖思曠左光祿大夫父寧黃門"
          },
          {
            "pdf_page": 11,
            "half": "右",
            "column_from_right": 8,
            "start": 0,
            "end": 21,
            "text": "侍郎萬齡少知名自通直郎為孟昶建威長史時袁豹"
          },
          {
            "pdf_page": 11,
            "half": "右",
            "column_from_right": 9,
            "start": 0,
            "end": 21,
            "text": "江夷相係為昶司馬時人謂昶府有三素望萬齡家在"
          },
          {
            "pdf_page": 11,
            "half": "右",
            "column_from_right": 10,
            "start": 0,
            "end": 21,
            "text": "會稽剡縣頗有素情永初末自侍中解職東歸徵為秘"
          },
          {
            "pdf_page": 11,
            "half": "左",
            "column_from_right": 1,
            "start": 0,
            "end": 21,
            "text": "書監加給事中不就尋除左民尚書復起應命遷太常"
          },
          {
            "pdf_page": 11,
            "half": "左",
            "column_from_right": 2,
            "start": 0,
            "end": 21,
            "text": "出為湘州刺史在州無政績還為東陽太守又被免復"
          },
          {
            "pdf_page": 11,
            "half": "左",
            "column_from_right": 3,
            "start": 0,
            "end": 21,
            "text": "為散騎常侍金紫光祿大夫元嘉二十五年卒時年七"
          },
          {
            "pdf_page": 11,
            "half": "左",
            "column_from_right": 4,
            "start": 0,
            "end": 2,
            "text": "十二"
          }
        ]
      }
    }
