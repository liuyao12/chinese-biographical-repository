    {
      "id": "name-song052-literal-011",
      "person_id": "u9s_w6j_8mc_AEC",
      "surname": "桓",
      "ming": "修",
      "additional_names": [],
      "chapter_id": "c-songshu-052-xiejingren",
      "paragraph_id": "c-songshu-052-xiejingren:p003",
      "person_mention_id": "c-songshu-052-xiejingren:p003:m0003",
      "quote": "高祖為桓修撫軍中兵參軍嘗詣景仁諮事景仁與語悅之因留高祖共食食未辦而景仁為𤣥所召𤣥性促急俄頃之間騎詔續至高祖屢求去景仁不許曰主上見待要應有方我欲與客共食豈當不得待竟安坐飽食然後應召高祖甚感之嘗謂景仁是太傅安孫",
      "note": "明示全名；本條只保存本源姓名成分，不由家族ID、標籤或別源補字。",
      "status": "editorial_provisional",
      "human_reviewed": false,
      "model": null
    },
    {
      "id": "name-song052-literal-012",
      "person_id": "df6_0d0_a2f",
      "surname": null,
      "ming": "遵",
      "additional_names": [],
      "chapter_id": "c-songshu-052-xiejingren",
      "paragraph_id": "c-songshu-052-xiejingren:p004",
      "person_mention_id": "c-songshu-052-xiejingren:p004:m0048",
      "quote": "及平京邑入鎮石頭景仁與百僚同見高祖高祖目之曰此名公孫也謂景仁曰承制府須記室參軍今當相屈以為大將軍武陵王遵記室參軍仍為從事中郎遷司徒左長史出為高祖鎮軍司馬領晉陵太守復為車騎司馬",
      "note": "爵名非姓名，姓未在此錨書出；本條只保存本源姓名成分，不由家族ID、標籤或別源補字。",
      "status": "editorial_provisional",
      "human_reviewed": false,
      "model": null
    },
    {
      "id": "name-song052-literal-013",
      "person_id": "a59_2c3_a2e",
      "surname": "劉",
      "ming": "毅",
      "additional_names": [],
      "chapter_id": "c-songshu-052-xiejingren",
      "paragraph_id": "c-songshu-052-xiejingren:p005",
      "person_mention_id": "c-songshu-052-xiejingren:p005:m0025",
      "quote": "義熙五年高祖以内難既寧思𢎞外略將伐鮮卑朝議皆謂不可劉毅時鎮姑熟固止高祖以為苻堅侵境謝太傅猶不自行宰相逺出傾動根本景仁獨曰公建桓文之烈應天人之心匡復皇祚芟夷姦逆雖業高振古而徳刑未孚宜推亡固存廣樹威略鮮卑密邇疆甸屢犯邊垂伐罪弔民於是乎在平定之後養銳息徒然後觀兵洛汭修復園寑豈有坐長寇虜縱敵貽患者哉高祖納之及北伐大司馬琅邪王天子母弟屬當儲副高祖深以根本為憂轉景仁為大司馬司馬專總府任右衛將軍加給事中",
      "note": "明示全名；本條只保存本源姓名成分，不由家族ID、標籤或別源補字。",
      "status": "editorial_provisional",
      "human_reviewed": false,
      "model": null
    },
