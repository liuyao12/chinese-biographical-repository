      },
      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-songshu",
          "book_id": "b-songshu-047",
          "chapter_id": "c-songshu-047-liujingxuan",
          "source_id": "s-songshu-047-liujingxuan-ws2190557",
          "paragraph_id": "c-songshu-047-liujingxuan:p006",
          "quote": "玄既得志，害元顯，廢道子，以牢之為征東將軍、會稽太守。牢之與敬宣謀共襲玄，期以明旦。值爾日大霧，府門晚開，日旰，敬宣不至，牢之謂所謀已泄，率部曲向白洲，欲奔廣陵。而敬宣還京口迎家，牢之尋求不得，謂已為玄所擒，乃自縊死。敬宣奔喪，哭畢，即渡江就司馬休之、高雅之等，俱奔洛陽，往來長安，各以子弟為質，求救於姚興。興與之符信，令關東募兵，得數千人，復還至彭城間，收聚義故。玄遣孫無終討冀州刺史劉軌，軌要敬宣、雅之等共據山陽破之，不剋。又進昌平澗，戰不利，眾各離散，乃俱奔鮮卑慕容德。",
          "person_mention_id": "c-songshu-047-liujingxuan:p006:m0006"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "按同段人物與次第核所屬卒事。",
