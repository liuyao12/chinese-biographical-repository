      "date_expression": null,
      "evidence": [
        {
          "work_id": "w-songshu",
          "book_id": "b-songshu-047",
          "chapter_id": "c-songshu-047-liujingxuan",
          "source_id": "s-songshu-047-liujingxuan-ws2190557",
          "paragraph_id": "c-songshu-047-liujingxuan:p007",
          "quote": "敬宣素曉天文，知必有興復晉室者。尋夢丸土服之，既覺，喜曰：「丸者桓也。桓既吞矣，吾復本土乎。」乃結青州大姓諸崔、封，并要鮮卑大帥免逵，謀滅德，推休之為主，剋日垂發。時劉軌為德司空，大被委任，雅之又欲要軌，敬宣曰：「此公年老，吾觀其有安齊志，必不動，不可告也。」雅之以為不然，遂告軌，軌果不從。謀頗泄，相與殺軌而去。至淮、泗間，會高祖平京口，手書召敬宣，左右疑其詐，敬宣曰：「吾固知其然矣。下邳不誘我也。」即便馳還。既至京師，以敬宣為輔國將軍、晉陵太守，襲封武岡縣男。是歲，安帝元興三年也。",
          "person_mention_id": "c-songshu-047-liujingxuan:p007:m0083"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "按同段人物與次第核所屬卒事。",
