      "id": "le-song047-liuzhendao-苻弘祖",
      "person_id": "nix_nc9_m03",
      "event_type": "death",
      "source_term": "斬",
      "source_anchor": {
        "paragraph_id": "c-songshu-047-liuzhendao:p002",
