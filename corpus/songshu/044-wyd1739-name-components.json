    {
      "id": "name-song044-wyd-shangxuanshi",
      "person_id": "f2z_47w_81j",
      "surname": "商",
      "ming": "玄石",
      "additional_names": [],
      "chapter_id": "c-songshu-044-wyd1739-xiehui",
      "paragraph_id": "c-songshu-044-wyd1739-xiehui:p016",
      "person_mention_id": "c-songshu-044-wyd1739-xiehui:p016:m0389",
      "quote": "方以自牧非矜石之圜照孰違禍以取福著殷鑒於自古豈獨歎於季叔能安親而揚名諒見稱於先哲保歸全而終孝傷在余而皆缺辱歷世之平素忽盛滿而傾滅惟烝嘗與灑掃痛一朝而永絕問其誰而為之冀孤人之險戾豈有踰於丘山雖萬死其何補羌無面於衡閻親朋交兮平義雖履尚兮不一隆兮好兮情寄俱憚耕兮從祿覩世道兮艱蔽規志局兮功名每謂之兮為易今定諡兮闔棺聽明智兮昔議雖待盡兮為恥嗜厚顏兮靡寘長揖兮數子謝爾兮明智百齡兮浮促終焉兮罔克臥盡兮斧斤理命兮同得世安彼兮非此豈曉分兮辨惑御莊生之達言請承風以為則周超旣降到彦之以參府事劉粹遣參軍沈敞之告彦之沙橋之敗事由周超彦之乃執之先繫檻等猶未卽戮於是與晦遯兄子世基世猷及同黨庾登之孔延秀周超費愔竇應期蔣虔嚴千斯等並伏誅世基絢之子也有才氣臨死為連句詩曰偉哉橫海鱗壯矣垂天翼一旦失風水翻為螻蟻食晦續之曰功遂侔昔人保退無智力旣涉太行險斯路信難陟晦死時年三十七庾登之殿道鸞何承天並皆原免初河東人商玄石為晦參軍晦為逆玄石密欲推西人庾田夫及到彦之從弟為主田夫等",
      "status": "contextual_provisional",
      "human_reviewed": false,
      "model": null,
