  "paragraphs": [
    {
      "id": "c-songshu-092-duhuidu:p001",
      "text": "杜慧度，交阯朱䳒人也。本屬京兆。曾祖元，為寧浦太守，遂居交阯。",
      "text_layer": "received_chapter",
      "annotation_status": "reviewed",
