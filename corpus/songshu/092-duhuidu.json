    "person_reference_occurrences": [
      {
        "id": "c-songshu-092-duhuidu:p003:r0000",
        "paragraph_id": "c-songshu-092-duhuidu:p003",
        "start": 0,
        "end": 2,
        "surface": "高祖",
        "person_id": "3qs_nqa_ioa_AAA",
        "referent_role": "third_person",
        "quote": "高祖踐阼，進號輔國將軍。其年，率文武萬人南討林邑，所殺過半，前後被抄略，悉得還本。林邑乞降，輸生口、大象、金銀、古貝等，乃釋之。遣長史江悠奉表獻捷。",
        "note": "依本段敘事、稱謂及語者受者定。"
      },
      {
        "id": "c-songshu-092-duhuidu:p004:r0079",
        "paragraph_id": "c-songshu-092-duhuidu:p004",
        "start": 79,
        "end": 81,
        "surface": "少帝",
        "person_id": "0ab_f5d_337",
        "referent_role": "third_person",
        "quote": "慧度布衣蔬食，儉約質素，能彈琴，頗好莊、老。禁斷淫祀，崇修學校，歲荒民饑，則以私祿賑給。為政纖密，有如治家，由是威惠沾洽，姦盜不起，乃至城門不夜閉，道不拾遺。少帝景平元年，卒，時年五十，追贈左將軍。",
        "note": "依本段敘事、稱謂及語者受者定。"
      }
    ],
    "source_reading_cases": [
      {
        "id": "c-songshu-092-duhuidu:received_sentence1-0",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "杜慧度，交阯朱䳒人也。",
        "reading": "杜慧度籍交阯朱䳒。",
        "note": "杜慧度籍交阯朱䳒。",
        "paragraph_id": "c-songshu-092-duhuidu:p001",
        "start_codepoint": 0,
        "end_codepoint": 11,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence1-11",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "本屬京兆。",
        "reading": "家本京兆。",
        "note": "家本京兆。",
        "paragraph_id": "c-songshu-092-duhuidu:p001",
        "start_codepoint": 11,
        "end_codepoint": 16,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence1-16",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "曾祖元，為寧浦太守，遂居交阯。",
        "reading": "曾祖杜元仕寧浦太守後徙居交阯。",
        "note": "曾祖杜元仕寧浦太守後徙居交阯。",
        "paragraph_id": "c-songshu-092-duhuidu:p001",
        "start_codepoint": 16,
        "end_codepoint": 31,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-0",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "慧度，瑗第五子也。",
        "reading": "慧度為瑗第五子。",
        "note": "慧度為瑗第五子。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 0,
        "end_codepoint": 9,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-9",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "初為州主簿，流民督護，遷九真太守。",
        "reading": "初任州主簿、流民督護、九真太守。",
        "note": "初任州主簿、流民督護、九真太守。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 9,
        "end_codepoint": 26,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-26",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "瑗卒，府州綱佐以交土接寇，不宜曠職，共推慧度行州府事，辭不就。",
        "reading": "瑗歿，僚佐推行州府，辭不就。",
        "note": "瑗歿，僚佐推行州府，辭不就。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 26,
        "end_codepoint": 57,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-57",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "七年，除使持節、督交州諸軍事、廣武將軍、交州刺史。",
        "reading": "義熙七年授交州刺史等。",
        "note": "義熙七年授交州刺史等。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 57,
        "end_codepoint": 82,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-82",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "詔書未至，其年春，盧循襲破合浦，徑向交州。",
        "reading": "詔未至，春盧循已進攻。",
        "note": "詔未至，春盧循已進攻。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 82,
        "end_codepoint": 103,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-103",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "慧度乃率文武六千人距循於石碕，交戰，禽循長史孫建之。",
        "reading": "慧度領軍六千，俘長史孫建之。",
        "note": "慧度領軍六千，俘長史孫建之。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 103,
        "end_codepoint": 129,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-129",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "循雖敗，餘黨猶有三千人，皆習練兵事，李遜子李弈、李脫等奔竄石碕，」盤結俚、獠，各有部曲。",
        "reading": "盧循餘黨三千，與其有關者含李弈、李脫；李遜子、子孫及李移諸本不同。",
        "note": "盧循餘黨三千，與其有關者含李弈、李脫；李遜子、子孫及李移諸本不同。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 129,
        "end_codepoint": 173,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-173",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "循知弈等與杜氏有怨，遣使招之，弈等引諸俚帥眾五六千人，受循節度。",
        "reading": "循招納與杜氏有怨者，共五六千。",
        "note": "循招納與杜氏有怨者，共五六千。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 173,
        "end_codepoint": 205,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-205",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "六月庚子，循晨造南津，命三軍入城乃食。",
        "reading": "六月庚子，循至南津。",
        "note": "六月庚子，循至南津。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 205,
        "end_codepoint": 224,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-224",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "慧度悉出宗族私財，以充勸賞。",
        "reading": "慧度散宗族私財為賞。",
        "note": "慧度散宗族私財為賞。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 224,
        "end_codepoint": 238,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-238",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "弟交阯太守慧期、九真太守章民並督率水步軍，慧度自登高艦，合戰，放火箭雉尾炬，步軍夾兩岸射之，循眾艦俱然，一時散潰，循中箭赴水死。",
        "reading": "交阯、九真二弟任郡守，與慧度合兵；循中矢赴水死。",
        "note": "交阯、九真二弟任郡守，與慧度合兵；循中矢赴水死。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 238,
        "end_codepoint": 302,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-302",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "斬循及父嘏，并循二子，親屬錄事參軍阮靜、中兵參軍羅農夫、李脫等，傳首京邑。",
        "reading": "續敘被斬者含循父嘏、循二子及屬下，與循先赴水之次序分清。",
        "note": "續敘被斬者含循父嘏、循二子及屬下，與循先赴水之次序分清。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 302,
        "end_codepoint": 339,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence2-339",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "封慧度龍編縣侯，食邑千戶。",
        "reading": "慧度封龍編縣侯，食邑一千戶。",
        "note": "慧度封龍編縣侯，食邑一千戶。",
        "paragraph_id": "c-songshu-092-duhuidu:p002",
        "start_codepoint": 339,
        "end_codepoint": 352,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence3-0",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "高祖踐阼，進號輔國將軍。",
        "reading": "宋武帝踐阼，進輔國將軍。",
        "note": "宋武帝踐阼，進輔國將軍。",
        "paragraph_id": "c-songshu-092-duhuidu:p003",
        "start_codepoint": 0,
        "end_codepoint": 12,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-092-duhuidu:received_sentence3-12",
        "kind": "received_sentence",
        "person_id": "b7k_v7g_vfe_*AB",
        "source_quote": "其年，率文武萬人南討林邑，所殺過半，前後被抄略，悉得還本。",
        "reading": "其年討林邑，被虜者得以還本。",
