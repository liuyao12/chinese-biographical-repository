        "evidence": [
          {
            "work_id": "w-songshu",
            "book_id": "b-songshu-045",
            "source_id": "s-songshu-045-wyd1739-liucui",
            "chapter_id": "c-songshu-045-wyd1739-liucui",
            "paragraph_id": "c-songshu-045-wyd1739-liucui:p005",
            "quote": "郎王弘車騎從事中郎江夏王義恭撫軍司馬河東太守仍遷振武將軍益州刺史長史費謙別駕張熙參軍楊德年等並聚斂與利而道濟委任之傷政害民民皆怨毒太祖聞之與道濟詔戒之曰聞卿在任未盡清省又頗為殖貨若萬有一此必宜改之比傳人情不政〓諸當以法御下深思自警以副本望道濟雖奉此旨政化如初有司馬飛龍者自稱晉之宗室晉末走仇池元嘉九年間道濟綏撫失和遂自仇池入緜竹煽動羣小得千餘人破巴興縣殺令王貞之進攻陰平陰平太守沈法興焚城遁走道濟遣軍擊飛龍斬之初道濟以五",
            "person_mention_id": "c-songshu-045-wyd1739-liucui:p005:m0052"
          },
          {
            "work_id": "w-songshu",
            "book_id": "b-songshu-045",
            "source_id": "s-songshu-045-wyd1739-liucui",
            "chapter_id": "c-songshu-045-wyd1739-liucui",
            "paragraph_id": "c-songshu-045-wyd1739-liucui:p006",
            "quote": "城人帛氏奴梁顯為參軍督護費謙固執不與遠方商人多至蜀土資貨或有直數百萬者謙等限布絲緜各不得過五十斤馬無善惡限蜀錢二萬府又立治一斷私民鼓鑄而貴賣鐵器商旅吁嗟百姓咸欲為亂氏奴旣懷恚忿因聚黨為賊盜其年七月道濟遣羅習為五城令氏奴等謀曰羅令是使君腹心而卿猶有作賊盜不止者一旦發露則為禍不測宜結要誓共相禁檢乃殺牛盟誓俄而氏奴及趙廣等唱曰官禁殺牛而村中公違法禁脫使羅令白使君錄吾徒更欲作賊則無餘類矣因詐言司馬殿下猶在陽泉山中若能共建大事",
            "person_mention_id": "c-songshu-045-wyd1739-liucui:p006:m0098"
          },
          {
            "work_id": "w-songshu",
            "book_id": "b-songshu-045",
            "source_id": "s-songshu-045-wyd1739-liucui",
            "chapter_id": "c-songshu-045-wyd1739-liucui",
            "paragraph_id": "c-songshu-045-wyd1739-liucui:p009",
            "quote": "戰皆失利十一月方明等復出戰破賊營焚其積聚賊黨江陽人楊孟子領千餘人屯城南道濟參軍梁儁之統南樓屢與孟子交言因投書曉以禍福要使入城孟子許諾入見道濟道濟大喜卽板為主簿遣子為任克期討賊趙廣知其謀孟子懼將所領奔晉原晉原太守文仲興拾合得二千餘人與孟子并力自固廣遣同黨袁玄子攻晉原為仲興所殺廣又遣帛氏奴攻之連戰仲興軍敗及孟子並死方明復出東門破賊三營斬首數百級賊雖敗已復還合方明復僞出北門仍回軍擊城東大營殺千餘人斬僞僕射蔡洽時天大霧方明等",
            "person_mention_id": "c-songshu-045-wyd1739-liucui:p009:m0035"
          },
          {
            "work_id": "w-songshu",
            "book_id": "b-songshu-045",
            "source_id": "s-songshu-045-wyd1739-liucui",
            "chapter_id": "c-songshu-045-wyd1739-liucui",
            "paragraph_id": "c-songshu-045-wyd1739-liucui:p010",
            "quote": "獲揚聲出東門而潛自北門出攻城北城西諸營賊衆大潰於是奔散道養收合得七千人還廣漢趙廣以別卒五千餘人還涪城初別駕張熙說道濟令糶太倉穀賊以九月末圍城至十二月末廩米便盡方明將三千人出城求食為賊所敗匹馬獨還賊因追之衆復大集方明夜於城西縋上道濟為設食饋不能食唯泣涕而已道濟時有疾已篤曰力疾勉之曰卿非大丈夫小敗何苦賊勢旣衰臺兵垂至但令卿還何憂於賊卽減左右數十人配之賊城外云方明已死可來取喪城中大恐道濟夜刈炬火方明自出衆見之乃安道濟悉出財",
            "person_mention_id": "c-songshu-045-wyd1739-liucui:p010:m0056"
          },
          {
            "work_id": "w-songshu",
            "book_id": "b-songshu-045",
            "source_id": "s-songshu-045-wyd1739-liucui",
