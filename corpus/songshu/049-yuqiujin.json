        "paragraph_id": "c-songshu-049-yuqiujin:p003",
        "start_codepoint": 41,
        "end_codepoint": 66,
        "human_reviewed": false
      },
      {
        "id": "c-songshu-049-yuqiujin:received_sentence3-66",
        "kind": "received_sentence",
        "person_id": "t8a_uoo_qhb",
        "source_quote": "討司馬休之，又有戰功。",
        "reading": "討司馬休之有功。",
