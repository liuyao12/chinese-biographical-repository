  <p id="c-songshu-041-xiefanjing-wyd:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-songshu-041-xiefanjing-wyd:p001:m0000" ref="6y2_apj_l05">順帝</persName><persName id="c-songshu-041-xiefanjing-wyd:p001:m0002" ref="aa6_83c_juy_DBABAAA">謝皇后</persName>諱<persName id="c-songshu-041-xiefanjing-wyd:p001:m0006" ref="aa6_83c_juy_DBABAAA">梵境</persName>陳郡陽夏人右光祿大夫<persName id="c-songshu-041-xiefanjing-wyd:p001:m0018" ref="aa6_83c_juy_DBABA">莊</persName>孫女也昇明二年立為皇后<persName id="c-songshu-041-xiefanjing-wyd:p001:m0030" ref="6y2_apj_l05">順帝</persName>禪位降為汝陰王妃<persName id="c-songshu-041-xiefanjing-wyd:p001:m0040" ref="aa6_83c_juy_DBABA">莊</persName>自有傳</p>
