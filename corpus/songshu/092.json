        "paragraph_id": "c-songshu-092-wangzhenzhi:line014",
        "start_codepoint": 214,
        "end_codepoint": 230,
        "source_quote": "服闋，為征西道規司馬、南平太守。",
        "reading": "服闋任劉道規司馬、南平太守。",
        "human_reviewed": false
      },
      {
