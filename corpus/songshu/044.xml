<text format-version="0.2" work-id="w-songshu" book-id="b-songshu-044" chapter-id="c-songshu-044-xiehui" source-id="s-songshu-044-xiehui">
  <p id="c-songshu-044-xiehui:p001" annotation-status="in_progress" text-layer="received_chapter"><persName id="c-songshu-044-xiehui:p001:m0000" ref="5t2_x7g_6iv_AA">謝晦</persName>字<persName id="c-songshu-044-xiehui:p001:m0003" ref="5t2_x7g_6iv_AA">宣明</persName>，陳郡陽夏人也。祖<persName id="c-songshu-044-xiehui:p001:m0014" ref="5t2_x7g_6iv">朗</persName>，東陽太守。父<persName id="c-songshu-044-xiehui:p001:m0022" ref="5t2_x7g_6iv_A">重</persName>，<persName id="c-songshu-044-xiehui:p001:m0024" ref="rts_9t6_fim">會稽王道子</persName>驃騎長史。兄<persName id="c-songshu-044-xiehui:p001:m0035" ref="5t2_x7g_6iv_AB">絢</persName>，<persName id="c-songshu-044-xiehui:p001:m0037" ref="3dv_ken_w58">高祖</persName>鎮軍長史，蚤卒。</p>
</text>
