      "evidence": [
        {
          "work_id": "w-songshu",
          "book_id": "b-songshu-047",
          "chapter_id": "c-songshu-047-menghuaiyu",
          "source_id": "s-songshu-047-menghuaiyu-ws2190557",
          "paragraph_id": "c-songshu-047-menghuaiyu:p002",
          "quote": "高祖東伐孫恩，以懷玉為建武司馬。豫義旗，從平京城，進定京邑。以功封鄱陽縣侯，食邑千戶。高祖鎮京口，以懷玉為鎮軍參軍、下邳太守。義熙三年，出為寧朔將軍、西陽太守、新蔡內史，除中書侍郎，轉輔國將軍，領丹陽府兵，戍石頭。",
          "person_mention_id": "c-songshu-047-menghuaiyu:p002:m0008"
        }
      ],
      "status": "source_attested",
      "interpretation_note": "所見原官稱，未載全任期。",
