    {
      "id": "name-song051-yiqing-literal-yq_yushi",
      "person_id": "91u_fdq_gok",
      "surname": "庾",
      "ming": "實",
      "additional_names": [],
      "chapter_id": "c-songshu-051-wyd1739-zongshi",
      "paragraph_id": "c-songshu-051-wyd1739-zongshi:p032",
      "person_mention_id": "c-songshu-051-wyd1739-zongshi:p032:m0205",
      "quote": "書令進號前將軍常侍尹如故在京尹九年出為使持節都督荆雍益寧梁南北秦七州諸軍平西將軍荆州刺史荆州居上流之重地廣兵彊資實兵甲居朝廷之半故高祖使諸子居之義慶以宗室令美故特有此授性謙虛始至及去鎮迎送物並不受十三年普使內外舉官舉士義慶上表曰詔書疇咨羣司延及連牧旌賢仄陋拔善幽遐伏惟陛下惠哲光宣經緯明遠皇階藻耀風猷日昇而猶詢衢室之令典遵明臺之嚴訓降淵慮於管庫紆聖思乎版築故以道邈往載德高前王臣敢竭虛闇祗承明旨伏見前臨沮令新野庾實乘貞履",
      "status": "editorial_provisional",
      "component_source_binding": {
