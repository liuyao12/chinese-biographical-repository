  <p id="c-houhanshu-052-cuiyuan-wangjian:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-houhanshu-052-cuiyuan-wangjian:p001:m0000" ref="yfm_7fm_2ei_AAAA">崔駰</persName>字<persName id="c-houhanshu-052-cuiyuan-wangjian:p001:m0003" ref="yfm_7fm_2ei_AAAA">亭伯</persName>，涿郡安平人也。高祖父<persName id="c-houhanshu-052-cuiyuan-wangjian:p001:m0016" ref="yfm_7fm_2ei">朝</persName></p>
  <p id="c-houhanshu-052-cuiyuan-wangjian:p002" annotation-status="reviewed" text-layer="received_chapter">生子<persName id="c-houhanshu-052-cuiyuan-wangjian:p002:m0002" ref="yfm_7fm_2ei_A">舒</persName>，歷四郡太守</p>
  <p id="c-houhanshu-052-cuiyuan-wangjian:p003" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-houhanshu-052-cuiyuan-wangjian:p003:m0000" ref="yfm_7fm_2ei_A">舒</persName>小子<persName id="c-houhanshu-052-cuiyuan-wangjian:p003:m0003" ref="yfm_7fm_2ei_AA">篆</persName></p>
  <p id="c-houhanshu-052-cuiyuan-wangjian:p004" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-houhanshu-052-cuiyuan-wangjian:p004:m0000" ref="yfm_7fm_2ei_AA">篆</persName>生<persName id="c-houhanshu-052-cuiyuan-wangjian:p004:m0002" ref="yfm_7fm_2ei_AAA">毅</persName>，以疾隱身不仕。</p>
  <p id="c-houhanshu-052-cuiyuan-wangjian:p005" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-houhanshu-052-cuiyuan-wangjian:p005:m0000" ref="yfm_7fm_2ei_AAA">毅</persName>生<persName id="c-houhanshu-052-cuiyuan-wangjian:p005:m0002" ref="yfm_7fm_2ei_AAAA">駰</persName></p>
  <p id="c-houhanshu-052-cuiyuan-wangjian:p006" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-houhanshu-052-cuiyuan-wangjian:p006:m0000" ref="yfm_7fm_2ei_AAAA">駰</persName>自以遠去，不得意，遂不之官而歸。永元四年，卒於家。</p>
  <p id="c-houhanshu-052-cuiyuan-wangjian:p007" annotation-status="reviewed" text-layer="received_chapter">中子<persName id="c-houhanshu-052-cuiyuan-wangjian:p007:m0002" ref="yfm_7fm_2ei_AAAAA">瑗</persName></p>
  <p id="c-houhanshu-052-cuiyuan-wangjian:p008" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-houhanshu-052-cuiyuan-wangjian:p008:m0000" ref="yfm_7fm_2ei_AAAAA">瑗</persName>字<persName id="c-houhanshu-052-cuiyuan-wangjian:p008:m0002" ref="yfm_7fm_2ei_AAAAA">子玉</persName></p>
