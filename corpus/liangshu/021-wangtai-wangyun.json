    "person_reference_occurrences": [
      {
        "id": "c-liangshu-021-wangtai-wangyun:p002:r0036",
        "surface": "其",
        "start": 36,
        "end": 37,
        "person_id": "7r6_k52_qji_ABAAAAEBAA",
        "referent_role": "third_person",
        "paragraph_id": "c-liangshu-021-wangtai-wangyun:p002",
        "quote": "泰幼敏悟，年數歲時，祖母集諸孫侄，散棗栗於床上，羣兒皆競之，泰獨不取。問其故，對曰：「不取，自當得賜。」由是中表異之。旣長，通和溫雅，人不見其喜慍之色。起家爲著作郎，不拜，改除秘書郎，遷前將軍、法曹行參軍、司徒東閤祭酒、車騎主簿。",
        "note": "依本段敘事及王府原卷。"
      },
