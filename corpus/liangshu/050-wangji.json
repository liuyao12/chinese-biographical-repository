        "human_reviewed": false
      },
      {
        "id": "liang050-wangji-dated-2",
        "kind": "chronological_comparison",
        "person_id": "p93_tgr_t8r_AA",
        "source_quote": "中散大夫",
        "reading": "中散大夫名簿報齡",
        "reference": "source-evidence/liang050-wangji/external/guanghongmingji020-ws778962.wikitext",
        "url": "https://zh.wikisource.org/w/index.php?oldid=778962",
        "paragraph_id": "c-liangshu-050-wangji:p002",
        "start_codepoint": 182,
        "end_codepoint": 186,
        "note": "序署繹，自報年二十七。攝提寅歲與其平西將軍官期相交得534。該簿四庫作「王藉年五十五字文海」，大正藏本作籍。",
        "human_reviewed": false
      },
      {
        "id": "liang050-wangji-dated-3",
        "kind": "chronological_comparison",
        "person_id": "p93_tgr_t8r_AA",
        "source_quote": "安西府",
        "reading": "蕭繹軍府官期",
        "reference": "source-evidence/nanshi019-xie-branches/liang003-ws2401780.wikitext",
        "url": "https://zh.wikisource.org/w/index.php?oldid=2401780",
        "paragraph_id": "c-liangshu-050-wangji:p002",
        "start_codepoint": 212,
        "end_codepoint": 215,
        "note": "大同元年十二月辛丑改安西，大同三年閏月甲子改鎮西。王籍被引入安西府可限於梁曆535至537年間。",
        "human_reviewed": false
      },
      {
        "id": "liang050-wangji-dated-4",
        "kind": "chronological_comparison",
        "person_id": "p93_tgr_t8r_AA",
        "source_quote": "少時，卒",
        "reading": "謝徵文集與王籍生存下界",
        "reference": "source-evidence/nanshi019-xie-branches/liang050-ws1514482.wikitext",
        "url": "https://zh.wikisource.org/w/index.php?oldid=1514482",
        "paragraph_id": "c-liangshu-050-wangji:p002",
        "start_codepoint": 244,
        "end_codepoint": 248,
        "note": "同卷載謝徵大同二年卒，友人王籍集其文二十卷，表明王籍至少活到536年。其子碧先卒，碧卒年亦不詳。",
        "human_reviewed": false
      },
      {
        "id": "liang050-wangji-dated-5",
        "kind": "chronological_comparison",
        "person_id": "p93_tgr_t8r_AAA",
        "source_quote": "先籍卒",
        "reading": "父子卒序",
        "reference": "source-evidence/nanshi019-xie-branches/liang050-ws1514482.wikitext",
        "url": "https://zh.wikisource.org/w/index.php?oldid=1514482",
        "paragraph_id": "c-liangshu-050-wangji:p003",
        "start_codepoint": 8,
        "end_codepoint": 11,
        "note": "王碧先於父王籍卒。原段沒有記某年某月，也無王碧報齡。",
        "human_reviewed": false
      }
