        },
        {
          "id": "c-liangshu-041-liang41:p001:m0013",
          "start": 13,
          "end": 14,
          "surface": "儉",
          "kind": "person",
          "person_id": "7r6_k52_qji_ABAAAAEAA",
          "identification_status": "contextual_provisional",
          "interpretation_note": "南史卷24王氏選錄原段；只採來源明載身份。徐孺子、許子將暫以原稱登記，待另核具名原句；未以模型記憶補姓名。王昕依父綸之及居父憂而卒辨識，不套同名他傳。"
        },
        {
          "id": "c-liangshu-041-liang41:p001:m0025",
          "start": 25,
          "end": 26,
          "surface": "騫",
          "kind": "person",
          "person_id": "7r6_k52_qji_ABAAAAEAAA",
          "identification_status": "contextual_provisional",
          "interpretation_note": "《梁書》王規傳明載祖儉、父騫；同段連續父祖作編輯組接。"
        }
      ]
    },
    {
      "id": "c-liangshu-041-liang41:p002",
      "text": "規辭疾不拜，於鐘山宗熙寺築室居焉。大同二年，卒，時年四十五。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": [
        {
