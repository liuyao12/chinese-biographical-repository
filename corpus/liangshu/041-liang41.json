  "paragraphs": [
    {
      "id": "c-liangshu-041-liang41:p001",
      "text": "王規字威明，琅邪臨沂人。祖儉，齊太尉南昌文憲公。父騫，金紫光祿大夫南昌安侯。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
