<text format-version="0.2" work-id="w-liangshu" book-id="b-liangshu-029" chapter-id="c-liangshu-029-eight-sons" source-id="s-liangshu-029-eight-sons-ws1538079">
  <p id="c-liangshu-029-eight-sons:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-liangshu-029-eight-sons:p001:m0000" ref="fo7_f8v_rmf">高祖</persName>八男：<persName id="c-liangshu-029-eight-sons:p001:m0005" ref="2zn_kvj_dmy_A">丁貴嬪</persName>生<persName id="c-liangshu-029-eight-sons:p001:m0009" ref="0va_s3x_wb4">昭明太子統</persName>，<persName id="c-liangshu-029-eight-sons:p001:m0015" ref="rtd_v0b_nyn">太宗簡文皇帝</persName>，<persName id="c-liangshu-029-eight-sons:p001:m0022" ref="fo7_f8v_rmf_G">廬陵威王續</persName>；<persName id="c-liangshu-029-eight-sons:p001:m0028" ref="8dg_6jb_3j5_A">阮脩容</persName>生<persName id="c-liangshu-029-eight-sons:p001:m0032" ref="rvc_bqx_v5w">世祖孝元皇帝</persName>；<persName id="c-liangshu-029-eight-sons:p001:m0039" ref="tpj_t61_f20">吳淑媛</persName>生<persName id="c-liangshu-029-eight-sons:p001:m0043" ref="syn_jn4_wiu">豫章王綜</persName>；<persName id="c-liangshu-029-eight-sons:p001:m0048" ref="z0c_znc_1y6">董淑儀</persName>生<persName id="c-liangshu-029-eight-sons:p001:m0052" ref="fo7_f8v_rmf_C">南康簡王績</persName>；<persName id="c-liangshu-029-eight-sons:p001:m0058" ref="qvu_slr_wgd">丁充華</persName>生<persName id="c-liangshu-029-eight-sons:p001:m0062" ref="81y_7i5_frc">邵陵攜王綸</persName>；<persName id="c-liangshu-029-eight-sons:p001:m0068" ref="1eh_wqx_875">葛脩容</persName>生<persName id="c-liangshu-029-eight-sons:p001:m0072" ref="fo7_f8v_rmf_D">武陵王紀</persName>。<persName id="c-liangshu-029-eight-sons:p001:m0077" ref="syn_jn4_wiu">綜</persName>及<persName id="c-liangshu-029-eight-sons:p001:m0079" ref="fo7_f8v_rmf_D">紀</persName>別有傳。</p>
</text>
