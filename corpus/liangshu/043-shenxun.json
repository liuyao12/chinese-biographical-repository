    "source_reading_cases": [
      {
        "id": "c-liangshu-043-shenxun:received_sentence1-0",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "沈浚字叔源，吳興武康人。",
        "reading": "浚字叔源，吳興武康人。",
        "note": "浚字叔源，吳興武康人。",
        "paragraph_id": "c-liangshu-043-shenxun:p001",
        "start_codepoint": 0,
        "end_codepoint": 12,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence1-12",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "祖憲，齊散騎常侍，《齊史》有傳。",
        "reading": "祖沈憲，曾任齊散騎常侍，傳見齊53。",
        "note": "祖沈憲，曾任齊散騎常侍，傳見齊53。",
        "paragraph_id": "c-liangshu-043-shenxun:p001",
        "start_codepoint": 12,
        "end_codepoint": 28,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-0",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "浚少博學，有才幹，歷山陰、吳、建康令，並有能名。",
        "reading": "少博學有幹才，歷山陰、吳、建康令。",
        "note": "少博學有幹才，歷山陰、吳、建康令。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 0,
        "end_codepoint": 24,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-24",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "入爲中書郎、尚書左丞。",
        "reading": "入中書郎、尚書左丞。",
        "note": "入中書郎、尚書左丞。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 24,
        "end_codepoint": 35,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-35",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "侯景逼京城，遷御史中丞。",
        "reading": "侯景逼京時遷御史中丞。",
        "note": "侯景逼京時遷御史中丞。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 35,
        "end_codepoint": 47,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-47",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "是時外援並至，侯景表請求和，詔許之。",
        "reading": "外援至，侯景請和獲允。",
        "note": "外援至，侯景請和獲允。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 47,
        "end_codepoint": 65,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-65",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "旣盟，景知城內疾疫，復懷奸計，遲疑不去。",
        "reading": "盟後景知城中疫病，遲疑不去。",
        "note": "盟後景知城中疫病，遲疑不去。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 65,
        "end_codepoint": 85,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-85",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "數日，皇太子令浚詣景所，景曰：「卽已向熱，非復行時。",
        "reading": "皇太子遣浚至景處，景稱天熱。",
        "note": "皇太子遣浚至景處，景稱天熱。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 85,
        "end_codepoint": 111,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-111",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "十萬之衆，何由可去，還欲立效朝廷，君可見爲申聞。」",
        "reading": "景自言眾十萬，請浚轉達。",
        "note": "景自言眾十萬，請浚轉達。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 111,
        "end_codepoint": 136,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-136",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "浚曰：「將軍此論，意在得城。",
        "reading": "浚答景意在得城。",
        "note": "浚答景意在得城。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 136,
        "end_codepoint": 150,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-150",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "城內兵糧，尚支百日。",
        "reading": "浚稱城中糧可支百日。",
        "note": "浚稱城中糧可支百日。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 150,
        "end_codepoint": 160,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-160",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "將軍儲積內盡，國家援軍外集，十萬之衆，將何所資？",
        "reading": "浚反問景十萬眾倚何供給。",
        "note": "浚反問景十萬眾倚何供給。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 160,
        "end_codepoint": 184,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-184",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "而反設此言，欲脅朝廷邪？」",
        "reading": "指景藉言要脅。",
        "note": "指景藉言要脅。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 184,
        "end_codepoint": 197,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-197",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "景橫刃於膝，暿真目叱之。",
        "reading": "景橫刃叱浚。",
        "note": "景橫刃叱浚。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 197,
        "end_codepoint": 209,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-209",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "浚正色責景曰：「明公親是人臣，舉兵向闕，聖主申恩赦過，已共結盟，口血未乾，而有翻背。",
        "reading": "浚責景背盟，稱聖主曾赦。",
        "note": "浚責景背盟，稱聖主曾赦。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 209,
        "end_codepoint": 251,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-251",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "沈浚六十之年，且天子之使，死生有命，豈畏逆臣之刀乎！」",
        "reading": "浚自言六十之年，為天子使。",
        "note": "浚自言六十之年，為天子使。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 251,
        "end_codepoint": 278,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-278",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "不顧而出。",
        "reading": "不顧而出。",
        "note": "不顧而出。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 278,
        "end_codepoint": 283,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-283",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "景曰：「是真司直也。」",
        "reading": "景稱浚是真司直。",
        "note": "景稱浚是真司直。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 283,
        "end_codepoint": 294,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-294",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
        "source_quote": "然密銜之。",
        "reading": "景暗中懷恨。",
        "note": "景暗中懷恨。",
        "paragraph_id": "c-liangshu-043-shenxun:p002",
        "start_codepoint": 294,
        "end_codepoint": 299,
        "human_reviewed": false
      },
      {
        "id": "c-liangshu-043-shenxun:received_sentence2-299",
        "kind": "received_sentence",
        "person_id": "8c4_l2o_krm_AA*A",
