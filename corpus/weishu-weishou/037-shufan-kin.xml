  <p id="c-weishu-weishou-037-shufan-kin:p001" annotation-status="reviewed" text-layer="received_chapter"><persName id="c-weishu-weishou-037-shufan-kin:p001:m0000" ref="0f8_dc1_803_A">司馬叔璠</persName>，晉安平獻王孚之後也。父<persName id="c-weishu-weishou-037-shufan-kin:p001:m0016" ref="0f8_dc1_803">曇之</persName>，<persName id="c-weishu-weishou-037-shufan-kin:p001:m0019" ref="s6y_280_81r">司馬德宗</persName>河間王。<persName id="c-weishu-weishou-037-shufan-kin:p001:m0027" ref="u9s_w6j_8mc_AAF">桓玄</persName>、<persName id="c-weishu-weishou-037-shufan-kin:p001:m0030" ref="3qs_nqa_ioa_AAA">劉裕</persName>之際，<persName id="c-weishu-weishou-037-shufan-kin:p001:m0035" ref="0f8_dc1_803_A">叔璠</persName>與兄<persName id="c-weishu-weishou-037-shufan-kin:p001:m0039" ref="n7q_zlm_snw">國璠</persName>北奔慕容超。</p>
</text>
