    {
      "id": "c-epitaph-wangyi-excerpts:p002",
      "text": "春秋卌有五，永安元年歲在戊申十二月壬午朔廿日辛丑終於位。",
      "text_layer": "received_chapter",
      "annotation_status": "in_progress",
      "mentions": [],
